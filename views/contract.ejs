<%- include('partials/header', { title: t('phieu.tieu_de') }) %>

<%
  var co = orderDetails && orderDetails.length > 0;
  var d = co ? orderDetails[0] : null;
  var tong = 0;
  if (co) orderDetails.forEach(function (i) { tong += Number(i.thanhtien) || 0; });
%>

<section class="nh-subhero" style="min-height:38vh">
  <div class="nh-subhero__bg nh-wa-koshi"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('phieu.da_ghi_nhan') %></span>
    <h1><%= t('phieu.tieu_de') %></h1>
    <div class="nh-crumbs"><a href="/"><%= t('dieu_huong.trang_chu') %></a> &nbsp;/&nbsp; <%= t('phieu.tieu_de') %></div>
  </div>
</section>

<section class="nh-section nh-section--cream">
  <div class="nh-container-narrow">
    <%- include('partials/nh-steps', { buoc: 4 }) %>

    <% if (co) { %>
      <!-- Lời xác nhận đặt TRƯỚC phiếu: câu khách cần đọc đầu tiên là "đã đặt
           được chưa và tiếp theo thế nào", không phải bảng số liệu. -->
      <div class="nh-done nh-reveal" style="margin-bottom:2.4rem">
        <div class="nh-done__seal"><i class="fas fa-check"></i></div>
        <h2 class="nh-section-title" style="font-size:clamp(1.6rem,3.4vw,2.3rem)"><%= t('phieu.da_nhan_yeu_cau') %></h2>
        <p class="nh-lead" style="margin-top:.8rem">
          <%- t('phieu.se_goi_lai', { sdt: '<strong>' + (d.sodienthoai || session.usersdt) + '</strong>' }) %>
        </p>
      </div>

      <div class="nh-receipt nh-reveal">
        <div class="nh-receipt__head">
          <span class="nh-eyebrow"><%= t('chung.ten_nha_hang') %></span>
          <h2><%= t('phieu.tieu_de').toUpperCase() %></h2>
          <div style="font-size:.78rem; letter-spacing:1.4px; opacity:.75; margin-top:.5rem">
            <%= t('don.ma_don').toUpperCase() %> &nbsp;<strong style="color:var(--nh-gold-soft)"><%= String(d.sesis).slice(0, 10).toUpperCase() %></strong>
          </div>
        </div>

        <div class="nh-receipt__facts">
          <div class="nh-receipt__fact"><%= t('phieu.nguoi_dat') %>
            <b><%= d.ten_khach || d.ten || session.username %></b></div>
          <div class="nh-receipt__fact"><%= t('chung.dien_thoai') %>
            <b><%= d.sodienthoai || session.usersdt %></b></div>
          <div class="nh-receipt__fact"><%= t('phieu.ngay_den') %>
            <b><%= ngayVN(d.dates) %></b></div>
          <div class="nh-receipt__fact"><%= t('phieu.gio_den') %>
            <b><%= gioVN(d.tg) %></b></div>
          <div class="nh-receipt__fact"><%= t('don.so_khach') %>
            <b><%= nhanSoKhach(d.so_user) %></b></div>
          <div class="nh-receipt__fact"><%= t('don.dip') %>
            <b><%= d.noidung %></b></div>
        </div>

        <div class="nh-receipt__body">
          <h3 class="nh-panel__title"><i class="fas fa-utensils"></i> <%= t('phieu.thuc_don_da_chon') %></h3>

          <% orderDetails.forEach(function (item) { %>
            <div class="nh-line" style="grid-template-columns:1fr auto auto">
              <div class="nh-line__info">
                <h4 class="nh-line__name"><%= (item.name_mon || '').trim() %></h4>
                <div class="nh-line__unit"><%= formatMoney(item.gia) %> ₫ × <%= item.soluong %></div>
              </div>
              <div></div>
              <div class="nh-line__sum"><%= formatMoney(item.thanhtien) %> ₫</div>
            </div>
          <% }) %>

          <div class="nh-summary__total">
            <span><%= t('chung.tong_cong') %></span>
            <b><%= formatMoney(tong) %> ₫</b>
          </div>

          <p class="nh-note">
            <i class="fas fa-circle-info" style="color:var(--nh-gold)"></i>
            Số tiền trên là giá trị các món đã đặt trước, thanh toán tại nhà hàng sau khi dùng bữa.
            Muốn đổi món hay đổi giờ, hãy gọi cho nhà hàng trước giờ đến.
          </p>
        </div>
      </div>

      <div class="nh-done__actions">
        <%
          /* Chi moi don CO GOI MON truoc moi cho dat coc: don dat ban thuan
             (tong = 0) thi khong co gi de tinh phan tram coc. */
        %>
        <% if (tong > 0 && Number(d.tinhtrang) !== 3 && Number(d.tinhtrang) !== 4) { %>
          <a href="/thanh-toan/dat-coc/<%= d.sesis %>" class="nh-btn nh-btn--gold">
            <i class="fas fa-shield-halved"></i> <%= t('dat_coc.tieu_de') %>
          </a>
        <% } %>
        <a href="/my-orders" class="nh-btn nh-btn--gold"><i class="fas fa-list-check"></i> <%= t('phieu.xem_don_cua_toi') %></a>
        <a href="/menu" class="nh-btn nh-btn--dark"><i class="fas fa-book-open"></i> <%= t('phieu.ve_thuc_don') %></a>
        <button type="button" class="nh-btn nh-btn--dark nh-btn--sm" onclick="window.print()">
          <i class="fas fa-print"></i> <%= t('phieu.in_phieu') %>
        </button>
      </div>
    <% } else { %>
      <div class="nh-empty">
        <i class="fas fa-file-circle-question"></i>
        <h3><%= t('phieu.khong_tim_thay') %></h3>
        <p class="nh-lead" style="margin:.6rem auto 1.8rem; max-width:460px">
          <%= t('phieu.duong_dan_sai') %>
        </p>
        <a href="/my-orders" class="nh-btn nh-btn--gold"><i class="fas fa-list-check"></i> <%= t('phieu.xem_don_cua_toi') %></a>
      </div>
    <% } %>
  </div>
</section>

<style>
  /* Bản in: chỉ giữ phiếu, bỏ thanh điều hướng, thanh bước, nút và chân trang. */
  @media print {
    .nh-nav, .nh-subhero, .nh-steps, .nh-done__actions, .nh-footer, .nh-done__seal { display: none !important; }
    .nh-section { padding: 0 !important; background: #fff !important; }
    .nh-receipt { box-shadow: none !important; border: 1px solid #ddd; }
    .nh-receipt__head { background: #fff !important; color: #000 !important; border-bottom: 2px solid #000; }
    .nh-receipt__head h2, .nh-receipt__head .nh-eyebrow { color: #000 !important; }
  }
</style>

<%- include('partials/footer') %>
