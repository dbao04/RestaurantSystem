<%- include('partials/header', { title: t('gioi_thieu.tieu_de'), activeNav: 'about' }) %>

<%
  /* Xem ghi chú đầu views/index.ejs — cùng cách làm: nền là hoa văn Nhật vẽ
     bằng SVG, "ảnh" là món thật trong thực đơn. `monTrangTri` do route /about
     truy vấn riêng; phải chịu được mảng rỗng khi CSDL lỗi. */
  var dsTrangTri = (typeof monTrangTri !== 'undefined' && monTrangTri) ? monTrangTri : [];
  function monTT(i) { return dsTrangTri.length ? dsTrangTri[i % dsTrangTri.length] : null; }
%>

<!-- ================= HERO NHỎ ================= -->
<section class="nh-subhero">
  <div class="nh-subhero__bg nh-wa-shippo"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('gioi_thieu.hero_eyebrow') %></span>
    <h1><%= t('gioi_thieu.tieu_de') %></h1>
    <div class="nh-crumbs"><a href="/"><%= t('dieu_huong.trang_chu') %></a> &nbsp;/&nbsp; <%= t('gioi_thieu.tieu_de') %></div>
  </div>
</section>

<!-- ================= CÂU CHUYỆN ================= -->
<section class="nh-section nh-section--cream">
  <div class="nh-container nh-about">
    <div class="nh-about__imgs nh-about__imgs--mon nh-reveal">
      <% [0, 1].forEach(function (i) { var m = monTT(i); %>
        <div class="nh-mon-khung <%= i % 2 ? 'nh-wa-shippo' : 'nh-wa-song' %>">
          <% if (m) { %>
            <img src="/food/<%= m.images %>" alt="<%= (m.name_mon || '').trim() %>" loading="lazy">
          <% } %>
        </div>
      <% }) %>
      <div class="nh-about__badge" style="font-family:var(--nh-serif)">
        <span style="font-size:1rem;line-height:1.25;font-family:var(--nh-serif)"><%- t('gioi_thieu.huy_hieu') %></span>
      </div>
    </div>
    <div class="nh-about__text nh-reveal" data-delay="1">
      <span class="nh-eyebrow"><%= t('trang_chu.ve_chung_toi') %></span>
      <h2 class="nh-section-title"><%- t('gioi_thieu.tieu_de_chinh') %></h2>
      <div class="nh-divider" style="margin-left:0"></div>
      <p><%- t('gioi_thieu.doan_1') %></p>
      <p><%- t('gioi_thieu.doan_2') %></p>
      <div class="nh-sign"><%- t('trang_chu.ky_ten') %></div>
    </div>
  </div>
</section>

<!-- ================= GIÁ TRỊ CỐT LÕI ================= -->
<section class="nh-section nh-section--dark">
  <div class="nh-container">
    <div class="nh-head nh-center nh-reveal">
      <span class="nh-eyebrow"><%= t('gioi_thieu.gia_tri_eyebrow') %></span>
      <h2 class="nh-section-title"><%= t('gioi_thieu.gia_tri') %></h2>
      <div class="nh-divider"></div>
    </div>
    <div class="nh-features">
      <div class="nh-feature nh-reveal" data-delay="1">
        <div class="nh-feature__icon"><i class="fas fa-fish"></i></div>
        <h3><%= t('gioi_thieu.gt_1_tieu_de') %></h3>
        <p><%= t('gioi_thieu.gt_1_mo_ta') %></p>
      </div>
      <div class="nh-feature nh-reveal" data-delay="2">
        <div class="nh-feature__icon"><i class="fas fa-hands"></i></div>
        <h3><%= t('gioi_thieu.gt_2_tieu_de') %></h3>
        <p><%= t('gioi_thieu.gt_2_mo_ta') %></p>
      </div>
      <div class="nh-feature nh-reveal" data-delay="3">
        <div class="nh-feature__icon"><i class="fas fa-heart"></i></div>
        <h3><%= t('gioi_thieu.gt_3_tieu_de') %></h3>
        <p><%= t('gioi_thieu.gt_3_mo_ta') %></p>
      </div>
    </div>
  </div>
</section>

<!-- ================= CTA ================= -->
<section class="nh-cta">
  <div class="nh-cta__bg nh-wa-koshi"></div>
  <div class="nh-cta__veil"></div>
  <div class="nh-container nh-cta__inner nh-reveal">
    <span class="nh-eyebrow"><%= t('gioi_thieu.cta_eyebrow') %></span>
    <h2><%- t('gioi_thieu.cta_tieu_de') %></h2>
    <p><%= t('gioi_thieu.cta_mo_ta') %></p>
    <a href="/datban" class="nh-btn nh-btn--gold"><i class="fas fa-calendar-check"></i> <%= t('chung.dat_ban_ngay') %></a>
  </div>
</section>

<%- include('partials/footer') %>
