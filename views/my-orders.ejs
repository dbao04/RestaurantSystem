<script>
// Chuyen tab Lich su dat ban / Lich su dat tiec; ghi ?tab= vao URL de tai lai trang van dung tab.
function chonTabLichSu(tab) {
  document.querySelectorAll('.nh-order-tab-btn').forEach(function (b) { b.classList.toggle('active', b.dataset.tab === tab); });
  document.querySelectorAll('.nh-tab-content').forEach(function (c) { c.classList.toggle('active', c.id === 'tab-' + tab); });
  // Phan tu .nh-reveal trong tab vua hien chua duoc observer bat (luc tai trang no dang an).
  document.querySelectorAll('#tab-' + tab + ' .nh-reveal').forEach(function (el) { el.classList.add('is-in'); });
  try {
    var u = new URL(location.href);
    if (tab === 'tiec') u.searchParams.set('tab', 'tiec'); else u.searchParams.delete('tab');
    u.searchParams.delete('msg'); u.searchParams.delete('msgType');
    history.replaceState(null, '', u.pathname + u.search);
  } catch (e) {}
}
var LEAD_MINUTES = <%= (typeof cauHinh !== 'undefined' && cauHinh.minimum_lead_minutes) ? Number(cauHinh.minimum_lead_minutes) : 30 %>;
var TXT_KHACH = "<%= t('dat_ban_moi.khach') %>";
var TXT_KHONG_CO_MON = "<%= t('don.khong_co_mon_goi_truoc') %>";
var TXT_KHONG_CO = "<%= t('don.khong_co') %>";
var TXT_KHONG_YEU_CAU_COC = "<%= t('don.khong_yeu_cau_coc') %>";
var TXT_XEP_BAN_KHI_DEN = "<%= t('don.xep_ban_khi_den') %>";
var TXT_THONG_THUONG = "<%= t('don.thong_thuong') %>";
var TXT_DANG_LUU = "<%= t('don.dang_luu') %>";
var TXT_LUU_THAY_DOI = "<%= t('don.luu_thay_doi') %>";
var TXT_DANG_HUY = "<%= t('don.dang_huy') %>";
var TXT_XAC_NHAN_HUY = "<%= t('don.xac_nhan_huy_ban') %>";
var TXT_CAP_NHAT_OK = "<%= t('don.cap_nhat_thanh_cong') %>";
var TXT_HUY_OK = "<%= t('don.huy_thanh_cong_msg') %>";
var TXT_LOI_MANG = "<%= t('don.loi_ket_noi') %>";
var TXT_GIO_MON_TRONG = "<%= t('don.gio_mon_trong') %>";
var TXT_CAP_NHAT_MON_OK = "<%= t('don.cap_nhat_mon_thanh_cong') %>";
var DS_MON_AN = <%- JSON.stringify(typeof dsMonAn !== 'undefined' ? dsMonAn : []).replace(/</g, '\\u003c') %>;
var ANH_MON_MAP = {};
DS_MON_AN.forEach(function (m) { ANH_MON_MAP[m.id_mon] = m.images; });
function anhMon(idMon) {
  var f = ANH_MON_MAP[idMon];
  return f ? ('/food/' + f) : '/mon-thay-the.svg';
}

function moModalSuaDatBan(btn) {
  var d = btn.dataset;
  document.getElementById('suaMa').textContent = d.code || '';
  document.getElementById('suaMaAn').value = d.code || '';
  document.getElementById('suaPhoneAn').value = d.phone || '';
  document.getElementById('suaNgay').value = d.date || '';
  document.getElementById('suaGio').value = d.time || '';
  document.getElementById('suaSoKhach').value = d.guests || 2;
  document.getElementById('suaKhuVuc').value = d.area || '';
  document.getElementById('suaYeuCau').value = d.requests || '';
  var hanEl = document.getElementById('suaHanPhut');
  if (hanEl) hanEl.textContent = LEAD_MINUTES;

  var loiBox = document.getElementById('suaBaoLoi');
  if (loiBox) {
    loiBox.style.display = 'none';
    loiBox.textContent = '';
  }
  var modal = document.getElementById('modalSuaDatBan');
  if (modal) {
    modal.classList.add('active');
    modal.style.display = 'flex';
  }
}

function moModalChiTiet(btn) {
  var d = btn.dataset;
  document.getElementById('mMa').textContent = d.code || '';
  document.getElementById('mTenKhach').textContent = d.name || <%- JSON.stringify(t('don.d_khach_hang')) %>;
  document.getElementById('mSdt').textContent = d.phone || '-';
  document.getElementById('mThoiGian').textContent = d.time || '';
  document.getElementById('mSoKhach').textContent = (d.guests || 1) + ' ' + TXT_KHACH;
  document.getElementById('mKhuVuc').textContent = d.area || "<%= t('tt_dat_ban.tieu_chuan') %>";
  document.getElementById('mBan').textContent = d.tables || TXT_XEP_BAN_KHI_DEN;
  document.getElementById('mDip').textContent = d.occasion || TXT_THONG_THUONG;
  document.getElementById('mTienCoc').textContent = d.deposit || TXT_KHONG_YEU_CAU_COC;
  document.getElementById('mYeuCau').textContent = d.requests || TXT_KHONG_CO;
  var monEl = document.getElementById('mMonGoiTruoc');
  if (monEl) monEl.textContent = d.dishes || TXT_KHONG_CO_MON;

  var badge = document.getElementById('mTrangThaiBadge');
  if (badge) {
    badge.textContent = d.status || '';
    badge.className = 'nh-reservation-badge badge--' + (d.rawStatus || 'PENDING');
  }

  var modal = document.getElementById('modalChiTietDatBan');
  if (modal) {
    modal.classList.add('active');
    modal.style.display = 'flex';
  }
}

function moModalHuyDatBan(btn) {
  var d = btn.dataset;
  document.getElementById('huyMa').textContent = d.code || '';
  document.getElementById('huyMaAn').value = d.code || '';
  document.getElementById('huyPhoneAn').value = d.phone || '';
  document.getElementById('huyLyDo').value = '';

  var box = document.getElementById('huyThongTinHoan');
  var loiBox = document.getElementById('huyBaoLoi');
  if (loiBox) loiBox.style.display = 'none';
  if (box) box.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <%= t("don.dang_tai_chinh_sach") %>';

  var modal = document.getElementById('modalHuyDatBan');
  if (modal) {
    modal.classList.add('active');
    modal.style.display = 'flex';
  }

  fetch('/api/dat-ban/tra-cuu', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ma: d.code, dien_thoai: d.phone })
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    if (data.ok && data.huy) {
      var h = data.huy;
      if (h.soTien > 0) {
        box.innerHTML = '<i class="fas fa-check-circle" style="color:#16a34a"></i> ' + <%- JSON.stringify(t('don.d_hoan_tien')) %>.replace('{tien}', Number(h.soTien).toLocaleString('vi-VN')).replace('{pt}', h.phanTram);
      } else if (h.da_coc > 0) {
        box.innerHTML = '<i class="fas fa-exclamation-circle" style="color:#d97706"></i> ' + <%- JSON.stringify(t('don.d_sat_gio')) %>.replace('{gio}', h.gio_con_lai);
      } else {
        box.innerHTML = '<i class="fas fa-info-circle"></i> ' + <%- JSON.stringify(t('don.d_khong_coc')) %>;
      }
    } else {
      box.innerHTML = '<i class="fas fa-info-circle"></i> ' + <%- JSON.stringify(t('don.d_xac_nhan_huy')) %>;
    }
  })
  .catch(function() {
    if (box) box.innerHTML = '<i class="fas fa-info-circle"></i> ' + <%- JSON.stringify(t('don.d_xac_nhan_huy')) %>;
  });
}

// Xu ly su kien click delegated tren toan bo document de phong ngua
document.addEventListener('click', function(e) {
  var btnDong = e.target.closest('.btn-dong-chi-tiet, .btn-dong-modal-x');
  if (btnDong) {
    e.preventDefault();
    e.stopPropagation();
    dongChiTiet();
    return;
  }
  var btnSua = e.target.closest('.btn-mo-sua');
  if (btnSua) {
    e.preventDefault();
    moModalSuaDatBan(btnSua);
    return;
  }

  var btnSuaMon = e.target.closest('.btn-mo-sua-mon');
  if (btnSuaMon) {
    e.preventDefault();
    moModalSuaMon(btnSuaMon);
    return;
  }

  // Dong goi y tim mon khi bam ra ngoai.
  if (!e.target.closest('#monTim, #monGoiY')) {
    var goiY = document.getElementById('monGoiY');
    if (goiY) goiY.style.display = 'none';
  }

  var btnChiTiet = e.target.closest('.btn-mo-chi-tiet');
  if (btnChiTiet) {
    e.preventDefault();
    moModalChiTiet(btnChiTiet);
    return;
  }

  var btnHuy = e.target.closest('.btn-mo-huy');
  if (btnHuy) {
    e.preventDefault();
    moModalHuyDatBan(btnHuy);
    return;
  }
});

// ----------------------------------------------------- sửa món đã đặt trước

var monState = { ma: '', dienThoai: '', items: [] };

function tien(n) { return Number(n || 0).toLocaleString('vi-VN') + ' ₫'; }

function moModalSuaMon(btn) {
  var d = btn.dataset;
  monState.ma = d.code || '';
  monState.dienThoai = d.phone || '';
  try {
    monState.items = JSON.parse(d.dishes || '[]').map(function (m) {
      return { id_mon: Number(m.id_mon), name_mon: m.name_mon, gia_mon: Number(m.gia_mon) || 0, soluong: Math.max(1, Number(m.soluong) || 1) };
    });
  } catch (e) { monState.items = []; }

  document.getElementById('monMa').textContent = monState.ma;
  document.getElementById('monTim').value = '';
  document.getElementById('monGoiY').style.display = 'none';
  var loiBox = document.getElementById('monBaoLoi');
  if (loiBox) { loiBox.style.display = 'none'; loiBox.textContent = ''; }

  veMonGioHang();

  var modal = document.getElementById('modalSuaMon');
  if (modal) { modal.classList.add('active'); modal.style.display = 'flex'; }
}

function dongSuaMon() {
  var modal = document.getElementById('modalSuaMon');
  if (modal) {
    modal.classList.remove('active');
    modal.style.removeProperty('display');
    modal.style.display = 'none';
  }
}

function veMonGioHang() {
  var khung = document.getElementById('monGioHang');
  khung.innerHTML = '';

  if (!monState.items.length) {
    var trong = document.createElement('div');
    trong.style.cssText = 'color:var(--nh-muted); font-size:.88rem; text-align:center; padding:.6rem 0;';
    trong.textContent = TXT_GIO_MON_TRONG;
    khung.appendChild(trong);
  }

  monState.items.forEach(function (m, i) {
    var dong = document.createElement('div');
    dong.style.cssText = 'display:flex; align-items:center; gap:.7rem; padding:.5rem .6rem; border:1px solid var(--nh-line); border-radius:10px;';

    var anh = document.createElement('img');
    anh.src = anhMon(m.id_mon);
    anh.alt = m.name_mon;
    anh.loading = 'lazy';
    anh.style.cssText = 'width:48px; height:48px; border-radius:8px; object-fit:cover; flex:none; background:#f3ece0;';
    anh.onerror = function () { this.onerror = null; this.src = '/mon-thay-the.svg'; };
    dong.appendChild(anh);

    var ten = document.createElement('div');
    ten.style.cssText = 'flex:1; min-width:0;';
    ten.innerHTML = '<div style="font-weight:600; color:var(--nh-espresso); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">'
      + m.name_mon + '</div><div style="font-size:.78rem; color:var(--nh-muted);">' + tien(m.gia_mon) + '</div>';
    dong.appendChild(ten);

    var buoc = document.createElement('div');
    buoc.style.cssText = 'display:flex; align-items:center; gap:.4rem; flex:none;';
    var nutBot = taoNutSoLuong('−', function () { doiSoLuongMon(i, -1); });
    var soLuong = document.createElement('span');
    soLuong.style.cssText = 'min-width:1.6rem; text-align:center; font-weight:600;';
    soLuong.textContent = m.soluong;
    var nutThem = taoNutSoLuong('+', function () { doiSoLuongMon(i, 1); });
    buoc.appendChild(nutBot); buoc.appendChild(soLuong); buoc.appendChild(nutThem);
    dong.appendChild(buoc);

    var nutXoa = document.createElement('button');
    nutXoa.type = 'button';
    nutXoa.title = "<%= t('don.huy_bo') %>";
    nutXoa.style.cssText = 'flex:none; background:none; border:none; color:#ef4444; cursor:pointer; font-size:1rem; padding:.2rem .4rem;';
    nutXoa.innerHTML = '<i class="fas fa-trash-alt"></i>';
    nutXoa.addEventListener('click', function () { xoaMon(i); });
    dong.appendChild(nutXoa);

    khung.appendChild(dong);
  });

  var tong = monState.items.reduce(function (s, m) { return s + m.gia_mon * m.soluong; }, 0);
  document.getElementById('monTongTien').textContent = tien(tong);
}

function taoNutSoLuong(nhan, onClick) {
  var nut = document.createElement('button');
  nut.type = 'button';
  nut.textContent = nhan;
  nut.style.cssText = 'width:26px; height:26px; border-radius:50%; border:1px solid var(--nh-line); background:#fff; color:var(--nh-espresso); cursor:pointer; font-weight:700; line-height:1;';
  nut.addEventListener('click', onClick);
  return nut;
}

function doiSoLuongMon(i, delta) {
  var m = monState.items[i];
  if (!m) return;
  m.soluong = Math.max(1, m.soluong + delta);
  veMonGioHang();
}

function xoaMon(i) {
  monState.items.splice(i, 1);
  veMonGioHang();
}

function themMon(mon) {
  var co = monState.items.find(function (m) { return m.id_mon === mon.id_mon; });
  if (co) { co.soluong += 1; } else {
    monState.items.push({ id_mon: mon.id_mon, name_mon: mon.name_mon, gia_mon: Number(mon.gia_mon) || 0, soluong: 1 });
  }
  veMonGioHang();
}

(function () {
  var oTim = document.getElementById('monTim');
  var hopGoiY = document.getElementById('monGoiY');
  if (!oTim || !hopGoiY) return;

  // Sap theo ten cho de luot xem khi khach chua go gi ca.
  var DS_MON_SAP = DS_MON_AN.slice().sort(function (a, b) {
    return String(a.name_mon || '').localeCompare(String(b.name_mon || ''), 'vi');
  });

  function veGoiY() {
    var tu = oTim.value.trim().toLowerCase();
    hopGoiY.innerHTML = '';

    // Chua go gi: cho xem ca thuc don (cuon duoc) de khach biet co gi ma chon,
    // khong bat buoc phai go dung ten mon moi thay duoc goi y.
    var dsGoc = tu
      ? DS_MON_SAP.filter(function (m) { return String(m.name_mon || '').toLowerCase().indexOf(tu) !== -1; })
      : DS_MON_SAP;

    if (!dsGoc.length) {
      var rong = document.createElement('div');
      rong.style.cssText = 'padding:.6rem .8rem; color:var(--nh-muted); font-size:.85rem;';
      rong.textContent = "<%= t('don.khong_tim_thay_mon') %>";
      hopGoiY.appendChild(rong);
      hopGoiY.style.display = 'block';
      return;
    }

    dsGoc.slice(0, 60).forEach(function (m) {
      var dong = document.createElement('div');
      dong.style.cssText = 'padding:.45rem .7rem; cursor:pointer; display:flex; align-items:center; gap:.6rem; border-bottom:1px solid var(--nh-line); font-size:.88rem;';
      dong.innerHTML = '<img src="' + anhMon(m.id_mon) + '" alt="" loading="lazy" '
        + 'style="width:40px;height:40px;border-radius:6px;object-fit:cover;flex:none;background:#f3ece0;" '
        + 'onerror="this.onerror=null;this.src=\'/mon-thay-the.svg\'">'
        + '<span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + m.name_mon + '</span>'
        + '<span style="color:var(--nh-gold); font-weight:600; flex:none;">' + tien(m.gia_mon) + '</span>';
      dong.addEventListener('mouseenter', function () { dong.style.background = '#fdf6e8'; });
      dong.addEventListener('mouseleave', function () { dong.style.background = ''; });
      dong.addEventListener('click', function () {
        themMon(m);
        oTim.value = '';
        veGoiY();
        oTim.focus();
      });
      hopGoiY.appendChild(dong);
    });
    hopGoiY.style.display = 'block';
  }

  oTim.addEventListener('input', veGoiY);
  oTim.addEventListener('focus', veGoiY);
})();

function xuLyLuuMon() {
  var btn = document.getElementById('monBtnLuu');
  var loiBox = document.getElementById('monBaoLoi');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + TXT_DANG_LUU;
  if (loiBox) loiBox.style.display = 'none';

  fetch('/api/dat-ban/tra-cuu/doi-mon', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      ma: monState.ma,
      dien_thoai: monState.dienThoai,
      items: monState.items.map(function (m) {
        return { id_mon: m.id_mon, name_mon: m.name_mon, gia_mon: m.gia_mon, soluong: m.soluong };
      })
    })
  })
  .then(function (res) { return res.json(); })
  .then(function (res) {
    if (res.ok) {
      nhThongBao(TXT_CAP_NHAT_MON_OK).then(function () { window.location.reload(); });
    } else {
      if (loiBox) { loiBox.textContent = res.thong_bao || TXT_LOI_MANG; loiBox.style.display = 'block'; }
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-save"></i> ' + "<%= t('don.luu_mon') %>";
    }
  })
  .catch(function () {
    if (loiBox) { loiBox.textContent = TXT_LOI_MANG; loiBox.style.display = 'block'; }
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-save"></i> ' + "<%= t('don.luu_mon') %>";
  });
}

function dongChiTiet() {
  var modal = document.getElementById('modalChiTietDatBan');
  if (modal) {
    modal.classList.remove('active');
    modal.style.removeProperty('display');
    modal.style.display = 'none';
  }
}

function dongSuaDatBan() {
  var modal = document.getElementById('modalSuaDatBan');
  if (modal) {
    modal.classList.remove('active');
    modal.style.removeProperty('display');
    modal.style.display = 'none';
  }
}

function dongHuyDatBan() {
  var modal = document.getElementById('modalHuyDatBan');
  if (modal) {
    modal.classList.remove('active');
    modal.style.removeProperty('display');
    modal.style.display = 'none';
  }
}

function xuLyLuuSua(e) {
  e.preventDefault();
  var ma = document.getElementById('suaMaAn').value;
  var dt = document.getElementById('suaPhoneAn').value;
  var ngay = document.getElementById('suaNgay').value;
  var gio = document.getElementById('suaGio').value;
  var soKhach = document.getElementById('suaSoKhach').value;
  var khuVuc = document.getElementById('suaKhuVuc').value;
  var yeuCau = document.getElementById('suaYeuCau').value;

  var btn = document.getElementById('suaBtnLuu');
  var loiBox = document.getElementById('suaBaoLoi');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + TXT_DANG_LUU;
  loiBox.style.display = 'none';

  fetch('/api/dat-ban/tra-cuu/doi-lich', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      ma: ma,
      dien_thoai: dt,
      ngay: ngay,
      gio: gio,
      so_khach: Number(soKhach),
      khu_vuc: khuVuc || null,
      yeu_cau: yeuCau
    })
  })
  .then(function(res) { return res.json(); })
  .then(function(res) {
    if (res.ok) {
      nhThongBao(TXT_CAP_NHAT_OK).then(function () { window.location.reload(); });
    } else {
      loiBox.textContent = res.thong_bao || <%- JSON.stringify(t('don.d_loi_doi_lich')) %>;
      loiBox.style.display = 'block';
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-save"></i> ' + TXT_LUU_THAY_DOI;
    }
  })
  .catch(function(err) {
    loiBox.textContent = TXT_LOI_MANG;
    loiBox.style.display = 'block';
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-save"></i> ' + TXT_LUU_THAY_DOI;
  });
}

function xuLyHuyDatBan(e) {
  e.preventDefault();
  var ma = document.getElementById('huyMaAn').value;
  var dt = document.getElementById('huyPhoneAn').value;
  var lyDo = document.getElementById('huyLyDo').value;

  var btn = document.getElementById('huyBtnSubmit');
  var loiBox = document.getElementById('huyBaoLoi');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + TXT_DANG_HUY;
  loiBox.style.display = 'none';

  fetch('/api/dat-ban/tra-cuu/huy', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      ma: ma,
      dien_thoai: dt,
      ly_do: lyDo
    })
  })
  .then(function(res) { return res.json(); })
  .then(function(res) {
    if (res.ok) {
      nhThongBao(TXT_HUY_OK).then(function () { window.location.reload(); });
    } else {
      loiBox.textContent = res.thong_bao || <%- JSON.stringify(t('don.d_loi_huy')) %>;
      loiBox.style.display = 'block';
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-trash-alt"></i> ' + TXT_XAC_NHAN_HUY;
    }
  })
  .catch(function(err) {
    loiBox.textContent = TXT_LOI_MANG;
    loiBox.style.display = 'block';
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-trash-alt"></i> ' + TXT_XAC_NHAN_HUY;
  });
}
// Dong modal bang Escape
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape' || e.key === 'Esc' || e.keyCode === 27) {
    dongChiTiet();
    dongSuaDatBan();
    dongHuyDatBan();
  }
});
</script>

