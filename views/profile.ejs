<%- include('partials/header', { title: t('tai_khoan.thong_tin') }) %>

<style>
  .nh-profile-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .nh-profile-grid {
      grid-template-columns: 1fr;
    }
  }
  .nh-card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 10px 30px -10px rgba(43, 26, 18, 0.12);
    border: 1px solid rgba(0, 0, 0, 0.06);
    overflow: hidden;
    margin-bottom: 2rem;
    transition: transform 0.25s var(--nh-ease), box-shadow 0.25s var(--nh-ease);
  }
  .nh-card:hover {
    box-shadow: 0 15px 35px -10px rgba(43, 26, 18, 0.18);
  }
  .nh-card__head {
    background: linear-gradient(135deg, var(--nh-espresso) 0%, var(--nh-espresso-2) 100%);
    color: #fff;
    padding: 1.2rem 1.6rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 2px solid var(--nh-gold);
  }
  .nh-card__head h3 {
    margin: 0;
    font-size: 1.15rem;
    font-family: var(--nh-serif);
    color: var(--nh-cream);
    font-weight: 700;
  }
  .nh-card__head i {
    color: var(--nh-gold);
    font-size: 1.1rem;
  }
  .nh-card__body {
    padding: 1.8rem;
  }
  .nh-field {
    margin-bottom: 1.3rem;
  }
  .nh-field label {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--nh-espresso);
    margin-bottom: 0.4rem;
  }
  .nh-field input {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    border: 1.5px solid var(--nh-line);
    background: var(--nh-cream);
    font-family: var(--nh-sans);
    font-size: 0.95rem;
    color: var(--nh-ink);
    transition: all 0.25s var(--nh-ease);
  }
  .nh-field input:focus {
    outline: none;
    border-color: var(--nh-gold);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(200, 162, 75, 0.2);
  }
  .nh-field input:disabled {
    background: #f1ede6;
    color: #8c827a;
    cursor: not-allowed;
    border-color: transparent;
  }
  .nh-field small {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    color: var(--nh-muted);
  }
  
  /* Danh sách liên kết nhanh */
  .nh-quick-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nh-quick-list li {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .nh-quick-list li:last-child {
    border-bottom: none;
  }
  .nh-quick-list a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.2rem;
    color: var(--nh-espresso);
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
    transition: all 0.2s var(--nh-ease);
  }
  .nh-quick-list a i {
    width: 24px;
    text-align: center;
    color: var(--nh-gold);
    font-size: 1.1rem;
  }
  .nh-quick-list a:hover {
    background: var(--nh-cream);
    color: var(--nh-gold);
    transform: translateX(4px);
  }
  .nh-quick-list a.is-danger {
    color: #c0392b;
  }
  .nh-quick-list a.is-danger i {
    color: #c0392b;
  }
  .nh-quick-list a.is-danger:hover {
    background: #fdf2f2;
    color: #e74c3c;
  }
</style>

<!-- Subhero đầu trang -->
<section class="nh-subhero" style="min-height:38vh">
  <div class="nh-subhero__bg nh-wa-koshi"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('dieu_huong.tai_khoan') %></span>
    <h1><%= t('tai_khoan.thong_tin') %></h1>
    <div class="nh-crumbs">
      <a href="/"><%= t('dieu_huong.trang_chu') %></a> &nbsp;/&nbsp; <%= t('tai_khoan.thong_tin') %>
    </div>
  </div>
</section>

<section class="nh-section nh-section--cream">
  <div class="nh-container">
    <% if (typeof msg !== 'undefined' && msg) { %>
      <div class="nh-panel nh-reveal" style="border-left:4px solid <%= (typeof msgType !== 'undefined' && msgType === 'danger') ? '#c0392b' : 'var(--nh-gold)' %>; margin-bottom:2rem;">
        <div style="display:flex; gap:.9rem; align-items:center;">
          <i class="fas <%= (typeof msgType !== 'undefined' && msgType === 'danger') ? 'fa-circle-exclamation' : 'fa-circle-check' %>"
             style="color:<%= (typeof msgType !== 'undefined' && msgType === 'danger') ? '#c0392b' : 'var(--nh-gold)' %>; font-size:1.3rem"></i>
          <span><%= msg %></span>
        </div>
      </div>
    <% } %>

    <div class="nh-profile-grid">
      <!-- Cột 1: Thông tin cá nhân -->
      <div>
        <div class="nh-card nh-reveal">
          <div class="nh-card__head">
            <i class="fas fa-id-card"></i>
            <h3><%= t('tai_khoan.thong_tin') %></h3>
          </div>
          <div class="nh-card__body">
            <form action="/profile" method="POST">
              <input type="hidden" name="action" value="update">
              
              <div class="nh-field">
                <label><i class="fas fa-user mr-1 text-muted"></i> <%= t('tai_khoan.ho_va_ten') %></label>
                <input type="text" name="ten" value="<%= user.ten %>" required placeholder="Nhập họ và tên">
              </div>

              <div class="nh-field">
                <label><i class="fas fa-phone mr-1 text-muted"></i> <%= t('chung.dien_thoai') %></label>
                <input type="text" value="<%= user.sodienthoai %>" readonly disabled>
                <small><i class="fas fa-lock mr-1"></i> <%= t('tai_khoan.khong_doi_sdt') %></small>
              </div>

              <div class="nh-field">
                <label><i class="fas fa-envelope mr-1 text-muted"></i> Email</label>
                <input type="email" name="email" value="<%= user.email || '' %>" required placeholder="example@email.com">
              </div>

              <div class="nh-field">
                <label><i class="fas fa-map-marker-alt mr-1 text-muted"></i> <%= t('chung.dia_chi') %></label>
                <input type="text" name="diachi" value="<%= user.diachi || '' %>" placeholder="Số nhà, tên đường, phường/xã...">
              </div>

              <button type="submit" class="nh-btn nh-btn--gold" style="width:100%; justify-content:center; margin-top:.5rem;">
                <i class="fas fa-save"></i> <%= t('tai_khoan.luu_thong_tin') %>
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Cột 2: Đổi mật khẩu & Liên kết nhanh -->
      <div>
        <!-- Đổi mật khẩu -->
        <div class="nh-card nh-reveal" data-delay="1">
          <div class="nh-card__head">
            <i class="fas fa-shield-alt"></i>
            <h3><%= t('tai_khoan.doi_mat_khau') %></h3>
          </div>
          <div class="nh-card__body">
            <form action="/profile" method="POST">
              <input type="hidden" name="action" value="password">

              <div class="nh-field">
                <label><i class="fas fa-key mr-1 text-muted"></i> <%= t('tai_khoan.mat_khau_cu') %></label>
                <input type="password" name="old_pass" required placeholder="••••••••">
              </div>

              <div class="nh-field">
                <label><i class="fas fa-lock mr-1 text-muted"></i> <%= t('tai_khoan.mat_khau_moi') %></label>
                <input type="password" name="new_pass" minlength="6" required placeholder="Tối thiểu 6 ký tự">
              </div>

              <div class="nh-field">
                <label><i class="fas fa-check-double mr-1 text-muted"></i> <%= t('tai_khoan.xac_nhan_mat_khau_moi') %></label>
                <input type="password" name="re_pass" minlength="6" required placeholder="Nhập lại mật khẩu mới">
              </div>

              <button type="submit" class="nh-btn nh-btn--dark" style="width:100%; justify-content:center; margin-top:.5rem;">
                <i class="fas fa-sync-alt"></i> <%= t('tai_khoan.doi_mat_khau') %>
              </button>
            </form>
          </div>
        </div>

        <!-- Tiện ích tài khoản -->
        <div class="nh-card nh-reveal" data-delay="2">
          <div class="nh-card__head">
            <i class="fas fa-compass"></i>
            <h3><%= t('dieu_huong.tai_khoan') %></h3>
          </div>
          <div class="nh-card__body" style="padding: 0.6rem 0.8rem;">
            <ul class="nh-quick-list">
              <li>
                <a href="/my-orders">
                  <i class="fas fa-receipt"></i>
                  <span><%= t('tai_khoan.don_dat_ban_cua_toi') %></span>
                  <i class="fas fa-angle-right ml-auto text-muted" style="font-size:0.85rem"></i>
                </a>
              </li>
              <li>
                <a href="/thanh-vien">
                  <i class="fas fa-crown"></i>
                  <span><%= t('dieu_huong.thanh_vien') %> & Điểm thưởng</span>
                  <i class="fas fa-angle-right ml-auto text-muted" style="font-size:0.85rem"></i>
                </a>
              </li>
              <li>
                <a href="/chat">
                  <i class="fas fa-comments"></i>
                  <span><%= t('tai_khoan.chat_nhan_vien') %></span>
                  <i class="fas fa-angle-right ml-auto text-muted" style="font-size:0.85rem"></i>
                </a>
              </li>
              <li>
                <a href="/rating">
                  <i class="fas fa-star"></i>
                  <span><%= t('danh_gia.tieu_de') %></span>
                  <i class="fas fa-angle-right ml-auto text-muted" style="font-size:0.85rem"></i>
                </a>
              </li>
              <li>
                <a href="/logout" class="is-danger">
                  <i class="fas fa-sign-out-alt"></i>
                  <span><%= t('dieu_huong.dang_xuat') %></span>
                  <i class="fas fa-angle-right ml-auto text-muted" style="font-size:0.85rem"></i>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
