<%
  /*
    TRANG THEO DÕI CHO KHÁCH

    Trang duy nhất trong hệ thống mà người xem có thể không đăng nhập gì cả —
    họ vào bằng mã in trên hóa đơn. Vì thế route đã lọc dữ liệu trước khi đưa
    sang đây: không có số điện thoại shipper, không có ghi chú nội bộ, không có
    id nhân viên nào. Xem ghi chú route GET /theo-doi/:ma trong routes/vanChuyen.js.

    Bản đồ chỉ hiện khi đơn ĐANG chạy. Đơn đã giao xong mà vẫn vẽ vị trí shipper
    là để lộ họ đang ở đâu sau khi công việc đã kết thúc — không liên quan gì tới
    khách nữa.
  */
  var BUOC = ['cho_phan', 'da_phan', 'dang_lay', 'dang_giao', 'da_giao'];
  var TEN_BUOC = {
    cho_phan: t('theo_doi.b_cho_phan'), da_phan: t('theo_doi.b_da_phan'),
    dang_lay: t('theo_doi.b_dang_lay'), dang_giao: t('theo_doi.b_dang_giao'), da_giao: t('theo_doi.b_da_giao'),
  };
  var viTriBuoc = BUOC.indexOf(don.trang_thai);
  var hong = don.trang_thai === 'that_bai' || don.trang_thai === 'huy';
%>
<!DOCTYPE html>
<html lang="<%= typeof maHtml !== 'undefined' ? maHtml : 'vi' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= t('theo_doi.don_ma', { ma: don.ma_giao }) %></title>
  <meta name="theme-color" content="#2c1810">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <% if (don.dang_chay) { %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
  <% } %>
  <style>
    * { box-sizing:border-box; }
    body {
      margin:0; min-height:100vh; min-height:100dvh;
      font-family:'Plus Jakarta Sans','Nunito',sans-serif;
      background:radial-gradient(circle at 50% 0%, #3d2117 0%, #1c100b 100%);
      color:#f8fafc; -webkit-font-smoothing:antialiased;
    }
    .boc {
      max-width:540px; margin:0 auto;
      padding:calc(20px + env(safe-area-inset-top)) 18px calc(32px + env(safe-area-inset-bottom));
    }

    /* Header & Status */
    .top-nav {
      display:flex; justify-content:space-between; align-items:center;
      margin-bottom:20px; font-size:14px;
    }
    .top-nav a {
      color:#d4af37; text-decoration:none; font-weight:600;
      display:inline-flex; align-items:center; gap:6px;
      padding:6px 12px; background:rgba(212,175,55,0.1); border-radius:8px;
      border:1px solid rgba(212,175,55,0.2); transition:all .2s ease;
    }
    .top-nav a:hover { background:rgba(212,175,55,0.2); }

    .hero-box {
      text-align:center; padding:24px 20px; margin-bottom:22px;
      background:linear-gradient(180deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%);
      border:1px solid rgba(255,255,255,0.1); border-radius:20px;
      backdrop-filter:blur(12px); box-shadow:0 12px 30px rgba(0,0,0,0.3);
    }
    .hero-icon-ring {
      width:72px; height:72px; border-radius:50%;
      display:inline-flex; align-items:center; justify-content:center;
      font-size:28px; color:#fff; margin-bottom:14px;
      box-shadow:0 8px 20px rgba(0,0,0,0.35); position:relative;
    }
    .hero-icon-ring::after {
      content:''; position:absolute; inset:-4px; border-radius:50%;
      border:2px solid rgba(255,255,255,0.25);
    }
    .hero-ma {
      font-size:12px; font-weight:700; letter-spacing:2px;
      color:#d4af37; text-transform:uppercase; margin-bottom:6px;
    }
    .hero-title {
      font-size:24px; font-weight:800; margin:0 0 6px; color:#fff;
    }
    .hero-sub {
      font-size:14.5px; color:#cbd5e1; margin:0; font-weight:500;
    }
    .live-dot {
      display:inline-block; width:8px; height:8px; border-radius:50%;
      background:#10b981; margin-right:6px; animation:pulse-dot 1.5s infinite;
    }
    @keyframes pulse-dot {
      0%, 100% { box-shadow:0 0 0 0 rgba(16,185,129,0.7); }
      70% { box-shadow:0 0 0 8px rgba(16,185,129,0); }
    }

    /* Stepper Progress Bar */
    .stepper {
      display:flex; justify-content:space-between; position:relative;
      margin:26px 0 24px; padding:0 6px;
    }
    .stepper::before {
      content:''; position:absolute; top:15px; left:24px; right:24px; height:3px;
      background:rgba(255,255,255,0.12); z-index:1; border-radius:2px;
    }
    .step-item {
      position:relative; z-index:2; text-align:center; flex:1;
      display:flex; flex-direction:column; align-items:center;
    }
    .step-circle {
      width:30px; height:30px; border-radius:50%;
      background:#2c1912; border:2px solid rgba(255,255,255,0.2);
      color:rgba(255,255,255,0.4); display:flex; align-items:center; justify-content:center;
      font-size:11px; font-weight:700; transition:all .3s ease; margin-bottom:8px;
    }
    .step-label {
      font-size:11px; font-weight:600; color:rgba(255,255,255,0.5);
      line-height:1.3; max-width:70px;
    }

    .step-item.done .step-circle {
      background:#d4af37; border-color:#d4af37; color:#1a0f0a;
      box-shadow:0 0 10px rgba(212,175,55,0.4);
    }
    .step-item.done .step-label { color:#e2e8f0; font-weight:700; }

    .step-item.active .step-circle {
      background:#10b981; border-color:#10b981; color:#fff;
      box-shadow:0 0 14px rgba(16,185,129,0.6);
      animation:pulse-active 1.8s infinite;
    }
    .step-item.active .step-label {
      color:#34d399; font-weight:800; transform:scale(1.05);
    }
    @keyframes pulse-active {
      0%, 100% { transform:scale(1); }
      50% { transform:scale(1.12); }
    }

    /* Map Box */
    #ban-do {
      height:260px; border-radius:18px; margin-bottom:18px;
      border:1px solid rgba(255,255,255,0.15); box-shadow:0 8px 24px rgba(0,0,0,0.35);
      overflow:hidden; z-index:1;
    }

    /* Glass Cards */
    .card {
      background:rgba(255,255,255,0.05);
      border:1px solid rgba(255,255,255,0.09);
      border-radius:18px; padding:18px 20px; margin-bottom:16px;
      backdrop-filter:blur(8px);
    }
    .card-header {
      display:flex; align-items:center; gap:8px; margin-bottom:14px;
    }
    .card-icon {
      font-size:13px; color:#d4af37;
    }
    .card-title {
      font-size:13px; font-weight:800; text-transform:uppercase;
      letter-spacing:1px; color:#94a3b8; margin:0;
    }

    /* Delivery Info */
    .dia-chi-box {
      font-size:16px; font-weight:700; color:#fff; line-height:1.45;
      margin-bottom:10px; display:flex; align-items:flex-start; gap:8px;
    }
    .dia-chi-box i { color:#ef4444; margin-top:3px; flex-shrink:0; }
    
    .info-sub {
      font-size:13.5px; color:#cbd5e1; display:flex; flex-wrap:wrap; gap:12px;
      padding-top:6px; border-top:1px solid rgba(255,255,255,0.06);
    }
    .info-sub span { display:inline-flex; align-items:center; gap:5px; }
    .info-sub i { color:#d4af37; }

    .ghi-chu-box {
      margin-top:12px; padding:10px 14px; border-radius:10px;
      background:rgba(234,179,8,0.12); border-left:3px solid #eab308;
      font-size:13px; color:#fef08a; line-height:1.4;
    }
    .shipper-box {
      margin-top:12px; padding:10px 14px; border-radius:10px;
      background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.25);
      font-size:13.5px; color:#6ee7b7; display:flex; align-items:center; gap:8px;
    }

    /* Order Items */
    .item-row {
      display:flex; justify-content:space-between; align-items:center;
      padding:8px 0; font-size:14px; border-bottom:1px dashed rgba(255,255,255,0.08);
    }
    .item-row:last-child { border-bottom:none; }
    .item-name { font-weight:600; color:#f1f5f9; }
    .item-qty { color:#94a3b8; font-size:13px; margin-left:4px; }
    .item-price { font-weight:600; color:#e2e8f0; }

    .total-row {
      display:flex; justify-content:space-between; align-items:center;
      padding:14px 0 4px; margin-top:8px; border-top:1px solid rgba(255,255,255,0.12);
      font-size:18px; font-weight:800; color:#d4af37;
    }

    /* Timeline Log */
    .timeline {
      position:relative; padding-left:18px; margin:4px 0;
    }
    .timeline::before {
      content:''; position:absolute; top:6px; bottom:6px; left:5px; width:2px;
      background:rgba(255,255,255,0.1);
    }
    .timeline-item {
      position:relative; margin-bottom:14px; font-size:13.5px;
    }
    .timeline-item:last-child { margin-bottom:0; }
    .timeline-dot {
      position:absolute; left:-18px; top:4px; width:12px; height:12px;
      border-radius:50%; border:2px solid #1c100b;
    }
    .timeline-title { font-weight:700; color:#f1f5f9; }
    .timeline-time { font-size:12px; color:#94a3b8; margin-top:2px; }

    /* Footer */
    .footer-actions {
      text-align:center; font-size:13px; color:#94a3b8; margin-top:24px; line-height:1.8;
    }
    .footer-actions a {
      color:#d4af37; text-decoration:none; font-weight:600;
      transition:color .2s ease;
    }
    .footer-actions a:hover { color:#fef08a; text-decoration:underline; }
  </style>
</head>
<body>
<div class="boc">

  <!-- Top Nav Bar -->
  <div class="top-nav">
    <a href="/cart"><i class="fas fa-chevron-left"></i> Giỏ hàng &amp; Đơn của tôi</a>
    <a href="/"><i class="fas fa-house"></i> Trang chủ</a>
  </div>

  <!-- Hero Status Card -->
  <div class="hero-box">
    <div class="hero-icon-ring" style="background:<%= don.mau %>">
      <i class="fas <%= don.icon %>"></i>
    </div>
    <div class="hero-ma"><%= don.ma_giao %></div>
    <h1 class="hero-title" id="tt-nhan"><%= don.nhan %></h1>
    <p class="hero-sub" id="tt-phu">
      <% if (don.trang_thai === 'dang_giao') { %>
        <span class="live-dot"></span><%= t('theo_doi.dang_toi') %>
      <% } else if (don.trang_thai === 'da_giao') { %>
        <%= t('theo_doi.cam_on') %>
      <% } else if (don.du_kien_luc && !don.da_xong) { %>
        <%= t('theo_doi.du_kien') %>
        <b style="color:#d4af37;"><%= new Date(don.du_kien_luc).toLocaleTimeString('vi-VN', {hour:'2-digit', minute:'2-digit'}) %></b>
      <% } %>
    </p>
  </div>

  <% if (hong) { %>
    <div style="background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.3); color:#fca5a5; border-radius:14px; padding:16px; font-size:14px; line-height:1.6; margin-bottom:16px;">
      <strong style="font-size:15px;"><i class="fas fa-triangle-exclamation"></i> <%= t('theo_doi.that_bai') %></strong><br>
      <%= t('theo_doi.that_bai_mo_ta') %>
    </div>
  <% } else { %>
    <!-- Stepper Indicator -->
    <div class="stepper">
      <% BUOC.forEach(function (b, i) { %>
        <div class="step-item <%= i < viTriBuoc ? 'done' : (i === viTriBuoc ? 'active' : '') %>">
          <div class="step-circle">
            <% if (i < viTriBuoc) { %>
              <i class="fas fa-check"></i>
            <% } else { %>
              <span><%= i + 1 %></span>
            <% } %>
          </div>
          <div class="step-label"><%= TEN_BUOC[b] %></div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% if (don.dang_chay && don.vi_do !== null) { %>
    <div id="ban-do"></div>
  <% } %>

  <!-- Delivery Info -->
  <div class="card">
    <div class="card-header">
      <i class="fas fa-location-arrow card-icon"></i>
      <h2 class="card-title"><%= t('theo_doi.giao_toi') %></h2>
    </div>
    <div class="dia-chi-box">
      <i class="fas fa-location-dot"></i>
      <span><%= don.dia_chi_giao %></span>
    </div>
    <div class="info-sub">
      <span><i class="fas fa-user"></i> <%= don.ten_nguoi_nhan %></span>
      <% if (don.sdt_nguoi_nhan) { %>
        <span><i class="fas fa-phone"></i> <%= don.sdt_nguoi_nhan %></span>
      <% } %>
      <% if (don.khoang_cach_km !== null) { %>
        <span><i class="fas fa-route"></i> <%= t('theo_doi.cach_nha_hang', { km: don.khoang_cach_km }) %></span>
      <% } %>
    </div>
    <% if (don.ghi_chu) { %>
      <div class="ghi-chu-box">
        <i class="fas fa-note-sticky"></i> <b>Ghi chú:</b> <%= don.ghi_chu %>
      </div>
    <% } %>
    <% if (don.ten_shipper && !don.da_xong) { %>
      <div class="shipper-box">
        <i class="fas fa-motorcycle" style="font-size:16px;"></i>
        <span><strong><%= don.ten_shipper %></strong> <%= t('theo_doi.dang_cam_don') %> <% if (don.ten_dv) { %>(<%= don.ten_dv %>)<% } %></span>
      </div>
    <% } %>
  </div>

  <!-- Order Items -->
  <div class="card">
    <div class="card-header">
      <i class="fas fa-bag-shopping card-icon"></i>
      <h2 class="card-title"><%= t('theo_doi.don_hang') %></h2>
    </div>
    <% (mon || []).forEach(function (m) { %>
      <div class="item-row">
        <div>
          <span class="item-name"><%= tenMon(m).chinh %></span>
          <span class="item-qty">× <%= m.soluong %></span>
        </div>
        <span class="item-price"><%= formatMoney(m.thanhtien) %>đ</span>
      </div>
    <% }) %>
    <div class="item-row">
      <span style="color:#94a3b8;"><%= t('dat_ban.phi_giao') %></span>
      <span class="item-price"><%= don.phi_giao > 0 ? formatMoney(don.phi_giao) + 'đ' : t('chung.mien_phi') %></span>
    </div>
    <div class="total-row">
      <span><%= t('chung.tong_cong') %></span>
      <span><%= formatMoney(don.tong_thu) %>đ</span>
    </div>
    <% if (don.tien_thu_ho > 0) { %>
      <p style="margin:8px 0 0; font-size:12.5px; color:#cbd5e1; text-align:right;">
        <i class="fas fa-money-bill-wave" style="color:#10b981;"></i> <%= t('theo_doi.tra_tien_mat') %>
      </p>
    <% } %>
  </div>

  <!-- Timeline Log -->
  <div class="card">
    <div class="card-header">
      <i class="fas fa-clock-rotate-left card-icon"></i>
      <h2 class="card-title"><%= t('theo_doi.dien_bien') %></h2>
    </div>
    <div class="timeline">
      <% (lichSu || []).forEach(function (n) { %>
        <div class="timeline-item">
          <span class="timeline-dot" style="background:<%= n.mau %>"></span>
          <div class="timeline-title"><%= n.nhan %></div>
          <div class="timeline-time"><%= new Date(n.luc).toLocaleString('vi-VN') %></div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Footer Actions -->
  <div class="footer-actions">
    <p style="margin:0 0 6px;"><i class="fas fa-rotate" style="margin-right:4px;"></i> <%= t('theo_doi.tu_cap_nhat') %></p>
  </div>
</div>
</div>

<% if (don.dang_chay) { %>
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
<script>
(function () {
  'use strict';

  var MA = '<%= don.ma_giao %>';
  var DIEM = <%- JSON.stringify(don.vi_do !== null ? [don.vi_do, don.kinh_do] : null) %>;
  var NHA_HANG = <%- JSON.stringify(nhaHang ? [nhaHang.vi_do, nhaHang.kinh_do] : null) %>;
  var SHIPPER = <%- JSON.stringify(don.shipper_vi_do !== null && don.shipper_vi_do !== undefined
                    ? [don.shipper_vi_do, don.shipper_kinh_do] : null) %>;

  var chamShipper = null;
  var ban_do = null;

  if (DIEM && document.getElementById('ban-do') && typeof L !== 'undefined') {
    ban_do = L.map('ban-do', { zoomControl: false, attributionControl: false });
    L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', { maxZoom: 20 }).addTo(ban_do);

    function cham(mau, hinh) {
      return L.divIcon({
        className: '',
        html: '<div style="display:flex;align-items:center;justify-content:center;width:30px;' +
              'height:30px;border-radius:50%;background:' + mau + ';color:#fff;font-size:14px;' +
              'border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.4)">' +
              '<i class="fas ' + hinh + '"></i></div>',
        iconSize: [30, 30], iconAnchor: [15, 15],
      });
    }

    var diem = [DIEM];
    L.marker(DIEM, { icon: cham('#e74a3b', 'fa-house') }).addTo(ban_do);
    if (NHA_HANG) { L.marker(NHA_HANG, { icon: cham('#2c1810', 'fa-utensils') }).addTo(ban_do); diem.push(NHA_HANG); }
    if (SHIPPER) {
      chamShipper = L.marker(SHIPPER, { icon: cham('#1cc88a', 'fa-motorcycle'), zIndexOffset: 400 }).addTo(ban_do);
      diem.push(SHIPPER);
    }
    ban_do.fitBounds(L.latLngBounds(diem), { padding: [34, 34] });
  }

  if (typeof io === 'undefined') return;
  var socket = io({ transports: ['websocket', 'polling'] });

  /*
    Xin vào phòng theo dõi bằng chính mã đơn.

    Máy chủ kiểm tra mã và chỉ cho vào nếu đơn còn đang chạy; sau đó nó đẩy toạ
    độ shipper xuống mỗi khi có nhịp mới. Phải xin lại sau mỗi lần kết nối lại
    ('connect' bắn cả lần đầu lẫn các lần nối lại) — mất sóng thang máy xong mà
    không xin lại thì chấm sẽ đứng im vĩnh viễn.
  */
  socket.on('connect', function () {
    socket.emit('giao-hang:theo-doi', MA, function (kq) {
      if (!kq || !kq.ok) console.warn('[theo dõi]', kq && kq.loi);
    });
  });

  socket.on('giao-hang:vi-tri', function (d) {
    if (!ban_do) return;
    var toa = [d.vi_do, d.kinh_do];
    if (chamShipper) {
      chamShipper.setLatLng(toa);
    } else {
      chamShipper = L.marker(toa, {
        icon: L.divIcon({
          className: '',
          html: '<div style="display:flex;align-items:center;justify-content:center;width:30px;' +
                'height:30px;border-radius:50%;background:#1cc88a;color:#fff;font-size:14px;' +
                'border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.4)">' +
                '<i class="fas fa-motorcycle"></i></div>',
          iconSize: [30, 30], iconAnchor: [15, 15],
        }),
        zIndexOffset: 400,
      }).addTo(ban_do);
    }
  });

  /*
    Đổi trạng thái thì tải lại cả trang thay vì vá từng mảnh.

    Trang này có tiến trình, nhật ký, bản đồ và cả phần chân — vá tay từng chỗ
    là bốn cơ hội để chúng nói bốn điều khác nhau. Một lần tải lại vài chục
    kilobyte, xảy ra đúng bốn lần trong cả vòng đời một đơn hàng.
  */
  socket.on('giao-hang:doi-trang-thai', function () {
    setTimeout(function () { location.reload(); }, 900);
  });
})();
</script>
<% } %>
</body>
</html>
