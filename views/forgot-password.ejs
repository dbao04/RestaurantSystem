<%- include('partials/header', { title: t('tai_khoan.quen_mat_khau_tieu_de') }) %>

<section class="nh-subhero" style="min-height: 28vh;">
  <div class="nh-subhero__bg nh-wa-koshi"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('dieu_huong.tai_khoan') %></span>
    <h1><%= t('tai_khoan.quen_mat_khau_tieu_de') %></h1>
    <div class="nh-crumbs">
      <a href="/"><%= t('dieu_huong.trang_chu') %></a> &nbsp;/&nbsp; <%= t('tai_khoan.quen_mat_khau_tieu_de') %>
    </div>
  </div>
</section>

<section class="nh-section nh-section--cream">
  <div class="nh-auth-wrapper">
    <div class="nh-auth-card nh-reveal">
      <div class="nh-auth-header">
        <div class="nh-auth-icon">
          <i class="fas fa-key"></i>
        </div>
        <h2 class="nh-auth-title"><%= t('tai_khoan.lay_lai') %></h2>
        <p class="nh-auth-subtitle"><%= t('tai_khoan.nhap_email_khoi_phuc') %></p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="nh-auth-alert nh-auth-alert--danger">
          <i class="fas fa-circle-exclamation"></i>
          <span><%- error %></span>
        </div>
      <% } %>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="nh-auth-alert nh-auth-alert--success">
          <i class="fas fa-circle-check"></i>
          <span><%- message %></span>
        </div>
      <% } %>

      <form action="/forgot-password" method="post">
        <div class="nh-auth-group">
          <label class="nh-auth-label"><%= t('tai_khoan.email_dang_ky') %></label>
          <div class="nh-auth-input-wrap">
            <i class="fas fa-envelope"></i>
            <input type="email" name="email" class="nh-auth-input" placeholder="Nhập địa chỉ email của bạn" required autofocus>
          </div>
        </div>

        <button type="submit" class="nh-auth-btn">
          <i class="fas fa-paper-plane"></i> <%= t('tai_khoan.khoi_phuc_nut') %>
        </button>

        <div class="nh-auth-footer">
          <div>
            <span><%= t('tai_khoan.quay_lai_trang') %></span>
            <a href="/login" class="nh-auth-link" style="color: var(--nh-gold);"><%= t('tai_khoan.dang_nhap') %></a>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
