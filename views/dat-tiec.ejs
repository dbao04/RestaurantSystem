<%- include('partials/header', { title: t('dat_tiec.tieu_de') }) %>
<%
/*
  DAT TIEC ONLINE - Sanh Gala (services/datTiecQuyTrinh.js).

  Sau buoc, moi buoc mo khi buoc truoc hop le:
    1 Chinh sach (bat buoc dong y) -> 2 Loai tiec + so khach (it hon toi thieu -> sang Dat ban)
    -> 3 Ngay (lich thang, ngay kin to do) + gio (gio trong xanh, gio da co tiec do)
    -> 4 Thuc don co san / tuy chinh -> 5 Dich vu -> 6 Lien he & xac nhan.
  Du toan tren trinh duyet chi de xem; may chu tinh lai tu CSDL khi luu.
*/
var vnd = function (n) { return Math.round(Number(n || 0)).toLocaleString('vi-VN') + 'đ'; };
var donVi = { GOI: 'gói', BAN: 'bàn', KHACH: 'khách' };
%>
<style>
  .dtw { --dt-ok: #1f7a4a; --dt-ok-nen: #e7f4ec; --dt-do: #b3352c; --dt-do-nen: #fbe9e7; --dt-cam: #b45309; --dt-cam-nen: #fff1dc; }
  [data-theme="dark"] .dtw { --dt-ok: #4ade80; --dt-ok-nen: rgba(74,222,128,.12); --dt-do: #f87171; --dt-do-nen: rgba(248,113,113,.14); --dt-cam: #fbbf24; --dt-cam-nen: rgba(251,191,36,.13); }
  .dtw { padding: 2.2rem 0 4rem; }
  .dtw__luoi { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 1.6rem; align-items: start; }
  .dtw__buoc { list-style: none; display: flex; gap: .4rem; padding: 0; margin: 0 0 1.4rem; overflow-x: auto; }
  .dtw__buoc li { flex: 1 0 auto; min-width: 92px; text-align: center; font-size: .78rem; color: var(--nh-muted); }
  .dtw__buoc li b { display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; margin: 0 auto .3rem; border-radius: 50%;
    border: 2px solid var(--nh-line); background: var(--nh-surface); color: var(--nh-muted); font-size: .85rem; }
  .dtw__buoc li.xong b { background: var(--nh-gold); border-color: var(--nh-gold); color: #fff; }
  .dtw__buoc li.dang { color: var(--nh-ink); font-weight: 700; }
  .dtw__buoc li.dang b { border-color: var(--nh-gold); color: var(--nh-gold); }
  .dtw__the { background: var(--nh-surface); border: 1px solid var(--nh-line); border-radius: 16px; padding: 1.4rem 1.5rem; }
  .dtw__the h2 { font-family: var(--nh-serif); font-size: 1.45rem; margin: 0 0 .3rem; color: var(--nh-ink); }
  .dtw__the > p.phu { color: var(--nh-muted); margin: 0 0 1.1rem; }
  .dtw__buoc-nd[hidden] { display: none !important; }
  .dtw__nav { display: flex; justify-content: space-between; gap: .6rem; margin-top: 1.4rem; flex-wrap: wrap; }
  .dtw__btn { border: 0; border-radius: 10px; padding: .7rem 1.3rem; font-weight: 700; cursor: pointer; font-size: .95rem; }
  .dtw__btn--chinh { background: var(--nh-gold); color: #fff; }
  .dtw__btn--chinh:disabled { opacity: .45; cursor: not-allowed; }
  .dtw__btn--phu { background: transparent; color: var(--nh-ink); border: 1px solid var(--nh-line); }
  .dtw__btn:focus-visible, .dtw button:focus-visible { outline: 2px solid var(--nh-gold); outline-offset: 2px; }
  /* chinh sach */
  .cs-muc { border: 1px solid var(--nh-line); border-radius: 12px; margin-bottom: .6rem; overflow: hidden; }
  .cs-muc summary { cursor: pointer; padding: .8rem 1rem; font-weight: 700; color: var(--nh-ink); list-style: none; display: flex; justify-content: space-between; }
  .cs-muc summary::after { content: '+'; color: var(--nh-gold); font-size: 1.2rem; line-height: 1; }
  .cs-muc[open] summary::after { content: '–'; }
  .cs-muc ul { margin: 0; padding: 0 1rem 1rem 2.1rem; color: var(--nh-ink); line-height: 1.6; font-size: .93rem; }
  .cs-dongy { display: flex; gap: .6rem; align-items: flex-start; margin-top: 1rem; padding: .9rem 1rem; border-radius: 12px; background: var(--nh-surface-subtle, rgba(0,0,0,.03)); }
  .cs-dongy input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--nh-gold); }
  /* loai tiec */
  .lt-luoi { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: .7rem; }
  .lt { text-align: left; border: 2px solid var(--nh-line); background: var(--nh-surface); border-radius: 12px; padding: .9rem; cursor: pointer; color: var(--nh-ink); }
  .lt i { color: var(--nh-gold); font-size: 1.2rem; }
  .lt b { display: block; margin: .35rem 0 .2rem; }
  .lt small { color: var(--nh-muted); line-height: 1.4; display: block; }
  .lt[aria-checked="true"] { border-color: var(--nh-gold); box-shadow: 0 0 0 3px rgba(200,162,75,.2); }
  .o-nhap { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: .8rem; margin-top: 1rem; }
  .o-nhap label { display: block; font-weight: 600; font-size: .88rem; margin-bottom: .3rem; color: var(--nh-ink); }
  .o-nhap input, .o-nhap textarea, .o-nhap select { width: 100%; padding: .6rem .75rem; border: 1px solid var(--nh-line); border-radius: 10px; background: var(--nh-bg); color: var(--nh-ink); font: inherit; }
  .bao { padding: .85rem 1rem; border-radius: 12px; margin-top: 1rem; line-height: 1.5; font-size: .93rem; }
  .bao--do { background: var(--dt-do-nen); color: var(--dt-do); }
  .bao--ok { background: var(--dt-ok-nen); color: var(--dt-ok); }
  .bao--cam { background: var(--dt-cam-nen); color: var(--dt-cam); }
  .bao a.dtw__btn { display: inline-block; margin-top: .6rem; text-decoration: none; }
  /* lich */
  .lich-dau { display: flex; align-items: center; justify-content: space-between; margin-bottom: .6rem; }
  .lich-dau b { font-family: var(--nh-serif); font-size: 1.15rem; color: var(--nh-ink); }
  .lich-dau button { border: 1px solid var(--nh-line); background: var(--nh-surface); color: var(--nh-ink); border-radius: 8px; width: 38px; height: 34px; cursor: pointer; }
  .lich { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; }
  .lich .th { text-align: center; font-size: .72rem; color: var(--nh-muted); font-weight: 700; padding: .2rem 0; }
  .lich button.ng { height: 54px; border: 1px solid var(--nh-line); border-radius: 9px; background: var(--nh-surface); color: var(--nh-ink); cursor: pointer;
    font-weight: 600; font-size: .92rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; padding: 0; }
  .lich button.ng small { font-size: .6rem; font-weight: 600; }
  .lich .ng--trong small { color: var(--dt-ok); }
  .lich .ng--mot_buoi { background: var(--dt-cam-nen); }
  .lich .ng--mot_buoi small { color: var(--dt-cam); }
  .lich .ng--kin { background: var(--dt-do-nen); color: var(--dt-do); border-color: transparent; cursor: not-allowed; }
  .lich .ng--khong_nhan { opacity: .35; cursor: not-allowed; }
  .lich .ng.chon { outline: 3px solid var(--nh-gold); outline-offset: -1px; }
  .chu-giai { display: flex; flex-wrap: wrap; gap: .9rem; font-size: .78rem; color: var(--nh-muted); margin-top: .6rem; }
  .chu-giai span::before { content: ''; display: inline-block; width: 11px; height: 11px; border-radius: 3px; margin-right: 5px; vertical-align: -1px; border: 1px solid var(--nh-line); }
  .chu-giai .c1::before { background: var(--nh-surface); } .chu-giai .c2::before { background: var(--dt-cam-nen); } .chu-giai .c3::before { background: var(--dt-do-nen); } .chu-giai .c4::before { opacity: .35; }
  .buoi-luoi { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: .8rem; margin-top: 1rem; }
  .buoi { border: 1px solid var(--nh-line); border-radius: 12px; padding: .9rem; }
  .buoi--kin { background: var(--dt-do-nen); border-color: transparent; }
  .buoi h4 { margin: 0 0 .2rem; font-size: 1rem; color: var(--nh-ink); }
  .buoi p { margin: 0 0 .6rem; font-size: .8rem; color: var(--nh-muted); }
  .gio-luoi { display: flex; flex-wrap: wrap; gap: .4rem; }
  .gio { border: 1.5px solid var(--dt-ok); color: var(--dt-ok); background: var(--dt-ok-nen); border-radius: 8px; padding: .4rem .7rem; font-weight: 700; cursor: pointer; font-variant-numeric: tabular-nums; }
  .gio[aria-pressed="true"] { background: var(--dt-ok); color: #fff; }
  .gio:disabled { border-color: var(--dt-do); color: var(--dt-do); background: transparent; cursor: not-allowed; text-decoration: line-through; }
  /* thuc don */
  .td-luoi { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: .9rem; }
  .td { text-align: left; border: 2px solid var(--nh-line); background: var(--nh-surface); border-radius: 14px; padding: 0; cursor: pointer; color: var(--nh-ink); overflow: hidden; display: flex; flex-direction: column; }
  .td[aria-checked="true"] { border-color: var(--nh-gold); box-shadow: 0 0 0 3px rgba(200,162,75,.22); }
  .td__anh { position: relative; aspect-ratio: 16 / 10; background: var(--nh-line); }
  .td__anh img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .td__chon { position: absolute; top: .55rem; right: .55rem; width: 30px; height: 30px; border-radius: 50%; background: var(--nh-gold); color: #fff; display: none; align-items: center; justify-content: center; font-size: .85rem; box-shadow: 0 2px 8px rgba(0,0,0,.25); }
  .td[aria-checked="true"] .td__chon { display: flex; }
  .td[hidden] { display: none !important; }
  .td-them { margin-top: .8rem; }
  .td__dai { display: flex; gap: 3px; padding: 3px; background: var(--nh-surface); }
  .td__dai img { flex: 1; min-width: 0; height: 38px; object-fit: cover; border-radius: 5px; }
  .td__than { padding: .7rem .85rem .85rem; }
  .td b { display: block; font-size: .98rem; } .td .gia { color: var(--nh-gold); font-weight: 700; font-variant-numeric: tabular-nums; }
  .td small { color: var(--nh-muted); display: block; }
  .chon-ban { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; margin-top: .8rem; padding: .8rem 1rem; border: 1px solid var(--nh-line); border-radius: 12px; background: var(--nh-surface); }
  .chon-ban[hidden] { display: none !important; }
  .chon-ban b { display: block; color: var(--nh-ink); } .chon-ban small { color: var(--nh-muted); }
  .chon-ban__nut { display: flex; align-items: center; gap: .5rem; }
  .chon-ban__nut button { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--nh-gold); background: transparent; color: var(--nh-gold); font-size: 1.25rem; line-height: 1; cursor: pointer; }
  .chon-ban__nut button:disabled { opacity: .35; cursor: not-allowed; }
  .chon-ban__nut output { min-width: 2.5rem; text-align: center; font-size: 1.35rem; font-weight: 700; color: var(--nh-ink); font-variant-numeric: tabular-nums; }
  .chon-ban__mo-ta { flex-basis: 100%; }
  .huong { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: .8rem; margin-bottom: 1.1rem; }
  .huong__the { display: flex; gap: .8rem; align-items: flex-start; text-align: left; border: 2px solid var(--nh-line); background: var(--nh-surface); color: var(--nh-ink); border-radius: 14px; padding: .95rem 1rem; cursor: pointer; font: inherit; }
  .huong__the:hover { border-color: rgba(200,162,75,.6); }
  .huong__the[aria-checked="true"] { border-color: var(--nh-gold); box-shadow: 0 0 0 3px rgba(200,162,75,.22); }
  .huong__ic { flex: 0 0 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(200,162,75,.15); color: var(--nh-gold); font-size: 1.15rem; }
  .huong__the b { display: block; font-size: 1rem; margin-bottom: .15rem; }
  .huong__the small { display: block; color: var(--nh-muted); line-height: 1.45; }
  .huong__the em { display: inline-block; margin-top: .4rem; font-style: normal; font-size: .74rem; font-weight: 700; padding: .12rem .5rem; border-radius: 999px; background: rgba(46,125,50,.12); color: #2e7d32; }
  .huong__the em.cho { background: rgba(230,126,34,.14); color: #b35c00; }
  .huong-nd[hidden] { display: none !important; }
  .tc-dem { display: flex; justify-content: space-between; align-items: center; gap: .6rem; flex-wrap: wrap; padding: .6rem .8rem; border-radius: 10px; background: var(--nh-surface-subtle, rgba(0,0,0,.04)); margin: .2rem 0 .6rem; font-size: .9rem; }
  .tc-dem b { font-variant-numeric: tabular-nums; }
  .tc-mau { margin: .4rem 0 1rem; }
  .tc-mau > p { margin: 0 0 .5rem; font-weight: 700; color: var(--nh-ink); }
  .tc-mau > p small { font-weight: 400; color: var(--nh-muted); }
  .mau-dai { display: flex; gap: .6rem; overflow-x: auto; padding: 2px 2px .5rem; scroll-snap-type: x proximity; }
  .mau { flex: 0 0 150px; scroll-snap-align: start; text-align: left; padding: 0; border: 2px solid var(--nh-line); border-radius: 12px; overflow: hidden; background: var(--nh-surface); color: var(--nh-ink); cursor: pointer; font: inherit; }
  .mau[aria-pressed="true"] { border-color: var(--nh-gold); box-shadow: 0 0 0 3px rgba(200,162,75,.22); }
  .mau img { display: block; width: 100%; height: 84px; object-fit: cover; }
  .mau span { display: block; padding: .4rem .55rem .5rem; font-size: .8rem; line-height: 1.3; }
  .mau span b { display: block; font-size: .84rem; }
  .mau span small { color: var(--nh-muted); }
  .mau-xem { border: 1px dashed rgba(200,162,75,.6); border-radius: 14px; padding: .9rem; margin-top: .4rem; }
  .mau-xem[hidden] { display: none !important; }
  .mau-xem__dau { display: flex; gap: .8rem; align-items: center; margin-bottom: .3rem; }
  .mau-xem__dau img { width: 96px; height: 64px; object-fit: cover; border-radius: 10px; flex: 0 0 auto; }
  .mau-xem__dau b { display: block; font-size: 1rem; color: var(--nh-ink); }
  .mau-xem__dau small { color: var(--nh-muted); }
  .mon-chon { position: relative; cursor: pointer; }
  .mon-chon input { position: absolute; top: .45rem; left: .45rem; width: 20px; height: 20px; accent-color: #c8a24b; z-index: 1; }
  .mon-chon:has(input:not(:checked)) .mon__anh img { filter: grayscale(.85); opacity: .55; }
  .mon-chon.khong-co { cursor: not-allowed; }
  .mon-chon.khong-co .mon__anh img { filter: grayscale(1); opacity: .45; }
  .mon__nhan { display: block; font-size: .72rem; font-weight: 600; color: var(--nh-muted); }
  .mon__nhan.da { color: #2e7d32; }
  .mau-xem__nut { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; justify-content: space-between; margin-top: .9rem; }
  .mau-xem__nut small { color: var(--nh-muted); }
  .mon-nhom { margin-top: .9rem; }
  .mon-nhom > b { display: block; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--nh-gold); margin-bottom: .45rem; }
  .mon-luoi { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .6rem; }
  .mon { position: relative; border: 1px solid var(--nh-line); border-radius: 12px; overflow: hidden; background: var(--nh-surface); color: var(--nh-ink); text-align: left; padding: 0; font: inherit; }
  button.mon { cursor: pointer; }
  .mon__anh { aspect-ratio: 4 / 3; background: var(--nh-surface-subtle, rgba(0,0,0,.05)); display: flex; align-items: center; justify-content: center; color: var(--nh-gold); font-size: 1.4rem; }
  .mon__anh img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mon__ten { padding: .45rem .55rem .55rem; font-size: .84rem; line-height: 1.35; font-weight: 600; }
  .mon__ten small { display: block; color: var(--nh-gold); font-weight: 700; font-variant-numeric: tabular-nums; }
  .mon.bo .mon__anh::after { content: 'Đã bỏ'; position: absolute; inset: 0 0 auto 0; aspect-ratio: 4 / 3; background: rgba(20,12,8,.62); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; letter-spacing: .05em; }
  .mon.bo .mon__ten { text-decoration: line-through; color: var(--nh-muted); }
  .mon__nut { position: absolute; top: .4rem; right: .4rem; border: 0; border-radius: 999px; padding: .2rem .55rem; font-size: .72rem; font-weight: 700; background: rgba(255,255,255,.92); color: #1f1a17; }
  .mon.bo .mon__nut { background: var(--nh-gold); color: #fff; }
  .mon__them { display: block; width: calc(100% - 1.1rem); margin: 0 .55rem .55rem; border: 1px solid var(--nh-gold); background: transparent; color: var(--nh-gold); border-radius: 8px; padding: .3rem; font-weight: 700; cursor: pointer; font-size: .8rem; }
  .mon__them:disabled { background: var(--nh-gold); color: #fff; cursor: default; }
  .td-ct { margin-top: 1rem; border: 1px dashed var(--nh-line); border-radius: 12px; padding: 1rem; }
  .td-mon { list-style: none; padding: 0; margin: .4rem 0 0; display: grid; gap: .3rem; }
  .td-mon label { display: flex; gap: .5rem; align-items: center; font-size: .9rem; color: var(--nh-ink); }
  .td-mon .bo { text-decoration: line-through; color: var(--nh-muted); }
  .td-mon em { font-style: normal; color: var(--nh-muted); font-size: .75rem; min-width: 70px; }
  .tc-bat { display: flex; align-items: center; gap: .5rem; margin-top: .9rem; font-weight: 600; color: var(--nh-ink); }
  .tc-bat input { width: 18px; height: 18px; accent-color: var(--nh-gold); }
  .them-mon { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: .6rem; }
  .them-mon input, .them-mon select { padding: .5rem .65rem; border: 1px solid var(--nh-line); border-radius: 8px; background: var(--nh-bg); color: var(--nh-ink); font: inherit; }
  .them-mon input[type=search] { flex: 1 1 220px; }
  .ds-them { list-style: none; padding: 0; margin: .6rem 0 0; display: grid; gap: .35rem; }
  .ds-them li { display: flex; justify-content: space-between; gap: .6rem; align-items: center; font-size: .88rem; padding: .4rem .6rem; border-radius: 10px; background: var(--nh-surface-subtle, rgba(0,0,0,.03)); color: var(--nh-ink); }
  .ds-them li img { width: 44px; height: 44px; object-fit: cover; border-radius: 8px; flex: 0 0 auto; }
  .ds-them li .tt-mon { display: flex; align-items: center; gap: .6rem; min-width: 0; }
  .them-luoi { margin-top: .7rem; max-height: 520px; overflow: auto; padding-right: 2px; }
  .ds-them button { border: 0; background: none; color: var(--dt-do); cursor: pointer; font-size: 1rem; }
  .ds-them .sl { display: inline-flex; align-items: center; gap: .3rem; }
  .ds-them .sl button { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--nh-gold); color: var(--nh-gold); font-size: 1rem; line-height: 1; padding: 0; }
  .ds-them .sl button:disabled { opacity: .35; cursor: not-allowed; }
  .ds-them .sl output { min-width: 1.6rem; text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }
  .ds-them .ben-phai { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; justify-content: flex-end; }
  .ds-them .tien { min-width: 6.5rem; text-align: right; font-variant-numeric: tabular-nums; }
  @media (max-width: 575px) {
    .ds-them li { flex-wrap: wrap; }
    .ds-them .tt-mon { flex: 1 1 100%; }
    .ds-them .ben-phai { flex: 1 1 100%; justify-content: space-between; flex-wrap: nowrap; padding-left: calc(44px + .6rem); }
    .ds-them .tien { min-width: 0; margin-left: auto; }
  }
  .goi-y { list-style: none; margin: .3rem 0 0; padding: 0; max-height: 210px; overflow: auto; border: 1px solid var(--nh-line); border-radius: 8px; }
  .goi-y button { width: 100%; text-align: left; border: 0; background: var(--nh-surface); color: var(--nh-ink); padding: .45rem .7rem; cursor: pointer; display: flex; justify-content: space-between; font-size: .86rem; }
  .goi-y button:hover { background: var(--nh-surface-subtle, rgba(0,0,0,.04)); }
  /* dich vu */
  .dv-luoi { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: .6rem; }
  .dv { display: flex; gap: .65rem; align-items: flex-start; border: 1px solid var(--nh-line); border-radius: 12px; padding: .75rem .85rem; cursor: pointer; color: var(--nh-ink); }
  .dv input { width: 18px; height: 18px; margin-top: 3px; accent-color: var(--nh-gold); }
  .dv b { display: block; font-size: .92rem; }
  .dv small { color: var(--nh-muted); display: block; line-height: 1.4; }
  .dv .gia { color: var(--nh-gold); font-weight: 700; font-size: .85rem; }
  .dv:has(input:checked) { border-color: var(--nh-gold); background: rgba(200,162,75,.07); }
  /* tom tat */
  .tt { position: sticky; top: 90px; background: var(--nh-surface); border: 1px solid var(--nh-line); border-radius: 16px; padding: 1.1rem 1.2rem; }
  .tt h3 { font-family: var(--nh-serif); margin: 0 0 .7rem; font-size: 1.15rem; color: var(--nh-ink); }
  .tt dl { margin: 0; display: grid; gap: .45rem; font-size: .88rem; }
  .tt dl div { display: flex; justify-content: space-between; gap: .6rem; }
  .tt dt { color: var(--nh-muted); } .tt dd { margin: 0; text-align: right; color: var(--nh-ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .tt .tong { border-top: 1px dashed var(--nh-line); padding-top: .6rem; margin-top: .3rem; font-size: 1rem; }
  .tt .tong dd { color: var(--nh-gold); font-size: 1.15rem; }
  .tt .coc dd { color: var(--dt-ok); }
  .tt p { font-size: .76rem; color: var(--nh-muted); margin: .7rem 0 0; line-height: 1.45; }
  .xn-bang { width: 100%; border-collapse: collapse; font-size: .9rem; margin-top: .6rem; }
  .xn-bang td { padding: .4rem 0; border-bottom: 1px solid var(--nh-line); color: var(--nh-ink); }
  .xn-bang td:last-child { text-align: right; font-variant-numeric: tabular-nums; }
  @media (max-width: 960px) { .dtw__luoi { grid-template-columns: 1fr; } .tt { position: static; } }
  @media (max-width: 560px) { .dtw__the { padding: 1.1rem; } .lich button.ng { height: 42px; } .lich button.ng small { display: none; } }
  @media (prefers-reduced-motion: reduce) { .dtw * { transition: none !important; } }
</style>

<section class="nh-subhero">
  <div class="nh-subhero__bg" style="background-image:url('/images/khong-gian/gala-2.jpg')"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow">Tiệc lớn tại <%= sanh ? sanh.ten : 'Sảnh Gala' %></span>
    <h1>Đặt tiệc</h1>
    <div class="nh-crumbs"><a href="/">Trang chủ</a> &nbsp;/&nbsp; <a href="/khong-gian">Không gian</a> &nbsp;/&nbsp; <span>Đặt tiệc</span></div>
  </div>
</section>

<div class="dtw">
  <div class="nh-container">
    <ol class="dtw__buoc" id="thanhBuoc" aria-label="Các bước đặt tiệc">
      <li data-b="1"><b>1</b>Chính sách</li><li data-b="2"><b>2</b>Loại tiệc</li><li data-b="3"><b>3</b>Ngày &amp; giờ</li>
      <li data-b="4"><b>4</b>Thực đơn</li><li data-b="5"><b>5</b>Dịch vụ</li><li data-b="6"><b>6</b>Xác nhận</li>
    </ol>

    <div class="dtw__luoi">
      <div>
        <!-- 1. CHINH SACH -->
        <section class="dtw__the dtw__buoc-nd" data-buoc="1">
          <h2>Chính sách đặt tiệc</h2>
          <p class="phu">Vui lòng đọc trước khi đặt. Chính sách này cũng được ghi trong trang thanh toán và lịch sử đặt tiệc của quý khách.</p>
          <% chinhSach.forEach(function (m, i) { %>
            <details class="cs-muc" <%= i < 3 ? 'open' : '' %>>
              <summary><%= m.tieu_de %></summary>
              <ul><% m.muc.forEach(function (x) { %><li><%= x %></li><% }) %></ul>
            </details>
          <% }) %>
          <label class="cs-dongy"><input type="checkbox" id="dongY"><span>Tôi đã đọc và đồng ý với chính sách đặt tiệc, đặt cọc và hoàn cọc của nhà hàng.</span></label>
          <div class="dtw__nav"><span></span><button type="button" class="dtw__btn dtw__btn--chinh" data-tiep="1" disabled>Tiếp tục</button></div>
        </section>

        <!-- 2. LOAI TIEC + SO KHACH -->
        <section class="dtw__the dtw__buoc-nd" data-buoc="2" hidden>
          <h2>Loại tiệc &amp; số khách</h2>
          <p class="phu">Đặt tiệc online dành cho tiệc lớn tại <%= sanh ? sanh.ten : 'Sảnh Gala' %>: <b><%= ch.khach_toi_thieu %>–<%= ch.khach_toi_da %> khách</b>.</p>
          <div class="lt-luoi" role="radiogroup" aria-label="Loại tiệc">
            <% Object.keys(loaiTiec).forEach(function (ma) { var l = loaiTiec[ma]; %>
              <button type="button" class="lt" role="radio" aria-checked="false" data-loai="<%= ma %>"><i class="fas <%= l.icon %>"></i><b><%= l.ten %></b><small><%= l.mo_ta %></small></button>
            <% }) %>
          </div>
          <div class="o-nhap">
            <div><label for="soKhach">Số khách dự kiến</label><input type="number" id="soKhach" min="1" max="<%= ch.khach_toi_da %>" inputmode="numeric" placeholder="VD: 120"></div>
            <div><label for="nhanVat" id="nhanVatNhan">Tên nhân vật chính (không bắt buộc)</label><input id="nhanVat" maxlength="150" placeholder="VD: Minh Anh & Quốc Bảo"></div>
          </div>
          <div id="baoSoKhach"></div>
          <div class="chon-ban" id="khoiSoBan" hidden>
            <div><b>Số bàn</b><small id="banGoiY"></small></div>
            <div class="chon-ban__nut">
              <button type="button" id="banGiam" aria-label="Bớt một bàn">−</button>
              <output id="banSo" aria-live="polite">0</output>
              <button type="button" id="banTang" aria-label="Thêm một bàn">+</button>
            </div>
            <small id="banMoTa" class="chon-ban__mo-ta"></small>
          </div>
          <div class="dtw__nav"><button type="button" class="dtw__btn dtw__btn--phu" data-lui="2">Quay lại</button><button type="button" class="dtw__btn dtw__btn--chinh" data-tiep="2" disabled>Chọn ngày</button></div>
        </section>

        <!-- 3. NGAY & GIO -->
        <section class="dtw__the dtw__buoc-nd" data-buoc="3" hidden>
          <h2>Ngày &amp; giờ tổ chức</h2>
          <p class="phu">Mỗi buổi sảnh chỉ nhận một tiệc. Ngày tô đỏ đã kín cả hai buổi.</p>
          <div class="lich-dau"><button type="button" id="thangTruoc" aria-label="Tháng trước">‹</button><b id="tenThang">–</b><button type="button" id="thangSau" aria-label="Tháng sau">›</button></div>
          <div class="lich" id="lich" aria-live="polite"></div>
          <div class="chu-giai"><span class="c1">Còn trống</span><span class="c2">Còn 1 buổi</span><span class="c3">Kín lịch</span><span class="c4">Không nhận đặt</span></div>
          <div id="chiTietNgay"></div>
          <div class="dtw__nav"><button type="button" class="dtw__btn dtw__btn--phu" data-lui="3">Quay lại</button><button type="button" class="dtw__btn dtw__btn--chinh" data-tiep="3" disabled>Chọn thực đơn</button></div>
        </section>

        <!-- 4. THUC DON -->
        <section class="dtw__the dtw__buoc-nd" data-buoc="4" hidden>
          <h2>Thực đơn</h2>
          <p class="phu">Giá tính theo bàn <%= khachMoiBan %> khách. Chọn một trong hai cách lên thực đơn:</p>
          <div class="huong" role="radiogroup" aria-label="Cách chọn thực đơn">
            <button type="button" class="huong__the" role="radio" aria-checked="false" data-huong="co_san">
              <span class="huong__ic"><i class="fas fa-book-open" aria-hidden="true"></i></span>
              <span><b>Thực đơn có sẵn của nhà hàng</b><small>Các set tiệc bếp đã thiết kế sẵn, giá trọn gói theo bàn.</small></span>
            </button>
            <button type="button" class="huong__the" role="radio" aria-checked="false" data-huong="tu_chon">
              <span class="huong__ic"><i class="fas fa-sliders" aria-hidden="true"></i></span>
              <span><b>Tự chọn thực đơn theo ý muốn</b><small>Tự chọn từng món (tối thiểu <%= ch.tu_chon_mon_toi_thieu %> món), số phần mỗi bàn và ghi yêu cầu riêng.</small></span>
            </button>
          </div>

          <!-- 4a. Co san -->
          <div class="huong-nd" id="ndCoSan" hidden>
            <div class="td-luoi" id="dsThucDon" role="radiogroup" aria-label="Thực đơn có sẵn">
              <% thucDon.forEach(function (m) { %>
                <% var anhMon = (m.mon || []).filter(function (x) { return x.anh; }).slice(0, 4); %>
                <button type="button" class="td" role="radio" aria-checked="false" data-td="<%= m.id %>" data-loai-td="<%= m.loai_tiec || '' %>">
                  <span class="td__anh"><img src="<%= m.hinh_anh || '/images/khong-gian/tiec-cuoi-1.jpg' %>" alt="" loading="lazy"><span class="td__chon"><i class="fas fa-check"></i></span></span>
                  <% if (anhMon.length) { %><span class="td__dai"><% anhMon.forEach(function (x) { %><img src="<%= x.anh %>" alt="" loading="lazy"><% }) %></span><% } %>
                  <span class="td__than"><b><%= m.ten %></b><span class="gia"><%= vnd(m.gia_ban) %>/bàn</span><small><%= (m.mon || []).length %> món · <%= vnd(m.gia_khach) %>/khách</small></span>
                </button>
              <% }) %>
            </div>
            <button type="button" class="dtw__btn dtw__btn--phu td-them" id="xemThemTd" hidden></button>
            <div class="td-ct" id="tdChiTiet" hidden>
              <b id="tdTen"></b>
              <div id="tdMon"></div>
              <p class="phu" style="margin:.8rem 0 0">Muốn đổi món trong set này? Chọn <a href="#" id="sangTuChon">Tự chọn thực đơn</a> và bấm "Lấy món từ thực đơn mẫu".</p>
            </div>
          </div>

          <!-- 4b. Tu chon -->
          <div class="huong-nd" id="ndTuChon" hidden>
            <div class="bao bao--cam">Giá thực đơn tự chọn = giá món × số phần mỗi bàn × số bàn<% if (ch.tu_chon_giam_phan_tram > 0) { %>, giảm <%= ch.tu_chon_giam_phan_tram %>%<% } %>. Gửi yêu cầu xong quý khách đặt cọc được ngay như thực đơn có sẵn.</div>
            <div class="tc-mau">
              <p>Lấy món từ thực đơn mẫu <small>(không bắt buộc · bấm một thực đơn để xem món)</small></p>
              <div class="mau-dai" id="dsMau">
                <% thucDon.forEach(function (m) { %>
                  <button type="button" class="mau" data-mau="<%= m.id %>" aria-pressed="false">
                    <img src="<%= m.hinh_anh || '/images/khong-gian/tiec-cuoi-1.jpg' %>" alt="" loading="lazy">
                    <span><b><%= m.ten %></b><small><%= (m.mon || []).length %> món</small></span>
                  </button>
                <% }) %>
              </div>
              <div class="mau-xem" id="mauXem" hidden></div>
            </div>
            <div class="tc-dem" id="tcDem"></div>
            <ul class="ds-them" id="dsThem"></ul>
            <p style="margin:1rem 0 .3rem;font-weight:700;color:var(--nh-ink)">Chọn món từ thực đơn nhà hàng</p>
            <div class="them-mon">
              <input type="search" id="timMon" placeholder="Tìm món: sashimi, tempura, lẩu..." aria-label="Tìm món" autocomplete="off">
              <select id="locLoai" aria-label="Loại món"><option value="">Tất cả loại món</option></select>
            </div>
            <div class="them-luoi"><div class="mon-luoi" id="luoiThem"></div></div>
            <div class="o-nhap"><div style="grid-column:1/-1"><label for="yeuCau">Yêu cầu riêng cho bếp</label><textarea id="yeuCau" rows="3" maxlength="1000" placeholder="VD: 10 bàn chay, không dùng hành tỏi; thêm 1 bàn trẻ em"></textarea></div></div>
          </div>
          <div class="dtw__nav"><button type="button" class="dtw__btn dtw__btn--phu" data-lui="4">Quay lại</button><button type="button" class="dtw__btn dtw__btn--chinh" data-tiep="4" disabled>Chọn dịch vụ</button></div>
        </section>

        <!-- 5. DICH VU -->
        <section class="dtw__the dtw__buoc-nd" data-buoc="5" hidden>
          <h2>Dịch vụ thêm</h2>
          <p class="phu">Không bắt buộc. Giá theo gói, theo bàn hoặc theo khách.</p>
          <div class="dv-luoi">
            <% dichVu.forEach(function (d) { %>
              <label class="dv"><input type="checkbox" value="<%= d.id %>" class="chon-dv"><span><b><%= d.ten %></b><small><%= d.mo_ta || '' %></small><span class="gia"><%= vnd(d.gia) %>/<%= donVi[d.don_vi] || d.don_vi %></span></span></label>
            <% }) %>
          </div>
          <div class="dtw__nav"><button type="button" class="dtw__btn dtw__btn--phu" data-lui="5">Quay lại</button><button type="button" class="dtw__btn dtw__btn--chinh" data-tiep="5">Xác nhận thông tin</button></div>
        </section>

        <!-- 6. XAC NHAN -->
        <section class="dtw__the dtw__buoc-nd" data-buoc="6" hidden>
          <h2>Thông tin liên hệ &amp; xác nhận</h2>
          <form id="formTiec" novalidate>
            <div class="o-nhap">
              <div><label for="hoTen">Họ tên người đặt</label><input id="hoTen" maxlength="150" autocomplete="name" value="<%= khach ? khach.ten : '' %>" required></div>
              <div><label for="sdt">Số điện thoại</label><input id="sdt" inputmode="tel" autocomplete="tel" value="<%= khach ? khach.sdt : '' %>" required></div>
              <div><label for="email">Email (nhận xác nhận)</label><input id="email" type="email" autocomplete="email"></div>
              <div style="grid-column:1/-1"><label for="ghiChu">Ghi chú thêm</label><textarea id="ghiChu" rows="2" maxlength="2000" placeholder="VD: cần khu vực để xe đẩy cho người lớn tuổi"></textarea></div>
            </div>
            <table class="xn-bang" id="bangXacNhan"></table>
            <div id="baoGui"></div>
            <div class="dtw__nav"><button type="button" class="dtw__btn dtw__btn--phu" data-lui="6">Quay lại</button><button type="submit" class="dtw__btn dtw__btn--chinh" id="nutGui">Gửi yêu cầu đặt tiệc</button></div>
          </form>
        </section>
      </div>

      <aside class="tt" aria-label="Tóm tắt dự toán">
        <h3>Tóm tắt tiệc</h3>
        <dl>
          <div><dt>Loại tiệc</dt><dd id="tLoai">–</dd></div>
          <div><dt>Số khách</dt><dd id="tKhach">–</dd></div>
          <div><dt>Ngày giờ</dt><dd id="tNgay">–</dd></div>
          <div><dt>Thực đơn</dt><dd id="tThucDon">–</dd></div>
          <div><dt>Món tự chọn</dt><dd id="tThem">0đ</dd></div>
          <div><dt>Dịch vụ</dt><dd id="tDichVu">0đ</dd></div>
          <div class="tong"><dt>Dự toán</dt><dd id="tTong">0đ</dd></div>
          <div class="coc"><dt>Cọc <%= ch.ty_le_coc %>%</dt><dd id="tCoc">0đ</dd></div>
        </dl>
        <p>Dự toán chưa gồm món, đồ uống phát sinh trong tiệc. Hóa đơn cuối tính theo số bàn thực tế đã chốt.</p>
      </aside>
    </div>
  </div>
</div>

<script>
(function () {
  var LOAI = <%- JSON.stringify(loaiTiec).replace(/</g, '\\u003c') %>;
  var BUOI = <%- JSON.stringify(buoi).replace(/</g, '\\u003c') %>;
  var THUC_DON = <%- JSON.stringify(thucDon.map(function (m) { return { id: m.id, ten: m.ten, gia: m.gia_ban, anh: m.hinh_anh || '/images/khong-gian/tiec-cuoi-1.jpg', mon: m.mon }; })).replace(/</g, '\\u003c') %>;
  var DICH_VU = <%- JSON.stringify(dichVu.map(function (d) { return { id: d.id, ten: d.ten, gia: d.gia, don_vi: d.don_vi }; })).replace(/</g, '\\u003c') %>;
  var MON_LE = <%- JSON.stringify(monLe).replace(/</g, '\\u003c') %>;
  var CH = { min: <%= ch.khach_toi_thieu %>, max: <%= ch.khach_toi_da %>, moiBan: <%= khachMoiBan %>, coc: <%= ch.ty_le_coc %>, tuChonMin: <%= ch.tu_chon_mon_toi_thieu %>, tuChonGiam: <%= Math.min(50, ch.tu_chon_giam_phan_tram || 0) %>, banIt: <%= ch.khach_moi_ban_it_nhat %>, banNhieu: <%= ch.khach_moi_ban_nhieu_nhat %> };
  var NGAY_MIN = '<%= ngayMin %>';
  var $ = function (id) { return document.getElementById(id); };
  var vnd = function (n) { return Math.round(Number(n) || 0).toLocaleString('vi-VN') + 'đ'; };
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
  var bo = function (s) { return String(s).normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase(); };
  var S = { buoc: 1, dongY: false, loai: '<%= chon.loai %>', soKhach: 0, ngay: '', buoi: '', gio: '', huong: '', soBan: 0, thucDon: null, tuyChinh: false, boMon: [], themMon: [], dichVu: [] };
  var THANG = NGAY_MIN.slice(0, 7);

  // Khoang so ban hop le (giong datTiecQuyTrinh.khoangBan).
  function khoangBan(k) {
    var goiY = Math.ceil(k / CH.moiBan);
    return { goiY: goiY, min: Math.min(goiY, Math.ceil(k / Math.max(CH.moiBan, CH.banNhieu))), max: Math.max(goiY, Math.min(Math.ceil(CH.max / CH.moiBan), Math.floor(k / Math.max(1, Math.min(CH.moiBan, CH.banIt))))) };
  }
  function soBan() { return S.soBan || Math.ceil((S.soKhach || 0) / CH.moiBan); }
  function veSoBan() {
    var ok = S.soKhach >= CH.min && S.soKhach <= CH.max;
    $('khoiSoBan').hidden = !ok; if (!ok) return;
    var kb = khoangBan(S.soKhach), b = soBan(), du = S.soKhach % b;
    $('banSo').textContent = b;
    $('banGiam').disabled = b <= kb.min; $('banTang').disabled = b >= kb.max;
    $('banGoiY').textContent = 'Gợi ý ' + kb.goiY + ' bàn · chọn được ' + kb.min + '–' + kb.max + ' bàn';
    var it = Math.floor(S.soKhach / b), nhieu = Math.ceil(S.soKhach / b);
    $('banMoTa').textContent = it === nhieu ? 'Mỗi bàn ' + it + ' khách.' :
      'Xếp ' + du + ' bàn × ' + nhieu + ' khách và ' + (b - du) + ' bàn × ' + it + ' khách. Giá tính theo ' + b + ' bàn.';
  }
  $('banGiam').addEventListener('click', function () { var kb = khoangBan(S.soKhach); S.soBan = Math.max(kb.min, soBan() - 1); veSoBan(); capNhatNut(); });
  $('banTang').addEventListener('click', function () { var kb = khoangBan(S.soKhach); S.soBan = Math.min(kb.max, soBan() + 1); veSoBan(); capNhatNut(); });
  function tinh() {
    var b = soBan(), td = S.huong === 'co_san' ? THUC_DON.filter(function (t) { return t.id === S.thucDon; })[0] : null;
    var tienTd = td ? td.gia * b : 0;
    var tienThem = S.tuyChinh ? Math.round(S.themMon.reduce(function (s, m) { return s + m.gia * m.so_phan * b; }, 0) * (100 - CH.tuChonGiam) / 100) : 0;
    var tienDv = S.dichVu.reduce(function (s, id) {
      var d = DICH_VU.filter(function (x) { return x.id === id; })[0]; if (!d) return s;
      return s + d.gia * (d.don_vi === 'BAN' ? b : d.don_vi === 'KHACH' ? S.soKhach : 1);
    }, 0);
    var tong = tienTd + tienThem + tienDv;
    return { b: b, td: td, tienTd: tienTd, tienThem: tienThem, tienDv: tienDv, tong: tong, coc: Math.ceil(tong * CH.coc / 100) };
  }
  function veTomTat() {
    var t = tinh();
    $('tLoai').textContent = S.loai ? LOAI[S.loai].ten : '–';
    $('tKhach').textContent = S.soKhach ? S.soKhach + ' khách · ' + t.b + ' bàn' : '–';
    $('tNgay').textContent = S.ngay ? S.ngay.split('-').reverse().join('/') + (S.gio ? ' · ' + S.gio : '') : '–';
    $('tThucDon').textContent = S.huong === 'tu_chon' ? 'Tự chọn · ' + S.themMon.length + ' món' : t.td ? t.td.ten : '–';
    $('tThem').parentElement.style.display = S.huong === 'tu_chon' ? '' : 'none'; $('tThem').textContent = vnd(t.tienThem); $('tDichVu').textContent = vnd(t.tienDv);
    $('tTong').textContent = vnd(t.tong); $('tCoc').textContent = vnd(t.coc);
  }

  // --- dieu huong buoc
  function hopLe(b) {
    if (b === 1) return S.dongY;
    if (b === 2) return !!S.loai && S.soKhach >= CH.min && S.soKhach <= CH.max;
    if (b === 3) return !!S.ngay && !!S.gio;
    if (b === 4) return S.huong === 'co_san' ? !!S.thucDon : S.huong === 'tu_chon' ? S.themMon.length >= CH.tuChonMin : false;
    return true;
  }
  function den(b) {
    S.buoc = b;
    document.querySelectorAll('.dtw__buoc-nd').forEach(function (el) { el.hidden = Number(el.getAttribute('data-buoc')) !== b; });
    document.querySelectorAll('#thanhBuoc li').forEach(function (li) {
      var n = Number(li.getAttribute('data-b')); li.classList.toggle('xong', n < b); li.classList.toggle('dang', n === b);
    });
    if (b === 3) veLich();
    if (b === 4) locThucDon(false);
    if (b === 6) veXacNhan();
    capNhatNut();
    var top = document.querySelector('.dtw').getBoundingClientRect().top + window.scrollY - 80;
    if (window.scrollY > top) window.scrollTo({ top: top, behavior: 'smooth' });
  }
  function capNhatNut() {
    document.querySelectorAll('[data-tiep]').forEach(function (n) { n.disabled = !hopLe(Number(n.getAttribute('data-tiep'))); });
    veTomTat();
  }
  document.querySelectorAll('[data-tiep]').forEach(function (n) { n.addEventListener('click', function () { var b = Number(n.getAttribute('data-tiep')); if (hopLe(b)) den(b + 1); }); });
  document.querySelectorAll('[data-lui]').forEach(function (n) { n.addEventListener('click', function () { den(Number(n.getAttribute('data-lui')) - 1); }); });

  // --- 1
  $('dongY').addEventListener('change', function () { S.dongY = this.checked; capNhatNut(); });

  // --- 2
  document.querySelectorAll('[data-loai]').forEach(function (n) {
    n.addEventListener('click', function () {
      S.loai = n.getAttribute('data-loai');
      document.querySelectorAll('[data-loai]').forEach(function (x) { x.setAttribute('aria-checked', String(x === n)); });
      $('nhanVatNhan').textContent = (LOAI[S.loai].nhan_vat || 'Tên nhân vật chính') + ' (không bắt buộc)';
      capNhatNut();
    });
    if (n.getAttribute('data-loai') === S.loai) n.click();
  });
  $('soKhach').addEventListener('input', function () {
    S.soKhach = Math.floor(Number(this.value) || 0);
    S.soBan = 0; // doi so khach -> ve lai so ban goi y
    var bao = $('baoSoKhach');
    if (!S.soKhach) bao.innerHTML = '';
    else if (S.soKhach < CH.min) {
      bao.innerHTML = '<div class="bao bao--do"><b>' + S.soKhach + ' khách chưa đủ điều kiện đặt tiệc.</b> Đặt tiệc online dành cho tiệc lớn từ ' + CH.min +
        ' khách tại sảnh Gala. Với nhóm nhỏ, quý khách vui lòng đặt bàn như bình thường (có phòng VIP và bàn ghép cho nhóm).<br>' +
        '<a class="dtw__btn dtw__btn--chinh" href="/dat-ban?so_khach=' + S.soKhach + '">Đặt bàn cho ' + S.soKhach + ' khách</a></div>';
    } else if (S.soKhach > CH.max) bao.innerHTML = '<div class="bao bao--do">Sảnh nhận tối đa ' + CH.max + ' khách. Tiệc lớn hơn vui lòng gọi Hotline để được tư vấn riêng.</div>';
    else bao.innerHTML = '';
    veSoBan();
    capNhatNut();
  });

  // --- 3 lich
  var TEN_TRANG = { trong: 'trống', mot_buoi: 'còn 1 buổi', kin: 'kín', khong_nhan: '' };
  async function veLich() {
    $('tenThang').textContent = 'Tháng ' + Number(THANG.slice(5)) + '/' + THANG.slice(0, 4);
    $('thangTruoc').disabled = THANG <= NGAY_MIN.slice(0, 7);
    var o = $('lich');
    o.innerHTML = ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'].map(function (x) { return '<div class="th">' + x + '</div>'; }).join('');
    try {
      var r = await fetch('/api/dat-tiec/lich-thang?thang=' + THANG); var j = await r.json();
      var dau = (new Date(THANG + '-01T00:00:00').getDay() + 6) % 7;
      var html = '';
      for (var i = 0; i < dau; i++) html += '<div></div>';
      j.ngay.forEach(function (n) {
        var khoa = n.trang === 'kin' || n.trang === 'khong_nhan';
        html += '<button type="button" class="ng ng--' + n.trang + (n.ngay === S.ngay ? ' chon' : '') + '" data-ngay="' + n.ngay + '"' + (khoa ? ' aria-disabled="true"' : '') +
          ' aria-label="Ngày ' + n.ngay.split('-').reverse().join('/') + ' ' + TEN_TRANG[n.trang] + '">' + Number(n.ngay.slice(8)) +
          (TEN_TRANG[n.trang] ? '<small>' + TEN_TRANG[n.trang] + '</small>' : '') + '</button>';
      });
      o.insertAdjacentHTML('beforeend', html);
    } catch (e) { o.insertAdjacentHTML('beforeend', '<div class="bao bao--do" style="grid-column:1/-1">Không tải được lịch. Vui lòng thử lại.</div>'); }
  }
  function doiThang(d) { var t = new Date(THANG + '-01T00:00:00'); t.setMonth(t.getMonth() + d); THANG = t.getFullYear() + '-' + String(t.getMonth() + 1).padStart(2, '0'); veLich(); }
  $('thangTruoc').addEventListener('click', function () { doiThang(-1); });
  $('thangSau').addEventListener('click', function () { doiThang(1); });
  $('lich').addEventListener('click', async function (e) {
    var n = e.target.closest('button.ng'); if (!n) return;
    var ngay = n.getAttribute('data-ngay');
    S.ngay = ngay; S.buoi = ''; S.gio = '';
    document.querySelectorAll('#lich .ng').forEach(function (x) { x.classList.toggle('chon', x === n); });
    var ct = $('chiTietNgay'); ct.innerHTML = '<p class="phu" style="margin-top:1rem">Đang kiểm tra lịch...</p>';
    try {
      var j = await (await fetch('/api/dat-tiec/lich?ngay=' + ngay)).json();
      if (!j.nhan || j.het_cho) { S.ngay = ''; ct.innerHTML = '<div class="bao bao--do"><b>Ngày ' + ngay.split('-').reverse().join('/') + ' không đặt được.</b> ' + esc(j.ly_do || '') + '</div>'; capNhatNut(); return; }
      ct.innerHTML = '<div class="buoi-luoi">' + j.buoi.map(function (b) {
        return '<div class="buoi' + (b.kin ? ' buoi--kin' : '') + '"><h4>' + esc(b.ten) + '</h4><p>' + esc(b.khung) + (b.kin ? ' · <b style="color:var(--dt-do)">Đã có tiệc</b>' : ' · còn trống') + '</p><div class="gio-luoi">' +
          b.gio.map(function (g) { return '<button type="button" class="gio" data-buoi="' + b.ma + '" data-gio="' + g.gio + '" aria-pressed="false"' + (g.trong ? '' : ' disabled title="Đã có tiệc"') + '>' + g.gio + '</button>'; }).join('') + '</div></div>';
      }).join('') + '</div>';
    } catch (e2) { ct.innerHTML = '<div class="bao bao--do">Không kiểm tra được lịch ngày này.</div>'; }
    capNhatNut();
  });
  $('chiTietNgay').addEventListener('click', function (e) {
    var g = e.target.closest('button.gio'); if (!g || g.disabled) return;
    S.buoi = g.getAttribute('data-buoi'); S.gio = g.getAttribute('data-gio');
    document.querySelectorAll('#chiTietNgay .gio').forEach(function (x) { x.setAttribute('aria-pressed', String(x === g)); });
    capNhatNut();
  });

  // --- 4 thuc don
  var anhMon = function (a) { return a ? '<img src="' + esc(a) + '" alt="" loading="lazy">' : '<i class="fas fa-utensils" aria-hidden="true"></i>'; };
  function veMon() {
    var td = THUC_DON.filter(function (t) { return t.id === S.thucDon; })[0]; if (!td) return;
    $('tdChiTiet').hidden = false; $('tdTen').textContent = td.ten + ' · ' + (td.mon || []).length + ' món';
    var nhom = [];
    (td.mon || []).forEach(function (m) { var g = nhom.filter(function (x) { return x.ten === m.nhom; })[0]; if (!g) nhom.push(g = { ten: m.nhom || 'Món', ds: [] }); g.ds.push(m); });
    $('tdMon').innerHTML = nhom.map(function (g) {
      return '<div class="mon-nhom"><b>' + esc(g.ten) + '</b><div class="mon-luoi">' + g.ds.map(function (m) {
        return '<div class="mon"><span class="mon__anh">' + anhMon(m.anh) + '</span><span class="mon__ten">' + esc(m.ten) + '</span></div>';
      }).join('') + '</div></div>';
    }).join('');
  }
  // Loai mon cho bo loc them mon.
  (function () {
    var ds = []; MON_LE.forEach(function (m) { if (m.loai && ds.indexOf(m.loai) < 0) ds.push(m.loai); });
    $('locLoai').insertAdjacentHTML('beforeend', ds.map(function (l) { return '<option value="' + esc(l) + '">' + esc(l.replace(/^\d+\.\s*/, '')) + '</option>'; }).join(''));
  })();
  function veLuoiThem() {
    var tu = bo($('timMon').value).trim(), loai = $('locLoai').value;
    // Mon an len truoc, do uong (Drink / Sake - Beer) xuong cuoi - tiec chu yeu them mon.
    var laUong = function (m) { return /DRINK|SAKE|BEER/i.test(m.loai || ''); };
    var kq = MON_LE.filter(function (m) { return (!loai || m.loai === loai) && (!tu || bo(m.ten).indexOf(tu) >= 0); })
      .sort(function (a, b) { return laUong(a) - laUong(b); }).slice(0, 48);
    $('luoiThem').innerHTML = kq.length ? kq.map(function (m) {
      var da = S.themMon.some(function (x) { return x.id === m.id; });
      return '<div class="mon"><span class="mon__anh">' + anhMon(m.anh) + '</span><span class="mon__ten">' + esc(m.ten.replace(/^[A-Z0-9]+-/, '')) + '<small>' + vnd(m.gia) + '/phần</small></span>' +
        '<button type="button" class="mon__them" data-them="' + m.id + '"' + (da ? ' disabled' : '') + '>' + (da ? '✓ Đã thêm' : '+ Thêm') + '</button></div>';
    }).join('') : '<p class="phu" style="grid-column:1/-1">Không có món phù hợp.</p>';
  }
  document.querySelectorAll('[data-td]').forEach(function (n) {
    n.addEventListener('click', function () {
      S.thucDon = Number(n.getAttribute('data-td')); S.boMon = [];
      document.querySelectorAll('[data-td]').forEach(function (x) { x.setAttribute('aria-checked', String(x === n)); });
      veMon(); capNhatNut();
      $('tdChiTiet').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
  // Buoc 4: hien thuc don dung loai tiec truoc; "Xem them" mo cac thuc don khac.
  function locThucDon(hetCa) {
    var the = Array.prototype.slice.call(document.querySelectorAll('[data-td]'));
    var dung = the.filter(function (x) { return x.getAttribute('data-loai-td') === S.loai; });
    var hien = hetCa || !dung.length;
    the.forEach(function (x) { x.hidden = !hien && dung.indexOf(x) < 0 && x.getAttribute('aria-checked') !== 'true'; });
    var an = the.filter(function (x) { return x.hidden; }).length;
    $('xemThemTd').hidden = !an;
    $('xemThemTd').textContent = 'Xem thêm ' + an + ' thực đơn khác';
  }
  $('xemThemTd').addEventListener('click', function () { locThucDon(true); });
  // Hai huong chon thuc don.
  function chonHuong(h) {
    S.huong = h; S.tuyChinh = h === 'tu_chon'; S.boMon = [];
    document.querySelectorAll('[data-huong]').forEach(function (x) { x.setAttribute('aria-checked', String(x.getAttribute('data-huong') === h)); });
    $('ndCoSan').hidden = h !== 'co_san'; $('ndTuChon').hidden = h !== 'tu_chon';
    if (h === 'tu_chon') veThem();
    capNhatNut();
  }
  document.querySelectorAll('[data-huong]').forEach(function (n) { n.addEventListener('click', function () { chonHuong(n.getAttribute('data-huong')); }); });
  $('sangTuChon').addEventListener('click', function (e) {
    e.preventDefault();
    chonHuong('tu_chon'); if (S.thucDon) xemMau(S.thucDon);
    $('ndTuChon').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  // Thuc don mau: xem anh tung mon theo nhom, tick mon muon lay (chi mon co ban le).
  var mauDang = null;
  function monLeCua(x) { return x.id_mon ? MON_LE.filter(function (y) { return y.id === x.id_mon; })[0] : null; }
  function xemMau(id) {
    var td = THUC_DON.filter(function (t) { return t.id === Number(id); })[0]; if (!td) return;
    mauDang = td;
    document.querySelectorAll('[data-mau]').forEach(function (b) { b.setAttribute('aria-pressed', String(Number(b.getAttribute('data-mau')) === td.id)); });
    var nhom = [], coLe = 0;
    (td.mon || []).forEach(function (m) { var g = nhom.filter(function (x) { return x.ten === m.nhom; })[0]; if (!g) nhom.push(g = { ten: m.nhom || 'Món', ds: [] }); g.ds.push(m); });
    var html = '<div class="mau-xem__dau"><img src="' + esc(td.anh) + '" alt=""><div><b>' + esc(td.ten) + '</b><small>' + (td.mon || []).length + ' món · bỏ tick món không muốn lấy</small></div></div>';
    html += nhom.map(function (g) {
      return '<div class="mon-nhom"><b>' + esc(g.ten) + '</b><div class="mon-luoi">' + g.ds.map(function (x) {
        var m = monLeCua(x), da = m && S.themMon.some(function (y) { return y.id === m.id; });
        if (m) coLe++;
        var nhan = !m ? '<span class="mon__nhan">Món riêng của set, không bán lẻ</span>' : da ? '<span class="mon__nhan da">✓ Đã có trong thực đơn</span>' : '<small>' + vnd(m.gia) + '/phần</small>';
        return '<label class="mon mon-chon' + (m ? '' : ' khong-co') + '">' + (m ? '<input type="checkbox" data-lay="' + m.id + '"' + (da ? ' disabled' : ' checked') + ' aria-label="Lấy ' + esc(x.ten) + '">' : '') +
          '<span class="mon__anh">' + anhMon(x.anh) + '</span><span class="mon__ten">' + esc(x.ten) + nhan + '</span></label>';
      }).join('') + '</div></div>';
    }).join('');
    html += '<div class="mau-xem__nut"><small id="mauDem"></small><span style="display:flex;gap:.5rem;flex-wrap:wrap">' +
      '<button type="button" class="dtw__btn dtw__btn--phu" id="mauDong">Đóng</button>' +
      '<button type="button" class="dtw__btn dtw__btn--chinh" id="nutLayMau">Lấy món đã chọn</button></span></div>';
    $('mauXem').innerHTML = html; $('mauXem').hidden = false;
    demMau();
  }
  function demMau() {
    var n = $('mauXem').querySelectorAll('[data-lay]:checked:not(:disabled)').length;
    $('mauDem').textContent = 'Đã chọn ' + n + ' món để lấy';
    $('nutLayMau').disabled = !n; $('nutLayMau').textContent = n ? 'Lấy ' + n + ' món đã chọn' : 'Chưa chọn món nào';
  }
  $('dsMau').addEventListener('click', function (e) { var b = e.target.closest('[data-mau]'); if (b) xemMau(b.getAttribute('data-mau')); });
  $('mauXem').addEventListener('change', function (e) { if (e.target.matches('[data-lay]')) demMau(); });
  $('mauXem').addEventListener('click', function (e) {
    if (e.target.closest('#mauDong')) { $('mauXem').hidden = true; document.querySelectorAll('[data-mau]').forEach(function (b) { b.setAttribute('aria-pressed', 'false'); }); return; }
    if (!e.target.closest('#nutLayMau') || !mauDang) return;
    var them = 0;
    $('mauXem').querySelectorAll('[data-lay]:checked:not(:disabled)').forEach(function (c) {
      var m = MON_LE.filter(function (y) { return y.id === Number(c.getAttribute('data-lay')); })[0];
      if (m && !S.themMon.some(function (y) { return y.id === m.id; })) { S.themMon.push({ id: m.id, ten: m.ten.replace(/^[A-Z0-9]+-/, ''), gia: m.gia, anh: m.anh, so_phan: 1 }); them++; }
    });
    var ten = mauDang.ten;
    $('mauXem').hidden = true; document.querySelectorAll('[data-mau]').forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
    veThem();
    $('tcDem').insertAdjacentHTML('beforeend', '<span style="flex-basis:100%;font-size:.82rem;color:var(--nh-muted)">Đã lấy ' + them + ' món từ ' + esc(ten) + '.</span>');
    $('tcDem').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
  function veThem() {
    var tam = Math.round(S.themMon.reduce(function (t, m) { return t + m.gia * m.so_phan * soBan(); }, 0) * (100 - CH.tuChonGiam) / 100), n = S.themMon.length;
    $('tcDem').innerHTML = '<span>Đã chọn <b>' + n + '</b> món' + (n < CH.tuChonMin ? ' · cần thêm <b>' + (CH.tuChonMin - n) + '</b> món nữa (tối thiểu ' + CH.tuChonMin + ')' : ' ✓') + '</span><span>Tiền món: <b>' + vnd(tam) + '</b> (' + soBan() + ' bàn' + (CH.tuChonGiam ? ', đã giảm ' + CH.tuChonGiam + '%' : '') + ')</span>';
    $('dsThem').innerHTML = S.themMon.map(function (m, i) {
      return '<li><span class="tt-mon">' + (m.anh ? '<img src="' + esc(m.anh) + '" alt="">' : '') + '<span>' + esc(m.ten) + '<br><small style="color:var(--nh-muted)">' + vnd(m.gia) + '/phần · ' + m.so_phan + ' phần/bàn × ' + soBan() + ' bàn = ' + (m.so_phan * soBan()) + ' phần</small></span></span>' +
        '<span class="ben-phai"><span class="sl" role="group" aria-label="Số phần mỗi bàn của ' + esc(m.ten) + '">' +
        '<button type="button" data-sl="' + i + '" data-d="-1"' + (m.so_phan <= SL_MIN ? ' disabled' : '') + ' aria-label="Bớt một phần">−</button>' +
        '<output aria-live="polite">' + m.so_phan + '</output>' +
        '<button type="button" data-sl="' + i + '" data-d="1"' + (m.so_phan >= SL_MAX ? ' disabled' : '') + ' aria-label="Thêm một phần">+</button></span>' +
        '<span class="tien">' + vnd(m.gia * m.so_phan * soBan()) + '</span>' +
        '<button type="button" data-xoa="' + i + '" aria-label="Bỏ ' + esc(m.ten) + '">×</button></span></li>';
    }).join('');
    if (!$('ndTuChon').hidden) veLuoiThem();
    capNhatNut();
  }
  $('timMon').addEventListener('input', veLuoiThem);
  $('locLoai').addEventListener('change', veLuoiThem);
  $('luoiThem').addEventListener('click', function (e) {
    var b = e.target.closest('[data-them]'); if (!b || b.disabled) return;
    var m = MON_LE.filter(function (x) { return x.id === Number(b.getAttribute('data-them')); })[0];
    if (m && !S.themMon.some(function (x) { return x.id === m.id; })) S.themMon.push({ id: m.id, ten: m.ten.replace(/^[A-Z0-9]+-/, ''), gia: m.gia, anh: m.anh, so_phan: 1 });
    veThem();
  });
  // So phan moi ban cua tung mon (server gioi han 1-5).
  var SL_MIN = 1, SL_MAX = 5;
  $('dsThem').addEventListener('click', function (e) {
    var x = e.target.closest('[data-xoa]');
    if (x) { S.themMon.splice(Number(x.getAttribute('data-xoa')), 1); veThem(); return; }
    var b = e.target.closest('[data-sl]'); if (!b || b.disabled) return;
    var m = S.themMon[Number(b.getAttribute('data-sl'))]; if (!m) return;
    m.so_phan = Math.min(SL_MAX, Math.max(SL_MIN, m.so_phan + Number(b.getAttribute('data-d'))));
    veThem();
  });

  // --- 5 dich vu
  document.querySelectorAll('.chon-dv').forEach(function (c) {
    c.addEventListener('change', function () { S.dichVu = Array.prototype.slice.call(document.querySelectorAll('.chon-dv:checked')).map(function (x) { return Number(x.value); }); capNhatNut(); });
  });

  // --- 6 xac nhan & gui
  function veXacNhan() {
    var t = tinh(), dong = [
      ['Loại tiệc', LOAI[S.loai].ten], ['Ngày giờ', S.ngay.split('-').reverse().join('/') + ' · ' + BUOI[S.buoi].ten + ' ' + S.gio],
      ['Số khách', S.soKhach + ' khách (' + t.b + ' bàn)']];
    if (S.huong === 'tu_chon') {
      dong.push(['Thực đơn', 'Tự chọn ' + S.themMon.length + ' món: ' + S.themMon.map(function (m) { return m.ten + (m.so_phan > 1 ? ' ×' + m.so_phan : ''); }).join(', ')]);
      dong.push(['Tiền món', vnd(t.tienThem) + (CH.tuChonGiam ? ' (đã giảm ' + CH.tuChonGiam + '%)' : '')]);
      if ($('yeuCau').value.trim()) dong.push(['Yêu cầu riêng', $('yeuCau').value.trim()]);
    } else {
      dong.push(['Thực đơn', t.td.ten + ' · ' + vnd(t.td.gia) + '/bàn × ' + t.b + ' = ' + vnd(t.tienTd)]);
    }
    if (S.dichVu.length) dong.push(['Dịch vụ', vnd(t.tienDv)]);
    dong.push(['Dự toán', vnd(t.tong)]);
    dong.push(['Cọc giữ sảnh (' + CH.coc + '%)', vnd(t.coc)]);
    $('bangXacNhan').innerHTML = dong.map(function (d) { return '<tr><td>' + esc(d[0]) + '</td><td>' + esc(d[1]) + '</td></tr>'; }).join('');
  }
  $('formTiec').addEventListener('submit', async function (e) {
    e.preventDefault();
    var bao = $('baoGui'); bao.innerHTML = '';
    var body = {
      dong_y_chinh_sach: S.dongY, loai_tiec: S.loai, so_khach: S.soKhach, ten_nhan_vat: $('nhanVat').value,
      ngay_to_chuc: S.ngay, buoi: S.buoi, gio_bat_dau: S.gio, dich_vu: S.dichVu,
      so_ban: soBan(), kieu_thuc_don: S.huong, thuc_don_id: S.huong === 'co_san' ? S.thucDon : null,
      tuy_chinh: S.tuyChinh ? { bo_mon: [], them_mon: S.themMon.map(function (m) { return { id_mon: m.id, so_phan: m.so_phan }; }), yeu_cau: $('yeuCau').value } : null,
      ho_ten: $('hoTen').value, so_dien_thoai: $('sdt').value, email: $('email').value, ghi_chu: $('ghiChu').value,
    };
    var nut = $('nutGui'); nut.disabled = true; nut.textContent = 'Đang gửi...';
    try {
      var r = await fetch('/api/dat-tiec', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      var j = await r.json();
      if (r.status === 401 && j.can_dang_nhap) { location.href = j.dang_nhap || '/login'; return; }
      if (!j.ok) throw new Error(j.thong_bao || 'Không gửi được yêu cầu.');
      location.href = '/dat-tiec/thanh-toan/' + encodeURIComponent(j.ma) + '?dt=' + encodeURIComponent(body.so_dien_thoai);
    } catch (err) {
      bao.innerHTML = '<div class="bao bao--do">' + esc(err.message) + '</div>';
      nut.disabled = false; nut.textContent = 'Gửi yêu cầu đặt tiệc';
    }
  });

  den(1);
})();
</script>

<%- include('partials/footer') %>
