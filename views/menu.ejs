<%- include('partials/header') %>

<section class="hero-wrap hero-wrap-2" style="background-image: url('/bg_3.jpg');"
    data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate text-center mb-4">
                <h1 class="mb-2 bread">Món đặc sắc</h1>
                <p class="breadcrumbs"><span class="mr-2"><a href="/">Trang chủ <i
                                class="ion-ios-arrow-forward"></i></a></span> <span>Menu <i
                            class="ion-ios-arrow-forward"></i></span></p>
            </div>
        </div>
    </div>
</section>


<section class="ftco-section">
    <div class="container">
        <div class="ftco-search">
        <form action="/menu" method="post">
                <input name="key" type="search" placeholder="Tìm kiếm món ăn..." value="<%= key %>">
                <button type="submit" >Tìm kiếm</button>
            </form>
            <div class="row">
                <div class="col-md-12 nav-link-wrap">
                    <div class="nav nav-pills d-flex text-center" id="v-pills-tab" role="tablist"
                        aria-orientation="vertical">
                        <% categories.forEach(category => { %>
                          <a class="nav-link ftco-animate <%= currentCategory == category.id_loai ? 'active' : '' %>" 
                             href="/menu?id_loai=<%= category.id_loai %>"
                             role="tab"><%= category.name_loai %></a>
                        <% }) %>
                    </div>
                </div>
                <div class="col-md-12 tab-wrap">
                    <div class="tab-content" id="v-pills-tabContent">
                        <div class="tab-pane fade show active" id="v-pills-1" role="tabpanel">
                            <div class="row no-gutters d-flex align-items-stretch">
                                <% if (dishes && dishes.length > 0) { %>
                                  <% dishes.forEach(dish => { %>
                                    <div class="col-md-12 col-lg-6 d-flex align-self-stretch">
                                        <div class="menus d-sm-flex ftco-animate align-items-stretch">
                                            <div class="menu-img img"
                                                style="background-image: url(/food/<%= dish.images %>);"></div>
                                            <div class="text d-flex align-items-center">
                                                <div>
                                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                                        <h3 class="mb-0" style="font-weight: 600; margin-right: 15px;"><%= dish.name_mon %></h3>
                                                        <span class="price" style="font-size: 20px; color: #c8a97e; font-weight: 600; white-space: nowrap;"><%= formatMoney(dish.gia_mon) %></span>
                                                    </div> 
                                                    <p><%= dish.ghichu_mon %></p>
                                                    <p><a href="/detail?monid=<%= dish.id_mon %>" class="btn btn-primary">Đặt món ngay</a></p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                  <% }) %>
                                <% } else { %>
                                  <p class="text-center w-100">Không tìm thấy món ăn nào.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
