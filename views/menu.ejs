<%- include('partials/header', { title: t('dieu_huong.thuc_don'), activeNav: 'menu' }) %>
<%
/*
  TRANG THỰC ĐƠN: 3 DANH MỤC CHÍNH (Khai vị, Món chính, Đồ uống).
*/
var boSo = function (s) { return String(s || '').replace(/^\d+\s*[.)-]\s*/, '').trim(); };
var dsLoai = (typeof categories !== 'undefined' && categories) ? categories : [];
var dsMon = (typeof dishes !== 'undefined' && dishes) ? dishes : [];
var tuKhoa = (typeof key !== 'undefined') ? key : '';
var curNhom = (typeof currentGroup !== 'undefined') ? currentGroup : null;
var curCat = (typeof currentCategory !== 'undefined') ? currentCategory : null;

function phanLoaiNhom(name) {
  var n = (name || '').toUpperCase();
  if (n.includes('DRINK') || n.includes('SAKE') || n.includes('BEER') || n.includes('DESSERT') || n.includes('NƯỚC') || n.includes('UỐNG') || n.includes('RƯỢU') || n.includes('BIA') || n.includes('TRÁNG MIỆNG')) return 'do-uong';
  if (n.includes('APPERTIZER') || n.includes('APPETIZER') || n.includes('SALAD') || n.includes('SOUP') || n.includes('KHAI VỊ') || n.includes('GỎI') || n.includes('SÚP')) return 'khai-vi';
  return 'mon-chinh';
}

var dsNhomChinh = (typeof mainGroups !== 'undefined' && mainGroups && mainGroups.length) ? mainGroups : [
  { key: 'khai-vi', name: 'Khai vị', icon: 'fa-bowl-food', categories: [], so_mon: 0 },
  { key: 'mon-chinh', name: 'Món chính', icon: 'fa-utensils', categories: [], so_mon: 0 },
  { key: 'do-uong', name: 'Đồ uống', icon: 'fa-wine-glass', categories: [], so_mon: 0 }
];

if (typeof mainGroups === 'undefined' || !mainGroups || !mainGroups.length) {
  var gMap = { 'khai-vi': dsNhomChinh[0], 'mon-chinh': dsNhomChinh[1], 'do-uong': dsNhomChinh[2] };
  dsLoai.forEach(function(c) {
    var k = phanLoaiNhom(c.name_loai);
    if (gMap[k]) {
      gMap[k].categories.push(c);
      gMap[k].so_mon += Number(c.so_mon || 0);
    }
  });
  if (!curNhom) {
    if (curCat) {
      var timCat = dsLoai.find(function(c) { return String(c.id_loai) === String(curCat); });
      if (timCat) curNhom = phanLoaiNhom(timCat.name_loai);
    } else {
      curNhom = dsNhomChinh[0].key;
    }
  }
}
%>

<!-- ================= HERO NHỎ ================= -->
<section class="nh-subhero">
  <div class="nh-subhero__bg nh-wa-koshi"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('thuc_don.eyebrow_bep') %></span>
    <h1><%= t('thuc_don.tieu_de') %></h1>
    <div class="nh-crumbs"><a href="/"><%= t('dieu_huong.trang_chu') %></a> &nbsp;/&nbsp; <%= t('dieu_huong.thuc_don') %></div>
  </div>
</section>

<!-- ================= THANH 3 DANH MỤC CHÍNH ================= -->
<nav class="nh-thanh-mon" id="thanhMon" aria-label="<%= t('thuc_don.danh_muc') %>">
  <div class="nh-container">
    <!-- 3 Danh mục chính -->
    <div class="nh-nhom-chinh">
      <% if (tuKhoa) { %>
        <a class="nh-nhom-item nh-nhom-item--tim" href="/menu">
          <i class="fas fa-times"></i>
          <span><%= t('thuc_don.ket_qua_tim') %></span>
        </a>
      <% } %>
      <% dsNhomChinh.forEach(function (g) { %>
        <%
          var firstId = (g.categories && g.categories.length) ? g.categories[0].id_loai : '';
        %>
        <a class="nh-nhom-item <%= (!tuKhoa && curNhom === g.key) ? 'is-active' : '' %>"
           href="/menu?nhom=<%= g.key %>">
          <i class="fas <%= g.icon %>"></i>
          <span class="nh-nhom-item__ten"><%= g.name %></span>
        </a>
      <% }) %>
    </div>

    <!-- Phân loại chi tiết thuộc nhóm đang chọn -->
    <% 
      var activeGroupObj = dsNhomChinh.find(function(g) { return g.key === curNhom; });
    %>
    <% if (!tuKhoa && activeGroupObj && activeGroupObj.categories && activeGroupObj.categories.length > 0) { %>
      <div class="nh-thanh-mon__trong" style="margin-top: 0.5rem; border-top: 1px dashed rgba(0,0,0,0.08); padding-top: 0.4rem;">
        <button type="button" class="nh-thanh-mon__mui" data-huong="-1"
                aria-label="<%= t('thuc_don.muc_truoc') %>"><i class="fas fa-chevron-left"></i></button>

        <div class="nh-thanh-mon__dai" id="daiMon">
          <a class="nh-muc <%= (!curCat) ? 'is-active' : '' %>"
             href="/menu?nhom=<%= activeGroupObj.key %>">
            <span class="nh-muc__ten"><%= t('thuc_don.tat_ca_nhom', { ten: activeGroupObj.name.toLowerCase() }) %></span>
          </a>
          <% activeGroupObj.categories.forEach(function (c) { %>
            <a class="nh-muc <%= (String(curCat) === String(c.id_loai)) ? 'is-active' : '' %>"
               href="/menu?nhom=<%= activeGroupObj.key %>&id_loai=<%= c.id_loai %>">
              <span class="nh-muc__ten"><%= boSo(tenNhom(c)) %></span>
            </a>
          <% }) %>
        </div>

        <button type="button" class="nh-thanh-mon__mui" data-huong="1"
                aria-label="<%= t('thuc_don.muc_sau') %>"><i class="fas fa-chevron-right"></i></button>
      </div>
    <% } %>
  </div>
</nav>

<!-- ================= MÓN ================= -->
<section class="nh-section nh-section--cream" style="padding-top:1.4rem">
  <div class="nh-container">
    <!-- Banner Trạng thái Giao hàng -->
    <% var ttGiao = (typeof thongTinGiao !== 'undefined' && thongTinGiao) ? thongTinGiao : null; %>
    <% if (ttGiao) { %>
      <%- include('partials/nh-steps', { buoc: 2 }) %>
      <div style="background: #fffdf7; border: 1.5px solid var(--nh-gold); border-radius: 14px; padding: 12px 18px; margin-bottom: 1.4rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; box-shadow: 0 4px 15px rgba(200,169,81,0.1);">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--nh-gold); color: #2c1810; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0;">
            <i class="fas fa-location-dot"></i>
          </div>
          <div>
            <div style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.06em; color: #888; font-weight: 700;"><%= t('thuc_don.giao_hang_den') %></div>
            <strong style="color: var(--nh-espresso); font-size: 0.98rem;"><%= ttGiao.dia_chi_giao %></strong>
            <span style="color: #666; font-size: 0.85rem;">(<%= ttGiao.khoang_cach_km %> km · <%= t('gio_hang.phi_giao_hang') %>: <%= ttGiao.phi_co_ban > 0 ? Number(ttGiao.phi_co_ban).toLocaleString('vi-VN') + ' ₫' : t('chung.mien_phi') %>)</span>
            &nbsp;·&nbsp; <a href="/giao-hang" style="color: var(--nh-gold); font-weight: 600; text-decoration: underline; font-size: 0.88rem;"><i class="fas fa-edit"></i> <%= t('thuc_don.doi_dia_chi') %></a>
          </div>
        </div>
        <a href="/cart" class="nh-btn nh-btn--gold nh-btn--sm" style="white-space: nowrap;">
          <i class="fas fa-shopping-bag"></i> <%= t('thuc_don.xem_gio_hang', { n: session.sum || 0 }) %> <i class="fas fa-arrow-right"></i>
        </a>
      </div>
    <% } else { %>
      <div style="background: linear-gradient(135deg, #fffdf8 0%, #fff9ec 100%); border: 1.5px solid rgba(200,169,81,0.35); border-radius: 14px; padding: 12px 18px; margin-bottom: 1.4rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--nh-gold); color: #2c1810; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0;">
            <i class="fas fa-motorcycle"></i>
          </div>
          <div>
            <strong style="color: var(--nh-espresso); font-size: 0.98rem;"><%= t('dat_ban.dich_vu_giao_tan_noi') %></strong>
            <p style="margin: 0; font-size: 0.85rem; color: #777;"><%- t('thuc_don.dich_vu_giao_mo_ta') %></p>
          </div>
        </div>
        <a href="/cart" class="nh-btn nh-btn--dark nh-btn--sm" style="white-space: nowrap;">
          <i class="fas fa-shopping-bag"></i> <%= t('thuc_don.gio_hang_dem', { n: session.sum || 0 }) %>
        </a>
      </div>
    <% } %>

    <form class="nh-search" action="/menu" method="post">
      <input name="key" type="search" placeholder="<%= t('thuc_don.tim_goi_y') %>" value="<%= tuKhoa %>">
      <button type="submit"><i class="fas fa-search"></i></button>
    </form>

    <%
      var nhomHienTai = null;
      var tieuDeHienThi = '';
      var soMonHienThi = dsMon ? dsMon.length : 0;

      if (tuKhoa) {
        tieuDeHienThi = t('thuc_don.ket_qua_cho') + ' “' + tuKhoa + '”';
      } else if (curCat) {
        dsLoai.forEach(function (c) {
          if (String(curCat) === String(c.id_loai)) nhomHienTai = c;
        });
        if (nhomHienTai) {
          tieuDeHienThi = boSo(tenNhom(nhomHienTai));
          soMonHienThi = nhomHienTai.so_mon;
        }
      } else if (activeGroupObj) {
        tieuDeHienThi = activeGroupObj.name;
        soMonHienThi = activeGroupObj.so_mon;
      }
    %>
    <div class="nh-head nh-center" style="margin-bottom:2rem">
      <% if (tuKhoa) { %>
        <h2 class="nh-section-title" style="font-size:clamp(1.5rem,3vw,2.1rem)">
          <%= tieuDeHienThi %>
        </h2>
        <p class="nh-lead"><%= t('thuc_don.tim_thay').replace('{n}', soMonHienThi) %></p>
      <% } else if (tieuDeHienThi) { %>
        <h2 class="nh-section-title" style="font-size:clamp(1.5rem,3vw,2.1rem)">
          <%= tieuDeHienThi %>
        </h2>
        <p class="nh-lead"><%= t('thuc_don.so_mon').replace('{n}', soMonHienThi) %></p>
      <% } %>
      <div class="nh-divider"></div>
    </div>

    <% if (dsMon && dsMon.length > 0) { %>
      <div class="nh-grid">
        <% dsMon.forEach(function(dish, i){ %>
          <article class="nh-dish nh-reveal" data-delay="<%= (i % 3) + 1 %>">
            <div class="nh-dish__media">
              <img src="/food/<%= dish.images %>" alt="<%= tenMon(dish).chinh %>" loading="lazy"
                   onerror="this.onerror=null;this.src='/mon-thay-the.svg'">
              <span class="nh-dish__price"><%= formatMoney(dish.gia_mon) %></span>
            </div>
            <div class="nh-dish__body">
              <h3><%= tenMon(dish).chinh %></h3>
              <p><% var tmd = tenMon(dish); %><%= tmd.phu || t('trang_chu.mon_mac_dinh_mo_ta') %></p>
              <a href="/detail?monid=<%= dish.id_mon %>" class="nh-dish__cta"><%= t('chung.dat_mon_ngay') %> <i class="fas fa-arrow-right"></i></a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="nh-center" style="padding:3rem 0">
        <i class="fas fa-utensils" style="font-size:2.4rem;color:var(--nh-gold)"></i>
        <p class="nh-lead" style="margin-top:1rem"><%= t('thuc_don.khong_thay') %></p>
        <% if (tuKhoa) { %>
          <a href="/menu" class="nh-btn nh-btn--outline nh-btn--sm" style="margin-top:1.2rem">
            <i class="fas fa-rotate-left"></i> <%= t('thuc_don.xem_toan_bo') %>
          </a>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/goi-y-mon') %>

<script>
(function () {
  'use strict';

  var thanh = document.getElementById('thanhMon');
  var dai = document.getElementById('daiMon');
  if (!thanh || !dai) return;

  /*
    Do chieu cao THUC TE cua thanh dieu huong roi truyen sang CSS.

    `.nh-thanh-mon` dinh o `top: var(--nh-nav-cao)`. Viet cung mot con so thi moi
    lan doi chieu cao nav - them mot muc menu, doi co logo, hay chi la ngon ngu
    khac lam chu dai hon - thanh nay lai lo ra mot khe ho, hoac chui xuong duoi
    nav va bi che mat.
  */
  function doNav() {
    var nav = document.querySelector('.nh-nav');
    if (nav) document.documentElement.style.setProperty('--nh-nav-cao', nav.offsetHeight + 'px');
  }

  var mui = thanh.querySelectorAll('.nh-thanh-mon__mui');

  /** Hien/an mui ten va bat/tat chung theo vi tri cuon hien tai. */
  function capNhatMui() {
    var cuonDuoc = dai.scrollWidth - dai.clientWidth > 4;
    thanh.classList.toggle('co-cuon', cuonDuoc);
    if (!cuonDuoc) return;
    mui[0].disabled = dai.scrollLeft <= 2;
    mui[1].disabled = dai.scrollLeft >= dai.scrollWidth - dai.clientWidth - 2;
  }

  mui.forEach(function (n) {
    n.addEventListener('click', function () {
      // Cuon 70% be ngang nhin thay: du de doi "trang" ma van chua vai muc cu
      // lai lam moc, khong lam khach mat dau vet minh dang o dau.
      dai.scrollBy({ left: Number(n.dataset.huong) * dai.clientWidth * 0.7, behavior: 'smooth' });
    });
  });

  dai.addEventListener('scroll', capNhatMui, { passive: true });
  window.addEventListener('resize', function () { doNav(); capNhatMui(); });

  /*
    Keo muc dang xem vao giua tam nhin.

    Bam mot danh muc la tai lai trang, dai cuon ve dau - muc vua chon co the nam
    ngoai man hinh va khach khong biet minh dang xem nhom nao. Dung `scrollLeft`
    truc tiep chu khong `scrollIntoView`: ham do cuon ca TRANG theo chieu doc,
    keo khach ra khoi vi tri ho dang doc.
  */
  var dangChon = dai.querySelector('.nh-muc.is-active') || dai.querySelector('.nh-muc--tim');
  if (dangChon) {
    dai.scrollLeft = dangChon.offsetLeft - (dai.clientWidth - dangChon.offsetWidth) / 2;
  }

  /* Them bong do khi thanh da dinh vao nav - de no tach khoi noi dung truot ben
     duoi. Dung IntersectionObserver voi mot moc dat ngay tren thanh, thay vi
     nghe su kien `scroll` chay hang tram lan mot giay. */
  var moc = document.createElement('div');
  moc.style.cssText = 'position:absolute;height:1px;width:1px';
  thanh.parentNode.insertBefore(moc, thanh);
  if (typeof IntersectionObserver === 'function') {
    new IntersectionObserver(function (muc) {
      thanh.classList.toggle('is-dinh', !muc[0].isIntersecting);
    }, { rootMargin: '-' + (parseInt(getComputedStyle(document.documentElement)
      .getPropertyValue('--nh-nav-cao'), 10) || 60) + 'px 0px 0px 0px' }).observe(moc);
  }

  doNav();
  capNhatMui();
})();
</script>

<%- include('partials/footer') %>
