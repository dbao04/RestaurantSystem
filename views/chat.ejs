<%- include('partials/header', { title: t('chat.tieu_de'), activeNav: 'chat' }) %>

<section class="nh-subhero" style="min-height: 32vh;">
  <div class="nh-subhero__bg nh-wa-koshi"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('chat.ho_tro') %></span>
    <h1><%= t('chat.tieu_de') %></h1>
    <div class="nh-crumbs">
      <a href="/"><%= t('dieu_huong.trang_chu') %></a> &nbsp;/&nbsp; <span>Chat</span>
    </div>
  </div>
</section>

<style>
  /* ================= Khung chat =================
     Bang mau va hoa tiet lay tu bien cua nhahang.css de trang nay khong lac
     ra khoi phan con lai cua khu khach.                                     */
  .ct-vo {
    max-width: 760px; margin: 0 auto;
    background: #fff; border-radius: 20px; overflow: hidden;
    box-shadow: var(--nh-shadow, 0 18px 50px -18px rgba(43,26,18,.45));
    border: 1px solid var(--nh-line, rgba(0,0,0,.08));
    display: flex; flex-direction: column;
  }

  /* ---- Dau khung ---- */
  .ct-dau {
    display: flex; align-items: center; gap: 12px; padding: 16px 20px;
    background: linear-gradient(135deg, var(--nh-brown, #4e342e), var(--nh-espresso, #2b1a12));
    color: #fff; position: relative;
  }
  .ct-dau::after {                       /* vien vang mong duoi dau khung */
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--nh-gold, #c8a24b), transparent);
  }
  .ct-dau__anh {
    width: 46px; height: 46px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--nh-gold, #c8a24b), var(--nh-gold-soft, #d9bd7e));
    display: flex; align-items: center; justify-content: center;
    color: var(--nh-espresso, #2b1a12); font-size: 22px;
  }
  .ct-dau__ten { font-family: var(--nh-serif, Georgia, serif); font-size: 18px; line-height: 1.2; }
  .ct-dau__phu { font-size: 12px; opacity: .75; }
  .ct-song {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; text-transform: uppercase; letter-spacing: .6px;
    padding: 5px 11px; border-radius: 999px;
    background: rgba(255,255,255,.12); margin-left: auto; white-space: nowrap;
  }
  .ct-song i {
    width: 7px; height: 7px; border-radius: 50%; background: #4ade80;
    box-shadow: 0 0 0 0 rgba(74,222,128,.7); animation: ct-dap 2s infinite;
  }
  @keyframes ct-dap {
    70%  { box-shadow: 0 0 0 7px rgba(74,222,128,0); }
    100% { box-shadow: 0 0 0 0 rgba(74,222,128,0); }
  }

  /* ---- Vung tin nhan ---- */
  .ct-than {
    position: relative; height: 460px; overflow-y: auto;
    padding: 20px; scroll-behavior: smooth;
    /* Hoa tiet ke Nhat (koshi) lam nen. Phong doi kich thuoc o va phu them mot
       lop kem ban trong suot len tren: de nguyen thi luoi ke qua day, nhin nhu
       giay ke o ly va tranh mat voi chinh cac bong bong. */
    background-color: var(--nh-cream, #faf6ef);
    background-image: linear-gradient(rgba(250,246,239,.74), rgba(250,246,239,.74)), var(--nh-koshi);
    background-size: auto, 56px 56px;
  }
  .ct-than::-webkit-scrollbar { width: 8px; }
  .ct-than::-webkit-scrollbar-thumb { background: rgba(43,26,18,.18); border-radius: 8px; }

  .ct-ngay { text-align: center; margin: 18px 0 14px; }
  .ct-ngay span {
    display: inline-block; padding: 4px 14px; border-radius: 999px;
    background: rgba(43,26,18,.07); color: var(--nh-muted, #5c5148);
    font-size: 11px; letter-spacing: .4px;
  }

  .ct-dong { display: flex; margin-bottom: 4px; align-items: flex-end; gap: 8px; }
  .ct-dong--toi { justify-content: flex-end; }
  .ct-dong--cuoi-nhom { margin-bottom: 14px; }

  .ct-anh-nv {
    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--nh-brown, #4e342e), var(--nh-espresso, #2b1a12));
    color: var(--nh-gold, #c8a24b);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 600;
  }
  .ct-anh-nv--an { visibility: hidden; }   /* giu cho, khong day bong bong lech */

  .ct-bong {
    max-width: 74%; padding: 10px 14px; position: relative;
    font-size: 14.5px; line-height: 1.55;
    animation: ct-hien .22s var(--nh-ease, ease);
  }
  /* pre-wrap chi dat o chinh cau chu, KHONG dat o ca bong bong: neu dat o bong
     bong thi moi dau xuong dong va thut le cua template EJS deu bien thanh
     khoang trang that, bong bong phinh to va cau chu bi day lech. */
  .ct-loi { white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere; }
  @keyframes ct-hien { from { opacity: 0; transform: translateY(6px); } }

  .ct-dong--ho  .ct-bong {
    background: #fff; color: var(--nh-ink, #241d18);
    border: 1px solid var(--nh-line, rgba(0,0,0,.08));
    border-radius: 16px 16px 16px 4px;
    box-shadow: var(--nh-shadow-sm, 0 8px 24px -12px rgba(43,26,18,.35));
  }
  .ct-dong--toi .ct-bong {
    background: linear-gradient(135deg, var(--nh-gold, #c8a24b), #b8923f);
    color: #fff; border-radius: 16px 16px 4px 16px;
    box-shadow: 0 8px 20px -12px rgba(200,162,75,.9);
  }
  /* Tin giua nhom: bo goc deu hai dau cho lien mach */
  .ct-dong--ho.ct-dong--tiep  .ct-bong { border-radius: 4px 16px 16px 4px; }
  .ct-dong--toi.ct-dong--tiep .ct-bong { border-radius: 16px 4px 4px 16px; }

  .ct-ten-nv {
    font-size: 11.5px; font-weight: 600; margin-bottom: 3px;
    color: var(--nh-brown, #4e342e);
  }
  .ct-gio { font-size: 10.5px; opacity: .6; margin-top: 4px; display: block; }
  .ct-dong--toi .ct-gio { text-align: right; }

  .ct-bong--cho { opacity: .55; }
  .ct-bong--loi { background: #b3453a !important; cursor: pointer; }

  /* ---- Trang thai rong ---- */
  .ct-rong { text-align: center; padding: 70px 20px; color: var(--nh-muted, #5c5148); }
  .ct-rong__vong {
    width: 84px; height: 84px; margin: 0 auto 16px; border-radius: 50%;
    background: rgba(200,162,75,.14); color: var(--nh-gold, #c8a24b);
    display: flex; align-items: center; justify-content: center; font-size: 40px;
  }
  .ct-rong h5 { font-family: var(--nh-serif, Georgia, serif); color: var(--nh-ink, #241d18); }

  /* ---- Nut xuong cuoi ---- */
  .ct-xuong {
    position: absolute; right: 18px; bottom: 16px; z-index: 3;
    width: 40px; height: 40px; border-radius: 50%; border: none;
    background: #fff; color: var(--nh-brown, #4e342e);
    box-shadow: 0 6px 18px -6px rgba(43,26,18,.5);
    display: none; align-items: center; justify-content: center; cursor: pointer;
    transition: transform .18s var(--nh-ease, ease);
  }
  .ct-xuong:hover { transform: translateY(-2px); }
  .ct-xuong.hien { display: flex; }

  /* ---- O nhap & Dinh kem anh / file ---- */
  .ct-chan { padding: 12px 16px 14px; background: #fff; border-top: 1px solid var(--nh-line, rgba(0,0,0,.08)); }
  .ct-xem-truoc {
    display: none; align-items: center; gap: 10px;
    padding: 8px 12px; margin-bottom: 10px;
    background: var(--nh-cream, #faf6ef);
    border: 1px dashed var(--nh-gold, #c8a24b);
    border-radius: 12px;
  }
  .ct-xem-truoc.hien { display: flex; }
  .ct-xem-truoc__thumb {
    width: 48px; height: 48px; border-radius: 8px; object-fit: cover;
    border: 1px solid rgba(0,0,0,.1); flex-shrink: 0; background: #fff;
    display: flex; align-items: center; justify-content: center;
    color: var(--nh-gold, #c8a24b); font-size: 20px;
  }
  .ct-xem-truoc__info { flex: 1; min-width: 0; }
  .ct-xem-truoc__ten {
    font-size: 13px; font-weight: 600; color: var(--nh-ink, #241d18);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .ct-xem-truoc__co { font-size: 11px; color: var(--nh-muted, #5c5148); }
  .ct-xem-truoc__xoa {
    width: 28px; height: 28px; border-radius: 50%; border: none;
    background: rgba(179,69,58,.12); color: #b3453a; cursor: pointer;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .ct-xem-truoc__xoa:hover { background: #b3453a; color: #fff; }

  .ct-hang { display: flex; align-items: flex-end; gap: 8px; }
  .ct-cong-cu { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
  .ct-nut-tep {
    width: 42px; height: 42px; border-radius: 50%;
    border: 1px solid var(--nh-line, rgba(0,0,0,.12));
    background: var(--nh-cream, #faf6ef); color: var(--nh-brown, #4e342e);
    font-size: 16px; cursor: pointer; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    transition: all .18s var(--nh-ease, ease);
  }
  .ct-nut-tep:hover {
    border-color: var(--nh-gold, #c8a24b);
    background: rgba(200,162,75,.15);
    color: var(--nh-espresso, #2b1a12);
    transform: translateY(-1px);
  }
  .ct-nhap {
    flex: 1; resize: none; border: 1px solid var(--nh-line, rgba(0,0,0,.12));
    border-radius: 22px; padding: 10px 16px; font-size: 14.5px; line-height: 1.5;
    max-height: 132px; outline: none; font-family: inherit;
    background: var(--nh-cream, #faf6ef); color: var(--nh-ink, #241d18);
    transition: border-color .18s, background .18s;
  }
  .ct-nhap:focus { border-color: var(--nh-gold, #c8a24b); background: #fff; }
  .ct-gui {
    width: 44px; height: 44px; border-radius: 50%; border: none; flex-shrink: 0;
    background: linear-gradient(135deg, var(--nh-gold, #c8a24b), #b8923f);
    color: #fff; font-size: 16px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: transform .18s var(--nh-ease, ease), opacity .18s;
  }
  .ct-gui:hover:not(:disabled) { transform: scale(1.07); }
  .ct-gui:disabled { opacity: .4; cursor: default; }
  .ct-meo { font-size: 11px; color: var(--nh-muted, #5c5148); opacity: .8; margin: 8px 0 0 6px; }

  /* Hien thi anh va file trong bong bong chat */
  .ct-anh-dinh-kem {
    display: block; max-width: 260px; max-height: 240px; width: auto; height: auto;
    border-radius: 10px; margin-bottom: 6px; cursor: zoom-in;
    object-fit: cover; border: 1px solid rgba(0,0,0,.08); background: #f8f5f0;
  }
  .ct-tep-dinh-kem {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px; border-radius: 10px; margin-bottom: 6px;
    background: rgba(0,0,0,.06); text-decoration: none !important;
    color: inherit !important; border: 1px solid rgba(0,0,0,.08);
    transition: background .15s;
  }
  .ct-dong--toi .ct-tep-dinh-kem {
    background: rgba(255,255,255,.18); border-color: rgba(255,255,255,.3); color: #fff !important;
  }
  .ct-tep-dinh-kem:hover { background: rgba(0,0,0,.1); }
  .ct-dong--toi .ct-tep-dinh-kem:hover { background: rgba(255,255,255,.26); }
  .ct-tep-dinh-kem__icon {
    width: 34px; height: 34px; border-radius: 8px;
    background: rgba(200,162,75,.2); color: var(--nh-espresso, #2b1a12);
    display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0;
  }
  .ct-dong--toi .ct-tep-dinh-kem__icon { background: rgba(255,255,255,.25); color: #fff; }
  .ct-tep-dinh-kem__meta { flex: 1; min-width: 0; }
  .ct-tep-dinh-kem__ten {
    font-size: 13px; font-weight: 600; display: block;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 190px;
  }
  .ct-tep-dinh-kem__co { font-size: 11px; opacity: .78; display: block; }

  /* Lightbox xem anh phong to */
  .ct-lightbox {
    position: fixed; inset: 0; z-index: 9999; background: rgba(18,12,9,.88);
    display: none; align-items: center; justify-content: center; padding: 20px;
  }
  .ct-lightbox.hien { display: flex; }
  .ct-lightbox img {
    max-width: 92vw; max-height: 88vh; border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0,0,0,.6); object-fit: contain;
  }
  .ct-lightbox__dong {
    position: absolute; top: 20px; right: 24px; width: 42px; height: 42px;
    border-radius: 50%; border: none; background: rgba(255,255,255,.16);
    color: #fff; font-size: 20px; cursor: pointer;
  }

  /* An nut tro ly ao noi tren chinh trang nay. Khach dang o day la dang muon
     noi chuyen voi NGUOI THAT; de hai khung chat chong len nhau vua roi vua
     che mat bong bong tin nhan o goc phai duoi tren dien thoai. */
  .cb-nut { display: none !important; }

  @media (max-width: 575.98px) {
    .ct-than { height: 60vh; padding: 14px; }
    .ct-bong { max-width: 84%; font-size: 14px; }
    .ct-dau { padding: 13px 15px; }
    .ct-meo { display: none; }        /* dien thoai khong co Shift + Enter */
  }
</style>

<section class="nh-section nh-section--cream">
  <div class="nh-container">
    <div class="ct-vo">

      <div class="ct-dau">
        <div class="ct-dau__anh"><i class="fas fa-headset"></i></div>
        <div>
          <div class="ct-dau__ten"><%= t('chat.ho_tro') %></div>
          <div class="ct-dau__phu"><%= t('chat.gio_lam') %></div>
        </div>
        <a href="tel:0825297297" style="margin-left:auto; display:inline-flex; align-items:center; gap:6px; padding:6px 13px; border-radius:999px; background:linear-gradient(135deg,#16a34a,#15803d); color:#fff; font-size:12px; font-weight:700; text-decoration:none; box-shadow:0 3px 10px rgba(22,163,74,.35);" title="Gọi ngay Hotline 0825 297 297">
          <i class="fas fa-phone-alt"></i> 0825 297 297
        </a>
        <span class="ct-song" style="margin-left:8px;"><i></i><%= t('chat.dang_hoat_dong') %></span>
      </div>

      <div class="ct-than" id="ct-than">
        <%
          // Dung mot bo dem duy nhat cho ca lan dung dau va cac tin den sau:
          // cung mot ham quyet dinh "co phai tin tiep theo cung nguoi khong" va
          // "da sang ngay moi chua", nen khong the lech giua HTML dung san va
          // HTML do JavaScript chen vao.
          var truoc = null;
        %>
        <% if (messages && messages.length > 0) { %>
          <% messages.forEach(function (m, i) {
               var d = new Date(m.thoigian);
               var toi = m.nguoi_gui === 'khach';
               var ngayMoi = !truoc || new Date(truoc.thoigian).toDateString() !== d.toDateString();
               var tiep = !ngayMoi && truoc && truoc.nguoi_gui === m.nguoi_gui;
               var ke = messages[i + 1];
               var cuoiNhom = !ke || ke.nguoi_gui !== m.nguoi_gui
                            || new Date(ke.thoigian).toDateString() !== d.toDateString();
               truoc = m;
          %>
            <% if (ngayMoi) { %>
              <div class="ct-ngay"><span data-ngay="<%= d.toISOString().slice(0,10) %>"><%= d.toLocaleDateString('vi-VN', { weekday:'long', day:'2-digit', month:'2-digit' }) %></span></div>
            <% } %>
            <div class="ct-dong <%= toi ? 'ct-dong--toi' : 'ct-dong--ho' %> <%= tiep ? 'ct-dong--tiep' : '' %> <%= cuoiNhom ? 'ct-dong--cuoi-nhom' : '' %>">
              <% if (!toi) { %>
                <div class="ct-anh-nv <%= tiep ? 'ct-anh-nv--an' : '' %>"><%= (m.ten_nv || t('chat.nhan_vien')).charAt(0).toUpperCase() %></div>
              <% } %>
              <div class="ct-bong">
                <% if (!toi && !tiep) { %><div class="ct-ten-nv"><%= m.ten_nv || t('chat.nhan_vien') %></div><% } %>
                <% if (m.duong_dan_file) { %>
                  <% if (m.loai_file === 'image') { %>
                    <img src="<%= m.duong_dan_file %>" alt="<%= m.ten_file || 'Hình ảnh' %>" class="ct-anh-dinh-kem" onclick="moLightboxAnh(this.src)" loading="lazy">
                  <% } else { %>
                    <a href="<%= m.duong_dan_file %>" download="<%= m.ten_file || 'tep_dinh_kem' %>" target="_blank" class="ct-tep-dinh-kem">
                      <span class="ct-tep-dinh-kem__icon"><i class="fas fa-file-alt"></i></span>
                      <span class="ct-tep-dinh-kem__meta">
                        <span class="ct-tep-dinh-kem__ten"><%= m.ten_file || 'Tệp đính kèm' %></span>
                        <% if (m.kich_thuoc_file) { %><span class="ct-tep-dinh-kem__co"><%= (m.kich_thuoc_file / 1024).toFixed(1) %> KB · Nhấn để tải</span><% } %>
                      </span>
                      <i class="fas fa-download" style="font-size:13px;opacity:.75"></i>
                    </a>
                  <% } %>
                <% } %>
                <% if (m.noi_dung) { %><div class="ct-loi"><%= m.noi_dung %></div><% } %>
                <span class="ct-gio" title="<%= d.toLocaleString('vi-VN') %>"><%= d.toLocaleTimeString('vi-VN', { hour:'2-digit', minute:'2-digit' }) %></span>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="ct-rong" id="ct-rong">
            <div class="ct-rong__vong"><i class="fas fa-comments"></i></div>
            <h5><%= t('chat.bat_dau') %></h5>
            <p class="mb-0"><%= t('chat.chua_co_tin') %></p>
          </div>
        <% } %>
        <button type="button" class="ct-xuong" id="ct-xuong" title="<%= t('chat.xuong_cuoi') %>">
          <i class="fas fa-arrow-down"></i>
        </button>
      </div>

      <div class="ct-chan">
        <!-- Thanh xem trước ảnh / tệp đính kèm -->
        <div class="ct-xem-truoc" id="ct-xem-truoc">
          <div class="ct-xem-truoc__thumb" id="ct-xem-truoc-thumb"><i class="fas fa-file-alt"></i></div>
          <div class="ct-xem-truoc__info">
            <div class="ct-xem-truoc__ten" id="ct-xem-truoc-ten"></div>
            <div class="ct-xem-truoc__co" id="ct-xem-truoc-co"></div>
          </div>
          <button type="button" class="ct-xem-truoc__xoa" id="ct-xoa-tep" title="Gỡ tệp đính kèm">
            <i class="fas fa-times"></i>
          </button>
        </div>

        <form action="/chat/send" method="POST" enctype="multipart/form-data" class="ct-hang" id="ct-form">
          <input type="file" id="ct-input-anh" accept="image/*" style="display:none">
          <input type="file" id="ct-input-file" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.csv,.zip,.rar,image/*" style="display:none">
          <div class="ct-cong-cu">
            <button type="button" class="ct-nut-tep" id="ct-chon-anh" title="Gửi hình ảnh">
              <i class="fas fa-image"></i>
            </button>
            <button type="button" class="ct-nut-tep" id="ct-chon-file" title="Đính kèm tệp / tài liệu">
              <i class="fas fa-paperclip"></i>
            </button>
          </div>
          <textarea class="ct-nhap" id="ct-nhap" name="noi_dung" rows="1"
                    placeholder="<%= t('chat.nhap_tin') %> (hoặc dán ảnh Ctrl+V)" autocomplete="off"></textarea>
          <button type="submit" class="ct-gui" id="ct-gui" title="<%= t('chung.gui') %>" disabled>
            <i class="fas fa-paper-plane"></i>
          </button>
        </form>
        <div class="ct-meo"><%= t('chat.goi_y_enter') %> · Hỗ trợ gửi ảnh & tệp đính kèm (tối đa 15MB)</div>
      </div>

    </div>
  </div>
</section>

<!-- Lightbox xem ảnh lớn -->
<div class="ct-lightbox" id="ct-lightbox" onclick="dongLightboxAnh(event)">
  <button type="button" class="ct-lightbox__dong" onclick="dongLightboxAnh(event)" aria-label="Đóng"><i class="fas fa-times"></i></button>
  <img id="ct-lightbox-img" src="" alt="Xem ảnh phóng to">
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
function moLightboxAnh(src) {
  var lb = document.getElementById('ct-lightbox');
  var img = document.getElementById('ct-lightbox-img');
  if (lb && img && src) {
    img.src = src;
    lb.classList.add('hien');
  }
}
function dongLightboxAnh(e) {
  if (e && e.target && e.target.id === 'ct-lightbox-img') return;
  var lb = document.getElementById('ct-lightbox');
  if (lb) lb.classList.remove('hien');
}

(function () {
  var NHAN = {
    nhanVien: <%- JSON.stringify(t('chat.nhan_vien')) %>,
    homNay:   <%- JSON.stringify(t('chat.hom_nay')) %>,
    homQua:   <%- JSON.stringify(t('chat.hom_qua')) %>,
    dangGui:  <%- JSON.stringify(t('chat.dang_gui')) %>,
    loiGui:   <%- JSON.stringify(t('chat.loi_gui')) %>
  };
  var NN = <%- JSON.stringify(nn) %>;

  var than  = document.getElementById('ct-than');
  var form  = document.getElementById('ct-form');
  var nhap  = document.getElementById('ct-nhap');
  var nutGui = document.getElementById('ct-gui');
  var nutXuong = document.getElementById('ct-xuong');
  var inputAnh = document.getElementById('ct-input-anh');
  var inputFile = document.getElementById('ct-input-file');
  var nutChonAnh = document.getElementById('ct-chon-anh');
  var nutChonFile = document.getElementById('ct-chon-file');
  var khungXemTruoc = document.getElementById('ct-xem-truoc');
  var thumbXemTruoc = document.getElementById('ct-xem-truoc-thumb');
  var tenXemTruoc = document.getElementById('ct-xem-truoc-ten');
  var coXemTruoc = document.getElementById('ct-xem-truoc-co');
  var nutXoaTep = document.getElementById('ct-xoa-tep');
  var userId = '<%= session.userId %>';

  var tepDangChon = null; // File object hiện tại

  var socket = io();
  if (userId) socket.emit('join-room', userId);

  function el(the, lop, chu) {
    var e = document.createElement(the);
    if (lop) e.className = lop;
    if (chu !== undefined) e.textContent = chu;
    return e;
  }

  function dinhDangDungLuong(bytes) {
    var b = Number(bytes || 0);
    if (b < 1024) return b + ' B';
    if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
    return (b / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function chonTep(file) {
    if (!file) return;
    if (file.size > 15 * 1024 * 1024) {
      alert('Kích thước tệp vượt quá giới hạn 15MB. Vui lòng chọn tệp nhỏ hơn.');
      return;
    }
    tepDangChon = file;
    tenXemTruoc.textContent = file.name || 'tep_dinh_kem';
    var laAnh = (file.type && file.type.indexOf('image/') === 0) || /\.(jpg|jpeg|png|gif|webp|bmp|svg)$/i.test(file.name || '');
    coXemTruoc.textContent = (laAnh ? 'Hình ảnh · ' : 'Tệp đính kèm · ') + dinhDangDungLuong(file.size);
    thumbXemTruoc.innerHTML = '';
    if (laAnh) {
      var img = document.createElement('img');
      img.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:7px;';
      img.src = URL.createObjectURL(file);
      thumbXemTruoc.appendChild(img);
    } else {
      var ic = document.createElement('i');
      ic.className = 'fas fa-file-alt';
      thumbXemTruoc.appendChild(ic);
    }
    khungXemTruoc.classList.add('hien');
    chinhCao();
    nhap.focus();
  }

  function xoaTepDangChon() {
    tepDangChon = null;
    if (inputAnh) inputAnh.value = '';
    if (inputFile) inputFile.value = '';
    if (khungXemTruoc) khungXemTruoc.classList.remove('hien');
    chinhCao();
  }

  if (nutChonAnh && inputAnh) {
    nutChonAnh.onclick = function () { inputAnh.click(); };
    inputAnh.onchange = function () { if (this.files && this.files[0]) chonTep(this.files[0]); };
  }
  if (nutChonFile && inputFile) {
    nutChonFile.onclick = function () { inputFile.click(); };
    inputFile.onchange = function () { if (this.files && this.files[0]) chonTep(this.files[0]); };
  }
  if (nutXoaTep) {
    nutXoaTep.onclick = xoaTepDangChon;
  }

  // Hỗ trợ dán ảnh trực tiếp từ Clipboard (Ctrl+V)
  nhap.addEventListener('paste', function (e) {
    var items = (e.clipboardData || window.clipboardData || {}).items;
    if (!items) return;
    for (var i = 0; i < items.length; i++) {
      if (items[i].kind === 'file') {
        var f = items[i].getAsFile();
        if (f) {
          chonTep(f);
          break;
        }
      }
    }
  });

  var dinhDangGio = new Intl.DateTimeFormat(NN, { hour: '2-digit', minute: '2-digit' });
  var dinhDangNgay = new Intl.DateTimeFormat(NN, { weekday: 'long', day: '2-digit', month: '2-digit' });

  function khoaNgay(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0')
         + '-' + String(d.getDate()).padStart(2, '0');
  }
  function nhanNgay(d) {
    var nay = new Date(), qua = new Date(); qua.setDate(nay.getDate() - 1);
    if (khoaNgay(d) === khoaNgay(nay)) return NHAN.homNay;
    if (khoaNgay(d) === khoaNgay(qua)) return NHAN.homQua;
    return dinhDangNgay.format(d);
  }

  function ngayCuoiCung() {
    var ds = than.querySelectorAll('.ct-ngay span[data-ngay]');
    return ds.length ? ds[ds.length - 1].getAttribute('data-ngay') : null;
  }
  function dongCuoiCung() {
    var ds = than.querySelectorAll('.ct-dong');
    return ds.length ? ds[ds.length - 1] : null;
  }

  function chenPhanTepVaoBong(bong, tin) {
    if (!tin.duong_dan_file) return;
    if (tin.loai_file === 'image') {
      var img = document.createElement('img');
      img.className = 'ct-anh-dinh-kem';
      img.src = tin.duong_dan_file;
      img.alt = tin.ten_file || 'Hình ảnh';
      img.onclick = function () { moLightboxAnh(img.src); };
      bong.appendChild(img);
    } else {
      var a = document.createElement('a');
      a.className = 'ct-tep-dinh-kem';
      a.href = tin.duong_dan_file;
      a.target = '_blank';
      a.setAttribute('download', tin.ten_file || 'tep_dinh_kem');

      var iconWrap = el('span', 'ct-tep-dinh-kem__icon');
      var ic = document.createElement('i');
      ic.className = 'fas fa-file-alt';
      iconWrap.appendChild(ic);
      a.appendChild(iconWrap);

      var meta = el('span', 'ct-tep-dinh-kem__meta');
      meta.appendChild(el('span', 'ct-tep-dinh-kem__ten', tin.ten_file || 'Tệp đính kèm'));
      if (tin.kich_thuoc_file) {
        meta.appendChild(el('span', 'ct-tep-dinh-kem__co', dinhDangDungLuong(tin.kich_thuoc_file) + ' · Nhấn để tải'));
      }
      a.appendChild(meta);

      var dlIcon = document.createElement('i');
      dlIcon.className = 'fas fa-download';
      dlIcon.style.cssText = 'font-size:13px;opacity:.75';
      a.appendChild(dlIcon);

      bong.appendChild(a);
    }
  }

  function chen(tin, tam) {
    var rong = document.getElementById('ct-rong');
    if (rong) rong.remove();

    var d = tin.thoigian ? new Date(tin.thoigian) : new Date();
    var toi = tin.nguoi_gui === 'khach';

    if (ngayCuoiCung() !== khoaNgay(d)) {
      var vach = el('div', 'ct-ngay');
      var nhan = el('span', null, nhanNgay(d));
      nhan.setAttribute('data-ngay', khoaNgay(d));
      vach.appendChild(nhan);
      than.insertBefore(vach, nutXuong);
    }

    var cuoi = dongCuoiCung();
    var tiep = !!cuoi && cuoi.classList.contains(toi ? 'ct-dong--toi' : 'ct-dong--ho')
               && !cuoi.classList.contains('ct-dong--cuoi-nhom');
    if (cuoi && tiep) cuoi.classList.remove('ct-dong--cuoi-nhom');

    var dong = el('div', 'ct-dong ' + (toi ? 'ct-dong--toi' : 'ct-dong--ho')
                       + (tiep ? ' ct-dong--tiep' : '') + ' ct-dong--cuoi-nhom');

    if (!toi) {
      var ten = tin.ten_nv || NHAN.nhanVien;
      dong.appendChild(el('div', 'ct-anh-nv' + (tiep ? ' ct-anh-nv--an' : ''),
                          ten.charAt(0).toUpperCase()));
    }

    var bong = el('div', 'ct-bong' + (tam ? ' ct-bong--cho' : ''));
    if (!toi && !tiep) bong.appendChild(el('div', 'ct-ten-nv', tin.ten_nv || NHAN.nhanVien));
    chenPhanTepVaoBong(bong, tin);
    if (tin.noi_dung) {
      bong.appendChild(el('div', 'ct-loi', tin.noi_dung));
    }
    var gio = el('span', 'ct-gio', tam ? NHAN.dangGui : dinhDangGio.format(d));
    gio.title = d.toLocaleString(NN);
    bong.appendChild(gio);
    dong.appendChild(bong);

    than.insertBefore(dong, nutXuong);
    return dong;
  }

  /* ---------- cuon ---------- */
  function xuongCuoi(muot) {
    than.scrollTo({ top: than.scrollHeight, behavior: muot ? 'smooth' : 'auto' });
  }
  function ganDay() { return than.scrollHeight - than.scrollTop - than.clientHeight < 120; }
  than.addEventListener('scroll', function () { nutXuong.classList.toggle('hien', !ganDay()); });
  nutXuong.onclick = function () { xuongCuoi(true); };
  xuongCuoi(false);

  /* ---------- o nhap tu gian cao ---------- */
  function chinhCao() {
    nhap.style.height = 'auto';
    nhap.style.height = Math.min(nhap.scrollHeight, 132) + 'px';
    nutGui.disabled = (!nhap.value.trim() && !tepDangChon);
  }
  nhap.addEventListener('input', chinhCao);
  nhap.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey && window.matchMedia('(min-width: 576px)').matches) {
      e.preventDefault();
      form.requestSubmit();
    }
  });

  /* ---------- gui ---------- */
  var hangCho = [];      // cac bong bong tam dang doi may chu doi lai

  form.onsubmit = async function (e) {
    e.preventDefault();
    var noiDung = nhap.value.trim();
    var tepGui = tepDangChon;
    if (!noiDung && !tepGui) return;

    nhap.value = '';
    xoaTepDangChon();

    var laAnhTam = tepGui && ((tepGui.type && tepGui.type.indexOf('image/') === 0) || /\.(jpg|jpeg|png|gif|webp|bmp|svg)$/i.test(tepGui.name || ''));
    var tinTam = {
      noi_dung: noiDung,
      nguoi_gui: 'khach',
      loai_file: tepGui ? (laAnhTam ? 'image' : 'file') : null,
      duong_dan_file: tepGui && laAnhTam ? URL.createObjectURL(tepGui) : (tepGui ? '#' : null),
      ten_file: tepGui ? tepGui.name : null,
      kich_thuoc_file: tepGui ? tepGui.size : null
    };
    var bongTam = chen(tinTam, true);
    hangCho.push({ noiDung: noiDung, coTep: !!tepGui, dong: bongTam });
    xuongCuoi(true);

    try {
      var fd = new FormData();
      fd.append('noi_dung', noiDung);
      if (tepGui) fd.append('tep_dinh_kem', tepGui);

      var res = await fetch('/chat/send', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: fd
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
    } catch (err) {
      console.error('Loi gui tin nhan:', err);
      var i = hangCho.findIndex(function (x) { return x.dong === bongTam; });
      if (i > -1) hangCho.splice(i, 1);
      var b = bongTam.querySelector('.ct-bong');
      b.classList.remove('ct-bong--cho');
      b.classList.add('ct-bong--loi');
      b.querySelector('.ct-gio').textContent = NHAN.loiGui;
      b.onclick = function () { bongTam.remove(); nhap.value = noiDung; chinhCao(); nhap.focus(); };
    }
  };

  /* ---------- nhan tin ---------- */
  socket.on('new-message', function (data) {
    if (data.nguoi_gui === 'khach') {
      var i = hangCho.findIndex(function (x) {
        return x.noiDung === (data.noi_dung || '') && x.coTep === !!data.duong_dan_file;
      });
      if (i > -1) {
        var muc = hangCho.splice(i, 1)[0];
        var b = muc.dong.querySelector('.ct-bong');
        b.classList.remove('ct-bong--cho');
        // Cap nhat link file that tu server neu co
        var linkTep = b.querySelector('a.ct-tep-dinh-kem');
        if (linkTep && data.duong_dan_file) linkTep.href = data.duong_dan_file;
        var anhTep = b.querySelector('img.ct-anh-dinh-kem');
        if (anhTep && data.duong_dan_file) anhTep.src = data.duong_dan_file;
        var g = b.querySelector('.ct-gio');
        var d = new Date(data.thoigian || Date.now());
        g.textContent = dinhDangGio.format(d);
        g.title = d.toLocaleString(NN);
        return;
      }
    }
    var gan = ganDay();
    chen(data, false);
    if (gan) xuongCuoi(true); else nutXuong.classList.add('hien');
  });
})();
</script>

<%- include('partials/footer') %>
