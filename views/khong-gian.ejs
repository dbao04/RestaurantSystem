<%- include('partials/header', { title: t('khong_gian.tieu_de') }) %>
<%
/*
  KHONG GIAN NHA HANG - anh, suc chua va tien ich tung khu.
  Du lieu: services/datTiecService.docKhongGian() (bang vitri + ban).
  Sanh tiec (la_sanh_tiec) duoc dua len dau, nen toi, nut dan sang /dat-tiec.
*/
var sanh = khongGian.filter(function (k) { return k.la_sanh_tiec; });
var khuThuong = khongGian.filter(function (k) { return !k.la_sanh_tiec; });
var nhanKhu = function (k) {
  if (k.la_sanh_tiec) return { icon: 'fa-crown', chu: t('khong_gian.nhan_sanh_tiec'), lop: 'kg-tag--gala' };
  if (k.la_vip) return { icon: 'fa-door-closed', chu: t('khong_gian.nhan_phong_rieng'), lop: '' };
  if (k.ngoai_troi) return { icon: 'fa-leaf', chu: t('khong_gian.nhan_ngoai_troi'), lop: '' };
  return { icon: 'fa-utensils', chu: t('khong_gian.nhan_khu_chung'), lop: '' };
};
var anhCua = function (k) {
  return (k.thu_vien_anh && k.thu_vien_anh.length) ? k.thu_vien_anh : ['/images/khong-gian/sanh-chinh-1.jpg'];
};
var veKhu = function (k, dao) {
  var n = nhanKhu(k), ds = anhCua(k);
  var html = '';
  html += '<article class="kg-khu' + (dao ? ' kg-khu--dao' : '') + '" id="khu-' + k.id + '">';
  html += '<div class="kg-gallery" data-gallery data-ten="' + escapeHtml(dichNd(k.ten)) + '" data-anh="' + escapeHtml(JSON.stringify(ds)) + '">';
  html += '<button type="button" class="kg-gallery__main" data-mo="0" aria-label="' + t('khong_gian.xem_anh_lon') + ' ' + escapeHtml(dichNd(k.ten)) + '">';
  html += '<img src="' + ds[0] + '" alt="' + escapeHtml(dichNd(k.ten)) + '" loading="lazy">';
  html += '<span class="kg-gallery__count"><i class="fas fa-images"></i> ' + t('khong_gian.so_anh', { n: ds.length }) + '</span></button>';
  if (ds.length > 1) {
    html += '<div class="kg-gallery__thumbs">';
    ds.forEach(function (a, i) {
      html += '<button type="button" data-thumb="' + i + '"' + (i === 0 ? ' class="is-active"' : '') + ' aria-label="' + t('khong_gian.anh_so', { n: i + 1 }) + '"><img src="' + a + '" alt="" loading="lazy"></button>';
    });
    html += '</div>';
  }
  html += '</div>';
  html += '<div class="kg-info">';
  html += '<span class="kg-tag ' + n.lop + '"><i class="fas ' + n.icon + '"></i> ' + n.chu + '</span>';
  html += '<h3>' + escapeHtml(dichNd(k.ten)) + '</h3>';
  if (k.mo_ta) html += '<div class="kg-ngan">' + escapeHtml(dichNd(k.mo_ta)) + '</div>';
  if (k.mo_ta_dai) html += '<p class="kg-dai">' + escapeHtml(dichNd(k.mo_ta_dai)) + '</p>';
  html += '<div class="kg-stats">';
  html += '<div class="kg-stat"><b>' + k.so_ban + '</b><span>' + (k.la_vip ? t('khong_gian.dv_phong') : t('khong_gian.dv_ban')) + '</span></div>';
  html += '<div class="kg-stat"><b>' + (k.la_sanh_tiec ? k.tiec_toi_da : k.tong_cho) + '</b><span>' + t('khong_gian.suc_chua') + '</span></div>';
  html += '<div class="kg-stat"><b>' + (k.cho_min === k.cho_max ? k.cho_max : k.cho_min + '–' + k.cho_max) + '</b><span>' + t('khong_gian.khach_ban') + '</span></div>';
  html += '</div>';
  if (k.tien_ich && k.tien_ich.length) {
    html += '<div class="kg-chips">';
    k.tien_ich.forEach(function (ti) { html += '<span><i class="fas fa-check"></i> ' + escapeHtml(dichNd(ti)) + '</span>'; });
    html += '</div>';
  }
  html += '<div class="kg-actions">';
  if (k.cho_dat_truoc) {
    html += '<a href="/dat-ban?khu_vuc=' + k.id + '" class="nh-btn nh-btn--gold"><i class="fas fa-calendar-check"></i> ' + escapeHtml(t('khong_gian.dat_ban_tai', { khu: dichNd(k.ten) })) + '</a>';
  }
  if (k.tiec_toi_da > 0) {
    html += '<a href="/dat-tiec?sanh=' + k.id + '#form-dat-tiec" class="nh-btn ' + (k.cho_dat_truoc ? 'nh-btn--outline' : 'nh-btn--gold') + '"><i class="fas fa-glass-cheers"></i> ' + t('khong_gian.dat_tiec_khach', { tu: k.tiec_toi_thieu, den: k.tiec_toi_da }) + '</a>';
  }
  html += '</div></div></article>';
  return html;
};
function escapeHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}
%>
<link rel="stylesheet" href="/su-kien.css">

<section class="nh-subhero">
  <div class="nh-subhero__bg" style="background-image:url('/images/khong-gian/sanh-chinh-1.jpg')"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('khong_gian.eyebrow') %></span>
    <h1><%= t('khong_gian.h1') %></h1>
    <div class="nh-crumbs">
      <a href="/"><%= t('khong_gian.crumb') %></a> &nbsp;/&nbsp; <span><%= t('khong_gian.tieu_de') %></span>
    </div>
  </div>
</section>

<div class="sk">
  <section class="sk-section sk-section--cream" style="padding-bottom:1.5rem">
    <div class="nh-container">
      <div class="sk-head" style="margin-bottom:0">
        <span class="sk-eyebrow"><%= t('khong_gian.chon_cho') %></span>
        <h2><%= t('khong_gian.moi_khu') %></h2>
        <p><%= t('khong_gian.gioi_thieu') %></p>
        <nav class="sk-jump" aria-label="<%= t('khong_gian.cac_khu') %>">
          <% khongGian.forEach(function (k) { var n = nhanKhu(k); %>
            <a href="#khu-<%= k.id %>"><i class="fas <%= n.icon %>"></i> <%= dichNd(k.ten) %></a>
          <% }) %>
        </nav>
      </div>
    </div>
  </section>

  <section class="sk-section sk-section--cream" style="padding-top:0">
    <div class="nh-container">
      <% khuThuong.forEach(function (k, i) { %><%- veKhu(k, i % 2 === 1) %><% }) %>
    </div>
  </section>

  <% if (sanh.length) { %>
  <section class="sk-section kg-gala-wrap">
    <div class="nh-container">
      <div class="sk-head" style="margin-bottom:0">
        <span class="sk-eyebrow"><%= t('khong_gian.dip_trong_dai') %></span>
        <h2><%= t('khong_gian.sanh_gala') %></h2>
        <p><%= t('khong_gian.gala_mo_ta') %></p>
      </div>
      <% sanh.forEach(function (k, i) { %><%- veKhu(k, i % 2 === 1) %><% }) %>
    </div>
  </section>
  <% } %>

  <section class="sk-section sk-section--cream">
    <div class="nh-container">
      <div class="sk-cta">
        <div class="sk-cta__bg" style="background-image:url('/images/khong-gian/tiec-cuoi-2.jpg')"></div>
        <span class="sk-eyebrow"><%= t('khong_gian.cta_eyebrow') %></span>
        <h2><%= t('khong_gian.cta_h2') %></h2>
        <p><%= t('khong_gian.cta_mo_ta') %></p>
        <div class="kg-actions" style="justify-content:center">
          <a href="/dat-tiec" class="nh-btn nh-btn--gold"><i class="fas fa-glass-cheers"></i> <%= t('khong_gian.cta_xem_td') %></a>
          <a href="/dat-ban" class="nh-btn nh-btn--outline" style="color:#fff;border-color:rgba(255,255,255,.6)"><i class="fas fa-utensils"></i> <%= t('khong_gian.cta_dat_ban') %></a>
        </div>
      </div>
    </div>
  </section>
</div>

<div class="sk-lightbox" id="skLightbox" hidden role="dialog" aria-modal="true" aria-label="<%= t('khong_gian.xem_anh') %>">
  <button type="button" class="sk-lightbox__btn sk-lightbox__close" data-lb="dong" aria-label="<%= t('khong_gian.dong') %>"><i class="fas fa-times"></i></button>
  <button type="button" class="sk-lightbox__btn sk-lightbox__prev" data-lb="truoc" aria-label="<%= t('khong_gian.anh_truoc') %>"><i class="fas fa-chevron-left"></i></button>
  <img id="skLbImg" src="" alt="">
  <button type="button" class="sk-lightbox__btn sk-lightbox__next" data-lb="sau" aria-label="<%= t('khong_gian.anh_sau') %>"><i class="fas fa-chevron-right"></i></button>
  <div class="sk-lightbox__cap" id="skLbCap"></div>
</div>

<script>
(function () {
  var lb = document.getElementById('skLightbox');
  var lbImg = document.getElementById('skLbImg');
  var lbCap = document.getElementById('skLbCap');
  var ds = [], ten = '', vt = 0;

  function ve() {
    lbImg.src = ds[vt];
    lbImg.alt = ten;
    lbCap.textContent = ten + ' — ' + (vt + 1) + ' / ' + ds.length;
  }
  function mo(g, i) {
    ds = JSON.parse(g.getAttribute('data-anh'));
    ten = g.getAttribute('data-ten');
    vt = i; ve();
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function dong() { lb.hidden = true; document.body.style.overflow = ''; }
  function buoc(d) { vt = (vt + d + ds.length) % ds.length; ve(); }

  document.querySelectorAll('[data-gallery]').forEach(function (g) {
    var anh = JSON.parse(g.getAttribute('data-anh'));
    var main = g.querySelector('.kg-gallery__main');
    var hien = 0;
    main.addEventListener('click', function () { mo(g, hien); });
    g.querySelectorAll('[data-thumb]').forEach(function (t) {
      t.addEventListener('click', function () {
        hien = Number(t.getAttribute('data-thumb'));
        main.querySelector('img').src = anh[hien];
        g.querySelectorAll('[data-thumb]').forEach(function (x) { x.classList.toggle('is-active', x === t); });
      });
    });
  });

  lb.addEventListener('click', function (e) {
    var nut = e.target.closest('[data-lb]');
    if (nut) {
      var h = nut.getAttribute('data-lb');
      if (h === 'dong') dong(); else buoc(h === 'sau' ? 1 : -1);
      return;
    }
    if (e.target === lb) dong();
  });
  document.addEventListener('keydown', function (e) {
    if (lb.hidden) return;
    if (e.key === 'Escape') dong();
    if (e.key === 'ArrowRight') buoc(1);
    if (e.key === 'ArrowLeft') buoc(-1);
  });
})();
</script>

<%- include('partials/footer') %>
