<%- include('partials/header', { title: t('danh_gia.tieu_de') }) %>

<section class="nh-subhero" style="min-height: 32vh;">
  <div class="nh-subhero__bg nh-wa-koshi"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('danh_gia.tieu_de_ngan') %></span>
    <h1><%= t('danh_gia.tieu_de') %></h1>
    <div class="nh-crumbs">
      <a href="/"><%= t('dieu_huong.trang_chu') %></a> &nbsp;/&nbsp; <%= t('danh_gia.tieu_de_ngan') %>
    </div>
  </div>
</section>

<section class="nh-section nh-section--cream">
  <div class="nh-container">
    <% if (msg) { %>
      <div class="nh-panel nh-reveal" style="border-left: 4px solid <%= (typeof msgType !== 'undefined' && msgType === 'danger') ? '#c0392b' : 'var(--nh-gold)' %>; margin-bottom: 2rem;">
        <div style="display: flex; gap: .9rem; align-items: center;">
          <i class="fas <%= (typeof msgType !== 'undefined' && msgType === 'danger') ? 'fa-circle-exclamation' : 'fa-circle-check' %>"
             style="color: <%= (typeof msgType !== 'undefined' && msgType === 'danger') ? '#c0392b' : 'var(--nh-gold)' %>; font-size: 1.3rem;"></i>
          <span><%= msg %></span>
        </div>
      </div>
    <% } %>

    <div class="row justify-content-center">
      <!-- Form đánh giá -->
      <div class="col-lg-6 mb-4">
        <% if (canRate) { %>
        <div class="nh-card nh-reveal">
          <div class="nh-card__head">
            <i class="fas fa-star"></i>
            <h3><%= t('danh_gia.gui_cua_ban') %></h3>
          </div>
          <div class="nh-card__body">
            <form action="/rating" method="POST">
              <div class="nh-field text-center">
                <label class="d-block mb-2" style="font-weight:600;"><%= t('danh_gia.chat_luong') %></label>
                <div id="star-rating" class="mb-2">
                  <% for(let i = 5; i >= 1; i--) { %>
                    <input type="radio" id="star<%= i %>" name="sao" value="<%= i %>" <%= i === 5 ? 'checked' : '' %> style="display:none;">
                    <label for="star<%= i %>" style="font-size:32px; color:#ddd; cursor:pointer;" class="star-label">&#9733;</label>
                  <% } %>
                </div>
              </div>

              <div class="nh-field">
                <label><i class="fas fa-comment-dots mr-1 text-muted"></i> <%= t('danh_gia.nhan_xet') %></label>
                <textarea class="form-control" name="noi_dung" rows="4" placeholder="<%= t('danh_gia.goi_y') %>"></textarea>
              </div>

              <div style="margin-top: 1.5rem;">
                <button type="submit" class="nh-btn nh-btn--gold" style="width: 100%; justify-content: center;">
                  <i class="fas fa-paper-plane"></i> <%= t('danh_gia.gui') %>
                </button>
              </div>
            </form>
          </div>
        </div>
        <% } else { %>
          <div class="nh-card nh-reveal">
            <div class="nh-card__body text-center" style="padding: 2.5rem 1.5rem;">
              <i class="fas fa-circle-info" style="font-size: 40px; color: var(--nh-gold); display: block; margin-bottom: 12px;"></i>
              <h4 style="margin-bottom: 8px;"><%= t('danh_gia.rat_tiec') %></h4>
              <p class="text-muted mb-0">Bạn cần trải nghiệm cấu trúc dịch vụ của chúng tôi bằng cách hoàn thành ít nhất một đơn đặt bàn mới có thể gửi đánh giá dịch vụ.</p>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Danh sách đánh giá -->
      <div class="col-lg-6">
        <div class="nh-card nh-reveal">
          <div class="nh-card__head">
            <i class="fas fa-comments"></i>
            <h3><%= t('danh_gia.gan_day') %></h3>
          </div>
          <div class="nh-card__body" style="max-height: 480px; overflow-y: auto;">
            <% if (ratings && ratings.length > 0) { %>
              <% ratings.forEach(r => { %>
                <div style="padding-bottom: 1.2rem; margin-bottom: 1.2rem; border-bottom: 1px solid var(--nh-line);">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <strong><%= r.ten %></strong>
                    <span style="color: var(--nh-gold); font-size: 1.1rem; letter-spacing: 2px;">
                      <% for(let i=1; i<=5; i++) { %><% if(i<=r.sao) { %>★<% } else { %>☆<% } %><% } %>
                    </span>
                  </div>
                  <p style="margin-bottom: 4px; color: var(--nh-ink);"><%- r.noi_dung ? r.noi_dung : '<em class="text-muted">' + t('danh_gia.khong_nhan_xet') + '</em>' %></p>
                  <small class="text-muted"><%= new Date(r.thoigian).toLocaleDateString('vi-VN') %></small>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-center text-muted my-4"><%= t('danh_gia.chua_co') %></p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #star-rating { display: flex; flex-direction: row-reverse; justify-content: center; gap: 4px; }
  #star-rating label { color: #d0c8b8; transition: color 0.2s; }
  #star-rating input:checked ~ label,
  #star-rating label:hover,
  #star-rating label:hover ~ label { color: var(--nh-gold) !important; }
</style>

<%- include('partials/footer') %>
