<%
/**
 * Bieu tuong NHA HANG BAO DOAN - dia + dao + nia, ve bang SVG noi tuyen.
 *
 * Truoc day cho la emoji 🍽️. Emoji phu thuoc font he thong: tren Windows no roi
 * ve Segoe UI Emoji va hien ra mot khoi mo nhat lech mau, co may khong co font
 * thi thanh o vuong. SVG noi tuyen thi moi may ve giong nhau, an theo mau chu
 * dao cua giao dien, va khong can tai tu CDN nen khong hong khi mat mang.
 *
 * Tham so: cao (px, mac dinh 24), mau (mac dinh vang dong thuong hieu).
 */
var _cao = typeof cao !== 'undefined' ? cao : 24;
var _mau = typeof mau !== 'undefined' ? mau : '#c8a951';
%><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="<%= _cao %>" height="<%= _cao %>"
     fill="none" stroke="<%= _mau %>" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
     role="img" aria-label="Nhà Hàng Bảo Đoàn" style="flex:none; vertical-align:middle">
  <circle cx="16" cy="16" r="8.5"/>
