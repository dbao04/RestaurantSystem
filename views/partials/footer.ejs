    <!-- Điều khiển giao diện mới: nav đổi nền khi cuộn, menu mobile, hiện dần -->
    <script>
      (function () {
        var nav = document.getElementById('nh-nav');
        var heroNav = nav && !nav.classList.contains('is-solid');
        if (heroNav) {
          var onScroll = function () { nav.classList.toggle('is-solid', window.scrollY > 60); };
          window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
        }
        var burger = document.getElementById('nh-burger');
        var menu = document.getElementById('nh-menu');
        if (burger && menu) {
          burger.addEventListener('click', function () { menu.classList.toggle('is-open'); });
          menu.querySelectorAll('a').forEach(function (a) {
            a.addEventListener('click', function () { menu.classList.remove('is-open'); });
          });
        }
        var els = document.querySelectorAll('.nh-reveal');
        if ('IntersectionObserver' in window && els.length) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
          }, { threshold: 0.12 });
          els.forEach(function (el) { io.observe(el); });
        } else { els.forEach(function (el) { el.classList.add('is-in'); }); }
      })();
    </script>


