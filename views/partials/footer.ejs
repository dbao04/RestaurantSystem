  <!-- Socket.io & Notifications cho Khách hàng -->
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    const userId = '<%= typeof session !== "undefined" && session.userId ? session.userId : "" %>';
    if(userId) {
      const socket = io();
      socket.emit('join-room', userId);

      const notifSound = new Audio('/sounds/notification.mp3');

      // Nhận thông báo thanh toán thành công
      socket.on('payment-success', function(data) {
        notifSound.play().catch(e => console.log('Autoplay prevent on audio'));
        Swal.fire({
          title: data.title,
          text: data.message,
          icon: 'success',
          confirmButtonText: 'Đóng',
          timer: 10000,
          timerProgressBar: true
        });
      });
      
      // Nếu có chat event (new-message) - Đã xử lý ở trang Chat nhưng gắn để nếu ngoài trang vẫn có popup tin mới (opt)
      socket.on('new-message', function(data) {
        if(!window.location.pathname.includes('/chat') && data.nguoi_gui !== 'khach') {
            notifSound.play().catch(e=>console.log(e));
            Swal.fire({
              title: "Tin nhắn mới!",
              text: data.noi_dung,
              icon: 'info',
              toast: true,
              position: 'bottom-end',
              showConfirmButton: false,
              timer: 5000
            });
        }
      });
    }
  </script>
    
  <script>
(function () {
  /*
    Menu doi ngon ngu.

    Mo bang BAM chu khong phai :hover — tren dien thoai khong co con tro, va
    menu chi hien khi hover thi khach dung dien thoai khong bao gio mo duoc.
  */
  var boc = document.querySelector('.nh-lang');
  var nut = document.getElementById('nh-lang-nut');
  if (!boc || !nut) return;

  function dong() { boc.classList.remove('is-open'); nut.setAttribute('aria-expanded', 'false'); }

  nut.addEventListener('click', function (e) {
    e.stopPropagation();
    var mo = boc.classList.toggle('is-open');
    nut.setAttribute('aria-expanded', mo ? 'true' : 'false');
  });
  document.addEventListener('click', dong);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') dong(); });
})();

/*
  Bo dieu khien Chuyen doi Che do Sang / Toi (Dark / Light Theme Switcher)
*/
(function () {
  var nutToggle = document.getElementById('nh-theme-toggle');
  var iconToggle = document.getElementById('nh-theme-icon');
  var nutMobile = document.getElementById('nh-theme-toggle-mobile');
  var textMobile = document.getElementById('nh-theme-mobile-text');

  function capNhatIcon(theme) {
    var isDark = (theme === 'dark');
    if (iconToggle) {
      iconToggle.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
      if (nutToggle) {
        nutToggle.title = isDark ? 'Chuyển sang giao diện Sáng' : 'Chuyển sang giao diện Tối';
      }
    }
    if (nutMobile) {
      var mIcon = nutMobile.querySelector('i');
      if (mIcon) mIcon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
      if (textMobile) textMobile.textContent = isDark ? 'Chế độ sáng' : 'Chế độ tối';
    }
  }

  function batTatTheme() {
    var current = document.documentElement.getAttribute('data-theme') || 'light';
    var next = (current === 'dark') ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('nh_theme', next);
    } catch (e) {}
    capNhatIcon(next);
  }

  var currentTheme = document.documentElement.getAttribute('data-theme') || localStorage.getItem('nh_theme') || 'light';
  capNhatIcon(currentTheme);

  if (nutToggle) {
    nutToggle.addEventListener('click', batTatTheme);
  }
  if (nutMobile) {
    nutMobile.addEventListener('click', function (e) {
      e.preventDefault();
      batTatTheme();
    });
  }
})();
</script>
