<!DOCTYPE html>
<html lang="<%= typeof maHtml !== 'undefined' ? maHtml : 'vi' %>">
  <head>
    <title><%= typeof title !== 'undefined' && title ? title + ' — ' + t('chung.ten_nha_hang') : t('chung.ten_nha_hang') %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Great+Vibes&family=Dancing+Script:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Montserrat:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Template cũ (giữ để các trang chưa thiết kế lại vẫn chạy) -->
    <link rel="stylesheet" href="/open-iconic-bootstrap.min.css">
    <link rel="stylesheet" href="/animate.css">
    <link rel="stylesheet" href="/owl.carousel.min.css">
    <link rel="stylesheet" href="/owl.theme.default.min.css">
    <link rel="stylesheet" href="/magnific-popup.css">
    <link rel="stylesheet" href="/aos.css">
    <link rel="stylesheet" href="/ionicons.min.css">
    <link rel="stylesheet" href="/bootstrap-datepicker.css">
    <link rel="stylesheet" href="/jquery.timepicker.css">
    <link rel="stylesheet" href="/flaticon.css">
    <link rel="stylesheet" href="/icomoon.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
    <!-- Hệ thống giao diện mới (nạp sau cùng để ưu tiên) -->
    <link rel="stylesheet" href="/nhahang.css">
    <script>
      (function () {
        var t = localStorage.getItem('nh_theme');
        if (t === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <style>
      @media (max-width: 760px) { .d-none-mobile { display: none !important; } }

      /*
        Cap doi cua .d-none-mobile: nhung muc CHI hien tren dien thoai.

        Duoi 760px, nut "Dat ban" va bieu tuong dang nhap/dang xuat o hang cong
        cu ben phai deu bi .d-none-mobile an di, ma ngan keo menu lai khong co
        muc thay the - nen tren dien thoai khong con duong nao vao trang dang
        nhap hay dat ban. Cac muc duoi day bu lai dung phan bi an do.
      */
      .nh-menu-mobile { display: none; }
      @media (max-width: 760px) { .nh-menu-mobile { display: block; } }
      .nh-menu-mobile--vach { border-top: 1px solid rgba(255, 255, 255, .16); padding-top: 1.1rem; margin-top: .2rem; }
    </style>
  </head>

  <body class="nh">
    <% var heroNav = (typeof heroNav !== 'undefined' && heroNav); %>
    <nav class="nh-nav <%= heroNav ? '' : 'is-solid' %>" id="nh-nav">
      <div class="nh-container nh-nav__inner">
        <a class="nh-brand" href="/">
          <img src="/logo.svg" alt="Logo" class="nh-brand__logo" width="40" height="40">
          <span class="nh-brand__name"><%= t('chung.ten_nha_hang') %></span>
        </a>

        <ul class="nh-nav__links" id="nh-menu">
          <li><a href="/" class="<%= (typeof activeNav !== 'undefined' && activeNav==='home') ? 'is-active' : '' %>"><%= t('dieu_huong.trang_chu') %></a></li>
          <li><a href="/about" class="<%= (typeof activeNav !== 'undefined' && activeNav==='about') ? 'is-active' : '' %>"><%= t('dieu_huong.gioi_thieu') %></a></li>
          <li><a href="/menu" class="<%= (typeof activeNav !== 'undefined' && activeNav==='menu') ? 'is-active' : '' %>"><%= t('dieu_huong.thuc_don') %></a></li>
          <li><a href="/blog" class="<%= (typeof activeNav !== 'undefined' && activeNav==='blog') ? 'is-active' : '' %>"><%= t('dieu_huong.tin_tuc') %></a></li>
          <li><a href="/thanh-vien" class="<%= (typeof activeNav !== 'undefined' && activeNav==='thanhvien') ? 'is-active' : '' %>"><%= t('dieu_huong.thanh_vien') %></a></li>
          <li><a href="/huong-dan-dat-ban" class="<%= (typeof activeNav !== 'undefined' && activeNav==='huongdandatban') ? 'is-active' : '' %>"><%= t('dieu_huong.huong_dan_dat_ban') %></a></li>
          <li><a href="/my-orders" class="<%= (typeof activeNav !== 'undefined' && activeNav==='myorders') ? 'is-active' : '' %>"><%= t('dieu_huong.don_cua_toi') %></a></li>
          <li><a href="/chat" class="<%= (typeof activeNav !== 'undefined' && activeNav==='chat') ? 'is-active' : '' %>"><i class="fas fa-headset" style="font-size:0.85rem; margin-right:4px;"></i><%= t('chat.tieu_de') || 'Chat Nhân Viên' %></a></li>

          <%# Chi hien trong ngan keo tren dien thoai - xem chu thich .nh-menu-mobile o tren %>
          <li class="nh-menu-mobile nh-menu-mobile--vach">
            <a href="javascript:void(0)" class="nh-theme-toggle-mobile" id="nh-theme-toggle-mobile"><i class="fas fa-moon"></i> <span id="nh-theme-mobile-text">Chế độ tối</span></a>
          </li>
          <li class="nh-menu-mobile">
            <a href="/giao-hang" style="color:var(--nh-gold); font-weight:700;"><i class="fas fa-motorcycle"></i> <%= t('gio_hang.dat_mon_giao_tan_noi') %></a>
          </li>
          <li class="nh-menu-mobile">
            <a href="/datban"><i class="fas fa-utensils"></i> <%= t('chung.dat_ban') %></a>
          </li>
          <li class="nh-menu-mobile">
            <a href="/chat" style="color:var(--nh-gold-soft); font-weight:700;"><i class="fas fa-headset"></i> <%= t('chat.tieu_de') || 'Chat Với Nhân Viên' %></a>
          </li>
          <% if (session.username) { %>
            <li class="nh-menu-mobile">
              <a href="/profile"><i class="fas fa-user"></i> <%= t('dieu_huong.tai_khoan') %></a>
            </li>
            <li class="nh-menu-mobile">
              <a href="/logout"><i class="fas fa-sign-out-alt"></i> <%= t('dieu_huong.dang_xuat') %></a>
            </li>
          <% } else { %>
            <li class="nh-menu-mobile">
              <a href="/login"><i class="fas fa-user"></i> <%= t('dieu_huong.dang_nhap') %></a>
            </li>
          <% } %>
        </ul>

        <div class="nh-nav__actions">
          <!-- Nut Dat mon Giao hang & Dat ban -->
          <a href="/giao-hang" class="nh-nav-action-btn nh-nav-action-btn--delivery d-none-mobile" title="<%= t('gio_hang.dat_mon_giao_tan_noi') %>">
            <i class="fas fa-motorcycle"></i>
            <span><%= t('dat_ban.giao_hang') %></span>
          </a>
          <a href="/datban" class="nh-nav-action-btn nh-nav-action-btn--booking d-none-mobile" title="<%= t('chung.dat_ban') %>">
            <i class="fas fa-utensils"></i>
            <span><%= t('chung.dat_ban') %></span>
          </a>

          <!-- Nut chuyen doi che do Sang / Toi -->
          <button type="button" class="nh-theme-btn" id="nh-theme-toggle" title="Chuyển đổi giao diện Sáng / Tối" aria-label="Đổi màu sáng tối">
            <i class="fas fa-moon" id="nh-theme-icon"></i>
          </button>

          <a href="/cart" class="nh-cart" title="<%= t('dieu_huong.gio_hang') %>">
            <i class="fas fa-shopping-bag"></i>
            <% if (session.sum) { %><span class="nh-cart__badge">•</span><% } %>
          </a>
          <% if (session.username) { %>
            <a href="/profile" class="nh-user" title="<%= t('dieu_huong.tai_khoan') %>">
              <span class="nh-user__avatar"><%= session.username.charAt(0).toUpperCase() %></span>
              <span class="nh-user__name d-none-mobile"><%= session.username %></span>
            </a>
          <% } %>
          <%
            /*
              Nut doi ngon ngu.

              Giu nguyen duong dan hien tai va chi them `?lang=`, nen khach dang
              doc trang nao thi o lai trang do. Middleware ghi lua chon xuong
              cookie ngay khi thay `?lang=`, nen cac trang sau khong con can
              tham so nay nua.

              Ten moi ngon ngu viet BANG CHINH NO (English, 日本語) chu khong
              phai bang tieng dang hien - nguoi dang nhin mot trang tieng Nhat
              ma khong doc duoc tieng Nhat van phai tim ra loi thoat.
            */
            var duongDanGoc = (typeof duongDanHienTai !== 'undefined' && duongDanHienTai) ? duongDanHienTai : '/';
          %>
          <div class="nh-lang">
            <button class="nh-lang__nut" type="button" id="nh-lang-nut"
                    aria-haspopup="true" aria-expanded="false"
                    title="<%= t('dieu_huong.ngon_ngu') %>">
              <i class="fas fa-globe"></i>
              <span><%= (dsNgonNgu.find(function (x) { return x.ma === nn; }) || dsNgonNgu[0]).ma_ngan %></span>
            </button>
            <ul class="nh-lang__menu" id="nh-lang-menu">
              <% dsNgonNgu.forEach(function (ng) { %>
                <li>
                  <a href="<%= duongDanGoc %><%= duongDanGoc.indexOf('?') >= 0 ? '&' : '?' %>lang=<%= ng.ma %>"
                     class="<%= ng.ma === nn ? 'is-active' : '' %>" lang="<%= ng.ma %>">
                    <span class="nh-lang__co"><%= ng.co %></span><%= ng.ten_goc %>
                    <% if (ng.ma === nn) { %><i class="fas fa-check"></i><% } %>
                  </a>
                </li>
              <% }) %>
            </ul>
          </div>
          <% if (!session.username) { %>
            <a href="/login" class="nh-icon-btn d-none-mobile" title="<%= t('dieu_huong.dang_nhap') %>"><i class="fas fa-user"></i></a>
          <% } else { %>
            <a href="/logout" class="nh-icon-btn d-none-mobile" title="<%= t('dieu_huong.dang_xuat') %>"><i class="fas fa-sign-out-alt"></i></a>
          <% } %>
        </div>

        <button class="nh-burger" id="nh-burger" aria-label="Menu"><i class="fas fa-bars"></i></button>
      </div>
    </nav>
    <% if (!heroNav) { %><div style="height:66px"></div><% } %>
