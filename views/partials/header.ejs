<!DOCTYPE html>
<html lang="vi">
  <head>
    <title><%= typeof title !== 'undefined' ? title + ' — Nhà Hàng Bảo Đoàn' : 'Nhà Hàng Bảo Đoàn' %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Great+Vibes&family=Dancing+Script:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Poppins:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <!-- Template cũ (giữ để các trang chưa thiết kế lại vẫn chạy) -->
    <link rel="stylesheet" href="/open-iconic-bootstrap.min.css">
    <link rel="stylesheet" href="/animate.css">
    <link rel="stylesheet" href="/owl.carousel.min.css">
    <link rel="stylesheet" href="/owl.theme.default.min.css">
    <link rel="stylesheet" href="/magnific-popup.css">
    <link rel="stylesheet" href="/aos.css">
    <link rel="stylesheet" href="/ionicons.min.css">
    <link rel="stylesheet" href="/bootstrap-datepicker.css">
    <link rel="stylesheet" href="/jquery.timepicker.css">
    <link rel="stylesheet" href="/flaticon.css">
    <link rel="stylesheet" href="/icomoon.css">
    <link rel="stylesheet" href="/style.css">
    <!-- Hệ thống giao diện mới (nạp sau cùng để ưu tiên) -->
    <link rel="stylesheet" href="/nhahang.css">
    <style>
      @media (max-width: 760px) { .d-none-mobile { display: none !important; } }
    </style>
  </head>

  <body class="nh">
    <% var heroNav = (typeof heroNav !== 'undefined' && heroNav); %>
    <nav class="nh-nav <%= heroNav ? '' : 'is-solid' %>" id="nh-nav">
      <div class="nh-container nh-nav__inner">
        <a class="nh-brand" href="/">
          <img src="/admin-img/new_logo.png" alt="Logo" onerror="this.style.display='none'">
          <span class="nh-brand__name">Nhà Hàng Bảo Đoàn</span>
        </a>

        <ul class="nh-nav__links" id="nh-menu">
          <li><a href="/" class="<%= (typeof activeNav !== 'undefined' && activeNav==='home') ? 'is-active' : '' %>">Trang Chủ</a></li>
          <li><a href="/about" class="<%= (typeof activeNav !== 'undefined' && activeNav==='about') ? 'is-active' : '' %>">Về Chúng Tôi</a></li>
          <li><a href="/menu" class="<%= (typeof activeNav !== 'undefined' && activeNav==='menu') ? 'is-active' : '' %>">Thực Đơn</a></li>
          <li><a href="/blog" class="<%= (typeof activeNav !== 'undefined' && activeNav==='blog') ? 'is-active' : '' %>">Tin Tức</a></li>
          <% if (session.username) { %>
            <li><a href="/my-orders">Đơn Của Tôi</a></li>
          <% } %>
        </ul>

        <div class="nh-nav__actions">
          <a href="/cart" class="nh-cart" title="Giỏ hàng">
            <i class="fas fa-shopping-bag"></i>
            <% if (session.sum) { %><span class="nh-cart__badge">•</span><% } %>
          </a>
          <% if (session.username) { %>
            <a href="/profile" class="nh-user" title="Tài khoản">
              <span class="nh-user__avatar"><%= session.username.charAt(0).toUpperCase() %></span>
              <span class="nh-user__name d-none-mobile"><%= session.username %></span>
            </a>
          <% } %>
          <a href="/datban" class="nh-btn nh-btn--gold nh-btn--sm d-none-mobile"><i class="fas fa-utensils"></i> Đặt Bàn</a>
          <% if (!session.username) { %>
            <a href="/login" class="nh-user d-none-mobile" title="Đăng nhập"><i class="fas fa-user"></i></a>
          <% } else { %>
            <a href="/logout" class="nh-user d-none-mobile" title="Đăng xuất"><i class="fas fa-sign-out-alt"></i></a>
          <% } %>
        </div>

        <button class="nh-burger" id="nh-burger" aria-label="Menu"><i class="fas fa-bars"></i></button>
      </div>
    </nav>
    <% if (!heroNav) { %><div style="height:66px"></div><% } %>
