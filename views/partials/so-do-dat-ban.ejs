  /**
   * Uoc luong so HANG ban trong mot khu, de tinh chieu cao dai vua du.
   *
   * Gom cac gia tri y lai thanh cum: hai ban lech nhau duoi 18% chieu cao khu
   * thi coi la cung mot hang. Dat chieu cao theo so hang chu khong theo mot con
   * so co dinh - khu mot hang khong bi bo mot khoang trong bang nua man hinh,
   * con khu ba hang khong bi ep den muc ban de len nhau.
   */
  function demHang(dsBan) {
    var ys = dsBan.map(function (b) { return Number(b.y) || 0; }).sort(function (a, b) { return a - b; });
    var dai = ys[ys.length - 1] - ys[0];
    if (dai < 1) return 1;
    var nguong = dai * 0.18;
    var hang = 1;
    for (var i = 1; i < ys.length; i += 1) if (ys[i] - ys[i - 1] > nguong) hang += 1;
    return Math.max(1, Math.min(6, hang));
  }

  /**
   * Ve so do.
   *
   * `tuyChon`:
   *   choChon      cho phep bam chon ban (trang khach, va man gan ban cua NV)
   *   soKhach      de tinh "da du cho chua"
   *   daChon       mang id ban dang chon (giu lai khi ve lai)
   *   onChon       goi lai moi khi tap chon doi -> (mangId, tongCho)
   *   onBam        goi khi bam vao mot ban bat ky (trang nhan vien mo chi tiet)
   *   hienKhach    hien ten khach tren ban (CHI man hinh nhan vien)
   *   mocTren/Duoi nhan trang tri mat bang (chi ve khi xem MOT khu)
   */
  function ve(khung, duLieu, tuyChon) {
    tuyChon = tuyChon || {};
    var dsBan = (duLieu.ban || []).slice();
    var daChon = (tuyChon.daChon || []).map(Number);

    khung.innerHTML = '';
    khung.classList.add('sdb');

    if (!dsBan.length) {
      khung.appendChild(el('div', 'sdb__khung sdb__khung--tai', N.khu_chua_co_ban));
      return { chon: daChon, xoaChon: function () {} };
    }

    var nhom = nhomTheoKhu(dsBan);
    var nhieuKhu = nhom.length > 1;

    var cuon = el('div', 'sdb__cuon');
    var mat = el('div', 'sdb__khung' + (nhieuKhu ? ' sdb__khung--nhieu' : ''));
    cuon.appendChild(mat);
    khung.appendChild(cuon);

    var nut = {};

    function tongChoDaChon() {
      return daChon.reduce(function (s, id) {
        var b = dsBan.filter(function (x) { return Number(x.id) === id; })[0];
        return s + (b ? Number(b.so_cho) : 0);
      }, 0);
    }

    function capNhatVe() {
      dsBan.forEach(function (b) {
        var n = nut[b.id];
        if (!n) return;
        var chon = daChon.indexOf(Number(b.id)) >= 0;
        n.classList.toggle('sdb__ban--chon', chon);
        n.setAttribute('aria-pressed', chon ? 'true' : 'false');
        var v = n.querySelector('.sdb__vien');
        var t = n.querySelector('.sdb__tich');
        if (v) v.setAttribute('opacity', chon ? '1' : '0');
        if (t) t.setAttribute('opacity', chon ? '1' : '0');
      });
      if (tuyChon.onChon) tuyChon.onChon(daChon.slice(), tongChoDaChon());
    }

    /** Ve mot ban vao dung mot san (khung khu vuc). */
    function veVao(san, b, bc) {
      var vt = bc.vt[b.id];
      var ly = b.kha_dung
        ? null
        : (LY_DO[(b.ly_do && b.ly_do.ma) || ''] || { kieu: THEO_MA[Number(b.trang_thai_ban)] || 'khongdat', ten: '' });
      var kieu = b.kha_dung ? 'trong' : ly.kieu;
      var chonDuoc = !!(tuyChon.choChon && b.kha_dung);

      var ket = veBan(b.so_cho, kieu, b.ten, chonDuoc ? false : undefined);

      var n = el(chonDuoc || tuyChon.onBam ? 'button' : 'div',
        'sdb__ban' + (chonDuoc ? ' sdb__ban--chon-duoc' : '') + (b.kha_dung ? '' : ' sdb__ban--mo'));
      if (n.tagName === 'BUTTON') n.type = 'button';
      n.style.left = vt.trai + '%';
      n.style.top = vt.tren + '%';
      n.appendChild(ket.svg);

      // Ten khach CHI hien o man hinh nhan vien. API cong khai khong tra ve
      // truong nay, nen day la lop chan thu hai chu khong phai lop duy nhat.
      if (tuyChon.hienKhach && b.reservation) {
        var t2 = the('text', {
          x: ket.kt.rong / 2, y: ket.kt.cao - 1, 'text-anchor': 'middle',
          fill: '#5c5148', 'font-size': 10, 'font-weight': 700, 'font-family': 'inherit'
        });
        t2.textContent = b.reservation.khach.split(' ').slice(-1)[0];
        ket.svg.querySelector('g').appendChild(t2);
      }

      // Nhan doc duoc cho trinh doc man hinh va cho chuot di qua: mau sac mot
      // minh khong mang du thong tin.
      var nhan = b.ten + ' · ' + b.so_cho + ' ' + N.cho + ' · ' + (b.kha_dung ? N.trong : ly.ten);
      if (b.khu_vuc) nhan += ' · ' + b.khu_vuc;
      if (!b.kha_dung && b.ly_do && b.ly_do.mo_ta) nhan += ' · ' + b.ly_do.mo_ta;
      if (b.thuoc_tinh) {
        var tt = [];
        if (b.thuoc_tinh.gan_cua_so) tt.push(N.gan_cua_so);
        if (b.thuoc_tinh.phong_rieng) tt.push(N.phong_rieng);
        if (b.thuoc_tinh.yen_tinh) tt.push(N.yen_tinh);
        if (tt.length) nhan += ' · ' + tt.join(', ');
      }
      n.title = nhan;
      n.setAttribute('aria-label', nhan);

      if (chonDuoc) {
        n.setAttribute('aria-pressed', 'false');
        n.addEventListener('click', function () {
          var vt2 = daChon.indexOf(Number(b.id));
          if (vt2 >= 0) daChon.splice(vt2, 1);
          else daChon.push(Number(b.id));
          capNhatVe();
        });
      } else if (tuyChon.onBam) {
        n.addEventListener('click', function () { tuyChon.onBam(b); });
      } else {
        n.setAttribute('aria-disabled', 'true');
      }

      nut[b.id] = n;
      san.appendChild(n);
    }

    /*
      Danh sach cac SAN da ve, de tinh lai ty le khi khung doi be ngang.

      Mot khu -> mot san (chinh la mat bang). Nhieu khu -> moi khu mot san rieng.
      Giu chung trong cung mot mang de `tinhLaiTyLe` chi phai biet mot dang du lieu.
    */
    var cacSan = [];

    function layTenKhu(tenGoc) {
      if (!tenGoc) return N.khu_vuc || 'Khu vực';
      var k = 'kv_' + String(tenGoc).toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');
      return N[k] || tenGoc;
    }

    if (!nhieuKhu) {
      // MOT khu: dung ca khung lam san, kem hai moc dinh huong mat bang.
      [['mocTren', 'sdb__moc sdb__moc--tren'], ['mocDuoi', 'sdb__moc sdb__moc--duoi']].forEach(function (p) {
        if (!tuyChon[p[0]]) return;
        var x = el('span', p[1], tuyChon[p[0]]);
        x.setAttribute('aria-hidden', 'true');
        mat.appendChild(x);
      });
      var bc1 = boCuc(dsBan);
      // Khung mot khu cao theo so hang, khong de mot khu hai hang chiem tron
      // 480px roi bo trong nua duoi.
      mat.style.height = Math.max(220, bc1.soHang * 118 + 46) + 'px';
      cacSan.push({ ban: dsBan, bc: bc1, san: mat });
      dsBan.forEach(function (b) { veVao(mat, b, bc1); });
    } else {
      // NHIEU khu: moi khu mot dai rieng, xep chong theo chieu doc.
      nhom.forEach(function (k) {
        var hop = el('div', 'sdb__khu');
        var dai = el('div', 'sdb__khu__dai', layTenKhu(k.ten));
        var trong = k.ban.filter(function (b) { return b.kha_dung; }).length;
        dai.appendChild(el('span', 'sdb__khu__dem', N.dai_khu
          .replace('{ban}', k.ban.length)
          .replace('{cho}', k.ban.reduce(function (s, b) { return s + Number(b.so_cho); }, 0))
          .replace('{trong}', trong)));
        hop.appendChild(dai);

        var bc = boCuc(k.ban);
        var san = el('div', 'sdb__khu__san');
        san.style.height = (bc.soHang * 116 + 26) + 'px';
        hop.appendChild(san);
        mat.appendChild(hop);
        cacSan.push({ ban: k.ban, bc: bc, san: san });
      });
      cacSan.forEach(function (x) {
        x.ban.forEach(function (b) { veVao(x.san, b, x.bc); });
      });
    }

    /**
     * Tinh lai ty le thu nho cho toan bo so do.
     *
     * Lay ty le NHO NHAT trong cac khu, khong phai ty le rieng tung khu: cac khu
     * phai cung mot co ban, neu khong ban 4 cho o khu nay lai to hon ban 6 cho o
     * khu ben canh - va so do noi doi ve suc chua.
     */
    function tinhLaiTyLe() {
      var nho = 1;
      cacSan.forEach(function (x) {
        var ty = tinhTyLe(x.ban, x.bc, x.san.offsetWidth || 900, x.san.offsetHeight || 260);
        if (ty < nho) nho = ty;
      });
      khung.style.setProperty('--sdb-ty-le', nho.toFixed(3));
    }
    tinhLaiTyLe();

    var goiY = el('div', 'sdb__goiy-cuon');
    goiY.appendChild(el('span', null, '\u2194'));
    goiY.appendChild(el('span', null, N.vuot_ngang));
    khung.appendChild(goiY);

    if (tuyChon.chuThich !== false) veChuThich(khung);
    capNhatVe();

    /*
      Tinh lai ty le khi khung doi be ngang.

      Ty le duoc tinh tu be ngang THUC TE cua san, nen no chi dung cho be ngang
      luc ve. Xoay dien thoai, mo/dong thanh ben, hay chi keo cua so - deu lam no
      sai, va ban se de len nhau. ResizeObserver bat dung viec do; trinh duyet cu
      khong co thi lui ve su kien `resize` cua cua so.
    */
    if (typeof ResizeObserver === 'function') {
      var ro = new ResizeObserver(function () { tinhLaiTyLe(); });
      ro.observe(cuon);
    } else if (window.addEventListener) {
      window.addEventListener('resize', tinhLaiTyLe);
    }

    return {
      chon: daChon,
      /** Cho phep ben ngoai xoa lua chon (vi du: khach doi gio). */
      xoaChon: function () { daChon.length = 0; capNhatVe(); },
      tinhLai: tinhLaiTyLe
    };
  }

  /** Ve hang tab khu vuc. `dem` = so ban trong tung khu o khung gio dang xem. */
  function veTabs(khung, dsKhu, dangChon, dem, onDoi) {
    khung.innerHTML = '';
    khung.className = 'sdb__tabs';
    khung.setAttribute('role', 'tablist');

    function layTenKhuTab(tenGoc) {
      if (!tenGoc) return N.khu_vuc || 'Khu vực';
      var k = 'kv_' + String(tenGoc).toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');
      return N[k] || tenGoc;
    }

    var muc = [{ id: '', ten: N.tat_ca_khu }].concat(dsKhu.map(function (k) {
      return { id: String(k.id), ten: layTenKhuTab(k.ten), vip: k.la_vip };
    }));

    muc.forEach(function (m) {
      var b = el('button', 'sdb__tab');
      b.type = 'button';
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-selected', String(m.id) === String(dangChon || '') ? 'true' : 'false');
      b.appendChild(document.createTextNode((m.vip ? '★ ' : '') + m.ten));

      if (dem && dem[m.id || '*'] !== undefined) {
        var d = dem[m.id || '*'];
        b.appendChild(el('span', 'sdb__tab__dem' + (d ? '' : ' sdb__tab__dem--het'),
          d ? N.ban_trong.replace('{n}', d) : N.het_ban));
      }
      b.addEventListener('click', function () { onDoi(m.id); });
      khung.appendChild(b);
    });
  }

  return { ve: ve, veTabs: veTabs, MAU: MAU, kichThuoc: kichThuoc, veBan: veBan,
    chuThich: veChuThich, oChuThich: oChuThich };
})();
</script>
