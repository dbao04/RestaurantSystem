   * `tuyChon`:
   *   choChon      cho phep bam chon ban (trang khach, va man gan ban cua NV)
   *   soKhach      de tinh "da du cho chua"
   *   daChon       mang id ban dang chon (giu lai khi ve lai)
   *   onChon       goi lai moi khi tap chon doi -> (mangId, tongCho)
   *   onBam        goi khi bam vao mot ban bat ky (trang nhan vien mo chi tiet)
   *   hienKhach    hien ten khach tren ban (CHI man hinh nhan vien)
   *   mocTren/Duoi nhan trang tri mat bang
   */
  /**
   * Gom ban theo khu vuc, giu nguyen thu tu xuat hien.
   *
   * Khong dung `duLieu.khu_vuc` de gom: danh sach do co ca khu KHONG co ban nao
   * trong ket qua (vi du khach loc theo suc chua), va mot dai khu vuc rong la
   * mot khoang trong vo nghia giua so do.
   */
  function nhomTheoKhu(dsBan) {
    var thuTu = [];
    var theo = {};
    dsBan.forEach(function (b) {
      var k = String(b.khu_vuc_id == null ? '' : b.khu_vuc_id);
      if (!theo[k]) { theo[k] = { id: k, ten: b.khu_vuc || 'Khu vực', ban: [] }; thuTu.push(theo[k]); }
      theo[k].ban.push(b);
    });
    return thuTu;
  }

