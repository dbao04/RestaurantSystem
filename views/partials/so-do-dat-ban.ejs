  function veChuThich(khung, ds) {
    var hop = el('div', 'sdb__chuthich');
    (ds || boChuThich()).forEach(function (x) { hop.appendChild(oChuThich(x[0], x[1])); });
    khung.appendChild(hop);
    return hop;
  }

