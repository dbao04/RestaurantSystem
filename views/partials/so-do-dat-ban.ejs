  /** Mot o chu thich: mieng ban thu nho + huy hieu + chu. */
  function oChuThich(kieu, nhan) {
    var m = MAU[kieu];
    var o = el('span', 'sdb__ct');
    var svg = the('svg', { width: 30, height: 22, viewBox: '0 0 30 22' });
    var g = the('g', {});
    svg.appendChild(g);
    g.appendChild(the('rect', { x: 2, y: 8.5, width: 9, height: 6, rx: 2, fill: m.ghe }));
    g.appendChild(the('rect', { x: 19, y: 8.5, width: 9, height: 6, rx: 2, fill: m.ghe }));
    g.appendChild(the('rect', { x: 9, y: 4, width: 12, height: 15, rx: 4, fill: m.mat, stroke: m.vien, 'stroke-width': 1.8 }));
    veHuyHieu(g, 22.5, 5, m.huy, m.glyph);
    o.appendChild(svg);
    o.appendChild(document.createTextNode(nhan));
    return o;
  }

  /** Bo chu thich chuan, dung o moi so do. */
  function boChuThich() {
    return [
      ['trong', N.trong_chon_duoc],
