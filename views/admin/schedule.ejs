<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="grid_10">
    <div class="box round first grid">
        <h2>Quản lý Lịch nhân viên</h2>
        <div class="block">
            <table class="data display datatable" id="example">
                <thead>
                    <tr>
                        <th>Ngày</th>
                        <th>Nhân viên</th>
                        <th>Ca / Giờ</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(schedules && schedules.length > 0) { %>
                        <% schedules.forEach(s => { %>
                        <tr class="odd gradeX">
                            <td>
                                <strong><%= new Date(s.ngay).toLocaleDateString('vi-VN') %></strong><br/>
                                <small><%= new Date(s.ngay).toLocaleDateString('vi-VN', { weekday: 'long' }) %></small>
                            </td>
                            <td>
                                <strong><%= s.ten_nhanvien %></strong><br/>
                                <small><%= s.chucvu %></small>
                            </td>
                            <td>
                                <span style="text-transform: uppercase; color: #444;"><%= s.ca %></span><br/>
                                <small>
                                    <%= s.gio_bat_dau ? s.gio_bat_dau.slice(0,5) : '--:--' %> - <%= s.gio_ket_thuc ? s.gio_ket_thuc.slice(0,5) : '--:--' %>
                                </small>
                            </td>
                            <td class="center">
                                <% if(s.trangthai == 0) { %>
                                    <span style="color: #b8860b; font-weight: bold;">Chờ duyệt</span>
                                <% } else if(s.trangthai == 1) { %>
                                    <span style="color: green; font-weight: bold;">Đã duyệt</span>
                                <% } else { %>
                                    <span style="color: red; font-weight: bold;">Từ chối</span>
                                <% } %>
                            </td>
                            <td>
                                <% if(s.trangthai == 0) { %>
                                    <form action="/admin/schedule/update/<%= s.id_lich %>" method="POST" style="display:inline;">
                                        <input type="hidden" name="status" value="1">
                                        <button type="submit" style="color: green; border: none; background: none; cursor: pointer; text-decoration: underline;">Duyệt</button>
                                    </form> | 
                                    <form action="/admin/schedule/update/<%= s.id_lich %>" method="POST" style="display:inline;">
                                        <input type="hidden" name="status" value="2">
                                        <button type="submit" style="color: red; border: none; background: none; cursor: pointer; text-decoration: underline;">Hủy</button>
                                    </form>
                                <% } else { %>
                                    <span style="color: #888;">Đã xử lý</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
