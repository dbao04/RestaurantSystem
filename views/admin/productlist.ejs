<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="grid_10">
    <div class="box round first grid">
        <h2>Danh sách món ăn</h2>
        <div class="block">  
            <table class="data display datatable" id="example">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên</th>
                        <th>Loại</th>
                        <th>Giá</th>
                        <th>Ghi chú</th>
                        <th>Hình ảnh</th>
                        <th>Trạng thái</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (products && products.length > 0) { %>
                        <% products.forEach((prod, index) => { %>
                            <tr class="odd gradeX">
                                <td><%= index + 1 %></td>
                                <td><%= prod.name_mon %></td>
                                <td><%= prod.name_loai %></td>
                                <td><%= formatMoney(prod.gia_mon) %></td>
                                <td><%- prod.ghichu_mon.substring(0, 50) %>...</td>
                                <td class="center"><img height="80" width="80" src="/food/<%= prod.images %>"></td>
                                <td><%= prod.tinhtrang == 1 ? "Phục vụ" : "Ngưng phục vụ" %></td>
                                <td>
                                    <a href="/admin/productedit/<%= prod.id_mon %>">Edit</a> 
                                    || 
                                    <a onclick="return confirm('Bạn muốn xóa?')" href="/admin/productdel/<%= prod.id_mon %>">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $('.datatable').dataTable();
    });
</script>

<%- include('partials/footer') %>
