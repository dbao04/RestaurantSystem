<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập quản trị · Nhà Hàng Bảo Đoàn</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="/admin/quantri.css" />
</head>
<body class="qt-login">
    <div class="qt-login__card">
        <div class="qt-login__mark"><i class="fas fa-utensils"></i></div>
        <h1>Nhà Hàng Bảo Đoàn</h1>
        <p class="qt-login__sub">Khu vực quản trị</p>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="qt-alert qt-alert--danger">
                <i class="fas fa-circle-exclamation"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/admin/login" method="post">
            <div class="qt-login__field">
                <i class="fas fa-user"></i>
                <input type="text" name="adminuser" placeholder="Tên đăng nhập" required autofocus />
            </div>
            <div class="qt-login__field">
                <i class="fas fa-lock"></i>
                <input type="password" name="adminpass" placeholder="Mật khẩu" required />
            </div>
            <button type="submit" class="qt-login__btn">
                <i class="fas fa-right-to-bracket"></i>&nbsp; Đăng nhập
            </button>
        </form>

        <a class="qt-login__back" href="/"><i class="fas fa-arrow-left"></i>&nbsp; Quay lại website</a>
    </div>
</body>
</html>
