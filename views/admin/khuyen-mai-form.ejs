<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<%
  var laSua = !!(km && km.id);
  var v = km || {};

  /* Gia tri cho <input type="datetime-local">.
     km co the den tu CSDL (Date) hoac tu req.body khi form loi (chuoi
     'YYYY-MM-DDTHH:mm'), nen phai chiu ca hai. */
  function dtLocal(x) {
    if (!x) return '';
    if (typeof x === 'string' && x.indexOf('T') === 10) return x.slice(0, 16);
    var d = new Date(x);
    if (isNaN(d)) return '';
    var p = function (n) { return String(n).padStart(2, '0'); };
    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate())
      + 'T' + p(d.getHours()) + ':' + p(d.getMinutes());
  }
  function gio(x) { return x ? String(x).slice(0, 5) : ''; }

  var thuDaChon = String(v.ap_dung_thu == null ? '' : v.ap_dung_thu)
    .split(',').map(function (s) { return parseInt(s, 10); }).filter(Boolean);
  var phamViDaChon = String(v.pham_vi_ids == null ? '' : v.pham_vi_ids)
    .split(',').map(function (s) { return parseInt(s, 10); }).filter(Boolean);
  var phamVi = v.pham_vi || 'tat_ca';

  var DS_THU = [
    { ma: 2, ten: 'Thứ 2' }, { ma: 3, ten: 'Thứ 3' }, { ma: 4, ten: 'Thứ 4' },
    { ma: 5, ten: 'Thứ 5' }, { ma: 6, ten: 'Thứ 6' }, { ma: 7, ten: 'Thứ 7' },
    { ma: 1, ten: 'Chủ nhật' }
  ];
%>

<% if (loi) { %>
  <div class="qt-alert qt-alert--danger"><i class="fas fa-triangle-exclamation"></i> <%= loi %></div>
<% } %>

<form method="POST" action="<%= laSua ? '/admin/khuyen-mai/' + v.id : '/admin/khuyen-mai/them' %>"
      class="qt-form qt-form--wide" id="form-km">

<div class="qt-grid qt-grid--2-1">
  <div>
    <!-- ================================================ Thông tin chung -->
    <div class="qt-card">
      <div class="qt-card__head">
        <div>
          <h2><%= laSua ? 'Sửa chương trình' : 'Chương trình mới' %></h2>
          <p>Đặt tên và mức giảm. Mọi điều kiện phía dưới đều tùy chọn.</p>
        </div>
      </div>
      <div class="qt-card__body">
        <div class="qt-form__row qt-form__row--2">
          <div class="qt-field">
            <label class="qt-label">Mã khuyến mãi <span class="qt-req">*</span></label>
            <input class="qt-input" type="text" name="code" required
                   value="<%= v.code || '' %>"
                   <%= laSua ? 'readonly' : '' %>
                   placeholder="VD: GIOVANG20" style="text-transform:uppercase">
            <div class="qt-field__hint">
              <% if (laSua) { %>
                Không đổi được sau khi tạo — các hóa đơn cũ lưu lại đúng chuỗi mã này để đối soát.
              <% } else { %>
                Chữ in hoa, số, gạch ngang hoặc gạch dưới. Khách sẽ đọc mã này cho thu ngân.
              <% } %>
            </div>
          </div>
          <div class="qt-field">
            <label class="qt-label">Tên chương trình <span class="qt-req">*</span></label>
            <input class="qt-input" type="text" name="ten" required maxlength="150"
                   value="<%= v.ten || '' %>" placeholder="VD: Giờ vàng chiều thứ 3">
            <div class="qt-field__hint">Tên hiển thị cho thu ngân và trong báo cáo.</div>
          </div>
        </div>

        <div class="qt-field">
          <label class="qt-label">Mô tả</label>
          <textarea class="qt-textarea" name="description" rows="2"
                    placeholder="Ghi chú nội bộ hoặc câu quảng cáo cho khách"><%= v.description || '' %></textarea>
        </div>

        <div class="qt-form__row qt-form__row--3">
          <div class="qt-field">
            <label class="qt-label">Kiểu giảm <span class="qt-req">*</span></label>
            <select class="qt-select" name="discount_type" id="kieu-giam">
              <option value="percentage"   <%= v.discount_type !== 'fixed_amount' ? 'selected' : '' %>>Theo phần trăm (%)</option>
              <option value="fixed_amount" <%= v.discount_type === 'fixed_amount' ? 'selected' : '' %>>Số tiền cố định (đ)</option>
            </select>
          </div>
          <div class="qt-field">
            <label class="qt-label">Mức giảm <span class="qt-req">*</span></label>
            <input class="qt-input" type="number" name="discount_value" required min="0" step="any"
                   value="<%= v.discount_value != null ? Number(v.discount_value) : '' %>">
            <div class="qt-field__hint" id="hint-muc-giam"></div>
          </div>
          <div class="qt-field" id="o-tran-giam">
            <label class="qt-label">Giảm tối đa</label>
            <input class="qt-input" type="number" name="max_discount_amount" min="0" step="1000"
                   value="<%= v.max_discount_amount != null ? Number(v.max_discount_amount) : '' %>">
            <div class="qt-field__hint">Trần tiền giảm. Để trống là không chặn.</div>
          </div>
        </div>

        <div class="qt-field">
          <label class="qt-label">Đơn tối thiểu</label>
          <input class="qt-input" type="number" name="min_order_value" min="0" step="1000"
                 value="<%= v.min_order_value != null ? Number(v.min_order_value) : '' %>"
                 placeholder="Để trống nếu không yêu cầu">
        </div>
      </div>
    </div>

    <!-- ================================================ Thời gian -->
    <div class="qt-card" style="margin-top:1.5rem">
      <div class="qt-card__head">
        <div>
          <h2>Thời gian áp dụng</h2>
          <p>Khoảng ngày là bắt buộc. Thứ và khung giờ để trống nghĩa là áp dụng mọi lúc trong khoảng đó.</p>
        </div>
      </div>
      <div class="qt-card__body">
        <div class="qt-form__row qt-form__row--2">
          <div class="qt-field">
            <label class="qt-label">Bắt đầu <span class="qt-req">*</span></label>
            <input class="qt-input" type="datetime-local" name="valid_from" required
                   value="<%= dtLocal(v.valid_from) %>">
          </div>
          <div class="qt-field">
            <label class="qt-label">Kết thúc <span class="qt-req">*</span></label>
            <input class="qt-input" type="datetime-local" name="valid_until" required
                   value="<%= dtLocal(v.valid_until) %>">
          </div>
        </div>

        <div class="qt-field">
          <label class="qt-label">Chỉ áp dụng các thứ</label>
          <div class="km-chips">
            <% DS_THU.forEach(function (t) { %>
              <label class="km-chip">
                <input type="checkbox" name="ap_dung_thu" value="<%= t.ma %>"
                       <%= thuDaChon.indexOf(t.ma) >= 0 ? 'checked' : '' %>>
                <span><%= t.ten %></span>
              </label>
            <% }); %>
          </div>
          <div class="qt-field__hint">
            Không chọn thứ nào (hoặc chọn đủ 7) = áp dụng tất cả các ngày.
          </div>
        </div>

        <div class="qt-form__row qt-form__row--2">
          <div class="qt-field">
            <label class="qt-label">Từ giờ</label>
            <input class="qt-input" type="time" name="gio_bat_dau" value="<%= gio(v.gio_bat_dau) %>">
          </div>
          <div class="qt-field">
            <label class="qt-label">Đến giờ</label>
            <input class="qt-input" type="time" name="gio_ket_thuc" value="<%= gio(v.gio_ket_thuc) %>">
            <div class="qt-field__hint">Khung qua nửa đêm cũng được, ví dụ 22:00 → 02:00.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ================================================ Phạm vi món -->
    <div class="qt-card" style="margin-top:1.5rem">
      <div class="qt-card__head">
        <div>
          <h2>Phạm vi món</h2>
          <p>Giảm trên cả đơn, hay chỉ trên phần tiền của một số loại món / món cụ thể.</p>
        </div>
      </div>
      <div class="qt-card__body">
        <div class="qt-field">
          <label class="qt-label">Áp dụng cho</label>
          <select class="qt-select" name="pham_vi" id="pham-vi">
            <option value="tat_ca"   <%= phamVi === 'tat_ca'   ? 'selected' : '' %>>Toàn bộ đơn hàng</option>
            <option value="loai_mon" <%= phamVi === 'loai_mon' ? 'selected' : '' %>>Chỉ một số loại món</option>
            <option value="mon"      <%= phamVi === 'mon'      ? 'selected' : '' %>>Chỉ một số món</option>
          </select>
        </div>

        <div class="qt-field km-pv" id="pv-loai" hidden>
          <label class="qt-label">Chọn loại món</label>
          <div class="km-chon">
            <% loaiMon.forEach(function (l) { %>
              <label class="km-chip">
                <input type="checkbox" class="pv-loai-box" value="<%= l.id_loai %>"
                       <%= phamVi === 'loai_mon' && phamViDaChon.indexOf(l.id_loai) >= 0 ? 'checked' : '' %>>
                <span><%= l.name_loai %></span>
              </label>
            <% }); %>
          </div>
        </div>

        <div class="qt-field km-pv" id="pv-mon" hidden>
          <label class="qt-label">Chọn món</label>
          <input class="qt-input" type="text" id="loc-mon" placeholder="Gõ để lọc nhanh trong danh sách…"
                 style="margin-bottom:.5rem">
          <div class="km-chon km-chon--cao">
            <% monAn.forEach(function (m) { %>
              <label class="km-chip km-chip--mon" data-ten="<%= (m.name_mon || '').toLowerCase() %> <%= (m.name_loai || '').toLowerCase() %>">
                <input type="checkbox" class="pv-mon-box" value="<%= m.id_mon %>"
                       <%= phamVi === 'mon' && phamViDaChon.indexOf(m.id_mon) >= 0 ? 'checked' : '' %>>
                <span><%= m.name_mon %> <em><%= m.name_loai || '' %></em></span>
              </label>
            <% }); %>
          </div>
        </div>

        <!-- Danh sách id được gom lại thành CSV ngay trước khi submit. -->
        <input type="hidden" name="pham_vi_ids" id="pham-vi-ids" value="<%= phamViDaChon.join(',') %>">
      </div>
    </div>
  </div>

  <div>
    <!-- ================================================ Giới hạn & kênh -->
    <div class="qt-card">
      <div class="qt-card__head">
        <div><h2>Giới hạn</h2></div>
      </div>
      <div class="qt-card__body">
        <div class="qt-field">
          <label class="qt-label">Tổng số lượt</label>
          <input class="qt-input" type="number" name="max_usage" min="0" step="1"
                 value="<%= v.max_usage != null ? Number(v.max_usage) : '' %>"
                 placeholder="Không giới hạn">
          <% if (laSua) { %>
            <div class="qt-field__hint">Đã dùng <%= v.current_usage || 0 %> lượt.</div>
          <% } %>
        </div>

        <div class="qt-field">
          <label class="qt-label">Số lượt mỗi khách</label>
          <input class="qt-input" type="number" name="gioi_han_moi_khach" min="1" step="1"
                 value="<%= v.gioi_han_moi_khach != null ? Number(v.gioi_han_moi_khach) : '' %>"
                 placeholder="Không giới hạn">
          <div class="qt-field__hint">Chỉ đếm được với khách có tài khoản; khách vãng lai quét QR không tính.</div>
        </div>

        <div class="qt-field">
          <label class="qt-label">Hạng thành viên tối thiểu</label>
          <select class="qt-select" name="hang_toi_thieu">
            <option value="">Mọi khách hàng</option>
            <option value="bronze"   <%= v.hang_toi_thieu === 'bronze'   ? 'selected' : '' %>>Đồng trở lên</option>
            <option value="silver"   <%= v.hang_toi_thieu === 'silver'   ? 'selected' : '' %>>Bạc trở lên</option>
            <option value="gold"     <%= v.hang_toi_thieu === 'gold'     ? 'selected' : '' %>>Vàng trở lên</option>
            <option value="platinum" <%= v.hang_toi_thieu === 'platinum' ? 'selected' : '' %>>Bạch kim</option>
          </select>
          <div class="qt-field__hint">
            <a href="/admin/thanh-vien" target="_blank">Xem có bao nhiêu khách ở mỗi hạng ↗</a>
          </div>
        </div>

        <div class="qt-field">
          <label class="qt-label">Kênh áp dụng</label>
          <select class="qt-select" name="kenh">
            <option value="tat_ca"   <%= (v.kenh || 'tat_ca') === 'tat_ca' ? 'selected' : '' %>>Mọi kênh</option>
            <option value="quay"     <%= v.kenh === 'quay'     ? 'selected' : '' %>>Chỉ tại quầy thu ngân</option>
            <option value="khach_qr" <%= v.kenh === 'khach_qr' ? 'selected' : '' %>>Chỉ khách tự quét QR</option>
          </select>
        </div>

        <div class="qt-field">
          <label class="qt-label">Độ ưu tiên</label>
          <input class="qt-input" type="number" name="do_uu_tien" step="1"
                 value="<%= v.do_uu_tien != null ? Number(v.do_uu_tien) : 0 %>">
          <div class="qt-field__hint">Số càng lớn càng được gợi ý lên trước cho thu ngân.</div>
        </div>

        <label class="km-switch">
          <input type="checkbox" name="hien_thi_khach" value="1"
                 <%= (laSua ? v.hien_thi_khach : 1) ? 'checked' : '' %>>
          <span><strong>Gợi ý tự động</strong><br>
            <small>Hiện trong danh sách mã khả dụng ở màn hình tính tiền.</small></span>
        </label>

        <label class="km-switch">
          <input type="checkbox" name="is_active" value="1"
                 <%= (laSua ? v.is_active : 1) ? 'checked' : '' %>>
          <span><strong>Đang bật</strong><br>
            <small>Tắt là ngưng ngay lập tức, không xóa dữ liệu.</small></span>
        </label>
      </div>
    </div>

    <% if (laSua) { %>
    <!-- ================================================ Thử mã -->
    <div class="qt-card" style="margin-top:1.5rem">
      <div class="qt-card__head">
        <div>
          <h2>Thử mã</h2>
          <p>Kiểm tra cấu hình đã lưu, không cần ra quầy.</p>
        </div>
      </div>
      <div class="qt-card__body">
        <div class="qt-form__row qt-form__row--2">
          <div class="qt-field">
            <label class="qt-label">Giá trị đơn</label>
            <input class="qt-input" type="number" id="thu-gia-tri" value="500000" step="10000" min="0">
          </div>
          <div class="qt-field">
            <label class="qt-label">Hạng khách</label>
            <select class="qt-select" id="thu-hang">
              <option value="bronze">Đồng</option>
              <option value="silver">Bạc</option>
              <option value="gold">Vàng</option>
              <option value="platinum">Bạch kim</option>
            </select>
          </div>
        </div>
        <button class="qt-btn qt-btn--ghost qt-btn--block" type="button" id="nut-thu">
          <i class="fas fa-flask"></i> Thử ngay
        </button>
        <div id="kq-thu" style="margin-top:.8rem"></div>
      </div>
    </div>
    <% } %>
  </div>
</div>

<div class="qt-form__actions" style="margin-top:1.5rem">
  <button class="qt-btn qt-btn--primary" type="submit">
    <i class="fas fa-floppy-disk"></i> <%= laSua ? 'Lưu thay đổi' : 'Tạo chương trình' %>
  </button>
  <a class="qt-btn qt-btn--ghost" href="/admin/khuyen-mai"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>
</form>

<% if (laSua && lichSu.length > 0) { %>
<!-- ================================================ Lịch sử dùng -->
<div class="qt-card" style="margin-top:1.5rem">
  <div class="qt-card__head">
    <div>
      <h2>Lượt sử dụng gần đây</h2>
      <p><%= lichSu.length %> lượt gần nhất</p>
    </div>
  </div>
  <div class="qt-card__body qt-card__body--flush">
    <div class="qt-tablewrap">
      <table class="qt-table">
        <thead>
          <tr><th>Thời gian</th><th>Khách hàng</th><th>Đơn</th><th>Giá trị đơn</th><th>Đã giảm</th></tr>
        </thead>
        <tbody>
          <% lichSu.forEach(function (u) { %>
          <tr>
            <td><%= formatDate(u.created_at) %></td>
            <td><%= u.ten_khach || 'Khách vãng lai' %></td>
            <td class="km-phu"><%= u.sesis || '—' %></td>
            <td class="qt-money"><%= formatMoney(u.gia_tri_don) %>đ</td>
            <td class="qt-money">− <%= formatMoney(u.so_tien_giam) %>đ</td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } %>

<style>
  .km-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .km-chon {
    display: flex; flex-wrap: wrap; gap: .4rem;
    max-height: 220px; overflow-y: auto;
    border: 1px solid var(--qt-line); border-radius: 10px; padding: .6rem; background: #fff;
  }
  .km-chon--cao { max-height: 320px; }
  .km-chip {
    display: inline-flex; align-items: center; gap: .4rem; cursor: pointer;
    padding: .35rem .7rem; border: 1px solid var(--qt-line); border-radius: 99px;
    background: #fff; font-size: .8rem; user-select: none;
  }
  .km-chip input { margin: 0; }
  .km-chip:has(input:checked) { border-color: var(--qt-gold); background: #fffaf0; color: #8a6a1f; font-weight: 600; }
  .km-chip em { font-style: normal; color: var(--qt-muted); font-size: .72rem; margin-left: .25rem; }
  .km-switch {
    display: flex; gap: .6rem; align-items: flex-start; cursor: pointer;
    padding: .7rem; border: 1px solid var(--qt-line); border-radius: 10px;
    margin-bottom: .7rem; background: #fff;
  }
  .km-switch small { color: var(--qt-muted); }
  .km-phu { font-size: .74rem; color: var(--qt-muted); }
  /* --2 đã có sẵn trong quantri.css, ở đây chỉ bổ sung biến thể 3 cột. */
  @media (min-width: 760px) {
    .qt-form__row--3 { grid-template-columns: 1fr 1fr 1fr; }
  }
</style>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };

  /* ---------------------------------------- gợi ý theo kiểu giảm --- */
  function capNhatKieuGiam() {
    var pt = $('kieu-giam').value === 'percentage';
    $('hint-muc-giam').textContent = pt ? 'Nhập 10 nghĩa là giảm 10%.' : 'Nhập số tiền, ví dụ 50000.';
    // Trần giảm chỉ có nghĩa khi giảm theo %; giảm số tiền cố định đã là trần.
    $('o-tran-giam').style.display = pt ? '' : 'none';
  }
  $('kieu-giam').addEventListener('change', capNhatKieuGiam);
  capNhatKieuGiam();

  /* ---------------------------------------------------- phạm vi --- */
  function capNhatPhamVi() {
    var pv = $('pham-vi').value;
    $('pv-loai').hidden = pv !== 'loai_mon';
    $('pv-mon').hidden = pv !== 'mon';
  }
  $('pham-vi').addEventListener('change', capNhatPhamVi);
  capNhatPhamVi();

  var locMon = $('loc-mon');
  if (locMon) {
    locMon.addEventListener('input', function () {
      var tu = this.value.trim().toLowerCase();
      document.querySelectorAll('.km-chip--mon').forEach(function (c) {
        c.style.display = (!tu || c.dataset.ten.indexOf(tu) >= 0) ? '' : 'none';
      });
    });
  }

  /* Gom các ô đã tick thành CSV. Làm ở lúc submit thay vì đặt name trực
     tiếp lên checkbox: người dùng đổi qua lại giữa "loại món" và "món"
     mà không bỏ tick thì server sẽ nhận lẫn cả hai nhóm id. */
  $('form-km').addEventListener('submit', function () {
    var pv = $('pham-vi').value;
    var lop = pv === 'loai_mon' ? '.pv-loai-box' : (pv === 'mon' ? '.pv-mon-box' : null);
    var ids = [];
    if (lop) {
      document.querySelectorAll(lop + ':checked').forEach(function (o) { ids.push(o.value); });
    }
    $('pham-vi-ids').value = ids.join(',');
  });

  /* ----------------------------------------------------- thử mã --- */
  var nutThu = $('nut-thu');
  if (nutThu) {
    nutThu.addEventListener('click', function () {
      var url = '/admin/khuyen-mai/<%= laSua ? v.id : 0 %>/thu'
        + '?gia_tri=' + (Number($('thu-gia-tri').value) || 0)
        + '&hang=' + $('thu-hang').value;
      var o = $('kq-thu');
      o.innerHTML = '<div class="qt-field__hint">Đang kiểm tra…</div>';
      fetch(url).then(function (r) { return r.json(); }).then(function (d) {
        if (!d.thanhCong) { o.innerHTML = '<div class="qt-alert qt-alert--danger">' + (d.loi || 'Lỗi') + '</div>'; return; }
        if (!d.ap_duoc) {
          o.innerHTML = '<div class="qt-alert qt-alert--danger"><i class="fas fa-xmark"></i> Không áp được: ' + d.ly_do + '</div>';
          return;
        }
        var tien = function (n) { return Number(n || 0).toLocaleString('vi-VN'); };
        o.innerHTML = '<div class="qt-alert qt-alert--success"><i class="fas fa-check"></i> '
          + 'Giảm <strong>' + tien(d.so_tien_giam) + 'đ</strong>, khách trả ' + tien(d.con_lai) + 'đ.'
          + (d.ghi_chu ? '<br><small>' + d.ghi_chu + '</small>' : '') + '</div>';
      }).catch(function () {
        o.innerHTML = '<div class="qt-alert qt-alert--danger">Không gọi được máy chủ.</div>';
      });
    });
  }
})();
</script>

