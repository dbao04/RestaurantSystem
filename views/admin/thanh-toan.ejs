<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<% if (thongBao) { %>
  <div class="qt-alert qt-alert--success"><i class="fas fa-circle-check"></i> <%= thongBao %></div>
<% } %>

<% if (!taiKhoan) { %>
  <div class="qt-alert qt-alert--danger">
    <i class="fas fa-triangle-exclamation"></i>
    <strong>Chưa cấu hình tài khoản nhận tiền.</strong>
    Thu ngân sẽ không tạo được mã QR cho tới khi bạn điền số tài khoản bên dưới.
  </div>
<% } %>

<!-- ====================================================== Tổng quan -->
<div class="qt-stats">
  <% var tongTat = tongHop.reduce(function (t, r) { return t + Number(r.tong_tien || 0); }, 0); %>
  <div class="qt-stat qt-stat--gold">
    <span class="qt-stat__icon"><i class="fas fa-coins"></i></span>
    <div class="qt-stat__label">Tổng đã thu</div>
    <div class="qt-stat__value"><%= formatMoney(tongTat) %>đ</div>
    <div class="qt-stat__note">toàn bộ lịch sử</div>
  </div>
  <% tongHop.forEach(function (t, i) { %>
    <div class="qt-stat qt-stat--<%= ['green','blue','plum'][i % 3] %>">
      <span class="qt-stat__icon"><i class="fas <%= t.type === 'cash' ? 'fa-money-bill-wave' : (t.type === 'online' ? 'fa-qrcode' : 'fa-credit-card') %>"></i></span>
      <div class="qt-stat__label"><%= t.name %></div>
      <div class="qt-stat__value"><%= formatMoney(t.tong_tien) %>đ</div>
      <div class="qt-stat__note"><%= t.so_giao_dich %> giao dịch</div>
    </div>
  <% }); %>
</div>

<div class="qt-grid qt-grid--2-1" style="margin-top:1.5rem">
  <div>
    <!-- ============================================ Tài khoản nhận tiền -->
    <div class="qt-card">
      <div class="qt-card__head">
        <div>
          <h2>Tài khoản nhận tiền</h2>
          <p>Mã VietQR khách quét sẽ chuyển thẳng vào tài khoản này. Không qua trung gian nào.</p>
        </div>
      </div>
      <div class="qt-card__body">
        <form method="POST" action="/admin/thanh-toan/tai-khoan" class="qt-form">
          <div class="qt-form__row">
            <div class="qt-field">
              <label class="qt-label">Ngân hàng</label>
              <select name="ma_ngan_hang" class="qt-select" required>
                <% danhSachNganHang.forEach(function (nh) { %>
                  <option value="<%= nh.ma %>" <%= taiKhoan && taiKhoan.maNganHang === nh.ma ? 'selected' : '' %>>
                    <%= nh.ten %> — <%= nh.dayDu %>
                  </option>
                <% }); %>
              </select>
              <div class="qt-field__hint">Danh sách theo mã BIN do NAPAS cấp.</div>
            </div>
            <div class="qt-field">
              <label class="qt-label">Số tài khoản</label>
              <input type="text" name="so_tai_khoan" class="qt-input" required
                     value="<%= taiKhoan ? taiKhoan.soTaiKhoan : '' %>" placeholder="0011001234567">
            </div>
          </div>
          <div class="qt-field">
            <label class="qt-label">Tên chủ tài khoản</label>
            <input type="text" name="ten_tai_khoan" class="qt-input"
                   value="<%= taiKhoan ? taiKhoan.tenTaiKhoan : 'NHA HANG BAO DOAN' %>"
                   placeholder="NHA HANG BAO DOAN">
            <div class="qt-field__hint">
              Viết không dấu, in hoa — đúng như tên hiển thị trong app ngân hàng.
            </div>
          </div>
          <div class="qt-form__actions">
            <button class="qt-btn qt-btn--primary"><i class="fas fa-floppy-disk"></i> Lưu tài khoản</button>
          </div>
          <p class="qt-field__hint" style="margin-top:.5rem">
            Hệ thống sẽ thử sinh một mã QR mẫu trước khi lưu. Nếu số tài khoản hoặc ngân hàng
            không hợp lệ, việc lưu sẽ bị từ chối ngay tại đây thay vì để thu ngân phát hiện
            lúc khách đang đứng chờ.
          </p>
        </form>
      </div>
    </div>

    <!-- ============================================ Tham số tính tiền -->
    <div class="qt-card" style="margin-top:1.5rem">
      <div class="qt-card__head">
        <div>
          <h2>Tham số tính tiền</h2>
          <p>Áp dụng ngay cho mọi hóa đơn mới, không cần khởi động lại máy chủ.</p>
        </div>
      </div>
      <div class="qt-card__body">
        <form method="POST" action="/admin/thanh-toan/cau-hinh" class="qt-form">
          <div class="qt-form__row">
            <div class="qt-field">
              <label class="qt-label">Thuế VAT (%)</label>
              <input type="number" name="thue_vat" class="qt-input" step="0.1" min="0" max="20" value="<%= cauHinh.thue_vat %>">
              <div class="qt-field__hint">Để 0 nếu giá món trên thực đơn đã gồm VAT.</div>
            </div>
            <div class="qt-field">
              <label class="qt-label">Phí phục vụ (%)</label>
              <input type="number" name="phi_phuc_vu" class="qt-input" step="0.1" min="0" max="20" value="<%= cauHinh.phi_phuc_vu %>">
            </div>
          </div>
          <div class="qt-form__row">
            <div class="qt-field">
              <label class="qt-label">Làm tròn lên bội số (đ)</label>
              <input type="number" name="lam_tron" class="qt-input" step="500" min="0" value="<%= cauHinh.lam_tron %>">
              <div class="qt-field__hint">0 = không làm tròn. Đặt 1000 để bỏ tiền lẻ.</div>
            </div>
            <div class="qt-field">
              <label class="qt-label">Mã QR hết hạn sau (giây)</label>
              <input type="number" name="han_qr_giay" class="qt-input" step="60" min="60" max="3600" value="<%= cauHinh.han_qr_giay %>">
            </div>
          </div>
          <div class="qt-form__row">
            <div class="qt-field">
              <label class="qt-label">Chi bao nhiêu đ được 1 điểm</label>
              <input type="number" name="ty_le_tich_diem" class="qt-input" step="1000" min="1000" value="<%= cauHinh.ty_le_tich_diem %>">
            </div>
            <div class="qt-field">
              <label class="qt-label">1 điểm đổi được (đ)</label>
              <input type="number" name="gia_tri_1_diem" class="qt-input" step="100" min="1" value="<%= cauHinh.gia_tri_1_diem %>">
            </div>
          </div>
          <div class="qt-form__row">
            <div class="qt-field">
              <label class="qt-label">Tối đa % hóa đơn trả bằng điểm</label>
              <input type="number" name="toi_da_diem_moi_don" class="qt-input" min="0" max="100" value="<%= cauHinh.toi_da_diem_moi_don %>">
              <div class="qt-field__hint">Chặn khách trả 100% bằng điểm.</div>
            </div>
            <div class="qt-field">
              <label class="qt-label">Tỷ lệ đặt cọc giữ bàn (%)</label>
              <input type="number" name="dat_coc_phan_tram" class="qt-input" min="0" max="100" value="<%= cauHinh.dat_coc_phan_tram %>">
            </div>
          </div>
          <div class="qt-field">
            <label class="qt-label">
              <input type="checkbox" name="tu_dong_doi_soat" value="1" <%= Number(cauHinh.tu_dong_doi_soat) ? 'checked' : '' %>>
              Tự động ghi nhận thanh toán khi webhook ngân hàng khớp mã đối soát
            </label>
            <div class="qt-field__hint">
              Tắt đi thì mọi giao dịch chỉ được ghi vào hộp thư, thu ngân phải tự ghép tay
              ở trang đối soát — an toàn hơn nhưng chậm hơn.
            </div>
          </div>
          <div class="qt-form__actions">
            <button class="qt-btn qt-btn--primary"><i class="fas fa-floppy-disk"></i> Lưu cấu hình</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ============================================ Phương thức -->
    <div class="qt-card" style="margin-top:1.5rem">
      <div class="qt-card__head">
        <div><h2>Phương thức thanh toán</h2><p>Tắt phương thức nào thì thu ngân sẽ không thấy phương thức đó.</p></div>
      </div>
      <div class="qt-card__body qt-card__body--flush">
        <div class="qt-tablewrap">
          <table class="qt-table">
            <thead><tr><th>Tên</th><th>Mã</th><th>Loại</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
              <% phuongThuc.forEach(function (p) { %>
                <tr>
                  <td><i class="fas <%= p.cauHinh.icon || 'fa-wallet' %>"></i> <%= p.name %></td>
                  <td><code><%= p.code %></code></td>
                  <td><%= { cash:'Tiền mặt', online:'Trực tuyến', card:'Thẻ', wallet:'Ví điện tử' }[p.type] || p.type %></td>
                  <td>
                    <% if (p.is_active) { %><span style="color:var(--qt-ok)">● Đang bật</span>
                    <% } else { %><span style="color:var(--qt-muted)">○ Đã tắt</span><% } %>
                  </td>
                  <td>
                    <form method="POST" action="/admin/thanh-toan/phuong-thuc/<%= p.id %>/bat-tat" style="display:inline">
                      <button class="qt-btn qt-btn--ghost qt-btn--sm"><%= p.is_active ? 'Tắt' : 'Bật' %></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- =============================================== Cột phải -->
  <div>
    <% if (qrTinh) { %>
      <div class="qt-card">
        <div class="qt-card__head"><div><h2>Mã QR cố định</h2><p>In ra dán tại quầy — khách tự nhập số tiền.</p></div></div>
        <div class="qt-card__body" style="text-align:center">
          <div style="background:#fff;padding:12px;border-radius:12px;display:inline-block;line-height:0">
            <img src="<%= qrTinh.anh %>" alt="Mã VietQR cố định" style="width:220px;height:220px;display:block">
          </div>
          <div style="margin-top:.8rem;font-weight:700"><%= qrTinh.nganHang %></div>
          <div style="color:var(--qt-muted);font-size:.85rem"><%= qrTinh.soTaiKhoan %></div>
          <div style="color:var(--qt-muted);font-size:.85rem"><%= taiKhoan.tenTaiKhoan %></div>
          <a class="qt-btn qt-btn--ghost qt-btn--sm" style="margin-top:.8rem" href="<%= qrTinh.anh %>" download="vietqr-baodoan.png">
            <i class="fas fa-download"></i> Tải ảnh
          </a>
        </div>
      </div>
    <% } %>

    <div class="qt-card" style="margin-top:1.5rem">
      <div class="qt-card__head"><div><h2>Webhook ngân hàng</h2><p>Để hệ thống tự ghi nhận khi tiền vào.</p></div></div>
      <div class="qt-card__body">
        <label class="qt-label">Địa chỉ nhận</label>
        <input class="qt-input" readonly id="url-webhook" onclick="this.select()">

        <label class="qt-label" style="margin-top:.8rem">Khóa xác thực</label>
        <input class="qt-input" readonly value="<%= cauHinh.webhook_api_key %>" onclick="this.select()">
        <div class="qt-field__hint">
          Bên gửi phải đặt vào header <code>Authorization: Apikey &lt;khóa&gt;</code>.
        </div>

        <form method="POST" action="/admin/thanh-toan/sinh-khoa-webhook" style="margin-top:.8rem"
              onsubmit="return confirm('Sinh khóa mới sẽ làm khóa cũ hết hiệu lực. Bạn phải cập nhật lại bên dịch vụ ngân hàng. Tiếp tục?')">
          <button class="qt-btn qt-btn--ghost qt-btn--sm"><i class="fas fa-rotate"></i> Sinh khóa mới</button>
        </form>
      </div>
    </div>

    <div class="qt-card" style="margin-top:1.5rem">
      <div class="qt-card__head"><div><h2>Cách hoạt động</h2></div></div>
      <div class="qt-card__body" style="font-size:.88rem;line-height:1.8;color:var(--qt-muted)">
        <p style="margin-bottom:.7rem">
          Mã QR được sinh <strong>ngay trong máy chủ</strong> theo chuẩn EMVCo/NAPAS,
          không gọi ra dịch vụ ngoài nào. Nhà hàng mất mạng Internet vẫn in được mã.
        </p>
        <p style="margin-bottom:.7rem">
          Mỗi lần thu tiền sinh một <strong>mã đối soát duy nhất</strong> (dạng
          <code>BD…</code>) đặt vào nội dung chuyển khoản. Đó là thứ duy nhất còn lại
          trong sao kê để biết tiền này của bàn nào.
        </p>
        <p style="margin-bottom:0">
          Nếu chưa đấu webhook, thu ngân vẫn thu bình thường bằng nút
          <strong>"Đã nhận tiền"</strong>; mọi lần bấm tay đều ghi vào nhật ký kiểm toán
          kèm tên người bấm.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('url-webhook').value = location.origin + '/api/webhook/ngan-hang';
</script>

<%- include('partials/footer') %>
