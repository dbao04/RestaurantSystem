<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="qt-card">
    <div class="qt-card__head">
        <div>
            <h2>Danh sách bài viết</h2>
            <p><%= posts ? posts.length : 0 %> bài viết đã đăng</p>
        </div>
        <div class="qt-card__act">
            <a class="qt-btn qt-btn--primary" href="/admin/blogadd"><i class="fas fa-pen-nib"></i> Thêm bài viết</a>
        </div>
    </div>
    <div class="qt-card__body qt-card__body--flush">
        <% if (posts && posts.length > 0) { %>
        <div class="qt-tablewrap">
            <table class="qt-table datatable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Ảnh</th>
                        <th>Tiêu đề</th>
                        <th>Nội dung rút gọn</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% posts.forEach((p, index) => { %>
                    <tr>
                        <td class="qt-num"><%= index + 1 %></td>
                        <td>
                            <% if (p.hinh_anh) { %>
                                <img class="qt-thumb" src="/food/<%= p.hinh_anh %>" alt="<%= p.tieu_de %>"
                                     onerror="this.src='/logo.png'">
                            <% } else { %>
                                <span class="qt-thumb--none"><i class="fas fa-image"></i></span>
                            <% } %>
                        </td>
                        <td class="qt-strong"><%= p.tieu_de %></td>
                        <td>
                            <% var nd = (p.noi_dung || '').replace(/<[^>]*>/g, '').trim(); %>
                            <%= nd.length > 100 ? nd.substring(0, 100) + '…' : (nd || '—') %>
                        </td>
                        <td>
                            <div class="qt-actions">
                                <a class="qt-btn qt-btn--ghost qt-btn--sm" href="/admin/blogedit/<%= p.id_bv %>">
                                    <i class="fas fa-pen"></i> Sửa
                                </a>
                                <a class="qt-btn qt-btn--danger qt-btn--sm" href="/admin/blogdel/<%= p.id_bv %>"
                                   onclick="return confirm('Xóa bài viết &quot;<%= p.tieu_de %>&quot;?')">
                                    <i class="fas fa-trash"></i> Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="qt-empty">
            <i class="fas fa-newspaper"></i>
            <p>Chưa có bài viết nào.</p>
            <a class="qt-btn qt-btn--primary" href="/admin/blogadd"><i class="fas fa-pen-nib"></i> Viết bài đầu tiên</a>
        </div>
        <% } %>
    </div>
</div>

<script>
    $(document).ready(function () { $('.datatable').dataTable(); });
</script>

<%- include('partials/footer') %>
