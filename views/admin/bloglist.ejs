<%- include('partials/header') %>
<%- include('partials/sidebar') %>
<div class="grid_10">
    <div class="box round first grid">
        <h2>Danh sách bài viết</h2>
        <div class="block">
            <table class="data display datatable" id="example">
                <thead>
                    <tr>
                        <th width="5%">ID</th>
                        <th width="30%">Tiêu đề</th>
                        <th width="20%">Hình ảnh</th>
                        <th width="30%">Nội dung (rút gọn)</th>
                        <th width="15%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% posts.forEach(p => { %>
                    <tr class="odd gradeX">
                        <td><%= p.id_bv %></td>
                        <td><%= p.tieu_de %></td>
                        <td>
                            <% if (p.hinh_anh) { %>
                                <img src="/food/<%= p.hinh_anh %>" width="80" height="auto" />
                            <% } else { %>
                                No image
                            <% } %>
                        </td>
                        <td><%= p.noi_dung ? p.noi_dung.substring(0, 100) + '...' : '' %></td>
                        <td>
                            <a href="/admin/blogedit/<%= p.id_bv %>">Sửa</a> || 
                            <a onclick="return confirm('Bạn có chắc muốn xóa?')" href="/admin/blogdel/<%= p.id_bv %>">Xóa</a>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
