<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="qt-card">
    <div class="qt-card__head">
        <div>
            <h2>Sửa loại món</h2>
            <p>Cập nhật thông tin loại “<%= (category.name_loai || '').trim() %>”.</p>
        </div>
        <div class="qt-card__act">
            <a class="qt-btn qt-btn--ghost" href="/admin/catlist"><i class="fas fa-arrow-left"></i> Quay lại danh sách</a>
        </div>
    </div>
    <div class="qt-card__body">
        <form class="qt-form" action="/admin/catedit/<%= category.id_loai %>" method="post">
            <div class="qt-field">
                <label for="name_loai">Tên loại món <span class="qt-req">*</span></label>
                <input type="text" id="name_loai" name="name_loai" value="<%= category.name_loai %>" placeholder="Ví dụ: Món khai vị" required />
            </div>

            <div class="qt-field">
                <label for="ghichu">Ghi chú</label>
                <input type="text" id="ghichu" name="ghichu" value="<%= category.ghichu %>" placeholder="Mô tả ngắn về loại món này" />
                <div class="qt-field__hint">Không bắt buộc — chỉ hiển thị trong trang quản trị.</div>
            </div>

            <div class="qt-form__actions">
                <button class="qt-btn qt-btn--primary" type="submit" name="submit"><i class="fas fa-floppy-disk"></i> Cập nhật</button>
                <a class="qt-btn qt-btn--ghost" href="/admin/catlist">Hủy</a>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
