<%- include('partials/header') %>
<%- include('partials/sidebar') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="qt-stats">
    <div class="qt-stat qt-stat--gold">
        <div class="qt-stat__icon"><i class="fas fa-sack-dollar"></i></div>
        <div class="qt-stat__label">Doanh thu</div>
        <div class="qt-stat__value"><%= formatMoney(stats.revenue) %></div>
        <div class="qt-stat__note">Tổng doanh thu đã ghi nhận</div>
    </div>
    <div class="qt-stat qt-stat--green">
        <div class="qt-stat__icon"><i class="fas fa-receipt"></i></div>
        <div class="qt-stat__label">Đơn hàng</div>
        <div class="qt-stat__value"><%= stats.orders %></div>
        <div class="qt-stat__note">Hợp đồng / đơn đặt tiệc</div>
    </div>
    <div class="qt-stat qt-stat--blue">
        <div class="qt-stat__icon"><i class="fas fa-user-group"></i></div>
        <div class="qt-stat__label">Khách hàng</div>
        <div class="qt-stat__value"><%= stats.customers %></div>
        <div class="qt-stat__note">Tài khoản đã đăng ký</div>
    </div>
    <div class="qt-stat qt-stat--plum">
        <div class="qt-stat__icon"><i class="fas fa-user-tie"></i></div>
        <div class="qt-stat__label">Nhân viên</div>
        <div class="qt-stat__value"><%= stats.staff %></div>
        <div class="qt-stat__note">Đang trong danh sách nhân sự</div>
    </div>
</div>

<div class="qt-grid qt-grid--2">
    <div class="qt-card" style="margin:0">
        <div class="qt-card__head">
            <div>
                <h2>Doanh thu theo tháng</h2>
                <p>Năm <%= new Date().getFullYear() %></p>
            </div>
        </div>
        <div class="qt-card__body">
            <canvas id="revenueChart" height="220"></canvas>
        </div>
    </div>

    <div class="qt-card" style="margin:0">
        <div class="qt-card__head">
            <div>
                <h2>Món ăn bán chạy</h2>
                <p>Top 10 món có số lượng bán ra cao nhất</p>
            </div>
        </div>
        <div class="qt-card__body">
            <canvas id="dishChart" height="220"></canvas>
        </div>
    </div>
</div>

<script>
    // Dong bo bang mau voi giao dien quan tri (espresso + gold).
    var mauVang = '#c8a24b';
    var mauXanh = '#2e7d4f';
    var mauChu  = '#6b5f54';
    var mauKe   = '#f0e9dd';

    Chart.defaults.font.family = "'Inter', system-ui, sans-serif";
    Chart.defaults.color = mauChu;

    // --- Doanh thu theo thang ------------------------------------------------
    var revData = <%- JSON.stringify(revenueByMonth) %>;
    var revLabels = ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'T8', 'T9', 'T10', 'T11', 'T12'];
    var revValues = new Array(12).fill(0);
    revData.forEach(function (item) { revValues[item.month - 1] = item.revenue; });

    new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: {
            labels: revLabels,
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: revValues,
                backgroundColor: 'rgba(200, 162, 75, .14)',
                borderColor: mauVang,
                pointBackgroundColor: mauVang,
                pointRadius: 3,
                pointHoverRadius: 5,
                borderWidth: 2,
                fill: true,
                tension: 0.3
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: mauKe } },
                x: { grid: { display: false } }
            }
        }
    });

    // --- Mon an ban chay -----------------------------------------------------
    var dishData = <%- JSON.stringify(topDishes) %>;

    new Chart(document.getElementById('dishChart'), {
        type: 'bar',
        data: {
            labels: dishData.map(function (d) { return d.name_mon; }),
            datasets: [{
                label: 'Số lượng bán ra',
                data: dishData.map(function (d) { return d.total; }),
                backgroundColor: 'rgba(46, 125, 79, .75)',
                borderColor: mauXanh,
                borderWidth: 1,
                borderRadius: 6
            }]
        },
        options: {
            indexAxis: 'y',
            plugins: { legend: { display: false } },
            scales: {
                x: { beginAtZero: true, grid: { color: mauKe } },
                y: { grid: { display: false } }
            }
        }
    });
</script>

<%- include('partials/footer') %>
