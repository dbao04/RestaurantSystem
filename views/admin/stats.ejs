<%- include('partials/header') %>
<%- include('partials/sidebar') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="grid_10">
    <div class="box round first grid">
        <h2>Báo cáo thống kê nhà hàng</h2>
        <div class="block">
            <!-- Tóm tắt số liệu -->
            <div class="stat-cards" style="display: flex; gap: 20px; margin-bottom: 30px;">
                <div class="card" style="flex: 1; background: #4e73df; color: white; padding: 20px; border-radius: 8px; text-align: center;">
                    <div style="font-size: 14px; opacity: 0.8;">TỔNG DOANH THU</div>
                    <div style="font-size: 24px; font-weight: bold; margin-top: 10px;"><%= formatMoney(stats.revenue) %></div>
                </div>
                <div class="card" style="flex: 1; background: #1cc88a; color: white; padding: 20px; border-radius: 8px; text-align: center;">
                    <div style="font-size: 14px; opacity: 0.8;">TỔNG ĐƠN HÀNG</div>
                    <div style="font-size: 24px; font-weight: bold; margin-top: 10px;"><%= stats.orders %></div>
                </div>
                <div class="card" style="flex: 1; background: #36b9cc; color: white; padding: 20px; border-radius: 8px; text-align: center;">
                    <div style="font-size: 14px; opacity: 0.8;">TỔNG KHÁCH HÀNG</div>
                    <div style="font-size: 24px; font-weight: bold; margin-top: 10px;"><%= stats.customers %></div>
                </div>
                <div class="card" style="flex: 1; background: #f6c23e; color: white; padding: 20px; border-radius: 8px; text-align: center;">
                    <div style="font-size: 14px; opacity: 0.8;">TỔNG NHÂN VIÊN</div>
                    <div style="font-size: 24px; font-weight: bold; margin-top: 10px;"><%= stats.staff %></div>
                </div>
            </div>

            <!-- Biểu đồ -->
            <div class="row" style="display: flex; gap: 20px;">
                <div style="flex: 1; background: white; padding: 20px; border: 1px solid #ddd; border-radius: 8px;">
                    <h3 style="margin-top: 0;">Doanh thu theo tháng (Năm <%= new Date().getFullYear() %>)</h3>
                    <canvas id="revenueChart"></canvas>
                </div>
                <div style="flex: 1; background: white; padding: 20px; border: 1px solid #ddd; border-radius: 8px;">
                    <h3 style="margin-top: 0;">Top 10 món ăn bán chạy nhất</h3>
                    <canvas id="dishChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Dữ liệu doanh thu theo tháng
    const revData = <%- JSON.stringify(revenueByMonth) %>;
    const revLabels = ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'T8', 'T9', 'T10', 'T11', 'T12'];
    const revValues = new Array(12).fill(0);
    revData.forEach(item => {
        revValues[item.month - 1] = item.revenue;
    });

    const ctxRev = document.getElementById('revenueChart').getContext('2d');
    new Chart(ctxRev, {
        type: 'line',
        data: {
            labels: revLabels,
            datasets: [{
                label: 'Doanh thu (VND)',
                data: revValues,
                backgroundColor: 'rgba(78, 115, 223, 0.05)',
                borderColor: 'rgba(78, 115, 223, 1)',
                pointRadius: 3,
                pointBackgroundColor: 'rgba(78, 115, 223, 1)',
                pointBorderColor: 'rgba(78, 115, 223, 1)',
                pointHoverRadius: 3,
                pointHoverBackgroundColor: 'rgba(78, 115, 223, 1)',
                pointHoverBorderColor: 'rgba(78, 115, 223, 1)',
                pointHitRadius: 10,
                pointBorderWidth: 2,
                fill: true,
                tension: 0.3
            }]
        },
        options: {
            scales: {
                y: { beginAtZero: true }
            }
        }
    });

    // Dữ liệu món ăn bán chạy
    const dishData = <%- JSON.stringify(topDishes) %>;
    const ctxDish = document.getElementById('dishChart').getContext('2d');
    new Chart(ctxDish, {
        type: 'bar',
        data: {
            labels: dishData.map(d => d.name_mon),
            datasets: [{
                label: 'Số lượng bán ra',
                data: dishData.map(d => d.total),
                backgroundColor: 'rgba(28, 200, 138, 0.8)',
                borderColor: 'rgba(28, 200, 138, 1)',
                borderWidth: 1
            }]
        },
        options: {
            indexAxis: 'y',
            scales: {
                x: { beginAtZero: true }
            }
        }
    });
</script>
<%- include('partials/footer') %>
