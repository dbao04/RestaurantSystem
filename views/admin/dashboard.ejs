// Vẽ Doanh thu theo ngày
// ---------------------------------------------------------------------------
async function veDoanhThuNgay() {
  const d = await layJSON('doanh-thu-ngay');
  ve('cDoanhThuNgay', {
    type: 'line',
    data: {
      labels: d.map(r => r.ngay.slice(5)),
      datasets: [
        { 
          label: 'Doanh thu (VNĐ)', 
          data: d.map(r => r.doanh_thu), 
          borderColor: '#c8a24b',
          backgroundColor: 'rgba(200, 162, 75, 0.12)', 
          fill: true, 
          tension: .3,
          borderWidth: 2.5,
          pointRadius: d.length > 90 ? 0 : 2.5,
          pointBackgroundColor: '#c8a24b',
          yAxisID: 'y' 
        },
        { 
          label: 'Số đơn hàng', 
          data: d.map(r => r.so_don), 
          borderColor: '#2d1f17',
          borderDash: [5, 4], 
          fill: false, 
          tension: .3,
          borderWidth: 2,
          pointRadius: 0, 
          yAxisID: 'y1' 
        },
      ],
    },
    options: {
      responsive: true, 
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { labels: { font: { family: "'Plus Jakarta Sans'", weight: 600 } } },
        tooltip: { 
          backgroundColor: '#221711',
          titleColor: '#c8a24b',
          padding: 12,
          cornerRadius: 8,
          callbacks: { 
            label: (c) => c.datasetIndex === 0
              ? 'Doanh thu: ' + dinhDangTien(c.parsed.y) + 'đ'
              : 'Số đơn: ' + c.parsed.y 
          } 
        },
      },
      scales: {
        x: { grid: { color: '#f3ede4' } },
        y:  { position: 'left', grid: { color: '#f3ede4' }, ticks: { callback: gonTien }, title: { display: true, text: 'Doanh thu' } },
        y1: { position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: 'Số đơn' } },
      },
    },
  });
}

// ---------------------------------------------------------------------------
// Vẽ Doanh thu theo giờ
// ---------------------------------------------------------------------------
async function veGio() {
  const d = await layJSON('doanh-thu-gio');
  ve('cGio', {
    type: 'bar',
    data: {
      labels: d.map(r => r.gio + 'h'),
      datasets: [{ 
        label: 'Doanh thu', 
        data: d.map(r => r.doanh_thu),
        borderRadius: 6,
        backgroundColor: d.map(r => (r.gio >= 11 && r.gio <= 13) || (r.gio >= 18 && r.gio <= 20) ? '#c8a24b' : '#d8cbbe') 
      }],
    },
    options: {
      responsive: true, 
      maintainAspectRatio: false,
      plugins: { 
        legend: { display: false },
        tooltip: { 
          backgroundColor: '#221711',
          titleColor: '#c8a24b',
          padding: 10,
          cornerRadius: 8,
          callbacks: { label: (c) => 'Doanh thu: ' + dinhDangTien(c.parsed.y) + 'đ' } 
        } 
      },
      scales: { 
        x: { grid: { display: false } },
        y: { grid: { color: '#f3ede4' }, ticks: { callback: gonTien } } 
      },
    },
  });

  const tong = d.reduce((s, r) => s + Number(r.doanh_thu), 0);
  const sap = [...d].sort((a, b) => b.doanh_thu - a.doanh_thu);
  const top3 = sap.slice(0, 3);
  const pct = tong > 0 ? (top3.reduce((s, r) => s + Number(r.doanh_thu), 0) / tong * 100) : 0;
  document.getElementById('insightGio').innerHTML =
    `<i class="fas fa-lightbulb"></i> <span>Ba khung giờ <b>${top3.map(r => r.gio + 'h').join(', ')}</b> đóng góp <b>${pct.toFixed(1)}%</b> tổng doanh thu. Cần bố trí tăng cường nhân sự và sơ chế nguyên liệu trước các khung giờ này.</span>`;
}

