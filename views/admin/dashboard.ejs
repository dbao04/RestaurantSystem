    <div class="nh-kpi c-gold">
      <div class="nh-kpi__top">
        <span class="nh-kpi__label">Tổng doanh thu</span>
        <div class="nh-kpi__icon"><i class="fas fa-coins"></i></div>
      </div>
      <div class="nh-kpi__value">${trieu(d.doanh_thu)} tr</div>
      <div class="nh-kpi__note"><i class="fas fa-circle-check" style="color:var(--nh-gold)"></i> ${d.so_don.toLocaleString('vi-VN')} đơn hoàn tất</div>
    </div>

    <div class="nh-kpi c-green">
      <div class="nh-kpi__top">
        <span class="nh-kpi__label">Lợi nhuận gộp</span>
        <div class="nh-kpi__icon"><i class="fas fa-chart-pie"></i></div>
      </div>
      <div class="nh-kpi__value">${trieu(d.loi_nhuan_gop)} tr</div>
      <div class="nh-kpi__note"><i class="fas fa-arrow-trend-up" style="color:var(--nh-ok)"></i> Biên lợi nhuận ${d.bien_loi_nhuan.toFixed(1)}%</div>
    </div>

    <div class="nh-kpi c-amber">
      <div class="nh-kpi__top">
        <span class="nh-kpi__label">Chi phí nguyên liệu</span>
        <div class="nh-kpi__icon"><i class="fas fa-boxes-packing"></i></div>
      </div>
      <div class="nh-kpi__value">${trieu(d.chi_phi_nguyen_lieu)} tr</div>
      <div class="nh-kpi__note"><i class="fas fa-scale-balanced" style="color:var(--nh-warn)"></i> ${(100 - d.bien_loi_nhuan).toFixed(1)}% doanh thu</div>
    </div>

    <div class="nh-kpi c-blue">
      <div class="nh-kpi__top">
        <span class="nh-kpi__label">Giá trị đơn TB</span>
        <div class="nh-kpi__icon"><i class="fas fa-receipt"></i></div>
      </div>
      <div class="nh-kpi__value">${dinhDangTien(Math.round(d.gia_tri_don_tb))}đ</div>
      <div class="nh-kpi__note"><i class="fas fa-bowl-food" style="color:var(--nh-info)"></i> ${dinhDangTien(d.so_mon_ban)} món bán ra</div>
    </div>

    <div class="nh-kpi c-red">
      <div class="nh-kpi__top">
        <span class="nh-kpi__label">Tỷ lệ hủy đơn</span>
        <div class="nh-kpi__icon"><i class="fas fa-ban"></i></div>
      </div>
      <div class="nh-kpi__value">${d.ty_le_huy.toFixed(2)}%</div>
      <div class="nh-kpi__note"><i class="fas fa-circle-exclamation" style="color:var(--nh-danger)"></i> ${d.don_huy} đơn đã hủy</div>
    </div>`;
}

