        <td><b>${r.name_mon.trim()}</b></td>
        <td class="num">${Number(r.so_lan).toLocaleString('vi-VN')}</td>
        <td class="num" style="font-weight:700; color:${r.phut_tb > 25 ? 'var(--nh-danger)' : r.phut_tb > 15 ? 'var(--nh-warn)' : 'var(--nh-ok)'}">${r.phut_tb}</td>
        <td class="num" style="color:var(--nh-muted)">${r.phut_max}</td>
      </tr>`).join('') || '<tr><td colspan="4" class="loading-state">Chưa có dữ liệu</td></tr>'}
    </tbody>`;
}

// ---------------------------------------------------------------------------
// Bảng Tồn kho
// ---------------------------------------------------------------------------
async function veTonKho() {
  const r = await fetch('/analytics/api/ton-kho');
  const d = await r.json();
  const nhan = { sap_het: 'Sắp hết', canh_bao: 'Cảnh báo', theo_doi: 'Theo dõi', du: 'Đủ' };
  const uuTien = { sap_het: 0, canh_bao: 1, theo_doi: 2, du: 3 };
  d.sort((a, b) => uuTien[a.muc] - uuTien[b.muc]);
  document.getElementById('tTonKho').innerHTML = `
    <thead><tr><th>Nguyên liệu</th><th class="num">Tồn hiện tại</th>
    <th class="num">Dùng/ngày</th><th class="num">Còn (ngày)</th><th>Trạng thái</th></tr></thead>
    <tbody>${d.map(x => `
      <tr>
        <td><b>${x.ten_nl}</b></td>
        <td class="num">${x.ton.toFixed(1)} ${x.ten_dvt || ''}</td>
        <td class="num" style="color:var(--nh-muted)">${x.tieu_hao_ngay.toFixed(2)}</td>
        <td class="num" style="font-weight:700">${x.so_ngay_con === null ? '—' : x.so_ngay_con.toFixed(1)}</td>
        <td><span class="nh-tag ${x.muc}">${nhan[x.muc]}</span></td>
      </tr>`).join('')}
    </tbody>`;
}

// ---------------------------------------------------------------------------
// Bảng Lô hết hạn
// ---------------------------------------------------------------------------
async function veHetHan() {
  const r = await fetch('/analytics/api/lo-het-han?ngay=14');
  const d = await r.json();
  document.getElementById('tHetHan').innerHTML = `
    <thead><tr><th>Nguyên liệu</th><th>Số lô</th><th class="num">SL tồn</th>
    <th>Hạn sử dụng</th><th class="num">Còn lại</th></tr></thead>
    <tbody>${d.map(x => `
      <tr>
        <td><b>${x.ten_nl}</b></td>
        <td style="color:var(--nh-muted)">${x.so_lo || '—'}</td>
        <td class="num">${Number(x.so_luong).toFixed(1)}</td>
        <td>${String(x.han_su_dung).slice(0, 10)}</td>
        <td class="num"><span class="nh-tag ${x.con_lai < 0 ? 'sap_het' : x.con_lai < 5 ? 'canh_bao' : 'theo_doi'}">${x.con_lai < 0 ? 'Quá hạn' : x.con_lai + ' ngày'}</span></td>
      </tr>`).join('') || '<tr><td colspan="5" class="loading-state">Không có lô hàng nào sắp hết hạn</td></tr>'}
    </tbody>`;
}

// ---------------------------------------------------------------------------
// Tải lại toàn bộ Dashboard
// ---------------------------------------------------------------------------
async function taiLai() {
  const viec = [
    veKpi(), veDoanhThuNgay(), veGio(), veThu(),
    veTron('cDanhMuc', 'danh-muc', r => r.name_loai, r => r.doanh_thu),
    veTron('cLoaiDon', 'loai-don', r => r.ten_loai, r => r.doanh_thu),
    veTopMon(), vePareto(), veNhanVien(), veBep(), veTonKho(), veHetHan(),
  ];
  const kq = await Promise.allSettled(viec);
  kq.filter(x => x.status === 'rejected').forEach(x => console.error(x.reason));
}

dongBoNutNhanh();
taiLai();
</script>
</body>
</html>
