<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard phân tích &amp; Hỗ trợ ra quyết định — Nhà Hàng Bảo Đoàn</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,400;1,700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Chart.js -->
  <script src="/chart.umd.js"></script>

  <style>
    :root {
      --nh-espresso: #221711;
      --nh-espresso-2: #2d1f17;
      --nh-espresso-3: #3b2a20;
      --nh-gold: #c8a24b;
      --nh-gold-light: #e5c87f;
      --nh-gold-soft: #f4ebd0;
      --nh-gold-dark: #9e7d30;
      --nh-cream: #fbf8f4;
      --nh-cream-2: #f2ece1;
      --nh-surface: #ffffff;
      --nh-ink: #1f1a16;
      --nh-muted: #786a5d;
      --nh-line: #e8ded1;
      --nh-line-soft: #f3ede4;

      --nh-ok: #15803d;
      --nh-ok-bg: #ecfdf5;
      --nh-ok-border: #a7f3d0;
      --nh-warn: #b45309;
      --nh-warn-bg: #fffbeb;
      --nh-warn-border: #fde68a;
      --nh-danger: #b91c1c;
      --nh-danger-bg: #fef2f2;
      --nh-danger-border: #fecaca;
      --nh-info: #1d4ed8;
      --nh-info-bg: #eff6ff;
      --nh-info-border: #bfdbfe;

      --nh-serif: 'Playfair Display', Georgia, serif;
      --nh-sans: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --nh-radius-sm: 8px;
      --nh-radius: 14px;
      --nh-radius-lg: 18px;
      --nh-shadow-sm: 0 4px 12px rgba(34, 23, 17, 0.04);
      --nh-shadow: 0 10px 30px -8px rgba(34, 23, 17, 0.08);
      --nh-shadow-lg: 0 20px 40px -12px rgba(34, 23, 17, 0.12);
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--nh-cream);
      color: var(--nh-ink);
      font-family: var(--nh-sans);
      -webkit-font-smoothing: antialiased;
      line-height: 1.5;
    }

    /* ------------------------------------------------------------- HEADER */
    header.nh-topbar {
      background: linear-gradient(135deg, var(--nh-espresso) 0%, var(--nh-espresso-2) 60%, var(--nh-espresso-3) 100%);
      color: #fff;
      padding: 16px 32px;
      border-bottom: 2px solid var(--nh-gold);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
    }
    .nh-topbar__inner {
      max-width: 1560px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }
    .nh-topbar__brand {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      color: inherit;
    }
    .nh-topbar__logo {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(200, 162, 75, 0.15);
      border: 1px solid rgba(200, 162, 75, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 6px;
      box-shadow: inset 0 0 12px rgba(200, 162, 75, 0.2);
    }
    .nh-topbar__logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: brightness(0) invert(1) sepia(1) saturate(5) hue-rotate(5deg);
    }
    .nh-topbar__titles h1 {
      margin: 0;
      font-family: var(--nh-serif);
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.3px;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .nh-badge-layer {
      background: linear-gradient(135deg, var(--nh-gold), var(--nh-gold-dark));
      color: #1f160e;
      font-family: var(--nh-sans);
      font-size: 11px;
      font-weight: 800;
      padding: 2px 9px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .nh-topbar__sub {
      font-size: 12.5px;
      color: rgba(255, 255, 255, 0.7);
      margin-top: 3px;
    }
    .nh-topbar__sub b {
      color: var(--nh-gold-light);
      font-weight: 600;
    }

    .nh-topbar__nav {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .nh-topbar__nav a {
      color: #fff;
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      padding: 8px 14px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: var(--nh-radius-sm);
      display: inline-flex;
      align-items: center;
      gap: 7px;
      transition: all 0.2s ease;
    }
    .nh-topbar__nav a i {
      color: var(--nh-gold);
      font-size: 12px;
      transition: transform 0.2s;
    }
    .nh-topbar__nav a:hover {
      background: rgba(200, 162, 75, 0.22);
      border-color: var(--nh-gold);
      color: #fff;
      transform: translateY(-1px);
    }
    .nh-topbar__nav a:hover i {
      transform: scale(1.15);
    }

    /* ------------------------------------------------------------- WRAPPER */
    .nh-wrap {
      max-width: 1560px;
      margin: 0 auto;
      padding: 26px 32px 80px;
    }

    /* ------------------------------------------------------------- FILTER BAR */
    .nh-filter {
      background: var(--nh-surface);
      border: 1px solid var(--nh-line);
      border-radius: var(--nh-radius);
      padding: 16px 22px;
      margin-bottom: 22px;
      box-shadow: var(--nh-shadow-sm);
      display: flex;
      gap: 16px;
      align-items: flex-end;
      flex-wrap: wrap;
      position: relative;
    }
    .nh-filter::before {
      content: '';
      position: absolute;
      top: 0; left: 24px; right: 24px;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--nh-gold), transparent);
    }
    .nh-field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .nh-field label {
      font-size: 12px;
      font-weight: 700;
      color: var(--nh-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .nh-field label i {
      color: var(--nh-gold);
    }
    .nh-input {
      padding: 9px 13px;
      border: 1px solid var(--nh-line);
      border-radius: var(--nh-radius-sm);
      font-size: 14px;
      font-family: inherit;
      background: var(--nh-cream);
      color: var(--nh-ink);
      font-weight: 600;
      transition: all 0.2s ease;
      outline: none;
    }
    .nh-input:focus {
      border-color: var(--nh-gold);
      background: #fff;
      box-shadow: 0 0 0 3px rgba(200, 162, 75, 0.18);
    }

    .nh-btn-group {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }
    .nh-btn {
      background: linear-gradient(135deg, var(--nh-espresso) 0%, var(--nh-espresso-2) 100%);
      color: #fff;
      border: 1px solid var(--nh-gold);
      padding: 9px 18px;
      border-radius: var(--nh-radius-sm);
      cursor: pointer;
      font-size: 13.5px;
      font-weight: 700;
      font-family: inherit;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      box-shadow: 0 4px 14px rgba(34, 23, 17, 0.15);
      transition: all 0.2s ease;
    }
    .nh-btn i { color: var(--nh-gold); }
    .nh-btn:hover {
      background: linear-gradient(135deg, var(--nh-gold) 0%, var(--nh-gold-dark) 100%);
      color: #1f160e;
      border-color: var(--nh-gold-dark);
      box-shadow: 0 6px 18px rgba(200, 162, 75, 0.35);
      transform: translateY(-1px);
    }
    .nh-btn:hover i { color: #1f160e; }

    .nh-btn.nh-pill {
      background: var(--nh-cream-2);
      color: var(--nh-ink);
      border: 1px solid var(--nh-line);
      box-shadow: none;
      font-weight: 600;
    }
    .nh-btn.nh-pill:hover {
      background: var(--nh-gold-soft);
      border-color: var(--nh-gold);
      color: var(--nh-espresso);
      transform: translateY(-1px);
    }
    .nh-btn.nh-pill.active {
      background: linear-gradient(135deg, var(--nh-gold), var(--nh-gold-dark));
      color: #1f160e;
      border-color: var(--nh-gold-dark);
      font-weight: 800;
      box-shadow: 0 4px 14px rgba(200, 162, 75, 0.3);
    }

    /* ------------------------------------------------------------- KPI CARDS */
    .nh-kpis {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .nh-kpi {
      background: var(--nh-surface);
      border: 1px solid var(--nh-line);
      border-radius: var(--nh-radius);
      padding: 18px 22px;
      box-shadow: var(--nh-shadow-sm);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s ease;
    }
    .nh-kpi:hover {
      transform: translateY(-2px);
      box-shadow: var(--nh-shadow);
      border-color: var(--nh-gold-light);
    }
    .nh-kpi__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }
    .nh-kpi__label {
      font-size: 12px;
      font-weight: 700;
      color: var(--nh-muted);
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }
    .nh-kpi__icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }
    .nh-kpi.c-gold .nh-kpi__icon   { background: var(--nh-gold-soft); color: var(--nh-gold-dark); border: 1px solid rgba(200, 162, 75, 0.3); }
    .nh-kpi.c-green .nh-kpi__icon  { background: var(--nh-ok-bg); color: var(--nh-ok); border: 1px solid var(--nh-ok-border); }
    .nh-kpi.c-amber .nh-kpi__icon  { background: var(--nh-warn-bg); color: var(--nh-warn); border: 1px solid var(--nh-warn-border); }
    .nh-kpi.c-blue .nh-kpi__icon   { background: var(--nh-info-bg); color: var(--nh-info); border: 1px solid var(--nh-info-border); }
    .nh-kpi.c-red .nh-kpi__icon    { background: var(--nh-danger-bg); color: var(--nh-danger); border: 1px solid var(--nh-danger-border); }

    .nh-kpi__value {
      font-size: 27px;
      font-weight: 800;
      color: var(--nh-espresso);
      font-family: var(--nh-sans);
      letter-spacing: -0.5px;
      margin-bottom: 4px;
    }
    .nh-kpi__note {
      font-size: 12.5px;
      color: var(--nh-muted);
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* ------------------------------------------------------------- CARDS & GRIDS */
    .nh-grid {
      display: grid;
      gap: 20px;
      margin-bottom: 20px;
    }
    .nh-grid--2 { grid-template-columns: repeat(auto-fit, minmax(480px, 1fr)); }
    .nh-grid--3 { grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); }

    @media (max-width: 768px) {
      .nh-grid--2, .nh-grid--3 { grid-template-columns: 1fr; }
      .nh-wrap { padding: 16px; }
      header.nh-topbar { padding: 14px 16px; }
    }

    .nh-card {
      background: var(--nh-surface);
      border: 1px solid var(--nh-line);
      border-radius: var(--nh-radius);
      padding: 22px 24px;
      box-shadow: var(--nh-shadow-sm);
      display: flex;
      flex-direction: column;
      transition: border-color 0.2s ease;
    }
    .nh-card:hover {
      border-color: #dcd0bf;
    }
    .nh-card__header {
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--nh-line-soft);
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }
    .nh-card__title {
      margin: 0;
      font-family: var(--nh-serif);
      font-size: 17px;
      font-weight: 700;
      color: var(--nh-espresso);
      display: flex;
      align-items: center;
      gap: 9px;
    }
    .nh-card__title i {
      color: var(--nh-gold);
      font-size: 15px;
    }
    .nh-card__desc {
      font-size: 12.5px;
      color: var(--nh-muted);
      margin-top: 3px;
    }

    .nh-chart-box {
      position: relative;
      height: 310px;
      width: 100%;
    }
    .nh-chart-box--tall {
      height: 390px;
    }

    /* ------------------------------------------------------------- INSIGHT BOX */
    .nh-insight {
      background: linear-gradient(135deg, #fdfaf3 0%, var(--nh-gold-soft) 100%);
      border: 1px solid #ebd9b0;
      border-left: 4px solid var(--nh-gold);
      border-radius: var(--nh-radius-sm);
      padding: 13px 16px;
      font-size: 13.5px;
      line-height: 1.6;
      margin-top: 14px;
      color: var(--nh-espresso);
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .nh-insight i.fa-lightbulb {
      color: var(--nh-gold-dark);
      font-size: 16px;
      margin-top: 2px;
      flex-shrink: 0;
    }
    .nh-insight b {
      color: var(--nh-espresso);
      font-weight: 700;
    }

    /* ------------------------------------------------------------- TABLES */
    .nh-table-scroll {
      max-height: 380px;
      overflow-y: auto;
      border: 1px solid var(--nh-line-soft);
      border-radius: var(--nh-radius-sm);
    }
    table.nh-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
      text-align: left;
    }
    table.nh-table th {
      background: var(--nh-cream-2);
      color: var(--nh-muted);
      font-weight: 700;
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px 14px;
      position: sticky;
      top: 0;
      z-index: 10;
      border-bottom: 1px solid var(--nh-line);
    }
    table.nh-table td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--nh-line-soft);
      color: var(--nh-ink);
    }
    table.nh-table tbody tr:hover {
      background: #faf6ef;
    }
    table.nh-table td.num, table.nh-table th.num {
      text-align: right;
      font-variant-numeric: tabular-nums;
      font-weight: 600;
    }

    /* Tags / Badges */
    .nh-tag {
      padding: 3px 9px;
      border-radius: 20px;
      font-size: 11.5px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
    }
    .nh-tag.sap_het  { background: var(--nh-danger-bg); color: var(--nh-danger); border: 1px solid var(--nh-danger-border); }
    .nh-tag.canh_bao { background: var(--nh-warn-bg); color: var(--nh-warn); border: 1px solid var(--nh-warn-border); }
    .nh-tag.theo_doi { background: var(--nh-info-bg); color: var(--nh-info); border: 1px solid var(--nh-info-border); }
    .nh-tag.du       { background: var(--nh-ok-bg); color: var(--nh-ok); border: 1px solid var(--nh-ok-border); }

    .nh-progress-bar {
      background: var(--nh-line-soft);
      border-radius: 6px;
      height: 7px;
      width: 100%;
      overflow: hidden;
    }
    .nh-progress-val {
      background: linear-gradient(90deg, var(--nh-gold), var(--nh-gold-dark));
      height: 100%;
      border-radius: 6px;
    }

    .loading-state {
      padding: 30px;
      text-align: center;
      color: var(--nh-muted);
      font-size: 13.5px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .loading-state i {
      color: var(--nh-gold);
    }
  </style>
</head>
<body>

  <!-- ========================================================= TOPBAR -->
  <header class="nh-topbar">
    <div class="nh-topbar__inner">
      <a class="nh-topbar__brand" href="/admin">
        <div class="nh-topbar__logo">
          <img src="/logo.svg" alt="Logo">
        </div>
        <div class="nh-topbar__titles">
          <h1>
            Nhà Hàng Bảo Đoàn
            <span class="nh-badge-layer">Tầng 2 &bull; Phân tích dữ liệu</span>
          </h1>
          <div class="nh-topbar__sub">
            Dashboard Phân Tích Vận Hành &amp; Hỗ Trợ Ra Quyết Định &bull; Xin chào <b><%= tenNguoiDung %></b>
          </div>
        </div>
      </a>

      <nav class="nh-topbar__nav">
        <a href="/admin"><i class="fas fa-gauge-high"></i> Trang quản trị</a>
        <a href="/du-bao"><i class="fas fa-brain"></i> Dự báo AI</a>
        <a href="/so-do-ban"><i class="fas fa-chair"></i> Sơ đồ bàn</a>
        <a href="/kds"><i class="fas fa-fire-burner"></i> Bếp KDS</a>
        <a href="/staff"><i class="fas fa-users-gear"></i> Nhân viên</a>
        <a href="/" target="_blank"><i class="fas fa-store"></i> Trang chủ</a>
      </nav>
    </div>
  </header>

  <!-- ========================================================= MAIN CONTAINER -->
  <div class="nh-wrap">
    
    <!-- Filter Toolbar -->
    <div class="nh-filter">
      <div class="nh-field">
        <label for="tu"><i class="fas fa-calendar-day"></i> Từ ngày</label>
        <input type="date" id="tu" class="nh-input" value="<%= khoang.tu %>">
      </div>
      <div class="nh-field">
        <label for="den"><i class="fas fa-calendar-check"></i> Đến ngày</label>
        <input type="date" id="den" class="nh-input" value="<%= khoang.den %>">
      </div>

      <div class="nh-btn-group">
        <button class="nh-btn" onclick="taiLai()"><i class="fas fa-filter"></i> Áp dụng</button>
        <button class="nh-btn nh-pill" data-ngay="7" onclick="datNhanh(7)">7 ngày</button>
        <button class="nh-btn nh-pill" data-ngay="30" onclick="datNhanh(30)">30 ngày</button>
        <button class="nh-btn nh-pill" data-ngay="90" onclick="datNhanh(90)">90 ngày</button>
        <button class="nh-btn nh-pill" data-ngay="365" onclick="datNhanh(365)">1 năm</button>
      </div>
    </div>

    <!-- 5 KPI Cards -->
    <div class="nh-kpis" id="kpis">
      <div class="loading-state"><i class="fas fa-spinner fa-spin"></i> Đang tải số liệu tổng quan...</div>
    </div>

    <!-- Hàng 1: Doanh thu theo ngày + Doanh thu theo khung giờ -->
    <div class="nh-grid nh-grid--2">
      <div class="nh-card">
        <div class="nh-card__header">
          <div>
            <h2 class="nh-card__title"><i class="fas fa-chart-line"></i> Doanh thu theo ngày</h2>
            <div class="nh-card__desc">Xu hướng biến động doanh thu &amp; số lượng đơn hàng theo chuỗi thời gian</div>
          </div>
        </div>
        <div class="nh-chart-box"><canvas id="cDoanhThuNgay"></canvas></div>
      </div>

      <div class="nh-card">
        <div class="nh-card__header">
          <div>
            <h2 class="nh-card__title"><i class="fas fa-clock"></i> Doanh thu theo khung giờ</h2>
            <div class="nh-card__desc">Xác định khung giờ cao điểm để điều phối nhân sự &amp; dự phòng bếp</div>
          </div>
        </div>
        <div class="nh-chart-box"><canvas id="cGio"></canvas></div>
        <div class="nh-insight" id="insightGio"><i class="fas fa-lightbulb"></i> <span>Đang phân tích dữ liệu khung giờ...</span></div>
      </div>
    </div>

    <!-- Hàng 2: Thứ trong tuần + Cơ cấu danh mục + Cơ cấu phục vụ -->
    <div class="nh-grid nh-grid--3">
      <div class="nh-card">
        <div class="nh-card__header">
          <div>
            <h2 class="nh-card__title"><i class="fas fa-calendar-week"></i> Theo thứ trong tuần</h2>
            <div class="nh-card__desc">Cơ sở khoa học để xếp ca làm việc</div>
          </div>
        </div>
        <div class="nh-chart-box"><canvas id="cThu"></canvas></div>
      </div>

      <div class="nh-card">
        <div class="nh-card__header">
          <div>
            <h2 class="nh-card__title"><i class="fas fa-chart-pie"></i> Cơ cấu danh mục món</h2>
            <div class="nh-card__desc">Tỷ trọng đóng góp doanh thu từng nhóm</div>
          </div>
        </div>
        <div class="nh-chart-box"><canvas id="cDanhMuc"></canvas></div>
      </div>

      <div class="nh-card">
        <div class="nh-card__header">
          <div>
            <h2 class="nh-card__title"><i class="fas fa-utensils"></i> Hình thức phục vụ</h2>
