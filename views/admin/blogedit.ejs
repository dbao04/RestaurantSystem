<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="qt-card">
    <div class="qt-card__head">
        <div>
            <h2>Sửa bài viết</h2>
            <p>Cập nhật nội dung bài “<%= post.tieu_de %>”.</p>
        </div>
        <div class="qt-card__act">
            <a class="qt-btn qt-btn--ghost" href="/admin/bloglist"><i class="fas fa-arrow-left"></i> Quay lại danh sách</a>
        </div>
    </div>
    <div class="qt-card__body">
        <form class="qt-form" action="/admin/blogedit/<%= post.id_bv %>" method="POST" enctype="multipart/form-data">
            <div class="qt-field">
                <label for="tieu_de">Tiêu đề <span class="qt-req">*</span></label>
                <input type="text" id="tieu_de" name="tieu_de" value="<%= post.tieu_de %>" required />
            </div>

            <div class="qt-field">
                <label>Hình ảnh hiện tại</label>
                <div class="qt-preview">
                    <% if (post.hinh_anh) { %>
                        <img src="/food/<%= post.hinh_anh %>" alt="<%= post.tieu_de %>" onerror="this.src='/logo.png'">
                        <span class="qt-field__hint" style="margin:0"><%= post.hinh_anh %></span>
                    <% } else { %>
                        <span class="qt-thumb--none"><i class="fas fa-image"></i></span>
                        <span class="qt-field__hint" style="margin:0">Bài viết này chưa có ảnh.</span>
                    <% } %>
                </div>
            </div>

            <div class="qt-field">
                <label>Đổi hình ảnh</label>
                <label class="qt-file">
                    <i class="fas fa-cloud-arrow-up"></i>
                    <span>Chọn ảnh mới từ máy tính</span>
                    <input type="file" name="hinh_anh" accept="image/*" />
                </label>
                <div class="qt-field__hint">Để trống nếu không muốn đổi ảnh.</div>
            </div>

            <div class="qt-field">
                <label for="noi_dung">Nội dung <span class="qt-req">*</span></label>
                <textarea id="noi_dung" name="noi_dung" style="min-height:300px" required><%= post.noi_dung %></textarea>
            </div>


            <!-- Ban dich. De trong cung duoc: bai chua dich se hien ban tieng
                 Viet kem dong bao "Bai viet hien chi co ban tieng Viet" o trang
                 tin tuc, dung cho bai do thoi. -->
            <div class="qt-field">
                <label for="tieu_de_en">Tiêu đề (English)</label>
                <input type="text" id="tieu_de_en" name="tieu_de_en" placeholder="Để trống nếu chưa dịch" value="<%= post.tieu_de_en || '' %>">
            </div>

            <div class="qt-field">
                <label for="noi_dung_en">Nội dung (English)</label>
                <textarea id="noi_dung_en" name="noi_dung_en" style="min-height:200px" placeholder="Để trống nếu chưa dịch"><%= post.noi_dung_en || '' %></textarea>
            </div>

            <div class="qt-field">
                <label for="tieu_de_ja">Tiêu đề (日本語)</label>
                <input type="text" id="tieu_de_ja" name="tieu_de_ja" placeholder="Để trống nếu chưa dịch" value="<%= post.tieu_de_ja || '' %>">
            </div>

            <div class="qt-field">
                <label for="noi_dung_ja">Nội dung (日本語)</label>
                <textarea id="noi_dung_ja" name="noi_dung_ja" style="min-height:200px" placeholder="Để trống nếu chưa dịch"><%= post.noi_dung_ja || '' %></textarea>
            </div>
            <div class="qt-form__actions">
                <button class="qt-btn qt-btn--primary" type="submit" name="submit"><i class="fas fa-floppy-disk"></i> Cập nhật</button>
                <a class="qt-btn qt-btn--ghost" href="/admin/bloglist">Hủy</a>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
