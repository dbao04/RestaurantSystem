<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="qt-card">
    <div class="qt-card__head">
        <div>
            <h2>Thêm món ăn</h2>
            <p>Bổ sung một món mới vào thực đơn của nhà hàng.</p>
        </div>
        <div class="qt-card__act">
            <a class="qt-btn qt-btn--ghost" href="/admin/productlist"><i class="fas fa-arrow-left"></i> Quay lại danh sách</a>
        </div>
    </div>
    <div class="qt-card__body">
        <form class="qt-form" action="/admin/productadd" method="post" enctype="multipart/form-data">
            <div class="qt-field">
                <label for="name_mon">Tên món <span class="qt-req">*</span></label>
                <input type="text" id="name_mon" name="name_mon" placeholder="Ví dụ: Gỏi cuốn tôm thịt" required />
            </div>

            <div class="qt-form__row qt-form__row--2">
                <div class="qt-field">
                    <label for="loaimon">Loại món <span class="qt-req">*</span></label>
                    <select id="loaimon" name="loaimon" required>
                        <option value="">— Chọn loại món —</option>
                        <% if (categories) { %>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id_loai %>"><%= cat.name_loai %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="qt-field">
                    <label for="gia">Giá (VNĐ) <span class="qt-req">*</span></label>
                    <input type="number" id="gia" name="gia" placeholder="Ví dụ: 85000" min="1" required />
                </div>
            </div>

            <div class="qt-field">
                <label for="ghichu">Ghi chú</label>
                <textarea id="ghichu" name="ghichu" placeholder="Mô tả nguyên liệu, cách phục vụ…"></textarea>
            </div>

            <div class="qt-field">
                <label>Hình ảnh món ăn <span class="qt-req">*</span></label>
                <label class="qt-file">
                    <i class="fas fa-cloud-arrow-up"></i>
                    <span>Chọn ảnh từ máy tính</span>
                    <input type="file" name="image" accept="image/*" required />
                </label>
            </div>

            <div class="qt-field">
                <label for="tinhtrang">Trạng thái</label>
                <select id="tinhtrang" name="tinhtrang">
                    <option value="1">Đang phục vụ</option>
                    <option value="0">Ngưng phục vụ</option>
                </select>
            </div>

            <div class="qt-form__actions">
                <button class="qt-btn qt-btn--primary" type="submit" name="submit"><i class="fas fa-floppy-disk"></i> Lưu món ăn</button>
                <a class="qt-btn qt-btn--ghost" href="/admin/productlist">Hủy</a>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
