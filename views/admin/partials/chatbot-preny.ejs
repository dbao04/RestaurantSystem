          <div class="pr-rong"><%- sw('nho_lich_su', 'Nhớ lịch sử cuộc trò chuyện', 'Hiểu câu nói tiếp như người thật: <b>“còn thứ 7 thì sao”</b> (sau khi hỏi giờ mở cửa), <b>“món thứ 2 giá bao nhiêu”</b>, <b>“còn món nào khác không”</b>, <b>“có món nào rẻ hơn không”</b>. Khách bấm “Cuộc trò chuyện mới” thì bot quên.') %></div>
          <%- so('so_luot_nho', 'Số lượt hỏi–đáp gần nhất bot nhớ', 'Dùng cho AI Claude và câu nói tiếp. 10–15 là vừa.', 2, 40) %>
          <div></div>
          <div class="pr-rong"><%- sw('nho_so_thich', 'Nhớ sở thích &amp; tên khách tự kể', 'Khách nói <b>“mình ăn chay”</b>, <b>“không ăn được cay”</b>, <b>“dị ứng hải sản”</b>, <b>“đi 6 người”</b>, <b>“ngân sách 200k”</b>, <b>“mình tên Lan”</b> → các lần gợi ý món sau tự bỏ món không hợp và gọi đúng tên khách.') %></div>
        </div>
      </div>

      <div class="nh-card" id="tl-ai">
        <div class="nh-card__header"><h2 class="nh-card__title"><i class="fas fa-wand-magic-sparkles"></i> AI Claude (tùy chọn)</h2>
          <p class="nh-card__desc">Không bật thì bot vẫn chạy đầy đủ như trên. Bật thêm AI Claude để bot <b>hiểu mọi loại ảnh / video</b> (hóa đơn, ảnh bàn tiệc, món ở quán khác, ảnh lỗi thanh toán…)
            và <b>trả lời cả những câu bot không hiểu</b> dựa trên lịch sử trò chuyện + thông tin nhà hàng + toàn bộ thực đơn. Mỗi lượt gọi AI tính phí theo tài khoản Anthropic của bạn.</p></div>
        <div class="pr-luoi">
          <div class="pr-rong">
            <div class="pr-truong">
              <span>Khóa API Claude</span>
              <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                <input class="nh-input" id="ai-khoa" type="password" autocomplete="off" placeholder="<%= aiTrangThai.co_khoa ? aiTrangThai.khoa_an + ' (đã lưu - nhập khóa mới để thay)' : 'sk-ant-...' %>" style="flex:1;min-width:220px;" <%= aiTrangThai.nguon_khoa === 'env' ? 'disabled' : '' %>>
                <button class="nh-btn ghost" type="button" id="ai-luu-khoa" <%= aiTrangThai.nguon_khoa === 'env' ? 'disabled' : '' %>><i class="fas fa-key"></i> Lưu khóa</button>
                <% if (aiTrangThai.co_khoa && aiTrangThai.nguon_khoa !== 'env') { %><button class="nh-btn ghost" type="button" id="ai-xoa-khoa"><i class="fas fa-trash"></i></button><% } %>
                <button class="nh-btn ghost" type="button" id="ai-kiem-tra"><i class="fas fa-plug-circle-check"></i> Kiểm tra kết nối</button>
              </div>
              <small id="ai-trang-thai"><%- aiTrangThai.nguon_khoa === 'env' ? 'Đang dùng khóa trong biến môi trường <code>ANTHROPIC_API_KEY</code> của máy chủ.' : (aiTrangThai.co_khoa ? '<b style="color:var(--nh-ok)">Đã có khóa</b> ' + aiTrangThai.khoa_an : 'Chưa có khóa. Tạo khóa tại console.anthropic.com → API Keys. Khóa chỉ lưu trên máy chủ, không bao giờ gửi ra trình duyệt khách.') %><%= aiTrangThai.loi_gan_nhat ? ' · Lỗi gần nhất: ' + aiTrangThai.loi_gan_nhat : '' %></small>
            </div>
          </div>
          <div class="pr-rong"><%- sw('bat_ai', 'Dùng AI Claude', 'Cần có khóa API ở trên.') %></div>
          <div><%- sw('ai_doc_anh', 'AI đọc ảnh &amp; video khách gửi', 'Kết quả so ảnh với thực đơn được gửi kèm cho AI để trả lời chính xác món, giá.') %></div>
          <div><%- sw('ai_khi_khong_hieu', 'AI trả lời câu bot không hiểu', 'Chỉ gọi AI khi kho kiến thức, thực đơn, hiểu ý khách đều không trả lời được → tiết kiệm chi phí.') %></div>
          <%- chon('ai_mo_hinh', 'Mô hình', [['claude-opus-5-5', 'Claude Opus 5.5 (thông minh nhất, mặc định)'], ['claude-sonnet-5-5', 'Claude Sonnet 5.5 (nhanh, rẻ hơn)'], ['claude-haiku-5-5', 'Claude Haiku 5.5 (nhanh nhất, rẻ nhất)']]) %>
          <div></div>
          <div class="pr-rong"><%- vung('ai_chi_dan', 'Dặn AI cách trả lời', 'Thông tin nhà hàng, thực đơn, xưng hô đã tự gửi kèm - ở đây chỉ cần dặn thêm phong cách, điều cần tránh.', 3) %></div>
        </div>
      </div>

      <div class="nh-card" id="tl-giao-dien">
        <div class="nh-card__header"><h2 class="nh-card__title"><i class="fas fa-comments"></i> Khung chat</h2>
          <p class="nh-card__desc">Các hiệu ứng giúp cuộc trò chuyện tự nhiên như đang nhắn với người thật.</p></div>
        <div class="pr-luoi">
          <div><%- sw('hieu_ung_go', 'Hiệu ứng “đang gõ…”', 'Hiện ba chấm trước khi trả lời, dài ngắn theo độ dài câu.') %></div>
          <div><%- sw('chia_tin', 'Tách tin dài thành nhiều bong bóng', 'Như người thật nhắn từng đoạn.') %></div>
          <%- so('toc_do_go', 'Tốc độ gõ (mili giây / ký tự)', 'Càng lớn bot gõ càng chậm. 40–60 giống người thật; 20 là khá nhanh.', 0, 150) %>
          <%- so('go_toi_da_ms', 'Thời gian gõ tối đa (mili giây)', 'Câu dài nhất cũng chỉ gõ tới mức này.', 0, 10000, 100) %>
          <%- so('tre_doc_ms', 'Thời gian đọc tin trước khi gõ (mili giây)', 'Bot im lặng như đang đọc tin của khách rồi mới hiện “đang gõ…”. Khoảng 800–1500 trông tự nhiên.', 0, 5000, 100) %>
          <div></div>
          <div class="pr-rong"><%- sw('chao_chu_dong', 'Chủ động mời khách trò chuyện', 'Sau vài giây khách vào web, bong bóng lời mời hiện cạnh nút chat.') %></div>
          <%- so('chao_chu_dong_giay', 'Hiện lời mời sau (giây)', '', 2, 120) %>
          <%- chu('chao_chu_dong_noi_dung', 'Nội dung lời mời') %>
          <div class="pr-rong"><%- sw('hien_goi_y', 'Hiện nút gợi ý câu hỏi dưới tin nhắn', 'Tắt (khuyên dùng) để khung chat giống nhắn tin với người thật. Khi tắt, bot hỏi lại bằng lời thay vì hiện nút.') %></div>
          <div class="pr-rong"><%- vung('goi_y_nhanh', 'Câu gợi ý nhanh (mỗi dòng một câu)', 'Chỉ hiện khi bật nút gợi ý ở trên.', 4) %></div>
          <div><%- sw('hien_nut_goi', 'Hiện nút gọi hotline', '') %></div>
          <div><%- sw('hien_nut_nhan_vien', 'Hiện nút “Chat với nhân viên”', '') %></div>
          <div><%- sw('luu_lich_su', 'Giữ cuộc trò chuyện khi khách chuyển trang', '') %></div>
          <div><%- sw('cham_diem', 'Cho khách chấm 👍 / 👎 câu trả lời', '') %></div>
        </div>
      </div>

      <div class="nh-card" id="tl-gio">
        <div class="nh-card__header"><h2 class="nh-card__title"><i class="fas fa-clock"></i> Giờ hoạt động</h2>
          <p class="nh-card__desc">Mặc định trợ lý trả lời 24/7. Chọn khung giờ nếu chỉ muốn bot trực trong giờ nhất định.</p></div>
        <div class="pr-luoi">
          <%- chon('gio_hoat_dong', 'Chế độ', [['24_7', 'Trả lời 24/7'], ['khung_gio', 'Chỉ trong khung giờ']]) %>
          <div style="display:flex;gap:12px;"><%- chu('gio_bat_dau', 'Từ', '', '08:00') %><%- chu('gio_ket_thuc', 'Đến', '', '22:00') %></div>
          <div class="pr-rong"><%- vung('tin_ngoai_gio', 'Tin nhắn ngoài giờ', '', 2) %></div>
        </div>
      </div>

      <div class="nh-card" id="tl-khach">
        <div class="nh-card__header"><h2 class="nh-card__title"><i class="fas fa-user-plus"></i> Thu thập khách &amp; chuyển nhân viên</h2>
          <p class="nh-card__desc">Khách nhắn số điện thoại trong khung chat thì bot tự ghi lại và báo cho quản lý, lễ tân.</p></div>
        <div class="pr-luoi">
          <div><%- sw('bat_thu_sdt', 'Ghi nhận số điện thoại khách để lại', '') %></div>
          <div><%- sw('bao_nhan_vien_sdt', 'Thông báo cho quản lý / lễ tân', 'Gửi vào chuông thông báo của nhân viên.') %></div>
          <div class="pr-rong"><%- vung('tin_cam_on_sdt', 'Câu cảm ơn khi khách để lại số', 'Biến <code>{sdt}</code> là số khách vừa nhập.', 2) %></div>
          <div><%- sw('tu_dong_chuyen_nv', 'Tự mời gặp nhân viên khi bot bí', '') %></div>
          <%- so('so_lan_khong_hieu', 'Sau bao nhiêu lần không hiểu liên tiếp', '', 1, 10) %>
          <div class="pr-rong"><%- vung('tin_chuyen_nv', 'Câu mời gặp nhân viên', '', 2) %></div>
        </div>
      </div>

      <div class="nh-card" id="tl-kiem-duyet">
        <div class="nh-card__header"><h2 class="nh-card__title"><i class="fas fa-shield-halved"></i> Kiểm duyệt</h2></div>
        <div class="pr-luoi">
          <div class="pr-rong"><%- vung('tu_cam', 'Từ ngữ không phù hợp (mỗi dòng một từ)', 'Khách dùng các từ này thì bot nhắc nhở lịch sự, không trả lời nội dung.', 3) %></div>
          <div class="pr-rong"><%- vung('tin_tu_cam', 'Câu nhắc nhở', '', 2) %></div>
        </div>
      </div>

      <div class="pr-luu">
        <span id="tl-trang-thai">Thay đổi có hiệu lực ngay sau khi lưu, không cần khởi động lại.</span>
        <button class="nh-btn ghost" type="button" id="tl-mac-dinh"><i class="fas fa-rotate-left"></i> Khôi phục mặc định</button>
        <button class="nh-btn" type="submit"><i class="fas fa-floppy-disk"></i> Lưu thiết lập</button>
      </div>
    </div>
  </div>
  </form>
</section>

<!-- =========================================================== THU NGHIEM -->
<section class="qt-tab" data-tab="thu">
  <div class="pr-thu">
    <div class="pr-chat">
      <div class="pr-chat__dau">
        <i class="fas fa-vial"></i> <b>Chat thử</b>
        <select id="thu-vai"><option value="khach">Đóng vai khách</option><option value="quan_ly">Đóng vai quản lý</option></select>
        <input id="thu-ten" placeholder="Tên khách (tùy chọn)" style="width:150px;">
        <button class="nh-btn ghost nho" type="button" id="thu-moi" style="margin-left:auto;padding:5px 10px;"><i class="fas fa-rotate-right"></i> Mới</button>
      </div>
      <div class="pr-chat__than" id="thu-than">
        <div class="pr-tn pr-tn--bot"><div class="pr-tn__noi">Gõ thử câu khách hay hỏi, ví dụ: <b>“sashimi cá hồi bao nhiêu”</b>, <b>“có chỗ đậu ô tô k”</b>, <b>“quán mở tới mấy h”</b>, <b>“món dưới 100k”</b>. Bên phải hiện bot đã lấy câu trả lời từ đâu.</div></div>
      </div>
      <form class="pr-chat__chan" id="thu-form">
        <button class="nh-btn ghost" type="button" id="thu-anh" title="Thử gửi ảnh như khách"><i class="fas fa-image"></i></button>
        <input type="file" id="thu-tep" accept="image/*" hidden>
        <input class="nh-input" id="thu-o" placeholder="Nhập câu hỏi như khách hàng… (hoặc bấm 🖼 để thử gửi ảnh)" maxlength="500">
        <button class="nh-btn" type="submit"><i class="fas fa-paper-plane"></i></button>
      </form>
    </div>
    <div class="pr-chan-doan" id="thu-cd">
      <h3><i class="fas fa-magnifying-glass-chart"></i> Phân tích câu trả lời</h3>
      <p class="nh-card__desc">Gửi một câu để xem bot chọn nguồn nào, độ khớp bao nhiêu và các câu gần nhất trong kho.</p>
    </div>
  </div>

  <div class="nh-card" style="margin-top:22px;">
    <div class="nh-card__header" style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap;">
      <div>
        <h2 class="nh-card__title"><i class="fas fa-clock-rotate-left"></i> Hội thoại gần đây</h2>
        <p class="nh-card__desc">Câu khách hỏi thật và câu bot đã trả lời. Câu trả lời chưa ổn thì bấm <b>Dạy bot</b> để sửa.</p>
      </div>
      <div style="display:flex;gap:8px;align-items:center;">
        <label style="font-size:13px;"><input type="checkbox" id="ht-chi-kh"> Chỉ câu chưa hiểu</label>
        <button class="nh-btn ghost nho" type="button" id="ht-tai"><i class="fas fa-rotate"></i> Tải lại</button>
      </div>
    </div>
    <div class="nh-table-wrap nh-scroll" style="max-height:480px;">
      <table class="nh-table pr-bang">
        <thead><tr><th style="width:120px;">Lúc</th><th>Khách hỏi</th><th>Bot trả lời</th><th style="width:130px;">Nguồn</th><th style="width:50px;"></th><th style="width:100px;"></th></tr></thead>
        <tbody id="ht-ds"></tbody>
      </table>
    </div>
  </div>
</section>

<!-- =========================================================== LIEN HE -->
<section class="qt-tab" data-tab="lien-he">
  <div class="nh-card">
    <div class="nh-card__header">
      <h2 class="nh-card__title"><i class="fas fa-address-book"></i> Khách để lại số điện thoại</h2>
      <p class="nh-card__desc">Khách nhắn số điện thoại trong khung chat (ví dụ khi bot chưa trả lời được, hoặc cần tư vấn tiệc). Gọi lại xong thì đánh dấu đã xử lý.</p>
    </div>
    <div class="nh-table-wrap">
      <table class="nh-table">
        <thead><tr><th style="width:140px;">Lúc</th><th style="width:140px;">Số điện thoại</th><th>Tin nhắn</th><th style="width:130px;">Khách</th><th style="width:150px;">Trạng thái</th></tr></thead>
        <tbody>
          <% if (lienHe && lienHe.length) { lienHe.forEach(function (r) { %>
            <tr data-lh="<%= r.id %>">
              <td><%= new Date(r.tao_luc).toLocaleString('vi-VN') %></td>
              <td><a href="tel:<%= r.sdt %>" style="font-weight:700;color:var(--nh-gold-dark);"><i class="fas fa-phone"></i> <%= r.sdt %></a></td>
              <td><%= r.noi_dung %></td>
              <td><%= r.ten || (r.id_kh ? ('KH #' + r.id_kh) : 'Khách vãng lai') %></td>
              <td><label class="pr-sw" style="border:0;padding:0;"><input type="checkbox" data-xu-ly="<%= r.id %>" <%= r.da_xu_ly ? 'checked' : '' %>><span class="pr-sw__nut"></span><span class="pr-sw__chu"><b style="font-size:12.5px;"><%= r.da_xu_ly ? 'Đã gọi lại' : 'Chờ gọi lại' %></b></span></label></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="5" style="text-align:center;padding:26px;color:var(--nh-muted);">Chưa có khách nào để lại số điện thoại.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- =========================================================== MODAL SUA KIEN THUC -->
<div class="pr-modal" id="md-kt" role="dialog" aria-modal="true" aria-labelledby="md-kt-td">
  <form class="pr-modal__hop" id="form-kt">
    <div class="pr-modal__dau"><h3 id="md-kt-td">Thêm câu hỏi</h3><button type="button" data-dong>&times;</button></div>
    <div class="pr-modal__than">
      <input type="hidden" name="id">
      <input type="hidden" name="nguon">
      <input type="hidden" name="cau_goc">
      <div class="pr-luoi">
        <label class="pr-truong pr-rong"><span>Câu hỏi chính *</span><input class="nh-input" name="cau_hoi" required maxlength="500" placeholder="Ví dụ: Nhà hàng có chỗ đậu ô tô không?"></label>
        <label class="pr-truong"><span>Cách hỏi khác (mỗi dòng một câu)</span><textarea class="nh-input" name="cau_hoi_khac" rows="5" placeholder="gửi xe ở đâu&#10;có bãi đỗ xe hơi không&#10;đậu ô tô được không"></textarea><small>Càng nhiều cách hỏi, bot càng hiểu được câu tương tự.</small></label>
        <div>
          <label class="pr-truong"><span>Từ khóa (cách nhau dấu phẩy)</span><input class="nh-input" name="tu_khoa" placeholder="dau xe, gui xe, o to"><small>Khách nhắc tới từ khóa là bot ưu tiên câu này. Có dấu hay không đều được.</small></label>
          <label class="pr-truong"><span>Nhóm</span><input class="nh-input" name="nhom" list="dl-nhom" placeholder="thong_tin"></label>
          <datalist id="dl-nhom"><% Object.keys(TEN_NHOM).forEach(function (k) { %><option value="<%= k %>"><%= TEN_NHOM[k] %></option><% }) %></datalist>
        </div>
        <label class="pr-truong pr-rong"><span>Câu trả lời *</span><textarea class="nh-input" name="tra_loi" rows="5" required placeholder="Có ạ 🚗 Nhà hàng có bãi đậu ô tô miễn phí…"></textarea>
          <small>Viết nhiều cách trả lời cách nhau bằng <code>||</code> để bot trả lời tự nhiên, không lặp lại. In đậm: <code>**chữ**</code>. Bấm để chèn biến:</small>
          <span class="pr-goi-y-bien" id="kt-bien"><% ['{ten_bot}','{ten_nha_hang}','{hotline}','{dia_chi}','{gio_mo_cua}','{email}','{wifi}','{ten_khach}','{so_mon}','{gia_thap}'].forEach(function (b) { %><code><%= b %></code><% }) %></span>
        </label>
        <label class="pr-truong"><span>Gợi ý câu hỏi tiếp (cách nhau dấu |)</span><input class="nh-input" name="goi_y" placeholder="Đặt bàn|Xem thực đơn"></label>
        <label class="pr-truong"><span>Nút liên kết (Nhãn|đường dẫn ; …)</span><input class="nh-input" name="lien_ket" placeholder="Đặt bàn ngay|/dat-ban"></label>
        <label class="pr-truong"><span>Ảnh đính kèm (đường dẫn, tùy chọn)</span><input class="nh-input" name="anh" placeholder="/images/bai-xe.jpg"></label>
        <div style="display:flex;gap:16px;align-items:center;">
          <label class="pr-truong" style="flex:0 0 110px;"><span>Ưu tiên</span><input class="nh-input" type="number" name="uu_tien" min="-10" max="10" value="0"></label>
          <label class="pr-sw" style="border:0;"><input type="checkbox" name="bat" checked><span class="pr-sw__nut"></span><span class="pr-sw__chu"><b>Đang bật</b></span></label>
        </div>
      </div>
    </div>
    <div class="pr-modal__chan">
      <span class="pr-trai nh-card__desc" id="md-kt-loi" style="color:var(--nh-danger);"></span>
      <button type="button" class="nh-btn ghost" data-dong>Hủy</button>
      <button type="submit" class="nh-btn"><i class="fas fa-floppy-disk"></i> Lưu</button>
    </div>
  </form>
</div>

<!-- =========================================================== MODAL NAP FILE -->
<div class="pr-modal" id="md-nap" role="dialog" aria-modal="true" aria-labelledby="md-nap-td">
  <div class="pr-modal__hop">
    <div class="pr-modal__dau"><h3 id="md-nap-td">Tải tài liệu huấn luyện</h3><button type="button" data-dong>&times;</button></div>
    <div class="pr-modal__than">
      <p class="nh-card__desc" style="margin-top:8px;">
        Chuẩn bị file <b>một bên câu hỏi, một bên câu trả lời</b>. Hỗ trợ <b>Excel (.xlsx, .xls), CSV, Word (.docx)</b>, <b>.txt</b> và <b>.json</b>.
        Câu hỏi trùng với câu đã có thì bot cập nhật câu trả lời mới.
        <a href="/admin/chatbot/kien-thuc.xlsx?mau=1" style="color:var(--nh-gold-dark);font-weight:700;"><i class="fas fa-download"></i> Tải file mẫu Excel</a>
      </p>
      <label class="pr-keo-tha" id="nap-vung">
        <i class="fas fa-cloud-arrow-up"></i>
        <b>Kéo thả file vào đây hoặc bấm để chọn</b>
        <div class="nh-card__desc">Word: bảng 2 cột Hỏi | Đáp, hoặc từng đoạn “Hỏi: … / Đáp: …”. TXT: “Q: … / A: …” hoặc mỗi dòng “câu hỏi | câu trả lời”.</div>
        <input type="file" id="nap-tep" accept=".xlsx,.xls,.csv,.ods,.docx,.txt,.md,.json" hidden>
      </label>
      <div id="nap-ket-qua"></div>
    </div>
    <div class="pr-modal__chan">
      <label class="pr-trai" style="font-size:13px;display:flex;gap:14px;">
        <span><input type="radio" name="nap-che-do" value="them" checked> Thêm mới &amp; cập nhật câu trùng</span>
        <span><input type="radio" name="nap-che-do" value="thay"> Xóa toàn bộ kho cũ rồi nạp</span>
      </label>
      <button type="button" class="nh-btn ghost" data-dong>Hủy</button>
      <button type="button" class="nh-btn" id="nap-xac-nhan" disabled><i class="fas fa-graduation-cap"></i> Huấn luyện ngay</button>
    </div>
  </div>
</div>

<div class="pr-toast" id="pr-toast"></div>

<script>
(function () {
  var TEN_NHOM = <%- JSON.stringify(TEN_NHOM) %>;
  var TEN_NGUON = { y_dinh_ngam: ['Hiểu ý khách', 'pr-the--xanh'], kien_thuc: ['Kho kiến thức', 'pr-the--vang'], thuc_don: ['Thực đơn', 'pr-the--xanh'], ml: ['Mô hình ML', 'pr-the--lam'], goi_y: ['Gợi ý gần đúng', ''], khong_hieu: ['Chưa hiểu', 'pr-the--do'], lien_he: ['Để lại SĐT', 'pr-the--lam'], ngoai_gio: ['Ngoài giờ', ''], tu_cam: ['Từ cấm', 'pr-the--do'], du_phong: ['Dự phòng', 'pr-the--vang'], hinh_anh: ['Ảnh / video', 'pr-the--vang'], tri_nho: ['Nhớ ngữ cảnh', 'pr-the--xanh'], ai: ['AI Claude', 'pr-the--lam'] };
  function $(s, g) { return (g || document).querySelector(s); }
  function $$(s, g) { return Array.prototype.slice.call((g || document).querySelectorAll(s)); }
  function thoat(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function dd(s) { return thoat(s).replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>'); }
  function toast(msg, loi) {
    var t = $('#pr-toast'); t.textContent = msg; t.className = 'pr-toast hien' + (loi ? ' loi' : '');
    clearTimeout(toast._h); toast._h = setTimeout(function () { t.className = 'pr-toast'; }, 2800);
  }
  function api(url, opt) {
    opt = opt || {};
    if (opt.json !== undefined) { opt.method = opt.method || 'POST'; opt.headers = { 'Content-Type': 'application/json' }; opt.body = JSON.stringify(opt.json); }
    return fetch(url, opt).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (d) {
        if (!r.ok || d.ok === false) throw new Error(d.loi || ('Lỗi ' + r.status));
        return d;
      });
    });
  }
  function nguonThe(n) { var t = TEN_NGUON[n] || [n || '—', '']; return '<span class="pr-the ' + t[1] + '">' + thoat(t[0]) + '</span>'; }

  /* ---------------- TABS ---------------- */
  var dsTab = $$('.qt-tabs button');
  function moTab(ten, capNhatUrl) {
    if (!$('.qt-tab[data-tab="' + ten + '"]')) ten = 'tong-quan';
    dsTab.forEach(function (b) { b.classList.toggle('on', b.dataset.tab === ten); });
    $$('.qt-tab').forEach(function (s) { s.classList.toggle('on', s.dataset.tab === ten); });
    if (capNhatUrl !== false) { var u = new URL(location.href); u.searchParams.set('tab', ten); history.replaceState(null, '', u); }
    if (ten === 'kho' && !taiKho.daTai) taiKho();
    if (ten === 'thu' && !taiHoiThoai.daTai) taiHoiThoai();
  }
  dsTab.forEach(function (b) { b.onclick = function () { moTab(b.dataset.tab); }; });
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-sang-tab]'); if (b) moTab(b.dataset.sangTab);
    var d = e.target.closest('[data-day-bot]');
    if (d) moSua(null, { cau_hoi: d.dataset.dayBot, cau_goc: d.dataset.dayBot, nguon: 'hoc', nhom: d.dataset.nhom || '', tu_khoa: d.dataset.tuKhoa || '' });
  });
  moTab(<%- JSON.stringify(tabMo) %>, false);

  /* ---------------- MODAL ---------------- */
  function moModal(id) { $(id).classList.add('mo'); }
  function dongModal(id) { $(id).classList.remove('mo'); }
  $$('.pr-modal').forEach(function (m) {
    m.addEventListener('click', function (e) { if (e.target === m || e.target.closest('[data-dong]')) m.classList.remove('mo'); });
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') $$('.pr-modal.mo').forEach(function (m) { m.classList.remove('mo'); }); });

  /* ---------------- KHO KIEN THUC ---------------- */
  var trangKho = 1, duLieuKho = {};
  function taiKho() {
    taiKho.daTai = true;
    var q = encodeURIComponent($('#kt-tim').value.trim()), nhom = encodeURIComponent($('#kt-nhom').value);
    api('/admin/chatbot/api/kien-thuc?q=' + q + '&nhom=' + nhom + '&trang=' + trangKho).then(function (d) {
      duLieuKho = {};
      var sel = $('#kt-nhom'), giu = sel.value;
      sel.innerHTML = '<option value="">Tất cả nhóm</option>' + d.nhoms.map(function (n) {
        return '<option value="' + thoat(n.nhom) + '">' + thoat(TEN_NHOM[n.nhom] || n.nhom) + ' (' + n.n + ')</option>';
      }).join('');
      sel.value = giu;
      $('#kt-ds').innerHTML = d.rows.length ? d.rows.map(function (r) {
        duLieuKho[r.id] = r;
        var khac = (r.cau_hoi_khac || '').split('\n').filter(Boolean);
        return '<tr>' +
          '<td><input type="checkbox" class="kt-chon" value="' + r.id + '"></td>' +
          '<td><div class="pr-cau">' + thoat(r.cau_hoi) + '</div>' +
            (khac.length ? '<div class="pr-phu">+' + khac.length + ' cách hỏi: ' + thoat(khac.slice(0, 3).join(' · ')) + (khac.length > 3 ? '…' : '') + '</div>' : '') +
            (r.tu_khoa ? '<div class="pr-phu"><i class="fas fa-key"></i> ' + thoat(r.tu_khoa) + '</div>' : '') + '</td>' +
          '<td><div class="pr-tl">' + dd(r.tra_loi.split('||')[0]) + '</div>' + (r.tra_loi.indexOf('||') >= 0 ? '<div class="pr-phu">' + r.tra_loi.split('||').length + ' cách trả lời</div>' : '') + '</td>' +
          '<td><span class="pr-the">' + thoat(TEN_NHOM[r.nhom] || r.nhom) + '</span>' + (r.nguon === 'file' ? '<div class="pr-phu">từ file</div>' : r.nguon === 'hoc' ? '<div class="pr-phu">dạy từ hội thoại</div>' : '') + '</td>' +
          '<td class="so">' + r.so_lan_dung + '</td>' +
          '<td><label class="pr-sw" style="border:0;padding:0;"><input type="checkbox" class="kt-bat" data-id="' + r.id + '"' + (r.bat ? ' checked' : '') + '><span class="pr-sw__nut"></span></label></td>' +
          '<td class="pr-hanh-dong"><button type="button" title="Sửa" data-sua="' + r.id + '"><i class="fas fa-pen"></i></button> <button type="button" title="Xóa" data-xoa="' + r.id + '"><i class="fas fa-trash"></i></button></td>' +
        '</tr>';
      }).join('') : '<tr><td colspan="7" style="text-align:center;padding:26px;color:var(--nh-muted);">Không có câu hỏi nào.</td></tr>';
      $('#kt-tong').textContent = 'Tổng ' + d.tong + ' chủ đề';
      var soTrang = Math.ceil(d.tong / d.moiTrang), h = '';
      if (soTrang > 1) for (var i = 1; i <= soTrang; i++) h += '<button type="button" class="' + (i === d.trang ? 'on' : '') + '" data-trang="' + i + '">' + i + '</button>';
      $('#kt-trang').innerHTML = h;
      $('#kt-chon-het').checked = false; capNhatNutXoa();
    }).catch(function (e) { $('#kt-ds').innerHTML = '<tr><td colspan="7" class="canh-bao">' + thoat(e.message) + '</td></tr>'; });
  }
  var hTim;
  $('#kt-tim').addEventListener('input', function () { clearTimeout(hTim); hTim = setTimeout(function () { trangKho = 1; taiKho(); }, 300); });
  $('#kt-nhom').onchange = function () { trangKho = 1; taiKho(); };
  $('#kt-trang').onclick = function (e) { var b = e.target.closest('[data-trang]'); if (b) { trangKho = Number(b.dataset.trang); taiKho(); } };
  function capNhatNutXoa() { $('#kt-xoa-chon').disabled = !$$('.kt-chon:checked').length; }
  $('#kt-chon-het').onchange = function () { var c = this.checked; $$('.kt-chon').forEach(function (x) { x.checked = c; }); capNhatNutXoa(); };
  $('#kt-ds').addEventListener('change', function (e) {
    if (e.target.classList.contains('kt-chon')) capNhatNutXoa();
    if (e.target.classList.contains('kt-bat')) {
      api('/admin/chatbot/api/kien-thuc/' + e.target.dataset.id + '/bat', { json: { bat: e.target.checked } })
        .then(function () { toast(e.target.checked ? 'Đã bật câu hỏi' : 'Đã tắt câu hỏi'); })
        .catch(function (er) { toast(er.message, true); });
    }
  });
  $('#kt-ds').addEventListener('click', function (e) {
    var s = e.target.closest('[data-sua]'); if (s) moSua(duLieuKho[s.dataset.sua]);
    var x = e.target.closest('[data-xoa]');
    if (x && confirm('Xóa câu hỏi này khỏi kho kiến thức?')) {
      api('/admin/chatbot/api/kien-thuc/xoa', { json: { ids: [Number(x.dataset.xoa)] } }).then(function () { toast('Đã xóa'); taiKho(); });
    }
  });
  $('#kt-xoa-chon').onclick = function () {
    var ids = $$('.kt-chon:checked').map(function (x) { return Number(x.value); });
    if (!ids.length || !confirm('Xóa ' + ids.length + ' câu hỏi đã chọn?')) return;
    api('/admin/chatbot/api/kien-thuc/xoa', { json: { ids: ids } }).then(function (d) { toast('Đã xóa ' + d.so_xoa + ' câu hỏi'); taiKho(); });
  };
  $('#kt-nap-mau').onclick = function () {
    if (!confirm('Nạp lại bộ câu mẫu ngành nhà hàng? Câu mẫu đã bị sửa sẽ được ghi đè bằng bản gốc, câu bạn tự thêm giữ nguyên.')) return;
    api('/admin/chatbot/api/kien-thuc/nap-mau', { method: 'POST' }).then(function (d) { toast('Thêm ' + d.them + ', cập nhật ' + d.cap_nhat + ' câu mẫu'); taiKho(); });
  };
  $('#kt-them').onclick = function () { moSua(null); };

  var formKt = $('#form-kt');
  function moSua(r, macDinh) {
    r = r || {};
    macDinh = macDinh || {};
    formKt.reset();
    $('#md-kt-td').textContent = r.id ? 'Sửa câu hỏi' : (macDinh.nguon === 'hoc' ? 'Dạy bot câu trả lời mới' : 'Thêm câu hỏi');
    ['id', 'cau_hoi', 'cau_hoi_khac', 'tu_khoa', 'nhom', 'tra_loi', 'goi_y', 'lien_ket', 'anh', 'uu_tien', 'nguon', 'cau_goc'].forEach(function (k) {
      var v = r[k] != null ? r[k] : (macDinh[k] != null ? macDinh[k] : '');
      if (k === 'goi_y') v = String(v || '').split('|').join(' | ');
      if (k === 'uu_tien' && v === '') v = 0;
      formKt.elements[k].value = v;
    });
    formKt.elements.bat.checked = r.bat === undefined ? true : !!r.bat;
    $('#md-kt-loi').textContent = '';
    moModal('#md-kt');
    setTimeout(function () { formKt.elements[macDinh.cau_hoi ? 'tra_loi' : 'cau_hoi'].focus(); }, 50);
  }
  window.prMoSuaKienThuc = moSua;
  $('#kt-bien').onclick = function (e) {
    var c = e.target.closest('code'); if (!c) return;
    var ta = formKt.elements.tra_loi, p = ta.selectionStart || ta.value.length;
    ta.value = ta.value.slice(0, p) + c.textContent + ta.value.slice(p); ta.focus();
  };
  formKt.onsubmit = function (e) {
    e.preventDefault();
    var f = formKt.elements, id = f.id.value;
    var du = { cau_hoi: f.cau_hoi.value, cau_hoi_khac: f.cau_hoi_khac.value, tu_khoa: f.tu_khoa.value, nhom: f.nhom.value || 'khac',
      tra_loi: f.tra_loi.value, goi_y: f.goi_y.value, lien_ket: f.lien_ket.value, anh: f.anh.value, uu_tien: f.uu_tien.value,
      bat: f.bat.checked, nguon: f.nguon.value, cau_goc: f.cau_goc.value };
    api(id ? '/admin/chatbot/api/kien-thuc/' + id : '/admin/chatbot/api/kien-thuc', { method: id ? 'PUT' : 'POST', json: du })
      .then(function () {
        dongModal('#md-kt'); toast('Đã lưu, bot học ngay câu này'); taiKho.daTai = false;
        if ($('.qt-tab.on').dataset.tab === 'kho') taiKho();
        // Day tu danh sach tu hoc -> bo dong do khoi bang cho duyet
        if (du.cau_goc) $$('#khung-tu-hoc tr[data-cau]').forEach(function (tr) { if (tr.dataset.cau === du.cau_goc) tr.remove(); });
      })
      .catch(function (er) { $('#md-kt-loi').textContent = er.message; });
  };

  /* ---------------- NAP FILE ---------------- */
  var dongNap = [];
  $('#kt-mo-nap').onclick = function () { dongNap = []; $('#nap-ket-qua').innerHTML = ''; $('#nap-xac-nhan').disabled = true; $('#nap-tep').value = ''; moModal('#md-nap'); };
  var vung = $('#nap-vung');
  ['dragenter', 'dragover'].forEach(function (ev) { vung.addEventListener(ev, function (e) { e.preventDefault(); vung.classList.add('dang-keo'); }); });
  ['dragleave', 'drop'].forEach(function (ev) { vung.addEventListener(ev, function (e) { e.preventDefault(); vung.classList.remove('dang-keo'); }); });
  vung.addEventListener('drop', function (e) { if (e.dataTransfer.files[0]) docTep(e.dataTransfer.files[0]); });
  $('#nap-tep').onchange = function () { if (this.files[0]) docTep(this.files[0]); };
  function docTep(tep) {
    var fd = new FormData(); fd.append('tep', tep);
    $('#nap-ket-qua').innerHTML = '<p class="nh-card__desc"><i class="fas fa-spinner fa-spin"></i> Đang đọc ' + thoat(tep.name) + '…</p>';
    api('/admin/chatbot/api/kien-thuc/doc-file', { method: 'POST', body: fd }).then(function (d) {
      dongNap = d.dong;
      $('#nap-xac-nhan').disabled = false;
      $('#nap-ket-qua').innerHTML = '<p style="margin:14px 0 0;"><b style="color:var(--nh-ok);"><i class="fas fa-circle-check"></i> Đọc được ' + d.so_dong + ' cặp hỏi–đáp</b> từ <i>' + thoat(d.ten) + '</i>. Xem trước:</p>' +
        '<div class="pr-xem-file"><table class="nh-table"><thead><tr><th>#</th><th>Câu hỏi</th><th>Trả lời</th><th>Từ khóa</th></tr></thead><tbody>' +
        d.dong.slice(0, 200).map(function (r, i) { return '<tr><td>' + (i + 1) + '</td><td>' + thoat(r.cau_hoi) + '</td><td>' + dd(String(r.tra_loi).slice(0, 160)) + '</td><td>' + thoat(r.tu_khoa || '') + '</td></tr>'; }).join('') +
        '</tbody></table></div>' + (d.so_dong > 200 ? '<p class="nh-card__desc">… và ' + (d.so_dong - 200) + ' dòng nữa.</p>' : '');
    }).catch(function (e) { $('#nap-ket-qua').innerHTML = '<p class="canh-bao" style="margin-top:12px;"><i class="fas fa-circle-xmark"></i> ' + thoat(e.message) + '</p>'; });
  }
  $('#nap-xac-nhan').onclick = function () {
    var cheDo = ($('input[name="nap-che-do"]:checked') || {}).value;
    if (cheDo === 'thay' && !confirm('Xóa TOÀN BỘ kho kiến thức hiện tại rồi nạp file này?')) return;
    var b = this; b.disabled = true; b.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang huấn luyện…';
    api('/admin/chatbot/api/kien-thuc/nap', { json: { dong: dongNap, che_do: cheDo } }).then(function (d) {
      dongModal('#md-nap');
      toast('Đã học ' + d.them + ' câu mới, cập nhật ' + d.cap_nhat + ' câu' + (d.bo_qua ? ', bỏ qua ' + d.bo_qua + ' dòng thiếu dữ liệu' : ''));
      trangKho = 1; taiKho();
    }).catch(function (e) { toast(e.message, true); })
      .then(function () { b.disabled = false; b.innerHTML = '<i class="fas fa-graduation-cap"></i> Huấn luyện ngay'; });
  };

  /* ---------------- THIET LAP ---------------- */
  var formTl = $('#form-tl');
  function docForm() {
    var o = {};
    $$('input, select, textarea', formTl).forEach(function (el) {
      if (!el.name) return;
      if (el.type === 'checkbox') o[el.name] = el.checked;
      else if (el.type === 'number' || el.type === 'range') o[el.name] = Number(el.value);
      else o[el.name] = el.value;
    });
    return o;
  }
  function xemTruoc() {
    var o = docForm();
    var ten = o.ten_bot || 'Trợ lý';
    var doiXh = function (s) {
      if (o.xung_ho === 'minh_ban') return s;
      var k = o.xung_ho === 'em_quykhach' ? ['quý khách', 'Quý khách'] : ['anh/chị', 'Anh/chị'];
      return s.replace(/(^|[^\p{L}])mình(?![\p{L}])/gu, '$1em').replace(/(^|[^\p{L}])Mình(?![\p{L}])/gu, '$1Em')
        .replace(/(^|[^\p{L}])bạn(?![\p{L}])/gu, '$1' + k[0]).replace(/(^|[^\p{L}])Bạn(?![\p{L}])/gu, '$1' + k[1]);
    };
    var chao = String(o.loi_chao || '').replace(/\{ten_bot\}/g, ten).replace(/\{ten_nha_hang\}/g, o.ten_nha_hang || '')
      .replace(/\{ten_khach\}/g, 'bạn').replace(/\{hotline\}/g, o.hotline || '').replace(/bạn bạn/g, 'bạn');
    chao = doiXh(chao);
    if (!o.dung_emoji) chao = chao.replace(/[\p{Extended_Pictographic}️‍]/gu, '');
    $('#xt-ten').textContent = ten;
    $('#xt-cd').textContent = o.chuc_danh || '';
    $('#xt-chao').innerHTML = dd(chao);
    $('#xt-av').innerHTML = o.avatar ? '<img src="' + thoat(o.avatar) + '" alt="">' : '<img src="/tro-ly-ao.svg" alt="">';
  }
  formTl.addEventListener('input', function (e) {
    if (e.target.type === 'range') { var b = $('[data-gia-tri="' + e.target.name + '"]'); if (b) b.textContent = e.target.value; }
    $('#tl-trang-thai').innerHTML = '<b style="color:var(--nh-warn)">Có thay đổi chưa lưu</b>';
    xemTruoc();
  });
  formTl.addEventListener('change', xemTruoc);
  xemTruoc();
  formTl.onsubmit = function (e) {
    e.preventDefault();
    api('/admin/chatbot/api/thiet-lap', { json: docForm() }).then(function () {
      $('#tl-trang-thai').innerHTML = '<b style="color:var(--nh-ok)"><i class="fas fa-circle-check"></i> Đã lưu lúc ' + new Date().toLocaleTimeString('vi-VN') + '. Khách tải lại trang là thấy thay đổi.</b>';
      toast('Đã lưu thiết lập trợ lý ảo');
    }).catch(function (er) { toast(er.message, true); });
  };
  $('#tl-mac-dinh').onclick = function () {
    if (!confirm('Khôi phục toàn bộ thiết lập về mặc định?')) return;
    api('/admin/chatbot/api/thiet-lap/mac-dinh', { method: 'POST' }).then(function () { location.href = '/admin/chatbot?tab=thiet-lap'; });
  };
  /* ---------------- AI CLAUDE ---------------- */
  function aiBao(html) { $('#ai-trang-thai').innerHTML = html; }
  if ($('#ai-luu-khoa')) $('#ai-luu-khoa').onclick = function () {
    var k = $('#ai-khoa').value.trim();
    if (!k) { toast('Nhập khóa API trước đã', true); return; }
    api('/admin/chatbot/api/ai-khoa', { json: { khoa: k } }).then(function (d) {
      $('#ai-khoa').value = ''; $('#ai-khoa').placeholder = d.trang_thai.khoa_an + ' (đã lưu - nhập khóa mới để thay)';
      aiBao('<b style="color:var(--nh-ok)">Đã lưu khóa</b> ' + thoat(d.trang_thai.khoa_an) + '. Bấm “Kiểm tra kết nối” để thử.');
      toast('Đã lưu khóa API');
    }).catch(function (e) { toast(e.message, true); });
  };
  if ($('#ai-xoa-khoa')) $('#ai-xoa-khoa').onclick = function () {
    if (!confirm('Xóa khóa API Claude? Bot sẽ ngừng dùng AI.')) return;
    api('/admin/chatbot/api/ai-khoa', { json: { khoa: '' } }).then(function () { location.href = '/admin/chatbot?tab=thiet-lap'; });
  };
  if ($('#ai-kiem-tra')) $('#ai-kiem-tra').onclick = function () {
    var b = this; b.disabled = true; aiBao('<i class="fas fa-spinner fa-spin"></i> Đang hỏi thử AI…');
    api('/admin/chatbot/api/ai-kiem-tra', { method: 'POST' }).then(function (d) {
      aiBao(d.ok ? '<b style="color:var(--nh-ok)"><i class="fas fa-circle-check"></i> Kết nối tốt.</b> AI trả lời thử: “' + dd(d.tra_loi) + '”'
        : '<b style="color:var(--nh-danger)"><i class="fas fa-circle-xmark"></i> ' + thoat(d.loi) + '</b>');
    }).catch(function (e) { aiBao('<b style="color:var(--nh-danger)">' + thoat(e.message) + '</b>'); })
      .then(function () { b.disabled = false; });
  };

  $$('.pr-tl__menu a').forEach(function (a) {
    a.onclick = function (e) { e.preventDefault(); var el = $(a.getAttribute('href')); if (el) window.scrollTo({ top: el.getBoundingClientRect().top + scrollY - 90, behavior: 'smooth' }); };
  });

  /* ---------------- THU NGHIEM ---------------- */
  var thuThan = $('#thu-than');
  function thuTin(vai, html) {
    var d = document.createElement('div'); d.className = 'pr-tn pr-tn--' + vai; d.innerHTML = html; thuThan.appendChild(d); thuThan.scrollTop = thuThan.scrollHeight; return d;
  }
  $('#thu-anh').onclick = function () { $('#thu-tep').click(); };
  $('#thu-tep').onchange = function () {
    var tep = this.files && this.files[0]; this.value = '';
    if (!tep) return;
    var url = URL.createObjectURL(tep); var im = new Image();
    im.onload = function () {
      var tl = Math.min(1, 1280 / Math.max(im.naturalWidth, im.naturalHeight));
      var c = document.createElement('canvas'); c.width = Math.round(im.naturalWidth * tl); c.height = Math.round(im.naturalHeight * tl);
      c.getContext('2d').drawImage(im, 0, 0, c.width, c.height); URL.revokeObjectURL(url);
      thuHoi($('#thu-o').value, c.toDataURL('image/jpeg', 0.85));
    };
    im.src = url;
  };
  function thuHoi(cau, anh) {
    cau = String(cau || '').trim(); if (!cau && !anh) return;
    thuTin('toi', '<div class="pr-tn__noi">' + (anh ? '<img src="' + anh + '" alt="" style="max-width:180px;border-radius:10px;display:block;margin-bottom:' + (cau ? 6 : 0) + 'px;">' : '') + thoat(cau) + '</div>');
    $('#thu-o').value = '';
    var cho = thuTin('bot', '<div class="pr-tn__noi"><i class="fas fa-ellipsis fa-fade"></i></div>');
    var goi = anh
      ? api('/admin/chatbot/api/thu-tep', { json: { anh: [anh], loai: 'anh', cau_hoi: cau, ten_khach: $('#thu-ten').value } })
      : api('/admin/chatbot/api/thu', { json: { cau_hoi: cau, vai_tro: $('#thu-vai').value, ten_khach: $('#thu-ten').value } });
    goi.then(function (d) {
      if (anh) cau = '[Ảnh]' + (cau ? ' ' + cau : '');
      var h = '<div class="pr-tn__noi">' + dd(d.van_ban || '') + '</div>';
      if (d.mon && d.mon.length) h += '<div class="pr-mon-nho">' + d.mon.map(function (m) { return '<div><img src="' + thoat(m.anh || '/mon-thay-the.svg') + '" alt=""><p><b>' + thoat(m.ten) + '</b><br>' + Number(m.gia).toLocaleString('vi-VN') + 'đ</p></div>'; }).join('') + '</div>';
      if (d.lien_ket && d.lien_ket.length) h += '<div class="pr-goi-y-nho">' + d.lien_ket.map(function (l) { return '<span class="pr-the"><i class="fas fa-link"></i> ' + thoat(l.nhan) + '</span>'; }).join('') + '</div>';
      if (d.goi_y && d.goi_y.length) h += '<div class="pr-goi-y-nho">' + d.goi_y.map(function (g) { var c = typeof g === 'object' ? g.cau_hoi : g; return '<button type="button" data-cau="' + thoat(c) + '">' + thoat(typeof g === 'object' ? g.nhan : g) + '</button>'; }).join('') + '</div>';
      h += '<div class="pr-tn__meta">' + nguonThe(d.nguon) + (d.tin_cay != null ? ' khớp ' + Math.round(d.tin_cay * 100) + '%' : '') + ' · ' + (d.thoi_gian_ms || 0) + ' ms</div>';
      cho.innerHTML = h;
      thuThan.scrollTop = thuThan.scrollHeight;
      var cd = '<h3><i class="fas fa-magnifying-glass-chart"></i> Phân tích câu trả lời</h3><dl>' +
        '<dt>Câu hỏi</dt><dd>' + thoat(cau) + '</dd>' +
        '<dt>Nguồn</dt><dd>' + nguonThe(d.nguon) + '</dd>' +
        '<dt>Ý định</dt><dd><code>' + thoat(d.y_dinh || '—') + '</code></dd>' +
        '<dt>Độ khớp</dt><dd>' + (d.tin_cay != null ? Math.round(d.tin_cay * 100) + '%' : '—') + '</dd>' +
        (d.khop_cau ? '<dt>Khớp với</dt><dd>“' + thoat(d.khop_cau) + '”</dd>' : '') +
        (d.tu_khoa_khop && d.tu_khoa_khop.length ? '<dt>Từ khóa bắt được</dt><dd>' + d.tu_khoa_khop.map(function (k) { return '<span class="pr-the pr-the--vang">' + thoat(k) + '</span>'; }).join(' ') + '</dd>' : '') +
        (d.mon && d.mon.length ? '<dt>Món gửi</dt><dd>' + d.mon.map(function (m) { return thoat(m.ten); }).join(', ') + '</dd>' : '') +
        '<dt>Thời gian</dt><dd>' + (d.thoi_gian_ms || 0) + ' ms</dd></dl>';
      if (d.ung_vien && d.ung_vien.length) {
        cd += '<div class="pr-uv"><div class="pr-nho" style="border:0;">Câu gần nhất trong kho</div>' + d.ung_vien.map(function (u) {
          return '<div><span>' + thoat(u.cau_hoi) + '<br><small style="color:var(--nh-muted)">qua: “' + thoat(u.khop) + '”</small></span><b>' + Math.round(u.diem * 100) + '%</b></div>';
        }).join('') + '</div>';
      }
      cd += '<div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap;"><button type="button" class="nh-btn nho" data-day-bot="' + thoat(cau) + '"><i class="fas fa-graduation-cap"></i> Dạy bot trả lời câu này</button></div>';
      $('#thu-cd').innerHTML = cd;
    }).catch(function (e) { cho.innerHTML = '<div class="pr-tn__noi canh-bao">' + thoat(e.message) + '</div>'; });
  }
  $('#thu-form').onsubmit = function (e) { e.preventDefault(); thuHoi($('#thu-o').value); };
  thuThan.addEventListener('click', function (e) { var b = e.target.closest('[data-cau]'); if (b) thuHoi(b.dataset.cau); });
  $('#thu-moi').onclick = function () { fetch('/admin/chatbot/api/thu/lam-moi', { method: 'POST' }); thuThan.innerHTML = ''; };

  function taiHoiThoai() {
    taiHoiThoai.daTai = true;
    api('/admin/chatbot/api/hoi-thoai?khong_hieu=' + ($('#ht-chi-kh').checked ? 1 : 0)).then(function (ds) {
      $('#ht-ds').innerHTML = ds.length ? ds.map(function (r) {
        var nguon = r.nguon || (r.khong_hieu ? 'khong_hieu' : 'ml');
        return '<tr><td style="font-size:12px;color:var(--nh-muted)">' + new Date(r.tao_luc).toLocaleString('vi-VN') + (r.quyen === 'quan_ly' ? '<br><span class="pr-the">quản lý</span>' : '') + '</td>' +
          '<td>' + (r.tep ? '<a href="' + thoat(r.tep) + '" target="_blank"><img src="' + thoat(r.tep) + '" alt="" style="width:64px;height:64px;object-fit:cover;border-radius:8px;display:block;margin-bottom:4px;"></a>' : '') + '<b>' + thoat(r.cau_hoi) + '</b></td>' +
          '<td><div class="pr-tl">' + dd(r.tra_loi || (r.y_dinh ? '(' + r.y_dinh + ')' : '—')) + '</div></td>' +
          '<td>' + nguonThe(nguon) + (r.tin_cay != null ? '<div class="pr-phu">' + Math.round(r.tin_cay * 100) + '%</div>' : '') + '</td>' +
          '<td>' + (r.huu_ich === 1 ? '👍' : r.huu_ich === 0 ? '👎' : '') + '</td>' +
          '<td style="text-align:right;"><button type="button" class="nh-btn ghost pr-nho-btn" data-day-bot="' + thoat(r.cau_hoi) + '">Dạy bot</button></td></tr>';
      }).join('') : '<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--nh-muted)">Chưa có hội thoại.</td></tr>';
    });
  }
  $('#ht-tai').onclick = taiHoiThoai;
  $('#ht-chi-kh').onchange = taiHoiThoai;

  /* ---------------- LIEN HE ---------------- */
  document.addEventListener('change', function (e) {
    var c = e.target.closest('[data-xu-ly]'); if (!c) return;
    api('/admin/chatbot/api/lien-he/' + c.dataset.xuLy, { json: { da_xu_ly: c.checked } }).then(function () {
      c.parentNode.querySelector('b').textContent = c.checked ? 'Đã gọi lại' : 'Chờ gọi lại';
    });
  });
})();
</script>
