<%
  /*
    Cac tab moi cua trang /admin/chatbot (tro ly kieu Preny AI):
      kho        - kho kien thuc hoi/dap: them/sua/xoa, nap file Excel/Word/CSV/TXT, xuat Excel
      thiet-lap  - toan bo thiet lap: tinh cach, bo nao, giao dien chat, gio hoat dong, thu SDT...
      thu        - khung chat thu nghiem (gia lap khach / quan ly) + nhat ky hoi thoai
      lien-he    - khach de lai so dien thoai trong khung chat
  */
  const tl = thietLap;
  const sw = (k, nhan, moTa) => `<label class="pr-sw"><input type="checkbox" name="${k}" ${tl[k] ? 'checked' : ''}><span class="pr-sw__nut"></span><span class="pr-sw__chu"><b>${nhan}</b>${moTa ? `<small>${moTa}</small>` : ''}</span></label>`;
  const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const chu = (k, nhan, moTa, ph) => `<label class="pr-truong"><span>${nhan}</span><input class="nh-input" name="${k}" value="${esc(tl[k])}" placeholder="${esc(ph || '')}">${moTa ? `<small>${moTa}</small>` : ''}</label>`;
  const vung = (k, nhan, moTa, dong) => `<label class="pr-truong"><span>${nhan}</span><textarea class="nh-input" name="${k}" rows="${dong || 3}">${esc(Array.isArray(tl[k]) ? tl[k].join('\n') : tl[k])}</textarea>${moTa ? `<small>${moTa}</small>` : ''}</label>`;
  const so = (k, nhan, moTa, min, max, buoc) => `<label class="pr-truong"><span>${nhan}</span><input class="nh-input" type="number" name="${k}" value="${esc(tl[k])}" min="${min}" max="${max}" step="${buoc || 1}">${moTa ? `<small>${moTa}</small>` : ''}</label>`;
  const truot = (k, nhan, moTa, min, max, buoc) => `<label class="pr-truong"><span>${nhan}: <b data-gia-tri="${k}">${tl[k]}</b></span><input type="range" name="${k}" value="${tl[k]}" min="${min}" max="${max}" step="${buoc}" class="pr-truot">${moTa ? `<small>${moTa}</small>` : ''}</label>`;
  const chon = (k, nhan, ds, moTa) => `<label class="pr-truong"><span>${nhan}</span><select class="nh-input" name="${k}">${ds.map(([v, t]) => `<option value="${v}" ${String(tl[k]) === v ? 'selected' : ''}>${t}</option>`).join('')}</select>${moTa ? `<small>${moTa}</small>` : ''}</label>`;
  const TEN_NHOM = { chao_hoi: 'Chào hỏi', thong_tin: 'Thông tin quán', dat_ban: 'Đặt bàn', dat_tiec: 'Đặt tiệc', thuc_don: 'Thực đơn', giao_hang: 'Giao hàng', thanh_toan: 'Thanh toán', khuyen_mai: 'Khuyến mãi', tai_khoan: 'Tài khoản', gop_y: 'Góp ý', khac: 'Khác' };
%>
<style>
  .qt-tabs { display:flex; gap:6px; flex-wrap:wrap; margin: 0 0 22px; border-bottom: 1px solid var(--nh-line); }
  .qt-tabs button {
    border:0; background:none; padding: 11px 16px; font: 600 14px var(--nh-sans); color: var(--nh-muted); cursor:pointer;
    border-bottom: 3px solid transparent; margin-bottom:-1px; display:inline-flex; align-items:center; gap:8px; border-radius: 8px 8px 0 0;
  }
  .qt-tabs button:hover { color: var(--nh-ink); background: var(--nh-cream-2); }
  .qt-tabs button.on { color: var(--nh-espresso); border-bottom-color: var(--nh-gold); }
  .qt-tabs button .pr-so { background: var(--nh-danger); color:#fff; border-radius:999px; font-size:11px; padding: 1px 7px; }
  .qt-tab { display:none; }
  .qt-tab.on { display:block; animation: prHien .2s ease; }
  @keyframes prHien { from { opacity:0; transform: translateY(4px);} to { opacity:1; transform:none; } }

  .pr-thanh-ds { display:flex; flex-direction:column; gap:12px; }
  .pr-thanh__nhan { display:flex; justify-content:space-between; font-size:13px; margin-bottom:5px; }
  .pr-thanh__nhan i { display:inline-block; width:9px; height:9px; border-radius:3px; margin-right:7px; }
  .pr-thanh__nen { height:8px; background: var(--nh-line-soft); border-radius:99px; overflow:hidden; }
  .pr-thanh__nen div { height:100%; border-radius:99px; }
  .pr-so-kho { display:grid; grid-template-columns: repeat(4, 1fr); gap:10px; }
  .pr-so-kho div { background: var(--nh-cream); border:1px solid var(--nh-line); border-radius:10px; padding:10px; text-align:center; }
  .pr-so-kho b { display:block; font: 800 22px var(--nh-sans); color: var(--nh-espresso); }
  .pr-so-kho span { font-size:11.5px; color: var(--nh-muted); }
  .pr-nho { font-size:12px; color: var(--nh-muted); font-weight:700; text-transform:uppercase; letter-spacing:.5px; }
  .pr-top { margin:0; padding-left:20px; font-size:13px; }
  .pr-top li { padding: 3px 0; }
  .pr-top li span { display:inline-block; max-width: 80%; }
  .pr-top li b { float:right; color: var(--nh-gold-dark); }
  .pr-the { display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:700; background:#f2ece1; color: var(--nh-espresso); }
  .pr-the--do { background:#fee2e2; color:#991b1b; }
  .pr-the--xanh { background: var(--nh-ok-bg); color: var(--nh-ok); }
  .pr-the--lam { background: var(--nh-info-bg); color: var(--nh-info); }
  .pr-the--vang { background: var(--nh-warn-bg); color: var(--nh-warn); }
  .pr-nho-btn { padding: 6px 11px !important; font-size: 12px !important; white-space: nowrap; }
  .nh-btn.do { background: var(--nh-danger); }
  .pr-hoc-bao { display:inline-flex; gap:8px; align-items:center; margin-top:8px; background: var(--nh-ok-bg); color: var(--nh-ok); border:1px solid var(--nh-ok-border); border-radius:8px; padding:6px 12px; font-size:13px; }
  .pr-lk-hoc { color: var(--nh-gold-dark); font-weight:600; }
  .pr-da-hoc { margin-top: 14px; border-top: 1px dashed var(--nh-line); padding-top: 12px; }
  .pr-da-hoc summary { cursor:pointer; font-weight:700; font-size:13.5px; color: var(--nh-muted); }
  .nh-btn.nho { padding: 7px 12px; font-size: 12.5px; }

  /* Kho kien thuc */
  .pr-thanh-cu { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:14px; }
  .pr-thanh-cu .nh-input { flex: 1 1 220px; }
  .pr-thanh-cu select.nh-input { flex: 0 0 170px; }
  .pr-bang td { vertical-align: top; }
  .pr-bang .pr-cau { font-weight:700; color: var(--nh-ink); }
  .pr-bang .pr-phu { font-size:12px; color: var(--nh-muted); margin-top:3px; }
  .pr-bang .pr-tl { font-size:12.5px; color:#4a3d33; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; max-width: 420px; }
  .pr-hanh-dong { white-space:nowrap; text-align:right; }
  .pr-hanh-dong button { border:1px solid var(--nh-line); background:#fff; border-radius:7px; width:30px; height:30px; cursor:pointer; color: var(--nh-muted); }
  .pr-hanh-dong button:hover { color: var(--nh-espresso); border-color: var(--nh-gold); }
  .pr-trang { display:flex; gap:6px; justify-content:center; margin-top:14px; flex-wrap:wrap; }
  .pr-trang button { min-width:34px; height:32px; border:1px solid var(--nh-line); background:#fff; border-radius:7px; cursor:pointer; }
  .pr-trang button.on { background: var(--nh-gold); color:#241a14; border-color: var(--nh-gold); font-weight:700; }
  .pr-keo-tha { display:block; margin-top: 12px; border:2px dashed #d9c9a8; border-radius:12px; padding:22px; text-align:center; background:#fffdf8; cursor:pointer; transition: all .2s; }
  .pr-keo-tha.dang-keo, .pr-keo-tha:hover { border-color: var(--nh-gold); background: #fbf3e2; }
  .pr-keo-tha i { font-size: 30px; color: var(--nh-gold); display:block; margin-bottom:8px; }

  /* Switch */
  .pr-sw { display:flex; gap:12px; align-items:flex-start; cursor:pointer; padding: 10px 0; border-bottom: 1px dashed var(--nh-line-soft); }
  .pr-sw input { position:absolute; opacity:0; pointer-events:none; }
  .pr-sw__nut { flex-shrink:0; width:42px; height:24px; border-radius:99px; background:#d6cfc5; position:relative; transition: background .2s; margin-top:1px; }
  .pr-sw__nut::after { content:""; position:absolute; top:3px; left:3px; width:18px; height:18px; border-radius:50%; background:#fff; transition: transform .2s; box-shadow: 0 1px 3px rgba(0,0,0,.25); }
  .pr-sw input:checked + .pr-sw__nut { background: var(--nh-ok); }
  .pr-sw input:checked + .pr-sw__nut::after { transform: translateX(18px); }
  .pr-sw input:focus-visible + .pr-sw__nut { outline: 2px solid var(--nh-gold); outline-offset: 2px; }
  .pr-sw__chu b { display:block; font-size:13.5px; }
  .pr-sw__chu small { display:block; font-size:12px; color: var(--nh-muted); margin-top:2px; line-height:1.45; }

  /* Form thiet lap */
  .pr-tl { display:grid; grid-template-columns: 220px 1fr; gap: 22px; align-items:start; }
  .pr-tl__menu { position: sticky; top: 100px; display:flex; flex-direction:column; gap:3px; }
  .pr-tl__menu a { padding:9px 12px; border-radius:8px; color: var(--nh-muted); text-decoration:none; font-weight:600; font-size:13.5px; display:flex; gap:9px; align-items:center; }
  .pr-tl__menu a:hover { background: var(--nh-cream-2); color: var(--nh-ink); }
  .pr-tl__menu a i { width:16px; text-align:center; color: var(--nh-gold-dark); }
  .pr-luoi { display:grid; grid-template-columns: 1fr 1fr; gap: 4px 18px; }
  .pr-luoi .pr-rong { grid-column: 1 / -1; }
  .pr-truong { display:flex; flex-direction:column; gap:5px; padding: 8px 0; }
  .pr-truong > span { font-weight:700; font-size:13px; }
  .pr-truong small { font-size:12px; color: var(--nh-muted); line-height:1.45; }
  .pr-truong .nh-input { flex: none; width: 100%; }
  .pr-truong textarea { resize: vertical; min-height: 60px; font-family: inherit; line-height: 1.5; }
  .pr-truot { accent-color: var(--nh-gold-dark); width:100%; }
  .pr-luu {
    position: sticky; bottom: 0; z-index: 20; display:flex; gap:10px; align-items:center; justify-content:flex-end;
    background: rgba(251,248,244,.96); backdrop-filter: blur(6px); border-top:1px solid var(--nh-line);
    padding: 12px 0; margin-top: 10px;
  }
  .pr-luu span { margin-right:auto; font-size:13px; color: var(--nh-muted); }
  .pr-xem-truoc { background: linear-gradient(180deg,#fbf8f2,#f4eee2); border:1px solid var(--nh-line); border-radius: 14px; padding: 14px; }
  .pr-xem-truoc__dau { display:flex; gap:10px; align-items:center; background:#2b1a12; color:#faf6ef; border-radius:10px; padding:10px 12px; margin-bottom:12px; }
  .pr-xem-truoc__dau .av { width:34px; height:34px; border-radius:50%; background: linear-gradient(135deg,#d4af37,#9a6f20); color:#24140b; display:flex; align-items:center; justify-content:center; overflow:hidden; }
  .pr-xem-truoc__dau .av img { width:100%; height:100%; object-fit:cover; }
  .pr-xem-truoc__dau b { color:#dfb962; font-family: var(--nh-serif); display:block; }
  .pr-xem-truoc__dau small { color:#e5dacd; font-size:11.5px; }
  .pr-xem-truoc__tn { background:#fff; border:1px solid rgba(200,162,75,.25); border-radius:14px 14px 14px 4px; padding:10px 13px; font-size:13px; white-space:pre-wrap; line-height:1.55; }

  /* Thu nghiem */
  .pr-thu { display:grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 18px; }
  .pr-chat { border:1px solid var(--nh-line); border-radius:14px; overflow:hidden; display:flex; flex-direction:column; height: 560px; background:#fff; }
  .pr-chat__dau { padding: 10px 14px; background: var(--nh-espresso); color: #fff; display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  .pr-chat__dau select, .pr-chat__dau input { background: rgba(255,255,255,.1); color:#fff; border:1px solid rgba(255,255,255,.25); border-radius:7px; padding:5px 8px; font: 13px var(--nh-sans); }
  .pr-chat__dau select option { color:#000; }
  .pr-chat__than { flex:1; overflow-y:auto; padding: 14px; background: linear-gradient(180deg,#fbf8f2,#f4eee2); }
  .pr-chat__chan { display:flex; gap:8px; padding: 10px; border-top:1px solid var(--nh-line); }
  .pr-tn { margin-bottom: 12px; display:flex; flex-direction:column; }
  .pr-tn--toi { align-items:flex-end; }
  .pr-tn__noi { max-width: 85%; padding: 9px 13px; border-radius: 14px; white-space: pre-wrap; font-size: 13.5px; line-height:1.55; }
  .pr-tn--toi .pr-tn__noi { background: var(--nh-gold); color:#241a14; border-bottom-right-radius:4px; }
  .pr-tn--bot .pr-tn__noi { background:#fff; border:1px solid var(--nh-line); border-bottom-left-radius:4px; }
  .pr-tn__meta { font-size: 11.5px; color: var(--nh-muted); margin-top: 5px; display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
  .pr-mon-nho { display:flex; gap:8px; overflow-x:auto; margin-top:8px; }
  .pr-mon-nho div { flex: 0 0 120px; border:1px solid var(--nh-line); border-radius:10px; overflow:hidden; font-size:11.5px; background:#fff; }
  .pr-mon-nho img { width:100%; height:80px; object-fit:cover; display:block; background:#f3ece0; }
  .pr-mon-nho p { margin:5px 7px; line-height:1.35; }
  .pr-goi-y-nho { display:flex; flex-wrap:wrap; gap:5px; margin-top:7px; }
  .pr-goi-y-nho button { border:1px solid #dcc9a2; background:#fff; border-radius:99px; padding:4px 10px; font-size:12px; cursor:pointer; }
  .pr-chan-doan { border:1px solid var(--nh-line); border-radius:14px; padding: 14px; background:#fff; height:560px; overflow:auto; }
  .pr-chan-doan h3 { margin: 0 0 10px; font-size: 14px; }
  .pr-chan-doan dl { margin:0; display:grid; grid-template-columns: 110px 1fr; gap: 6px 10px; font-size: 13px; }
  .pr-chan-doan dt { color: var(--nh-muted); }
  .pr-chan-doan dd { margin:0; font-weight:600; word-break: break-word; }
  .pr-uv { margin-top: 14px; }
  .pr-uv div { display:flex; justify-content:space-between; gap:10px; padding:7px 0; border-bottom:1px dashed var(--nh-line); font-size:12.5px; }
  .pr-uv b { color: var(--nh-gold-dark); }

  /* Modal */
  .pr-modal { position:fixed; inset:0; background: rgba(20,12,8,.55); z-index: 1000; display:none; align-items:flex-start; justify-content:center; padding: 40px 16px; overflow-y:auto; }
  .pr-modal.mo { display:flex; }
  .pr-modal__hop { background:#fff; border-radius:16px; width: 100%; max-width: 860px; box-shadow: 0 30px 80px rgba(0,0,0,.35); }
  .pr-modal__dau { display:flex; justify-content:space-between; align-items:center; padding: 16px 22px; border-bottom:1px solid var(--nh-line); }
  .pr-modal__dau h3 { margin:0; font: 700 18px var(--nh-serif); }
  .pr-modal__dau button { border:0; background:none; font-size: 24px; cursor:pointer; color: var(--nh-muted); }
  .pr-modal__than { padding: 8px 22px 6px; }
  .pr-modal__chan { display:flex; justify-content:flex-end; gap:10px; padding: 14px 22px; border-top:1px solid var(--nh-line); align-items:center; }
  .pr-modal__chan .pr-trai { margin-right:auto; }
  .pr-xem-file { max-height: 360px; overflow:auto; border:1px solid var(--nh-line); border-radius:10px; margin-top:12px; }
  .pr-goi-y-bien { display:flex; flex-wrap:wrap; gap:5px; margin-top:4px; }
  .pr-goi-y-bien code { background:#f2ece1; border-radius:5px; padding:2px 6px; font-size:11.5px; cursor:pointer; }

  .pr-toast { position: fixed; right: 20px; bottom: 20px; z-index: 2000; background: var(--nh-espresso); color:#fff; padding: 12px 18px; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,.3); font-size: 13.5px; transform: translateY(120%); transition: transform .25s; }
  .pr-toast.hien { transform: none; }
  .pr-toast.loi { background: var(--nh-danger); }

  @media (max-width: 1000px) {
    .pr-tl, .pr-thu { grid-template-columns: 1fr; }
    .pr-tl__menu { position: static; flex-direction: row; flex-wrap: wrap; }
    .pr-luoi { grid-template-columns: 1fr; }
    .pr-so-kho { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<!-- =========================================================== KHO KIEN THUC -->
<section class="qt-tab" data-tab="kho">
  <div class="nh-card">
    <div class="nh-card__header">
      <h2 class="nh-card__title"><i class="fas fa-book"></i> Kho kiến thức hỏi – đáp</h2>
      <p class="nh-card__desc">
        Mỗi chủ đề gồm <b>câu hỏi</b>, các <b>cách hỏi khác</b> và <b>từ khóa</b>. Bot so khớp câu khách với tất cả những thứ này, nên khách hỏi
        kiểu khác, viết tắt hay gõ không dấu bot vẫn hiểu. Hỏi về món ăn thì bot tự tra thực đơn và gửi kèm ảnh, không cần nhập ở đây.
      </p>
    </div>
    <div class="pr-thanh-cu">
      <input class="nh-input" id="kt-tim" placeholder="Tìm câu hỏi, từ khóa, câu trả lời…">
      <select class="nh-input" id="kt-nhom"><option value="">Tất cả nhóm</option></select>
      <button class="nh-btn" type="button" id="kt-them"><i class="fas fa-plus"></i> Thêm câu hỏi</button>
      <button class="nh-btn ghost" type="button" id="kt-mo-nap"><i class="fas fa-file-arrow-up"></i> Tải file huấn luyện</button>
      <a class="nh-btn ghost" href="/admin/chatbot/kien-thuc.xlsx"><i class="fas fa-file-excel"></i> Xuất Excel</a>
    </div>
    <div class="nh-table-wrap">
      <table class="nh-table pr-bang">
        <thead><tr><th style="width:36px;"><input type="checkbox" id="kt-chon-het"></th><th>Câu hỏi &amp; cách hỏi</th><th>Trả lời</th><th style="width:110px;">Nhóm</th><th class="so" style="width:70px;">Đã dùng</th><th style="width:60px;">Bật</th><th style="width:80px;"></th></tr></thead>
        <tbody id="kt-ds"><tr><td colspan="7" style="text-align:center;padding:24px;color:var(--nh-muted)"><i class="fas fa-spinner fa-spin"></i> Đang tải…</td></tr></tbody>
      </table>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:10px;flex-wrap:wrap;gap:8px;">
      <div>
        <button class="nh-btn do nho" type="button" id="kt-xoa-chon" disabled><i class="fas fa-trash"></i> Xóa mục đã chọn</button>
        <button class="nh-btn ghost nho" type="button" id="kt-nap-mau"><i class="fas fa-wand-magic-sparkles"></i> Nạp lại bộ câu mẫu ngành nhà hàng</button>
      </div>
      <span class="nh-card__desc" id="kt-tong"></span>
    </div>
    <div class="pr-trang" id="kt-trang"></div>
  </div>
</section>

<!-- =========================================================== HIEU Y KHACH -->
<%
  const dsYD = (typeof yDinhNgam !== 'undefined' && yDinhNgam) || [];
  const TEN_HD = { chi_tra_loi: 'Chỉ trả lời', ban_chay: 'Gửi món bán chạy', nhom: 'Gửi món theo nhóm', gia: 'Gửi món dưới mức giá', mon_chin: 'Gửi món chín', ten: 'Gửi món có tên chứa' };
%>
<section class="qt-tab" data-tab="hieu-y">
  <div class="nh-card">
    <div class="nh-card__header" style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;">
      <div>
        <h2 class="nh-card__title"><i class="fas fa-heart-pulse"></i> Hiểu ý khách</h2>
        <p class="nh-card__desc">
          Khách không hỏi thẳng nhưng lời nói cho thấy nhu cầu: <b>“đói quá”</b> → đang muốn ăn → bot gợi ý món kèm ảnh và hỏi đến quán hay giao;
          <b>“trời lạnh”</b> → gợi ý lẩu, súp; <b>“hết tiền”</b> → món dưới 100k…
          Bot bỏ qua câu phủ định (<i>“không đói”, “hết khát”</i>) và nếu khách đang <b>hỏi</b> một chủ đề khác (vd “đói quá có giao hàng không”) thì trả lời câu hỏi đó trước.
        </p>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button class="nh-btn" type="button" id="yd-them"><i class="fas fa-plus"></i> Thêm ý định</button>
        <button class="nh-btn ghost" type="button" id="yd-mac-dinh"><i class="fas fa-rotate-left"></i> Khôi phục bộ mặc định</button>
      </div>
    </div>
    <div class="yd-luoi" id="yd-ds"></div>
  </div>
</section>

<div class="pr-modal" id="md-yd" role="dialog" aria-modal="true" aria-labelledby="md-yd-td">
  <form class="pr-modal__hop" id="form-yd">
    <div class="pr-modal__dau"><h3 id="md-yd-td">Ý định</h3><button type="button" data-dong>&times;</button></div>
    <div class="pr-modal__than">
      <input type="hidden" name="vi_tri">
      <div class="pr-luoi">
        <label class="pr-truong"><span>Tên ý định *</span><input class="nh-input" name="ten" required maxlength="80" placeholder="Đói / muốn ăn"></label>
        <label class="pr-truong"><span>Độ ưu tiên (0–10)</span><input class="nh-input" type="number" name="uu_tien" min="0" max="10" value="3">
          <small>Khách nói trúng nhiều ý một lúc (“đói mà trời lạnh”) thì ý ưu tiên cao hơn thắng. Ý cụ thể nên cao hơn ý chung chung.</small></label>
        <label class="pr-truong pr-rong"><span>Từ / cụm từ tín hiệu * (mỗi dòng một cụm)</span>
          <textarea class="nh-input" name="tu_khoa" rows="5" required placeholder="đói&#10;đói bụng&#10;thèm ăn&#10;chưa ăn gì"></textarea>
          <small><b>Viết có dấu</b>: khách gõ có dấu thì bot so đúng dấu (“đói” không nhầm “đổi”), khách gõ không dấu vẫn hiểu.</small></label>
        <label class="pr-truong pr-rong"><span>Câu bot đáp * (nhiều cách cách nhau ||)</span>
          <textarea class="nh-input" name="tra_loi" rows="4" required></textarea>
          <small>Dùng được <code>{ten_khach}</code> <code>{hotline}</code> <code>{ten_nha_hang}</code>… In đậm: <code>**chữ**</code>.</small></label>
        <label class="pr-truong"><span>Gửi kèm</span>
          <select class="nh-input" name="hanh_dong">
            <% Object.keys(TEN_HD).forEach(function (k) { %><option value="<%= k %>"><%= TEN_HD[k] %></option><% }) %>
          </select></label>
        <label class="pr-truong"><span>Tham số</span><input class="nh-input" name="tham_so" placeholder="HOT POT|SOUP">
          <small id="yd-goi-y-ts">Nhóm món: tên nhóm tiếng Anh trong thực đơn, cách nhau | (DRINK, DESSERT, HOT POT, SOUP, SALAD, SASHIMI, COMBO…). Mức giá: số tiền tối đa. Tên món: chữ có trong tên, cách nhau |.</small></label>
        <label class="pr-truong"><span>Nút liên kết (Nhãn|đường dẫn ; …)</span><input class="nh-input" name="lien_ket" placeholder="Đặt món|/menu;Đặt bàn|/dat-ban"></label>
        <label class="pr-truong"><span>Gợi ý câu tiếp (cách nhau |)</span><input class="nh-input" name="goi_y"></label>
        <label class="pr-sw pr-rong" style="border:0;"><input type="checkbox" name="bat" checked><span class="pr-sw__nut"></span><span class="pr-sw__chu"><b>Đang bật</b></span></label>
      </div>
    </div>
    <div class="pr-modal__chan">
      <button type="button" class="nh-btn do pr-trai" id="yd-xoa"><i class="fas fa-trash"></i> Xóa ý định</button>
      <button type="button" class="nh-btn ghost" data-dong>Hủy</button>
      <button type="submit" class="nh-btn"><i class="fas fa-floppy-disk"></i> Lưu</button>
    </div>
  </form>
</div>

<style>
  .yd-luoi { display:grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .yd-the { border:1px solid var(--nh-line); border-radius: 12px; padding: 14px 16px; background:#fff; display:flex; flex-direction:column; gap:8px; cursor:pointer; transition: border-color .2s, box-shadow .2s; }
  .yd-the:hover { border-color: var(--nh-gold); box-shadow: var(--nh-shadow-sm); }
  .yd-the.tat { opacity: .5; }
  .yd-the__dau { display:flex; flex-direction:column; align-items:flex-start; gap:6px; }
  .yd-the__dau b { font-size: 14.5px; }
  .yd-tu { display:flex; flex-wrap:wrap; gap:5px; }
  .yd-tu span { background:#fbf3e2; border:1px solid #ecdcb8; color:#6b4a1c; border-radius:999px; padding:2px 9px; font-size:12px; }
  .yd-tl { font-size:12.5px; color: var(--nh-muted); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
</style>

<script>
(function () {
  var TEN_HD = <%- JSON.stringify(TEN_HD) %>;
  var ds = <%- JSON.stringify(dsYD) %>;
  var hop = document.getElementById('yd-ds');
  var form = document.getElementById('form-yd');
  var md = document.getElementById('md-yd');
  function thoat(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function bao(msg, loi) { var t = document.getElementById('pr-toast'); if (!t) return; t.textContent = msg; t.className = 'pr-toast hien' + (loi ? ' loi' : ''); setTimeout(function () { t.className = 'pr-toast'; }, 2600); }
  function ve() {
    var xep = ds.map(function (y, i) { return [y, i]; }).sort(function (a, b) { return (b[0].uu_tien || 0) - (a[0].uu_tien || 0); });
    hop.innerHTML = xep.length ? xep.map(function (p) {
      var y = p[0];
      return '<div class="yd-the' + (y.bat ? '' : ' tat') + '" data-i="' + p[1] + '">' +
        '<div class="yd-the__dau"><b>' + thoat(y.ten) + '</b><span class="pr-the">' + thoat(TEN_HD[y.hanh_dong] || '') + (y.tham_so ? ': ' + thoat(y.tham_so) : '') + '</span></div>' +
        '<div class="yd-tu">' + y.tu_khoa.slice(0, 8).map(function (k) { return '<span>' + thoat(k) + '</span>'; }).join('') + (y.tu_khoa.length > 8 ? '<span>+' + (y.tu_khoa.length - 8) + '</span>' : '') + '</div>' +
        '<div class="yd-tl">' + thoat(String(y.tra_loi).split('||')[0]).replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>') + '</div>' +
        '<div class="pr-phu">Ưu tiên ' + (y.uu_tien || 0) + (y.bat ? '' : ' · <b style="color:var(--nh-danger)">đang tắt</b>') + '</div>' +
      '</div>';
    }).join('') : '<p class="nh-card__desc">Chưa có ý định nào.</p>';
  }
  function luu(thongBao) {
    return fetch('/admin/chatbot/api/y-dinh-ngam', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ds: ds }) })
      .then(function (r) { return r.json(); })
      .then(function (d) { if (!d.ok) throw new Error(d.loi || 'Lỗi lưu'); bao(thongBao || 'Đã lưu, bot hiểu ý mới ngay'); ve(); })
      .catch(function (e) { bao(e.message, true); });
  }
  function mo(i) {
    var y = i == null ? { ten: '', tu_khoa: [], tra_loi: '', hanh_dong: 'ban_chay', tham_so: '', lien_ket: '', goi_y: '', uu_tien: 3, bat: true } : ds[i];
    form.reset();
    form.elements.vi_tri.value = i == null ? '' : i;
    form.elements.ten.value = y.ten;
    form.elements.tu_khoa.value = (y.tu_khoa || []).join('\n');
    form.elements.tra_loi.value = y.tra_loi;
    form.elements.hanh_dong.value = y.hanh_dong;
    form.elements.tham_so.value = y.tham_so || '';
    form.elements.lien_ket.value = y.lien_ket || '';
    form.elements.goi_y.value = y.goi_y || '';
    form.elements.uu_tien.value = y.uu_tien || 0;
    form.elements.bat.checked = y.bat !== false;
    document.getElementById('md-yd-td').textContent = i == null ? 'Thêm ý định' : 'Sửa ý định';
    document.getElementById('yd-xoa').style.display = i == null ? 'none' : '';
    md.classList.add('mo');
  }
  hop.addEventListener('click', function (e) { var t = e.target.closest('[data-i]'); if (t) mo(Number(t.dataset.i)); });
  document.getElementById('yd-them').onclick = function () { mo(null); };
  form.onsubmit = function (e) {
    e.preventDefault();
    var f = form.elements;
    var y = {
      ma: f.vi_tri.value !== '' ? ds[Number(f.vi_tri.value)].ma : undefined,
      ten: f.ten.value, tu_khoa: f.tu_khoa.value.split(/\n|,/).map(function (s) { return s.trim(); }).filter(Boolean),
      tra_loi: f.tra_loi.value, hanh_dong: f.hanh_dong.value, tham_so: f.tham_so.value, lien_ket: f.lien_ket.value,
      goi_y: f.goi_y.value, uu_tien: Number(f.uu_tien.value) || 0, bat: f.bat.checked
    };
    if (f.vi_tri.value !== '') ds[Number(f.vi_tri.value)] = y; else ds.push(y);
    md.classList.remove('mo');
    luu();
  };
  document.getElementById('yd-xoa').onclick = function () {
    var i = form.elements.vi_tri.value;
    if (i === '' || !confirm('Xóa ý định “' + ds[Number(i)].ten + '”?')) return;
    ds.splice(Number(i), 1);
    md.classList.remove('mo');
    luu('Đã xóa ý định');
  };
  document.getElementById('yd-mac-dinh').onclick = function () {
    if (!confirm('Khôi phục bộ ý định mặc định? Các ý định bạn đã sửa sẽ mất.')) return;
    fetch('/admin/chatbot/api/y-dinh-ngam/mac-dinh', { method: 'POST' }).then(function () { location.href = '/admin/chatbot?tab=hieu-y'; });
  };
  ve();
})();
</script>

