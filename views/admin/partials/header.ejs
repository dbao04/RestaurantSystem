<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản trị · Nhà Hàng Bảo Đoàn</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/admin/quantri.css" />
    <style>
      /* Ngăn chặn tuyệt đối tình trạng gạch chân khi hover/click menu hoặc tab */
      a, a:hover, a:focus, a:active,
      .qt-side a, .qt-side a:hover, .qt-side a:focus,
      .qt-nav__item, .qt-nav__item:hover, .qt-nav__item:focus,
      .qt-link, .qt-link:hover, .qt-link:focus,
      .nav-link, .nav-link:hover, .nav-link:focus,
      .btn, .btn:hover, .btn:focus {
        text-decoration: none !important;
      }
    </style>

    <script src="/admin-js/jquery-1.6.4.min.js"></script>
    <script src="/admin-js/table/jquery.dataTables.min.js"></script>
    <script>
      (function () {
        if (!window.jQuery || !jQuery.fn.dataTable) return;
        var goc = jQuery.fn.dataTable;
        jQuery.fn.dataTable = function (tuyChon) {
          return goc.call(this, jQuery.extend({
            aLengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, 'Tất cả']],
            iDisplayLength: 25
          }, tuyChon || {}));
        };
        jQuery.extend(jQuery.fn.dataTable, goc);
      })();
    </script>
</head>
<body class="qt-body">

<script src="/socket.io/socket.io.js"></script>
<script src="/realtime-to-chuc.js"></script>

<div class="qt-shell" id="qtShell">

    <!-- ================================================ THANH BEN TRAI -->
    <aside class="qt-side">
        <div class="qt-side__brand">
            <span class="qt-side__mark">
                <img src="/logo.svg" alt="Logo" width="32" height="32" style="filter: brightness(0) invert(1) sepia(1) saturate(5) hue-rotate(10deg);">
            </span>
            <span>
                <span class="qt-side__name">Nhà Hàng Bảo Đoàn</span>
                <span class="qt-side__role">Trang quản trị</span>
            </span>
        </div>

        <nav class="qt-side__scroll" id="qtNav">
            <div class="qt-side__group">
                <div class="qt-side__label">Hệ thống &amp; Dự báo</div>
                <a class="qt-nav__item" href="/admin" data-match="/admin"><i class="fas fa-gauge-high"></i><span>Bảng điều khiển</span></a>
                <a class="qt-nav__item" href="/admin/to-chuc-quan-ly" data-match="/admin/to-chuc-quan-ly,/to-chuc/quan-ly"><i class="fas fa-sitemap"></i><span>Cơ cấu &amp; Phân quyền</span></a>
                <a class="qt-nav__item" href="/admin/du-bao" data-match="/admin/du-bao,/du-bao"><i class="fas fa-brain"></i><span>Dự báo AI (ML)</span></a>
                <a class="qt-nav__item" href="/admin/chatbot" data-match="/admin/chatbot"><i class="fas fa-robot"></i><span>Cấu hình Trợ lý AI</span></a>
                <a class="qt-nav__item" href="/admin/stats" data-match="/admin/stats"><i class="fas fa-chart-pie"></i><span>Báo cáo hệ thống</span></a>
                <a class="qt-nav__item" href="/analytics" data-match="/analytics"><i class="fas fa-chart-line"></i><span>Dashboard phân tích</span></a>
            </div>

            <div class="qt-side__group">
                <div class="qt-side__label">Tài khoản &amp; Nhân sự</div>
                <a class="qt-nav__item" href="/admin/stafflist" data-match="/admin/stafflist,/admin/staffedit,/admin/staffdel"><i class="fas fa-user-group"></i><span>Tài khoản nhân sự</span></a>
                <a class="qt-nav__item" href="/admin/staffadd" data-match="/admin/staffadd"><i class="fas fa-user-plus"></i><span>Thêm tài khoản</span></a>
            </div>

            <div class="qt-side__group">
                <div class="qt-side__label">Cấu hình Vận hành</div>
                <a class="qt-nav__item" href="/admin/khuyen-mai" data-match="/admin/khuyen-mai"><i class="fas fa-ticket"></i><span>Chương trình khuyến mãi</span></a>
                <a class="qt-nav__item" href="/admin/thanh-toan" data-match="/admin/thanh-toan"><i class="fas fa-credit-card"></i><span>Cấu hình thanh toán</span></a>
                <a class="qt-nav__item" href="/admin/dat-ban" data-match="/admin/dat-ban"><i class="fas fa-calendar-check"></i><span>Chính sách đặt bàn</span></a>
                <a class="qt-nav__item" href="/admin/van-chuyen" data-match="/admin/van-chuyen"><i class="fas fa-truck"></i><span>Đơn vị vận chuyển</span></a>
                <a class="qt-nav__item" href="/admin/khuon-mat" data-match="/admin/khuon-mat,/to-chuc/khuon-mat"><i class="fas fa-camera"></i><span>Cấu hình khuôn mặt</span></a>
            </div>

            <div class="qt-side__group">
                <div class="qt-side__label">Dữ liệu Danh mục</div>
                <a class="qt-nav__item" href="/admin/productlist" data-match="/admin/productlist,/admin/productedit,/admin/productdel"><i class="fas fa-bowl-food"></i><span>Danh mục món ăn</span></a>
                <a class="qt-nav__item" href="/admin/catlist" data-match="/admin/catlist,/admin/catedit,/admin/catdel"><i class="fas fa-layer-group"></i><span>Loại món</span></a>
            </div>

            <div class="qt-side__group">
                <div class="qt-side__label">Nội dung Website</div>
                <a class="qt-nav__item" href="/admin/bloglist" data-match="/admin/bloglist,/admin/blogedit,/admin/blogdel"><i class="fas fa-newspaper"></i><span>Danh sách bài viết</span></a>
                <a class="qt-nav__item" href="/admin/blogadd" data-match="/admin/blogadd"><i class="fas fa-pen-nib"></i><span>Thêm bài viết</span></a>
            </div>

            <div class="qt-side__group">
                <div class="qt-side__label">Tài khoản</div>
                <a class="qt-nav__item" href="/admin/profile" data-match="/admin/profile"><i class="fas fa-id-card"></i><span>Thông tin cá nhân</span></a>
                <a class="qt-nav__item" href="/admin/changepassword" data-match="/admin/changepassword"><i class="fas fa-key"></i><span>Đổi mật khẩu</span></a>
                <a class="qt-nav__item" href="/" target="_blank"><i class="fas fa-store"></i><span>Xem website</span><i class="fas fa-arrow-up-right-from-square qt-nav__ext"></i></a>
            </div>
        </nav>
    </aside>

    <div class="qt-backdrop" id="qtBackdrop"></div>

    <!-- ====================================================== NOI DUNG -->
    <div class="qt-main">
        <header class="qt-top">
            <button class="qt-top__burger" id="qtBurger" type="button" aria-label="Mở menu">
                <i class="fas fa-bars"></i>
            </button>
            <div>
                <div class="qt-top__crumb"><%= (typeof crumb !== 'undefined' && crumb) ? crumb : 'Quản trị' %></div>
                <h1 class="qt-top__title" id="qtTitle" <%- (typeof title !== 'undefined' && title) ? 'data-custom-title="1"' : '' %>><%= (typeof title !== 'undefined' && title) ? title : 'Bảng điều khiển' %></h1>
            </div>
            <div class="qt-top__right">
                <div class="qt-chip">
                    <span class="qt-chip__ava"><%= (session.adminname || 'A').trim().charAt(0).toUpperCase() %></span>
                    <span class="qt-chip__meta">
                        <span class="qt-chip__name"><%= session.adminname || 'Quản trị viên' %></span><br>
                        <span class="qt-chip__sub">@<%= session.adminuser || 'admin' %></span>
                    </span>
                </div>
                <a class="qt-icon-btn" href="/admin/logout" title="Đăng xuất"><i class="fas fa-right-from-bracket"></i></a>
            </div>
        </header>

        <main class="qt-content">
