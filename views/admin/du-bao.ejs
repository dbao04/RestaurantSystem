<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dự báo AI &amp; Machine Learning - Nhà Hàng Bảo Đoàn</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,400;1,700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Chart.js -->
  <script src="/chart.umd.js"></script>

  <style>
    :root {
      --nh-espresso: #221711;
      --nh-espresso-2: #2d1f17;
      --nh-espresso-3: #3b2a20;
      --nh-gold: #c8a24b;
      --nh-gold-light: #e5c87f;
      --nh-gold-soft: #f4ebd0;
      --nh-gold-dark: #9e7d30;
      --nh-cream: #fbf8f4;
      --nh-cream-2: #f2ece1;
      --nh-surface: #ffffff;
      --nh-ink: #1f1a16;
      --nh-muted: #786a5d;
      --nh-line: #e8ded1;
      --nh-line-soft: #f3ede4;

      --nh-ok: #15803d;
      --nh-ok-bg: #ecfdf5;
      --nh-ok-border: #a7f3d0;
      --nh-warn: #b45309;
      --nh-warn-bg: #fffbeb;
      --nh-warn-border: #fde68a;
      --nh-danger: #b91c1c;
      --nh-danger-bg: #fef2f2;
      --nh-danger-border: #fecaca;
      --nh-info: #1d4ed8;
      --nh-info-bg: #eff6ff;
      --nh-info-border: #bfdbfe;

      --nh-serif: 'Playfair Display', Georgia, serif;
      --nh-sans: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;

      --nh-radius: 14px;
      --nh-radius-sm: 8px;
      --nh-shadow: 0 16px 36px -18px rgba(34, 23, 17, 0.35);
      --nh-shadow-sm: 0 4px 14px -6px rgba(34, 23, 17, 0.18);
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--nh-cream);
      color: var(--nh-ink);
      font-family: var(--nh-sans);
      font-size: 14px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }

    /* ------------------------------------------------------------- TOPBAR */
    header.nh-topbar {
      background: linear-gradient(135deg, var(--nh-espresso) 0%, var(--nh-espresso-2) 60%, var(--nh-espresso-3) 100%);
      color: #fff;
      padding: 18px 32px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
      border-bottom: 2px solid var(--nh-gold);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .nh-topbar__inner {
      max-width: 1560px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }
    .nh-topbar__brand {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      color: inherit;
    }
    .nh-topbar__logo {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, var(--nh-gold), #9e7d30);
      border-radius: 12px;
      display: grid;
      place-items: center;
      box-shadow: 0 4px 12px rgba(200, 162, 75, 0.45);
      flex-shrink: 0;
    }
    .nh-topbar__logo img {
      width: 26px;
      height: 26px;
      filter: brightness(0) invert(1) sepia(1) saturate(5) hue-rotate(10deg);
    }
    .nh-topbar__titles h1 {
      margin: 0;
      font-family: var(--nh-serif);
      font-size: 21px;
      font-weight: 700;
      letter-spacing: 0.3px;
      display: flex;
      align-items: center;
      gap: 10px;
      color: #fff;
    }
    .nh-badge-layer {
      font-family: var(--nh-sans);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      background: rgba(200, 162, 75, 0.25);
      color: var(--nh-gold-light);
      border: 1px solid rgba(200, 162, 75, 0.45);
      padding: 3px 9px;
      border-radius: 20px;
    }
    .nh-topbar__sub {
      font-size: 12.5px;
      color: #d8cdbe;
      margin-top: 3px;
    }
    .nh-topbar__sub b {
      color: var(--nh-gold-light);
      font-weight: 600;
    }

    .nh-topbar__nav {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .nh-topbar__nav a {
      color: #fff;
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      padding: 8px 14px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: var(--nh-radius-sm);
      display: inline-flex;
      align-items: center;
      gap: 7px;
      transition: all 0.2s ease;
    }
    .nh-topbar__nav a i {
      color: var(--nh-gold);
      font-size: 12px;
      transition: transform 0.2s;
    }
    .nh-topbar__nav a:hover {
      background: rgba(200, 162, 75, 0.22);
      border-color: var(--nh-gold);
      color: #fff;
      transform: translateY(-1px);
    }
    .nh-topbar__nav a:hover i {
      transform: scale(1.15);
    }

    /* ------------------------------------------------------------- WRAPPER */
    .nh-wrap {
      max-width: 1560px;
      margin: 0 auto;
      padding: 24px 32px 80px;
    }

    /* ------------------------------------------------------------- BANNER */
    .nh-banner {
      padding: 13px 18px;
      border-radius: var(--nh-radius);
      margin-bottom: 20px;
      font-size: 13.5px;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      box-shadow: var(--nh-shadow-sm);
    }
    .nh-banner.ok {
      background: var(--nh-ok-bg);
      border: 1px solid var(--nh-ok-border);
      color: #14532d;
    }
    .nh-banner.ok i { color: var(--nh-ok); font-size: 16px; }
    .nh-banner.tat {
      background: var(--nh-warn-bg);
      border: 1px solid var(--nh-warn-border);
      color: #78350f;
    }
    .nh-banner.tat i { color: var(--nh-warn); font-size: 16px; }
    .nh-banner code {
      background: rgba(0, 0, 0, 0.06);
      padding: 2px 7px;
      border-radius: 4px;
      font-size: 12.5px;
      font-weight: 600;
    }

    /* ------------------------------------------------------------- ACTION TOOLBAR */
    .nh-toolbar {
      background: var(--nh-surface);
      border: 1px solid var(--nh-line);
      border-radius: var(--nh-radius);
      padding: 16px 22px;
      margin-bottom: 22px;
      box-shadow: var(--nh-shadow-sm);
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
      position: relative;
    }
    .nh-toolbar::before {
      content: '';
      position: absolute;
      top: 0; left: 24px; right: 24px;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--nh-gold), transparent);
    }

    .nh-btn {
      background: linear-gradient(135deg, var(--nh-espresso) 0%, var(--nh-espresso-2) 100%);
      color: #fff;
      border: 1px solid var(--nh-gold);
      padding: 9px 18px;
      border-radius: var(--nh-radius-sm);
      cursor: pointer;
      font-size: 13.5px;
      font-weight: 700;
      font-family: inherit;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .nh-btn i {
      color: var(--nh-gold);
      font-size: 13px;
    }
    .nh-btn:hover {
      background: var(--nh-espresso-3);
      box-shadow: 0 4px 12px rgba(34, 23, 17, 0.25);
      transform: translateY(-1px);
    }
    .nh-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none !important;
    }
    .nh-btn.ghost {
      background: #fff;
      color: var(--nh-espresso);
      border: 1px solid var(--nh-line);
    }
    .nh-btn.ghost:hover {
      background: var(--nh-cream);
      border-color: var(--nh-gold);
    }

    .trang-thai-text {
      font-size: 13px;
      color: var(--nh-muted);
      font-weight: 500;
      margin-left: 6px;
    }

    /* ------------------------------------------------------------- KPIS */
    .nh-kpis {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 22px;
    }
    .nh-kpi {
      background: var(--nh-surface);
      border: 1px solid var(--nh-line);
      border-radius: var(--nh-radius);
      padding: 18px 20px;
      box-shadow: var(--nh-shadow-sm);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-left: 4px solid var(--nh-gold);
      transition: all 0.2s ease;
    }
    .nh-kpi:hover {
      transform: translateY(-2px);
      box-shadow: var(--nh-shadow);
      border-color: #dcd0bf;
    }
    .nh-kpi.accent { border-left-color: var(--nh-gold); }
    .nh-kpi.good   { border-left-color: var(--nh-ok); }
    .nh-kpi.info   { border-left-color: var(--nh-info); }

    .nh-kpi__label {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--nh-muted);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nh-kpi__label i {
      font-size: 16px;
      color: var(--nh-gold);
    }
    .nh-kpi__val {
      font-size: 26px;
      font-weight: 800;
      color: var(--nh-espresso);
      margin: 8px 0 4px;
      letter-spacing: -0.3px;
    }
    .nh-kpi__note {
      font-size: 12px;
      color: var(--nh-muted);
      font-weight: 500;
    }

    /* ------------------------------------------------------------- CARDS & GRIDS */
    .nh-grid {
      display: grid;
      gap: 20px;
      margin-bottom: 20px;
    }
    .nh-g2 {
      grid-template-columns: repeat(auto-fit, minmax(460px, 1fr));
    }

    .nh-card {
      background: var(--nh-surface);
      border: 1px solid var(--nh-line);
      border-radius: var(--nh-radius);
      padding: 22px 24px;
      box-shadow: var(--nh-shadow-sm);
      display: flex;
      flex-direction: column;
      margin-bottom: 20px;
      transition: border-color 0.2s ease;
    }
    .nh-card:hover {
      border-color: #dcd0bf;
    }
    .nh-card__header {
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--nh-line-soft);
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }
    .nh-card__title {
      margin: 0;
      font-family: var(--nh-serif);
      font-size: 17px;
      font-weight: 700;
      color: var(--nh-espresso);
      display: flex;
      align-items: center;
      gap: 9px;
    }
    .nh-card__title i {
      color: var(--nh-gold);
      font-size: 15px;
    }
    .nh-card__desc {
      font-size: 12.5px;
      color: var(--nh-muted);
      margin-top: 3px;
    }

    .nh-chart-box {
      position: relative;
      height: 320px;
      width: 100%;
    }

    /* ------------------------------------------------------------- INSIGHT BOX */
    .nh-insight {
      background: linear-gradient(135deg, #fdfaf3 0%, var(--nh-gold-soft) 100%);
      border: 1px solid #ebd9b0;
      border-left: 4px solid var(--nh-gold);
      border-radius: var(--nh-radius-sm);
      padding: 13px 16px;
      font-size: 13.5px;
      line-height: 1.6;
      margin-top: 14px;
      color: var(--nh-espresso);
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .nh-insight i.fa-lightbulb {
      color: var(--nh-gold-dark);
      font-size: 16px;
      margin-top: 2px;
      flex-shrink: 0;
    }
    .nh-insight b {
      color: var(--nh-espresso);
      font-weight: 700;
    }

    /* ------------------------------------------------------------- TABLES */
    .nh-table-scroll {
      max-height: 400px;
      overflow-y: auto;
      border: 1px solid var(--nh-line-soft);
      border-radius: var(--nh-radius-sm);
    }
    table.nh-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
      text-align: left;
    }
    table.nh-table th {
      background: var(--nh-cream-2);
      color: var(--nh-muted);
      font-weight: 700;
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px 14px;
      position: sticky;
      top: 0;
      z-index: 10;
      border-bottom: 1px solid var(--nh-line);
    }
    table.nh-table td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--nh-line-soft);
      color: var(--nh-ink);
    }
    table.nh-table tbody tr:hover {
      background: #faf6ef;
    }
    table.nh-table tr.tot td {
      background: #f0fdf4;
      font-weight: 600;
    }
    table.nh-table td.num, table.nh-table th.num {
      text-align: right;
      font-variant-numeric: tabular-nums;
      font-weight: 600;
    }

    /* Tags / Badges */
    .nh-tag {
      padding: 3px 9px;
      border-radius: 20px;
      font-size: 11.5px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
    }
    .nh-tag.gap { background: var(--nh-danger-bg); color: var(--nh-danger); border: 1px solid var(--nh-danger-border); }
    .nh-tag.som { background: var(--nh-warn-bg); color: var(--nh-warn); border: 1px solid var(--nh-warn-border); }
    .nh-tag.on  { background: var(--nh-ok-bg); color: var(--nh-ok); border: 1px solid var(--nh-ok-border); }

    .loading-state {
      padding: 30px;
      text-align: center;
      color: var(--nh-muted);
      font-size: 13.5px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .loading-state i {
      color: var(--nh-gold);
    }

    @media (max-width: 768px) {
      .nh-wrap { padding: 16px; }
      header.nh-topbar { padding: 14px 16px; }
      .nh-g2 { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <!-- ========================================================= TOPBAR -->
  <header class="nh-topbar">
    <div class="nh-topbar__inner">
      <a class="nh-topbar__brand" href="/admin">
        <div class="nh-topbar__logo">
          <img src="/logo.svg" alt="Logo">
        </div>
        <div class="nh-topbar__titles">
          <h1>
            Nhà Hàng Bảo Đoàn
            <span class="nh-badge-layer">Tầng 3 &bull; Machine Learning &bull; Gợi ý AI</span>
          </h1>
          <div class="nh-topbar__sub">
            Dự Báo Nhu Cầu &amp; Gợi Ý Món Bằng AI &bull; Xin chào <b><%= tenNguoiDung %></b>
          </div>
        </div>
      </a>

      <nav class="nh-topbar__nav">
        <a href="/admin"><i class="fas fa-gauge-high"></i> Trang quản trị</a>
        <a href="/analytics"><i class="fas fa-chart-line"></i> Dashboard phân tích</a>
        <a href="/so-do-ban"><i class="fas fa-chair"></i> Sơ đồ bàn</a>
        <a href="/kds"><i class="fas fa-fire-burner"></i> Bếp KDS</a>
        <a href="/staff"><i class="fas fa-users-gear"></i> Nhân viên</a>
        <a href="/" target="_blank"><i class="fas fa-store"></i> Trang chủ</a>
      </nav>
    </div>
  </header>

  <!-- ========================================================= MAIN CONTAINER -->
  <div class="nh-wrap">
    <% if (trangThaiML.san_sang) { %>
      <div class="nh-banner ok">
        <i class="fas fa-circle-check"></i>
        <div>
          <b>ML Service đang hoạt động:</b> Đã kết nối CSDL thành công, <b><%= Number(trangThaiML.so_dong_don_hang).toLocaleString('vi-VN') %></b> dòng đơn hàng sẵn sàng cho mô hình học máy.
        </div>
      </div>
    <% } else { %>
      <div class="nh-banner tat">
        <i class="fas fa-triangle-exclamation"></i>
        <div>
          <b>ML Service chưa kích hoạt:</b> Đang hiển thị kết quả dự báo đã lưu gần nhất trong CSDL. Để huấn luyện lại mô hình, hãy khởi chạy: <code>python -m uvicorn ml_service.main:app --port 8000</code>
        </div>
      </div>
    <% } %>

    <!-- Action Buttons -->
    <div class="nh-toolbar">
      <button class="nh-btn" id="btnKhach" onclick="chay('khach')">
        <i class="fas fa-users"></i> Chạy lại dự báo lượt khách
      </button>
      <button class="nh-btn" id="btnNL" onclick="chay('nguyen-lieu')">
        <i class="fas fa-boxes-stacked"></i> Chạy lại dự báo nguyên liệu
      </button>
      <button class="nh-btn ghost" id="btnAp" onclick="chay('apriori')">
        <i class="fas fa-diagram-project"></i> Khai phá lại luật kết hợp
      </button>
      <span class="trang-thai-text" id="trangThai"></span>
    </div>

    <!-- 3 KPI Cards -->
    <div class="nh-kpis" id="kpis"></div>

    <!-- Chart: Dự báo lượt khách theo ngày -->
    <div class="nh-card">
      <div class="nh-card__header">
        <div>
          <h2 class="nh-card__title"><i class="fas fa-chart-line"></i> Dự báo lượt khách theo ngày</h2>
          <div class="nh-card__desc">Đường liền là số liệu thực tế đã ghi nhận, đường nét đứt là dự báo kèm khoảng tin cậy 95%</div>
        </div>
      </div>
      <div class="nh-chart-box"><canvas id="cKhach"></canvas></div>
      <div class="nh-insight" id="insightKhach">
        <i class="fas fa-lightbulb"></i>
        <span>Đang phân tích số liệu...</span>
      </div>
    </div>

    <!-- Grid 2 Cột: Đánh giá mô hình & Dự báo nguyên liệu -->
    <div class="nh-grid nh-g2">
      <div class="nh-card" style="margin-bottom:0">
        <div class="nh-card__header">
          <div>
            <h2 class="nh-card__title"><i class="fas fa-scale-balanced"></i> So sánh hiệu năng các mô hình</h2>
            <div class="nh-card__desc">
              Kiểm thử Time-series Split. <b>SeasonalNaive</b> là mô hình nền. Mô hình Machine Learning vượt trội sẽ được ưu tiên dự báo.
            </div>
          </div>
        </div>
        <div class="nh-table-scroll">
          <table class="nh-table" id="tDanhGia">
            <tbody><tr><td class="loading-state"><i class="fas fa-spinner fa-spin"></i> Đang tải kết quả...</td></tr></tbody>
          </table>
        </div>
        <div class="nh-insight" id="insightMoHinh">
          <i class="fas fa-lightbulb"></i>
          <span>Đang so sánh hiệu năng...</span>
        </div>
      </div>

      <div class="nh-card" style="margin-bottom:0">
        <div class="nh-card__header">
          <div>
            <h2 class="nh-card__title"><i class="fas fa-cubes-stacked"></i> Dự báo nhu cầu nguyên liệu</h2>
            <div class="nh-card__desc">Lượng nguyên liệu dự kiến tiêu hao và số lượng cần nhập thêm so với kho thực tế</div>
          </div>
        </div>
        <div class="nh-table-scroll">
          <table class="nh-table" id="tNguyenLieu">
            <tbody><tr><td class="loading-state"><i class="fas fa-spinner fa-spin"></i> Đang tải nguyên liệu...</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Card: Luật kết hợp Apriori -->
    <div class="nh-card">
      <div class="nh-card__header">
        <div>
          <h2 class="nh-card__title"><i class="fas fa-brain"></i> Luật kết hợp món ăn (Khai phá bằng Apriori)</h2>
          <div class="nh-card__desc">
            <b>Độ hỗ trợ (Support)</b>: Tỷ lệ đơn có mặt tổ hợp món &bull; 
            <b>Độ tin cậy (Confidence)</b>: Xác suất gọi B khi đã có A &bull; 
            <b>Lift &gt; 1</b>: Mức độ tương quan kích cầu gọi kèm (Lift càng cao, gợi ý càng chuẩn xác)
          </div>
        </div>
      </div>
      <div class="nh-table-scroll">
        <table class="nh-table" id="tLuat">
          <tbody><tr><td class="loading-state"><i class="fas fa-spinner fa-spin"></i> Đang tải tập luật gợi ý...</td></tr></tbody>
        </table>
      </div>
      <div class="nh-insight" id="insightLuat">
        <i class="fas fa-lightbulb"></i>
        <span>Đang phân tích luật bán kèm mạnh nhất...</span>
      </div>
    </div>

  </div>

<script>
const bieuDo = {};
function ve(id, cfg) {
  if (bieuDo[id]) bieuDo[id].destroy();
  bieuDo[id] = new Chart(document.getElementById(id), cfg);
}
const so = (v, n = 0) => Number(v || 0).toLocaleString('vi-VN', { maximumFractionDigits: n });

const KHONG_LE = ['lon','chai','cai','cái','bo','bó','hop','hộp','goi','gói','gram','g','ml'];
const soKho = (v, dv) => Number(v || 0).toLocaleString('vi-VN', {
  maximumFractionDigits: KHONG_LE.indexOf(String(dv || '').trim().toLowerCase()) >= 0 ? 0 : 2,
  useGrouping: false,
});

async function layJSON(duong) {
  const r = await fetch(duong);
  if (!r.ok) throw new Error(duong + ' -> ' + r.status);
  return r.json();
}

// Thiết lập font mặc định cho Chart.js chuẩn nhà hàng
Chart.defaults.font.family = "'Plus Jakarta Sans', 'Inter', system-ui, sans-serif";
Chart.defaults.color = '#786a5d';

// --- Dự báo lượt khách ---
async function veKhach() {
  const [duBao, lichSu] = await Promise.all([
    layJSON('/du-bao/api/khach-da-luu?so_ngay=14'),
    layJSON('/du-bao/api/lich-su-khach?so_ngay=45'),
  ]);

  if (!duBao.length) {
    document.getElementById('insightKhach').innerHTML =
      '<i class="fas fa-lightbulb"></i><span>Chưa có dữ liệu dự báo. Bấm <b>Chạy lại dự báo lượt khách</b> để huấn luyện mô hình.</span>';
    return;
  }

  const nhanLS = lichSu.map(r => r.ngay.slice(5));
  const nhanDB = duBao.map(r => String(r.ngay_du_bao).slice(5, 10));
  const nhan = [...nhanLS, ...nhanDB];
  const demLS = lichSu.length;

  const thuc = [...lichSu.map(r => Number(r.so_khach)), ...new Array(duBao.length).fill(null)];
  const db = new Array(demLS - 1).fill(null);
  db.push(lichSu.length ? Number(lichSu[demLS - 1].so_khach) : null);
  duBao.forEach(r => db.push(Number(r.so_khach_du_bao)));

  const duoi = new Array(demLS).fill(null);
  const tren = new Array(demLS).fill(null);
  duBao.forEach(r => { duoi.push(Number(r.can_duoi)); tren.push(Number(r.can_tren)); });

  ve('cKhach', {
    type: 'line',
    data: {
      labels: nhan,
      datasets: [
        { label: 'Thực tế (lượt khách)', data: thuc, borderColor: '#15803d',
          backgroundColor: 'rgba(21, 128, 61, 0.10)', fill: true, tension: .3, pointRadius: 2 },
        { label: 'Dự báo', data: db, borderColor: '#c8a24b', borderDash: [6, 4],
          tension: .3, pointRadius: 4, pointBackgroundColor: '#9e7d30', fill: false, borderWidth: 2.5 },
        { label: 'Cận trên 95%', data: tren, borderColor: 'rgba(200, 162, 75, .35)',
          pointRadius: 0, fill: '+1', backgroundColor: 'rgba(200, 162, 75, .12)' },
        { label: 'Cận dưới 95%', data: duoi, borderColor: 'rgba(200, 162, 75, .35)',
          pointRadius: 0, fill: false },
      ],
    },
    options: {
      responsive: true, maintainAspectRatio: false, spanGaps: true,
      interaction: { mode: 'index', intersect: false },
      plugins: { legend: { position: 'bottom', labels: { boxWidth: 14, font: { size: 12, weight: 600 } } } },
      scales: {
        y: { title: { display: true, text: 'Lượt khách' }, grid: { color: '#f3ede4' } },
        x: { grid: { display: false } }
      },
    },
  });

  const tong = duBao.reduce((s, r) => s + Number(r.so_khach_du_bao), 0);
  const cao = duBao.reduce((a, b) => Number(a.so_khach_du_bao) > Number(b.so_khach_du_bao) ? a : b);
  const thu = ['Chủ nhật','Thứ 2','Thứ 3','Thứ 4','Thứ 5','Thứ 6','Thứ 7'][new Date(cao.ngay_du_bao).getDay()];
  document.getElementById('insightKhach').innerHTML =
    `<i class="fas fa-lightbulb"></i><span>Dự báo tổng cộng <b>${so(tong)}</b> lượt khách trong <b>${duBao.length} ngày tới</b> (mô hình tối ưu: <b>${cao.mo_hinh}</b>). ` +
    `Ngày cao điểm nhất là <b>${String(cao.ngay_du_bao).slice(0,10)} (${thu})</b> với khoảng <b>${so(cao.so_khach_du_bao)} lượt</b> &mdash; ` +
    `cần chủ động bố trí tăng cường ca làm và chuẩn bị sẵn nguồn thực phẩm.</span>`;
}

// --- Bảng đánh giá mô hình ---
async function veDanhGia() {
  const d = await layJSON('/du-bao/api/danh-gia');
  if (!d.length) {
    document.getElementById('tDanhGia').innerHTML = '<tbody><tr><td class="loading-state">Chưa có kết quả đánh giá</td></tr></tbody>';
    return;
  }
  const tenBT = { du_bao_so_khach: 'Dự báo lượt khách', du_bao_so_don: 'Dự báo số đơn',
                  du_bao_nguyen_lieu: 'Dự báo nguyên liệu' };
  const tot = {};
  d.forEach(r => { if (!tot[r.bai_toan] || r.mae < tot[r.bai_toan]) tot[r.bai_toan] = r.mae; });

  document.getElementById('tDanhGia').innerHTML = `
    <thead><tr><th>Bài toán</th><th>Mô hình</th><th class="num">MAE</th>
    <th class="num">RMSE</th><th class="num">MAPE</th><th class="num">R²</th></tr></thead>
    <tbody>${d.map(r => `
      <tr class="${r.mae === tot[r.bai_toan] ? 'tot' : ''}">
        <td style="color:var(--nh-muted); font-weight:600;">${tenBT[r.bai_toan] || r.bai_toan}</td>
        <td><b>${r.mo_hinh}</b>${r.mo_hinh === 'SeasonalNaive' ? ' <span class="nh-tag som">nền</span>' : (r.mae === tot[r.bai_toan] ? ' <span class="nh-tag on">tốt nhất</span>' : '')}</td>
        <td class="num">${r.mae === null ? '—' : Number(r.mae).toFixed(2)}</td>
        <td class="num">${r.rmse === null ? '—' : Number(r.rmse).toFixed(2)}</td>
        <td class="num">${r.mape === null ? '—' : Number(r.mape).toFixed(1) + '%'}</td>
        <td class="num">${r.r2 === null ? '—' : Number(r.r2).toFixed(3)}</td>
      </tr>`).join('')}
    </tbody>`;

  const bt = d.filter(r => r.bai_toan === 'du_bao_so_khach');
  const nen = bt.find(r => r.mo_hinh === 'SeasonalNaive');
  const hay = bt.filter(r => r.mo_hinh !== 'SeasonalNaive').sort((a, b) => a.mae - b.mae)[0];
  if (nen && hay) {
    const caiThien = ((nen.mae - hay.mae) / nen.mae * 100);
    document.getElementById('insightMoHinh').innerHTML =
      `<i class="fas fa-lightbulb"></i><span>Mô hình <b>${hay.mo_hinh}</b> đạt sai số MAE = <b>${Number(hay.mae).toFixed(2)}</b>, ` +
      `giảm <b>${caiThien.toFixed(1)}%</b> sai số so với mô hình nền (SeasonalNaive MAE ${Number(nen.mae).toFixed(2)}). ` +
      `Hệ số R² = <b>${Number(hay.r2).toFixed(3)}</b> chứng minh mô hình dự báo rất chuẩn xác với biến thiên thực tế.</span>`;
  }
}

// --- Dự báo nguyên liệu ---
async function veNguyenLieu() {
  const d = await layJSON('/du-bao/api/nguyen-lieu-da-luu');
  if (!d.length) {
    document.getElementById('tNguyenLieu').innerHTML =
      '<tbody><tr><td class="loading-state">Chưa có dữ liệu. Bấm "Chạy lại dự báo nguyên liệu".</td></tr></tbody>';
    return;
  }
  document.getElementById('tNguyenLieu').innerHTML = `
    <thead><tr><th>Nguyên liệu</th><th>Mô hình</th><th class="num">Tồn</th>
    <th class="num">Cần</th><th class="num">Nhập thêm</th></tr></thead>
    <tbody>${d.map(r => {
      const nhap = Number(r.can_nhap_them);
      const dv = r.ten_dvt || '';
      return `<tr>
        <td><b>${r.ten_nl}</b></td>
        <td style="color:var(--nh-muted); font-size:12.5px">${r.mo_hinh}</td>
        <td class="num">${soKho(r.ton_hien_tai, dv)}</td>
        <td class="num">${soKho(r.tong_can, dv)}</td>
        <td class="num">${nhap > 0
          ? `<span class="nh-tag ${nhap > Number(r.ton_hien_tai) ? 'gap' : 'som'}">${soKho(nhap, dv)} ${dv}</span>`
          : '<span class="nh-tag on">Đủ</span>'}</td>
      </tr>`;
    }).join('')}
    </tbody>`;
}

// --- Luật kết hợp ---
async function veLuat() {
  const d = await layJSON('/goi-y/api/luat?gioi_han=25');
  const tk = d.thong_ke || {};
  document.getElementById('kpis').innerHTML = `
    <div class="nh-kpi accent">
      <div class="nh-kpi__label"><span>Số luật kết hợp</span><i class="fas fa-diagram-project"></i></div>
      <div class="nh-kpi__val">${so(tk.so_luat)}</div>
      <div class="nh-kpi__note">Khai phá từ ${so(tk.so_giao_dich)} hóa đơn</div>
    </div>
    <div class="nh-kpi info">
      <div class="nh-kpi__label"><span>Độ tin cậy TB</span><i class="fas fa-shield-halved"></i></div>
      <div class="nh-kpi__val">${tk.tin_cay_tb ? (tk.tin_cay_tb * 100).toFixed(1) + '%' : '—'}</div>
      <div class="nh-kpi__note">Trên toàn bộ tập luật</div>
    </div>
    <div class="nh-kpi good">
      <div class="nh-kpi__label"><span>Lift cao nhất</span><i class="fas fa-arrow-trend-up"></i></div>
      <div class="nh-kpi__val">${tk.lift_max || '—'}</div>
      <div class="nh-kpi__note">Luật có giá trị gợi ý cao nhất</div>
    </div>`;

  if (!d.luat.length) {
    document.getElementById('tLuat').innerHTML = '<tbody><tr><td class="loading-state">Chưa khai phá luật nào</td></tr></tbody>';
    return;
  }
  document.getElementById('tLuat').innerHTML = `
    <thead><tr><th>Nếu khách gọi món</th><th>Gợi ý thêm</th>
    <th class="num">Hỗ trợ (Support)</th><th class="num">Tin cậy (Confidence)</th><th class="num">Lift</th></tr></thead>
    <tbody>${d.luat.map(r => `
      <tr>
        <td><b>${r.neu_goi.join(' <span style="color:var(--nh-gold); font-weight:bold">+</span> ')}</b></td>
        <td><b style="color:var(--nh-espresso)">${r.goi_y_them}</b></td>
        <td class="num">${(r.ho_tro * 100).toFixed(2)}%</td>
        <td class="num">${(r.tin_cay * 100).toFixed(1)}%</td>
        <td class="num"><span class="nh-tag ${r.lift >= 3 ? 'gap' : r.lift >= 1.5 ? 'som' : 'on'}">${r.lift.toFixed(2)}x</span></td>
      </tr>`).join('')}
    </tbody>`;

  const top = d.luat[0];
  document.getElementById('insightLuat').innerHTML =
    `<i class="fas fa-lightbulb"></i><span>Luật bán kèm mạnh nhất: Khi khách gọi <b>${top.neu_goi.join(' + ')}</b> thì có tới <b>${(top.tin_cay*100).toFixed(1)}%</b> ` +
    `khả năng sẽ chọn thêm <b>${top.goi_y_them}</b> (cao gấp <b>${top.lift.toFixed(2)} lần</b> mức ngẫu nhiên). ` +
    `Đây là cơ sở tự động gợi ý món trên thực đơn và app gọi món.</span>`;
}

// --- Kích hoạt huấn luyện lại ---
async function chay(loai) {
  const nut = { khach: 'btnKhach', 'nguyen-lieu': 'btnNL', apriori: 'btnAp' }[loai];
  const duong = {
    khach: '/du-bao/api/chay-du-bao-khach',
    'nguyen-lieu': '/du-bao/api/chay-du-bao-nguyen-lieu',
    apriori: '/du-bao/api/chay-apriori',
  }[loai];

  const b = document.getElementById(nut);
  const tt = document.getElementById('trangThai');
  ['btnKhach','btnNL','btnAp'].forEach(x => document.getElementById(x).disabled = true);
  const nhan = b.innerHTML;
  b.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang chạy...';
  tt.textContent = 'Đang huấn luyện mô hình, quá trình này có thể mất vài chục giây...';

  try {
    const r = await fetch(duong, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({}),
    });
    const kq = await r.json();
    if (!r.ok) throw new Error(kq.loi || 'Lỗi không xác định');
    tt.textContent = '✓ Đã hoàn tất lúc ' + new Date().toLocaleTimeString('vi-VN');
    await taiLai();
  } catch (e) {
    tt.textContent = '✗ Thất bại: ' + e.message;
  } finally {
    b.innerHTML = nhan;
    ['btnKhach','btnNL','btnAp'].forEach(x => document.getElementById(x).disabled = false);
  }
}

async function taiLai() {
  const kq = await Promise.allSettled([veKhach(), veDanhGia(), veNguyenLieu(), veLuat()]);
  kq.filter(x => x.status === 'rejected').forEach(x => console.error(x.reason));
}
taiLai();
</script>
</body>
