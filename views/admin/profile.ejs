<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="qt-card">
    <div class="qt-card__head">
        <div>
            <h2>Thông tin cá nhân</h2>
            <p>Cập nhật tên hiển thị và tên đăng nhập của tài khoản quản trị.</p>
        </div>
        <div class="qt-card__act">
            <a class="qt-btn qt-btn--ghost" href="/admin/changepassword"><i class="fas fa-key"></i> Đổi mật khẩu</a>
        </div>
    </div>
    <div class="qt-card__body">
        <% if (msg) { %>
        <div class="qt-alert qt-alert--<%= msgType === 'success' ? 'success' : 'danger' %>">
            <i class="fas <%= msgType === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation' %>"></i>
            <span><%= msg %></span>
        </div>
        <% } %>

        <form class="qt-form" action="/admin/profile" method="POST">
            <div class="qt-field">
                <label for="Name_admin">Tên hiển thị <span class="qt-req">*</span></label>
                <input type="text" id="Name_admin" name="Name_admin" value="<%= admin.Name_admin %>" required />
                <div class="qt-field__hint">Tên này hiển thị ở góc trên bên phải trang quản trị.</div>
            </div>

            <div class="qt-field">
                <label for="adminuser">Tên đăng nhập <span class="qt-req">*</span></label>
                <input type="text" id="adminuser" name="adminuser" value="<%= admin.adminuser %>" required />
            </div>

            <div class="qt-form__actions">
                <button class="qt-btn qt-btn--primary" type="submit" name="submit"><i class="fas fa-floppy-disk"></i> Cập nhật</button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
