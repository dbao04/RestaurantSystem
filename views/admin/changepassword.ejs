<%- include('partials/header') %>
<%- include('partials/sidebar') %>
<div class="grid_10">
    <div class="box round first grid">
        <h2>Đổi mật khẩu</h2>
        <div class="block">
            <% if (msg) { %>
                <div style="padding: 10px; margin-bottom: 20px; border-radius: 4px; background-color: <%= msgType === 'success' ? '#d4edda' : '#f8d7da' %>; color: <%= msgType === 'success' ? '#155724' : '#721c24' %>; border: 1px solid <%= msgType === 'success' ? '#c3e6cb' : '#f5c6cb' %>;">
                    <%= msg %>
                </div>
            <% } %>
            <form action="/admin/changepassword" method="POST">
                <table class="form">
                    <tr>
                        <td><label>Mật khẩu cũ</label></td>
                        <td><input type="password" name="oldpass" placeholder="Nhập mật khẩu cũ..." class="medium" required /></td>
                    </tr>
                    <tr>
                        <td><label>Mật khẩu mới</label></td>
                        <td><input type="password" name="newpass" placeholder="Nhập mật khẩu mới..." class="medium" required /></td>
                    </tr>
                    <tr>
                        <td><label>Xác nhận mật khẩu mới</label></td>
                        <td><input type="password" name="repass" placeholder="Nhập lại mật khẩu mới..." class="medium" required /></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td><input type="submit" name="submit" Value="Đổi mật khẩu" /></td>
                    </tr>
                </table>
            </form>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
