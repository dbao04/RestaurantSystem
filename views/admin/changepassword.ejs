<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="qt-card">
    <div class="qt-card__head">
        <div>
            <h2>Đổi mật khẩu</h2>
            <p>Đặt mật khẩu mới cho tài khoản quản trị của bạn.</p>
        </div>
        <div class="qt-card__act">
            <a class="qt-btn qt-btn--ghost" href="/admin/profile"><i class="fas fa-id-card"></i> Thông tin cá nhân</a>
        </div>
    </div>
    <div class="qt-card__body">
        <% if (msg) { %>
        <div class="qt-alert qt-alert--<%= msgType === 'success' ? 'success' : 'danger' %>">
            <i class="fas <%= msgType === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation' %>"></i>
            <span><%= msg %></span>
        </div>
        <% } %>

        <form class="qt-form" action="/admin/changepassword" method="POST">
            <div class="qt-field">
                <label for="oldpass">Mật khẩu hiện tại <span class="qt-req">*</span></label>
                <input type="password" id="oldpass" name="oldpass" placeholder="Nhập mật khẩu hiện tại" required />
            </div>

            <div class="qt-field">
                <label for="newpass">Mật khẩu mới <span class="qt-req">*</span></label>
                <input type="password" id="newpass" name="newpass" placeholder="Nhập mật khẩu mới" required />
            </div>

            <div class="qt-field">
                <label for="repass">Xác nhận mật khẩu mới <span class="qt-req">*</span></label>
                <input type="password" id="repass" name="repass" placeholder="Nhập lại mật khẩu mới" required />
                <div class="qt-field__hint">Hai ô mật khẩu mới phải trùng khớp.</div>
            </div>

            <div class="qt-form__actions">
                <button class="qt-btn qt-btn--primary" type="submit" name="submit"><i class="fas fa-key"></i> Đổi mật khẩu</button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
