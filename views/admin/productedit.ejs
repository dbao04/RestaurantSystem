<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="qt-card">
    <div class="qt-card__head">
        <div>
            <h2>Sửa món ăn</h2>
            <p>Cập nhật thông tin món “<%= (product.name_mon || '').trim() %>”.</p>
        </div>
        <div class="qt-card__act">
            <a class="qt-btn qt-btn--ghost" href="/admin/productlist"><i class="fas fa-arrow-left"></i> Quay lại danh sách</a>
        </div>
    </div>
    <div class="qt-card__body">
        <form class="qt-form" action="/admin/productedit/<%= product.id_mon %>" method="post" enctype="multipart/form-data">
            <div class="qt-field">
                <label for="name_mon">Tên món <span class="qt-req">*</span></label>
                <input type="text" id="name_mon" name="name_mon" value="<%= product.name_mon %>" required />
            </div>

            <div class="qt-form__row qt-form__row--2">
                <div class="qt-field">
                    <label for="loaimon">Loại món <span class="qt-req">*</span></label>
                    <select id="loaimon" name="loaimon" required>
                        <option value="">— Chọn loại món —</option>
                        <% if (categories) { %>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id_loai %>" <%= cat.id_loai === product.id_loai ? 'selected' : '' %>><%= cat.name_loai %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="qt-field">
                    <label for="gia">Giá (VNĐ) <span class="qt-req">*</span></label>
                    <input type="number" id="gia" name="gia" value="<%= product.gia_mon %>" min="1" required />
                </div>
            </div>

            <div class="qt-field">
                <label for="ghichu">Ghi chú</label>
                <textarea id="ghichu" name="ghichu" placeholder="Mô tả nguyên liệu, cách phục vụ…"><%= product.ghichu_mon %></textarea>
            </div>

            <div class="qt-field">
                <label>Hình ảnh hiện tại</label>
                <div class="qt-preview">
                    <% if (product.images) { %>
                        <img src="/food/<%= product.images %>" alt="<%= product.name_mon %>" onerror="this.src='/logo.png'">
                        <span class="qt-field__hint" style="margin:0"><%= product.images %></span>
                    <% } else { %>
                        <span class="qt-thumb--none"><i class="fas fa-image"></i></span>
                        <span class="qt-field__hint" style="margin:0">Món này chưa có ảnh.</span>
                    <% } %>
                </div>
            </div>

            <div class="qt-field">
                <label>Đổi hình ảnh</label>
                <label class="qt-file">
                    <i class="fas fa-cloud-arrow-up"></i>
                    <span>Chọn ảnh mới từ máy tính</span>
                    <input type="file" name="image" accept="image/*" />
                </label>
                <div class="qt-field__hint">Để trống nếu không muốn đổi ảnh.</div>
            </div>

            <div class="qt-field">
                <label for="tinhtrang">Trạng thái</label>
                <select id="tinhtrang" name="tinhtrang">
                    <option value="1" <%= product.tinhtrang == 1 ? 'selected' : '' %>>Đang phục vụ</option>
                    <option value="0" <%= product.tinhtrang == 0 ? 'selected' : '' %>>Ngưng phục vụ</option>
                </select>
            </div>

            <div class="qt-form__actions">
                <button class="qt-btn qt-btn--primary" type="submit" name="submit"><i class="fas fa-floppy-disk"></i> Cập nhật</button>
                <a class="qt-btn qt-btn--ghost" href="/admin/productlist">Hủy</a>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
