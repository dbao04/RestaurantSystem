<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="grid_10">
    <div class="box round first grid">
        <h2>Sửa món ăn</h2>
        <div class="block">   
            <form action="/admin/productedit/<%= product.id_mon %>" method="post" enctype="multipart/form-data">
                <table class="form">
                    <tr>
                        <td><label>Tên món</label></td>
                        <td><input type="text" name="name_mon" value="<%= product.name_mon %>" placeholder="Enter Name..." class="medium" required /></td>
                    </tr>
                    <tr>
                        <td><label>Loại món</label></td>
                        <td>
                            <select id="select" name="loaimon" required>
                                <option value="">-----Chọn loại món-----</option>
                                <% if (categories) { %>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat.id_loai %>" <%= cat.id_loai === product.id_loai ? 'selected' : '' %>><%= cat.name_loai %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td><label>Giá</label></td>
                        <td><input type="number" name="gia" value="<%= product.gia_mon %>" placeholder="Enter Price..." class="medium" min="1" required /></td>
                    </tr>
                    <tr>
                        <td style="vertical-align: top; padding-top: 9px;"><label>Ghi chú</label></td>
                        <td><textarea name="ghichu" class="tinymce" style="width: 100%; height: 100px;"><%= product.ghichu_mon %></textarea></td>
                    </tr>
                    <tr>
                        <td><label>Hình ảnh hiện tại</label></td>
                        <td>
                            <% if(product.images) { %>
                                <img src="/food/<%= product.images %>" height="80" width="80" />
                            <% } %>
                        </td>
                    </tr>
                    <tr>
                        <td><label>Tải hình mới</label></td>
                        <td><input type="file" name="image" /> (Để trống nếu không muốn đổi ảnh)</td>
                    </tr>
                    <tr>
                        <td><label>Trạng thái</label></td>
                        <td>
                            <select id="select" name="tinhtrang">
                                <option value="1" <%= product.tinhtrang == 1 ? 'selected' : '' %>>Phục vụ</option>
                                <option value="0" <%= product.tinhtrang == 0 ? 'selected' : '' %>>Ngưng phục vụ</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td><input type="submit" name="submit" Value="Save" /></td>
                    </tr>
                </table>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
