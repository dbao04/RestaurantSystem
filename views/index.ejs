<%- include('partials/header', { heroNav: true, activeNav: 'home' }) %>

<%
  /*
    MÓN THẬT THAY CHO ẢNH STOCK

    Bảy ảnh nền cũ là ảnh của một nhà hàng Âu (đầu bếp mũ toque bày bít tết,
    croissant với cà phê, oải hương Provence...). Nay nền là hoa văn Nhật vẽ
    bằng SVG trong css/nhahang.css, còn "ảnh" là chính món trong thực đơn —
    PNG nền trong suốt nên đặt lên nền tối là gọn.

    `monTrangTri` do route `/` cắt ra từ cùng một truy vấn với khối "Món đặc
    sắc", nên không món nào xuất hiện hai lần trên cùng một trang.

    Mọi chỗ dùng đều phải chịu được mảng RỖNG: cơ sở dữ liệu lỗi hay thực đơn
    chưa có ảnh thì trang vẫn phải dựng được, chỉ là không có món nổi lên.
  */
  var dsTrangTri = (typeof monTrangTri !== 'undefined' && monTrangTri) ? monTrangTri : [];
  function monTT(i) { return dsTrangTri.length ? dsTrangTri[i % dsTrangTri.length] : null; }
%>

<!-- ================= HERO (SLIDER) ================= -->
<%
  /*
    BANNER DANG SLIDE. Slide 1 (chao mung) luon co; cac slide sau chi hien khi
    co du lieu that: ma giam gia dang chay (discount_codes), mon ban chay
    (hopdong), va slide dat tiec / Sanh Gala.

    Moi slide la mot o luoi chong len nhau (grid-area 1/1) chu khong
    position:absolute - hero cao theo slide cao nhat, khong cat chu tren dien
    thoai. Hoa van/anh cua tung slide la phan tu absolute bam vao .nh-hero.
  */
  var dsKM = (typeof khuyenMai !== 'undefined' && khuyenMai) ? khuyenMai : [];
  var dsBC = (typeof banChay !== 'undefined' && banChay) ? banChay : [];
  var vnd = function (n) { return Number(n || 0).toLocaleString('vi-VN') + 'đ'; };
  var giaTriKM = function (k) {
    return k.discount_type === 'percentage'
      ? Number(k.discount_value) + '%'
      : (Number(k.discount_value) >= 1000 ? Math.round(Number(k.discount_value) / 1000) + 'K' : vnd(k.discount_value));
  };
  var tenGon = function (m) {
    var t = String(tenMon(m).chinh || m.name_mon || '').replace(/^[A-Z]{0,4}\d{1,3}\s*-\s*/, '').trim();
    return t.toLowerCase().replace(/(^|\s)(\S)/g, function (x, a, c) { return a + c.toUpperCase(); });
  };
  var soSlide = 1 + dsKM.length + (dsBC.length ? 1 : 0) + 1;
  var stt = 0;
%>
<header class="nh-hero nh-hero--slider" aria-roledescription="carousel" aria-label="Ưu đãi và nổi bật">
  <div class="nh-hero__bg nh-wa-song"></div>
  <div class="nh-hero__veil"></div>

  <div class="nh-slides" id="nhSlides">

    <!-- ---------- SLIDE 1: CHAO MUNG ---------- -->
    <div class="nh-slide is-active" data-slide="<%= stt++ %>" role="group" aria-roledescription="slide" aria-label="1 / <%= soSlide %>">
    <%
      var heroDishes = [];
      for (var hIdx = 0; hIdx < 4; hIdx++) {
        var dItem = monTT(hIdx);
        if (dItem) heroDishes.push(dItem);
      }
    %>
    <% if (heroDishes.length > 0) { %>
      <svg class="nh-hero__enso" viewBox="0 0 200 200" aria-hidden="true">
        <circle cx="100" cy="100" r="84" fill="none"
                stroke="url(#nh-enso-mau)" stroke-width="5.5" stroke-linecap="round"
                stroke-dasharray="455 73" transform="rotate(34 100 100)"/>
        <defs>
          <linearGradient id="nh-enso-mau" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0"   stop-color="#c8a24b" stop-opacity=".85"/>
            <stop offset="0.6" stop-color="#c8a24b" stop-opacity=".35"/>
            <stop offset="1"   stop-color="#c8a24b" stop-opacity=".05"/>
          </linearGradient>
        </defs>
      </svg>
      <div class="nh-hero__quang" aria-hidden="true"></div>

      <!-- Khối 4 món ăn Hero -->
      <div class="nh-hero__showcase">
        <div class="nh-hero__dishes">
          <% heroDishes.forEach(function(m, idx) { %>
            <div class="nh-hero__dish-item <%= idx === 0 ? 'is-active' : '' %>" id="heroDish_<%= idx %>">
              <img class="nh-hero__mon" src="/food/<%= m.images %>"
                   alt="<%= tenMon(m).chinh %>" loading="<%= idx === 0 ? 'eager' : 'lazy' %>">
              <div class="nh-hero__dish-tag">
                <span class="nh-hero__dish-price"><i class="fas fa-tag" style="font-size:0.8rem;margin-right:4px;"></i><%= Number(m.gia_mon || 0).toLocaleString('vi-VN') %> ₫</span>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- 4 Nút thumbnail chọn nhanh món -->
        <div class="nh-hero__thumbs">
          <% heroDishes.forEach(function(m, idx) { %>
            <button type="button" class="nh-hero__thumb-btn <%= idx === 0 ? 'is-active' : '' %>"
                    data-index="<%= idx %>" title="<%= tenMon(m).chinh %>">
              <img src="/food/<%= m.images %>" alt="<%= tenMon(m).chinh %>">
            </button>
          <% }) %>
        </div>
      </div>
    <% } %>
      <div class="nh-container">
        <div class="nh-hero__inner">
          <span class="nh-eyebrow"><%= t('trang_chu.eyebrow') %></span>
          <h1><%= t('trang_chu.tieu_de_1') %> <span><%= t('trang_chu.tieu_de_nhan') %></span><br><%= t('trang_chu.tieu_de_2') %></h1>
          <p><%= t('trang_chu.mo_ta') %></p>
          <div class="nh-hero__actions">
            <a href="/datban" class="nh-btn nh-btn--gold" style="font-weight:700;"><i class="fas fa-calendar-check"></i> <%= t('chung.dat_ban_ngay') %></a>
            <a href="/menu" class="nh-btn nh-btn--ghost"><i class="fas fa-book-open"></i> <%= t('chung.xem_thuc_don') %></a>
            <a href="/giao-hang" class="nh-btn nh-btn--ghost"><i class="fas fa-motorcycle"></i> <%= t('gio_hang.dat_mon_giao_tan_noi') %></a>
          </div>
        </div>
      </div>
    </div>

    <!-- ---------- SLIDE KHUYEN MAI (moi ma mot slide) ---------- -->
    <% dsKM.forEach(function (k) { %>
    <div class="nh-slide nh-slide--km" data-slide="<%= stt %>" role="group" aria-roledescription="slide" aria-label="<%= ++stt %> / <%= soSlide %>" aria-hidden="true">
      <div class="nh-km-ve" aria-hidden="true">
        <div class="nh-km-ve__trai">
          <span class="nh-km-ve__nhan">Giảm</span>
          <b class="nh-km-ve__so"><%= giaTriKM(k) %></b>
          <% if (k.max_discount_amount && k.discount_type === 'percentage') { %><span class="nh-km-ve__phu">tối đa <%= vnd(k.max_discount_amount) %></span><% } %>
        </div>
        <div class="nh-km-ve__phai">
          <span>Mã ưu đãi</span>
          <b><%= k.code %></b>
          <small>HSD: <%= k.han %></small>
        </div>
      </div>
      <div class="nh-container">
        <div class="nh-hero__inner">
          <span class="nh-eyebrow">Ưu đãi đặc biệt</span>
          <h1>Giảm ngay <span><%= giaTriKM(k) %></span><br>cho hóa đơn</h1>
          <p><% if (k.min_order_value) { %>Áp dụng cho đơn từ <%= vnd(k.min_order_value) %><% if (k.max_discount_amount && k.discount_type === 'percentage') { %>, giảm tối đa <%= vnd(k.max_discount_amount) %><% } %>. <% } %>Nhập mã khi thanh toán đơn giao tận nơi hoặc tại quầy – hạn dùng đến <%= k.han %>.</p>
          <div class="nh-hero__actions">
            <button type="button" class="nh-btn nh-btn--gold nh-km-copy" data-ma="<%= k.code %>"><i class="fas fa-copy"></i> <span>Sao chép mã <%= k.code %></span></button>
            <a href="/giao-hang" class="nh-btn nh-btn--ghost"><i class="fas fa-motorcycle"></i> <%= t('gio_hang.dat_mon_giao_tan_noi') %></a>
          </div>
        </div>
      </div>
    </div>
    <% }) %>

    <!-- ---------- SLIDE BAN CHAY ---------- -->
    <% if (dsBC.length) { var top = dsBC[0]; %>
    <div class="nh-slide nh-slide--bc" data-slide="<%= stt %>" role="group" aria-roledescription="slide" aria-label="<%= ++stt %> / <%= soSlide %>" aria-hidden="true">
      <div class="nh-hero__quang" aria-hidden="true"></div>
      <div class="nh-bc-mon">
        <img src="/food/<%= top.images %>" alt="<%= tenGon(top) %>" loading="lazy">
        <span class="nh-bc-mon__huy"><i class="fas fa-crown"></i> #1 Best Seller</span>
      </div>
      <div class="nh-container">
        <div class="nh-hero__inner">
          <span class="nh-eyebrow">Best Seller</span>
          <h1>Món bán chạy <span>nhất</span><br>tại Bảo Đoàn</h1>
          <ol class="nh-bc-ds">
            <% dsBC.forEach(function (m, i) { %>
              <li>
                <a href="/detail?monid=<%= m.id_mon %>">
                  <span class="nh-bc-ds__hang">#<%= i + 1 %></span>
                  <img src="/food/<%= m.images %>" alt="" loading="lazy">
                  <span class="nh-bc-ds__ten"><%= tenGon(m) %><small><%= m.da_ban.toLocaleString('vi-VN') %> phần đã bán</small></span>
                  <span class="nh-bc-ds__gia"><%= vnd(m.gia_mon) %></span>
                </a>
              </li>
            <% }) %>
          </ol>
          <div class="nh-hero__actions">
            <a href="/detail?monid=<%= top.id_mon %>" class="nh-btn nh-btn--gold"><i class="fas fa-utensils"></i> Gọi món #1 ngay</a>
            <a href="/menu" class="nh-btn nh-btn--ghost"><i class="fas fa-book-open"></i> <%= t('chung.xem_thuc_don') %></a>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- ---------- SLIDE DAT TIEC ---------- -->
    <div class="nh-slide nh-slide--tiec" data-slide="<%= stt %>" role="group" aria-roledescription="slide" aria-label="<%= ++stt %> / <%= soSlide %>" aria-hidden="true">
      <div class="nh-slide__anh" style="background-image:url('/images/khong-gian/gala-1.jpg')" aria-hidden="true"></div>
      <div class="nh-container">
        <div class="nh-hero__inner">
          <span class="nh-eyebrow">Sảnh Gala mới</span>
          <h1>Tiệc cưới · Sinh nhật<br><span>Party</span> trọn gói</h1>
          <p>Sảnh tiệc 50–300 khách với sân khấu, đèn chùm và 12 thực đơn Nhật Bản soạn riêng cho từng dịp – chỉ từ 2.790.000đ/bàn 10 khách.</p>
          <div class="nh-hero__actions">
            <a href="/dat-tiec" class="nh-btn nh-btn--gold"><i class="fas fa-glass-cheers"></i> Xem thực đơn tiệc</a>
            <a href="/khong-gian" class="nh-btn nh-btn--ghost"><i class="fas fa-images"></i> Xem không gian</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="nh-slider-nav">
    <button type="button" class="nh-slider-nav__nut" data-slider="truoc" aria-label="Slide trước"><i class="fas fa-chevron-left"></i></button>
    <div class="nh-slider-nav__cham">
      <% for (var c = 0; c < soSlide; c++) { %>
        <button type="button" data-den="<%= c %>" class="<%= c === 0 ? 'is-active' : '' %>" aria-label="Đến slide <%= c + 1 %>" aria-current="<%= c === 0 %>"><span><i></i></span></button>
      <% } %>
    </div>
    <button type="button" class="nh-slider-nav__nut" data-slider="sau" aria-label="Slide sau"><i class="fas fa-chevron-right"></i></button>
  </div>
  <div class="nh-hero__scroll"><%= t('trang_chu.cuon_xuong') %><span></span></div>
</header>



<!-- ================= GIỚI THIỆU ================= -->
<section class="nh-section nh-section--cream">
  <div class="nh-container nh-about">
    <div class="nh-about__imgs nh-about__imgs--mon nh-reveal">
      <% [1, 2].forEach(function (i) { var m = monTT(i); %>
        <div class="nh-mon-khung <%= i % 2 ? 'nh-wa-shippo' : 'nh-wa-song' %>">
          <% if (m) { %>
            <img src="/food/<%= m.images %>" alt="<%= tenMon(m).chinh %>" loading="lazy">
          <% } %>
        </div>
      <% }) %>
      <div class="nh-about__badge"><b><%= (typeof thongKe!=='undefined'&&thongKe)?thongKe.soMon:'' %></b><span><%= t('trang_chu.mon_dac_sac') %></span></div>
    </div>
    <div class="nh-about__text nh-reveal" data-delay="1">
      <span class="nh-eyebrow"><%= t('trang_chu.ve_chung_toi') %></span>
      <h2 class="nh-section-title"><%= t('trang_chu.cau_chuyen') %><br><%= t('chung.ten_nha_hang') %></h2>
      <div class="nh-divider" style="margin-left:0"></div>
      <p><%- t('trang_chu.gioi_thieu_1') %></p>
      <p><%- t('trang_chu.gioi_thieu_2') %></p>
      <div class="nh-sign"><%- t('trang_chu.ky_ten') %></div>
      <div style="margin-top:1.6rem"><a href="/about" class="nh-btn nh-btn--dark"><%= t('chung.tim_hieu_them') %></a></div>
    </div>
  </div>
</section>

<!-- ================= MÓN NỔI BẬT ================= -->
<section class="nh-section nh-section--cream2">
  <div class="nh-container">
    <div class="nh-head nh-center nh-reveal">
      <span class="nh-eyebrow"><%= t('trang_chu.mon_dac_sac_eyebrow') %></span>
      <h2 class="nh-section-title"><%= t('trang_chu.mon_dac_sac') %></h2>
      <div class="nh-divider"></div>
      <p class="nh-lead"><%= t('trang_chu.mon_dac_sac_mo_ta') %></p>
    </div>

    <% var ds = (typeof mons !== 'undefined' && mons) ? mons : []; %>
    <% if (ds.length) { %>
      <div class="nh-grid">
        <% ds.forEach(function(m, i){ %>
          <article class="nh-dish nh-reveal" data-delay="<%= (i % 3) + 1 %>">
            <div class="nh-dish__media">
              <img src="/food/<%= m.images %>" alt="<%= tenMon(m).chinh %>" loading="lazy"
                   onerror="this.onerror=null;this.src='/mon-thay-the.svg'">
              <span class="nh-dish__price"><%= formatMoney(m.gia_mon) %></span>
            </div>
            <div class="nh-dish__body">
              <h3><%= tenMon(m).chinh %></h3>
              <% var tm = tenMon(m); %>
              <p><%= tm.phu || t('trang_chu.mon_mac_dinh_mo_ta') %></p>
              <a href="/detail?monid=<%= m.id_mon %>" class="nh-dish__cta"><%= t('chung.dat_mon_ngay') %> <i class="fas fa-arrow-right"></i></a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p class="nh-center nh-lead"><%= t('chung.dang_cap_nhat') %></p>
    <% } %>

    <div class="nh-center nh-reveal" style="margin-top:3rem">
      <a href="/menu" class="nh-btn nh-btn--gold"><i class="fas fa-utensils"></i> <%= t('chung.xem_toan_bo_thuc_don') %></a>
    </div>
  </div>
</section>

<!-- ================= VÌ SAO CHỌN CHÚNG TÔI ================= -->
<section class="nh-section nh-section--dark">
  <div class="nh-container">
    <div class="nh-head nh-center nh-reveal">
      <span class="nh-eyebrow"><%= t('trang_chu.vi_sao_eyebrow') %></span>
      <h2 class="nh-section-title"><%= t('trang_chu.vi_sao') %></h2>
      <div class="nh-divider"></div>
    </div>
    <div class="nh-features">
      <div class="nh-feature nh-reveal" data-delay="1">
        <div class="nh-feature__icon"><i class="fas fa-fish"></i></div>
        <h3><%= t('trang_chu.the_1_tieu_de') %></h3>
        <p><%= t('trang_chu.the_1_mo_ta') %></p>
      </div>
      <div class="nh-feature nh-reveal" data-delay="2">
        <div class="nh-feature__icon"><i class="fas fa-award"></i></div>
        <h3><%= t('trang_chu.the_2_tieu_de') %></h3>
        <p><%= t('trang_chu.the_2_mo_ta') %></p>
      </div>
      <div class="nh-feature nh-reveal" data-delay="3">
        <div class="nh-feature__icon"><i class="fas fa-torii-gate"></i></div>
        <h3><%= t('trang_chu.the_3_tieu_de') %></h3>
        <p><%= t('trang_chu.the_3_mo_ta') %></p>
      </div>
      <div class="nh-feature nh-reveal" data-delay="3">
        <div class="nh-feature__icon"><i class="fas fa-concierge-bell"></i></div>
        <h3><%= t('trang_chu.the_4_tieu_de') %></h3>
        <p><%= t('trang_chu.the_4_mo_ta') %></p>
      </div>
    </div>

    <% var tk = (typeof thongKe !== 'undefined' && thongKe) ? thongKe : {soMon:0,soDanhMuc:0,soNhanVien:0,soDon:0}; %>
    <div class="nh-stats nh-reveal" style="margin-top:4rem">
      <div class="nh-stat"><b data-count="<%= tk.soMon %>"><%= tk.soMon %></b><span><%= t('trang_chu.tk_mon') %></span></div>
      <div class="nh-stat"><b data-count="<%= tk.soDanhMuc %>"><%= tk.soDanhMuc %></b><span><%= t('trang_chu.tk_danh_muc') %></span></div>
      <div class="nh-stat"><b data-count="<%= tk.soNhanVien %>"><%= tk.soNhanVien %></b><span><%- t('trang_chu.tk_nhan_vien') %></span></div>
      <div class="nh-stat"><b data-count="<%= tk.soDon %>"><%= tk.soDon.toLocaleString('vi-VN') %></b><span><%= t('trang_chu.tk_don') %></span></div>
    </div>
  </div>
</section>

<!-- ================= THƯ VIỆN ẢNH ================= -->
<section class="nh-section nh-section--cream">
  <div class="nh-container">
    <div class="nh-head nh-center nh-reveal">
      <%
        /* Tiêu đề phải nói đúng thứ bên dưới nó.

           Bản cũ là "Không gian & ẩm thực" vì lưới này từng có ảnh phòng ăn,
           bàn tiệc và đồ uống. Nay lưới chỉ còn các món trong thực đơn, nên
           giữ chữ "không gian" là hứa một thứ trang không đưa ra. */
      %>
      <span class="nh-eyebrow"><%= t('trang_chu.thu_vien_eyebrow') %></span>
      <h2 class="nh-section-title"><%= t('trang_chu.thu_vien') %></h2>
      <div class="nh-divider"></div>
      <p class="nh-lead"><%= t('trang_chu.thu_vien_mo_ta') %></p>
    </div>
    <%
      /* Sáu ô, ô thứ nhất và thứ tư cao gấp đôi (lớp `tall`) — giữ đúng bố cục
         so le của bản cũ để lưới không bị vỡ nhịp. Bấm vào ô thì mở trang món
         chứ không phóng to ảnh: người xem đang muốn đặt món, không muốn ngắm ảnh. */
      var oCao = [0, 3];
    %>
    <div class="nh-gallery nh-gallery--mon nh-reveal">
      <% for (var i = 0; i < 6; i++) { var m = monTT(i); %>
        <%
          /* Xen kẽ ba hoa văn theo ô. Sáu ô cùng một nền thì lưới trông như
             một mảng phẳng; đổi nền làm mắt nhận ra đây là sáu món riêng. */
          var nen = ['nh-wa-song', 'nh-wa-koshi', 'nh-wa-shippo'][i % 3];
        %>
        <a class="<%= nen %> <%= oCao.indexOf(i) >= 0 ? 'tall' : '' %>"
           href="<%= m ? '/detail?monid=' + m.id_mon : '/menu' %>"
           data-ten="<%= m ? tenMon(m).chinh : '' %>">
          <% if (m) { %>
            <img src="/food/<%= m.images %>" alt="<%= tenMon(m).chinh %>" loading="lazy">
          <% } %>
        </a>
      <% } %>
    </div>
  </div>
</section>

<!-- ================= CẢM NHẬN ================= -->
<section class="nh-section nh-section--dark">
  <div class="nh-container-narrow nh-quote nh-reveal">
    <div class="nh-quote__mark">&ldquo;</div>
    <p><%= t('trang_chu.cam_nhan') %></p>
    <cite><%= t('trang_chu.cam_nhan_ky') %></cite>
  </div>
</section>

<!-- ================= CTA ĐẶT BÀN ================= -->
<section class="nh-cta">
  <div class="nh-cta__bg nh-wa-koshi"></div>
  <div class="nh-cta__veil"></div>
  <div class="nh-container nh-cta__inner nh-reveal">
    <span class="nh-eyebrow"><%= t('trang_chu.cta_eyebrow') %></span>
    <h2><%- t('trang_chu.cta_tieu_de') %></h2>
    <p><%= t('trang_chu.cta_mo_ta') %></p>
    <a href="/datban" class="nh-btn nh-btn--gold"><i class="fas fa-calendar-check"></i> <%= t('chung.dat_ban_ngay') %></a>
  </div>
</section>

<script>
  // SLIDER BANNER: tu chuyen DEU 5 giay, KE CA khi re chuot vao (theo yeu cau chu quan).
  // Bam chuyen tay thi dem lai 5 giay tu dau.
  // Nguoi bat "giam chuyen dong" (Windows: tat Animation effects) van duoc tu
  // chuyen nhung cham hon (8 giay) va chi mo dan - CSS bo het truot, phong to.
  (function () {
    var slides = document.querySelectorAll('#nhSlides .nh-slide');
    var cham = document.querySelectorAll('.nh-slider-nav__cham [data-den]');
    var hero = document.querySelector('.nh-hero--slider');
    if (slides.length < 2 || !hero) return;
    var cur = 0, timer = null;
    var KHOANG = 5000;

    function den(i) {
      cur = (i + slides.length) % slides.length;
      slides.forEach(function (s, k) {
        var on = k === cur;
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-hidden', on ? 'false' : 'true');
        s.querySelectorAll('a, button').forEach(function (el) { el.tabIndex = on ? 0 : -1; });
      });
      cham.forEach(function (c, k) {
        c.classList.toggle('is-active', k === cur);
        c.setAttribute('aria-current', k === cur ? 'true' : 'false');
      });
      hero.style.setProperty('--nh-slide-time', KHOANG + 'ms');
    }
    function chay() {
      clearInterval(timer);
      timer = setInterval(function () { den(cur + 1); }, KHOANG);
      // Chay lai thanh tien trinh tu dau cho khop voi bo dem vua dat lai
      var thanh = document.querySelector('.nh-slider-nav__cham .is-active i');
      if (thanh) { thanh.style.animation = 'none'; void thanh.offsetWidth; thanh.style.animation = ''; }
    }
    document.querySelectorAll('[data-slider]').forEach(function (b) {
      b.addEventListener('click', function () { den(cur + (b.getAttribute('data-slider') === 'sau' ? 1 : -1)); chay(); });
    });
    cham.forEach(function (c) {
      c.addEventListener('click', function () { den(Number(c.getAttribute('data-den'))); chay(); });
    });

    // Vuot tren dien thoai
    var x0 = null;
    hero.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
    hero.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 50) { den(cur + (dx < 0 ? 1 : -1)); chay(); }
    });

    // Nut sao chep ma giam gia
    document.querySelectorAll('.nh-km-copy').forEach(function (b) {
      b.addEventListener('click', function () {
        var ma = b.getAttribute('data-ma'), nhan = b.querySelector('span'), cu = nhan.textContent;
        var xong = function () { nhan.textContent = 'Đã sao chép ' + ma; setTimeout(function () { nhan.textContent = cu; }, 2000); };
        if (navigator.clipboard) navigator.clipboard.writeText(ma).then(xong, xong); else xong();
      });
    });

    den(0);
    chay();
  })();
</script>

<script>
  // Chuyển đổi 4 món ăn ở Hero Banner
  (function () {
    var items = document.querySelectorAll('.nh-hero__dish-item');
    var thumbs = document.querySelectorAll('.nh-hero__thumb-btn');
    if (!items.length || !thumbs.length) return;

    var cur = 0;
    var timer = null;

    function activeDish(idx) {
      cur = (idx + items.length) % items.length;
      items.forEach(function (el, i) { el.classList.toggle('is-active', i === cur); });
      thumbs.forEach(function (el, i) { el.classList.toggle('is-active', i === cur); });
    }

    thumbs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var idx = Number(this.getAttribute('data-index') || 0);
        activeDish(idx);
        startAuto();
      });
    });

    function startAuto() {
      if (timer) clearInterval(timer);
      timer = setInterval(function () {
        activeDish(cur + 1);
      }, 4000);
    }

    startAuto();
  })();

  // Đếm số cho phần thống kê khi cuộn tới.
  (function () {
    var stats = document.querySelectorAll('.nh-stat b[data-count]');
    if (!('IntersectionObserver' in window) || !stats.length) return;
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        var el = e.target, dich = +el.getAttribute('data-count'), t0 = null, gt = el.textContent;
        function step(ts) {
          if (!t0) t0 = ts; var p = Math.min((ts - t0) / 1600, 1);
          var val = Math.floor(p * dich);
          el.textContent = dich >= 50000 ? (val.toLocaleString('vi-VN') + (p === 1 ? '+' : '')) : val;
          if (p < 1) requestAnimationFrame(step); else el.textContent = gt;
        }
        requestAnimationFrame(step); io.unobserve(el);
      });
    }, { threshold: 0.5 });
    stats.forEach(function (s) { io.observe(s); });
  })();
</script>

