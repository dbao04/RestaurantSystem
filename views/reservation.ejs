              </button>
            </div>
          </div>
        </div>

        <!-- ============================ BƯỚC 4: XÁC NHẬN ==================== -->
        <div class="db-man" id="man4" data-buoc="4">
          <div class="nh-panel">
            <h3 class="nh-panel__title"><i class="fas fa-clipboard-check"></i> <%= t('dat_ban_moi.b4_tieu_de') %></h3>
            <div id="dbBaoGui"></div>
            <dl class="db-xemlai" id="dbXemLai"></dl>

            <div class="db-bao db-bao--nhac" style="margin-top:1.4rem">
              <i class="fas fa-info-circle"></i>
              <div><%- t('dat_ban_moi.dieu_khoan').replace('{giu}', cauHinh.giu_ban_phut) %></div>
            </div>

            <div class="db-dieuhuong">
              <button type="button" class="nh-btn nh-btn--outline" data-lui="1">
                <i class="fas fa-arrow-left"></i> <%= t('dat_ban_moi.quay_lai') %>
              </button>
              <button type="button" class="nh-btn nh-btn--gold" id="dbGui">
                <i class="fas fa-paper-plane"></i> <%= t('dat_ban_moi.gui_yeu_cau') %>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================ TÓM TẮT BÊN PHẢI ==================== -->
      <aside class="nh-panel db-tomtat" aria-live="polite">
        <h3 class="nh-panel__title"><i class="fas fa-receipt"></i> <%= t('dat_ban_moi.tom_tat') %></h3>
        <div id="dbTomTat"></div>
        <div id="dbTomTatCoc"></div>
        <p class="nh-hint" style="margin-top:1.2rem">
          <i class="fas fa-phone"></i> <%= t('dat_ban_moi.can_ho_tro') %>
        </p>
        <a href="/dat-ban/tra-cuu" class="nh-btn nh-btn--outline nh-btn--sm" style="margin-top:.8rem;width:100%;justify-content:center">
          <i class="fas fa-search"></i> <%= t('dat_ban_moi.tra_cuu') %>
        </a>
      </aside>
    </div>
  </div>
</section>

<script>
(function () {
  'use strict';

  /*
    Tu dien nhan giao dien, nap mot lan duoi dang JSON.

    Truoc day moi chuoi duoc nhung thang vao JavaScript bang the xuat EJS.
    Cach do chay dung, nhung no gai mot cai bay: the xuat escape ky tu HTML, ma noi
    dung the <script> KHONG duoc trinh duyet giai ma thuc the nguoc lai. Nen chi
    can mot ban dich chua dau nhay don ("Let's...") la man hinh hien ra
    "Let&#39;s" - va khong ai phat hien duoc cho den khi doi sang ngon ngu do.

    JSON.stringify + doi dau '<' thanh \u003c: khong ban dich nao dong duoc som
    the script (chi mot chuoi chua the dong la ca khoi JavaScript ben duoi chet),
    va moi ky tu deu qua duoc nguyen ven.
  */
  var T = <%- JSON.stringify(nhan).replace(/</g, '\\u003c') %>;

  var CF = <%- JSON.stringify(cauHinh) %>;
  var KHU = <%- JSON.stringify(khuVuc) %>;

  /*
    Trang thai cua ca man hinh nam trong MOT doi tuong.

    Khong doc nguoc lai tu DOM khi can gia tri: DOM la noi HIEN THI trang thai,
    khong phai noi luu no. Doc nguoc tu DOM la cach nhanh nhat de co hai nguon
    su that - vi du so khach hien tren tom tat lech voi so khach thuc su gui len.
  */
  var S = {
    buoc: 1,
    ngay: document.getElementById('dbNgay').value,
    soKhach: 2,
    khuVuc: '',
    gio: '',
    thoiLuong: null,
    ban: [],        // id ban khach tu chon; rong = de nha hang xep
    tongChoDaChon: 0,
    the: [],
    coc: null,
    goiY: null      // to hop ban he thong de xuat
  };

  // Buoc 2 chi ton tai khi quan ly cho phep khach tu chon ban.
  var BUOC = CF.cho_chon_ban ? [1, 2, 3, 4] : [1, 3, 4];
  var TEN_BUOC = {
    1: T['dat_ban_moi.b1_ngan'],
    2: T['dat_ban_moi.b2_ngan'],
    3: T['dat_ban_moi.b3_ngan'],
    4: T['dat_ban_moi.b4_ngan']
  };

  var $ = function (id) { return document.getElementById(id); };
  var tien = function (n) { return Number(n || 0).toLocaleString('vi-VN') + 'đ'; };
  var ngayVN = function (s) { return String(s || '').split('-').reverse().join('/'); };

  /** Chen van ban an toan - khong bao gio dung innerHTML voi du lieu tu API. */
  function chu(the, lop, noiDung) {
    var n = document.createElement(the);
    if (lop) n.className = lop;
    if (noiDung != null) n.textContent = noiDung;
    return n;
  }

  function bao(khung, kieu, thongDiep, phuThem) {
    khung.innerHTML = '';
    if (!thongDiep) return;
    var hop = chu('div', 'db-bao db-bao--' + kieu);
    var i = document.createElement('i');
    i.className = 'fas ' + (kieu === 'loi' ? 'fa-exclamation-circle'
      : kieu === 'ok' ? 'fa-check-circle' : 'fa-info-circle');
    hop.appendChild(i);
    var than = chu('div', null, thongDiep);
    if (phuThem) than.appendChild(phuThem);
    hop.appendChild(than);
    khung.appendChild(hop);
  }

  // ------------------------------------------------------------- thanh buoc

  function veThanhBuoc() {
    var ol = $('dbBuoc');
    ol.innerHTML = '';
    BUOC.forEach(function (b, i) {
      var li = chu('li', 'db-buoc__o');
      if (b === S.buoc) li.setAttribute('aria-current', 'step');
      if (BUOC.indexOf(S.buoc) > i) li.setAttribute('data-xong', '1');
      li.appendChild(chu('span', 'db-buoc__so', String(i + 1)));
      li.appendChild(document.createTextNode(TEN_BUOC[b]));
      ol.appendChild(li);
    });
  }

  function den(buoc) {
    S.buoc = buoc;
    [1, 2, 3, 4].forEach(function (b) {
      var m = $('man' + b);
      if (m) m.classList.toggle('hien', b === buoc);
    });
    veThanhBuoc();
    veTomTat();
    // Cuon len dau khung noi dung, khong phai dau trang: khach vua bam nut o
    // cuoi man hinh truoc, keo ho ve tan dinh trang la mot buoc thua.
    var moc = $('dbBuoc');
    if (moc) moc.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (buoc === 2) taiSoDo();
    if (buoc === 4) veXemLai();
  }

  function tienTu(buoc) {
    var i = BUOC.indexOf(buoc);
    return BUOC[i + 1] || buoc;
  }
  function luiTu(buoc) {
    var i = BUOC.indexOf(buoc);
    return BUOC[i - 1] || buoc;
  }

  // -------------------------------------------------------------- bước 1

  // Chon nhanh so khach: cham mot lan thay vi go so - nhanh hon han tren dien thoai.
  (function veNhanhKhach() {
    var khung = $('dbNhanhKhach');
    [2, 4, 6, 8, 10, 12].forEach(function (n) {
      if (n > CF.toi_da_khach) return;
      var l = chu('label', 'nh-chip');
      var o = document.createElement('input');
      o.type = 'radio'; o.name = 'dbNhanh'; o.value = String(n);
      if (n === 2) o.checked = true;
      o.addEventListener('change', function () {
        $('dbSoKhach').value = n;
        S.soKhach = n;
        taiKhungGio();
      });
      l.appendChild(o);
      l.appendChild(chu('span', null, n + ' ' + T['dat_ban_moi.khach']));
      khung.appendChild(l);
    });
  })();

  var henTai = null;
  function taiKhungGioHoan() {
    clearTimeout(henTai);
    henTai = setTimeout(taiKhungGio, 320);
  }

  async function taiKhungGio() {
    var khung = $('dbGio');
    var baoKhung = $('dbBaoGio');
    khung.innerHTML = '';
    S.gio = '';
    $('dbTiep1').disabled = true;
    baoKhung.innerHTML = '';

    var tai = chu('p', 'nh-hint');
    tai.appendChild(chu('span', 'db-tai'));
    tai.appendChild(document.createTextNode(' ' + T['dat_ban_moi.dang_tim_gio']));
    khung.appendChild(tai);

    var q = new URLSearchParams({ ngay: S.ngay, so_khach: S.soKhach });
    if (S.khuVuc) q.set('khu_vuc', S.khuVuc);

    try {
      var kq = await fetch('/api/dat-ban/khung-gio?' + q).then(function (r) { return r.json(); });
      khung.innerHTML = '';

      if (!kq.ok) { bao(baoKhung, 'loi', kq.thong_bao || T['dat_ban_moi.loi_chung']); return; }
      if (kq.dong_cua) { bao(baoKhung, 'nhac', kq.ly_do); return; }
      if (!kq.khung.length) {
        bao(baoKhung, 'nhac', T['dat_ban_moi.het_gio_trong_ngay']);
        return;
      }

      S.thoiLuong = kq.thoi_luong;
      var conBan = 0;

      kq.khung.forEach(function (k) {
        if (k.con_ban) conBan += 1;
        var l = chu('label', 'db-gio__o');
        var o = document.createElement('input');
        o.type = 'radio'; o.name = 'dbGioChon'; o.value = k.gio;
        o.disabled = !k.con_ban;
        o.addEventListener('change', function () {
          S.gio = k.gio;
          S.ban = [];
          $('dbTiep1').disabled = false;
          veTomTat();
          taiCoc();
        });
        var s = document.createElement('span');
        if (k.cao_diem) s.classList.add('db-gio__caodiem');
        s.appendChild(document.createTextNode(k.gio));
        s.appendChild(chu('small', null, k.con_ban
          ? (k.cao_diem ? T['dat_ban_moi.cao_diem'] : T['dat_ban_moi.con_ban'])
          : T['dat_ban_moi.het_ban']));
        l.appendChild(o);
        l.appendChild(s);
        khung.appendChild(l);
      });

      if (!conBan) {
        bao(baoKhung, 'nhac', T['dat_ban_moi.kin_ban_ngay']);
      }
    } catch (e) {
      khung.innerHTML = '';
      bao(baoKhung, 'loi', T['dat_ban_moi.loi_mang']);
    }
  }

  $('dbNgay').addEventListener('change', function () {
    S.ngay = this.value;
    taiKhungGioHoan();
  });
  $('dbSoKhach').addEventListener('input', function () {
    var n = Math.max(1, Math.min(CF.toi_da_khach, Number(this.value) || 1));
    S.soKhach = n;
    // Bo chon o "chon nhanh" neu khach go so khac - hai o cung sang la mau thuan.
    document.querySelectorAll('input[name="dbNhanh"]').forEach(function (o) {
      o.checked = Number(o.value) === n;
    });
    veTomTat();
    taiKhungGioHoan();
  });
  $('dbKhuVuc').addEventListener('change', function () {
    S.khuVuc = this.value;
    S.ban = [];
    veTomTat();
    taiKhungGioHoan();
  });

  $('dbTiep1').addEventListener('click', function () { den(tienTu(1)); });

  // -------------------------------------------------------------- bước 2

  var dieuKhienSoDo = null;

  async function taiSoDo() {
    var khung = $('dbSoDo');
    khung.innerHTML = '<div class="sdb__khung sdb__khung--tai">' + T['dat_ban_moi.dang_tai_so_do'] + '</div>';
    $('dbTomTatBan').textContent = T['dat_ban_moi.dang_tai'];

    // Dem so ban trong tung khu de ve so tren tab. Goi song song - bon khu vuc
    // la bon request, cho lan luot se cham gap bon lan ma khong duoc gi.
    var q = function (khu) {
      var p = new URLSearchParams({ ngay: S.ngay, gio: S.gio, so_khach: S.soKhach });
      if (khu) p.set('khu_vuc', khu);
      return fetch('/api/dat-ban/so-do?' + p).then(function (r) { return r.json(); });
    };

    try {
      var tatCa = await q(S.khuVuc);
      if (!tatCa.ok) { bao($('dbTomTatBan'), 'loi', tatCa.thong_bao); return; }

      var dem = {};
      dem['*'] = tatCa.ban.filter(function (b) { return b.kha_dung; }).length;
      var demTheoKhu = await Promise.all(KHU.map(function (k) { return q(k.id); }));
      demTheoKhu.forEach(function (r, i) {
        dem[String(KHU[i].id)] = r.ok ? r.ban.filter(function (b) { return b.kha_dung; }).length : 0;
      });

      SoDoDatBan.veTabs($('dbTabs'), KHU, S.khuVuc, dem, function (khu) {
        S.khuVuc = khu;
        S.ban = [];
        $('dbKhuVuc').value = khu;
        taiSoDo();
      });

      var khuDangXem = KHU.filter(function (k) { return String(k.id) === String(S.khuVuc); })[0];

      dieuKhienSoDo = SoDoDatBan.ve(khung, tatCa, {
        choChon: tatCa.cho_chon_ban,
        soKhach: S.soKhach,
        daChon: S.ban,
        mocTren: khuDangXem && khuDangXem.ngoai_troi ? T['dat_ban_moi.moc_ngoai_troi'] : T['dat_ban_moi.moc_cua_so'],
        mocDuoi: T['dat_ban_moi.moc_quay'],
        onChon: function (ds, tongCho) {
          S.ban = ds;
          S.tongChoDaChon = tongCho;
          capNhatTomTatBan(tongCho);
          veTomTat();
        }
      });
    } catch (e) {
      khung.innerHTML = '';
      bao($('dbTomTatBan'), 'loi', T['dat_ban_moi.loi_mang']);
    }
  }

  function capNhatTomTatBan(tongCho) {
    var o = $('dbTomTatBan');
    o.className = 'sdb__tomtat';
    o.innerHTML = '';

    if (!S.ban.length) {
      o.appendChild(document.createTextNode(T['dat_ban_moi.chua_chon_ban']));
      // Khong chon ban van di tiep duoc: khach chon "de nha hang xep giup" la
      // mot lua chon hop le, khong phai mot buoc chua hoan thanh.
      $('dbTiep2').disabled = false;
      return;
    }

    var du = tongCho >= S.soKhach;
    o.classList.add(du ? 'sdb__tomtat--du' : 'sdb__tomtat--thieu');
    var m = chu('span');
    m.appendChild(document.createTextNode(T['dat_ban_moi.da_chon'] + ' '));
    var b = document.createElement('b');
    b.textContent = S.ban.length + ' ' + T['dat_ban_moi.ban_dv'] + ' · ' + tongCho + ' ' + T['dat_ban_moi.cho'];
    m.appendChild(b);
    o.appendChild(m);
    o.appendChild(chu('span', null, du
      ? T['dat_ban_moi.du_cho']
      : T['dat_ban_moi.thieu_cho'].replace('{n}', S.soKhach - tongCho)));

    $('dbTiep2').disabled = !du;
  }

  $('dbTuXep').addEventListener('click', function () {
    S.ban = [];
    if (dieuKhienSoDo && dieuKhienSoDo.xoaChon) dieuKhienSoDo.xoaChon();
    den(tienTu(2));
  });
  $('dbTiep2').addEventListener('click', function () { den(tienTu(2)); });

  // -------------------------------------------------------------- bước 3

  $('dbThe').addEventListener('change', function () {
    S.the = Array.prototype.slice
      .call(document.querySelectorAll('#dbThe input:checked'))
      .map(function (o) { return o.value; });
    veTomTat();
  });

  $('dbTiep3').addEventListener('click', function () {
    var ten = $('dbTen').value.trim();
    var dt = $('dbDienThoai').value.trim();
    if (ten.length < 2) { $('dbTen').focus(); $('dbTen').reportValidity(); return; }
    if (dt.replace(/\D/g, '').length < 8) {
      $('dbDienThoai').setCustomValidity(T['dat_ban_moi.dien_thoai_sai']);
      $('dbDienThoai').reportValidity();
      $('dbDienThoai').setCustomValidity('');
      return;
    }
    den(tienTu(3));
  });

  document.querySelectorAll('[data-lui]').forEach(function (n) {
    n.addEventListener('click', function () { den(luiTu(S.buoc)); });
  });

  // -------------------------------------------------------------- tóm tắt

  async function taiCoc() {
    if (!S.gio) { S.coc = null; veTomTat(); return; }
    var q = new URLSearchParams({
      reservation_date: S.ngay, start_time: S.gio, guest_count: S.soKhach
    });
    if (S.khuVuc) q.set('area_id', S.khuVuc);
    if (S.the.length) q.set('tags', S.the.join(','));
    try {
      var kq = await fetch('/api/dat-ban/kha-dung?' + q).then(function (r) { return r.json(); });
      S.coc = kq.ok ? kq.coc : null;
      S.goiY = kq.ok ? kq.goi_y : null;
    } catch (e) { S.coc = null; }
    veTomTat();
  }

  function hang(nhan, giaTri) {
    var h = chu('div', 'db-tomtat__hang');
    h.appendChild(chu('span', null, nhan));
    var b = document.createElement('b');
    b.textContent = giaTri;
    h.appendChild(b);
    return h;
  }

  function veTomTat() {
    var o = $('dbTomTat');
    o.innerHTML = '';
    o.appendChild(hang(T['dat_ban_moi.ngay'], ngayVN(S.ngay)));
    o.appendChild(hang(T['dat_ban_moi.gio_den'], S.gio || '—'));
    o.appendChild(hang(T['dat_ban_moi.so_khach'], S.soKhach + ' ' + T['dat_ban_moi.khach']));
    if (S.thoiLuong) o.appendChild(hang(T['dat_ban_moi.thoi_luong'], S.thoiLuong + ' ' + T['dat_ban_moi.phut']));

    var tenKhu = T['dat_ban_moi.khu_bat_ky'];
    KHU.forEach(function (k) { if (String(k.id) === String(S.khuVuc)) tenKhu = k.ten; });
    o.appendChild(hang(T['dat_ban_moi.khu_vuc'], tenKhu));

    if (S.ban.length) {
      o.appendChild(hang(T['dat_ban_moi.ban_da_chon'], S.ban.length + ' ' + T['dat_ban_moi.ban_dv'] + ' · ' + S.tongChoDaChon + ' ' + T['dat_ban_moi.cho']));
    } else if (S.goiY) {
      o.appendChild(hang(T['dat_ban_moi.ban_de_xuat'],
        S.goiY.ban.map(function (b) { return b.ten; }).join(', ')));
    }
    if (S.the.length) {
      o.appendChild(hang(T['dat_ban_moi.yeu_cau'], S.the.length + ' ' + T['dat_ban_moi.muc']));
    }

    var c = $('dbTomTatCoc');
    c.innerHTML = '';
    if (S.coc && S.coc.soTien > 0) {
      var hop = chu('div', 'db-coc');
      var b = document.createElement('b');
      b.textContent = tien(S.coc.soTien);
      hop.appendChild(b);
      hop.appendChild(chu('div', null, S.coc.lyDo));
      hop.appendChild(chu('div', null, T['dat_ban_moi.coc_ghi_chu']));
      c.appendChild(hop);
    }
  }

  // -------------------------------------------------------------- bước 4

  function veXemLai() {
    var dl = $('dbXemLai');
    dl.innerHTML = '';
    function muc(nhan, giaTri) {
      if (!giaTri) return;
      dl.appendChild(chu('dt', null, nhan));
      dl.appendChild(chu('dd', null, giaTri));
    }
    var tenKhu = T['dat_ban_moi.khu_bat_ky'];
    KHU.forEach(function (k) { if (String(k.id) === String(S.khuVuc)) tenKhu = k.ten; });
    var tenThe = Array.prototype.slice
      .call(document.querySelectorAll('#dbThe input:checked'))
      .map(function (o) { return o.parentNode.querySelector('span').textContent.trim(); });

    muc(T['dat_ban_moi.ho_ten'], $('dbTen').value.trim());
    muc(T['dat_ban_moi.dien_thoai'], $('dbDienThoai').value.trim());
    muc(T['dat_ban_moi.email'], $('dbEmail').value.trim());
    muc(T['dat_ban_moi.thoi_gian'], S.gio + ' · ' + ngayVN(S.ngay)
      + (S.thoiLuong ? ' · ' + S.thoiLuong + ' ' + T['dat_ban_moi.phut'] : ''));
    muc(T['dat_ban_moi.so_khach'], S.soKhach + ' ' + T['dat_ban_moi.khach']);
    muc(T['dat_ban_moi.khu_vuc'], tenKhu);
    muc(T['dat_ban_moi.ban'], S.ban.length
      ? S.tongChoDaChon + ' ' + T['dat_ban_moi.cho'] + ' (' + T['dat_ban_moi.tu_chon'] + ')'
      : (S.goiY ? S.goiY.ban.map(function (b) { return b.ten; }).join(', ') : T['dat_ban_moi.nha_hang_xep']));
    muc(T['dat_ban_moi.yeu_cau'], tenThe.join(' · '));
    muc(T['dat_ban_moi.ghi_chu'], $('dbYeuCau').value.trim());
    if (S.coc && S.coc.soTien > 0) muc(T['dat_ban_moi.tien_coc'], tien(S.coc.soTien) + ' — ' + S.coc.lyDo);
  }

  var dangGui = false;

  $('dbGui').addEventListener('click', async function () {
    if (dangGui) return;
    dangGui = true;
    var nut = this;
    var chuCu = nut.innerHTML;
    nut.disabled = true;
    nut.innerHTML = '<span class="db-tai"></span> ' + T['dat_ban_moi.dang_gui'];
    $('dbBaoGui').innerHTML = '';

    // Dip = the OCCASION dau tien khach tich. Con lai di vao `tags`.
    var dip = '';
    document.querySelectorAll('#dbThe input:checked').forEach(function (o) {
      if (!dip && o.getAttribute('data-kind') === 'OCCASION') dip = o.value;
    });

    var goi = {
      customer_name: $('dbTen').value.trim(),
      phone: $('dbDienThoai').value.trim(),
      email: $('dbEmail').value.trim() || null,
      reservation_date: S.ngay,
      start_time: S.gio,
      guest_count: S.soKhach,
      area_id: S.khuVuc || null,
      table_ids: S.ban,
      tags: S.the,
      occasion: dip || null,
      special_requests: $('dbYeuCau').value.trim() || null
    };

    try {
      var r = await fetch('/api/dat-ban', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(goi)
      });
      var kq = await r.json();

      if (kq.ok) {
        // Chuyen sang trang xac nhan thay vi hien mot the bao thanh cong: khach
        // can mot trang co dia chi rieng de luu lai / gui cho nguoi khac.
        window.location.href = '/dat-ban/xong?ma=' + encodeURIComponent(kq.ma)
          + '&dt=' + encodeURIComponent(goi.phone);
        return;
      }

      // Het ban: kem nut bam thang sang khung gio / khu vuc con cho.
      var them = null;
      if (kq.chi_tiet && (kq.chi_tiet.gio_thay_the || kq.chi_tiet.khu_thay_the)) {
        them = chu('div', 'db-goiy');
        (kq.chi_tiet.gio_thay_the || []).forEach(function (g) {
          var b = document.createElement('button');
          b.type = 'button';
          b.textContent = g.gio + ' (' + g.khu_vuc + ')';
          b.addEventListener('click', function () {
            S.gio = g.gio; S.ban = [];
            den(1);
            taiKhungGio().then(function () {
              var o = document.querySelector('#dbGio input[value="' + g.gio + '"]');
              if (o && !o.disabled) { o.checked = true; o.dispatchEvent(new Event('change')); }
            });
          });
          them.appendChild(b);
        });
        (kq.chi_tiet.khu_thay_the || []).forEach(function (k) {
          var b = document.createElement('button');
          b.type = 'button';
          b.textContent = k.khu_vuc + ' — ' + k.tong_cho + ' ' + T['dat_ban_moi.cho'];
          b.addEventListener('click', function () {
            S.khuVuc = String(k.khu_vuc_id); S.ban = [];
            $('dbKhuVuc').value = S.khuVuc;
            den(1); taiKhungGio();
          });
          them.appendChild(b);
        });
      }
      bao($('dbBaoGui'), 'loi', kq.thong_bao || T['dat_ban_moi.loi_chung'], them);
    } catch (e) {
      bao($('dbBaoGui'), 'loi', T['dat_ban_moi.loi_mang']);
    } finally {
      dangGui = false;
      nut.disabled = false;
      nut.innerHTML = chuCu;
    }
  });

  // -------------------------------------------------------------- khởi động
  veThanhBuoc();
  veTomTat();
  taiKhungGio();
})();
</script>

<%- include('partials/footer') %>
