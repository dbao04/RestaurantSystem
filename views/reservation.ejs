  var dieuKhienSoDo = null;
  var chiHienBanPhuHop = true;

  /*
    RÀNG BUỘC QUY MÔ BÀN — bản sao phía trình duyệt của
    reservationRules.kiemTraQuyMoBan() để khách thấy lỗi NGAY khi bấm chọn bàn.
    Server vẫn kiểm lại; sửa quy tắc thì sửa cả hai nơi.
  */
  var QM = <%- JSON.stringify(cauHinh.quy_mo_ban || {}) %>;
  function gioiHanCho(k, soBan) {
    if (soBan <= 1) return Math.max(k + (QM.max_extra_seats_single || 2), QM.single_table_max_guests || 4);
    return k + Math.max(QM.max_extra_seats_group || 3, Math.ceil(k * (QM.max_extra_seats_percent || 20) / 100));
  }
  function kiemTraQuyMoBan(dsSoCho, k) {
    var n = dsSoCho.length;
    var tong = dsSoCho.reduce(function (s, c) { return s + c; }, 0);
    if (!n) return null;
    if (tong < k) return null; // "thiếu chỗ" đã có thông báo riêng
    if (n > 1 && k <= (QM.single_table_max_guests || 4)) {
      return 'Nhóm ' + k + ' khách chỉ được đặt 1 bàn (bàn tối đa ' + gioiHanCho(k, 1) + ' chỗ).';
    }
    if (n > 1) {
      for (var i = 0; i < n; i++) {
        if (tong - dsSoCho[i] >= k) return 'Bạn đã chọn thừa bàn: bỏ bớt bàn ' + dsSoCho[i] + ' chỗ vẫn đủ cho ' + k + ' khách.';
      }
    }
    var toiDa = gioiHanCho(k, n);
    if (tong > toiDa) {
      return n === 1
        ? 'Bàn ' + tong + ' chỗ quá lớn cho ' + k + ' khách — chỉ được chọn bàn tối đa ' + toiDa + ' chỗ.'
        : 'Tổng ' + tong + ' chỗ quá nhiều cho ' + k + ' khách — tổng số chỗ chỉ được từ ' + k + ' đến ' + toiDa + '.';
    }
    if (QM.max_tables_per_reservation && n > QM.max_tables_per_reservation) {
      return 'Mỗi lượt đặt tối đa ' + QM.max_tables_per_reservation + ' bàn.';
    }
    return null;
  }

  function laBanPhuHop(b, soKhach) {
    var k = Number(soKhach) || 2;
    var c = Number(b.so_cho) || 4;
    // Nhóm ngồi vừa MỘT bàn: chỉ hiện bàn đủ chỗ và không quá rộng.
    // Đoàn đông không vừa bàn nào thì bộ lọc tự hiện mọi bàn để ghép.
    return c >= k && c <= gioiHanCho(k, 1);
  }

  function layMotaKhoangCho(soKhach) {
    var k = Number(soKhach) || 2;
    return Math.max(k, 2) + ' – ' + gioiHanCho(k, 1);
  }

  function locDanhSachBan(dsBan, soKhach, batBuocPhuHop) {
    if (!batBuocPhuHop) return dsBan;
    var phuHop = dsBan.filter(function (b) { return laBanPhuHop(b, soKhach); });
    if (phuHop.length > 0) return phuHop;
    var duCho = dsBan.filter(function (b) { return Number(b.so_cho) >= soKhach; });
    return duCho.length > 0 ? duCho : dsBan;
  }

  function capNhatThanhLocBan() {
    var hop = $('dbFilterStatus');
    var txt = $('dbFilterTextContent');
    var btn = $('dbBtnToggleFilter');
    if (!hop || !txt || !btn) return;

    if (chiHienBanPhuHop) {
      txt.innerHTML = (T['dat_ban_moi.loc_ban_phu_hop'] || 'Đang lọc các bàn phù hợp cho {n} khách').replace('{n}', '<b>' + S.soKhach + '</b>')
        + ' <span style="color:var(--nh-muted); font-weight:normal;">(Bàn ' + layMotaKhoangCho(S.soKhach) + ' chỗ)</span>';
      btn.textContent = T['dat_ban_moi.hien_tat_ca_ban'] || 'Xem tất cả bàn';
      btn.className = 'nh-btn nh-btn--xs nh-btn--outline';
    } else {
      txt.innerHTML = '<span style="color:var(--nh-muted); font-weight:500;"><i class="fas fa-eye"></i> Đang hiển thị toàn bộ bàn của nhà hàng</span>';
      btn.textContent = (T['dat_ban_moi.chi_hien_phu_hop'] || 'Chỉ hiện bàn phù hợp') + ' (' + S.soKhach + ' khách)';
      btn.className = 'nh-btn nh-btn--xs nh-btn--gold';
    }
  }

  var btnToggleFilter = $('dbBtnToggleFilter');
  if (btnToggleFilter) {
    btnToggleFilter.addEventListener('click', function () {
      chiHienBanPhuHop = !chiHienBanPhuHop;
      taiSoDo();
    });
  }

  async function taiSoDo() {
    var khung = $('dbSoDo');
    khung.innerHTML = '<div class="sdb__khung sdb__khung--tai">' + T['dat_ban_moi.dang_tai_so_do'] + '</div>';
    $('dbTomTatBan').textContent = T['dat_ban_moi.dang_tai'];
    capNhatThanhLocBan();

    var q = function (khu) {
      var p = new URLSearchParams({ ngay: S.ngay, gio: S.gio, so_khach: S.soKhach });
      if (khu) p.set('khu_vuc', khu);
      return fetch('/api/dat-ban/so-do?' + p).then(function (r) { return r.json(); });
    };

    try {
      var tatCa = await q(S.khuVuc);
      if (!tatCa.ok) { bao($('dbTomTatBan'), 'loi', tatCa.thong_bao); return; }

      S.soChoTheoBan = {};
      (tatCa.ban || []).forEach(function (b) { S.soChoTheoBan[Number(b.id)] = Number(b.so_cho) || 0; });
      var banHienThi = locDanhSachBan(tatCa.ban || [], S.soKhach, chiHienBanPhuHop);
      var tatCaDaLoc = Object.assign({}, tatCa, { ban: banHienThi });

      var dem = {};
      dem['*'] = banHienThi.filter(function (b) { return b.kha_dung; }).length;
      var demTheoKhu = await Promise.all(KHU.map(function (k) { return q(k.id); }));
      demTheoKhu.forEach(function (r, i) {
        if (r.ok) {
          var banKhu = locDanhSachBan(r.ban || [], S.soKhach, chiHienBanPhuHop);
          dem[String(KHU[i].id)] = banKhu.filter(function (b) { return b.kha_dung; }).length;
        } else {
          dem[String(KHU[i].id)] = 0;
        }
      });

      SoDoDatBan.veTabs($('dbTabs'), KHU, S.khuVuc, dem, function (khu) {
        S.khuVuc = khu;
        S.ban = [];
        $('dbKhuVuc').value = khu;
        taiSoDo();
      });

      var khuDangXem = KHU.filter(function (k) { return String(k.id) === String(S.khuVuc); })[0];

      dieuKhienSoDo = SoDoDatBan.ve(khung, tatCaDaLoc, {
        choChon: tatCa.cho_chon_ban,
        soKhach: S.soKhach,
        daChon: S.ban,
        mocTren: khuDangXem && khuDangXem.ngoai_troi ? T['dat_ban_moi.moc_ngoai_troi'] : T['dat_ban_moi.moc_cua_so'],
        mocDuoi: T['dat_ban_moi.moc_quay'],
        onChon: function (ds, tongCho) {
          S.ban = ds;
          S.tongChoDaChon = tongCho;
          capNhatTomTatBan(tongCho);
          veTomTat();
        }
      });
    } catch (e) {
      khung.innerHTML = '';
      bao($('dbTomTatBan'), 'loi', T['dat_ban_moi.loi_mang']);
    }
  }

  function capNhatTomTatBan(tongCho) {
    var o = $('dbTomTatBan');
    o.className = 'sdb__tomtat';
    o.innerHTML = '';

    if (!S.ban.length) {
      o.appendChild(document.createTextNode(T['dat_ban_moi.chua_chon_ban']));
      $('dbTiep2').disabled = false;
      return;
    }

    var du = tongCho >= S.soKhach;
    var loiQuyMo = du ? kiemTraQuyMoBan(S.ban.map(function (id) { return (S.soChoTheoBan || {})[Number(id)] || 0; }), Number(S.soKhach)) : null;
    if (loiQuyMo) du = false;
    o.classList.add(du ? 'sdb__tomtat--du' : 'sdb__tomtat--thieu');
    var m = chu('span');
    m.appendChild(document.createTextNode(T['dat_ban_moi.da_chon'] + ' '));
    var b = document.createElement('b');
    b.textContent = S.ban.length + ' ' + T['dat_ban_moi.ban_dv'] + ' · ' + tongCho + ' ' + T['dat_ban_moi.cho'];
    m.appendChild(b);
    o.appendChild(m);
    o.appendChild(chu('span', null, loiQuyMo ? loiQuyMo : (du
      ? T['dat_ban_moi.du_cho']
      : T['dat_ban_moi.thieu_cho'].replace('{n}', S.soKhach - tongCho))));

    $('dbTiep2').disabled = !du;
  }

