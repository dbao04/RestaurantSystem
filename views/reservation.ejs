  .db-selected-item button { border: none; background: transparent; color: #dc2626; cursor: pointer; font-size: 0.75rem; padding: 0; }

  /* ---------- Nut dieu huong ---------- */
  .db-dieuhuong { display: flex; gap: .8rem; justify-content: space-between; margin-top: 1.8rem; flex-wrap: wrap; }
  .db-dieuhuong .nh-btn { flex: 1; justify-content: center; min-width: 150px; }
  .nh-btn[disabled] { opacity: .45; cursor: not-allowed; transform: none !important; }

  .db-tai { display: inline-block; width: 14px; height: 14px; border: 2px solid currentColor;
    border-right-color: transparent; border-radius: 50%; animation: dbQuay .7s linear infinite; }
  @keyframes dbQuay { to { transform: rotate(360deg); } }

  .db-xemlai { display: grid; grid-template-columns: 150px 1fr; gap: .5rem 1rem; font-size: .94rem; }
  .db-xemlai dt { color: var(--nh-muted); font-size: .8rem; text-transform: uppercase; letter-spacing: .05em;
    font-weight: 700; padding-top: .12rem; }
  .db-xemlai dd { margin: 0; color: var(--nh-espresso); font-weight: 600; }
  @media (max-width: 560px) { .db-xemlai { grid-template-columns: 1fr; gap: .1rem .5rem; }
    .db-xemlai dd { margin-bottom: .7rem; } }

  /* ---------- Chinh sach dat ban (Buoc Mo Dau + Modal) ---------- */
  .db-cs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: .95rem; margin-bottom: 1.4rem; }
  .db-cs-card { background: #fffdf8; border: 1.5px solid rgba(200, 162, 75, 0.35); border-radius: 14px; padding: 1.05rem 1.15rem; position: relative; transition: all .2s var(--nh-ease); }
  .db-cs-card:hover { border-color: var(--nh-gold); box-shadow: 0 6px 18px rgba(200, 162, 75, 0.14); transform: translateY(-2px); }
  .db-cs-card--highlight { background: linear-gradient(135deg, #fffdf4 0%, #fcf3dc 100%); border-color: var(--nh-gold); }
  .db-cs-badge { display: inline-flex; align-items: center; gap: .35rem; font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; padding: .22rem .65rem; border-radius: 999px; margin-bottom: .55rem; background: rgba(200, 162, 75, 0.18); color: #854d0e; }
  .db-cs-badge--green { background: #dcfce7; color: #166534; }
  .db-cs-badge--gold { background: var(--nh-espresso); color: var(--nh-gold-soft); }
  .db-cs-card h4 { font-size: 1rem; font-weight: 750; color: var(--nh-espresso); margin: 0 0 .35rem; line-height: 1.35; }
  .db-cs-price { font-size: 1.18rem; font-weight: 800; color: #b45309; margin-bottom: .35rem; display: block; }
  .db-cs-price--free { color: #15803d; }
  .db-cs-card p { font-size: .85rem; color: var(--nh-muted); margin: 0; line-height: 1.5; }
  .db-cs-note { margin-top: .5rem; padding: .5rem .7rem; border-radius: 8px; background: rgba(255,255,255,0.85); border-left: 3px solid var(--nh-gold); font-size: .81rem; color: #7c2d12; font-weight: 600; }

  .db-cs-table { width: 100%; border-collapse: collapse; font-size: .88rem; margin-top: .6rem; background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid var(--nh-line); }
  .db-cs-table th, .db-cs-table td { padding: .65rem .85rem; text-align: left; border-bottom: 1px solid var(--nh-line); }
  .db-cs-table th { background: #f8f5ee; font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: var(--nh-espresso); font-weight: 800; }
  .db-cs-table tr:last-child td { border-bottom: none; }

  .db-cs-agree { display: flex; align-items: flex-start; gap: .75rem; padding: 1rem 1.15rem; border-radius: 12px; background: #f0fdf4; border: 1.5px solid rgba(22, 163, 74, 0.35); margin-top: 1.3rem; cursor: pointer; font-size: .92rem; color: #14532d; font-weight: 600; }
  .db-cs-agree input { width: 20px; height: 20px; margin-top: 2px; accent-color: #15803d; cursor: pointer; flex-shrink: 0; }

  .db-cs-live { margin-top: 1.1rem; padding: .9rem 1.1rem; border-radius: 12px; background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border: 1.5px solid rgba(217, 119, 6, 0.35); font-size: .88rem; color: #7c2d12; display: flex; gap: .75rem; align-items: flex-start; }
  .db-cs-live--free { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-color: rgba(22, 163, 74, 0.35); color: #14532d; }
  .db-cs-live i { font-size: 1.1rem; margin-top: .15rem; flex: none; }

  .db-modal-backdrop { position: fixed; inset: 0; background: rgba(24, 17, 13, 0.65); z-index: 9999; display: none; align-items: center; justify-content: center; padding: 1rem; backdrop-filter: blur(3px); }
  .db-modal-backdrop.hien { display: flex; }
  .db-modal { background: #fff; border-radius: 18px; max-width: 780px; width: 100%; max-height: 88vh; overflow-y: auto; padding: 1.6rem 1.8rem; box-shadow: 0 20px 50px rgba(0,0,0,0.3); border: 1.5px solid var(--nh-gold); position: relative; }
  .db-modal__close { position: sticky; top: 0; float: right; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--nh-line); background: #fff; color: var(--nh-espresso); cursor: pointer; font-size: 1rem; display: grid; place-content: center; }
  .db-modal__close:hover { background: var(--nh-espresso); color: #fff; }
</style>

<section class="nh-section nh-section--cream">
  <div class="nh-container">

    <noscript>
      <div class="db-bao db-bao--nhac">
        <i class="fas fa-exclamation-triangle"></i>
        <div><%- t('dat_ban_moi.khong_js') %></div>
      </div>
    </noscript>



    <ol class="db-buoc" id="dbBuoc" aria-label="<%= t('dat_ban_moi.tien_trinh') %>"></ol>

    <div class="db-luoi">
      <div>
        <!-- ============================ BƯỚC MỞ ĐẦU: CHÍNH SÁCH ĐẶT BÀN ==================== -->
        <div class="db-man hien" id="manCs" data-buoc="cs">
          <div class="nh-panel">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:0.8rem; margin-bottom:1rem;">
              <div>
                <h3 class="nh-panel__title" style="margin-bottom:0.3rem;"><i class="fas fa-shield-alt"></i> Chính sách Đặt bàn, Đặt cọc & Hoàn hủy</h3>
                <p class="nh-hint" style="margin:0;">Vui lòng xem qua quy định đặt cọc giữ bàn và hoàn hủy trước khi tiến hành đặt bàn.</p>
              </div>
              <a href="/chinh-sach-dat-ban.pdf" target="_blank" class="nh-btn nh-btn--outline nh-btn--sm" style="font-size:0.8rem;">
                <i class="fas fa-file-pdf"></i> Xem / Tải bản PDF
              </a>
            </div>

            <h4 style="font-size:0.95rem; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--nh-espresso); margin: 0 0 0.75rem;">
              <i class="fas fa-coins" style="color:var(--nh-gold); margin-right:0.35rem;"></i> 1. Quy định Đặt cọc bàn & Đặt món trước
            </h4>

            <div class="db-cs-grid">
              <!-- Thẻ 1: Giờ thường dưới 6 người -->
              <div class="db-cs-card">
                <span class="db-cs-badge db-cs-badge--green"><i class="fas fa-smile"></i> Giờ thường · 1 – 5 khách</span>
                <h4>Bàn lẻ & Gia đình nhỏ</h4>
                <span class="db-cs-price db-cs-price--free">Miễn đặt cọc (0đ)</span>
                <p>Áp dụng ngoài khung giờ cao điểm (ngoài <%= cauHinh.gio_cao_diem || '18:00-21:00' %>) cho bàn từ 1 đến 5 người khi không đặt món trước.</p>
              </div>

              <!-- Thẻ 2: Giờ cao điểm hoặc >= 6 khách giờ thường -->
              <div class="db-cs-card">
                <span class="db-cs-badge"><i class="fas fa-fire"></i> Giờ cao điểm / Đoàn 6–14 khách</span>
                <h4>Giờ cao điểm (<%= cauHinh.gio_cao_diem || '18:00-21:00' %>) hoặc Bàn ≥ 6 người</h4>
                <span class="db-cs-price">Cọc 100.000đ / người</span>
                <p>
                  • <b>Giờ cao điểm (<%= cauHinh.gio_cao_diem || '18:00-21:00' %>):</b> Bắt buộc cọc <b>100.000đ/người</b> nếu không đặt trước món ăn.<br>
                  • <b>Giờ thường:</b> Bàn từ <b>6 – 14 người</b> cọc <b>100.000đ/người</b>.
                </p>
              </div>

              <!-- Thẻ 3: Đặt tiệc từ 15 người -->
              <div class="db-cs-card db-cs-card--highlight">
                <span class="db-cs-badge db-cs-badge--gold"><i class="fas fa-glass-cheers"></i> Đặt tiệc · Từ <%= cauHinh.nguong_tiec || 15 %> người trở lên</span>
                <h4>Bàn đặt tiệc đoàn đông (≥ <%= cauHinh.nguong_tiec || 15 %> khách)</h4>
                <span class="db-cs-price">Cọc 150.000đ / người</span>
                <p>Áp dụng cho mọi khung giờ đối với đoàn đặt tiệc từ <%= cauHinh.nguong_tiec || 15 %> khách trở lên.</p>
                <div class="db-cs-note">
                  <i class="fas fa-hand-holding-usd"></i> <b>Cam kết hoàn tiền thừa:</b> Trường hợp khách dùng món thực tế thấp hơn tổng mức 150.000đ/người sẽ được <b>hoàn lại tiền thừa ngay lúc thanh toán</b>!
                </div>
              </div>

              <!-- Thẻ 4: Đặt món trước -->
              <div class="db-cs-card">
                <span class="db-cs-badge" style="background:#e0f2fe; color:#0369a1;"><i class="fas fa-utensils"></i> Đặt món trước (Pre-order)</span>
                <h4>Đặt bàn kèm Chọn món trước</h4>
                <span class="db-cs-price" style="color:#0369a1;">Thanh toán 100% tiền món</span>
                <p>Khi chọn món trước, quý khách thanh toán trước <b>100% tiền món ăn</b> và được <b>miễn thu thêm cọc bàn 100.000đ/người</b> (đoàn ≥ 15 người áp dụng mức tối thiểu 150.000đ/người).</p>
              </div>
            </div>

            <h4 style="font-size:0.95rem; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--nh-espresso); margin: 1.3rem 0 0.6rem;">
              <i class="fas fa-undo-alt" style="color:var(--nh-gold); margin-right:0.35rem;"></i> 2. Chính sách Đổi lịch & Hủy bàn (Hoàn tiền cọc)
            </h4>

            <table class="db-cs-table">
              <thead>
                <tr>
                  <th>Thời điểm báo hủy (so với giờ hẹn)</th>
                  <th>Bàn thường (&lt; 15 khách)</th>
                  <th>Đoàn tiệc (≥ 15 khách) / Có đặt món trước</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><b>Trước từ 24 giờ trở lên</b></td>
                  <td style="color:#15803d; font-weight:700;">Hoàn 100% tiền cọc</td>
                  <td style="color:#15803d; font-weight:700;">Hoàn 100% tiền cọc / tiền món</td>
                </tr>
                <tr>
                  <td><b>Từ 6 giờ đến dưới 24 giờ</b></td>
                  <td style="color:#b45309; font-weight:700;">Hoàn 70% tiền cọc</td>
                  <td style="color:#b45309; font-weight:700;">Hoàn 50% tiền cọc / tiền món</td>
                </tr>
                <tr>
                  <td><b>Từ 2 giờ đến dưới 6 giờ</b></td>
                  <td style="color:#b45309; font-weight:700;">Hoàn 50% tiền cọc</td>
                  <td style="color:#b91c1c; font-weight:700;">Không hoàn (0%) <small style="font-weight:normal;">(Bếp đã sơ chế)</small></td>
                </tr>
                <tr>
                  <td><b>Dưới 2 giờ (Sát giờ) / Không đến (No-show)</b></td>
                  <td style="color:#b91c1c; font-weight:700;">Không hoàn tiền (0%)</td>
                  <td style="color:#b91c1c; font-weight:700;">Không hoàn tiền (0%)</td>
                </tr>
              </tbody>
            </table>

            <div class="db-bao db-bao--nhac" style="margin-top:1rem; margin-bottom:0;">
              <i class="fas fa-clock"></i>
              <div style="font-size:0.86rem; line-height:1.55;">
                <b>Quy định giữ bàn & Đổi lịch:</b> Nhà hàng giữ bàn tối đa <b><%= cauHinh.giu_ban_phut %> phút</b> kể từ giờ hẹn (nếu đến trễ vui lòng gọi báo trước để gia hạn). Quý khách được <b>miễn phí đổi giờ/ngày (bảo lưu 100% tiền cọc)</b> khi báo trước ít nhất <b>4 giờ</b> (bàn thường) hoặc <b>12 giờ</b> (bàn tiệc / đặt món trước).
              </div>
            </div>

            <label class="db-cs-agree" for="dbDongYChinhSach">
              <input type="checkbox" id="dbDongYChinhSach" checked>
              <span>Tôi đã đọc, hiểu rõ và đồng ý với Chính sách đặt bàn, đặt cọc (100k/người giờ cao điểm hoặc ≥ 6 người; 150k/người cho tiệc ≥ 15 người; 100% tiền món đặt trước) và Chính sách hoàn hủy của Nhà hàng Bảo Đoàn.</span>
            </label>

            <div class="db-dieuhuong">
              <a href="/huong-dan-dat-ban" class="nh-btn nh-btn--outline">
                <i class="fas fa-book-open"></i> Xem hướng dẫn chi tiết
              </a>
              <button type="button" class="nh-btn nh-btn--gold" id="dbBatDauDatBan">
                Đồng ý & Bắt đầu đặt bàn <i class="fas fa-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- ============================ BƯỚC 1: THỜI GIAN ==================== -->
        <div class="db-man" id="man1" data-buoc="1">
          <div class="nh-panel">
            <h3 class="nh-panel__title"><i class="fas fa-calendar-day"></i> <%= t('dat_ban_moi.b1_tieu_de') %></h3>

            <div class="nh-fields">
              <div class="nh-field">
                <label for="dbNgay"><%= t('dat_ban_moi.ngay') %> <span class="req">*</span></label>
                <input type="date" id="dbNgay" class="nh-input" value="<%= homNay %>" min="<%= homNay %>">
              </div>
              <div class="nh-field">
                <label for="dbSoKhach"><%= t('dat_ban_moi.so_khach') %> <span class="req">*</span></label>
                <input type="number" id="dbSoKhach" class="nh-input" value="0" min="0" max="<%= cauHinh.toi_da_khach %>">
                <span class="nh-hint"><%= t('dat_ban_moi.toi_da_online').replace('{n}', cauHinh.toi_da_khach) %></span>
              </div>
              <div class="nh-field nh-field--full">
                <label><%= t('dat_ban_moi.chon_nhanh') %></label>
                <div class="nh-chips" id="dbNhanhKhach"></div>
              </div>
              <div class="nh-field nh-field--full">
                <label for="dbKhuVuc"><%= t('dat_ban_moi.khu_vuc') %></label>
                <select id="dbKhuVuc" class="nh-select">
                  <option value=""><%= t('dat_ban_moi.khu_bat_ky') %></option>
                  <% khuVuc.forEach(function (k) { %>
                    <option value="<%= k.id %>" <%= (typeof khuVucChon !== 'undefined' && String(khuVucChon) === String(k.id)) ? 'selected' : '' %>><%= k.la_vip ? '★ ' : '' %><%= tenKhuVucDich(k) %> — <%= k.so_ban %> <%= t('dat_ban_moi.ban_dv') %><%= k.mo_ta ? ' · ' + k.mo_ta : '' %></option>
                  <% }); %>
                </select>
              </div>
            </div>

            <div style="margin-top:1.6rem">
              <label class="nh-field" style="margin-bottom:.6rem">
                <span style="font-size:.78rem;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--nh-muted)">
                  <%= t('dat_ban_moi.gio_den') %> <span class="req">*</span>
                </span>
              </label>
              <div id="dbBaoGio"></div>
              <div class="db-gio" id="dbGio" role="radiogroup" aria-label="<%= t('dat_ban_moi.gio_den') %>"></div>
              <div id="dbChinhSachApDung"></div>
            </div>

            <div class="db-dieuhuong">
              <button type="button" class="nh-btn nh-btn--outline" data-lui="1">
                <i class="fas fa-shield-alt"></i> Xem lại Chính sách
              </button>
              <button type="button" class="nh-btn nh-btn--gold" id="dbTiep1" disabled>
                <%= t('dat_ban_moi.tiep_tuc') %> <i class="fas fa-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- ============================ BƯỚC 2: CHỌN BÀN ==================== -->
        <div class="db-man" id="man2" data-buoc="2">
          <div class="nh-panel">
            <h3 class="nh-panel__title"><i class="fas fa-map-marked-alt"></i> <%= t('dat_ban_moi.b2_tieu_de') %></h3>
            <p class="nh-hint" style="margin-bottom:1.1rem"><%= t('dat_ban_moi.b2_mo_ta') %></p>

            <div class="db-filter-status" id="dbFilterStatus" style="margin-bottom: 1rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; background: #fffdf5; border: 1.5px solid rgba(200,162,75,0.35); border-radius: 10px; padding: 0.55rem 0.95rem; font-size: 0.88rem;">
              <span id="dbFilterStatusText" style="color: var(--nh-espresso); font-weight: 600;">
                <i class="fas fa-filter" style="color: var(--nh-gold); margin-right: 0.35rem;"></i>
                <span id="dbFilterTextContent"></span>
              </span>
              <button type="button" id="dbBtnToggleFilter" class="nh-btn nh-btn--xs nh-btn--outline" style="font-size: 0.78rem; padding: 0.25rem 0.75rem; border-radius: 999px;">
                <%= t('dat_ban_moi.hien_tat_ca_ban') %>
              </button>
            </div>

            <div id="dbTabs"></div>
            <div id="dbSoDo" class="sdb"></div>
            <div class="sdb__tomtat" id="dbTomTatBan"><%= t('dat_ban_moi.dang_tai') %></div>

            <div class="db-dieuhuong">
              <button type="button" class="nh-btn nh-btn--outline" data-lui="1">
                <i class="fas fa-arrow-left"></i> <%= t('dat_ban_moi.quay_lai') %>
              </button>
              <button type="button" class="nh-btn nh-btn--outline" id="dbTuXep">
                <i class="fas fa-magic"></i> <%= t('dat_ban_moi.de_nha_hang_xep') %>
              </button>
              <button type="button" class="nh-btn nh-btn--gold" id="dbTiep2" disabled>
                <%= t('dat_ban_moi.tiep_tuc') %> <i class="fas fa-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- ============================ BƯỚC: GỌI MÓN TRƯỚC (TÙY CHỌN) ===== -->
        <div class="db-man" id="manMon" data-buoc="mon">
          <div class="nh-panel">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.5rem;">
              <h3 class="nh-panel__title" style="margin:0"><i class="fas fa-utensils"></i> <%= t('dat_ban_moi.b_mon_tieu_de') %></h3>
              <span class="nh-hint" style="margin:0"><%= t('dat_ban_moi.b_mon_mo_ta') %></span>
            </div>
            <p class="nh-hint" style="margin-bottom:1rem">
              <%= t('dat_ban_moi.b_mon_hint') %>
            </p>

            <!-- COMBO GỢI Ý THEO SỐ LƯỢNG KHÁCH -->
            <div class="db-combo-section" id="dbComboSection">
              <div class="db-combo-header">
                <h4 class="db-combo-title">
                  <i class="fas fa-crown"></i> <span id="dbComboGuestTitle"><%= t('dat_ban_moi.goi_y_combo', null, { n: '2' }) %></span>
                </h4>
                <span class="db-combo-badge"><i class="fas fa-sparkles"></i> <%= t('dat_ban_moi.tiet_kiem_du_vi') %></span>
              </div>
              <div class="db-combo-grid" id="dbComboGrid"></div>
            </div>

            <div style="margin-bottom: 0.8rem;">
              <input type="text" id="dbTimMon" class="nh-input" placeholder="<%= t('dat_ban_moi.tim_mon_placeholder') %>" style="max-width: 360px;">
            </div>

            <div class="db-mon-layout">
              <!-- Danh mục món bên trái -->
              <div class="db-loai-list" id="dbLoaiList">
                <button type="button" class="db-loai-btn active" data-loai="ALL"><%= t('dat_ban_moi.tat_ca_mon') %> (<%= (dsMonAn||[]).length %>)</button>
                <% (danhMucMon||[]).forEach(function(l) { %>
                  <button type="button" class="db-loai-btn" data-loai="<%= l.id_loai %>"><%= tenLoaiDich(l) %> (<%= l.so_mon || 0 %>)</button>
                <% }) %>
              </div>

              <!-- Lưới món ăn bên phải -->
              <div class="db-mon-grid" id="dbMonGrid">
                <% (dsMonAn||[]).forEach(function(m) { %>
                  <div class="db-dish-card" data-loai="<%= m.id_loai %>" data-ten="<%= (tenMonDich(m) + ' ' + (m.name_mon||'')).toLowerCase() %>">
                    <div class="db-dish-thumb">
                      <img src="/food/<%= m.images || '' %>" alt="<%= tenMonDich(m) %>" onerror="this.onerror=null;this.src='/mon-thay-the.svg'">
                    </div>
                    <div class="db-dish-body">
                      <div class="db-dish-name" title="<%= tenMonDich(m) %>"><%= tenMonDich(m) %></div>
                      <div class="db-dish-price"><%= Number(m.gia_mon||0).toLocaleString('vi-VN') %> ₫</div>
                      <div class="db-dish-qty">
                        <button type="button" class="btn-giam-mon" data-id="<%= m.id_mon %>" title="<%= t('dat_ban_moi.giam_bo') %>"><i class="fas fa-minus"></i></button>
                        <span id="qty_<%= m.id_mon %>">0</span>
                        <button type="button" class="btn-tang-mon" data-id="<%= m.id_mon %>" data-ten="<%= tenMonDich(m) %>" data-gia="<%= m.gia_mon %>" title="+1"><i class="fas fa-plus"></i></button>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- Khay món đã chọn -->
            <div class="db-selected-tray" id="dbSelectedTray" style="display:none">
              <div class="db-selected-title">
                <span><i class="fas fa-shopping-basket" style="color:var(--nh-gold)"></i> <%= t('dat_ban_moi.mon_da_chon_goi_truoc') %></span>
                <span id="dbSelectedTongTien" style="color:var(--nh-gold)">0 ₫</span>
              </div>
              <div class="db-selected-list" id="dbSelectedList"></div>
            </div>

            <div class="db-dieuhuong">
              <button type="button" class="nh-btn nh-btn--outline" data-lui="1">
                <i class="fas fa-arrow-left"></i> <%= t('dat_ban_moi.quay_lai') %>
              </button>
              <button type="button" class="nh-btn nh-btn--outline" id="dbBoQuaMon">
                <i class="fas fa-forward"></i> <%= t('dat_ban_moi.bo_qua_buoc_nay') %>
              </button>
              <button type="button" class="nh-btn nh-btn--gold" id="dbTiepMon">
                <%= t('dat_ban_moi.tiep_tuc') %> <i class="fas fa-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- ============================ BƯỚC 3: THÔNG TIN =================== -->
        <div class="db-man" id="man3" data-buoc="3">
          <div class="nh-panel">
            <h3 class="nh-panel__title"><i class="fas fa-user-edit"></i> <%= t('dat_ban_moi.b3_tieu_de') %></h3>

            <div class="nh-fields">
              <div class="nh-field">
                <label for="dbTen"><%= t('dat_ban_moi.ho_ten') %> <span class="req">*</span></label>
                <input id="dbTen" class="nh-input" maxlength="150" autocomplete="name"
                       value="<%= session.username || '' %>" required>
              </div>
              <div class="nh-field">
                <label for="dbDienThoai"><%= t('dat_ban_moi.dien_thoai') %> <span class="req">*</span></label>
                <input id="dbDienThoai" class="nh-input" type="tel" inputmode="tel" maxlength="30"
                       autocomplete="tel" value="<%= session.usersdt || '' %>" required>
                <span class="nh-hint"><%= t('dat_ban_moi.dien_thoai_hint') %></span>
              </div>
              <div class="nh-field nh-field--full">
                <label for="dbEmail"><%= t('dat_ban_moi.email') %></label>
                <input id="dbEmail" class="nh-input" type="email" maxlength="190" autocomplete="email">
                <span class="nh-hint"><%= t('dat_ban_moi.email_hint') %></span>
              </div>
            </div>

            <h4 style="font-size:1.05rem;margin:1.8rem 0 .8rem"><%= t('dat_ban_moi.dip_dac_biet') %></h4>
            <div class="db-the" id="dbThe">
              <% theYeuCau.forEach(function (the) { %>
                <label class="db-the__o">
                  <input type="checkbox" value="<%= the.code %>" data-kind="<%= the.kind %>">
                  <span><i class="fas <%= the.icon %>"></i> <%= nhanThe(the) %></span>
                </label>
              <% }); %>
            </div>

            <div class="nh-field nh-field--full" style="margin-top:1.4rem">
              <label for="dbYeuCau"><%= t('dat_ban_moi.yeu_cau_them') %></label>
              <textarea id="dbYeuCau" class="nh-textarea" maxlength="800"
                        placeholder="<%= t('dat_ban_moi.yeu_cau_goi_y') %>"></textarea>
            </div>

            <div class="db-dieuhuong">
              <button type="button" class="nh-btn nh-btn--outline" data-lui="1">
                <i class="fas fa-arrow-left"></i> <%= t('dat_ban_moi.quay_lai') %>
              </button>
              <button type="button" class="nh-btn nh-btn--gold" id="dbTiep3">
                <%= t('dat_ban_moi.xem_lai') %> <i class="fas fa-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- ============================ BƯỚC 4: XÁC NHẬN ==================== -->
        <div class="db-man" id="man4" data-buoc="4">
          <div class="nh-panel">
            <h3 class="nh-panel__title"><i class="fas fa-clipboard-check"></i> <%= t('dat_ban_moi.b4_tieu_de') %></h3>
            <div id="dbBaoGui"></div>
            <dl class="db-xemlai" id="dbXemLai"></dl>

            <div class="db-bao db-bao--nhac" style="margin-top:1.4rem">
              <i class="fas fa-info-circle"></i>
              <div><%- t('dat_ban_moi.dieu_khoan').replace('{giu}', cauHinh.giu_ban_phut) %></div>
            </div>

            <div class="db-dieuhuong">
              <button type="button" class="nh-btn nh-btn--outline" data-lui="1">
                <i class="fas fa-arrow-left"></i> <%= t('dat_ban_moi.quay_lai') %>
              </button>
              <button type="button" class="nh-btn nh-btn--gold" id="dbGui">
                <i class="fas fa-paper-plane"></i> <%= t('dat_ban_moi.gui_yeu_cau') %>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================ TÓM TẮT BÊN PHẢI ==================== -->
      <aside class="nh-panel db-tomtat" aria-live="polite">
        <h3 class="nh-panel__title"><i class="fas fa-receipt"></i> <%= t('dat_ban_moi.tom_tat') %></h3>
        <div id="dbTomTat"></div>
        <div id="dbTomTatCoc"></div>
        <button type="button" class="nh-btn nh-btn--outline nh-btn--sm" id="dbMoModalChinhSach" style="margin-top:1rem;width:100%;justify-content:center;border-color:var(--nh-gold);color:var(--nh-espresso);white-space:normal;line-height:1.35;padding:.55rem .75rem;height:auto;text-align:center;">
          <i class="fas fa-shield-alt" style="color:var(--nh-gold);flex-shrink:0"></i> <span>Xem Chính sách đặt bàn & hoàn hủy</span>
        </button>
        <p class="nh-hint" style="margin-top:1rem">
          <i class="fas fa-phone"></i> <%= t('dat_ban_moi.can_ho_tro') %>
        </p>
        <a href="/my-orders" class="nh-btn nh-btn--outline nh-btn--sm" style="margin-top:.6rem;width:100%;justify-content:center">
          <i class="fas fa-history"></i> <%= t('dieu_huong.don_cua_toi') %>
        </a>
      </aside>
    </div>
  </div>
</section>

<!-- Modal xem nhanh Chính sách Đặt bàn ở mọi bước -->
<div class="db-modal-backdrop" id="dbModalChinhSach" role="dialog" aria-modal="true" aria-labelledby="dbModalTitle">
  <div class="db-modal">
    <button type="button" class="db-modal__close" id="dbDongModalChinhSach" aria-label="Đóng"><i class="fas fa-times"></i></button>
    <h3 id="dbModalTitle" style="font-size:1.25rem; color:var(--nh-espresso); margin:0 0 0.9rem; display:flex; align-items:center; gap:0.55rem;">
      <i class="fas fa-shield-alt" style="color:var(--nh-gold)"></i> Chính sách Đặt bàn, Đặt cọc & Hoàn hủy
    </h3>
    <div class="db-cs-grid" style="margin-bottom:1rem;">
      <div class="db-cs-card">
        <span class="db-cs-badge db-cs-badge--green">Giờ thường · 1 – 5 khách</span>
        <h4>Miễn đặt cọc (0đ)</h4>
        <p>Ngoài khung giờ cao điểm (<%= cauHinh.gio_cao_diem || '18:00-21:00' %>) cho bàn dưới 6 khách không đặt món trước.</p>
      </div>
      <div class="db-cs-card">
        <span class="db-cs-badge">Giờ cao điểm / Bàn 6–14 khách</span>
        <h4>Cọc 100.000đ / người</h4>
        <p>Áp dụng trong giờ cao điểm (<%= cauHinh.gio_cao_diem || '18:00-21:00' %>) nếu không đặt món trước, hoặc bàn từ 6–14 khách ở giờ thường.</p>
      </div>
      <div class="db-cs-card db-cs-card--highlight">
        <span class="db-cs-badge db-cs-badge--gold">Đặt tiệc ≥ <%= cauHinh.nguong_tiec || 15 %> khách</span>
        <h4>Cọc 150.000đ / người</h4>
        <p>Bắt buộc mọi khung giờ. <b>Nếu dùng món thực tế thấp hơn tổng mức 150.000đ/người sẽ được hoàn lại tiền thừa ngay lúc thanh toán.</b></p>
      </div>
      <div class="db-cs-card">
        <span class="db-cs-badge" style="background:#e0f2fe; color:#0369a1;">Đặt trước món ăn</span>
        <h4>Thanh toán 100% tiền món</h4>
        <p>Thanh toán trước 100% tiền món đã chọn (miễn thu thêm cọc bàn 100k/người; đoàn tiệc ≥ 15 người tối thiểu 150k/người).</p>
      </div>
    </div>
    <table class="db-cs-table">
      <thead>
        <tr>
          <th>Mốc thời gian hủy (trước giờ hẹn)</th>
          <th>Bàn thường (&lt; 15 khách)</th>
          <th>Đoàn tiệc (≥ 15 khách) / Có đặt món trước</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><b>Trước ≥ 24 giờ</b></td><td style="color:#15803d;font-weight:700;">Hoàn 100%</td><td style="color:#15803d;font-weight:700;">Hoàn 100%</td></tr>
        <tr><td><b>Từ 6h đến dưới 24h</b></td><td style="color:#b45309;font-weight:700;">Hoàn 70%</td><td style="color:#b45309;font-weight:700;">Hoàn 50%</td></tr>
        <tr><td><b>Từ 2h đến dưới 6h</b></td><td style="color:#b45309;font-weight:700;">Hoàn 50%</td><td style="color:#b91c1c;font-weight:700;">Không hoàn (0%)</td></tr>
        <tr><td><b>Dưới 2 giờ / Không đến (No-show)</b></td><td style="color:#b91c1c;font-weight:700;">Không hoàn (0%)</td><td style="color:#b91c1c;font-weight:700;">Không hoàn (0%)</td></tr>
      </tbody>
    </table>
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.6rem; margin-top:1.1rem;">
      <a href="/chinh-sach-dat-ban.pdf?tai=1" class="nh-btn nh-btn--outline nh-btn--sm">
        <i class="fas fa-file-pdf"></i> Tải file Chính sách (PDF)
      </a>
      <button type="button" class="nh-btn nh-btn--gold nh-btn--sm" id="dbDongModalChinhSachBtn">Đã hiểu</button>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  /*
    Tu dien nhan giao dien, nap mot lan duoi dang JSON.

    Truoc day moi chuoi duoc nhung thang vao JavaScript bang the xuat EJS.
    Cach do chay dung, nhung no gai mot cai bay: the xuat escape ky tu HTML, ma noi
    dung the <script> KHONG duoc trinh duyet giai ma thuc the nguoc lai. Nen chi
    can mot ban dich chua dau nhay don ("Let's...") la man hinh hien ra
    "Let&#39;s" - va khong ai phat hien duoc cho den khi doi sang ngon ngu do.

    JSON.stringify + doi dau '<' thanh \u003c: khong ban dich nao dong duoc som
    the script (chi mot chuoi chua the dong la ca khoi JavaScript ben duoi chet),
    va moi ky tu deu qua duoc nguyen ven.
  */
  var T = <%- JSON.stringify(nhan).replace(/</g, '\\u003c') %>;

  var CF = <%- JSON.stringify(cauHinh) %>;
  var KHU = <%- JSON.stringify(khuVuc) %>;
  var DS_MON_AN = <%- JSON.stringify((dsMonAn || []).map(function(m){ return { id_mon: m.id_mon, name_mon: m.name_mon, images: m.images || '' }; })) %>;

  /*
    Trang thai cua ca man hinh nam trong MOT doi tuong.

    Khong doc nguoc lai tu DOM khi can gia tri: DOM la noi HIEN THI trang thai,
    khong phai noi luu no. Doc nguoc tu DOM la cach nhanh nhat de co hai nguon
    su that - vi du so khach hien tren tom tat lech voi so khach thuc su gui len.
  */
  var S = {
    buoc: 'cs',
    ngay: document.getElementById('dbNgay').value,
    soKhach: 0,
    khuVuc: document.getElementById('dbKhuVuc').value, // co the duoc chon san qua ?khu_vuc= (trang /khong-gian)
    gio: '',
    thoiLuong: null,
    ban: [],        // id ban khach tu chon; rong = de nha hang xep
    tongChoDaChon: 0,
    the: [],
    coc: null,
    goiY: null,     // to hop ban he thong de xuat
    mon: {}         // { id_mon: { id_mon, name_mon, gia_mon, soluong } }
  };

  // Buoc 'cs' (Xem chinh sach dat ban) luon nam dau tien. Buoc 2 chi ton tai khi cho phep tu chon ban.
  var BUOC = CF.cho_chon_ban ? ['cs', 1, 2, 'mon', 3, 4] : ['cs', 1, 'mon', 3, 4];
  var TEN_BUOC = {
    'cs': 'Chính sách',
    1: T['dat_ban_moi.b1_ngan'] || 'Thời gian',
    2: T['dat_ban_moi.b2_ngan'] || 'Chọn bàn',
    'mon': T['dat_ban_moi.b_mon_ngan'] || 'Gọi món',
    3: T['dat_ban_moi.b3_ngan'] || 'Thông tin',
    4: T['dat_ban_moi.b4_ngan'] || 'Xác nhận'
  };

  var $ = function (id) { return document.getElementById(id); };
  var tien = function (n) { return Number(n || 0).toLocaleString('vi-VN') + 'đ'; };
  var ngayVN = function (s) { return String(s || '').split('-').reverse().join('/'); };

  function tinhTongTienMonDaChon() {
    return Object.values(S.mon || {}).reduce(function (s, m) {
      return s + (Number(m.soluong || 0) * Number(m.gia_mon || 0));
    }, 0);
  }

  /** Chen van ban an toan - khong bao gio dung innerHTML voi du lieu tu API. */
  function chu(the, lop, noiDung) {
    var n = document.createElement(the);
    if (lop) n.className = lop;
    if (noiDung != null) n.textContent = noiDung;
    return n;
  }

  function bao(khung, kieu, thongDiep, phuThem) {
    khung.innerHTML = '';
    if (!thongDiep) return;
    var hop = chu('div', 'db-bao db-bao--' + kieu);
    var i = document.createElement('i');
    i.className = 'fas ' + (kieu === 'loi' ? 'fa-exclamation-circle'
      : kieu === 'ok' ? 'fa-check-circle' : 'fa-info-circle');
    hop.appendChild(i);
    var than = chu('div', null, thongDiep);
    if (phuThem) than.appendChild(phuThem);
    hop.appendChild(than);
    khung.appendChild(hop);
  }

  // ------------------------------------------------------------- thanh buoc

  function veThanhBuoc() {
    var ol = $('dbBuoc');
    ol.innerHTML = '';
    BUOC.forEach(function (b, i) {
      var li = chu('li', 'db-buoc__o');
      if (b === S.buoc) li.setAttribute('aria-current', 'step');
      var daQua = BUOC.indexOf(S.buoc) > i;
      if (daQua) {
        li.setAttribute('data-xong', '1');
        li.style.cursor = 'pointer';
        li.title = 'Quay lại bước ' + TEN_BUOC[b];
        li.addEventListener('click', function () { den(b); });
      }
      li.appendChild(chu('span', 'db-buoc__so', String(i + 1)));
      li.appendChild(document.createTextNode(TEN_BUOC[b]));
      ol.appendChild(li);
    });
  }

  function den(buoc) {
    S.buoc = buoc;
    ['Cs', 1, 2, 'Mon', 3, 4].forEach(function (b) {
      var m = $('man' + b);
      if (m) m.classList.toggle('hien', String(b).toLowerCase() === String(buoc).toLowerCase());
    });
    veThanhBuoc();
    veTomTat();
    var moc = $('dbBuoc');
    if (moc) moc.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (buoc === 2) taiSoDo();
    if (String(buoc).toLowerCase() === 'mon') veGoiYCombo();
    if (buoc === 4) veXemLai();
  }

  function tienTu(buoc) {
    var i = BUOC.indexOf(buoc);
    return BUOC[i + 1] || buoc;
  }
  function luiTu(buoc) {
    var i = BUOC.indexOf(buoc);
    return BUOC[i - 1] || buoc;
  }

  // -------------------------------------------------------------- bước CS: CHÍNH SÁCH ĐẶT BÀN

  var chkDongY = $('dbDongYChinhSach');
  var btnBatDau = $('dbBatDauDatBan');
  if (chkDongY && btnBatDau) {
    chkDongY.addEventListener('change', function () {
      btnBatDau.disabled = !chkDongY.checked;
    });
    btnBatDau.addEventListener('click', function () {
      if (!chkDongY.checked) return;
      den(1);
    });
  }

  var modalCs = $('dbModalChinhSach');
  var btnMoModalCs = $('dbMoModalChinhSach');
  var btnDongModalCs = $('dbDongModalChinhSach');
  var btnDongModalCs2 = $('dbDongModalChinhSachBtn');
  function moModalChinhSach() {
    if (modalCs) modalCs.classList.add('hien');
  }
  function dongModalChinhSach() {
    if (modalCs) modalCs.classList.remove('hien');
  }
  if (btnMoModalCs) btnMoModalCs.addEventListener('click', moModalChinhSach);
  if (btnDongModalCs) btnDongModalCs.addEventListener('click', dongModalChinhSach);
  if (btnDongModalCs2) btnDongModalCs2.addEventListener('click', dongModalChinhSach);
  if (modalCs) {
    modalCs.addEventListener('click', function (e) {
      if (e.target === modalCs) dongModalChinhSach();
    });
  }

  function laKhungGioCaoDiem(gioStr) {
    if (!gioStr) return false;
    var p = String(gioStr).split(':');
    var phut = (Number(p[0]) || 0) * 60 + (Number(p[1]) || 0);
    var ds = String(CF.gio_cao_diem || '18:00-21:00').split(',');
    for (var i = 0; i < ds.length; i++) {
      var cap = ds[i].trim().split('-');
      if (cap.length === 2) {
        var d = cap[0].split(':'), c = cap[1].split(':');
        var tu = (Number(d[0]) || 0) * 60 + (Number(d[1]) || 0);
        var denP = (Number(c[0]) || 0) * 60 + (Number(c[1]) || 0);
        if (phut >= tu && phut <= denP) return true;
      }
    }
    return false;
  }

  function veChinhSachApDung() {
    var hop = $('dbChinhSachApDung');
    if (!hop) return;
    var soK = Number(S.soKhach || 0);
    var nguongTiec = Number(CF.nguong_tiec || 15);
    var caoDiem = laKhungGioCaoDiem(S.gio);
    var tongMon = tinhTongTienMonDaChon();

    hop.className = 'db-live-policy';
    if (soK <= 0) {
      hop.innerHTML = '<i class="fas fa-user-friends"></i><div>'
        + 'Vui lòng <b>nhập hoặc chọn số lượng khách</b> để hệ thống hiển thị khung giờ trống và chính sách đặt cọc tương ứng.'
        + '</div>';
      return;
    }
    if (soK >= nguongTiec) {
      var cocTiec = soK * 150000;
      hop.innerHTML = '<i class="fas fa-crown"></i><div>'
        + '<b>Chính sách áp dụng cho đoàn tiệc ' + soK + ' khách:</b> Bắt buộc đặt cọc <b>150.000đ/người</b> (tạm tính <b>' + tien(cocTiec) + '</b>).'
        + '<br><span style="color:#15803d;font-weight:600;"><i class="fas fa-hand-holding-usd"></i> Cam kết: Nếu khi dùng bữa thực tế tổng tiền món thấp hơn ' + tien(cocTiec) + ', nhà hàng sẽ hoàn lại phần tiền thừa ngay lúc thanh toán.</span>'
        + '</div>';
      return;
    }

    if (tongMon > 0) {
      hop.innerHTML = '<i class="fas fa-utensils"></i><div>'
        + '<b>Chính sách đặt món trước (' + soK + ' khách):</b> Thanh toán trước <b>100% tiền món đã chọn (' + tien(tongMon) + ')</b> — được miễn thu thêm cọc bàn 100.000đ/người.'
        + '</div>';
      return;
    }

    if (!S.gio) {
      if (soK >= 6) {
        hop.innerHTML = '<i class="fas fa-info-circle"></i><div>'
          + '<b>Chính sách áp dụng cho bàn ' + soK + ' khách:</b> Đặt cọc giữ bàn <b>100.000đ/người (' + tien(soK * 100000) + ')</b> (hoặc thanh toán 100% tiền món nếu quý khách chọn đặt món trước ở bước tiếp theo).'
          + '</div>';
      } else {
        hop.innerHTML = '<i class="fas fa-info-circle"></i><div>'
          + '<b>Chính sách áp dụng cho bàn ' + soK + ' khách:</b> <b>Miễn đặt cọc (0đ)</b> nếu chọn khung giờ thường; <b>cọc 100.000đ/người (' + tien(soK * 100000) + ')</b> nếu chọn khung giờ cao điểm (' + (CF.gio_cao_diem || '18:00-21:00') + ') mà không đặt trước món ăn.'
          + '</div>';
      }
      return;
    }

    if (caoDiem) {
      hop.innerHTML = '<i class="fas fa-fire" style="color:#d97706"></i><div>'
        + '<b>Khung giờ cao điểm (' + S.gio + ') · ' + soK + ' khách:</b> Bắt buộc đặt cọc bàn <b>100.000đ/người (' + tien(soK * 100000) + ')</b> nếu không đặt trước món ăn (nếu đặt món trước ở bước sau sẽ thanh toán 100% tiền món, miễn cọc bàn).'
        + '</div>';
    } else if (soK >= 6) {
      hop.innerHTML = '<i class="fas fa-users"></i><div>'
        + '<b>Khung giờ thường (' + S.gio + ') · Bàn từ 6 khách (' + soK + ' khách):</b> Đặt cọc giữ bàn <b>100.000đ/người (' + tien(soK * 100000) + ')</b> nếu không đặt trước món ăn.'
        + '</div>';
    } else {
      hop.className = 'db-live-policy db-live-policy--free';
      hop.innerHTML = '<i class="fas fa-check-circle"></i><div>'
        + '<b>Khung giờ thường (' + S.gio + ') · ' + soK + ' khách:</b> <b>Miễn đặt cọc giữ bàn (0đ)</b> (trừ khi quý khách chủ động chọn đặt món trước ở bước tiếp theo).'
        + '</div>';
    }
  }

  // -------------------------------------------------------------- bước 1

  // Chon nhanh so khach: cham mot lan thay vi go so - nhanh hon han tren dien thoai.
  (function veNhanhKhach() {
    var khung = $('dbNhanhKhach');
    [2, 4, 6, 8, 10, 12, 15, 20].forEach(function (n) {
      if (n > CF.toi_da_khach) return;
      var l = chu('label', 'nh-chip');
      var o = document.createElement('input');
      o.type = 'radio'; o.name = 'dbNhanh'; o.value = String(n);
      o.addEventListener('change', function () {
        $('dbSoKhach').value = n;
        S.soKhach = n;
        veChinhSachApDung();
        veTomTat();
        taiKhungGio();
      });
      l.appendChild(o);
      l.appendChild(chu('span', null, n + ' ' + T['dat_ban_moi.khach']));
      khung.appendChild(l);
    });
  })();

  var henTai = null;
  function taiKhungGioHoan() {
    clearTimeout(henTai);
    henTai = setTimeout(taiKhungGio, 320);
  }

  async function taiKhungGio() {
    var khung = $('dbGio');
    var baoKhung = $('dbBaoGio');
    khung.innerHTML = '';
    S.gio = '';
    S.thoiLuong = null;
    S.coc = null;
    $('dbTiep1').disabled = true;
    baoKhung.innerHTML = '';

    if (!S.soKhach || S.soKhach <= 0) {
      bao(baoKhung, 'nhac', 'Vui lòng chọn hoặc nhập số lượng khách (từ 1 khách trở lên) để xem các khung giờ còn bàn.');
      veChinhSachApDung();
      veTomTat();
      return;
    }

    var tai = chu('p', 'nh-hint');
    tai.appendChild(chu('span', 'db-tai'));
    tai.appendChild(document.createTextNode(' ' + T['dat_ban_moi.dang_tim_gio']));
    khung.appendChild(tai);

    var q = new URLSearchParams({ ngay: S.ngay, so_khach: S.soKhach });
    if (S.khuVuc) q.set('khu_vuc', S.khuVuc);

    try {
      var kq = await fetch('/api/dat-ban/khung-gio?' + q).then(function (r) { return r.json(); });
      khung.innerHTML = '';

      if (!kq.ok) { bao(baoKhung, 'loi', kq.thong_bao || T['dat_ban_moi.loi_chung']); return; }
      if (kq.dong_cua) { bao(baoKhung, 'nhac', kq.ly_do); return; }
      if (!kq.khung.length) {
        bao(baoKhung, 'nhac', T['dat_ban_moi.het_gio_trong_ngay']);
        return;
      }

      S.thoiLuong = kq.thoi_luong;
      var conBan = 0;

      kq.khung.forEach(function (k) {
        if (k.con_ban) conBan += 1;
        var l = chu('label', 'db-gio__o');
        var o = document.createElement('input');
        o.type = 'radio'; o.name = 'dbGioChon'; o.value = k.gio;
        o.disabled = !k.con_ban;
        o.addEventListener('change', function () {
          S.gio = k.gio;
          S.ban = [];
          $('dbTiep1').disabled = false;
          veChinhSachApDung();
          veTomTat();
          taiCoc();
        });
        var s = document.createElement('span');
        if (k.cao_diem) s.classList.add('db-gio__caodiem');
        s.appendChild(document.createTextNode(k.gio));
        s.appendChild(chu('small', null, k.con_ban
          ? (k.cao_diem ? T['dat_ban_moi.cao_diem'] : T['dat_ban_moi.con_ban'])
          : T['dat_ban_moi.het_ban']));
        l.appendChild(o);
        l.appendChild(s);
        khung.appendChild(l);
      });

      if (!conBan) {
        bao(baoKhung, 'nhac', T['dat_ban_moi.kin_ban_ngay']);
      }
      veChinhSachApDung();
