    border-radius: 999px; padding: .45rem 1rem; font: inherit; font-size: .84rem; font-weight: 600; cursor: pointer; }
  .db-goiy button:hover { background: #fffbeb; border-color: #d97706; }

  /* ---------- The yeu cau dac biet ---------- */
  .db-the { display: grid; grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); gap: .5rem; }
  .db-the__o { position: relative; }
  .db-the__o input { position: absolute; opacity: 0; width: 0; height: 0; }
  .db-the__o span { display: flex; align-items: center; gap: .5rem; padding: .6rem .85rem; border-radius: 10px;
    border: 1.5px solid var(--nh-line); background: var(--nh-cream); font-size: .86rem; cursor: pointer;
    transition: all .2s var(--nh-ease); }
  .db-the__o input:checked + span { background: var(--nh-espresso); border-color: var(--nh-espresso); color: var(--nh-cream); }
  .db-the__o input:focus-visible + span { box-shadow: 0 0 0 4px rgba(200,162,75,.3); }
  .db-the__o span i { color: var(--nh-gold); width: 16px; text-align: center; }
  .db-the__o input:checked + span i { color: var(--nh-gold-soft); }

  /* ---------- Mon goi truoc (Buoc Goi Mon) ---------- */
  .db-combo-section { margin-bottom: 1.2rem; background: linear-gradient(135deg, #fffdfa 0%, #fcf6ea 100%); border: 1.5px solid rgba(200,162,75,0.35); border-radius: 14px; padding: 1rem 1.1rem; box-shadow: 0 4px 14px rgba(200,162,75,0.08); }
  .db-combo-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.4rem; }
  .db-combo-title { font-size: 0.95rem; font-weight: 700; color: var(--nh-espresso); display: flex; align-items: center; gap: 0.5rem; margin: 0; }
  .db-combo-title i { color: var(--nh-gold); }
  .db-combo-badge { font-size: 0.75rem; background: var(--nh-gold); color: var(--nh-espresso); font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px; }
  
  .db-combo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.85rem; }
  .db-combo-card { background: #fff; border: 1.5px solid rgba(200,162,75,0.25); border-radius: 12px; padding: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 0; transition: all 0.25s var(--nh-ease); box-shadow: 0 2px 6px rgba(0,0,0,0.03); position: relative; overflow: hidden; }
  .db-combo-card:hover { border-color: var(--nh-gold); box-shadow: 0 6px 18px rgba(200,162,75,0.2); transform: translateY(-2px); }
  .db-combo-card.is-recommended { border-color: var(--nh-gold); background: #fffdf7; }
  .db-combo-banner { width: 100%; height: 120px; overflow: hidden; position: relative; background: #231c19; }
  .db-combo-banner img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .db-combo-card:hover .db-combo-banner img { transform: scale(1.05); }
  .db-combo-tag { position: absolute; top: 0; right: 0; background: linear-gradient(135deg, var(--nh-gold), #e5c378); color: var(--nh-espresso); font-size: 0.68rem; font-weight: 800; padding: 0.2rem 0.6rem; border-bottom-left-radius: 8px; text-transform: uppercase; letter-spacing: 0.05em; z-index: 2; }
  
  .db-combo-inner { padding: 0.85rem 0.95rem; display: flex; flex-direction: column; justify-content: space-between; flex: 1; gap: 0.6rem; }
  .db-combo-top { display: flex; flex-direction: column; gap: 0.3rem; }
  .db-combo-name { font-size: 0.92rem; font-weight: 700; color: var(--nh-espresso); line-height: 1.3; }
  .db-combo-for { font-size: 0.78rem; color: #b45309; font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem; }
  .db-combo-desc { font-size: 0.8rem; color: var(--nh-muted); line-height: 1.4; margin: 0.2rem 0 0 0; }
  .db-combo-price-row { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; margin-top: 0.3rem; }
