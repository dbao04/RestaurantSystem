<%- include('partials/header', { title: t('dat_ban_moi.tieu_de') }) %>
<%
/*
  TRANG DAT BAN CUA KHACH - bon buoc.

    1. Thoi gian   ngay, so khach, khung gio (o nao het ban thi hien mo, khong an)
    2. Chon ban    so do mat bang that, tab theo khu vuc
    3. Thong tin   ten, dien thoai, dip, yeu cau dac biet
    4. Xac nhan    doi chieu lai + tien coc truoc khi gui

  VI SAO CHIA BUOC CHU KHONG DE MOT FORM DAI
  ------------------------------------------
  Mot form dai bat khach dien het roi moi biet khung gio do da het ban - va luc
  do ho phai sua lai tu dau. Chia buoc cho phep kiem tra bàn NGAY o buoc 1, khi
  khach chua bo cong dien gi ca. Do cung la ly do buoc "chon ban" dung truoc
  buoc "thong tin": biet chac co ban roi moi hoi ten khach.

  BUOC 2 CO THE BI BO QUA
  -----------------------
  Neu quan ly tat `allow_customer_pick_table`, buoc 2 bien mat va he thong tu
  xep ban. Trang van chay dung voi ba buoc - so buoc duoc tinh trong `BUOC`
  luc khoi tao chu khong viet cung trong HTML.

  KHONG CO TRANG NAO BI KHOA VI THIEU JAVASCRIPT
  ----------------------------------------------
  Neu JS hong, `<noscript>` chi khach sang so dien thoai cua nha hang. Mot form
  dat ban gui thang khong co kiem tra bàn se nhan don cho nhung khung gio da
  kin - hua mot dieu khong giu duoc con te hon la bao khach goi dien.
*/

/*
  Nhan the yeu cau rieng. `label_vi` trong CSDL la ban goc; ban dich tra theo
  `code`. The quan ly tu them chua co khoa dich se giu nguyen `label_vi` -
  thieu ban dich thi thoi, chu khong bien mat khoi danh sach.
*/
var nhanThe = function (the) {
  var nhan = t('dat_ban_moi.the_' + the.code);
  return nhan === 'dat_ban_moi.the_' + the.code ? the.label_vi : nhan;
};
%>

<section class="nh-subhero nh-subhero--sm">
  <div class="nh-subhero__bg" style="background-image:url('/bg_1.jpg')"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-subhero__inner nh-container">
    <span class="nh-eyebrow"><%= t('dat_ban_moi.eyebrow') %></span>
