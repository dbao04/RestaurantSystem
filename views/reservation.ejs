      minKhach: 3,
      maxKhach: 5,
      nguoiText: 'Dành cho 4 người',
      moTa: '1 Bò Aukobe Steak + 1 Combo Hàu Hyogo + 1 Combo Sushi Set 3 + 1 Lẩu Nabe Hải Sản.',
      monList: [
        { id_mon: 267, name_mon: 'E05-BÒ AUKOBE STEAK', gia_mon: 159000, soluong: 1 },
        { id_mon: 127, name_mon: 'SH01-COMBO HÀU HYOGO', gia_mon: 199000, soluong: 1 },
        { id_mon: 207, name_mon: 'SET3-COMBO SUSHI SET 3', gia_mon: 299000, soluong: 1 },
        { id_mon: 298, name_mon: 'H06-LẨU NABE HẢI SẢN', gia_mon: 249000, soluong: 1 }
      ]
    },
    {
      id: 'combo_6k_tiec',
      ten: 'Combo Tiệc Bạn Bè & Đồng Nghiệp (5 - 6 người)',
      minKhach: 5,
      maxKhach: 8,
      nguoiText: 'Dành cho 5 - 6 người',
      moTa: '1 Salad bò Mỹ + 1 Sashimi Set G Đại Tiệc (799k) + 1 Combo Sushi Set 4 (399k) + 1 Lẩu Kim Chi Hải Sản + 1 Bò Áp Chảo.',
      monList: [
        { id_mon: 125, name_mon: 'SA06-SALAD BÒ MỸ XÀO VÀ TRỨNG ONSEN', gia_mon: 119000, soluong: 1 },
        { id_mon: 167, name_mon: 'SETG-SASHIMI SET G', gia_mon: 799000, soluong: 1 },
        { id_mon: 208, name_mon: 'SET4-COMBO SUSHI SET 4', gia_mon: 399000, soluong: 1 },
        { id_mon: 296, name_mon: 'H04-LẨU KIM CHI HẢI SẢN', gia_mon: 199000, soluong: 1 },
        { id_mon: 263, name_mon: 'E01-BÒ AUKOBE ÁP CHẢO', gia_mon: 159000, soluong: 1 }
      ]
    },
    {
      id: 'combo_8k_hoangia',
      ten: 'Combo Đại Tiệc Hoàng Gia (7 - 10+ người)',
      minKhach: 7,
      maxKhach: 99,
      nguoiText: 'Dành cho 7 - 10+ người',
      moTa: '1 Sashimi Set H Premium (899k) + 2 Combo Sushi Set 3 + 1 Lẩu Nấm Cá Hồi + 1 Lẩu Sukiyaki + 2 Bò Aukobe Steak + Khai vị.',
      monList: [
        { id_mon: 168, name_mon: 'SETH-SASHIMI SET H PREMIUM', gia_mon: 899000, soluong: 1 },
        { id_mon: 207, name_mon: 'SET3-COMBO SUSHI SET 3', gia_mon: 299000, soluong: 2 },
        { id_mon: 293, name_mon: 'H01-LẨU NẤM CÁ HỒI', gia_mon: 245000, soluong: 1 },
        { id_mon: 297, name_mon: 'H05-LẨU SUKIYAKI', gia_mon: 259000, soluong: 1 },
        { id_mon: 267, name_mon: 'E05-BÒ AUKOBE STEAK', gia_mon: 159000, soluong: 2 },
        { id_mon: 120, name_mon: 'SA01-SALAD CUA LỘT', gia_mon: 189000, soluong: 1 }
      ]
    }
  ];

  function veGoiYCombo() {
    var grid = $('dbComboGrid');
    var textKhach = $('dbComboGuestText');
    if (!grid) return;
    grid.innerHTML = '';
    var soK = Number(S.soKhach || 2);
    if (textKhach) textKhach.textContent = soK + ' khách';

    // Sắp xếp combo ưu tiên combo khớp với số lượng khách của phiên đặt hiện tại
    var combosHienThi = DANH_SACH_COMBOS.slice().sort(function (a, b) {
      var aKhop = (soK >= a.minKhach && soK <= a.maxKhach);
      var bKhop = (soK >= b.minKhach && soK <= b.maxKhach);
      if (aKhop && !bKhop) return -1;
      if (!aKhop && bKhop) return 1;
      return 0;
    });

    combosHienThi.forEach(function (cb) {
      var laGoiYChinh = (soK >= cb.minKhach && soK <= cb.maxKhach);
      var tongTienCombo = cb.monList.reduce(function (sum, item) {
        return sum + (item.gia_mon * item.soluong);
      }, 0);

      var card = document.createElement('div');
      card.className = 'db-combo-card' + (laGoiYChinh ? ' is-recommended' : '');
      
      var tagHtml = laGoiYChinh ? '<div class="db-combo-tag"><i class="fas fa-thumbs-up"></i> Khuyên dùng</div>' : '';

      card.innerHTML = tagHtml +
        '<div class="db-combo-top">' +
          '<div class="db-combo-for"><i class="fas fa-user-friends"></i> ' + cb.nguoiText + '</div>' +
          '<div class="db-combo-name">' + cb.ten + '</div>' +
          '<p class="db-combo-desc">' + cb.moTa + '</p>' +
        '</div>' +
        '<div>' +
          '<div class="db-combo-price-row">' +
            '<span style="font-size:0.78rem; color:var(--nh-muted);">Trọn gói combo:</span>' +
            '<span class="db-combo-price">' + tien(tongTienCombo) + '</span>' +
          '</div>' +
          '<button type="button" class="db-combo-btn mt-2" data-comboid="' + cb.id + '">' +
            '<i class="fas fa-cart-plus"></i> Chọn Combo này' +
          '</button>' +
        '</div>';

      var btn = card.querySelector('button');
      btn.addEventListener('click', function () {
        themNhanhCombo(cb);
      });

      grid.appendChild(card);
    });
  }

  function themNhanhCombo(combo) {
    combo.monList.forEach(function (m) {
      if (!S.mon[m.id_mon]) {
        S.mon[m.id_mon] = { id_mon: m.id_mon, name_mon: m.name_mon, gia_mon: m.gia_mon, soluong: 0 };
      }
      S.mon[m.id_mon].soluong += m.soluong;
    });
    capNhatGiaoDienMon();
    
    // Cuộn nhẹ xuống khay món đã chọn để khách thấy
    var tray = $('dbSelectedTray');
    if (tray) {
      tray.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  window.tangMon = function (id, ten, gia) {
    if (!S.mon[id]) {
      S.mon[id] = { id_mon: id, name_mon: ten, gia_mon: gia, soluong: 0 };
    }
    S.mon[id].soluong += 1;
    capNhatGiaoDienMon();
  };

  window.giamMon = function (id) {
    if (!S.mon[id]) return;
    S.mon[id].soluong -= 1;
    if (S.mon[id].soluong <= 0) {
      delete S.mon[id];
    }
    capNhatGiaoDienMon();
  };

  document.querySelectorAll('.btn-tang-mon').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = this.getAttribute('data-id');
      var ten = this.getAttribute('data-ten');
      var gia = Number(this.getAttribute('data-gia') || 0);
      tangMon(id, ten, gia);
    });
  });

  document.querySelectorAll('.btn-giam-mon').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = this.getAttribute('data-id');
      giamMon(id);
    });
  });

  function capNhatGiaoDienMon() {
    document.querySelectorAll('[id^="qty_"]').forEach(function (el) {
      var id = el.id.replace('qty_', '');
      el.textContent = (S.mon[id] && S.mon[id].soluong) ? S.mon[id].soluong : '0';
    });

    var tray = $('dbSelectedTray');
    var list = $('dbSelectedList');
    var tongTienEl = $('dbSelectedTongTien');
    list.innerHTML = '';

    var ds = Object.values(S.mon);
    if (ds.length === 0) {
      tray.style.display = 'none';
    } else {
      tray.style.display = 'block';
      var tongTien = 0;
      ds.forEach(function (item) {
        tongTien += item.soluong * item.gia_mon;
        var tag = chu('div', 'db-selected-item');
        tag.innerHTML = '<span>' + item.name_mon + ' <b>x' + item.soluong + '</b> (' + tien(item.soluong * item.gia_mon) + ')</span>'
          + ' <button type="button" onclick="giamMon(' + item.id_mon + ')" title="Giảm / Bỏ"><i class="fas fa-times-circle"></i></button>';
        list.appendChild(tag);
      });
      tongTienEl.textContent = tien(tongTien);
    }
    veTomTat();
  }

  // Loc loai mon
  document.querySelectorAll('.db-loai-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.db-loai-btn').forEach(function (b) { b.classList.remove('active'); });
      this.classList.add('active');
      var loai = this.getAttribute('data-loai');
      locMon(loai, ($('dbTimMon').value || '').trim().toLowerCase());
    });
  });

  $('dbTimMon').addEventListener('input', function () {
    var activeBtn = document.querySelector('.db-loai-btn.active');
    var loai = activeBtn ? activeBtn.getAttribute('data-loai') : 'ALL';
    locMon(loai, this.value.trim().toLowerCase());
  });

  function locMon(loai, tuKhoa) {
    document.querySelectorAll('.db-dish-card').forEach(function (card) {
      var cardLoai = card.getAttribute('data-loai');
      var cardTen = card.getAttribute('data-ten') || '';
      var matchLoai = (loai === 'ALL' || String(cardLoai) === String(loai));
      var matchTen = (!tuKhoa || cardTen.indexOf(tuKhoa) >= 0);
      var hien = matchLoai && matchTen;
      card.classList.toggle('is-hidden', !hien);
      card.style.display = hien ? 'flex' : 'none';
    });
  }

  $('dbBoQuaMon').addEventListener('click', function () {
    S.mon = {};
    capNhatGiaoDienMon();
    den(tienTu('mon'));
  });
  $('dbTiepMon').addEventListener('click', function () {
    den(tienTu('mon'));
  });

  // -------------------------------------------------------------- bước 3: THÔNG TIN

  $('dbThe').addEventListener('change', function () {
    S.the = Array.prototype.slice
      .call(document.querySelectorAll('#dbThe input:checked'))
      .map(function (o) { return o.value; });
    veTomTat();
  });

  $('dbTiep3').addEventListener('click', function () {
    var ten = $('dbTen').value.trim();
    var dt = $('dbDienThoai').value.trim();
    if (ten.length < 2) { $('dbTen').focus(); $('dbTen').reportValidity(); return; }
    if (dt.replace(/\D/g, '').length < 8) {
      $('dbDienThoai').setCustomValidity(T['dat_ban_moi.dien_thoai_sai'] || 'Số điện thoại không hợp lệ');
      $('dbDienThoai').reportValidity();
      $('dbDienThoai').setCustomValidity('');
      return;
    }
    den(tienTu(3));
  });

  document.querySelectorAll('[data-lui]').forEach(function (n) {
    n.addEventListener('click', function () { den(luiTu(S.buoc)); });
  });

  // -------------------------------------------------------------- tóm tắt

  async function taiCoc() {
    if (!S.gio) { S.coc = null; veTomTat(); return; }
    var q = new URLSearchParams({
      reservation_date: S.ngay, start_time: S.gio, guest_count: S.soKhach
    });
    if (S.khuVuc) q.set('area_id', S.khuVuc);
    if (S.the.length) q.set('tags', S.the.join(','));
    try {
      var kq = await fetch('/api/dat-ban/kha-dung?' + q).then(function (r) { return r.json(); });
      S.coc = kq.ok ? kq.coc : null;
      S.goiY = kq.ok ? kq.goi_y : null;
    } catch (e) { S.coc = null; }
    veTomTat();
  }

  function hang(nhan, giaTri) {
    var h = chu('div', 'db-tomtat__hang');
    h.appendChild(chu('span', null, nhan));
    var b = document.createElement('b');
    b.textContent = giaTri;
    h.appendChild(b);
    return h;
  }

  function veTomTat() {
    var o = $('dbTomTat');
    o.innerHTML = '';
    o.appendChild(hang(T['dat_ban_moi.ngay'], ngayVN(S.ngay)));
    o.appendChild(hang(T['dat_ban_moi.gio_den'], S.gio || '—'));
    o.appendChild(hang(T['dat_ban_moi.so_khach'], S.soKhach + ' ' + T['dat_ban_moi.khach']));
    if (S.thoiLuong) o.appendChild(hang(T['dat_ban_moi.thoi_luong'], S.thoiLuong + ' ' + T['dat_ban_moi.phut']));

    var tenKhu = T['dat_ban_moi.khu_bat_ky'];
    KHU.forEach(function (k) { if (String(k.id) === String(S.khuVuc)) tenKhu = k.ten; });
    o.appendChild(hang(T['dat_ban_moi.khu_vuc'], tenKhu));

    if (S.ban.length) {
      o.appendChild(hang(T['dat_ban_moi.ban_da_chon'], S.ban.length + ' ' + T['dat_ban_moi.ban_dv'] + ' · ' + S.tongChoDaChon + ' ' + T['dat_ban_moi.cho']));
    } else if (S.goiY) {
      o.appendChild(hang(T['dat_ban_moi.ban_de_xuat'],
        S.goiY.ban.map(function (b) { return b.ten; }).join(', ')));
    }

    var dsMon = Object.values(S.mon);
    if (dsMon.length > 0) {
      var tongMon = dsMon.reduce(function (s, m) { return s + m.soluong; }, 0);
      var tongTienMon = dsMon.reduce(function (s, m) { return s + (m.soluong * m.gia_mon); }, 0);
      o.appendChild(hang('Món gọi trước', tongMon + ' phần (' + tien(tongTienMon) + ')'));
    }

    if (S.the.length) {
      o.appendChild(hang(T['dat_ban_moi.yeu_cau'], S.the.length + ' ' + T['dat_ban_moi.muc']));
    }

    var c = $('dbTomTatCoc');
    c.innerHTML = '';
    if (S.coc && S.coc.soTien > 0) {
      var hop = chu('div', 'db-coc');
      var b = document.createElement('b');
      b.textContent = tien(S.coc.soTien);
      hop.appendChild(b);
      hop.appendChild(chu('div', null, S.coc.lyDo));
      hop.appendChild(chu('div', null, T['dat_ban_moi.coc_ghi_chu']));
      c.appendChild(hop);
    }
  }

  // -------------------------------------------------------------- bước 4: XÁC NHẬN

  function veXemLai() {
    var dl = $('dbXemLai');
    dl.innerHTML = '';
    function muc(nhan, giaTri) {
      if (!giaTri) return;
      dl.appendChild(chu('dt', null, nhan));
      dl.appendChild(chu('dd', null, giaTri));
    }
    var tenKhu = T['dat_ban_moi.khu_bat_ky'];
    KHU.forEach(function (k) { if (String(k.id) === String(S.khuVuc)) tenKhu = k.ten; });
    var tenThe = Array.prototype.slice
      .call(document.querySelectorAll('#dbThe input:checked'))
      .map(function (o) { return o.parentNode.querySelector('span').textContent.trim(); });

    muc(T['dat_ban_moi.ho_ten'], $('dbTen').value.trim());
    muc(T['dat_ban_moi.dien_thoai'], $('dbDienThoai').value.trim());
    muc(T['dat_ban_moi.email'], $('dbEmail').value.trim());
    muc(T['dat_ban_moi.thoi_gian'], S.gio + ' · ' + ngayVN(S.ngay)
      + (S.thoiLuong ? ' · ' + S.thoiLuong + ' ' + T['dat_ban_moi.phut'] : ''));
    muc(T['dat_ban_moi.so_khach'], S.soKhach + ' ' + T['dat_ban_moi.khach']);
    muc(T['dat_ban_moi.khu_vuc'], tenKhu);
    muc(T['dat_ban_moi.ban'], S.ban.length
      ? S.tongChoDaChon + ' ' + T['dat_ban_moi.cho'] + ' (' + T['dat_ban_moi.tu_chon'] + ')'
      : (S.goiY ? S.goiY.ban.map(function (b) { return b.ten; }).join(', ') : T['dat_ban_moi.nha_hang_xep']));

    var dsMon = Object.values(S.mon);
    if (dsMon.length > 0) {
      var dsMonChuoi = dsMon.map(function (m) { return m.name_mon + ' x' + m.soluong; }).join(', ');
      var tongTienMon = dsMon.reduce(function (s, m) { return s + (m.soluong * m.gia_mon); }, 0);
      muc('Món gọi trước', dsMonChuoi + ' (' + tien(tongTienMon) + ')');
    }

    muc(T['dat_ban_moi.yeu_cau'], tenThe.join(' · '));
    muc(T['dat_ban_moi.ghi_chu'], $('dbYeuCau').value.trim());
    if (S.coc && S.coc.soTien > 0) muc(T['dat_ban_moi.tien_coc'], tien(S.coc.soTien) + ' — ' + S.coc.lyDo);
  }

  var dangGui = false;

  $('dbGui').addEventListener('click', async function () {
    if (dangGui) return;
    dangGui = true;
    var nut = this;
    var chuCu = nut.innerHTML;
    nut.disabled = true;
    nut.innerHTML = '<span class="db-tai"></span> ' + T['dat_ban_moi.dang_gui'];
    $('dbBaoGui').innerHTML = '';

    // Dip = the OCCASION dau tien khach tich. Con lai di vao `tags`.
    var dip = '';
    document.querySelectorAll('#dbThe input:checked').forEach(function (o) {
      if (!dip && o.getAttribute('data-kind') === 'OCCASION') dip = o.value;
    });

    var itemsList = Object.values(S.mon).map(function (m) {
      return { dish_id: m.id_mon, dish_name: m.name_mon, price: m.gia_mon, quantity: m.soluong };
    });

    var goi = {
      customer_name: $('dbTen').value.trim(),
      phone: $('dbDienThoai').value.trim(),
      email: $('dbEmail').value.trim() || null,
      reservation_date: S.ngay,
      start_time: S.gio,
      guest_count: S.soKhach,
      area_id: S.khuVuc || null,
      table_ids: S.ban,
      tags: S.the,
      occasion: dip || null,
      special_requests: $('dbYeuCau').value.trim() || null,
      items: itemsList
    };

    try {
      var r = await fetch('/api/dat-ban', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(goi)
      });
      var kq = await r.json();

      if (kq.ok) {
        window.location.href = '/dat-ban/xong?ma=' + encodeURIComponent(kq.ma)
          + '&dt=' + encodeURIComponent(goi.phone);
        return;
      }

      var them = null;
      if (kq.chi_tiet && (kq.chi_tiet.gio_thay_the || kq.chi_tiet.khu_thay_the)) {
        them = chu('div', 'db-goiy');
        (kq.chi_tiet.gio_thay_the || []).forEach(function (g) {
          var b = document.createElement('button');
          b.type = 'button';
          b.textContent = g.gio + ' (' + g.khu_vuc + ')';
          b.addEventListener('click', function () {
            S.gio = g.gio; S.ban = [];
            den(1);
            taiKhungGio().then(function () {
              var o = document.querySelector('#dbGio input[value="' + g.gio + '"]');
              if (o && !o.disabled) { o.checked = true; o.dispatchEvent(new Event('change')); }
            });
          });
          them.appendChild(b);
        });
        (kq.chi_tiet.khu_thay_the || []).forEach(function (k) {
          var b = document.createElement('button');
          b.type = 'button';
          b.textContent = k.khu_vuc + ' — ' + k.tong_cho + ' ' + T['dat_ban_moi.cho'];
          b.addEventListener('click', function () {
            S.khuVuc = String(k.khu_vuc_id); S.ban = [];
            $('dbKhuVuc').value = S.khuVuc;
            den(1); taiKhungGio();
          });
          them.appendChild(b);
        });
      }
      bao($('dbBaoGui'), 'loi', kq.thong_bao || T['dat_ban_moi.loi_chung'], them);
    } catch (e) {
      bao($('dbBaoGui'), 'loi', T['dat_ban_moi.loi_mang']);
    } finally {
      dangGui = false;
      nut.disabled = false;
      nut.innerHTML = chuCu;
    }
  });

  // -------------------------------------------------------------- khởi động
  veThanhBuoc();
  veTomTat();
  taiKhungGio();
})();
</script>

