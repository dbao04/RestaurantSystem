<%- include('partials/header', { title: t('dat_ban_moi.tieu_de') }) %>
<%
/*
  TRANG DAT BAN CUA KHACH - bon buoc.

    1. Thoi gian   ngay, so khach, khung gio (o nao het ban thi hien mo, khong an)
    2. Chon ban    so do mat bang that, tab theo khu vuc
    3. Thong tin   ten, dien thoai, dip, yeu cau dac biet
    4. Xac nhan    doi chieu lai + tien coc truoc khi gui

  VI SAO CHIA BUOC CHU KHONG DE MOT FORM DAI
  ------------------------------------------
  Mot form dai bat khach dien het roi moi biet khung gio do da het ban - va luc
  do ho phai sua lai tu dau. Chia buoc cho phep kiem tra bàn NGAY o buoc 1, khi
  khach chua bo cong dien gi ca. Do cung la ly do buoc "chon ban" dung truoc
  buoc "thong tin": biet chac co ban roi moi hoi ten khach.

  BUOC 2 CO THE BI BO QUA
  -----------------------
  Neu quan ly tat `allow_customer_pick_table`, buoc 2 bien mat va he thong tu
  xep ban. Trang van chay dung voi ba buoc - so buoc duoc tinh trong `BUOC`
  luc khoi tao chu khong viet cung trong HTML.

  KHONG CO TRANG NAO BI KHOA VI THIEU JAVASCRIPT
  ----------------------------------------------
  Neu JS hong, `<noscript>` chi khach sang so dien thoai cua nha hang. Mot form
  dat ban gui thang khong co kiem tra bàn se nhan don cho nhung khung gio da
  kin - hua mot dieu khong giu duoc con te hon la bao khach goi dien.
*/

/*
  Nhan the yeu cau rieng. `label_vi` trong CSDL la ban goc; ban dich tra theo
  `code`. The quan ly tu them chua co khoa dich se giu nguyen `label_vi` -
  thieu ban dich thi thoi, chu khong bien mat khoi danh sach.
*/
var nhanThe = function (the) {
  var nhan = t('dat_ban_moi.the_' + the.code);
  return nhan === 'dat_ban_moi.the_' + the.code ? the.label_vi : nhan;
};
var dsMonAn = typeof dsMonAn !== 'undefined' && Array.isArray(dsMonAn) ? dsMonAn : [];
var danhMucMon = typeof danhMucMon !== 'undefined' && Array.isArray(danhMucMon) ? danhMucMon : [];

var tenKhuVucDich = function (k) {
  var tenGoc = (k && k.ten) ? k.ten : (k || '');
  var khoa = 'khu_vuc.' + String(tenGoc).toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/g, 'd')
    .replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');
  var dich = t(khoa);
  return dich === khoa ? tenGoc : dich;
};

var tenLoaiDich = function (l) {
  if (typeof tenNhom === 'function') return tenNhom(l);
  return (l && l.name_loai) || '';
};

var tenMonDich = function (m) {
  if (typeof tenMon === 'function') {
    var tm = tenMon(m);
    return tm ? tm.chinh : (m && m.name_mon) || '';
  }
  return (m && m.name_mon) || '';
};
%>

<section class="nh-subhero nh-subhero--sm">
  <div class="nh-subhero__bg" style="background-image:url('/bg_1.jpg')"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-subhero__inner nh-container">
    <span class="nh-eyebrow"><%= t('dat_ban_moi.eyebrow') %></span>
    <h1><%= t('dat_ban_moi.tieu_de') %></h1>
    <div class="nh-crumbs">
      <a href="/"><%= t('dieu_huong.trang_chu') %></a> ·
      <span><%= t('dat_ban_moi.tieu_de') %></span>
    </div>
  </div>
</section>

<%- include('partials/so-do-dat-ban', { laKhuKhach: true }) %>

<style>
  /* ---------- Thanh buoc ---------- */
  .db-buoc { display: flex; gap: .5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2.2rem; }
  .db-buoc__o { display: flex; align-items: center; gap: .55rem; padding: .5rem 1rem; border-radius: 999px;
    background: #fff; border: 1.5px solid var(--nh-line); font-size: .84rem; font-weight: 600; color: var(--nh-muted); }
  .db-buoc__o[data-xong="1"] { border-color: rgba(22,163,74,.4); color: #14532d; background: #f0fdf4; }
  .db-buoc__o[aria-current="step"] { background: var(--nh-espresso); border-color: var(--nh-espresso); color: var(--nh-cream); }
  .db-buoc__so { width: 22px; height: 22px; border-radius: 50%; display: grid; place-content: center;
    background: rgba(0,0,0,.07); font-size: .74rem; font-weight: 800; flex: none; }
  .db-buoc__o[aria-current="step"] .db-buoc__so { background: var(--nh-gold); color: var(--nh-espresso); }

  /* ---------- Bo cuc ---------- */
  .db-luoi { display: grid; grid-template-columns: 1fr 340px; gap: 1.8rem; align-items: start; }
  @media (max-width: 980px) { .db-luoi { grid-template-columns: 1fr; } }

  .db-man { display: none; }
  .db-man.hien { display: block; animation: dbVao .3s var(--nh-ease); }
  @keyframes dbVao { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .db-man.hien { animation: none; } }

  /* ---------- Khung gio ---------- */
  .db-gio { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: .55rem; }
  .db-gio__o { position: relative; }
  .db-gio__o input { position: absolute; opacity: 0; width: 0; height: 0; }
  .db-gio__o span { display: block; text-align: center; padding: .6rem .3rem; border-radius: 10px;
    border: 1.5px solid var(--nh-line); background: var(--nh-cream); font-size: .92rem; font-weight: 600;
    cursor: pointer; transition: all .2s var(--nh-ease); }
  .db-gio__o span small { display: block; font-size: .62rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .06em; opacity: .7; margin-top: .12rem; }
  .db-gio__o span:hover { border-color: var(--nh-gold); }
  .db-gio__o input:checked + span { background: var(--nh-espresso); border-color: var(--nh-espresso); color: var(--nh-cream); }
  .db-gio__o input:focus-visible + span { box-shadow: 0 0 0 4px rgba(200,162,75,.3); }
  /* Het ban: van hien (khong an di) nhung khong bam duoc, kem chu "hết bàn".
     Xem chu thich cua /api/dat-ban/khung-gio. */
  .db-gio__o input:disabled + span { opacity: .5; cursor: not-allowed; border-style: dashed;
    background: #f8fafc; color: #94a3b8; text-decoration: line-through; }
  .db-gio__caodiem { color: #b45309; font-weight: 700; border-color: rgba(217, 119, 6, 0.45); }
  .db-gio__caodiem small { opacity: 1 !important; font-weight: 700; color: #b45309; }
  .db-gio__o input:checked + span.db-gio__caodiem,
  .db-gio__o input:checked + span.db-gio__caodiem small { color: var(--nh-cream) !important; }

  /* ---------- Bang tom tat ben phai ---------- */
  .db-tomtat { position: sticky; top: 96px; }
  .db-tomtat__hang { display: flex; justify-content: space-between; gap: 1rem; padding: .55rem 0;
    border-bottom: 1px dashed var(--nh-line); font-size: .92rem; }
  .db-tomtat__hang:last-of-type { border-bottom: 0; }
  .db-tomtat__hang b { color: var(--nh-espresso); text-align: right; }
  .db-coc { margin-top: 1rem; padding: .9rem 1rem; border-radius: 12px; background: #fffbeb;
    border: 1px solid rgba(217,119,6,.3); font-size: .86rem; color: #7c2d12; }
  .db-coc b { display: block; font-size: 1.15rem; margin-bottom: .2rem; }

  /* ---------- Thong bao ---------- */
  .db-bao { padding: .9rem 1.1rem; border-radius: 12px; font-size: .9rem; margin-bottom: 1.2rem;
    display: flex; gap: .7rem; align-items: flex-start; }
  .db-bao i { margin-top: .18rem; flex: none; }
  .db-bao--loi { background: #fef2f2; border: 1px solid rgba(220,38,38,.28); color: #991b1b; }
  .db-bao--nhac { background: #fffbeb; border: 1px solid rgba(217,119,6,.28); color: #7c2d12; }
  .db-bao--ok { background: #f0fdf4; border: 1px solid rgba(22,163,74,.28); color: #14532d; }

  /* ---------- Goi y khi het ban ---------- */
