      <a href="/"><%= t('dieu_huong.trang_chu') %></a> ·
      <span><%= t('dat_ban_moi.tieu_de') %></span> ·
      <a href="/dat-ban/tra-cuu"><%= t('dat_ban_moi.tra_cuu') %></a>
    </div>
  </div>
</section>

<%- include('partials/so-do-dat-ban') %>

<style>
  /* ---------- Thanh buoc ---------- */
  .db-buoc { display: flex; gap: .5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2.2rem; }
  .db-buoc__o { display: flex; align-items: center; gap: .55rem; padding: .5rem 1rem; border-radius: 999px;
    background: #fff; border: 1.5px solid var(--nh-line); font-size: .84rem; font-weight: 600; color: var(--nh-muted); }
  .db-buoc__o[data-xong="1"] { border-color: rgba(22,163,74,.4); color: #14532d; background: #f0fdf4; }
  .db-buoc__o[aria-current="step"] { background: var(--nh-espresso); border-color: var(--nh-espresso); color: var(--nh-cream); }
  .db-buoc__so { width: 22px; height: 22px; border-radius: 50%; display: grid; place-content: center;
    background: rgba(0,0,0,.07); font-size: .74rem; font-weight: 800; flex: none; }
  .db-buoc__o[aria-current="step"] .db-buoc__so { background: var(--nh-gold); color: var(--nh-espresso); }

  /* ---------- Bo cuc ---------- */
  .db-luoi { display: grid; grid-template-columns: 1fr 340px; gap: 1.8rem; align-items: start; }
  @media (max-width: 980px) { .db-luoi { grid-template-columns: 1fr; } }

  .db-man { display: none; }
  .db-man.hien { display: block; animation: dbVao .3s var(--nh-ease); }
  @keyframes dbVao { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .db-man.hien { animation: none; } }

  /* ---------- Khung gio ---------- */
  .db-gio { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: .55rem; }
  .db-gio__o { position: relative; }
  .db-gio__o input { position: absolute; opacity: 0; width: 0; height: 0; }
  .db-gio__o span { display: block; text-align: center; padding: .6rem .3rem; border-radius: 10px;
    border: 1.5px solid var(--nh-line); background: var(--nh-cream); font-size: .92rem; font-weight: 600;
    cursor: pointer; transition: all .2s var(--nh-ease); }
  .db-gio__o span small { display: block; font-size: .62rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .06em; opacity: .7; margin-top: .12rem; }
  .db-gio__o span:hover { border-color: var(--nh-gold); }
  .db-gio__o input:checked + span { background: var(--nh-espresso); border-color: var(--nh-espresso); color: var(--nh-cream); }
  .db-gio__o input:focus-visible + span { box-shadow: 0 0 0 4px rgba(200,162,75,.3); }
  /* Het ban: van hien (khong an di) nhung khong bam duoc, kem chu "hết bàn".
     Xem chu thich cua /api/dat-ban/khung-gio. */
  .db-gio__o input:disabled + span { opacity: .5; cursor: not-allowed; border-style: dashed;
    background: #f8fafc; color: #94a3b8; text-decoration: line-through; }
  .db-gio__o input:disabled + span small { text-decoration: none; }
  .db-gio__caodiem { color: var(--nh-gold); }

  /* ---------- Bang tom tat ben phai ---------- */
  .db-tomtat { position: sticky; top: 96px; }
  .db-tomtat__hang { display: flex; justify-content: space-between; gap: 1rem; padding: .55rem 0;
    border-bottom: 1px dashed var(--nh-line); font-size: .92rem; }
  .db-tomtat__hang:last-of-type { border-bottom: 0; }
  .db-tomtat__hang b { color: var(--nh-espresso); text-align: right; }
  .db-coc { margin-top: 1rem; padding: .9rem 1rem; border-radius: 12px; background: #fffbeb;
    border: 1px solid rgba(217,119,6,.3); font-size: .86rem; color: #7c2d12; }
  .db-coc b { display: block; font-size: 1.15rem; margin-bottom: .2rem; }

  /* ---------- Thong bao ---------- */
  .db-bao { padding: .9rem 1.1rem; border-radius: 12px; font-size: .9rem; margin-bottom: 1.2rem;
    display: flex; gap: .7rem; align-items: flex-start; }
  .db-bao i { margin-top: .18rem; flex: none; }
  .db-bao--loi { background: #fef2f2; border: 1px solid rgba(220,38,38,.28); color: #991b1b; }
  .db-bao--nhac { background: #fffbeb; border: 1px solid rgba(217,119,6,.28); color: #7c2d12; }
  .db-bao--ok { background: #f0fdf4; border: 1px solid rgba(22,163,74,.28); color: #14532d; }

  /* ---------- Goi y khi het ban ---------- */
  .db-goiy { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .8rem; }
  .db-goiy button { border: 1.5px solid rgba(217,119,6,.4); background: #fff; color: #7c2d12;
    border-radius: 999px; padding: .45rem 1rem; font: inherit; font-size: .84rem; font-weight: 600; cursor: pointer; }
  .db-goiy button:hover { background: #fffbeb; border-color: #d97706; }

  /* ---------- The yeu cau dac biet ---------- */
  .db-the { display: grid; grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); gap: .5rem; }
  .db-the__o { position: relative; }
  .db-the__o input { position: absolute; opacity: 0; width: 0; height: 0; }
  .db-the__o span { display: flex; align-items: center; gap: .5rem; padding: .6rem .85rem; border-radius: 10px;
    border: 1.5px solid var(--nh-line); background: var(--nh-cream); font-size: .86rem; cursor: pointer;
    transition: all .2s var(--nh-ease); }
  .db-the__o input:checked + span { background: var(--nh-espresso); border-color: var(--nh-espresso); color: var(--nh-cream); }
  .db-the__o input:focus-visible + span { box-shadow: 0 0 0 4px rgba(200,162,75,.3); }
  .db-the__o span i { color: var(--nh-gold); width: 16px; text-align: center; }
  .db-the__o input:checked + span i { color: var(--nh-gold-soft); }

  /* ---------- Nut dieu huong ---------- */
  .db-dieuhuong { display: flex; gap: .8rem; justify-content: space-between; margin-top: 1.8rem; flex-wrap: wrap; }
  .db-dieuhuong .nh-btn { flex: 1; justify-content: center; min-width: 150px; }
  .nh-btn[disabled] { opacity: .45; cursor: not-allowed; transform: none !important; }

  .db-tai { display: inline-block; width: 14px; height: 14px; border: 2px solid currentColor;
    border-right-color: transparent; border-radius: 50%; animation: dbQuay .7s linear infinite; }
  @keyframes dbQuay { to { transform: rotate(360deg); } }

  .db-xemlai { display: grid; grid-template-columns: 150px 1fr; gap: .5rem 1rem; font-size: .94rem; }
  .db-xemlai dt { color: var(--nh-muted); font-size: .8rem; text-transform: uppercase; letter-spacing: .05em;
    font-weight: 700; padding-top: .12rem; }
  .db-xemlai dd { margin: 0; color: var(--nh-espresso); font-weight: 600; }
  @media (max-width: 560px) { .db-xemlai { grid-template-columns: 1fr; gap: .1rem .5rem; }
    .db-xemlai dd { margin-bottom: .7rem; } }
</style>

<section class="nh-section nh-section--cream">
  <div class="nh-container">

    <noscript>
      <div class="db-bao db-bao--nhac">
        <i class="fas fa-exclamation-triangle"></i>
        <div><%- t('dat_ban_moi.khong_js') %></div>
      </div>
    </noscript>

    <ol class="db-buoc" id="dbBuoc" aria-label="<%= t('dat_ban_moi.tien_trinh') %>"></ol>

    <div class="db-luoi">
      <div>
        <!-- ============================ BƯỚC 1: THỜI GIAN ==================== -->
        <div class="db-man hien" id="man1" data-buoc="1">
          <div class="nh-panel">
            <h3 class="nh-panel__title"><i class="fas fa-calendar-day"></i> <%= t('dat_ban_moi.b1_tieu_de') %></h3>

            <div class="nh-fields">
              <div class="nh-field">
                <label for="dbNgay"><%= t('dat_ban_moi.ngay') %> <span class="req">*</span></label>
                <input type="date" id="dbNgay" class="nh-input" value="<%= homNay %>" min="<%= homNay %>">
              </div>
              <div class="nh-field">
                <label for="dbSoKhach"><%= t('dat_ban_moi.so_khach') %> <span class="req">*</span></label>
                <input type="number" id="dbSoKhach" class="nh-input" value="2" min="1" max="<%= cauHinh.toi_da_khach %>">
                <span class="nh-hint"><%= t('dat_ban_moi.toi_da_online').replace('{n}', cauHinh.toi_da_khach) %></span>
              </div>
              <div class="nh-field nh-field--full">
                <label><%= t('dat_ban_moi.chon_nhanh') %></label>
                <div class="nh-chips" id="dbNhanhKhach"></div>
              </div>
              <div class="nh-field nh-field--full">
                <label for="dbKhuVuc"><%= t('dat_ban_moi.khu_vuc') %></label>
                <select id="dbKhuVuc" class="nh-select">
                  <option value=""><%= t('dat_ban_moi.khu_bat_ky') %></option>
                  <% khuVuc.forEach(function (k) { %>
                    <option value="<%= k.id %>"><%= k.la_vip ? '★ ' : '' %><%= k.ten %> — <%= k.so_ban %> <%= t('dat_ban_moi.ban_dv') %><%= k.mo_ta ? ' · ' + k.mo_ta : '' %></option>
                  <% }); %>
                </select>
              </div>
            </div>

            <div style="margin-top:1.6rem">
              <label class="nh-field" style="margin-bottom:.6rem">
                <span style="font-size:.78rem;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--nh-muted)">
                  <%= t('dat_ban_moi.gio_den') %> <span class="req">*</span>
                </span>
              </label>
              <div id="dbBaoGio"></div>
              <div class="db-gio" id="dbGio" role="radiogroup" aria-label="<%= t('dat_ban_moi.gio_den') %>"></div>
            </div>

            <div class="db-dieuhuong">
              <span></span>
              <button type="button" class="nh-btn nh-btn--gold" id="dbTiep1" disabled>
                <%= t('dat_ban_moi.tiep_tuc') %> <i class="fas fa-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- ============================ BƯỚC 2: CHỌN BÀN ==================== -->
        <div class="db-man" id="man2" data-buoc="2">
          <div class="nh-panel">
            <h3 class="nh-panel__title"><i class="fas fa-map-marked-alt"></i> <%= t('dat_ban_moi.b2_tieu_de') %></h3>
            <p class="nh-hint" style="margin-bottom:1.1rem"><%= t('dat_ban_moi.b2_mo_ta') %></p>

            <div id="dbTabs"></div>
            <div id="dbSoDo" class="sdb"></div>
            <div class="sdb__tomtat" id="dbTomTatBan"><%= t('dat_ban_moi.dang_tai') %></div>

            <div class="db-dieuhuong">
              <button type="button" class="nh-btn nh-btn--outline" data-lui="1">
                <i class="fas fa-arrow-left"></i> <%= t('dat_ban_moi.quay_lai') %>
              </button>
              <button type="button" class="nh-btn nh-btn--outline" id="dbTuXep">
                <i class="fas fa-magic"></i> <%= t('dat_ban_moi.de_nha_hang_xep') %>
              </button>
              <button type="button" class="nh-btn nh-btn--gold" id="dbTiep2" disabled>
                <%= t('dat_ban_moi.tiep_tuc') %> <i class="fas fa-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- ============================ BƯỚC 3: THÔNG TIN =================== -->
        <div class="db-man" id="man3" data-buoc="3">
          <div class="nh-panel">
            <h3 class="nh-panel__title"><i class="fas fa-user-edit"></i> <%= t('dat_ban_moi.b3_tieu_de') %></h3>

            <div class="nh-fields">
              <div class="nh-field">
                <label for="dbTen"><%= t('dat_ban_moi.ho_ten') %> <span class="req">*</span></label>
                <input id="dbTen" class="nh-input" maxlength="150" autocomplete="name"
                       value="<%= session.username || '' %>" required>
              </div>
              <div class="nh-field">
                <label for="dbDienThoai"><%= t('dat_ban_moi.dien_thoai') %> <span class="req">*</span></label>
                <input id="dbDienThoai" class="nh-input" type="tel" inputmode="tel" maxlength="30"
