            <div class="nh-field nh-field--full" style="margin-top:1.4rem">
              <label for="dbYeuCau"><%= t('dat_ban_moi.yeu_cau_them') %></label>
              <textarea id="dbYeuCau" class="nh-textarea" maxlength="800"
                        placeholder="<%= t('dat_ban_moi.yeu_cau_goi_y') %>"></textarea>
            </div>

            <div class="db-dieuhuong">
              <button type="button" class="nh-btn nh-btn--outline" data-lui="1">
                <i class="fas fa-arrow-left"></i> <%= t('dat_ban_moi.quay_lai') %>
              </button>
              <button type="button" class="nh-btn nh-btn--gold" id="dbTiep3">
