  .db-combo-btn { width: 100%; padding: 0.5rem 0.8rem; border-radius: 8px; border: 1.5px solid var(--nh-gold); background: #fff; color: var(--nh-espresso); font-size: 0.82rem; font-weight: 700; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; }
  .db-combo-btn:hover { background: var(--nh-gold); color: var(--nh-espresso); transform: translateY(-1px); box-shadow: 0 4px 10px rgba(200,162,75,0.3); }

  .db-mon-layout { display: grid; grid-template-columns: 210px 1fr; gap: 1.2rem; margin-top: 1rem; align-items: start; }
  @media (max-width: 768px) { .db-mon-layout { grid-template-columns: 1fr; } }
  .db-loai-list { display: flex; flex-direction: column; gap: 0.35rem; max-height: 540px; overflow-y: auto; padding-right: 0.3rem; }
  @media (max-width: 768px) {
    .db-loai-list { flex-direction: row; overflow-x: auto; max-height: none; padding-bottom: 0.5rem; }
  }
  .db-loai-btn { background: #fff; border: 1.5px solid var(--nh-line); border-radius: 8px; padding: 0.55rem 0.8rem;
    font-size: 0.84rem; font-weight: 600; text-align: left; color: var(--nh-muted); cursor: pointer; transition: all 0.2s; white-space: nowrap; flex-shrink: 0; }
  .db-loai-btn:hover { border-color: var(--nh-gold); color: var(--nh-espresso); }
  .db-loai-btn.active { background: var(--nh-espresso); color: var(--nh-cream); border-color: var(--nh-espresso); }
  
  .db-mon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; max-height: 540px; overflow-y: auto; padding: 0.4rem; min-height: 200px; }
  .db-dish-card { background: #fff; border: 1.5px solid rgba(200,162,75,0.25); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; transition: all 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.04); height: auto; min-height: 230px; }
  .db-dish-card.is-hidden { display: none !important; }
  .db-dish-card:hover { border-color: var(--nh-gold); box-shadow: 0 6px 16px rgba(0,0,0,0.08); transform: translateY(-2px); }
  .db-dish-card .db-dish-thumb { width: 100%; height: 125px; min-height: 125px; overflow: hidden; position: relative; background: #f8fafc; flex-shrink: 0; }
  .db-dish-card .db-dish-thumb img { width: 100%; height: 100%; max-height: 125px; object-fit: cover; display: block; }
  .db-dish-body { padding: 0.75rem; display: flex; flex-direction: column; flex: 1 1 auto; justify-content: space-between; gap: 0.4rem; background: #fff; }
  .db-dish-name { font-size: 0.88rem; font-weight: 700; color: var(--nh-espresso); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.4em; }
