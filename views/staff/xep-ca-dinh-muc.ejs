<%- include('partials/header', { activePage: 'xep-ca', staffName: session.staffName || 'Quản lý' }) %>

<%
  var THU = [
    { so: 1, ten: 'Thứ 2' }, { so: 2, ten: 'Thứ 3' }, { so: 3, ten: 'Thứ 4' },
    { so: 4, ten: 'Thứ 5' }, { so: 5, ten: 'Thứ 6' }, { so: 6, ten: 'Thứ 7' },
    { so: 0, ten: 'Chủ nhật' }
  ];

  var mucHienCo = {};
  (dinhMuc || []).forEach(function (d) {
    mucHienCo[d.thu + '|' + d.ma_ca + '|' + d.chucvu] = Number(d.so_luong);
  });
  function soHienCo(thu, maCa, cv) { return mucHienCo[thu + '|' + maCa + '|' + cv] || 0; }

  var cvHienThi = (chucVuList || []).filter(function (cv) { return (soNguoi[cv] || 0) > 0; });

  var tongTuan = 0;
  (dinhMuc || []).forEach(function (d) { tongTuan += Number(d.so_luong); });
%>

<style>
  .dm-bang { width: 100%; border-collapse: collapse; }
  .dm-bang th, .dm-bang td { border: 1px solid #e3e3e3; padding: 5px 7px; font-size: 13px; }
  .dm-bang thead th { background: #faf7f4; text-align: center; }
  .dm-bang td.dm-thu { background: #faf7f4; font-weight: 600; white-space: nowrap; }
  .dm-bang td.dm-ca  { background: #fdfbf9; white-space: nowrap; }
  .dm-bang input { width: 52px; text-align: center; padding: 2px; }
  .dm-tran { color: #b03a2e; }
  .dm-ghichu { font-size: 13px; color: #6b6b6b; margin-bottom: 14px; line-height: 1.6; }
</style>

<div class="card mb-4 shadow">
  <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
    <div>
      <h6 class="m-0 font-weight-bold" style="color: #241d18;">Định mức nhân sự theo ca</h6>
      <small class="text-muted">Mỗi ca cần bao nhiêu người — hiện <%= tongTuan %> lượt người mỗi tuần</small>
    </div>
    <div>
      <a class="btn btn-sm btn-outline-primary" href="/staff/xep-ca">
        <i class="fas fa-table-cells mr-1"></i> Về lưới xếp ca
      </a>
    </div>
  </div>

  <div class="card-body">

    <% if (msg) { %>
      <div class="alert alert-<%= msgType === 'danger' ? 'danger' : 'success' %>"><%= msg %></div>
    <% } %>

    <div class="dm-ghichu">
      Bảng này khai theo <strong>thứ trong tuần</strong>, không theo ngày cụ thể — khai một lần
      dùng cho mọi tuần. Cuối tuần đông khách hơn thì để số lớn hơn.
      Điền <strong>0</strong> nghĩa là ca đó không cần chức vụ đó.
      <br>
      Số người hiện có:
      <% cvHienThi.forEach(function (cv) { %>
        <strong><%= cv %></strong> <%= soNguoi[cv] %> người ·
      <% }) %>
      mỗi người tối đa 6 ca/tuần, nên tổng định mức một chức vụ vượt quá
      <em>số người × 6</em> thì chắc chắn sẽ báo thiếu.
    </div>

    <form method="POST" action="/staff/xep-ca/dinh-muc">
      <div class="table-responsive">
        <table class="dm-bang">
          <thead>
            <tr>
              <th>Thứ</th>
              <th>Ca</th>
              <% cvHienThi.forEach(function (cv) { %>
                <th><%= cv %><br><span style="font-weight:400; font-size:11px;">có <%= soNguoi[cv] %></span></th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% THU.forEach(function (t) { %>
              <% caList.forEach(function (ca, i) { %>
                <tr>
                  <% if (i === 0) { %>
                    <td class="dm-thu" rowspan="<%= caList.length %>"><%= t.ten %></td>
                  <% } %>
                  <td class="dm-ca"><%= ca.ten_ca %></td>
                  <% cvHienThi.forEach(function (cv) { %>
                    <td style="text-align:center;">
                      <input type="number" min="0" max="20"
                             name="so_luong[<%= t.so %>|<%= ca.ma_ca %>|<%= cv %>]"
                             value="<%= soHienCo(t.so, ca.ma_ca, cv) %>">
                    </td>
                  <% }) %>
                </tr>
              <% }) %>
            <% }) %>
          </tbody>
          <tfoot>
            <tr>
              <td colspan="2" class="dm-thu">Tổng mỗi tuần</td>
              <% cvHienThi.forEach(function (cv) { %>
                <%
                  var tong = 0;
                  (dinhMuc || []).forEach(function (d) { if (d.chucvu === cv) tong += Number(d.so_luong); });
                  var tran = (soNguoi[cv] || 0) * 6;
                %>
                <td style="text-align:center;" class="<%= tong > tran ? 'dm-tran' : '' %>">
                  <strong><%= tong %></strong>
                  <span style="font-size:11px; display:block;">tối đa <%= tran %></span>
                </td>
              <% }) %>
            </tr>
          </tfoot>
        </table>
      </div>

      <div style="margin-top:14px;">
        <button class="btn btn-primary" type="submit">
          <i class="fas fa-save mr-1"></i> Lưu định mức
        </button>
        <span class="text-muted ml-2 small">
          Lưu xong hãy quay về lưới và bấm “Xếp tự động” để áp dụng.
        </span>
      </div>
    </form>

  </div>
</div>

<%- include('partials/footer') %>
