<%- include('partials/header', { activePage: 'sodoban', staffName: session.staffName || session.adminname || 'Nhân viên' }) %>

<style>
  :root {
    --sdb-gold: #c8a24b;
    --sdb-gold-dark: #a8822f;
    --sdb-dark: #241a14;
    --sdb-cream: #fbf7f0;
    --sdb-line: #e7ded0;
    --sdb-muted: #786c5f;
    --sdb-ink: #241d18;
    --sdb-trong: #2e7d4f;
    --sdb-phucvu: #b3352c;
    --sdb-dat: #d97706;
    --sdb-don: #64748b;
    --sdb-baotri: #1e293b;
  }

  .sdb-container {
    width: 100%;
    margin-bottom: 2.5rem;
  }

  .sdb-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .sdb-title {
    font-family: var(--qt-serif, 'Playfair Display', Georgia, serif) !important;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--sdb-ink);
    margin: 0;
  }

  .sdb-subtitle {
    font-family: var(--qt-sans, 'Inter', sans-serif);
    font-size: .85rem;
    color: var(--sdb-muted);
    margin-top: .25rem;
    display: flex;
    align-items: center;
    gap: .5rem;
  }

  .sdb-cham {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sdb-trong);
    box-shadow: 0 0 0 3px rgba(46, 125, 79, .2);
  }
  .sdb-cham.tat {
    background: var(--sdb-phucvu);
    box-shadow: 0 0 0 3px rgba(179, 53, 44, .2);
  }

  .sdb-nav-links {
    display: flex;
    align-items: center;
    gap: .6rem;
    flex-wrap: wrap;
  }

  .sdb-link-btn {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .45rem .95rem;
    background: #ffffff;
    border: 1px solid var(--sdb-line);
    border-radius: 9px;
    color: var(--sdb-ink);
    font-size: .82rem;
    font-weight: 600;
    text-decoration: none;
    transition: all .2s ease;
    box-shadow: 0 2px 6px rgba(36, 26, 20, .04);
  }
  .sdb-link-btn:hover {
    border-color: var(--sdb-gold);
    color: var(--sdb-gold-dark);
    background: #fffdfa;
    transform: translateY(-1px);
  }

  .sdb-date-picker {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .35rem .65rem;
    background: #ffffff;
    border: 1px solid var(--sdb-line);
    border-radius: 9px;
    box-shadow: 0 2px 6px rgba(36, 26, 20, .04);
  }
  .sdb-date-input {
    border: 1px solid var(--sdb-line);
    border-radius: 6px;
    padding: .2rem .5rem;
    font-family: inherit;
    font-size: .82rem;
    font-weight: 600;
    color: var(--sdb-ink);
    background: #faf8f5;
    outline: none;
    cursor: pointer;
  }
  .sdb-date-input:focus {
    border-color: var(--sdb-gold);
    background: #ffffff;
  }
  .sdb-btn-today {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .22rem .55rem;
    font-size: .75rem;
    font-weight: 600;
    color: var(--sdb-gold-dark);
    background: var(--sdb-cream);
    border: 1px solid rgba(200, 162, 75, .3);
    border-radius: 6px;
    cursor: pointer;
    transition: all .2s ease;
  }
  .sdb-btn-today:hover {
    background: var(--sdb-gold);
    color: #ffffff;
  }

  /* Grid Thống Kê KPI */
  .sdb-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .sdb-kpi-card {
    background: #ffffff;
    border: 1px solid var(--sdb-line);
    border-radius: 12px;
    padding: 1rem 1.15rem;
    position: relative;
    box-shadow: 0 6px 18px -12px rgba(36, 26, 20, .25);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .sdb-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -12px rgba(36, 26, 20, .35);
  }
  .sdb-kpi-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 4px;
    border-radius: 12px 0 0 12px;
    background: var(--sdb-line);
  }
  .sdb-kpi-card.t::before { background: var(--sdb-trong); }
  .sdb-kpi-card.p::before { background: var(--sdb-phucvu); }
  .sdb-kpi-card.d::before { background: var(--sdb-dat); }
  .sdb-kpi-card.gold::before { background: var(--sdb-gold); }

  .sdb-kpi-title {
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.1px;
    color: var(--sdb-muted);
    margin-bottom: .35rem;
  }

  .sdb-kpi-val {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--sdb-ink);
    line-height: 1.2;
    display: flex;
    align-items: baseline;
    gap: .3rem;
  }

  /* Toolbar Bộ Lọc & Nút Sắp Xếp */
  .sdb-toolbar {
    background: #ffffff;
    border: 1px solid var(--sdb-line);
    border-radius: 14px;
    padding: .85rem 1.25rem;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    box-shadow: 0 6px 18px -12px rgba(36, 26, 20, .2);
  }

  .sdb-tabs {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
  }

  .sdb-tab-btn {
    padding: .45rem .95rem;
    border: 1px solid var(--sdb-line);
    background: #ffffff;
    border-radius: 8px;
    cursor: pointer;
    font-size: .84rem;
    font-weight: 500;
    color: var(--sdb-ink);
    transition: all .2s;
  }
  .sdb-tab-btn:hover {
    border-color: var(--sdb-gold);
    color: var(--sdb-gold-dark);
  }
  .sdb-tab-btn.on {
    background: var(--sdb-dark);
    color: var(--sdb-gold);
    border-color: var(--sdb-dark);
    font-weight: 600;
    box-shadow: 0 4px 10px rgba(36, 26, 20, .3);
  }

  .sdb-actions {
    display: flex;
    align-items: center;
    gap: .75rem;
    flex-wrap: wrap;
  }

  .sdb-btn {
    background: var(--sdb-dark);
    color: var(--sdb-gold);
    border: 1px solid var(--sdb-dark);
    padding: .45rem 1.1rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: .84rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    transition: all .2s;
  }
  .sdb-btn:hover {
    background: #3d2b21;
    color: #ffd875;
    transform: translateY(-1px);
  }
  .sdb-btn.ghost {
    background: #ffffff;
    color: var(--sdb-ink);
    border-color: var(--sdb-line);
  }
  .sdb-btn.ghost:hover {
    border-color: var(--sdb-gold);
    color: var(--sdb-gold-dark);
    background: #fffdfa;
  }

  /* Khung Sân Sơ Đồ */
  .sdb-floor-container {
    background: #ffffff;
    border: 1px solid var(--sdb-line);
    border-radius: 14px;
    padding: 1.25rem;
    box-shadow: 0 10px 30px -15px rgba(36, 26, 20, .3);
  }

  .san {
    position: relative;
    border-radius: 12px;
    min-height: 540px;
    overflow: auto;
    background:
      radial-gradient(120% 90% at 50% 6%, rgba(255,255,255,.9), rgba(255,255,255,0) 60%),
      linear-gradient(rgba(200,162,75,.06) 1px, transparent 1px) 0 0 / 100% 44px,
      linear-gradient(90deg, rgba(200,162,75,.06) 1px, transparent 1px) 0 0 / 44px 100%,
      linear-gradient(160deg, #fdfaf5, #f4eee3);
    box-shadow: inset 0 0 0 1px rgba(200, 162, 75, .18);
  }

  .dai-khu {
    position: absolute;
    left: 0; right: 0;
    height: 38px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 20px;
    font-size: .88rem;
    font-weight: 700;
    color: var(--sdb-dark);
    background: rgba(255, 255, 255, .85);
    backdrop-filter: blur(6px);
    border-top: 1px solid rgba(200, 162, 75, .2);
    border-bottom: 1px solid rgba(200, 162, 75, .2);
    box-shadow: 0 2px 6px rgba(0,0,0,.03);
  }
  .dai-khu .dem {
    font-weight: 500;
    color: var(--sdb-muted);
    font-size: .78rem;
  }

  /* Bàn */
  .ban {
    position: absolute;
    cursor: pointer;
    user-select: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    transition: transform .14s, filter .14s;
    filter: drop-shadow(0 3px 6px rgba(60,40,20,.18));
  }
  .ban:hover {
    transform: translateY(-3px);
    filter: drop-shadow(0 9px 16px rgba(60,40,20,.32));
    z-index: 20;
  }
  .ban svg { display: block; }
  .ban.keo { cursor: grab; }
  .ban.dang-keo { opacity: .75; cursor: grabbing; z-index: 50; }
  .ban .ct {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    background: #ffffff;
    border: 1px solid rgba(200, 162, 75, .3);
    border-radius: 7px;
    padding: 2px 7px;
    white-space: nowrap;
    color: #4a4038;
    margin-top: -4px;
    box-shadow: 0 2px 5px rgba(0,0,0,.08);
  }
  .ban .ct b { color: #b3352c; }

  /* Modal Đổi Trạng Thái */
  .lop {
    position: fixed;
    inset: 0;
    background: rgba(36, 26, 20, .6);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1050;
  }
  .hop {
    background: #ffffff;
    border: 1px solid var(--sdb-line);
    border-radius: 16px;
    padding: 24px 28px;
    width: min(440px, 92vw);
    box-shadow: 0 20px 50px -15px rgba(36, 26, 20, .45);
  }
  .hop h3 {
    margin: 0 0 6px;
    font-family: var(--qt-serif, 'Playfair Display', Georgia, serif) !important;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--sdb-ink);
  }
  .hop .p {
    color: var(--sdb-muted);
    font-size: .86rem;
    margin-bottom: 18px;
    line-height: 1.45;
  }
  .hop .nut {
    display: grid;
    gap: 9px;
  }
  .hop .nut button {
    padding: 11px 16px;
    border: 0;
    border-radius: 9px;
    cursor: pointer;
    font-size: .88rem;
    font-weight: 600;
    color: #ffffff;
    font-family: inherit;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: opacity .2s, transform .2s;
  }
  .hop .nut button:hover {
    opacity: .92;
    transform: translateX(2px);
  }
  #hopNutThuTien {
    display: none;
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--sdb-line);
  }
  .hop .nut a.thu-tien {
    padding: 12px 16px;
    border-radius: 9px;
    font-size: .92rem;
    font-weight: 700;
    color: var(--sdb-gold);
    background: var(--sdb-dark);
    text-decoration: none;
    text-align: center;
    display: block;
    box-shadow: 0 4px 12px rgba(36, 26, 20, .25);
    transition: all .2s;
  }
  .hop .nut a.thu-tien:hover {
    background: #3d2b21;
    color: #ffd875;
  }
  .hop .dong {
    margin-top: 14px;
    width: 100%;
    padding: 10px;
    background: #f1ede6;
    color: var(--sdb-ink);
    border: 0;
    border-radius: 9px;
    cursor: pointer;
    font-family: inherit;
    font-size: .88rem;
    font-weight: 600;
    transition: background .2s;
  }
  .hop .dong:hover {
    background: #e4ddd2;
  }

  .sdb-guide-text {
    font-size: .82rem;
    color: var(--sdb-muted);
    margin-top: 10px;
  }
  
  #chuThich .sdb__chuthich {
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    gap: .35rem .25rem;
  }

  /* Mobile App Responsive Styling for Sơ đồ bàn */
  @media (max-width: 767.98px) {
    .sdb-header-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .sdb-nav-links {
      width: 100%;
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
    }
    .sdb-kpi-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.65rem;
    }
    .sdb-kpi-card {
      padding: 0.75rem 0.85rem;
    }
    .sdb-kpi-val {
      font-size: 1.15rem;
    }
    .sdb-toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding: 0.75rem;
    }
    .sdb-tabs {
      overflow-x: auto;
      flex-wrap: nowrap !important;
      padding-bottom: 4px;
      -webkit-overflow-scrolling: touch;
      display: flex;
      gap: 6px;
    }
    .sdb-tab-btn {
      white-space: nowrap !important;
      flex-shrink: 0;
      padding: 0.35rem 0.75rem;
      font-size: 0.78rem;
    }
    .sdb-actions {
      width: 100%;
      justify-content: flex-start;
      flex-wrap: wrap;
    }
    .sdb-floor-container {
      padding: 0.75rem;
    }
    .san {
      min-height: 440px;
      overflow-x: auto !important;
      -webkit-overflow-scrolling: touch;
    }
    .sdb-mobile-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-top: 10px;
    }
    .m-table-card {
      background: #ffffff;
      border: 1px solid #e7ded0;
      border-radius: 12px;
      padding: 12px;
      box-shadow: 0 4px 12px rgba(36,26,20,0.06);
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
    }
    .m-table-card:active {
      transform: scale(0.97);
    }
    .m-table-card.m-trong { border-top: 4px solid var(--sdb-trong); }
    .m-table-card.m-phucvu { border-top: 4px solid var(--sdb-phucvu); background: #fffcfb; }
    .m-table-card.m-dat { border-top: 4px solid var(--sdb-dat); }
    .m-table-card.m-don { border-top: 4px solid #f59e0b; }
    .m-table-card.m-baotri { border-top: 4px solid #6b7280; opacity: 0.7; }
  }
</style>

<div class="sdb-container">
  <!-- Top Header Bar -->
  <div class="sdb-header-bar">
    <div>
      <h1 class="sdb-title"><i class="fas fa-chair" style="color:var(--sdb-gold); margin-right: .5rem;"></i>Sơ đồ bàn thời gian thực</h1>
      <div class="sdb-subtitle">
        <span class="sdb-cham" id="chamKN"></span>
        <span id="ttKetNoi">Đang kết nối...</span>
        <span style="opacity: .5;">•</span>
        <span><%= tenNguoiDung %></span>
      </div>
    </div>
    <div class="sdb-nav-links">
      <div class="sdb-date-picker">
        <i class="fas fa-calendar-days" style="color:var(--sdb-gold);"></i>
        <input type="date" id="chonNgaySDB" class="sdb-date-input" onchange="doiNgayXem(this.value)" />
        <button class="sdb-btn-today" onclick="veHomNay()"><i class="fas fa-rotate-left"></i>Hôm nay</button>
      </div>
      <a class="sdb-link-btn" href="/kds"><i class="fas fa-fire-burner" style="color:var(--sdb-gold);"></i>Màn hình bếp</a>
      <a class="sdb-link-btn" href="/analytics"><i class="fas fa-chart-pie" style="color:var(--sdb-gold);"></i>Dashboard</a>
      <a class="sdb-link-btn" href="/staff"><i class="fas fa-id-badge" style="color:var(--sdb-gold);"></i>Trang nhân viên</a>
    </div>
  </div>

  <!-- KPI Grid -->
  <div class="sdb-kpi-grid" id="chiSo"></div>

  <!-- Floor Board Container -->
  <div class="sdb-floor-container">
    <!-- Toolbar -->
    <div class="sdb-toolbar">
      <div class="sdb-tabs" id="tabViTri"></div>
      <div class="sdb-actions">
        <div id="chuThich"></div>
        <% if (choPhepKeoTha) { %>
          <button class="sdb-btn ghost" id="btnSapXep" onclick="batSapXep()"><i class="fas fa-arrows-up-down-left-right"></i>Sắp xếp sơ đồ</button>
          <button class="sdb-btn" id="btnLuu" onclick="luuViTri()" style="display:none"><i class="fas fa-floppy-disk"></i>Lưu vị trí</button>
        <% } %>
      </div>
    </div>

    <!-- Bộ chuyển đổi chế độ xem trên Điện Thoại: Bản đồ toạ độ hoặc Thẻ bàn -->
    <div class="d-flex d-md-none justify-content-between align-items-center mb-3">
      <div class="btn-group btn-group-sm w-100 shadow-sm" role="group">
        <button type="button" class="btn btn-primary font-weight-bold" id="btnModeMap" onclick="setMobileSdbMode('map')">
          <i class="fas fa-map-marked-alt mr-1"></i> Sơ đồ trực quan
        </button>
        <button type="button" class="btn btn-outline-primary font-weight-bold" id="btnModeGrid" onclick="setMobileSdbMode('grid')">
          <i class="fas fa-th-large mr-1"></i> Thẻ bàn di động
        </button>
      </div>
    </div>

    <!-- Sàn Nhà (Bản đồ) -->
    <div class="san" id="san"></div>

    <!-- Sàn Nhà (Danh sách thẻ bàn tối ưu di động) -->
    <div id="sanGrid" class="sdb-mobile-grid" style="display:none;"></div>
    <% if (choPhepKeoTha) { %>
      <p class="sdb-guide-text"><i class="fas fa-circle-info" style="color:var(--sdb-gold); margin-right: 4px;"></i>Bấm <b>Sắp xếp sơ đồ</b> để kéo thả bàn về đúng vị trí thực tế trong nhà hàng, sau đó bấm <b>Lưu vị trí</b>.</p>
    <% } %>
  </div>
</div>

<!-- Modal Đổi Trạng Thái & Thao Tác Bàn -->
<div class="lop" id="lop">
  <div class="hop">
    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
      <h3 id="hopTieuDe">Bàn</h3>
      <button onclick="dongHop()" style="background:none; border:none; font-size:1.3rem; cursor:pointer; color:var(--sdb-muted); line-height:1;">&times;</button>
    </div>
    <div class="p" id="hopMoTa"></div>

    <!-- Nút Gọi Món Cho Bàn (Chức năng cốt lõi của Phục vụ) -->
    <div class="nut" id="hopNutOrder" style="margin-bottom: 12px;">
      <button id="btnOrderBan" style="background:#2e7d4f; font-weight:700; font-size:.92rem; color:#fff;" onclick="moModalOrder()">
        <span><i class="fas fa-utensils" style="margin-right:8px;"></i><span id="txtBtnOrder">Gọi món cho bàn</span></span>
        <i class="fas fa-plus-circle" style="font-size:1.1rem;"></i>
      </button>
    </div>

    <!-- Danh sách món đã gọi của bàn -->
    <div id="hopDsMon" style="display:none; max-height:160px; overflow-y:auto; margin-bottom:14px; padding:10px 12px; background:#fbf7f0; border:1px solid var(--sdb-line); border-radius:10px; font-size:.82rem;">
      <div style="font-weight:700; color:var(--sdb-dark); margin-bottom:6px; display:flex; justify-content:space-between; align-items:center;">
        <span><i class="fas fa-receipt mr-1"></i> Món đã gọi (<span id="demMonDaGoi">0</span>)</span>
        <span id="tongTienMonDaGoi" style="color:#b3352c; font-weight:700;"></span>
      </div>
      <div id="dsMonDaGoiChiTiet" style="display:grid; gap:4px;"></div>
    </div>

    <div class="nut" id="hopNutThuTien"><a class="thu-tien" id="hopLinkThuTien" href="#"><i class="fas fa-cash-register" style="margin-right: 6px;"></i>Tính tiền bàn này</a></div>
    <div class="nut">
      <button style="background:var(--sdb-trong)"  onclick="doiTrangThai(0)"><span><i class="fas fa-check-circle" style="margin-right: 6px;"></i>Đặt là Trống</span> <i class="fas fa-chevron-right" style="opacity: .6;"></i></button>
      <button style="background:var(--sdb-phucvu)" onclick="doiTrangThai(1)"><span><i class="fas fa-user-group" style="margin-right: 6px;"></i>Đặt là Đang phục vụ</span> <i class="fas fa-chevron-right" style="opacity: .6;"></i></button>
      <button style="background:var(--sdb-dat)"    onclick="doiTrangThai(2)"><span><i class="fas fa-clock" style="margin-right: 6px;"></i>Đặt là Đã đặt trước</span> <i class="fas fa-chevron-right" style="opacity: .6;"></i></button>
      <button style="background:var(--sdb-don)"    onclick="doiTrangThai(3)"><span><i class="fas fa-broom" style="margin-right: 6px;"></i>Đặt là Đang dọn</span> <i class="fas fa-chevron-right" style="opacity: .6;"></i></button>
    </div>
    <button class="dong" onclick="dongHop()">Đóng cửa sổ</button>
  </div>
</div>

<!-- Modal Gọi Món Trực Tiếp Cho Bàn (Menu popup) -->
<div class="lop" id="lopOrder" style="z-index: 1060;">
  <div class="hop" style="width: min(760px, 96vw); max-height: 90vh; display: flex; flex-direction: column; padding: 20px 24px;">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--sdb-line); padding-bottom:10px; margin-bottom:12px;">
      <div>
        <h3 id="orderTieuDe" style="margin:0; font-size:1.25rem;">Gọi món - Bàn</h3>
        <small class="text-muted" id="orderPhuDe">Chọn món gửi trực tiếp vào màn hình Bếp KDS</small>
      </div>
      <button type="button" onclick="dongModalOrder()" style="background:none; border:none; font-size:1.5rem; cursor:pointer; color:var(--sdb-muted); line-height:1;">&times;</button>
    </div>

    <!-- Thanh tìm kiếm & lọc loại -->
    <div style="display:flex; gap:10px; margin-bottom:12px; flex-wrap:wrap;">
      <input type="text" id="orderTimKiem" class="form-control form-control-sm" placeholder="Tìm tên món ăn..." oninput="locMonOrder()" style="flex:1; min-width:180px;">
      <select id="orderLocLoai" class="form-control form-control-sm" onchange="locMonOrder()" style="width:170px;">
        <option value="">Tất cả danh mục</option>
      </select>
    </div>

    <!-- Danh sách món để chọn -->
    <div id="orderDanhSachMon" style="flex:1; overflow-y:auto; min-height:220px; max-height:360px; display:grid; grid-template-columns:repeat(auto-fill, minmax(210px, 1fr)); gap:10px; padding:4px;">
      <div style="text-align:center; padding:30px; color:var(--sdb-muted); grid-column:1/-1;">Đang tải thực đơn...</div>
    </div>

    <!-- Giỏ món đã chọn -->
    <div id="orderGioHang" style="margin-top:12px; padding:10px 14px; background:#fbf7f0; border:1px solid var(--sdb-line); border-radius:10px; max-height:130px; overflow-y:auto; font-size:.85rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; font-weight:700;">
        <span>Món chọn thêm: <span id="orderTongSoMon" class="badge badge-success">0</span></span>
        <span style="color:#b3352c; font-size:.95rem;" id="orderTongTienTam">0 ₫</span>
      </div>
      <div id="orderDanhSachChon" style="margin-top:6px; color:#555;">Chưa chọn món nào</div>
    </div>

    <!-- Nút hành động -->
    <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:14px; border-top:1px solid var(--sdb-line); padding-top:12px;">
      <button type="button" class="btn btn-secondary btn-sm" onclick="dongModalOrder()">Hủy bỏ</button>
      <button type="button" id="btnGuiBep" class="btn btn-success btn-sm font-weight-bold" onclick="xacNhanGuiBep()" disabled>
        <i class="fas fa-fire mr-1"></i> GỬI BẾP CHẾ BIẾN
      </button>
    </div>
  </div>
</div>

<%- include('../partials/so-do-dat-ban') %>

<script>
const $ = (id) => document.getElementById(id);
const tien = (v) => Number(v || 0).toLocaleString('vi-VN');

let duLieu = { ban: [], vi_tri: [], thong_ke: {} };
let viTriDangXem = 'tat_ca';
let ngayDangXem = new Date().toISOString().slice(0, 10);
let dangSapXep = false;
let banDangChon = null;

let doLechKhu = {};
const CAO_TIEU_DE = 38;
const CAO_BAN = 120;
const DEM_KHU = 26;

// Khởi tạo ngày hiện tại vào input
if ($('chonNgaySDB')) {
  $('chonNgaySDB').value = ngayDangXem;
}

function doiNgayXem(ngay) {
  if (!ngay) return;
  ngayDangXem = ngay;
  tai();
}

function veHomNay() {
  ngayDangXem = new Date().toISOString().slice(0, 10);
  if ($('chonNgaySDB')) $('chonNgaySDB').value = ngayDangXem;
  tai();
}

async function tai() {
  try {
    const r = await fetch('/so-do-ban/api/du-lieu?ngay=' + encodeURIComponent(ngayDangXem));
    if (!r.ok) throw new Error(r.status);
    duLieu = await r.json();
  } catch (e) {
    console.error('Không tải được sơ đồ:', e);
    return;
  }
  veChiSo();
  veTab();
  veSan();
}

function veChiSo() {
  const t = duLieu.thong_ke || {};
  const isHomNay = ngayDangXem === new Date().toISOString().slice(0, 10);
  const nhanDoanhThu = isHomNay ? 'Doanh thu hôm nay' : `Doanh thu (${ngayDangXem})`;

  $('chiSo').innerHTML = `
    <div class="sdb-kpi-card t">
      <div class="sdb-kpi-title">Bàn trống</div>
      <div class="sdb-kpi-val">${t.trong || 0}<span style="font-size:14px;color:var(--sdb-muted);font-weight:500;">/${t.tong || 0}</span></div>
    </div>
    <div class="sdb-kpi-card p">
      <div class="sdb-kpi-title">Đang phục vụ</div>
      <div class="sdb-kpi-val">${t.dang_phuc_vu || 0}</div>
    </div>
    <div class="sdb-kpi-card d">
      <div class="sdb-kpi-title">Đã đặt trước</div>
      <div class="sdb-kpi-val">${t.da_dat || 0}</div>
    </div>
    <div class="sdb-kpi-card gold">
      <div class="sdb-kpi-title">Tỷ lệ lấp đầy</div>
      <div class="sdb-kpi-val">${t.ty_le_lap_day || 0}% <span style="font-size:13px;color:var(--sdb-muted);font-weight:500;">· ${t.so_cho || 0} chỗ</span></div>
    </div>
    <div class="sdb-kpi-card">
      <div class="sdb-kpi-title">Doanh thu đang mở</div>
      <div class="sdb-kpi-val" style="font-size:1.2rem; color:var(--sdb-gold-dark);">${tien(t.doanh_thu_dang_mo)}đ</div>
    </div>
    <div class="sdb-kpi-card">
      <div class="sdb-kpi-title">${nhanDoanhThu}</div>
      <div class="sdb-kpi-val" style="font-size:1.2rem; color:var(--sdb-ink);">${tien(t.doanh_thu_hom_nay)}đ</div>
    </div>`;
}

const tenKhu = (v) => v.Name_vitri || v.name_vitri || 'Khu';

function veTab() {
  const tong = (duLieu.ban || []).length;
  const ds = [{ id_vitri: 'tat_ca', Name_vitri: 'Tất cả', so_ban: tong }, ...(duLieu.vi_tri || [])];
  $('tabViTri').innerHTML = ds.map(v => `
    <button class="sdb-tab-btn ${String(v.id_vitri) === String(viTriDangXem) ? 'on' : ''}"
            onclick="chonViTri('${v.id_vitri}')">${tenKhu(v)}
      <span style="opacity:.7">(${v.so_ban || 0})</span></button>`).join('');
}

function chonViTri(id) { viTriDangXem = id; veTab(); veSan(); }

if (window.SoDoDatBan) {
  SoDoDatBan.chuThich($('chuThich'), [
    ['trong', 'Trống'],
    ['dat', 'Đã đặt trước'],
    ['phucvu', 'Đang phục vụ'],
    ['don', 'Đang dọn'],
    ['baotri', 'Bảo trì'],
  ]);
}

const KIEU_VE = { 0: 'trong', 1: 'phucvu', 2: 'dat', 3: 'don', 4: 'baotri' };

function theBan(b, doLech) {
  const el = document.createElement('div');
  el.className = 'ban' + (dangSapXep ? ' keo' : '');
  el.dataset.id = b.Id_ban;
  el.dataset.khu = b.id_vitri;
  el.style.left = b.toa_do_x + 'px';
  el.style.top = (Number(b.toa_do_y) + doLech) + 'px';
  
  let ttMoTa = b.ten_trang_thai;
  if (b.dat_truoc) {
    ttMoTa = `Đã đặt trước: ${b.dat_truoc.ten_khach} (${b.dat_truoc.gio})`;
  }
  el.title = `Bàn ${b.number_ban} · ${b.so_cho} chỗ · ${ttMoTa}`;
  el.onclick = () => moHop(b.Id_ban);

  el.appendChild(SoDoDatBan.veBan(b.so_cho, KIEU_VE[b.trangthai] || 'trong', b.number_ban).svg);

  let ct = '';
  if (b.trangthai === 1 && b.so_mon) {
    ct = `${b.so_mon} món · <b>${tien(b.tong_tien)}đ</b>` + (b.so_khach ? ` · ${b.so_khach} khách` : '');
  } else if (b.dat_truoc) {
    ct = `Giữ chỗ: <b>${b.dat_truoc.gio ? b.dat_truoc.gio.slice(0,5) : ''}</b>`;
  } else if (b.trangthai === 2) {
    ct = 'Giữ chỗ';
  } else if (b.trangthai === 4) {
    ct = 'Bảo trì';
  }
  if (ct) {
    const d = document.createElement('div');
    d.className = 'ct';
    d.innerHTML = ct;
    el.appendChild(d);
  }
  return el;
}

function veSan() {
  const tatCa = viTriDangXem === 'tat_ca';
  const khuHienThi = (duLieu.vi_tri || []).filter(
    v => tatCa || String(v.id_vitri) === String(viTriDangXem));

  const manh = document.createDocumentFragment();
  let y = 0;
  doLechKhu = {};

  for (const v of khuHienThi) {
    const ds = (duLieu.ban || []).filter(b => String(b.id_vitri) === String(v.id_vitri));
    const trong = ds.filter(b => b.trangthai === 0).length;
    doLechKhu[v.id_vitri] = y + CAO_TIEU_DE;

    const dai = document.createElement('div');
    dai.className = 'dai-khu';
    dai.style.top = y + 'px';
    dai.textContent = tenKhu(v);
    const dem = document.createElement('span');
    dem.className = 'dem';
    dem.textContent = `${ds.length} bàn · ${v.so_cho || 0} chỗ · ${trong} bàn trống`;
    dai.appendChild(dem);
    manh.appendChild(dai);

    ds.forEach(b => manh.appendChild(theBan(b, y + CAO_TIEU_DE)));

    const day = ds.reduce((m, b) => Math.max(m, Number(b.toa_do_y) + CAO_BAN), CAO_BAN);
    y += CAO_TIEU_DE + day + DEM_KHU;
  }

  const san = $('san');
  san.innerHTML = '';
  if (manh.childNodes.length) san.appendChild(manh);
  else san.innerHTML = '<div style="padding:40px;color:var(--sdb-muted);text-align:center">Khu vực này chưa có bàn nào</div>';
  san.style.height = Math.max(540, y + 10) + 'px';

  if (dangSapXep) ganKeoTha();
  veSanGrid((duLieu.ban || []).filter(b => tatCa || String(b.id_vitri) === String(viTriDangXem)));
}

let currentMobileSdbMode = 'map';
function setMobileSdbMode(mode) {
  currentMobileSdbMode = mode;
  const san = $('san');
  const sanGrid = $('sanGrid');
  const btnMap = $('btnModeMap');
  const btnGrid = $('btnModeGrid');
  if (mode === 'grid') {
    if (san) san.style.display = 'none';
    if (sanGrid) sanGrid.style.display = 'grid';
    if (btnMap) btnMap.className = 'btn btn-outline-primary font-weight-bold';
    if (btnGrid) btnGrid.className = 'btn btn-primary font-weight-bold';
  } else {
    if (san) san.style.display = 'block';
    if (sanGrid) sanGrid.style.display = 'none';
    if (btnMap) btnMap.className = 'btn btn-primary font-weight-bold';
    if (btnGrid) btnGrid.className = 'btn btn-outline-primary font-weight-bold';
  }
}

function veSanGrid(dsBans) {
  const container = $('sanGrid');
  if (!container) return;
  if (!dsBans || dsBans.length === 0) {
    container.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:30px;color:var(--sdb-muted);">Khu vực này chưa có bàn nào</div>';
    return;
  }
  let html = '';
  dsBans.forEach(b => {
    let kieu = KIEU_VE[b.trangthai] || 'trong';
    let statusBadge = '<span class="badge badge-success px-2 py-1">Trống</span>';
    if (b.trangthai === 1) statusBadge = '<span class="badge badge-danger px-2 py-1">Có khách</span>';
    else if (b.trangthai === 2 || b.dat_truoc) statusBadge = '<span class="badge badge-warning text-dark px-2 py-1">Đã đặt</span>';
    else if (b.trangthai === 3) statusBadge = '<span class="badge badge-warning px-2 py-1">Cần dọn</span>';
    else if (b.trangthai === 4) statusBadge = '<span class="badge badge-secondary px-2 py-1">Bảo trì</span>';

    let subText = `<i class="fas fa-users fa-xs mr-1"></i>${b.so_cho} chỗ ngồi`;
    if (b.trangthai === 1 && b.so_mon) {
      subText = `<span class="text-danger font-weight-bold">${tien(b.tong_tien)}đ</span> (${b.so_mon} món)`;
    } else if (b.dat_truoc) {
      subText = `Giữ chỗ: <b>${b.dat_truoc.gio ? b.dat_truoc.gio.slice(0,5) : ''}</b>`;
    }

    html += `
      <div class="m-table-card m-${kieu}" onclick="moHop(${b.Id_ban})">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <strong style="font-size:0.95rem;color:var(--sdb-ink);"><i class="fas fa-chair text-muted mr-1"></i>Bàn ${b.number_ban}</strong>
          ${statusBadge}
        </div>
        <div style="font-size:0.8rem;color:#6b5f54;margin-top:4px;">${subText}</div>
      </div>
    `;
  });
  container.innerHTML = html;
}

// --- Kéo thả ---
function batSapXep() {
  dangSapXep = !dangSapXep;
  $('btnSapXep').innerHTML = dangSapXep ? '<i class="fas fa-xmark"></i>Hủy sắp xếp' : '<i class="fas fa-arrows-up-down-left-right"></i>Sắp xếp sơ đồ';
  $('btnLuu').style.display = dangSapXep ? 'inline-flex' : 'none';
  veSan();
}

function ganKeoTha() {
  document.querySelectorAll('.ban').forEach(el => {
    el.onmousedown = (e) => {
      if (!dangSapXep) return;
      e.preventDefault();
      const san = $('san').getBoundingClientRect();
      const the = el.getBoundingClientRect();
      const lechX = e.clientX - the.left;
      const lechY = e.clientY - the.top;
      el.classList.add('dang-keo');

      const dayKhu = doLechKhu[el.dataset.khu] || 0;

      const dichuyen = (ev) => {
        const x = Math.max(0, ev.clientX - san.left - lechX);
        const y = Math.max(dayKhu, ev.clientY - san.top - lechY);
        el.style.left = x + 'px';
        el.style.top = y + 'px';
      };
      const tha = () => {
        el.classList.remove('dang-keo');
        document.removeEventListener('mousemove', dichuyen);
        document.removeEventListener('mouseup', tha);
      };
      document.addEventListener('mousemove', dichuyen);
      document.addEventListener('mouseup', tha);
    };
  });
}

async function luuViTri() {
  const ban = [...document.querySelectorAll('.ban')].map(el => ({
    id: Number(el.dataset.id),
    x: Math.max(0, parseInt(el.style.left) || 0),
    y: Math.max(0, (parseInt(el.style.top) || 0) - (doLechKhu[el.dataset.khu] || 0)),
  }));
  try {
    const r = await fetch('/so-do-ban/api/vi-tri', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ban }),
    });
    const kq = await r.json();
    if (!r.ok) throw new Error(kq.loi || 'Lỗi');
    dangSapXep = false;
    $('btnSapXep').innerHTML = '<i class="fas fa-arrows-up-down-left-right"></i>Sắp xếp sơ đồ';
    $('btnLuu').style.display = 'none';
    await tai();
  } catch (e) {
    alert('Không lưu được vị trí: ' + e.message);
  }
}

// --- Đổi trạng thái & Gọi món ---
let toanBoMon = [];
let danhMucMon = [];
let monDangChonOrder = {}; // id_mon -> { mon, qty }
let thucDonDaTai = false;

async function moHop(id) {
  if (dangSapXep) return;
  const b = (duLieu.ban || []).find(x => x.Id_ban === id);
  if (!b) return;
  banDangChon = b;
  $('hopTieuDe').textContent = 'Bàn ' + b.number_ban;
  let moTa = `Trạng thái: <b>${b.ten_trang_thai}</b> &middot; ${b.so_cho} chỗ`;
  if (b.so_mon) {
    moTa += `<br>Đang có ${b.so_mon} món, tổng <b>${tien(b.tong_tien)}đ</b>`;
  }
  if (b.dat_truoc) {
    moTa += `<br><span style="color:var(--sdb-dat)"><i class="fas fa-calendar-check" style="margin-right:4px;"></i><b>Đã đặt trước</b>: ${b.dat_truoc.ten_khach} (${b.dat_truoc.so_khach} khách) - Giờ đến: <b>${b.dat_truoc.gio}</b> (Mã: ${b.dat_truoc.ma})</span>`;
  }
  $('hopMoTa').innerHTML = moTa;

  // Nút Gọi món
  if (b.sesis_hien_tai) {
    $('txtBtnOrder').textContent = 'Gọi thêm món cho bàn';
  } else {
    $('txtBtnOrder').textContent = 'Mở bàn & Gọi món ngay';
  }

  // Nút tính tiền
  if (b.sesis_hien_tai) {
    $('hopLinkThuTien').href = '/staff/thanh-toan/' + encodeURIComponent(b.sesis_hien_tai);
    $('hopNutThuTien').style.display = 'grid';
  } else {
    $('hopNutThuTien').style.display = 'none';
  }

  // Tải danh sách món đã gọi
  $('hopDsMon').style.display = 'none';
  $('dsMonDaGoiChiTiet').innerHTML = '';
  if (b.sesis_hien_tai) {
    fetch('/so-do-ban/api/mon-cua-ban/' + b.Id_ban)
      .then(r => r.json())
      .then(d => {
        if (d.ok && d.items && d.items.length > 0) {
          $('demMonDaGoi').textContent = d.items.length;
          let tongTien = 0;
          let html = '';
          const nhanBep = {
            0: '<span class="badge badge-secondary" style="font-size:10px;">Chờ làm</span>',
            1: '<span class="badge badge-warning" style="font-size:10px;">Đang làm</span>',
            2: '<span class="badge badge-success" style="font-size:10px;">Đã xong</span>',
            3: '<span class="badge badge-info" style="font-size:10px;">Đã phục vụ</span>'
          };
          d.items.forEach(m => {
            tongTien += Number(m.thanhtien || 0);
            html += `<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px dashed #e7ded0; padding:3px 0;">
              <div><strong>${m.name_mon}</strong> <span class="text-muted">x${m.soluong}</span></div>
              <div style="display:flex; align-items:center; gap:6px;">
                <span style="color:#b3352c; font-weight:600;">${tien(m.thanhtien)}đ</span>
                ${nhanBep[m.trangthai_bep] || ''}
              </div>
            </div>`;
          });
          $('tongTienMonDaGoi').textContent = tien(tongTien) + ' ₫';
          $('dsMonDaGoiChiTiet').innerHTML = html;
          $('hopDsMon').style.display = 'block';
        }
      })
      .catch(() => {});
  }

  $('lop').style.display = 'flex';
}
function dongHop() { $('lop').style.display = 'none'; banDangChon = null; }

// --- GỌI MÓN TRỰC TIẾP ---
async function taiThucDon() {
  if (thucDonDaTai) return;
  try {
    const res = await fetch('/staff/bookings/dishes');
    const data = await res.json();
    if (data.success) {
      toanBoMon = data.dishes || [];
      danhMucMon = data.categories || [];
      thucDonDaTai = true;

      // Đổ options loại món
      const sel = $('orderLocLoai');
      sel.innerHTML = '<option value="">Tất cả danh mục</option>';
      danhMucMon.forEach(c => {
        sel.innerHTML += `<option value="${c.id_loai}">${c.name_loai}</option>`;
      });
    }
  } catch (err) {
    console.error('Lỗi tải thực đơn:', err);
  }
}

async function moModalOrder() {
  if (!banDangChon) return;
  dongHop(); // đóng popup nhỏ
  monDangChonOrder = {};
  $('orderTieuDe').textContent = 'Gọi món - Bàn ' + banDangChon.number_ban;
  $('orderPhuDe').textContent = banDangChon.sesis_hien_tai 
    ? 'Thêm món cho bàn đang phục vụ (Phiên: ' + banDangChon.sesis_hien_tai.substring(0,6).toUpperCase() + ')'
    : 'Mở bàn mới và chọn món phục vụ khách';
  $('orderTimKiem').value = '';
  $('orderLocLoai').value = '';

  $('lopOrder').style.display = 'flex';
  await taiThucDon();
  locMonOrder();
  capNhatGioOrder();
}

function dongModalOrder() {
  $('lopOrder').style.display = 'none';
  monDangChonOrder = {};
}

function locMonOrder() {
  const tim = ($('orderTimKiem').value || '').trim().toLowerCase();
  const loai = $('orderLocLoai').value;

  const loc = toanBoMon.filter(m => {
    const khopTen = !tim || m.name_mon.toLowerCase().includes(tim);
    const khopLoai = !loai || String(m.id_loai) === String(loai);
    return khopTen && khopLoai;
  });

  const box = $('orderDanhSachMon');
  if (loc.length === 0) {
    box.innerHTML = '<div style="text-align:center; padding:30px; color:var(--sdb-muted); grid-column:1/-1;">Không tìm thấy món ăn phù hợp.</div>';
    return;
  }

  let html = '';
  loc.forEach(d => {
    const curQty = monDangChonOrder[d.id_mon] ? monDangChonOrder[d.id_mon].qty : 0;
    html += `
      <div style="background:#fff; border:1px solid ${curQty > 0 ? '#2e7d4f' : 'var(--sdb-line)'}; border-radius:10px; padding:8px 10px; display:flex; flex-direction:column; justify-content:space-between; box-shadow:0 2px 6px rgba(0,0,0,.04);">
        <div style="display:flex; align-items:center; gap:8px;">
          ${d.images ? `<img src="/food/${d.images}" style="width:40px;height:40px;border-radius:6px;object-fit:cover;" onerror="this.style.display='none'">` : '<div style="width:40px;height:40px;border-radius:6px;background:#f0ede6;display:grid;place-items:center;">🍲</div>'}
          <div style="flex:1; min-width:0;">
            <div style="font-weight:700; font-size:.85rem; color:var(--sdb-dark); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${d.name_mon}">${d.name_mon}</div>
            <div style="color:#b3352c; font-weight:700; font-size:.8rem;">${tien(d.gia_mon)} ₫</div>
          </div>
        </div>
        <div style="display:flex; justify-content:flex-end; align-items:center; gap:6px; margin-top:8px;">
          <button type="button" class="btn btn-outline-danger btn-sm" onclick="doiSoLuongOrder(${d.id_mon}, -1)" style="padding:1px 8px; font-weight:bold; line-height:1.2;">−</button>
          <span id="orderQty_${d.id_mon}" style="font-weight:700; min-width:20px; text-align:center; font-size:.88rem;">${curQty}</span>
          <button type="button" class="btn btn-outline-success btn-sm" onclick="doiSoLuongOrder(${d.id_mon}, 1, ${JSON.stringify(d).replace(/"/g, '&quot;')})" style="padding:1px 8px; font-weight:bold; line-height:1.2;">+</button>
        </div>
      </div>
    `;
  });
  box.innerHTML = html;
}

function doiSoLuongOrder(idMon, delta, objMon) {
  if (!monDangChonOrder[idMon] && delta > 0 && objMon) {
    monDangChonOrder[idMon] = { mon: objMon, qty: 0 };
  }
  if (!monDangChonOrder[idMon]) return;

  monDangChonOrder[idMon].qty += delta;
  if (monDangChonOrder[idMon].qty <= 0) {
    delete monDangChonOrder[idMon];
  }

  const el = $('orderQty_' + idMon);
  if (el) el.textContent = monDangChonOrder[idMon] ? monDangChonOrder[idMon].qty : 0;

  capNhatGioOrder();
}

function capNhatGioOrder() {
  const items = Object.values(monDangChonOrder);
  const btn = $('btnGuiBep');
  if (items.length === 0) {
    $('orderTongSoMon').textContent = '0';
    $('orderTongTienTam').textContent = '0 ₫';
    $('orderDanhSachChon').innerHTML = '<span class="text-muted">Chưa chọn món nào</span>';
    btn.disabled = true;
    return;
  }

  let tongMon = 0;
  let tongTien = 0;
  let html = '<div style="display:flex; flex-wrap:wrap; gap:8px;">';
  items.forEach(it => {
    tongMon += it.qty;
    const sub = it.mon.gia_mon * it.qty;
    tongTien += sub;
    html += `<span class="badge badge-light" style="border:1px solid var(--sdb-line); padding:4px 8px; font-size:12px;"><strong>${it.mon.name_mon}</strong> x${it.qty} (${tien(sub)}đ)</span>`;
  });
  html += '</div>';

  $('orderTongSoMon').textContent = tongMon;
  $('orderTongTienTam').textContent = tien(tongTien) + ' ₫';
  $('orderDanhSachChon').innerHTML = html;
  btn.disabled = false;
}

async function xacNhanGuiBep() {
  if (!banDangChon) return;
  const items = Object.values(monDangChonOrder).map(it => ({
    id_mon: it.mon.id_mon,
    soluong: it.qty
  }));
  if (items.length === 0) return alert('Vui lòng chọn ít nhất 1 món!');

  const btn = $('btnGuiBep');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Đang gửi bếp...';

  try {
    const res = await fetch('/so-do-ban/api/order-mon/' + banDangChon.Id_ban, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items })
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.loi || 'Lỗi khi gửi món');

    dongModalOrder();
    alert('✅ Đã gửi ' + items.length + ' món vào bếp thành công cho Bàn ' + banDangChon.number_ban + '!');
    await tai();
  } catch (err) {
    alert('Lỗi: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-fire mr-1"></i> GỬI BẾP CHẾ BIẾN';
  }
}

async function doiTrangThai(tt) {
  if (!banDangChon) return;
  try {
    const r = await fetch('/so-do-ban/api/trang-thai/' + banDangChon.Id_ban, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ trangthai: tt, sesis: banDangChon.sesis_hien_tai }),
    });
    const kq = await r.json();
    if (!r.ok) throw new Error(kq.loi || 'Lỗi');
    dongHop();
    await tai();
  } catch (e) {
    alert('Không đổi được trạng thái: ' + e.message);
  }
}

$('lop').addEventListener('click', (e) => { if (e.target.id === 'lop') dongHop(); });
$('lopOrder').addEventListener('click', (e) => { if (e.target.id === 'lopOrder') dongModalOrder(); });

// --- Realtime ---
const socket = io();
socket.on('connect', () => {
  socket.emit('join-room', { role: 'Phuc vu' });
  $('ttKetNoi').textContent = 'Đã kết nối thời gian thực';
  $('chamKN').classList.remove('tat');
});
socket.on('disconnect', () => {
  $('ttKetNoi').textContent = 'Mất kết nối - đang thử lại';
  $('chamKN').classList.add('tat');
});
socket.on('ban-cap-nhat', tai);
socket.on('kds-cap-nhat', tai);
socket.on('so-do-thay-doi', tai);

tai();
setInterval(() => { if (!dangSapXep) tai(); }, 20000);
</script>

