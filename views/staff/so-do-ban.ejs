<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sơ đồ bàn thời gian thực - Nhà Hàng Bảo Đoàn</title>
  <script src="/socket.io/socket.io.js"></script>
  <style>
    :root {
      --bg:#f1f5f9; --card:#fff; --line:#e2e8f0; --text:#0f172a; --muted:#64748b;
      --trong:#16a34a; --phucvu:#dc2626; --dat:#d97706; --don:#64748b; --baotri:#1e293b;
    }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--text);
           font-family:"Segoe UI",system-ui,-apple-system,sans-serif; }
    header { background:linear-gradient(135deg,#0f766e,#115e59); color:#fff;
             padding:16px 26px; display:flex; justify-content:space-between;
             align-items:center; flex-wrap:wrap; gap:12px; }
    header h1 { margin:0; font-size:19px; }
    header .sub { font-size:12.5px; opacity:.85; margin-top:2px; }
    /* nav la flex co gap chu khong phai cac the a noi tiep nhau cach nhau bang
       margin-left: the <a> mac dinh la inline, ma padding tren o inline KHONG
       lam giay dong ra - nen khi ba nut xuong dong tren dien thoai, khung vien
       cua nut dong duoi de len nut dong tren. Do o 390px: nut "Trang nhan vien"
       xuong dong va khung cua no cat ngang nut "Man hinh bep". */
    header nav { display:flex; flex-wrap:wrap; gap:8px; }
    header nav a { color:#fff; text-decoration:none; font-size:13px; padding:7px 13px;
                   border:1px solid rgba(255,255,255,.35); border-radius:7px;
                   display:inline-flex; align-items:center; min-height:38px; }
    header nav a:hover { background:rgba(255,255,255,.16); }

    /* Dien thoai: le 26px hai ben la qua rong tren man 390px. */
    @media (max-width:640px) {
      header { padding:14px 16px; }
      header h1 { font-size:17px; }
      .wrap { padding:14px 16px 40px; }
    }
    .cham { display:inline-block; width:9px; height:9px; border-radius:50%;
            background:#4ade80; margin-right:6px; }
    .cham.tat { background:#f87171; }

    .wrap { padding:18px 26px 50px; max-width:1500px; margin:0 auto; }

    .chiso { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
             gap:13px; margin-bottom:18px; }
    .o { background:var(--card); border:1px solid var(--line); border-radius:10px;
         padding:13px 16px; border-left:4px solid var(--line); }
    .o .n { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.4px; }
    .o .v { font-size:25px; font-weight:700; margin-top:5px; }
    .o.t { border-left-color:var(--trong); }
    .o.p { border-left-color:var(--phucvu); }
    .o.d { border-left-color:var(--dat); }

    .thanh { background:var(--card); border:1px solid var(--line); border-radius:10px;
             padding:12px 16px; margin-bottom:16px; display:flex; gap:16px;
             align-items:center; flex-wrap:wrap; }
    /* Chu thich duoc thanh phan chung ve ra (.sdb__chuthich); o day chi chinh
       lai nen cho hop voi thanh cong cu mau trang. */
    #chuThich .sdb__chuthich { margin:0; padding:0; background:none; border:0; gap:.35rem .1rem; }
    .tab { display:flex; gap:8px; }
    .tab button { padding:7px 15px; border:1px solid var(--line); background:#fff;
                  border-radius:7px; cursor:pointer; font-size:13.5px; font-family:inherit; }
    .tab button.on { background:#0f766e; color:#fff; border-color:#0f766e; }
    .btn { background:#0f766e; color:#fff; border:0; padding:8px 15px; border-radius:7px;
           cursor:pointer; font-size:13.5px; font-family:inherit; }
    .btn.ghost { background:#fff; color:#0f766e; border:1px solid #0f766e; }

    /* San nha: nen am co luoi mo, giong het so do dat ban o khu khach - hai
       man hinh ve cung mot nha hang thi phai nhin ra la cung mot nha hang. */
    .san { position:relative; border-radius:14px; min-height:520px; overflow:auto;
           background:
             radial-gradient(120% 90% at 50% 6%, rgba(255,255,255,.9), rgba(255,255,255,0) 60%),
             linear-gradient(rgba(120,90,60,.05) 1px, transparent 1px) 0 0 / 100% 44px,
             linear-gradient(90deg, rgba(120,90,60,.05) 1px, transparent 1px) 0 0 / 44px 100%,
             linear-gradient(160deg,#fdfaf5,#f4eee3);
           box-shadow: inset 0 0 0 1px rgba(120,90,60,.16); }

    /* Dai tieu de ngan cach cac khu khi xem tab "Tất cả". */
    .dai-khu { position:absolute; left:0; right:0; height:34px; display:flex;
               align-items:center; gap:10px; padding:0 18px; font-size:13px;
               font-weight:700; color:#6b4f2a; background:rgba(255,255,255,.72);
               border-top:1px solid rgba(120,90,60,.16); border-bottom:1px solid rgba(120,90,60,.16); }
    .dai-khu .dem { font-weight:500; color:var(--muted); font-size:12px; }

    /* THE BAN.

       Truoc day moi ban la mot hop chu nhat 138px to mau, chu trang ben trong.
       Doc duoc, nhung phai DOC: muon biet ban may cho thi phai tim dong chu.
       Bay gio ban duoc VE ra - mat ban va ghe xung quanh, dung bang so cho -
       nen suc chua la thu nhin la thay. Dung chung ham ve voi so do dat ban o
       khu khach (partials/so-do-dat-ban.ejs). */
    .ban { position:absolute; cursor:pointer; user-select:none;
           display:flex; flex-direction:column; align-items:center; gap:2px;
           transition:transform .14s, filter .14s;
           filter:drop-shadow(0 3px 6px rgba(60,40,20,.18)); }
    .ban:hover { transform:translateY(-3px); filter:drop-shadow(0 9px 16px rgba(60,40,20,.32)); z-index:20; }
    .ban svg { display:block; }
    .ban.keo { cursor:grab; }
    .ban.dang-keo { opacity:.75; cursor:grabbing; z-index:50; }
    /* Dong thong tin duoi ban: chi hien khi CO gi de noi (dang phuc vu, giu cho).
       Ban trong khong can mot dong chu lap lai dieu ma mau sac da noi. */
    .ban .ct { font-size:11px; font-weight:600; line-height:1.35; text-align:center;
               background:#fff; border:1px solid rgba(120,90,60,.2); border-radius:7px;
               padding:2px 7px; white-space:nowrap; color:#4a4038; margin-top:-4px; }
    .ban .ct b { color:#7c2d12; }

    .lop { position:fixed; inset:0; background:rgba(15,23,42,.55); display:none;
           align-items:center; justify-content:center; z-index:100; }
    .hop { background:#fff; border-radius:12px; padding:24px 26px; width:min(420px,92vw); }
    .hop h3 { margin:0 0 4px; font-size:18px; }
    .hop .p { color:var(--muted); font-size:13px; margin-bottom:16px; }
    .hop .nut { display:grid; gap:9px; }
    .hop .nut button { padding:11px; border:0; border-radius:8px; cursor:pointer;
                       font-size:14px; color:#fff; font-family:inherit; text-align:left;
                       padding-left:16px; }
    /* Nut ra man hinh thu tien - viec chinh o hop thoai nay nen de noi bat va
       tach khoi nhom nut doi trang thai ben duoi. */
    #hopNutThuTien { display:none; margin-bottom:14px; padding-bottom:14px;
                     border-bottom:1px solid var(--line); }
    .hop .nut a.thu-tien { padding:12px; border-radius:8px; font-size:14.5px;
                           font-weight:600; color:#fff; background:#0f766e;
                           text-decoration:none; text-align:center; display:block; }
    .hop .nut a.thu-tien:hover { background:#115e59; }
    .hop .dong { margin-top:14px; width:100%; padding:10px; background:#e2e8f0;
                 border:0; border-radius:8px; cursor:pointer; font-family:inherit; font-size:14px; }
    .ghi-chu { font-size:12.5px; color:var(--muted); margin-top:12px; }
  </style>
</head>
<body>
  <header>
    <div>
      <h1>Sơ đồ bàn thời gian thực</h1>
      <div class="sub">
        <span class="cham" id="chamKN"></span><span id="ttKetNoi">Đang kết nối...</span>
        &nbsp;|&nbsp; <%= tenNguoiDung %>
      </div>
    </div>
    <nav>
      <a href="/kds">Màn hình bếp</a>
      <a href="/analytics">Dashboard</a>
      <a href="/staff">Trang nhân viên</a>
    </nav>
  </header>

  <div class="wrap">
    <div class="chiso" id="chiSo"></div>

    <div class="thanh">
      <div class="tab" id="tabViTri"></div>
      <%# Chu thich do chinh thanh phan ve ban dung ra, khong ve tay lai o day:
          mot bang mau viet tay se lech khoi so do ngay lan dau ai do doi mot mau. %>
      <div id="chuThich" style="margin-left:auto"></div>
      <% if (choPhepKeoTha) { %>
        <button class="btn ghost" id="btnSapXep" onclick="batSapXep()">Sắp xếp sơ đồ</button>
        <button class="btn" id="btnLuu" onclick="luuViTri()" style="display:none">Lưu vị trí</button>
      <% } %>
    </div>

    <div class="san" id="san"></div>
    <% if (choPhepKeoTha) { %>
      <p class="ghi-chu">Bấm <b>Sắp xếp sơ đồ</b> để kéo thả bàn về đúng vị trí thực tế trong nhà hàng, sau đó bấm <b>Lưu vị trí</b>.</p>
    <% } %>
  </div>

  <div class="lop" id="lop">
    <div class="hop">
      <h3 id="hopTieuDe">Bàn</h3>
      <div class="p" id="hopMoTa"></div>
      <!-- Loi ra man hinh thu tien. Chi hien khi ban dang co don, vi khong co
           `sesis` thi khong co gi de tinh. Day la duong di tu nhien nhat cua
           thu ngan: khach o ban 7 goi tinh tien -> bam ban 7 tren so do. -->
      <div class="nut" id="hopNutThuTien"><a class="thu-tien" id="hopLinkThuTien" href="#">Tính tiền bàn này</a></div>
      <div class="nut">
        <button style="background:var(--trong)"  onclick="doiTrangThai(0)">Đặt là Trống</button>
        <button style="background:var(--phucvu)" onclick="doiTrangThai(1)">Đặt là Đang phục vụ</button>
        <button style="background:var(--dat)"    onclick="doiTrangThai(2)">Đặt là Đã đặt trước</button>
        <button style="background:var(--don)"    onclick="doiTrangThai(3)">Đặt là Đang dọn</button>
      </div>
      <button class="dong" onclick="dongHop()">Đóng</button>
    </div>
  </div>

<%- include('../partials/so-do-dat-ban') %>

<script>
const $ = (id) => document.getElementById(id);
const tien = (v) => Number(v || 0).toLocaleString('vi-VN');

let duLieu = { ban: [], vi_tri: [], thong_ke: {} };
let viTriDangXem = 'tat_ca';
let dangSapXep = false;
let banDangChon = null;

// `ban.toa_do_x/y` trong CSDL la toa do TRONG TUNG KHU. Khi ve, moi khu duoc day
// xuong mot doan theo chieu doc de 4 khu khong chong len nhau; `doLechKhu` giu
// lai doan day do de tru nguoc ra luc luu ket qua keo tha.
let doLechKhu = {};
const CAO_TIEU_DE = 34;  // chieu cao dai ten khu
// The ban cao 78px khi trong va ~109px khi dang phuc vu (co them dong so mon /
// tien / so khach). Lay du 120 de hang cuoi cua mot khu khong bao gio thoc
// xuong dai tieu de cua khu ke tiep.
const CAO_BAN = 120;
const DEM_KHU = 26;      // khoang ho duoi moi khu

async function tai() {
  try {
    const r = await fetch('/so-do-ban/api/du-lieu');
    if (!r.ok) throw new Error(r.status);
    duLieu = await r.json();
  } catch (e) {
    console.error('Không tải được sơ đồ:', e);
    return;
  }
  veChiSo();
  veTab();
  veSan();
}

function veChiSo() {
  const t = duLieu.thong_ke || {};
  $('chiSo').innerHTML = `
    <div class="o t"><div class="n">Bàn trống</div><div class="v">${t.trong || 0}<span style="font-size:15px;color:var(--muted)">/${t.tong || 0}</span></div></div>
    <div class="o p"><div class="n">Đang phục vụ</div><div class="v">${t.dang_phuc_vu || 0}</div></div>
    <div class="o d"><div class="n">Đã đặt trước</div><div class="v">${t.da_dat || 0}</div></div>
    <div class="o"><div class="n">Tỷ lệ lấp đầy</div><div class="v">${t.ty_le_lap_day || 0}<span style="font-size:15px;color:var(--muted)">% · ${t.so_cho || 0} chỗ</span></div></div>
    <div class="o"><div class="n">Doanh thu đang mở</div><div class="v" style="font-size:20px">${tien(t.doanh_thu_dang_mo)}đ</div></div>
    <div class="o"><div class="n">Doanh thu hôm nay</div><div class="v" style="font-size:20px">${tien(t.doanh_thu_hom_nay)}đ</div></div>`;
}

const tenKhu = (v) => v.Name_vitri || v.name_vitri || 'Khu';

function veTab() {
  const tong = (duLieu.ban || []).length;
  const ds = [{ id_vitri: 'tat_ca', Name_vitri: 'Tất cả', so_ban: tong }, ...(duLieu.vi_tri || [])];
  $('tabViTri').innerHTML = ds.map(v => `
    <button class="${String(v.id_vitri) === String(viTriDangXem) ? 'on' : ''}"
            onclick="chonViTri('${v.id_vitri}')">${tenKhu(v)}
      <span style="opacity:.7">(${v.so_ban || 0})</span></button>`).join('');
}

function chonViTri(id) { viTriDangXem = id; veTab(); veSan(); }

/*
  Chu thich chi ve mot lan - no khong doi theo du lieu.

  Truyen nhan rieng thay vi dung bo mac dinh: bo mac dinh viet cho trang KHACH
  ("Trống — chọn được"), con o day bam vao ban la DOI TRANG THAI chu khong phai
  chon ban. Cung mot mau, khac mot dong chu.
*/
SoDoDatBan.chuThich($('chuThich'), [
  ['trong', 'Trống'],
  ['dat', 'Đã đặt trước'],
  ['phucvu', 'Đang phục vụ'],
  ['don', 'Đang dọn'],
  ['baotri', 'Bảo trì'],
]);

/** Ma trang thai ban (0..4) -> kieu ve cua SoDoDatBan. */
const KIEU_VE = { 0: 'trong', 1: 'phucvu', 2: 'dat', 3: 'don', 4: 'baotri' };

/**
 * Dung the mot cai ban - tra ve PHAN TU DOM, khong phai chuoi HTML.
 *
 * Bat buoc phai la DOM: ban duoc ve bang SVG (mat ban + ghe), ma SVG tao bang
 * innerHTML tren mot the <div> se rot vao namespace HTML chu khong phai SVG -
 * trinh duyet dung ra mot dong the rong khong hien gi. Xem `veBan` trong
 * partials/so-do-dat-ban.ejs.
 */
function theBan(b, doLech) {
  const el = document.createElement('div');
  el.className = 'ban' + (dangSapXep ? ' keo' : '');
  el.dataset.id = b.Id_ban;
  el.dataset.khu = b.id_vitri;
  el.style.left = b.toa_do_x + 'px';
  el.style.top = (Number(b.toa_do_y) + doLech) + 'px';
  el.title = `Bàn ${b.number_ban} · ${b.so_cho} chỗ · ${b.ten_trang_thai}`;
  el.onclick = () => moHop(b.Id_ban);

  el.appendChild(SoDoDatBan.veBan(b.so_cho, KIEU_VE[b.trangthai] || 'trong', b.number_ban).svg);

  // Dong thong tin chi hien khi co gi de noi: ban trong khong can mot dong chu
  // lap lai dieu ma mau sac va huy hieu da noi roi.
  let ct = '';
  if (b.trangthai === 1 && b.so_mon) {
    ct = `${b.so_mon} món · <b>${tien(b.tong_tien)}đ</b>` + (b.so_khach ? ` · ${b.so_khach} khách` : '');
  } else if (b.trangthai === 2) {
    ct = 'Giữ chỗ';
  } else if (b.trangthai === 4) {
    ct = 'Bảo trì';
  }
  if (ct) {
    const d = document.createElement('div');
    d.className = 'ct';
    d.innerHTML = ct;
    el.appendChild(d);
  }
  return el;
}

/**
 * Ve so do theo tung khu, xep chong theo chieu doc.
 *
 * Toa do trong CSDL tinh rieng cho moi khu nen neu ve thang se co 4 khu de len
 * nhau. Moi khu duoc cap mot dai tieu de va mot doan lech Y bang tong chieu cao
 * cac khu phia tren.
 */
function veSan() {
  const tatCa = viTriDangXem === 'tat_ca';
  const khuHienThi = (duLieu.vi_tri || []).filter(
    v => tatCa || String(v.id_vitri) === String(viTriDangXem));

  // Dung bang DOM chu khong bang chuoi HTML: the ban chua SVG, ma SVG ghep bang
  // innerHTML se sai namespace va khong hien ra gi. Xem chu thich cua theBan().
  const manh = document.createDocumentFragment();
  let y = 0;
  doLechKhu = {};

  for (const v of khuHienThi) {
    const ds = (duLieu.ban || []).filter(b => String(b.id_vitri) === String(v.id_vitri));
    const trong = ds.filter(b => b.trangthai === 0).length;
    doLechKhu[v.id_vitri] = y + CAO_TIEU_DE;

    const dai = document.createElement('div');
    dai.className = 'dai-khu';
    dai.style.top = y + 'px';
    dai.textContent = tenKhu(v);
    const dem = document.createElement('span');
    dem.className = 'dem';
    dem.textContent = `${ds.length} bàn · ${v.so_cho || 0} chỗ · ${trong} bàn trống`;
    dai.appendChild(dem);
    manh.appendChild(dai);

    ds.forEach(b => manh.appendChild(theBan(b, y + CAO_TIEU_DE)));

    // Chieu cao khu = day nhat cua ban trong khu, toi thieu du cho mot hang.
    const day = ds.reduce((m, b) => Math.max(m, Number(b.toa_do_y) + CAO_BAN), CAO_BAN);
    y += CAO_TIEU_DE + day + DEM_KHU;
  }

  const san = $('san');
  san.innerHTML = '';
  if (manh.childNodes.length) san.appendChild(manh);
  else san.innerHTML = '<div style="padding:40px;color:var(--muted);text-align:center">Khu vực này chưa có bàn nào</div>';
  san.style.height = Math.max(520, y + 10) + 'px';

  if (dangSapXep) ganKeoTha();
}

// --- Kéo thả ---
function batSapXep() {
  dangSapXep = !dangSapXep;
  $('btnSapXep').textContent = dangSapXep ? 'Hủy sắp xếp' : 'Sắp xếp sơ đồ';
  $('btnLuu').style.display = dangSapXep ? '' : 'none';
  veSan();
}

function ganKeoTha() {
  document.querySelectorAll('.ban').forEach(el => {
    el.onmousedown = (e) => {
      if (!dangSapXep) return;
      e.preventDefault();
      const san = $('san').getBoundingClientRect();
      const the = el.getBoundingClientRect();
      const lechX = e.clientX - the.left;
      const lechY = e.clientY - the.top;
      el.classList.add('dang-keo');

      // Khong cho keo ban len tren dai tieu de cua chinh khu do - neu khong,
      // toa do luu lai se am va ban nhay sang khu ben tren o lan ve sau.
      const dayKhu = doLechKhu[el.dataset.khu] || 0;

      const dichuyen = (ev) => {
        // Giu bàn nam trong khung san va trong dung khu cua no.
        const x = Math.max(0, ev.clientX - san.left - lechX);
        const y = Math.max(dayKhu, ev.clientY - san.top - lechY);
        el.style.left = x + 'px';
        el.style.top = y + 'px';
      };
      const tha = () => {
        el.classList.remove('dang-keo');
        document.removeEventListener('mousemove', dichuyen);
        document.removeEventListener('mouseup', tha);
      };
      document.addEventListener('mousemove', dichuyen);
      document.addEventListener('mouseup', tha);
    };
  });
}

async function luuViTri() {
  // Tru nguoc doan lech cua khu de tra ve toa do trong khu - dung dang dang duoc
  // luu trong CSDL.
  const ban = [...document.querySelectorAll('.ban')].map(el => ({
    id: Number(el.dataset.id),
    x: Math.max(0, parseInt(el.style.left) || 0),
    y: Math.max(0, (parseInt(el.style.top) || 0) - (doLechKhu[el.dataset.khu] || 0)),
  }));
  try {
    const r = await fetch('/so-do-ban/api/vi-tri', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ban }),
    });
    const kq = await r.json();
    if (!r.ok) throw new Error(kq.loi || 'Lỗi');
    dangSapXep = false;
    $('btnSapXep').textContent = 'Sắp xếp sơ đồ';
    $('btnLuu').style.display = 'none';
    await tai();
  } catch (e) {
    alert('Không lưu được vị trí: ' + e.message);
  }
}

// --- Đổi trạng thái ---
function moHop(id) {
  if (dangSapXep) return; // dang keo tha thi khong mo hop thoai
  const b = (duLieu.ban || []).find(x => x.Id_ban === id);
  if (!b) return;
  banDangChon = b;
  $('hopTieuDe').textContent = 'Bàn ' + b.number_ban;
  $('hopMoTa').innerHTML = `Trạng thái hiện tại: <b>${b.ten_trang_thai}</b> &middot; ${b.so_cho} chỗ` +
    (b.so_mon ? `<br>Đang có ${b.so_mon} món, tổng ${tien(b.tong_tien)}đ` : '');

  // Bàn chưa có đơn thì không có gì để tính tiền - giấu nút đi thay vì để nó
  // dẫn tới một trang lỗi "không tìm thấy đơn hàng".
  if (b.sesis_hien_tai) {
    $('hopLinkThuTien').href = '/staff/thanh-toan/' + encodeURIComponent(b.sesis_hien_tai);
    $('hopNutThuTien').style.display = 'grid';
  } else {
    $('hopNutThuTien').style.display = 'none';
  }

  $('lop').style.display = 'flex';
}
function dongHop() { $('lop').style.display = 'none'; banDangChon = null; }

async function doiTrangThai(tt) {
  if (!banDangChon) return;
  try {
    const r = await fetch('/so-do-ban/api/trang-thai/' + banDangChon.Id_ban, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ trangthai: tt, sesis: banDangChon.sesis_hien_tai }),
    });
    const kq = await r.json();
    if (!r.ok) throw new Error(kq.loi || 'Lỗi');
    dongHop();
    await tai();
  } catch (e) {
    alert('Không đổi được trạng thái: ' + e.message);
  }
}

$('lop').addEventListener('click', (e) => { if (e.target.id === 'lop') dongHop(); });

// --- Realtime ---
const socket = io();
socket.on('connect', () => {
  socket.emit('join-room', { role: 'Phuc vu' });
  $('ttKetNoi').textContent = 'Đã kết nối thời gian thực';
  $('chamKN').classList.remove('tat');
});
socket.on('disconnect', () => {
  $('ttKetNoi').textContent = 'Mất kết nối - đang thử lại';
  $('chamKN').classList.add('tat');
});
socket.on('ban-cap-nhat', tai);
socket.on('kds-cap-nhat', tai);
socket.on('so-do-thay-doi', tai);

tai();
setInterval(() => { if (!dangSapXep) tai(); }, 20000);
</script>
</body>
</html>
