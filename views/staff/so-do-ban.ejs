<%- include('partials/header', { activePage: 'sodoban', staffName: session.staffName || session.adminname || 'Nhân viên' }) %>

<style>
  :root {
    --sdb-gold: #c8a24b;
    --sdb-gold-dark: #a8822f;
    --sdb-dark: #241a14;
    --sdb-cream: #fbf7f0;
    --sdb-line: #e7ded0;
    --sdb-muted: #786c5f;
    --sdb-ink: #241d18;
    --sdb-trong: #2e7d4f;
    --sdb-phucvu: #b3352c;
    --sdb-dat: #d97706;
    --sdb-don: #64748b;
    --sdb-baotri: #1e293b;
  }

  .sdb-container {
    width: 100%;
    margin-bottom: 2.5rem;
  }

  .sdb-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .sdb-title {
    font-family: var(--qt-serif, 'Playfair Display', Georgia, serif) !important;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--sdb-ink);
    margin: 0;
  }

  .sdb-subtitle {
    font-family: var(--qt-sans, 'Inter', sans-serif);
    font-size: .85rem;
    color: var(--sdb-muted);
    margin-top: .25rem;
    display: flex;
    align-items: center;
    gap: .5rem;
  }

  .sdb-cham {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sdb-trong);
    box-shadow: 0 0 0 3px rgba(46, 125, 79, .2);
  }
  .sdb-cham.tat {
    background: var(--sdb-phucvu);
    box-shadow: 0 0 0 3px rgba(179, 53, 44, .2);
  }

  .sdb-nav-links {
    display: flex;
    align-items: center;
    gap: .6rem;
    flex-wrap: wrap;
  }

  .sdb-link-btn {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .45rem .95rem;
    background: #ffffff;
    border: 1px solid var(--sdb-line);
    border-radius: 9px;
    color: var(--sdb-ink);
    font-size: .82rem;
    font-weight: 600;
    text-decoration: none;
    transition: all .2s ease;
    box-shadow: 0 2px 6px rgba(36, 26, 20, .04);
  }
  .sdb-link-btn:hover {
    border-color: var(--sdb-gold);
    color: var(--sdb-gold-dark);
    background: #fffdfa;
    transform: translateY(-1px);
  }

  /* Grid Thống Kê KPI */
  .sdb-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .sdb-kpi-card {
    background: #ffffff;
    border: 1px solid var(--sdb-line);
    border-radius: 12px;
    padding: 1rem 1.15rem;
    position: relative;
    box-shadow: 0 6px 18px -12px rgba(36, 26, 20, .25);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .sdb-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -12px rgba(36, 26, 20, .35);
  }
  .sdb-kpi-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 4px;
    border-radius: 12px 0 0 12px;
    background: var(--sdb-line);
  }
  .sdb-kpi-card.t::before { background: var(--sdb-trong); }
  .sdb-kpi-card.p::before { background: var(--sdb-phucvu); }
  .sdb-kpi-card.d::before { background: var(--sdb-dat); }
  .sdb-kpi-card.gold::before { background: var(--sdb-gold); }

  .sdb-kpi-title {
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.1px;
    color: var(--sdb-muted);
    margin-bottom: .35rem;
  }

  .sdb-kpi-val {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--sdb-ink);
    line-height: 1.2;
    display: flex;
    align-items: baseline;
    gap: .3rem;
  }

  /* Toolbar Bộ Lọc & Nút Sắp Xếp */
  .sdb-toolbar {
    background: #ffffff;
    border: 1px solid var(--sdb-line);
    border-radius: 14px;
    padding: .85rem 1.25rem;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    box-shadow: 0 6px 18px -12px rgba(36, 26, 20, .2);
  }

  .sdb-tabs {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
  }

  .sdb-tab-btn {
    padding: .45rem .95rem;
    border: 1px solid var(--sdb-line);
    background: #ffffff;
    border-radius: 8px;
    cursor: pointer;
    font-size: .84rem;
    font-weight: 500;
    color: var(--sdb-ink);
    transition: all .2s;
  }
  .sdb-tab-btn:hover {
    border-color: var(--sdb-gold);
    color: var(--sdb-gold-dark);
  }
  .sdb-tab-btn.on {
    background: var(--sdb-dark);
    color: var(--sdb-gold);
    border-color: var(--sdb-dark);
    font-weight: 600;
    box-shadow: 0 4px 10px rgba(36, 26, 20, .3);
  }

  .sdb-actions {
    display: flex;
    align-items: center;
    gap: .75rem;
    flex-wrap: wrap;
  }

  .sdb-btn {
    background: var(--sdb-dark);
    color: var(--sdb-gold);
    border: 1px solid var(--sdb-dark);
    padding: .45rem 1.1rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: .84rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    transition: all .2s;
  }
  .sdb-btn:hover {
    background: #3d2b21;
    color: #ffd875;
    transform: translateY(-1px);
  }
  .sdb-btn.ghost {
    background: #ffffff;
    color: var(--sdb-ink);
    border-color: var(--sdb-line);
  }
  .sdb-btn.ghost:hover {
    border-color: var(--sdb-gold);
    color: var(--sdb-gold-dark);
    background: #fffdfa;
  }

  /* Khung Sân Sơ Đồ */
  .sdb-floor-container {
    background: #ffffff;
    border: 1px solid var(--sdb-line);
    border-radius: 14px;
    padding: 1.25rem;
    box-shadow: 0 10px 30px -15px rgba(36, 26, 20, .3);
  }

  .san {
    position: relative;
    border-radius: 12px;
    min-height: 540px;
    overflow: auto;
    background:
      radial-gradient(120% 90% at 50% 6%, rgba(255,255,255,.9), rgba(255,255,255,0) 60%),
      linear-gradient(rgba(200,162,75,.06) 1px, transparent 1px) 0 0 / 100% 44px,
      linear-gradient(90deg, rgba(200,162,75,.06) 1px, transparent 1px) 0 0 / 44px 100%,
      linear-gradient(160deg, #fdfaf5, #f4eee3);
    box-shadow: inset 0 0 0 1px rgba(200, 162, 75, .18);
  }

  .dai-khu {
    position: absolute;
    left: 0; right: 0;
    height: 38px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 20px;
    font-size: .88rem;
    font-weight: 700;
    color: var(--sdb-dark);
    background: rgba(255, 255, 255, .85);
    backdrop-filter: blur(6px);
    border-top: 1px solid rgba(200, 162, 75, .2);
    border-bottom: 1px solid rgba(200, 162, 75, .2);
    box-shadow: 0 2px 6px rgba(0,0,0,.03);
  }
  .dai-khu .dem {
    font-weight: 500;
    color: var(--sdb-muted);
    font-size: .78rem;
  }

  /* Bàn */
  .ban {
    position: absolute;
    cursor: pointer;
    user-select: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    transition: transform .14s, filter .14s;
    filter: drop-shadow(0 3px 6px rgba(60,40,20,.18));
  }
  .ban:hover {
    transform: translateY(-3px);
    filter: drop-shadow(0 9px 16px rgba(60,40,20,.32));
    z-index: 20;
  }
  .ban svg { display: block; }
  .ban.keo { cursor: grab; }
  .ban.dang-keo { opacity: .75; cursor: grabbing; z-index: 50; }
  .ban .ct {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    background: #ffffff;
    border: 1px solid rgba(200, 162, 75, .3);
    border-radius: 7px;
    padding: 2px 7px;
    white-space: nowrap;
    color: #4a4038;
    margin-top: -4px;
    box-shadow: 0 2px 5px rgba(0,0,0,.08);
  }
  .ban .ct b { color: #b3352c; }

  /* Modal Đổi Trạng Thái */
  .lop {
    position: fixed;
    inset: 0;
    background: rgba(36, 26, 20, .6);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1050;
  }
  .hop {
    background: #ffffff;
    border: 1px solid var(--sdb-line);
    border-radius: 16px;
    padding: 24px 28px;
    width: min(440px, 92vw);
    box-shadow: 0 20px 50px -15px rgba(36, 26, 20, .45);
  }
  .hop h3 {
    margin: 0 0 6px;
    font-family: var(--qt-serif, 'Playfair Display', Georgia, serif) !important;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--sdb-ink);
  }
  .hop .p {
    color: var(--sdb-muted);
    font-size: .86rem;
    margin-bottom: 18px;
    line-height: 1.45;
  }
  .hop .nut {
    display: grid;
    gap: 9px;
  }
  .hop .nut button {
    padding: 11px 16px;
    border: 0;
    border-radius: 9px;
    cursor: pointer;
    font-size: .88rem;
    font-weight: 600;
    color: #ffffff;
    font-family: inherit;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: opacity .2s, transform .2s;
  }
  .hop .nut button:hover {
    opacity: .92;
    transform: translateX(2px);
  }
  #hopNutThuTien {
    display: none;
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--sdb-line);
  }
  .hop .nut a.thu-tien {
    padding: 12px 16px;
    border-radius: 9px;
    font-size: .92rem;
    font-weight: 700;
    color: var(--sdb-gold);
    background: var(--sdb-dark);
    text-decoration: none;
    text-align: center;
    display: block;
    box-shadow: 0 4px 12px rgba(36, 26, 20, .25);
    transition: all .2s;
  }
  .hop .nut a.thu-tien:hover {
    background: #3d2b21;
    color: #ffd875;
  }
  .hop .dong {
    margin-top: 14px;
    width: 100%;
    padding: 10px;
    background: #f1ede6;
    color: var(--sdb-ink);
    border: 0;
    border-radius: 9px;
    cursor: pointer;
    font-family: inherit;
    font-size: .88rem;
    font-weight: 600;
    transition: background .2s;
  }
  .hop .dong:hover {
    background: #e4ddd2;
  }

  .sdb-guide-text {
    font-size: .82rem;
    color: var(--sdb-muted);
    margin-top: 10px;
  }
  
  #chuThich .sdb__chuthich {
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    gap: .35rem .25rem;
  }
</style>

<div class="sdb-container">
  <!-- Top Header Bar -->
  <div class="sdb-header-bar">
    <div>
      <h1 class="sdb-title"><i class="fas fa-chair" style="color:var(--sdb-gold); margin-right: .5rem;"></i>Sơ đồ bàn thời gian thực</h1>
      <div class="sdb-subtitle">
        <span class="sdb-cham" id="chamKN"></span>
        <span id="ttKetNoi">Đang kết nối...</span>
        <span style="opacity: .5;">•</span>
        <span><%= tenNguoiDung %></span>
      </div>
    </div>
    <div class="sdb-nav-links">
      <a class="sdb-link-btn" href="/kds"><i class="fas fa-fire-burner" style="color:var(--sdb-gold);"></i>Màn hình bếp</a>
      <a class="sdb-link-btn" href="/analytics"><i class="fas fa-chart-pie" style="color:var(--sdb-gold);"></i>Dashboard</a>
      <a class="sdb-link-btn" href="/staff"><i class="fas fa-id-badge" style="color:var(--sdb-gold);"></i>Trang nhân viên</a>
    </div>
  </div>

  <!-- KPI Grid -->
  <div class="sdb-kpi-grid" id="chiSo"></div>

  <!-- Floor Board Container -->
  <div class="sdb-floor-container">
    <!-- Toolbar -->
    <div class="sdb-toolbar">
      <div class="sdb-tabs" id="tabViTri"></div>
      <div class="sdb-actions">
        <div id="chuThich"></div>
        <% if (choPhepKeoTha) { %>
          <button class="sdb-btn ghost" id="btnSapXep" onclick="batSapXep()"><i class="fas fa-arrows-up-down-left-right"></i>Sắp xếp sơ đồ</button>
          <button class="sdb-btn" id="btnLuu" onclick="luuViTri()" style="display:none"><i class="fas fa-floppy-disk"></i>Lưu vị trí</button>
        <% } %>
      </div>
    </div>

    <!-- Sàn Nhà -->
    <div class="san" id="san"></div>
    <% if (choPhepKeoTha) { %>
      <p class="sdb-guide-text"><i class="fas fa-circle-info" style="color:var(--sdb-gold); margin-right: 4px;"></i>Bấm <b>Sắp xếp sơ đồ</b> để kéo thả bàn về đúng vị trí thực tế trong nhà hàng, sau đó bấm <b>Lưu vị trí</b>.</p>
    <% } %>
  </div>
</div>

<!-- Modal Đổi Trạng Thái Bàn -->
<div class="lop" id="lop">
  <div class="hop">
    <h3 id="hopTieuDe">Bàn</h3>
    <div class="p" id="hopMoTa"></div>
    <div class="nut" id="hopNutThuTien"><a class="thu-tien" id="hopLinkThuTien" href="#"><i class="fas fa-cash-register" style="margin-right: 6px;"></i>Tính tiền bàn này</a></div>
    <div class="nut">
      <button style="background:var(--sdb-trong)"  onclick="doiTrangThai(0)"><span><i class="fas fa-check-circle" style="margin-right: 6px;"></i>Đặt là Trống</span> <i class="fas fa-chevron-right" style="opacity: .6;"></i></button>
      <button style="background:var(--sdb-phucvu)" onclick="doiTrangThai(1)"><span><i class="fas fa-user-group" style="margin-right: 6px;"></i>Đặt là Đang phục vụ</span> <i class="fas fa-chevron-right" style="opacity: .6;"></i></button>
      <button style="background:var(--sdb-dat)"    onclick="doiTrangThai(2)"><span><i class="fas fa-clock" style="margin-right: 6px;"></i>Đặt là Đã đặt trước</span> <i class="fas fa-chevron-right" style="opacity: .6;"></i></button>
      <button style="background:var(--sdb-don)"    onclick="doiTrangThai(3)"><span><i class="fas fa-broom" style="margin-right: 6px;"></i>Đặt là Đang dọn</span> <i class="fas fa-chevron-right" style="opacity: .6;"></i></button>
    </div>
    <button class="dong" onclick="dongHop()">Đóng cửa sổ</button>
  </div>
</div>

<%- include('../partials/so-do-dat-ban') %>

<script>
const $ = (id) => document.getElementById(id);
const tien = (v) => Number(v || 0).toLocaleString('vi-VN');

let duLieu = { ban: [], vi_tri: [], thong_ke: {} };
let viTriDangXem = 'tat_ca';
let dangSapXep = false;
let banDangChon = null;

let doLechKhu = {};
const CAO_TIEU_DE = 38;
const CAO_BAN = 120;
const DEM_KHU = 26;

async function tai() {
  try {
    const r = await fetch('/so-do-ban/api/du-lieu');
    if (!r.ok) throw new Error(r.status);
    duLieu = await r.json();
  } catch (e) {
    console.error('Không tải được sơ đồ:', e);
    return;
  }
  veChiSo();
  veTab();
  veSan();
}

function veChiSo() {
  const t = duLieu.thong_ke || {};
  $('chiSo').innerHTML = `
    <div class="sdb-kpi-card t">
      <div class="sdb-kpi-title">Bàn trống</div>
      <div class="sdb-kpi-val">${t.trong || 0}<span style="font-size:14px;color:var(--sdb-muted);font-weight:500;">/${t.tong || 0}</span></div>
    </div>
    <div class="sdb-kpi-card p">
      <div class="sdb-kpi-title">Đang phục vụ</div>
      <div class="sdb-kpi-val">${t.dang_phuc_vu || 0}</div>
    </div>
    <div class="sdb-kpi-card d">
      <div class="sdb-kpi-title">Đã đặt trước</div>
      <div class="sdb-kpi-val">${t.da_dat || 0}</div>
    </div>
    <div class="sdb-kpi-card gold">
      <div class="sdb-kpi-title">Tỷ lệ lấp đầy</div>
      <div class="sdb-kpi-val">${t.ty_le_lap_day || 0}% <span style="font-size:13px;color:var(--sdb-muted);font-weight:500;">· ${t.so_cho || 0} chỗ</span></div>
    </div>
    <div class="sdb-kpi-card">
      <div class="sdb-kpi-title">Doanh thu đang mở</div>
      <div class="sdb-kpi-val" style="font-size:1.2rem; color:var(--sdb-gold-dark);">${tien(t.doanh_thu_dang_mo)}đ</div>
    </div>
    <div class="sdb-kpi-card">
      <div class="sdb-kpi-title">Doanh thu hôm nay</div>
      <div class="sdb-kpi-val" style="font-size:1.2rem; color:var(--sdb-ink);">${tien(t.doanh_thu_hom_nay)}đ</div>
    </div>`;
}

const tenKhu = (v) => v.Name_vitri || v.name_vitri || 'Khu';

function veTab() {
  const tong = (duLieu.ban || []).length;
  const ds = [{ id_vitri: 'tat_ca', Name_vitri: 'Tất cả', so_ban: tong }, ...(duLieu.vi_tri || [])];
  $('tabViTri').innerHTML = ds.map(v => `
    <button class="sdb-tab-btn ${String(v.id_vitri) === String(viTriDangXem) ? 'on' : ''}"
            onclick="chonViTri('${v.id_vitri}')">${tenKhu(v)}
      <span style="opacity:.7">(${v.so_ban || 0})</span></button>`).join('');
}

function chonViTri(id) { viTriDangXem = id; veTab(); veSan(); }

if (window.SoDoDatBan) {
  SoDoDatBan.chuThich($('chuThich'), [
    ['trong', 'Trống'],
    ['dat', 'Đã đặt trước'],
    ['phucvu', 'Đang phục vụ'],
    ['don', 'Đang dọn'],
    ['baotri', 'Bảo trì'],
  ]);
}

const KIEU_VE = { 0: 'trong', 1: 'phucvu', 2: 'dat', 3: 'don', 4: 'baotri' };

function theBan(b, doLech) {
  const el = document.createElement('div');
  el.className = 'ban' + (dangSapXep ? ' keo' : '');
  el.dataset.id = b.Id_ban;
  el.dataset.khu = b.id_vitri;
  el.style.left = b.toa_do_x + 'px';
  el.style.top = (Number(b.toa_do_y) + doLech) + 'px';
  el.title = `Bàn ${b.number_ban} · ${b.so_cho} chỗ · ${b.ten_trang_thai}`;
  el.onclick = () => moHop(b.Id_ban);

  el.appendChild(SoDoDatBan.veBan(b.so_cho, KIEU_VE[b.trangthai] || 'trong', b.number_ban).svg);

  let ct = '';
  if (b.trangthai === 1 && b.so_mon) {
    ct = `${b.so_mon} món · <b>${tien(b.tong_tien)}đ</b>` + (b.so_khach ? ` · ${b.so_khach} khách` : '');
  } else if (b.trangthai === 2) {
    ct = 'Giữ chỗ';
  } else if (b.trangthai === 4) {
    ct = 'Bảo trì';
  }
  if (ct) {
    const d = document.createElement('div');
    d.className = 'ct';
    d.innerHTML = ct;
    el.appendChild(d);
  }
  return el;
}

function veSan() {
  const tatCa = viTriDangXem === 'tat_ca';
  const khuHienThi = (duLieu.vi_tri || []).filter(
    v => tatCa || String(v.id_vitri) === String(viTriDangXem));

  const manh = document.createDocumentFragment();
  let y = 0;
  doLechKhu = {};

  for (const v of khuHienThi) {
    const ds = (duLieu.ban || []).filter(b => String(b.id_vitri) === String(v.id_vitri));
    const trong = ds.filter(b => b.trangthai === 0).length;
    doLechKhu[v.id_vitri] = y + CAO_TIEU_DE;

    const dai = document.createElement('div');
    dai.className = 'dai-khu';
    dai.style.top = y + 'px';
    dai.textContent = tenKhu(v);
    const dem = document.createElement('span');
    dem.className = 'dem';
    dem.textContent = `${ds.length} bàn · ${v.so_cho || 0} chỗ · ${trong} bàn trống`;
    dai.appendChild(dem);
    manh.appendChild(dai);

    ds.forEach(b => manh.appendChild(theBan(b, y + CAO_TIEU_DE)));

    const day = ds.reduce((m, b) => Math.max(m, Number(b.toa_do_y) + CAO_BAN), CAO_BAN);
    y += CAO_TIEU_DE + day + DEM_KHU;
  }

  const san = $('san');
  san.innerHTML = '';
  if (manh.childNodes.length) san.appendChild(manh);
  else san.innerHTML = '<div style="padding:40px;color:var(--sdb-muted);text-align:center">Khu vực này chưa có bàn nào</div>';
  san.style.height = Math.max(540, y + 10) + 'px';

  if (dangSapXep) ganKeoTha();
}

// --- Kéo thả ---
function batSapXep() {
  dangSapXep = !dangSapXep;
  $('btnSapXep').innerHTML = dangSapXep ? '<i class="fas fa-xmark"></i>Hủy sắp xếp' : '<i class="fas fa-arrows-up-down-left-right"></i>Sắp xếp sơ đồ';
  $('btnLuu').style.display = dangSapXep ? 'inline-flex' : 'none';
  veSan();
}

function ganKeoTha() {
  document.querySelectorAll('.ban').forEach(el => {
    el.onmousedown = (e) => {
      if (!dangSapXep) return;
      e.preventDefault();
      const san = $('san').getBoundingClientRect();
      const the = el.getBoundingClientRect();
      const lechX = e.clientX - the.left;
      const lechY = e.clientY - the.top;
      el.classList.add('dang-keo');

      const dayKhu = doLechKhu[el.dataset.khu] || 0;

      const dichuyen = (ev) => {
        const x = Math.max(0, ev.clientX - san.left - lechX);
        const y = Math.max(dayKhu, ev.clientY - san.top - lechY);
        el.style.left = x + 'px';
        el.style.top = y + 'px';
      };
      const tha = () => {
        el.classList.remove('dang-keo');
        document.removeEventListener('mousemove', dichuyen);
        document.removeEventListener('mouseup', tha);
      };
      document.addEventListener('mousemove', dichuyen);
      document.addEventListener('mouseup', tha);
    };
  });
}

async function luuViTri() {
  const ban = [...document.querySelectorAll('.ban')].map(el => ({
    id: Number(el.dataset.id),
    x: Math.max(0, parseInt(el.style.left) || 0),
    y: Math.max(0, (parseInt(el.style.top) || 0) - (doLechKhu[el.dataset.khu] || 0)),
  }));
  try {
    const r = await fetch('/so-do-ban/api/vi-tri', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ban }),
    });
    const kq = await r.json();
    if (!r.ok) throw new Error(kq.loi || 'Lỗi');
    dangSapXep = false;
    $('btnSapXep').innerHTML = '<i class="fas fa-arrows-up-down-left-right"></i>Sắp xếp sơ đồ';
    $('btnLuu').style.display = 'none';
    await tai();
  } catch (e) {
    alert('Không lưu được vị trí: ' + e.message);
  }
}

// --- Đổi trạng thái ---
function moHop(id) {
  if (dangSapXep) return;
  const b = (duLieu.ban || []).find(x => x.Id_ban === id);
  if (!b) return;
  banDangChon = b;
  $('hopTieuDe').textContent = 'Bàn ' + b.number_ban;
  $('hopMoTa').innerHTML = `Trạng thái hiện tại: <b>${b.ten_trang_thai}</b> &middot; ${b.so_cho} chỗ` +
    (b.so_mon ? `<br>Đang có ${b.so_mon} món, tổng <b>${tien(b.tong_tien)}đ</b>` : '');

  if (b.sesis_hien_tai) {
    $('hopLinkThuTien').href = '/staff/thanh-toan/' + encodeURIComponent(b.sesis_hien_tai);
    $('hopNutThuTien').style.display = 'grid';
  } else {
    $('hopNutThuTien').style.display = 'none';
  }

  $('lop').style.display = 'flex';
}
function dongHop() { $('lop').style.display = 'none'; banDangChon = null; }

async function doiTrangThai(tt) {
  if (!banDangChon) return;
  try {
    const r = await fetch('/so-do-ban/api/trang-thai/' + banDangChon.Id_ban, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ trangthai: tt, sesis: banDangChon.sesis_hien_tai }),
    });
    const kq = await r.json();
    if (!r.ok) throw new Error(kq.loi || 'Lỗi');
    dongHop();
    await tai();
  } catch (e) {
    alert('Không đổi được trạng thái: ' + e.message);
  }
}

$('lop').addEventListener('click', (e) => { if (e.target.id === 'lop') dongHop(); });

// --- Realtime ---
const socket = io();
socket.on('connect', () => {
  socket.emit('join-room', { role: 'Phuc vu' });
  $('ttKetNoi').textContent = 'Đã kết nối thời gian thực';
  $('chamKN').classList.remove('tat');
});
socket.on('disconnect', () => {
  $('ttKetNoi').textContent = 'Mất kết nối - đang thử lại';
  $('chamKN').classList.add('tat');
});
socket.on('ban-cap-nhat', tai);
socket.on('kds-cap-nhat', tai);
socket.on('so-do-thay-doi', tai);

tai();
setInterval(() => { if (!dangSapXep) tai(); }, 20000);
</script>

