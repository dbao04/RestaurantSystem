<%
  var activePage = 'ke-toan-chot-so';
  var vnd = function (n) { return Math.round(Number(n || 0)).toLocaleString('vi-VN') + 'đ'; };
  var dau = function (n) { n = Math.round(Number(n || 0)); return (n > 0 ? '+' : n < 0 ? '−' : '') + Math.abs(n).toLocaleString('vi-VN') + 'đ'; };
  var ngayVN = function (d) { var x = new Date(d); return x.getDate() + '/' + (x.getMonth() + 1) + '/' + x.getFullYear(); };
  var gio = function (d) { if (!d) return ''; var x = new Date(d); return String(x.getHours()).padStart(2, '0') + ':' + String(x.getMinutes()).padStart(2, '0') + ' ' + x.getDate() + '/' + (x.getMonth() + 1); };
  var daChot = !!ds.khoa;
  var coChenh = ds.chenh_ca !== 0 || ds.chenh_doanh_thu !== 0;
  var thangTruoc = new Date(); thangTruoc.setDate(1); thangTruoc.setMonth(thangTruoc.getMonth() - 1);
%>
<%- include('../partials/header') %>

<div class="d-sm-flex align-items-center justify-content-between mb-3">
  <div>
    <h1 class="h3 mb-1 text-gray-800"><i class="fas fa-scale-balanced text-warning"></i> Đối soát doanh thu & chốt sổ</h1>
    <div class="small text-muted">Thu ngân tạo dữ liệu, kế toán đối soát và chốt. Sổ đã chốt không sửa / hủy được phiếu; chỉ Quản lý mở khóa (ghi lý do, lưu nhật ký).</div>
  </div>
  <form class="form-inline" method="GET" style="gap:.4rem">
    <label class="small mb-0" for="ngay">Ngày</label>
    <input type="date" id="ngay" name="ngay" value="<%= ngay %>" max="<%= homNay %>" class="form-control form-control-sm">
    <button class="btn btn-sm btn-primary">Xem</button>
  </form>
</div>

<% if (msg) { %><div class="alert alert-<%= msgType === 'danger' ? 'danger' : msgType === 'warning' ? 'warning' : 'success' %> py-2" role="status"><%= msg %></div><% } %>

<div class="row">
  <div class="col-lg-8">
    <!-- KPI doi soat -->
    <div class="row">
      <div class="col-md-4 mb-3"><div class="card shadow h-100 py-2 border-left-primary"><div class="card-body py-2">
        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Doanh thu POS</div>
        <div class="h5 mb-0 font-weight-bold"><%= vnd(ds.doanh_thu_pos) %></div>
        <div class="small text-muted"><%= ds.so_don %> đơn đã thanh toán ngày <%= ngayVN(ds.ngay) %></div>
      </div></div></div>
      <div class="col-md-4 mb-3"><div class="card shadow h-100 py-2 border-left-success"><div class="card-body py-2">
        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Tiền thực thu</div>
        <div class="h5 mb-0 font-weight-bold"><%= vnd(ds.tong_thuc_thu) %></div>
        <div class="small text-muted">gồm cọc, đã trừ hoàn tiền</div>
      </div></div></div>
      <div class="col-md-4 mb-3"><div class="card shadow h-100 py-2 <%= coChenh ? 'border-left-danger' : 'border-left-secondary' %>"><div class="card-body py-2">
        <div class="text-xs font-weight-bold <%= coChenh ? 'text-danger' : 'text-secondary' %> text-uppercase mb-1">Chênh lệch</div>
        <div class="h6 mb-0">Thu − POS: <b><%= dau(ds.chenh_doanh_thu) %></b></div>
        <div class="h6 mb-0">Két chốt ca: <b><%= dau(ds.chenh_ca) %></b></div>
      </div></div></div>
    </div>

    <div class="card shadow mb-3">
      <div class="card-header py-2"><h6 class="m-0 font-weight-bold text-primary">Theo phương thức thanh toán</h6></div>
      <div class="card-body p-0"><div class="table-responsive"><table class="table table-sm mb-0">
        <thead class="thead-light"><tr><th>Phương thức</th><th class="text-right">Số GD</th><th class="text-right">Thu</th><th class="text-right">Hoàn</th><th class="text-right">Thuần</th><th class="text-right">Tip (giữ hộ)</th></tr></thead>
        <tbody>
          <% ds.theo_phuong_thuc.forEach(function (p) { %>
            <tr><td><%= p.ten %></td><td class="text-right"><%= p.so_gd %></td><td class="text-right"><%= vnd(p.thu) %></td>
              <td class="text-right text-danger"><%= p.hoan ? vnd(p.hoan) : '—' %></td><td class="text-right font-weight-bold"><%= vnd(p.thuan) %></td><td class="text-right text-muted"><%= vnd(p.tip) %></td></tr>
          <% }) %>
          <tr class="font-weight-bold"><td>Tổng</td><td></td><td></td><td></td><td class="text-right"><%= vnd(ds.tong_thuc_thu) %></td><td></td></tr>
        </tbody>
      </table></div></div>
      <div class="card-footer small text-muted">Phiếu thu chi tay trong ngày: thu <%= vnd(ds.phieu.thu) %> · chi <%= vnd(ds.phieu.chi) %>
        <% if (ds.ngan_hang.da_khop || ds.ngan_hang.khong_khop) { %> · Sao kê ngân hàng: <%= ds.ngan_hang.da_khop ? ds.ngan_hang.da_khop.so + ' đã khớp' : '0 đã khớp' %><% if (ds.ngan_hang.khong_khop) { %>, <span class="text-danger"><%= ds.ngan_hang.khong_khop.so %> chưa khớp (<%= vnd(ds.ngan_hang.khong_khop.tien) %>)</span> - <a href="/staff/thanh-toan/doi-soat">đối soát</a><% } %><% } %>
      </div>
    </div>

    <div class="card shadow mb-3">
      <div class="card-header py-2"><h6 class="m-0 font-weight-bold text-primary">Biên bản chốt ca trong ngày (<%= ds.chot_ca.length %>)</h6></div>
      <div class="card-body p-0"><div class="table-responsive"><table class="table table-sm mb-0">
        <thead class="thead-light"><tr><th>Thu ngân</th><th>Ca</th><th class="text-right">Tiền mặt hệ thống</th><th class="text-right">Đếm được</th><th class="text-right">Chênh lệch</th><th>Lý do</th><th>Trạng thái</th></tr></thead>
        <tbody>
          <% if (!ds.chot_ca.length) { %><tr><td colspan="7" class="text-muted small">Không có biên bản chốt ca nào trong ngày.</td></tr><% } %>
          <% ds.chot_ca.forEach(function (c) { %>
            <tr><td><a href="/staff/chot-ca/<%= c.id %>"><%= c.ten_nv %></a></td><td class="small"><%= c.ten_ca || gio(c.shift_start) %></td>
              <td class="text-right"><%= vnd(c.tien_mat_he_thong) %></td><td class="text-right"><%= vnd(c.tien_mat_dem_duoc) %></td>
              <td class="text-right <%= Number(c.chenh_lech) ? 'text-danger font-weight-bold' : '' %>"><%= dau(c.chenh_lech) %></td>
              <td class="small"><%= c.ly_do_chenh_lech || '' %></td>
              <td><%- c.status === 'verified' ? '<span class="badge badge-success">Đã duyệt</span>' : '<span class="badge badge-warning">Chờ duyệt</span>' %></td></tr>
          <% }) %>
        </tbody>
      </table></div></div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow mb-3">
      <div class="card-header py-2"><h6 class="m-0 font-weight-bold <%= daChot ? 'text-success' : 'text-warning' %>"><i class="fas <%= daChot ? 'fa-lock' : 'fa-lock-open' %>"></i> Chốt sổ ngày <%= ngayVN(ds.ngay) %></h6></div>
      <div class="card-body">
        <% if (ds.canh_bao.length) { %>
          <ul class="small pl-3 mb-3 text-danger"><% ds.canh_bao.forEach(function (c) { %><li><%= c %></li><% }) %></ul>
        <% } else { %><p class="small text-success">Không có chênh lệch hay việc tồn đọng.</p><% } %>
        <% if (daChot) { %>
          <p class="small mb-0">Đã chốt (<%= ds.khoa.loai === 'thang' ? 'sổ tháng' : 'sổ ngày' %>) lúc <%= gio(ds.khoa.khoa_luc) %>.<% if (ds.khoa.ly_do_chenh_lech) { %><br>Lý do chênh lệch: <i><%= ds.khoa.ly_do_chenh_lech %></i><% } %></p>
        <% } else if (ds.ngay >= homNay) { %>
          <p class="small text-muted mb-0">Chỉ chốt được ngày đã qua.</p>
        <% } else { %>
          <form method="POST" action="/staff/ke-toan/chot-so/ngay" onsubmit="return confirm('Chốt sổ ngày <%= ngayVN(ds.ngay) %>? Sau khi chốt, phiếu thu chi của ngày này không sửa / hủy được.')">
            <input type="hidden" name="ngay" value="<%= ds.ngay %>">
            <div class="form-group">
              <label class="small font-weight-bold" for="lyDoCl">Lý do chênh lệch <%- coChenh ? '<span class="text-danger">*</span>' : '<span class="text-muted font-weight-normal">(nếu có)</span>' %></label>
              <textarea id="lyDoCl" name="ly_do_chenh_lech" class="form-control form-control-sm" rows="2" <%= coChenh ? 'required minlength=5' : '' %> placeholder="VD: tiền cọc tiệc thu trước, thu ngân thối nhầm 20.000đ"></textarea>
            </div>
            <div class="form-group"><label class="small font-weight-bold" for="ghiChuCs">Ghi chú</label>
              <input id="ghiChuCs" name="ghi_chu" class="form-control form-control-sm" maxlength="500"></div>
            <button class="btn btn-success btn-block"><i class="fas fa-lock"></i> Chốt sổ ngày</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="card shadow mb-3">
      <div class="card-header py-2"><h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-calendar-check"></i> Chốt sổ tháng</h6></div>
      <div class="card-body">
        <form method="POST" action="/staff/ke-toan/chot-so/thang" class="form-inline" style="gap:.4rem" onsubmit="return confirm('Chốt sổ cả tháng? Mọi phiếu thu chi trong tháng sẽ bị khóa.')">
          <select name="thang" class="form-control form-control-sm" aria-label="Tháng">
            <% for (var t = 1; t <= 12; t++) { %><option value="<%= t %>" <%= t === thangTruoc.getMonth() + 1 ? 'selected' : '' %>>Tháng <%= t %></option><% } %>
          </select>
          <input name="nam" type="number" class="form-control form-control-sm" style="width:90px" value="<%= thangTruoc.getFullYear() %>" aria-label="Năm">
          <button class="btn btn-sm btn-outline-success">Chốt tháng</button>
        </form>
        <p class="small text-muted mt-2 mb-0">Chỉ chốt được tháng đã kết thúc và không còn phiếu chi chờ duyệt.</p>
      </div>
    </div>

    <div class="card shadow mb-3">
      <div class="card-header py-2"><h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-clock-rotate-left"></i> Các kỳ đã chốt</h6></div>
      <div class="card-body p-0">
        <% if (!ky.length) { %><p class="small text-muted m-3">Chưa chốt kỳ nào.</p><% } %>
        <ul class="list-group list-group-flush small">
          <% ky.forEach(function (k) { %>
            <li class="list-group-item">
              <b><%= k.loai === 'thang' ? 'Tháng ' + (new Date(k.tu_ngay).getMonth() + 1) + '/' + new Date(k.tu_ngay).getFullYear() : 'Ngày ' + ngayVN(k.tu_ngay) %></b>
              <%- k.trang_thai === 'da_khoa' ? '<span class="badge badge-success">đã chốt</span>' : '<span class="badge badge-secondary">đã mở khóa</span>' %>
              <div class="text-muted">Chốt: <%= k.nguoi_khoa || '—' %> · <%= gio(k.khoa_luc) %><% if (k.trang_thai === 'mo_khoa') { %><br>Mở: <%= k.nguoi_mo || '—' %> · <%= gio(k.mo_khoa_luc) %> - <i><%= k.ly_do_mo %></i><% } %></div>
              <% if (k.trang_thai === 'da_khoa' && laQuanLyMoKhoa) { %>
                <form method="POST" action="/staff/ke-toan/chot-so/<%= k.id %>/mo-khoa" class="d-flex mt-1" style="gap:4px" onsubmit="return confirm('Mở khóa sổ kỳ này? Thao tác được ghi nhật ký.')">
                  <input name="ly_do" class="form-control form-control-sm" placeholder="Lý do mở khóa" required minlength="5" aria-label="Lý do mở khóa">
                  <button class="btn btn-sm btn-outline-danger">Mở khóa</button>
                </form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
