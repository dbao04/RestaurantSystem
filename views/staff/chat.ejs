<%
  var activePage = 'chat';
  var staffName = session.staffName || 'Nhân viên';
  var unreadCount = unread || 0;
%>
<%- include('partials/header') %>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Chat với khách hàng</h1>
</div>

<div class="row" style="height:calc(100vh - 200px);">
  <!-- Danh sách khách -->
  <div class="col-md-4 mb-4">
    <div class="card shadow h-100">
      <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Khách hàng</h6></div>
      <div class="card-body p-0" style="overflow-y:auto;">
        <% if (customers && customers.length > 0) { %>
          <div class="list-group list-group-flush">
            <% customers.forEach(c => { %>
              <a href="/staff/chat/<%= c.id %>" class="list-group-item list-group-item-action <%= selectedId == c.id ? 'active' : '' %>">
                <div class="d-flex align-items-center">
                  <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mr-2" style="width:36px;height:36px;flex-shrink:0">
                    <%= c.ten.charAt(0).toUpperCase() %>
                  </div>
                  <div class="flex-grow-1 overflow-hidden">
                    <div class="d-flex justify-content-between">
                      <strong style="font-size:14px;"><%= c.ten %></strong>
                      <% if (c.unread > 0) { %><span class="badge badge-danger"><%= c.unread %></span><% } %>
                    </div>
                    <small class="text-truncate d-block" style="max-width:180px; color:<%= selectedId == c.id ? 'rgba(255,255,255,.7)' : '#999' %>"><%= c.last_msg || 'Chưa có tin nhắn' %></small>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-center text-muted p-4">Chưa có khách nào nhắn tin.</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Khu vực chat -->
  <div class="col-md-8 mb-4">
    <div class="card shadow h-100 d-flex flex-column">
      <% if (selectedCustomer) { %>
        <div class="card-header py-3 d-flex align-items-center">
          <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mr-2" style="width:36px;height:36px;">
            <%= selectedCustomer.ten.charAt(0).toUpperCase() %>
          </div>
          <div>
            <h6 class="m-0 font-weight-bold"><%= selectedCustomer.ten %></h6>
            <small class="text-muted"><%= selectedCustomer.sodienthoai %></small>
          </div>
        </div>
        <div class="card-body flex-grow-1" id="chat-box" style="overflow-y:auto; background:#f8f9fc; max-height:450px;">
          <% if (messages && messages.length > 0) { %>
            <% messages.forEach(m => { %>
              <% if (m.nguoi_gui === 'khach') { %>
                <div class="d-flex justify-content-start mb-3">
                  <div class="p-2 px-3 rounded" style="background:#fff;border:1px solid #ddd;max-width:75%;">
                    <small class="text-muted d-block"><strong><%= m.ten_kh %></strong></small>
                    <% if (m.duong_dan_file) { %>
                      <% if (m.loai_file === 'image') { %>
                        <div class="my-1">
                          <a href="<%= m.duong_dan_file %>" target="_blank">
                            <img src="<%= m.duong_dan_file %>" alt="<%= m.ten_file || 'Hình ảnh' %>" style="max-width:240px;max-height:220px;border-radius:8px;object-fit:cover;border:1px solid #eee;">
                          </a>
                        </div>
                      <% } else { %>
                        <div class="my-1">
                          <a href="<%= m.duong_dan_file %>" download="<%= m.ten_file || 'tep_dinh_kem' %>" target="_blank" class="d-inline-flex align-items-center p-2 rounded text-decoration-none" style="background:#f1f5f9;border:1px solid #cbd5e1;color:#1e293b;">
                            <i class="fas fa-file-alt mr-2 text-primary"></i>
                            <span style="max-width:190px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;font-weight:600;"><%= m.ten_file || 'Tệp đính kèm' %></span>
                            <i class="fas fa-download ml-2 text-muted" style="font-size:12px;"></i>
                          </a>
                        </div>
                      <% } %>
                    <% } %>
                    <% if (m.noi_dung) { %><div style="white-space:pre-wrap;word-break:break-word;"><%= m.noi_dung %></div><% } %>
                    <small style="color:#999;font-size:11px;"><%= new Date(m.thoigian).toLocaleTimeString('vi-VN') %></small>
                  </div>
                </div>
              <% } else { %>
                <div class="d-flex justify-content-end mb-3">
                  <div class="p-2 px-3 rounded" style="background:#4e342e;color:#fff;max-width:75%;">
                    <% if (m.duong_dan_file) { %>
                      <% if (m.loai_file === 'image') { %>
                        <div class="my-1">
                          <a href="<%= m.duong_dan_file %>" target="_blank">
                            <img src="<%= m.duong_dan_file %>" alt="<%= m.ten_file || 'Hình ảnh' %>" style="max-width:240px;max-height:220px;border-radius:8px;object-fit:cover;border:1px solid rgba(255,255,255,.2);">
                          </a>
                        </div>
                      <% } else { %>
                        <div class="my-1">
                          <a href="<%= m.duong_dan_file %>" download="<%= m.ten_file || 'tep_dinh_kem' %>" target="_blank" class="d-inline-flex align-items-center p-2 rounded text-decoration-none" style="background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);color:#fff;">
                            <i class="fas fa-file-alt mr-2"></i>
                            <span style="max-width:190px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;font-weight:600;"><%= m.ten_file || 'Tệp đính kèm' %></span>
                            <i class="fas fa-download ml-2" style="font-size:12px;"></i>
                          </a>
                        </div>
                      <% } %>
                    <% } %>
                    <% if (m.noi_dung) { %><div style="white-space:pre-wrap;word-break:break-word;"><%= m.noi_dung %></div><% } %>
                    <small style="opacity:.7;font-size:11px;"><%= new Date(m.thoigian).toLocaleTimeString('vi-VN') %></small>
                  </div>
                </div>
              <% } %>
            <% }) %>
          <% } else { %>
            <div class="text-center text-muted mt-5">
              <i class="fas fa-comments fa-3x text-gray-300"></i>
              <p class="mt-2">Hãy bắt đầu cuộc trò chuyện</p>
            </div>
          <% } %>
        </div>
        <div class="card-footer">
          <div id="staff-file-preview" class="align-items-center justify-content-between p-2 mb-2 rounded" style="display:none;background:#fffbeb;border:1px dashed #d97706;">
            <div class="d-flex align-items-center overflow-hidden">
              <i class="fas fa-paperclip text-warning mr-2"></i>
              <span id="staff-file-name" class="text-truncate font-weight-bold" style="max-width:280px;font-size:13px;"></span>
              <small id="staff-file-size" class="text-muted ml-2"></small>
            </div>
            <button type="button" id="staff-file-remove" class="btn btn-sm btn-outline-danger py-0 px-2" title="Gỡ tệp">&times;</button>
          </div>
          <form action="/staff/chat/send" method="POST" enctype="multipart/form-data" class="d-flex align-items-center">
            <input type="hidden" name="id_kh" value="<%= selectedCustomer.id %>">
            <input type="file" id="staff-input-img" accept="image/*" style="display:none">
            <input type="file" id="staff-input-file" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.csv,.zip,.rar,image/*" style="display:none">
            <button type="button" id="staff-btn-img" class="btn btn-outline-secondary mr-1" title="Gửi hình ảnh">
              <i class="fas fa-image"></i>
            </button>
            <button type="button" id="staff-btn-file" class="btn btn-outline-secondary mr-2" title="Đính kèm tệp / tài liệu">
              <i class="fas fa-paperclip"></i>
            </button>
            <input type="text" name="noi_dung" class="form-control mr-2" placeholder="Nhập phản hồi hoặc dán ảnh (Ctrl+V)..." autocomplete="off">
            <button type="submit" class="btn btn-primary px-4">Gửi</button>
          </form>
        </div>
      <% } else { %>
        <div class="card-body d-flex align-items-center justify-content-center">
          <div class="text-center text-muted">
            <i class="fas fa-comments fa-4x text-gray-300"></i>
            <p class="mt-3">Chọn khách hàng để bắt đầu chat</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const selectedCustomerId = '<%= selectedId %>';
  const chatBox = document.getElementById('chat-box');
  const chatForm = document.querySelector('form[action="/staff/chat/send"]');

  // Join room của khách đang chọn
  if (selectedCustomerId && selectedCustomerId !== '0') {
    socket.emit('join-room', selectedCustomerId);
  }

  function scrollToBottom() {
    if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
  }
  scrollToBottom();

  // Xử lý đính kèm ảnh / file và gửi tin nhắn qua AJAX
  let staffSelectedFile = null;
  const staffPreview = document.getElementById('staff-file-preview');
  const staffFileName = document.getElementById('staff-file-name');
  const staffFileSize = document.getElementById('staff-file-size');
  const staffFileRemove = document.getElementById('staff-file-remove');
  const staffInputImg = document.getElementById('staff-input-img');
  const staffInputFile = document.getElementById('staff-input-file');
  const staffBtnImg = document.getElementById('staff-btn-img');
  const staffBtnFile = document.getElementById('staff-btn-file');

  function chonTepNhanVien(file) {
    if (!file) return;
    if (file.size > 15 * 1024 * 1024) {
      alert('Kích thước tệp vượt quá giới hạn 15MB.');
      return;
    }
    staffSelectedFile = file;
    if (staffFileName) staffFileName.textContent = file.name;
    if (staffFileSize) staffFileSize.textContent = '(' + (file.size / 1024).toFixed(1) + ' KB)';
    if (staffPreview) staffPreview.style.display = 'flex';
  }

  function xoaTepNhanVien() {
    staffSelectedFile = null;
    if (staffInputImg) staffInputImg.value = '';
    if (staffInputFile) staffInputFile.value = '';
    if (staffPreview) staffPreview.style.display = 'none';
  }

  if (staffBtnImg && staffInputImg) {
    staffBtnImg.onclick = () => staffInputImg.click();
    staffInputImg.onchange = function() { if (this.files && this.files[0]) chonTepNhanVien(this.files[0]); };
  }
  if (staffBtnFile && staffInputFile) {
    staffBtnFile.onclick = () => staffInputFile.click();
    staffInputFile.onchange = function() { if (this.files && this.files[0]) chonTepNhanVien(this.files[0]); };
  }
  if (staffFileRemove) staffFileRemove.onclick = xoaTepNhanVien;

  if (chatForm) {
    const inputMsg = chatForm.querySelector('input[name="noi_dung"]');
    if (inputMsg) {
      inputMsg.addEventListener('paste', (e) => {
        const items = (e.clipboardData || {}).items;
        if (!items) return;
        for (let i = 0; i < items.length; i++) {
          if (items[i].kind === 'file') {
            const f = items[i].getAsFile();
            if (f) { chonTepNhanVien(f); break; }
          }
        }
      });
    }

    chatForm.onsubmit = async (e) => {
      e.preventDefault();
      const idKh = chatForm.querySelector('input[name="id_kh"]').value;
      const content = inputMsg ? inputMsg.value.trim() : '';
      if (!content && !staffSelectedFile) return;

      try {
        const fd = new FormData();
        fd.append('id_kh', idKh);
        fd.append('noi_dung', content);
        if (staffSelectedFile) fd.append('tep_dinh_kem', staffSelectedFile);

        const response = await fetch('/staff/chat/send', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: fd
        });
        if (response.ok) {
          if (inputMsg) inputMsg.value = '';
          xoaTepNhanVien();
        }
      } catch (err) {
        console.error('Lỗi gửi tin nhắn (Nhân viên):', err);
      }
    };
  }

  function taoThe(the, lop, chu) {
    const e = document.createElement(the);
    if (lop) e.className = lop;
    if (chu !== undefined) e.textContent = chu;
    return e;
  }

  socket.on('new-message', (data) => {
    if (!chatBox) return;

    const isMe = data.nguoi_gui === 'nhanvien';
    const gio = new Date(data.thoigian || Date.now());

    const dong = taoThe('div', 'd-flex mb-3 ' + (isMe ? 'justify-content-end' : 'justify-content-start'));
    const bong = taoThe('div', 'p-2 px-3 rounded');
    bong.style.cssText = isMe
      ? 'background:#4e342e;color:#fff;max-width:75%;'
      : 'background:#fff;border:1px solid #ddd;max-width:75%;';

    if (!isMe) {
      const nhan = taoThe('small', 'text-muted d-block');
      nhan.appendChild(taoThe('strong', null, data.ten_kh || 'Khách hàng'));
      bong.appendChild(nhan);
    }

    if (data.duong_dan_file) {
      const wrap = taoThe('div', 'my-1');
      if (data.loai_file === 'image') {
        const a = taoThe('a');
        a.href = data.duong_dan_file;
        a.target = '_blank';
        const img = taoThe('img');
        img.src = data.duong_dan_file;
        img.alt = data.ten_file || 'Hình ảnh';
        img.style.cssText = 'max-width:240px;max-height:220px;border-radius:8px;object-fit:cover;border:1px solid rgba(0,0,0,.1);';
        a.appendChild(img);
        wrap.appendChild(a);
      } else {
        const a = taoThe('a', 'd-inline-flex align-items-center p-2 rounded text-decoration-none');
        a.href = data.duong_dan_file;
        a.target = '_blank';
        a.setAttribute('download', data.ten_file || 'tep_dinh_kem');
        a.style.cssText = isMe
          ? 'background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);color:#fff;'
          : 'background:#f1f5f9;border:1px solid #cbd5e1;color:#1e293b;';
        const ic = taoThe('i', 'fas fa-file-alt mr-2');
        a.appendChild(ic);
        const sp = taoThe('span', null, data.ten_file || 'Tệp đính kèm');
        sp.style.cssText = 'max-width:190px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;font-weight:600;';
        a.appendChild(sp);
        const dl = taoThe('i', 'fas fa-download ml-2');
        dl.style.fontSize = '12px';
        a.appendChild(dl);
        wrap.appendChild(a);
      }
      bong.appendChild(wrap);
    }

    if (data.noi_dung) {
      const dNoiDung = taoThe('div', null, data.noi_dung);
      dNoiDung.style.cssText = 'white-space:pre-wrap;word-break:break-word;';
      bong.appendChild(dNoiDung);
    }

    const nhanGio = taoThe('small', null, gio.toLocaleTimeString('vi-VN'));
    nhanGio.style.cssText = isMe ? 'opacity:.7;font-size:11px;' : 'color:#999;font-size:11px;';
    bong.appendChild(nhanGio);

    dong.appendChild(bong);

    // Xoa trang thai rong neu con
    const rong = chatBox.querySelector('.text-center.text-muted');
    if (rong) rong.remove();

    chatBox.appendChild(dong);
    scrollToBottom();
  });
</script>

<%- include('partials/footer') %>
