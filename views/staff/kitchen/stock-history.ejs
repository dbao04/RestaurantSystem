<%
  var activePage = 'inventory';
  var staffName = session.staffName || 'Bếp trưởng';

  /* Ban du phong khi server chua nap lai server.js - xem chu thich
     cung loai o views/staff/kitchen/inventory.ejs. */
  var slKho = (typeof soLuongKho === 'function')
    ? soLuongKho
    : function (v) { return String(v == null ? 0 : v); };
%>
<%- include('../partials/header') %>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-history mr-2"></i> Lịch sử Nhập kho</h1>
    <a href="/staff/kitchen/inventory" class="btn btn-sm btn-secondary shadow-sm"><i class="fas fa-arrow-left fa-sm"></i> Quay lại</a>
</div>

<div class="card shadow mb-4 border-left-success">
    <div class="card-body">
        <div class="d-flex align-items-center flex-wrap mb-3"><div class="input-group input-group-sm" style="max-width:340px"><div class="input-group-prepend"><span class="input-group-text bg-white"><i class="fas fa-search"></i></span></div><input type="search" class="form-control" data-tim-kiem="#bangLichSuNhap" data-tim-dem="#demLichSu" placeholder="Tìm nguyên liệu, ngày nhập..." aria-label="Tìm nguyên liệu, ngày nhập..."></div><small class="text-muted ml-2" id="demLichSu"></small>
            <a href="/staff/kitchen/kho" class="btn btn-sm btn-outline-primary ml-auto"><i class="fas fa-book"></i> Sổ xuất nhập kho (theo phiếu)</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-striped" id="bangLichSuNhap" width="100%" cellspacing="0">
                <thead class="bg-light">
                    <tr>
                        <th>Ngày nhập</th>
                        <th>Nguyên liệu</th>
                        <th>Số lượng</th>
                        <th>Đơn vị</th>
                        <th>Giá nhập</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    <% history.forEach(h => { %>
                    <tr>
                        <td><%= new Date(h.ngay_nhap).toLocaleString('vi-VN') %></td>
                        <td class="font-weight-bold"><%= h.ten_nl %></td>
                        <td class="text-success">+<%= slKho(h.so_luong, h.ten_dvt) %></td>
                        <td><%= h.ten_dvt %></td>
                        <td><%= formatMoney(h.gia_nhap) %></td>
                        <td class="font-weight-bold"><%= formatMoney(h.gia_nhap * h.so_luong) %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
