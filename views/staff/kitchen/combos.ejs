<%
  var activePage = 'kitchen-menu';
  var staffName = session.staffName || 'Bếp trưởng';
%>
<%- include('../partials/header') %>

<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="h3 mb-0 text-gray-800">Quản lý Combo món ăn</h1>
    </div>
    <div class="col-md-4 text-right">
        <button class="btn btn-primary" data-toggle="modal" data-target="#addComboModal"><i class="fas fa-plus mr-1"></i> Tạo Combo mới</button>
    </div>
</div>

<div class="row">
    <% combos.forEach(c => { %>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow h-100 py-2 border-left-info">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1"><%= c.ten_combo %></div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= formatMoney(c.gia_combo) %></div>
                            <p class="mt-2 text-muted small"><%= c.mo_ta %></p>
                            <span class="badge badge-<%= c.trang_thai == 1 ? 'success' : 'secondary' %>">
                                <%= c.trang_thai == 1 ? 'Đang bán' : 'Tạm dừng' %>
                            </span>
                        </div>
                        <div class="col-auto">
                            <% if(c.hinh_anh) { %>
                                <img src="/food/<%= c.hinh_anh %>" height="60px" style="border-radius:5px;" />
                            <% } else { %>
                                <i class="fas fa-gift fa-2x text-gray-300"></i>
                            <% } %>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                    <button class="btn btn-sm btn-outline-primary" data-toggle="modal" data-target="#editComboModal<%= c.id_combo %>">
                        <i class="fas fa-edit mr-1"></i> Sửa
                    </button>
                    <a href="/staff/kitchen/combo/delete/<%= c.id_combo %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xác nhận xóa combo này?')">
                        <i class="fas fa-trash mr-1"></i> Xóa
                    </a>
                </div>
            </div>
        </div>

        <!-- Edit Combo Modal -->
        <div class="modal fade" id="editComboModal<%= c.id_combo %>" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/staff/kitchen/combo/edit/<%= c.id_combo %>" method="POST" enctype="multipart/form-data">
                        <div class="modal-header">
                            <h5 class="modal-title">Sửa Combo: <%= c.ten_combo %></h5>
                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                        </div>
                        <div class="modal-body">
                            <div class="form-group"><label>Tên Combo</label><input type="text" name="ten_combo" class="form-control" value="<%= c.ten_combo %>" required></div>
                            <div class="form-group"><label>Giá (VNĐ)</label><input type="number" name="gia_combo" class="form-control" value="<%= c.gia_combo %>" required></div>
                            <div class="form-group"><label>Mô tả</label><textarea name="mo_ta" class="form-control" rows="3"><%= c.mo_ta %></textarea></div>
                            <div class="form-group"><label>Hình ảnh (Để trống nếu giữ cũ)</label><input type="file" name="hinh_anh" class="form-control-file"></div>
                            <div class="form-group">
                                <label>Trạng thái</label>
                                <select name="trang_thai" class="form-control">
                                    <option value="1" <%= c.trang_thai == 1 ? 'selected' : '' %>>Đang bán</option>
                                    <option value="0" <%= c.trang_thai == 0 ? 'selected' : '' %>>Tạm dừng</option>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<!-- Add Combo Modal -->
<div class="modal fade" id="addComboModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/staff/kitchen/combo/add" method="POST" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Tạo Combo mới</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group"><label>Tên Combo</label><input type="text" name="ten_combo" class="form-control" placeholder="Ví dụ: Combo Gia đình" required></div>
                    <div class="form-group"><label>Giá (VNĐ)</label><input type="number" name="gia_combo" class="form-control" placeholder="150000" required></div>
                    <div class="form-group"><label>Mô tả</label><textarea name="mo_ta" class="form-control" rows="3" placeholder="Chi tiết món trong combo..."></textarea></div>
                    <div class="form-group"><label>Hình ảnh</label><input type="file" name="hinh_anh" class="form-control-file"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Tạo ngay</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
