<%
  var activePage = 'kitchen-shift';
  var staffName = session.staffName || 'Bếp trưởng';
%>
<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-6 text-center mb-4">
        <h1 class="h3 mb-2 text-gray-800"><i class="fas fa-stopwatch mr-2"></i> Chốt ca Bếp</h1>
        <p class="text-muted">Nhân viên bếp thực hiện chốt ca làm việc và bàn giao kho.</p>
    </div>
</div>

<% if (msg) { %>
<div class="alert alert-<%= msgType === 'success' ? 'success' : 'danger' %> alert-dismissible fade show shadow-sm" role="alert">
    <i class="fas fa-<%= msgType === 'success' ? 'check-circle' : 'exclamation-circle' %> mr-2"></i>
    <%= msg %>
    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
</div>
<% } %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-primary text-white text-center">
                <h6 class="m-0 font-weight-bold">Báo cáo chốt ca (Bếp)</h6>
            </div>
            <div class="card-body">
                <form action="/staff/kitchen/shift/close" method="POST">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Nhân viên chốt</label>
                                <input type="text" class="form-control" value="<%= staffName %>" readonly />
                                <input type="hidden" name="id_nv" value="<%= session.staffId %>" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Ngày chốt ca <span class="text-danger">*</span></label>
                                <input type="date" name="ngay" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Ca làm việc <span class="text-danger">*</span></label>
                                <select name="ca" class="form-control" required>
                                    <option value="Sáng">Sáng (7h - 12h)</option>
                                    <option value="Chiều">Chiều (12h - 17h)</option>
                                    <option value="Tối">Tối (17h - 22h)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Tổng tiền thu trong ca (VNĐ)</label>
                                <input type="number" name="tong_tien" class="form-control" placeholder="0" min="0" value="0" />
                            </div>
                        </div>
                    </div>

                    <hr>

                    <div class="form-group">
                        <label class="font-weight-bold text-danger"><i class="fas fa-exclamation-triangle mr-1"></i> Ghi chú bàn giao & Sự cố</label>
                        <textarea name="ghi_chu" class="form-control" rows="4" placeholder="Ghi chú về tình hình kho, thiết bị hoặc các sự cố phát sinh trong ca làm việc..."></textarea>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Xác nhận tình trạng kho</label>
                        <div class="custom-control custom-checkbox ml-2">
                            <input type="checkbox" class="custom-control-input" id="checkStock" required>
                            <label class="custom-control-label" for="checkStock">Tôi đã kiểm tra và đảm bảo số lượng tồn kho thực tế khớp với hệ thống.</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block btn-lg shadow-sm mt-4">
                        <i class="fas fa-check-circle mr-2"></i>Hoàn tất Chốt ca & Bàn giao
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Lịch sử chốt ca -->
<div class="row">
    <div class="col-md-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-history mr-2"></i>Lịch sử Chốt ca (Bếp)</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-sm">
                        <thead class="bg-light">
                            <tr>
                                <th>Ngày</th>
                                <th>Ca</th>
                                <th>Nhân viên</th>
                                <th>Tổng tiền</th>
                                <th>Ghi chú</th>
                                <th>Thời gian chốt</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (history && history.length > 0) { %>
                                <% history.forEach(h => { %>
                                <tr>
                                    <td><%= h.ngay ? new Date(h.ngay).toLocaleDateString('vi-VN') : '-' %></td>
                                    <td><span class="badge badge-info"><%= h.ca %></span></td>
                                    <td><%= h.ten_nv || '-' %></td>
                                    <td class="text-success font-weight-bold"><%= formatMoney(h.tong_tien) %></td>
                                    <td><%= h.ghi_chu || '-' %></td>
                                    <td><%= h.created_at ? new Date(h.created_at).toLocaleString('vi-VN') : '-' %></td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="6" class="text-center py-3 text-muted">Chưa có lịch sử chốt ca bếp.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
