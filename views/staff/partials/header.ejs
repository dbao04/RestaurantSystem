<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Nhân viên - Nhà Hàng Bảo Đoàn</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/startbootstrap-sb-admin-2/4.1.4/css/sb-admin-2.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/admin/quantri.css">
  <style>
    /* Đồng bộ tuyệt đối Staff Sidebar với Admin Sidebar */
    .sidebar,
    .sidebar.toggled,
    #accordionSidebar {
      background: linear-gradient(180deg, #241a14 0%, #1c130e 100%) !important;
      min-height: 100vh;
      width: 262px !important;
      min-width: 262px !important;
      max-width: 262px !important;
      flex: 0 0 262px !important;
      box-sizing: border-box !important;
      border-right: 1px solid rgba(200, 162, 75, .16) !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    #wrapper {
      display: flex;
      width: 100%;
      align-items: stretch;
    }
    #content-wrapper {
      flex: 1 1 auto;
      width: calc(100% - 262px);
      min-width: 0;
      background: var(--qt-cream) !important;
      min-height: 100vh;
    }
    @media (min-width: 768px) {
      .sidebar {
        width: 262px !important;
        min-width: 262px !important;
        max-width: 262px !important;
        flex: 0 0 262px !important;
      }
    }
    .qt-side__scroll {
      flex: 1;
      overflow-y: auto;
      padding: 1rem .75rem 2rem !important;
    }
    .sidebar .qt-side__group {
      margin-bottom: 1.35rem !important;
      list-style: none !important;
      padding: 0 !important;
    }
    .sidebar .qt-side__label {
      font-size: .64rem !important;
      letter-spacing: 1.8px !important;
      text-transform: uppercase !important;
      color: rgba(233, 224, 211, .45) !important;
      padding: 0 .85rem !important;
      margin-bottom: .5rem !important;
      font-family: var(--qt-sans) !important;
      font-weight: 700 !important;
    }
    .sidebar .qt-nav__item {
      display: flex !important;
      align-items: center !important;
      gap: .75rem !important;
      padding: .6rem .85rem !important;
      border-radius: 10px !important;
      color: #d8cdbe !important;
      font-size: .875rem !important;
      font-weight: 500 !important;
      text-decoration: none !important;
      transition: background .2s cubic-bezier(.22, .61, .36, 1), color .2s cubic-bezier(.22, .61, .36, 1) !important;
      position: relative !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    .sidebar .qt-nav__item i {
      width: 18px !important;
      text-align: center !important;
      font-size: .95rem !important;
      color: rgba(200, 162, 75, .7) !important;
      transition: color .2s !important;
      flex: none !important;
    }
    .sidebar .qt-nav__item span {
      font-family: var(--qt-sans) !important;
      font-size: .875rem !important;
      font-weight: 500 !important;
      color: inherit !important;
      display: inline !important;
    }
    .sidebar .qt-nav__item:hover {
      background: rgba(255, 255, 255, .06) !important;
      color: #fff !important;
    }
    .sidebar .qt-nav__item:hover i {
      color: #c8a24b !important;
    }
    .sidebar .qt-nav__item.active,
    .sidebar .qt-nav__item.is-active {
      background: linear-gradient(90deg, rgba(200, 162, 75, .22), rgba(200, 162, 75, .04)) !important;
      color: #fff !important;
      font-weight: 600 !important;
    }
    .sidebar .qt-nav__item.active span,
    .sidebar .qt-nav__item.is-active span {
      font-weight: 600 !important;
      color: #fff !important;
    }
    .sidebar .qt-nav__item.active i,
    .sidebar .qt-nav__item.is-active i {
      color: #c8a24b !important;
    }
    .sidebar .qt-nav__item.active::before,
    .sidebar .qt-nav__item.is-active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 20%;
      bottom: 20%;
      width: 3px;
      border-radius: 0 3px 3px 0;
      background: #c8a24b !important;
    }
    .sidebar-divider { display: none !important; }
    .sidebar .sidebar-heading {
      font-family: var(--qt-sans) !important;
      font-size: .64rem !important;
      letter-spacing: 1.8px !important;
      text-transform: uppercase !important;
      color: rgba(233, 224, 211, .45) !important;
      padding: 0 .85rem !important;
      margin-top: 1.35rem !important;
      margin-bottom: .5rem !important;
      font-weight: 700 !important;
      line-height: 1.4 !important;
    }
    .sidebar .nav-item {
      margin: 0 !important;
      padding: 0 .75rem !important;
      width: 100% !important;
      list-style: none !important;
    }
    .sidebar .nav-item .nav-link { 
      color: #d8cdbe !important; 
      font-family: var(--qt-sans) !important;
      font-size: .875rem !important;
      font-weight: 500 !important;
      line-height: 1.5 !important;
      padding: .6rem .85rem !important;
      border-radius: 10px !important;
      display: flex !important;
      align-items: center !important;
      gap: .75rem !important;
      width: 100% !important;
      transition: background .2s cubic-bezier(.22, .61, .36, 1), color .2s cubic-bezier(.22, .61, .36, 1) !important;
    }
    .sidebar .nav-item .nav-link span {
      font-family: var(--qt-sans) !important;
      font-size: .875rem !important;
      font-weight: 500 !important;
      color: inherit !important;
      display: inline !important;
      line-height: 1.5 !important;
    }
    .sidebar .nav-item .nav-link i {
      width: 18px !important;
      text-align: center !important;
      font-size: .95rem !important;
      color: rgba(200, 162, 75, .7) !important;
      transition: color .2s !important;
      margin-right: 0 !important;
      flex: none !important;
    }
    .sidebar .nav-item .nav-link:hover { 
      background: rgba(255, 255, 255, .06) !important; 
      color: #ffffff !important; 
    }
    .sidebar .nav-item .nav-link:hover i {
      color: #c8a24b !important;
    }
    .sidebar .nav-item.active .nav-link { 
      background: linear-gradient(90deg, rgba(200, 162, 75, .22), rgba(200, 162, 75, .04)) !important; 
      color: #ffffff !important; 
      font-weight: 600 !important;
      position: relative !important;
    }
    .sidebar .nav-item.active .nav-link span {
      font-weight: 600 !important;
      color: #ffffff !important;
    }
    .sidebar .nav-item.active .nav-link i {
      color: #c8a24b !important;
    }
    .sidebar .nav-item.active .nav-link::before {
      content: '';
      position: absolute; left: 0; top: 20%; bottom: 20%;
      width: 3px; border-radius: 0 3px 3px 0;
      background: #c8a24b !important;
    }
    .sidebar-divider {
      display: none !important;
    }
    .badge-unread { background:#b3352c; color:#fff; border-radius:50%; padding:2px 6px; font-size:11px; }
    .staff-avatar { width:38px; height:38px; border-radius:10px; background:linear-gradient(135deg, #c8a24b, #a8822f); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:bold; font-size:16px; box-shadow: 0 4px 10px rgba(200, 162, 75, .3); }
    .card { border:1px solid #e7ded0; border-radius: 14px; box-shadow: 0 6px 18px -12px rgba(36, 26, 20, .45); }

    /* Đồng bộ giao diện tổng thể theo Admin Theme */
    #content-wrapper {
      background: var(--qt-cream) !important;
      min-height: 100vh;
    }
    #content {
      background: var(--qt-cream) !important;
    }
    .container-fluid {
      padding: 1.75rem !important;
      max-width: 1560px;
    }
    h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
      font-family: var(--qt-serif) !important;
      font-weight: 700 !important;
      color: #241d18 !important;
    }

    /* Topbar styling chuẩn Admin */
    .topbar {
      height: 68px !important;
      background: rgba(247, 243, 236, .88) !important;
      backdrop-filter: blur(10px) !important;
      border-bottom: 1px solid #e7ded0 !important;
      padding: 0 1.75rem !important;
    }
    .topbar .navbar-nav {
      gap: .6rem;
    }

    /* Khối thẻ card chuẩn Admin */
    .card {
      background: #ffffff !important;
      border: 1px solid #e7ded0 !important;
      border-radius: 14px !important;
      box-shadow: 0 18px 40px -24px rgba(36, 26, 20, .5) !important;
      overflow: hidden;
      margin-bottom: 1.5rem !important;
    }
    .card-header {
      background: linear-gradient(180deg, #fffdf9, #fbf7f0) !important;
      border-bottom: 1px solid #f0e9dd !important;
      padding: 1.1rem 1.4rem !important;
    }
    .card-header h6, .card-header .h6 {
      font-family: var(--qt-serif) !important;
      font-size: 1.12rem !important;
      font-weight: 700 !important;
      color: #241d18 !important;
      margin: 0 !important;
    }
    .card-body {
      padding: 1.4rem !important;
    }

    /* Form inputs & buttons chuẩn Admin */
    .form-control {
      height: auto !important;
      min-height: 40px;
      border: 1px solid #e7ded0 !important;
      border-radius: 9px !important;
      padding: .5rem .85rem !important;
      font-size: .88rem !important;
      line-height: 1.5 !important;
      color: #241d18 !important;
      background-color: #ffffff !important;
      transition: border-color .2s, box-shadow .2s;
    }
    .form-control-sm {
      min-height: 36px !important;
      padding: .35rem .75rem !important;
      font-size: .84rem !important;
      border-radius: 8px !important;
    }
    select.form-control,
    select.form-control-sm {
      height: auto !important;
      padding-top: .4rem !important;
      padding-bottom: .4rem !important;
      line-height: 1.5 !important;
    }
    .form-control:focus {
      border-color: #c8a24b !important;
      box-shadow: 0 0 0 3px rgba(200, 162, 75, .18) !important;
    }
    .btn-primary {
      background: #241a14 !important;
      border-color: #241a14 !important;
      color: #c8a24b !important;
      border-radius: 9px !important;
      font-weight: 600 !important;
      padding: .55rem 1.25rem !important;
      transition: all .2s !important;
    }
    .btn-primary:hover {
      background: #3d2b21 !important;
      border-color: #3d2b21 !important;
      color: #e0c684 !important;
      box-shadow: 0 6px 16px -6px rgba(36, 26, 20, .6) !important;
    }
    .btn-warning {
      background: #c8a24b !important;
      border-color: #c8a24b !important;
      color: #241a14 !important;
      border-radius: 9px !important;
      font-weight: 700 !important;
    }
    .btn-warning:hover {
      background: #a8822f !important;
      border-color: #a8822f !important;
      color: #fff !important;
    }
    .btn-success {
      background: #2e7d4f !important;
      border-color: #2e7d4f !important;
      border-radius: 9px !important;
    }
    .btn-danger {
      background: #b3352c !important;
      border-color: #b3352c !important;
      border-radius: 9px !important;
    }
    .btn-outline-primary {
      color: #241a14 !important;
      border-color: #e7ded0 !important;
      background: #fff !important;
      border-radius: 9px !important;
      font-weight: 500 !important;
    }
    .btn-outline-primary:hover {
      background: #fbf7f0 !important;
      border-color: #c8a24b !important;
      color: #a8822f !important;
    }

    /* Profile Chip ở Topbar */
    .qt-chip {
      display: inline-flex; align-items: center; gap: .6rem;
      padding: .4rem .85rem .4rem .4rem;
      background: #fff;
      border: 1px solid #e7ded0;
      border-radius: 999px;
      box-shadow: 0 6px 18px -12px rgba(36, 26, 20, .45);
    }
    .qt-chip__ava {
      width: 30px; height: 30px; border-radius: 50%;
      display: grid; place-items: center;
      background: linear-gradient(135deg, #3d2b21, #241a14);
      color: #c8a24b;
      font-weight: 600; font-size: .8rem;
    }
    .qt-chip__name { font-weight: 600; font-size: .82rem; color: #241d18; }
    .qt-chip__sub { font-size: .68rem; color: #6b5f54; }

    .qt-icon-btn {
      width: 38px; height: 38px;
      display: grid; place-items: center;
      border: 1px solid #e7ded0;
      border-radius: 10px;
      background: #fff;
      color: #6b5f54;
      transition: all .2s;
    }
    .qt-icon-btn:hover { color: #b3352c; border-color: rgba(179, 53, 44, .35); }

    .sb-che { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1040; display: none; }

    @media (max-width: 767.98px) {
      .sidebar, .sidebar.toggled {
        position: fixed; top: 0; left: 0; bottom: 0; z-index: 1045;
        width: 15rem !important; min-height: 100vh;
        transform: translateX(-100%); transition: transform .25s ease;
        overflow-y: auto; -webkit-overflow-scrolling: touch;
      }
      body.sb-mo .sidebar, body.sb-mo .sidebar.toggled { transform: none; }
      .sidebar .nav-item .nav-link span,
      .sidebar.toggled .nav-item .nav-link span { display: inline !important; font-size: 14px; }
      .sidebar .nav-item .nav-link,
      .sidebar.toggled .nav-item .nav-link {
        display: flex; align-items: center; gap: .7rem;
        padding: .7rem 1rem !important; min-height: 44px; text-align: left; width: 100%;
      }
      .sidebar .nav-item .nav-link i { width: 20px; text-align: center; }
      .sidebar .sidebar-heading, .sidebar.toggled .sidebar-heading {
        display: block !important; text-align: left !important; }
      .sidebar-brand { height: auto !important; padding: 1rem !important; }
      #content-wrapper { width: 100%; margin-left: 0 !important; }
      body.sb-mo .sb-che { display: block; }
      body.sb-mo { overflow: hidden; }
    }
  </style>
</head>
<body id="page-top">

<!--
  Socket.io + thu vien RT phai nap O DAY, truoc noi dung trang.

  Truoc day hai the nay nam trong footer.ejs - tuc la SAU cac khoi <script> cua
  tung trang. Nhung trang goi RT ngay dau khoi (vi du `var E = RT.escapeHtml`
  o /to-chuc/khuon-mat va /dieu-hanh) nem ReferenceError va CHET CA KHOI: bang
  danh sach khong ve, dong bo thoi gian thuc khong chay. Chinh comment dau file
  realtime-to-chuc.js cung ghi "nap mot lan trong header.ejs" - o day moi dung.

  Dat sau <body> chu khong trong <head> vi thu vien co dung document.body.
-->
<script src="/socket.io/socket.io.js"></script>
<script src="/realtime-to-chuc.js"></script>

<div id="wrapper">
  <!-- Sidebar -->
  <aside class="navbar-nav sidebar sidebar-dark accordion" id="accordionSidebar" style="padding:0; box-shadow:none; position:relative !important;">
    <div class="qt-side__brand">
      <span class="qt-side__mark">
        <img src="/logo.svg" alt="Logo" width="32" height="32" style="filter: brightness(0) invert(1) sepia(1) saturate(5) hue-rotate(10deg);">
      </span>
      <span>
        <span class="qt-side__name">Nhà Hàng Bảo Đoàn</span>
        <span class="qt-side__role">Khu vực nhân sự</span>
      </span>
    </div>

    <nav class="qt-side__scroll" id="qtNav" style="width:100%;">
      <div class="qt-side__group">
        <div class="qt-side__label">Chung</div>
        <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='dashboard' ? 'active' : '' %>" href="/staff" data-match="/staff"><i class="fas fa-gauge-high"></i><span>Tổng quan</span></a>
      </div>

      <% if (typeof dongVaiDuoc === 'function' && dongVaiDuoc(['Bep', 'Quan ly'])) { %>
        <div class="qt-side__group">
          <div class="qt-side__label">Khu vực Bếp</div>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='kds' ? 'active' : '' %>" href="/kds" data-match="/kds"><i class="fas fa-fire-burner"></i><span>Màn hình Bếp (KDS)</span></a>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='recipes' ? 'active' : '' %>" href="/staff/kitchen/recipes" data-match="/staff/kitchen/recipes"><i class="fas fa-scroll"></i><span>Công thức món ăn</span></a>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='inventory' ? 'active' : '' %>" href="/staff/kitchen/inventory" data-match="/staff/kitchen/inventory"><i class="fas fa-boxes-stacked"></i><span>Tồn kho nguyên liệu</span></a>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='kitchen-shift' ? 'active' : '' %>" href="/staff/kitchen/shift" data-match="/staff/kitchen/shift"><i class="fas fa-stopwatch"></i><span>Chốt ca Bếp</span></a>
        </div>
      <% } %>

      <% if (typeof dongVaiDuoc === 'function' && dongVaiDuoc(['Phuc vu', 'letan', 'Quay', 'Quan ly'])) { %>
        <div class="qt-side__group">
          <div class="qt-side__label">Phục vụ &amp; Sảnh</div>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='sodoban' ? 'active' : '' %>" href="/so-do-ban" data-match="/so-do-ban"><i class="fas fa-chair"></i><span>Sơ đồ bàn &amp; Gọi món</span></a>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='reservations' ? 'active' : '' %>" href="/staff/dat-ban" data-match="/staff/dat-ban"><i class="fas fa-calendar-check"></i><span>Quản lý Đặt bàn</span></a>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && (activePage==='kitchen' || activePage==='kds') ? 'active' : '' %>" href="/kds" data-match="/kds,/staff/kitchen"><i class="fas fa-bell-concierge"></i><span>Theo dõi món ra (KDS)</span></a>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='qr-codes' ? 'active' : '' %>" href="/staff/qr-codes" data-match="/staff/qr-codes"><i class="fas fa-qrcode"></i><span>Mã QR bàn</span></a>
        </div>
      <% } %>

      <% if (typeof dongVaiDuoc === 'function' && dongVaiDuoc(['Thu ngan', 'Ke toan', 'Quan ly'])) { %>
        <div class="qt-side__group">
          <div class="qt-side__label">Thu ngân &amp; Kế toán</div>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='thanh-toan' ? 'active' : '' %>" href="/staff/thanh-toan" data-match="/staff/thanh-toan"><i class="fas fa-cash-register"></i><span>Thu ngân POS</span></a>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='chot-ca' ? 'active' : '' %>" href="/staff/chot-ca" data-match="/staff/chot-ca"><i class="fas fa-vault"></i><span>Chốt ca thu ngân</span></a>
          <% if (typeof dongVaiDuoc === 'function' && dongVaiDuoc(['Ke toan', 'Quan ly'])) { %>
            <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='salary' ? 'active' : '' %>" href="/staff/accountant/salary" data-match="/staff/accountant/salary"><i class="fas fa-money-check-dollar"></i><span>Bảng lương</span></a>
            <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='reports' ? 'active' : '' %>" href="/staff/accountant/reports" data-match="/staff/accountant/reports"><i class="fas fa-chart-line"></i><span>Báo cáo Thu chi</span></a>
          <% } %>
        </div>
      <% } %>

      <% if (typeof coQuyen === 'function' && coQuyen('giao_hang.xem')) { %>
        <div class="qt-side__group">
          <div class="qt-side__label">Giao hàng</div>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='giao-hang' ? 'active' : '' %>" href="/staff/giao-hang" data-match="/staff/giao-hang"><i class="fas fa-truck-fast"></i><span>Điều phối giao hàng</span></a>
          <a class="qt-nav__item" href="/staff/giao-hang/ban-do" data-match="/staff/giao-hang/ban-do"><i class="fas fa-map-location-dot"></i><span>Bản đồ Shipper</span></a>
        </div>
      <% } %>

      <% if (typeof tuCapBac === 'function' && tuCapBac(2)) { %>
        <div class="qt-side__group">
          <div class="qt-side__label">Điều hành &amp; Quản lý</div>
          <a class="qt-nav__item <%= typeof activePage !== 'undefined' && activePage==='dieu-hanh' ? 'active' : '' %>" href="/staff/dieu-hanh" data-match="/staff/dieu-hanh,/dieu-hanh"><i class="fas fa-satellite-dish"></i><span>Bảng điều hành</span></a>
          <a class="qt-nav__item" href="/staff/analytics" data-match="/staff/analytics,/analytics"><i class="fas fa-chart-pie"></i><span>Dashboard Phân tích</span></a>
          <a class="qt-nav__item" href="/staff/du-bao" data-match="/staff/du-bao,/du-bao"><i class="fas fa-wand-magic-sparkles"></i><span>Dự báo AI</span></a>
          <a class="qt-nav__item" href="/staff/xep-ca" data-match="/staff/xep-ca,/admin/xep-ca"><i class="fas fa-calendar-check"></i><span>Xếp ca tự động</span></a>
          <a class="qt-nav__item" href="/staff/schedule/approval" data-match="/staff/schedule/approval,/admin/schedule"><i class="fas fa-calendar-days"></i><span>Duyệt lịch làm việc</span></a>
          <a class="qt-nav__item" href="/staff/khuyen-mai" data-match="/staff/khuyen-mai,/admin/khuyen-mai"><i class="fas fa-ticket"></i><span>Chương trình Khuyến mãi</span></a>
          <a class="qt-nav__item" href="/staff/thanh-vien" data-match="/staff/thanh-vien,/admin/thanh-vien"><i class="fas fa-medal"></i><span>Khách hàng &amp; Hạng</span></a>
          <a class="qt-nav__item" href="/staff/to-chuc" data-match="/staff/to-chuc,/to-chuc"><i class="fas fa-sitemap"></i><span>Sơ đồ tổ chức</span></a>
