<%
  var activePage = 'profile';
  var staffName = session.staffName || 'Nhân viên';
  var unreadCount = unread || 0;
%>
<%- include('partials/header') %>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Thông tin cá nhân</h1>
</div>

<% if (typeof msg !== 'undefined' && msg) { %>
  <div class="alert alert-<%= msgType||'info' %> alert-dismissible fade show"><%= msg %>
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
<% } %>

<div class="row">
  <!-- Thông tin cá nhân -->
  <div class="col-md-6 mb-4">
    <div class="card shadow">
      <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Cập nhật thông tin</h6></div>
      <div class="card-body">
        <form action="/staff/profile" method="POST">
          <input type="hidden" name="action" value="update">
          <div class="form-group">
            <label>Họ và tên</label>
            <input type="text" class="form-control" name="ten" value="<%= staff.ten %>" required>
          </div>
          <div class="form-group">
            <label>Số điện thoại</label>
            <input type="text" class="form-control" name="sodienthoai" value="<%= staff.sodienthoai %>">
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" class="form-control" name="email" value="<%= staff.email || '' %>">
          </div>
          <div class="form-group">
            <label>Địa chỉ</label>
            <input type="text" class="form-control" name="diachi" value="<%= staff.diachi || '' %>">
          </div>
          <div class="form-group">
            <label>Chức vụ</label>
            <input type="text" class="form-control" value="<%= staff.chucvu %>" readonly disabled>
          </div>
          <button type="submit" class="btn btn-primary">Lưu thông tin</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Đổi mật khẩu -->
  <div class="col-md-6 mb-4">
    <div class="card shadow">
      <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-warning">Đổi mật khẩu</h6></div>
      <div class="card-body">
        <form action="/staff/profile" method="POST">
          <input type="hidden" name="action" value="password">
          <div class="form-group">
            <label>Mật khẩu hiện tại</label>
            <input type="password" class="form-control" name="old_pass" required>
          </div>
          <div class="form-group">
            <label>Mật khẩu mới</label>
            <input type="password" class="form-control" name="new_pass" minlength="6" required>
          </div>
          <div class="form-group">
            <label>Xác nhận mật khẩu mới</label>
            <input type="password" class="form-control" name="re_pass" minlength="6" required>
          </div>
          <button type="submit" class="btn btn-warning">Đổi mật khẩu</button>
        </form>
      </div>
    </div>

    <!-- Thông tin tài khoản -->
    <div class="card shadow mt-3">
      <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-secondary">Thông tin tài khoản</h6></div>
      <div class="card-body">
        <p class="mb-2"><strong>Username:</strong> <%= staff.username %></p>
        <p class="mb-2"><strong>Ngày vào làm:</strong> <%= staff.ngayvaolam ? new Date(staff.ngayvaolam).toLocaleDateString('vi-VN') : '–' %></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
