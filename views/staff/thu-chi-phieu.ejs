<%
  var laThu = p.loai === 'thu';
  var tien = Number(p.so_tien);
  /* Doc so tien thanh chu tieng Viet - dong "Viet bang chu" bat buoc tren phieu. */
  function docBaSo(n, day) {
    var so = ['không', 'một', 'hai', 'ba', 'bốn', 'năm', 'sáu', 'bảy', 'tám', 'chín'];
    var tr = Math.floor(n / 100), ch = Math.floor((n % 100) / 10), dv = n % 10, kq = [];
    if (day || tr > 0) kq.push(so[tr] + ' trăm');
    if (ch > 1) kq.push(so[ch] + ' mươi');
    else if (ch === 1) kq.push('mười');
    else if ((day || tr > 0) && dv > 0) kq.push('lẻ');
    if (dv > 0) {
      if (dv === 1 && ch > 1) kq.push('mốt');
      else if (dv === 5 && ch > 0) kq.push('lăm');
      else if (dv === 4 && ch > 1) kq.push('tư');
      else kq.push(so[dv]);
    }
    return kq.join(' ');
  }
  function docSo(n) {
    n = Math.round(n);
    if (n === 0) return 'Không đồng';
    var don = ['', ' nghìn', ' triệu', ' tỷ'], nhom = [], kq = [];
    while (n > 0) { nhom.push(n % 1000); n = Math.floor(n / 1000); }
    for (var i = nhom.length - 1; i >= 0; i--) {
      if (nhom[i] === 0) continue;
      kq.push(docBaSo(nhom[i], i < nhom.length - 1) + don[i % 4] + (i >= 4 ? ' tỷ' : ''));
    }
    var s = kq.join(' ').replace(/\s+/g, ' ').trim();
    return s.charAt(0).toUpperCase() + s.slice(1) + ' đồng';
  }
  var t = new Date(p.thoi_diem);
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= laThu ? 'Phiếu thu' : 'Phiếu chi' %> <%= p.ma_phieu %></title>
  <style>
    @page { size: A5 landscape; margin: 10mm; }
    * { box-sizing: border-box; }
    body { font-family: "Times New Roman", Times, serif; color: #111; margin: 0; background: #eee; font-size: 14px; }
    .to { background: #fff; max-width: 820px; margin: 16px auto; padding: 22px 28px; box-shadow: 0 4px 20px rgba(0,0,0,.12); position: relative; }
    .dau { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
    .dv b { font-size: 15px; } .dv div { font-size: 12.5px; }
    .mau { text-align: center; font-size: 12px; }
    h1 { text-align: center; font-size: 24px; margin: 14px 0 2px; letter-spacing: 1px; }
    .ngay { text-align: center; font-style: italic; margin-bottom: 4px; }
    .so { text-align: center; font-size: 13px; margin-bottom: 14px; }
    .dong { display: flex; gap: 6px; margin: 7px 0; line-height: 1.5; }
    .dong span:first-child { white-space: nowrap; min-width: 170px; }
    .dong b, .dong i { border-bottom: 1px dotted #555; flex: 1; font-weight: 600; }
    .ky { display: grid; grid-template-columns: repeat(5, 1fr); text-align: center; margin-top: 22px; font-size: 13px; }
    .ky b { display: block; } .ky i { font-size: 11.5px; }
    .ky .ten { margin-top: 56px; font-weight: 600; }
    .huy { position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%) rotate(-18deg); font-size: 64px; font-weight: 900;
           color: rgba(200, 30, 30, .25); border: 6px solid rgba(200, 30, 30, .25); padding: 4px 28px; pointer-events: none; }
    .nut { text-align: center; margin: 14px; font-family: system-ui, sans-serif; }
    .nut button { padding: 10px 22px; font-size: 15px; border-radius: 8px; border: 0; background: #2b1a12; color: #f3dfa6; cursor: pointer; margin: 0 4px; }
    @media print { body { background: #fff; } .to { box-shadow: none; margin: 0; max-width: none; } .nut { display: none; } }
    @media (max-width: 600px) {
      .to { padding: 16px; } .dong { flex-wrap: wrap; } .dong span:first-child { min-width: 0; }
      .ky { grid-template-columns: repeat(3, 1fr); row-gap: 10px; }
    }
  </style>
</head>
<body>
  <div class="nut">
    <button type="button" onclick="window.print()">🖨 In phiếu</button>
    <button type="button" onclick="window.close()">Đóng</button>
  </div>
  <div class="to">
    <% if (p.trang_thai === 'da_huy') { %><div class="huy">ĐÃ HỦY</div><% } %>
    <div class="dau">
      <div class="dv">
        <b>NHÀ HÀNG BẢO ĐOÀN</b>
        <div>12 Nguyễn Văn Bảo, Hạnh Thông, TP. Hồ Chí Minh</div>
      </div>
      <div class="mau">
        <b>Mẫu số <%= laThu ? '01-TT' : '02-TT' %></b><br>
        <i>(Ban hành theo TT 133/2016/TT-BTC)</i>
      </div>
    </div>

    <h1><%= laThu ? 'PHIẾU THU' : 'PHIẾU CHI' %></h1>
    <div class="ngay">Ngày <%= t.getDate() %> tháng <%= t.getMonth() + 1 %> năm <%= t.getFullYear() %> — lúc <%= ('0' + t.getHours()).slice(-2) %>:<%= ('0' + t.getMinutes()).slice(-2) %></div>
    <div class="so">Số: <b><%= p.ma_phieu %></b> &nbsp;·&nbsp; <%= laThu ? 'Nợ TK 111 / Có TK ...' : 'Nợ TK ... / Có TK 111' %></div>

    <div class="dong"><span>Họ tên người <%= laThu ? 'nộp' : 'nhận' %> tiền:</span><b><%= p.doi_tuong || '' %></b></div>
    <div class="dong"><span><%= laThu ? 'Lý do nộp:' : 'Lý do chi:' %></span><b><%= (danhMuc[p.loai][p.danh_muc] || p.danh_muc) %> — <%= p.noi_dung %></b></div>
    <div class="dong"><span>Số tiền:</span><b><%= tien.toLocaleString('vi-VN') %> đồng &nbsp;(<%= phuongThuc[p.phuong_thuc] || p.phuong_thuc %>)</b></div>
    <div class="dong"><span>Viết bằng chữ:</span><i><%= docSo(tien) %></i></div>
    <div class="dong"><span>Kèm theo:</span><b><%= p.so_chung_tu ? 'Chứng từ gốc: ' + p.so_chung_tu : '........ chứng từ gốc' %></b></div>
    <% if (p.trang_thai === 'da_huy') { %>
      <div class="dong" style="color:#b91c1c"><span>Lý do hủy:</span><b><%= p.ly_do_huy %></b></div>
    <% } %>

    <div class="ky">
      <div><b>Giám đốc</b><i>(Ký, họ tên, đóng dấu)</i><div class="ten">&nbsp;</div></div>
      <div><b>Kế toán trưởng</b><i>(Ký, họ tên)</i><div class="ten">&nbsp;</div></div>
      <div><b>Người lập phiếu</b><i>(Ký, họ tên)</i><div class="ten"><%= p.nguoi_lap || '' %></div></div>
      <div><b>Người <%= laThu ? 'nộp' : 'nhận' %> tiền</b><i>(Ký, họ tên)</i><div class="ten"><%= p.doi_tuong || '' %></div></div>
      <div><b>Thủ quỹ</b><i>(Ký, họ tên)</i><div class="ten">&nbsp;</div></div>
    </div>
  </div>
</body>
</html>
