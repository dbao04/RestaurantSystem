<%
  var activePage = 'huy-mon-nhat-ky';
  var vnd = function (n) { return Math.round(Number(n || 0)).toLocaleString('vi-VN') + 'đ'; };
  var gio = function (d) { if (!d) return ''; var x = new Date(d); return String(x.getHours()).padStart(2, '0') + ':' + String(x.getMinutes()).padStart(2, '0') + ' ' + x.getDate() + '/' + (x.getMonth() + 1); };
%>
<%- include('partials/header') %>

<div class="d-sm-flex align-items-center justify-content-between mb-3">
  <div>
    <h1 class="h3 mb-1 text-gray-800"><i class="fas fa-ban text-danger"></i> Nhật ký xóa món</h1>
    <div class="small text-muted">Mọi lần xóa món đã order đều phải giải trình. Quản lý và giám sát nhận thông báo ngay khi có món bị xóa.</div>
  </div>
  <form class="form-inline" method="GET" style="gap:.4rem">
    <input type="date" name="tu" value="<%= tuNgay %>" class="form-control form-control-sm">
    <span class="small">→</span>
    <input type="date" name="den" value="<%= denNgay %>" class="form-control form-control-sm">
    <% if (nv) { %><input type="hidden" name="nv" value="<%= nv %>"><% } %>
    <button class="btn btn-sm btn-primary"><i class="fas fa-filter"></i> Xem</button>
    <% if (nv) { %><a class="btn btn-sm btn-light" href="?tu=<%= tuNgay %>&den=<%= denNgay %>">Bỏ lọc nhân viên</a><% } %>
  </form>
</div>

<div class="row">
  <div class="col-lg-4 mb-3">
    <div class="card shadow h-100">
      <div class="card-header py-2"><h6 class="m-0 font-weight-bold text-primary">Theo nhân viên</h6></div>
      <div class="card-body p-0">
        <% if (!theoNv.length) { %><p class="text-muted small m-3">Không có món nào bị xóa trong khoảng này.</p><% } %>
        <table class="table table-sm mb-0">
          <% theoNv.forEach(function (t) { %>
            <tr>
              <td><a href="?tu=<%= tuNgay %>&den=<%= denNgay %>&nv=<%= t.id_nv || '' %>"><%= t.ten_nv %></a>
                <div class="small text-muted"><%= t.so_lan %> lần · <%= t.so_phan %> phần<% if (t.da_nau) { %> · <span class="text-danger"><%= t.da_nau %> lần món đã nấu</span><% } %></div></td>
              <td class="text-right font-weight-bold text-danger"><%= vnd(t.gia_tri) %></td>
            </tr>
          <% }) %>
        </table>
      </div>
      <div class="card-footer small">Tổng giá trị bị xóa: <b class="text-danger"><%= vnd(tong) %></b></div>
    </div>
  </div>
  <div class="col-lg-8 mb-3">
    <div class="card shadow">
      <div class="card-header py-2"><h6 class="m-0 font-weight-bold text-primary">Chi tiết (<%= ds.length %>)</h6></div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead class="thead-light"><tr><th>Lúc</th><th>Món</th><th>Bàn</th><th>Người xóa</th><th>Lý do / giải trình</th><th class="text-right">Giá trị</th></tr></thead>
            <tbody>
              <% ds.forEach(function (r) { %>
                <tr>
                  <td class="small text-nowrap"><%= gio(r.tao_luc) %></td>
                  <td><%= String(r.name_mon).trim() %> ×<%= r.so_luong %>
                    <div class="small <%= r.trangthai_bep >= 1 ? 'text-danger' : 'text-muted' %>"><%= r.ten_bep %></div></td>
                  <td class="small"><%= r.number_ban ? 'Bàn ' + r.number_ban : '—' %></td>
                  <td class="small"><%= r.ten_nv || '—' %></td>
                  <td class="small"><b><%= r.ten_ly_do %></b><% if (r.ly_do) { %><div><%= r.ly_do %></div><% } %></td>
                  <td class="text-right"><%= vnd(r.gia_tri) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
