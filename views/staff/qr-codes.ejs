<%
  var activePage = 'qr-codes';
  var staffName = session.staffName || 'Nhân viên';
  var unreadCount = unread || 0;
%>
<%- include('partials/header') %>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">🔲 Quản lý Mã QR Đặt Món</h1>
  <div class="text-muted small">Mỗi bàn có 1 mã QR. Khách quét để đặt món trực tiếp tại bàn.</div>
</div>

<!-- Info card -->
<div class="card shadow mb-4" style="background:linear-gradient(135deg,#4e342e,#2c1810); color:#fff; border:none;">
  <div class="card-body d-flex align-items-center">
    <div style="font-size:48px; margin-right:20px;">📱</div>
    <div>
      <h5 class="mb-1" style="color:#c8a951;">Hướng dẫn sử dụng QR Code</h5>
      <p class="mb-0" style="color:rgba(255,255,255,0.8); font-size:13px;">
        1. Chọn bàn cần in QR → Bấm "Tạo QR Code" <br>
        2. In hoặc hiển thị mã QR lên màn hình để khách quét<br>
        3. Khách dùng camera điện thoại quét QR → vào trang đặt món → chọn và gửi đơn<br>
        4. Đơn sẽ tự động xuất hiện trong hệ thống của nhân viên bếp
      </p>
    </div>
  </div>
</div>

<!-- Tạo QR mới -->
<div class="card shadow mb-4">
  <div class="card-header py-3">
    <h6 class="m-0 font-weight-bold text-primary">Tạo mã QR cho bàn</h6>
  </div>
  <div class="card-body">
    <form id="qrForm" onsubmit="generateQR(event)">
      <div class="row align-items-end">
        <div class="col-md-4">
          <label class="font-weight-bold">Tên / Số bàn <span class="text-danger">*</span></label>
          <input type="text" id="tableNameInput" class="form-control" placeholder="Ví dụ: Bàn 1, VIP-1, Terrace 2..." required>
        </div>
        <div class="col-md-4">
          <label class="font-weight-bold">Ghi chú (tùy chọn)</label>
          <input type="text" id="tableNoteInput" class="form-control" placeholder="Khu vực, tầng...">
        </div>
        <div class="col-md-4">
          <button type="submit" class="btn btn-primary btn-block" id="btnGenQR">
            <i class="fas fa-qrcode"></i> Tạo mã QR
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- QR Preview -->
<div class="card shadow mb-4" id="qrPreviewCard" style="display:none;">
  <div class="card-header py-3 d-flex align-items-center justify-content-between">
    <h6 class="m-0 font-weight-bold text-success"><i class="fas fa-check-circle"></i> Mã QR đã tạo</h6>
    <button class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('qrPreviewCard').style.display='none'">
      <i class="fas fa-times"></i>
    </button>
  </div>
  <div class="card-body text-center">
    <div id="qrContainer" class="d-inline-block p-3 bg-white rounded shadow mb-3"></div>
    <div id="qrTableName" class="h5 font-weight-bold text-dark mb-1"></div>
    <div id="qrUrl" class="small text-muted mb-3"></div>
    <div class="d-flex justify-content-center gap-2" style="gap:10px;">
      <button class="btn btn-primary" onclick="printQR()">
        <i class="fas fa-print"></i> In mã QR
      </button>
      <button class="btn btn-outline-secondary" onclick="downloadQR()">
        <i class="fas fa-download"></i> Tải xuống
      </button>
      <a id="qrTestLink" href="#" target="_blank" class="btn btn-outline-info">
        <i class="fas fa-external-link-alt"></i> Mở thử trang đặt món
      </a>
    </div>
  </div>
</div>

<!-- Danh sách QR đã tạo -->
<div class="card shadow mb-4">
  <div class="card-header py-3">
    <h6 class="m-0 font-weight-bold text-primary">Danh sách bàn & mã QR</h6>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-bordered" id="qrTable">
        <thead>
          <tr>
            <th width="60">#</th>
            <th>Tên bàn</th>
            <th>Link đặt món</th>
            <th width="200" class="text-center">Hành động</th>
          </tr>
        </thead>
        <tbody id="qrTableBody">
          <% if (qrCodes && qrCodes.length > 0) { %>
            <% qrCodes.forEach((qr, i) => { %>
            <tr>
              <td><%= i+1 %></td>
              <td><strong><%= qr.table_name %></strong><% if(qr.note) { %><br><small class="text-muted"><%= qr.note %></small><% } %></td>
              <td><a href="<%= qr.url %>" target="_blank" class="text-info small"><%= qr.url %></a></td>
              <td class="text-center">
                <button class="btn btn-sm btn-primary mb-1" onclick="showQRForTable('<%= qr.table_id %>', '<%= qr.table_name %>', '<%= qr.url %>')">
                  <i class="fas fa-qrcode"></i> Hiển thị QR
                </button>
                <form action="/staff/qr-codes/delete/<%= qr.id %>" method="POST" class="d-inline" onsubmit="return confirm('Xóa QR bàn này?')">
                  <button type="submit" class="btn btn-sm btn-danger mb-1"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="4" class="text-center text-muted py-4">Chưa có mã QR nào. Hãy tạo mã QR cho từng bàn ở trên!</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- QR Library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
  let currentQRCode = null;
  const baseUrl = window.location.protocol + '//' + window.location.host;

  async function generateQR(e) {
    e.preventDefault();
    const name = document.getElementById('tableNameInput').value.trim();
    const note = document.getElementById('tableNoteInput').value.trim();
    if (!name) return;

    const btn = document.getElementById('btnGenQR');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang tạo...';

    try {
      const res = await fetch('/staff/qr-codes/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ table_name: name, note })
      });
      const data = await res.json();
      if (data.success) {
        showQRCode(data.table_id, name, data.url);
        // Add row to table
        addTableRow(data.id, name, note, data.table_id, data.url);
        document.getElementById('tableNameInput').value = '';
        document.getElementById('tableNoteInput').value = '';
      } else {
        alert('Lỗi: ' + data.message);
      }
    } catch(err) {
      alert('Lỗi kết nối server!');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-qrcode"></i> Tạo mã QR';
    }
  }

  function showQRCode(tableId, name, url) {
    const container = document.getElementById('qrContainer');
    container.innerHTML = '';
    new QRCode(container, {
      text: url,
      width: 200,
      height: 200,
      colorDark: '#1a1818',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.H
    });
    document.getElementById('qrTableName').textContent = '🪑 ' + name;
    document.getElementById('qrUrl').textContent = url;
    document.getElementById('qrTestLink').href = url;
    document.getElementById('qrPreviewCard').style.display = 'block';
    document.getElementById('qrPreviewCard').scrollIntoView({ behavior: 'smooth' });
  }

  function showQRForTable(tableId, name, url) {
    showQRCode(tableId, name, url);
  }

  function addTableRow(id, name, note, tableId, url) {
    const tbody = document.getElementById('qrTableBody');
    // Remove empty placeholder row if exists
    if (tbody.querySelector('td[colspan]')) tbody.innerHTML = '';
    const rowCount = tbody.querySelectorAll('tr').length + 1;
    const row = document.createElement('tr');
    row.innerHTML = `
      <td>${rowCount}</td>
      <td><strong>${name}</strong>${note ? `<br><small class="text-muted">${note}</small>` : ''}</td>
      <td><a href="${url}" target="_blank" class="text-info small">${url}</a></td>
      <td class="text-center">
        <button class="btn btn-sm btn-primary mb-1" onclick="showQRForTable('${tableId}', '${name}', '${url}')">
          <i class="fas fa-qrcode"></i> Hiển thị QR
        </button>
        <form action="/staff/qr-codes/delete/${id}" method="POST" class="d-inline" onsubmit="return confirm('Xóa QR bàn này?')">
          <button type="submit" class="btn btn-sm btn-danger mb-1"><i class="fas fa-trash"></i></button>
        </form>
      </td>
    `;
    tbody.appendChild(row);
  }

  function printQR() {
    const qrHtml = document.getElementById('qrContainer').innerHTML;
    const name = document.getElementById('qrTableName').textContent;
    const url = document.getElementById('qrUrl').textContent;
    const win = window.open('', '', 'width=400,height=500');
    win.document.write(`
      <!DOCTYPE html><html><head><title>In QR Code</title>
      <style>
        body { font-family: Arial, sans-serif; text-align: center; padding: 20px; }
        h2 { margin-bottom: 8px; }
        p { font-size: 12px; color: #555; word-break: break-all; }
        img { max-width: 200px; }
      </style>
      </head><body>
        <h2>🍽️ NHA HANG BD</h2>
        <h3 style="color:#c8813a">${name}</h3>
        <div style="display:flex;justify-content:center;margin:10px 0;">${qrHtml}</div>
        <p>📱 Quét mã QR để đặt món tại bàn</p>
        <p style="font-size:10px">${url}</p>
      </body></html>
    `);
    win.document.close();
    win.print();
  }

  function downloadQR() {
    const canvas = document.querySelector('#qrContainer canvas');
    if (!canvas) return alert('Vui lòng tạo QR trước!');
    const link = document.createElement('a');
    link.download = 'qr-dat-mon.png';
    link.href = canvas.toDataURL();
    link.click();
  }
</script>

<%- include('partials/footer') %>
