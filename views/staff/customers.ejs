<%
  var activePage = 'customers';
  var staffName = session.staffName || 'Nhân viên';
  var unreadCount = unread || 0;
%>
<%- include('partials/header') %>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Quản lý Khách hàng</h1>
  <button class="btn btn-sm btn-primary shadow-sm" data-toggle="modal" data-target="#addCustomerModal">
    <i class="fas fa-user-plus fa-sm text-white-50"></i> Thêm Khách hàng mới
  </button>
</div>

<div class="card shadow mb-4">
  <div class="card-header py-3">
    <h6 class="m-0 font-weight-bold text-primary">Danh sách Khách hàng</h6>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
        <thead>
          <tr>
            <th>ID</th>
            <th>Tên</th>
            <th>Số điện thoại</th>
            <th>Email</th>
            <th>Địa chỉ</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if(customers && customers.length > 0) { %>
            <% customers.forEach(c => { %>
              <tr>
                <td><%= c.id %></td>
                <td><%= c.ten %></td>
                <td><%= c.sodienthoai %></td>
                <td><%= c.email || 'N/A' %></td>
                <td><%= c.diachi || 'N/A' %></td>
                <td>
                  <button class="btn btn-sm btn-warning" data-toggle="modal" data-target="#editModal<%= c.id %>"><i class="fas fa-edit"></i></button>
                  <form action="/staff/customers/delete/<%= c.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?')">
                    <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                  </form>

                  <!-- Edit Modal -->
                  <div class="modal fade" id="editModal<%= c.id %>" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                      <div class="modal-content">
                        <form action="/staff/customers/edit/<%= c.id %>" method="POST">
                          <div class="modal-header">
                            <h5 class="modal-title">Sửa thông tin khách hàng</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                              <span aria-hidden="true">&times;</span>
                            </button>
                          </div>
                          <div class="modal-body">
                            <div class="form-group">
                              <label>Tên</label>
                              <input type="text" name="ten" class="form-control" value="<%= c.ten %>" required>
                            </div>
                            <div class="form-group">
                              <label>Số điện thoại</label>
                              <input type="text" name="sodienthoai" class="form-control" value="<%= c.sodienthoai %>" required>
                            </div>
                            <div class="form-group">
                              <label>Email</label>
                              <input type="email" name="email" class="form-control" value="<%= c.email %>">
                            </div>
                            <div class="form-group">
                              <label>Địa chỉ</label>
                              <input type="text" name="diachi" class="form-control" value="<%= c.diachi %>">
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="6" class="text-center">Chưa có khách hàng nào</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addCustomerModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form action="/staff/customers/add" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">Thêm Khách hàng mới</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label>Tên</label>
            <input type="text" name="ten" class="form-control" required>
          </div>
          <div class="form-group">
            <label>Số điện thoại</label>
            <input type="text" name="sodienthoai" class="form-control" required>
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-control">
          </div>
          <div class="form-group">
            <label>Địa chỉ</label>
            <input type="text" name="diachi" class="form-control">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-primary">Thêm mới</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
