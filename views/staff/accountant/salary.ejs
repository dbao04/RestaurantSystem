<%
  var activePage = 'salary';
  var staffName = session.staffName || 'Kế toán';
  var sum = (typeof summary !== 'undefined' && summary) ? summary : {};
  var sList = (typeof salaryList !== 'undefined' && salaryList) ? salaryList : [];
  var stList = (typeof staffList !== 'undefined' && staffList) ? staffList : [];
  var attList = (typeof attendanceList !== 'undefined' && attendanceList) ? attendanceList : [];
  var totalAmount = sum.total_amount || 0;
  var totalStaff = sum.total_staff || sList.length || 0;
  var draftCount = sum.draft_count || 0;
  var pendingCount = sum.pending_count || 0;
  var approvedCount = sum.approved_count || 0;
  var paidCount = sum.paid_count || 0;
  var paidAmount = sum.paid_amount || 0;
  var msgText = (typeof msg !== 'undefined') ? msg : null;
  var msgStyle = (typeof msgType !== 'undefined') ? msgType : 'success';
%>
<%- include('../partials/header') %>

<style>
  /* Đồng bộ chuẩn theme Espresso & Gold của nhà hàng */
  .salary-stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .salary-stat-card {
    background: #ffffff;
    border: 1px solid var(--qt-line, #e7ded0);
    border-radius: 14px;
    padding: 1.25rem 1.4rem;
    box-shadow: 0 10px 25px -15px rgba(36, 26, 20, 0.25);
    position: relative;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .salary-stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px -15px rgba(36, 26, 20, 0.35);
  }
  .salary-stat-card::after {
    content: '';
    position: absolute;
    right: -25px; top: -25px;
    width: 95px; height: 95px;
    border-radius: 50%;
    background: var(--stat-tint, rgba(200, 162, 75, 0.1));
  }
  .salary-stat-icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--stat-tint, rgba(200, 162, 75, 0.15));
    color: var(--stat-tone, #c8a24b);
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    position: relative; z-index: 1;
  }
  .salary-stat-label {
    font-size: 0.68rem;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: #6b5f54;
    font-weight: 700;
    position: relative; z-index: 1;
  }
  .salary-stat-val {
    font-family: var(--qt-serif, 'Playfair Display', Georgia, serif);
    font-size: 1.65rem;
    font-weight: 700;
    color: #241d18;
    margin-top: 0.2rem;
    line-height: 1.2;
    position: relative; z-index: 1;
  }
  .salary-stat-sub {
    font-size: 0.75rem;
    color: #6b5f54;
    margin-top: 0.3rem;
    position: relative; z-index: 1;
  }

  .stat--gold { --stat-tone: #a8822f; --stat-tint: rgba(200, 162, 75, 0.15); }
  .stat--blue { --stat-tone: #2b5f8a; --stat-tint: rgba(43, 95, 138, 0.12); }
  .stat--warn { --stat-tone: #a9750f; --stat-tint: rgba(169, 117, 15, 0.15); }
  .stat--green { --stat-tone: #2e7d4f; --stat-tint: rgba(46, 125, 79, 0.15); }

  /* Toolbar Bộ Lọc & Nút Bấm Thao Tác */
  .salary-toolbar {
    background: #ffffff;
    border: 1px solid #e7ded0;
    border-radius: 14px;
    padding: 1.1rem 1.4rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 6px 18px -12px rgba(36, 26, 20, 0.25);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .filter-pill-btn {
    cursor: pointer;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid #e7ded0;
    background: #fff;
    color: #6b5f54;
    transition: all 0.2s;
  }
  .filter-pill-btn:hover {
    border-color: #c8a24b;
    color: #241a14;
  }
  .filter-pill-btn.active {
    background: linear-gradient(135deg, #3d2b21, #241a14);
    color: #c8a24b;
    border-color: #3d2b21;
    box-shadow: 0 4px 12px rgba(36, 26, 20, 0.2);
  }

  .status-tag {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }
  .status-tag.draft { background: #f2ede4; color: #6b5f54; border: 1px solid #e7ded0; }
  .status-tag.pending { background: #fbf1dc; color: #a9750f; border: 1px solid rgba(169, 117, 15, 0.3); }
  .status-tag.ready { background: #e8f1f8; color: #2b5f8a; border: 1px solid rgba(43, 95, 138, 0.3); }
  .status-tag.paid { background: #e6f4ec; color: #2e7d4f; border: 1px solid rgba(46, 125, 79, 0.3); }

  .table-salary-wrap {
    background: #fff;
    border: 1px solid #e7ded0;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 30px -15px rgba(36, 26, 20, 0.25);
  }
  .table-salary thead th {
    background: #faf6ef;
    color: #6b5f54;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    border-bottom: 1px solid #e7ded0;
    padding: 12px 14px;
    vertical-align: middle;
  }
  .table-salary tbody td {
    padding: 12px 14px;
    vertical-align: middle;
    border-bottom: 1px solid #f2ede4;
    color: #241d18;
  }
  .table-salary tbody tr:hover {
    background: #fdfaf4;
  }
</style>

<div class="container-fluid px-0">

  <!-- Thông báo Toast / Alert -->
  <% if (msgText) { %>
    <div class="alert alert-<%= msgStyle === 'danger' ? 'danger' : (msgStyle === 'warning' ? 'warning' : 'success') %> alert-dismissible fade show shadow-sm mb-4" role="alert">
      <i class="fas fa-<%= msgStyle === 'danger' ? 'exclamation-circle' : (msgStyle === 'warning' ? 'exclamation-triangle' : 'check-circle') %> mr-2"></i>
      <%= msgText %>
      <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
  <% } %>

  <!-- Thanh Tiêu đề & Chọn Kỳ Lương -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h1 class="h3 mb-1 font-weight-bold" style="font-family: var(--qt-serif); color: #241a14;">
        <i class="fas fa-calculator text-warning mr-2"></i>Quản lý &amp; Tính Bảng Lương
      </h1>
      <p class="text-muted small mb-0">Hệ thống tính lương tự động 1-Click theo ngày công thực tế, cấp bậc chức vụ và thưởng phạt</p>
    </div>

    <!-- Bộ chọn Kỳ Lương Tháng / Năm -->
    <div class="d-flex align-items-center bg-white p-2 rounded-lg shadow-sm border" style="border-color: #e7ded0 !important;">
      <form class="form-inline mb-0" method="GET" action="/staff/accountant/salary">
        <span class="text-muted small font-weight-bold mr-2"><i class="far fa-calendar-alt text-warning"></i> Kỳ lương:</span>
        <select name="month" class="form-control form-control-sm mr-2 font-weight-bold" onchange="this.form.submit()">
          <% for(let m = 1; m <= 12; m++) { %>
            <option value="<%= m %>" <%= m == month ? 'selected' : '' %>>Tháng <%= m %></option>
          <% } %>
        </select>
        <select name="year" class="form-control form-control-sm font-weight-bold" onchange="this.form.submit()">
          <% for(let y = 2024; y <= 2027; y++) { %>
            <option value="<%= y %>" <%= y == year ? 'selected' : '' %>>Năm <%= y %></option>
          <% } %>
        </select>
      </form>
    </div>
  </div>

  <!-- 4 Thẻ KPI Tóm Tắt Tài Chính -->
  <div class="salary-stat-grid">
    <div class="salary-stat-card stat--gold">
      <div class="salary-stat-icon"><i class="fas fa-sack-dollar"></i></div>
      <div class="salary-stat-label">Tổng Quỹ Lương T<%= month %></div>
      <div class="salary-stat-val" style="color:#a8822f"><%= formatMoney(totalAmount) %></div>
      <div class="salary-stat-sub"><i class="fas fa-users mr-1"></i><%= totalStaff %> nhân sự được tính</div>
    </div>

    <div class="salary-stat-card stat--blue">
      <div class="salary-stat-icon"><i class="fas fa-file-pen"></i></div>
      <div class="salary-stat-label">Bản Ghi Dự Thảo</div>
      <div class="salary-stat-val"><%= draftCount %> <span style="font-size:1rem;color:#6b5f54">/ <%= totalStaff %></span></div>
      <div class="salary-stat-sub"><%= draftCount > 0 ? 'Cần kiểm tra và gửi duyệt' : 'Đã gửi duyệt hết' %></div>
    </div>

    <div class="salary-stat-card stat--warn">
      <div class="salary-stat-icon"><i class="fas fa-hourglass-half"></i></div>
      <div class="salary-stat-label">Chờ Ban Giám Đốc Duyệt</div>
      <div class="salary-stat-val" style="color:#a9750f"><%= pendingCount %> <span style="font-size:1rem;color:#6b5f54">hồ sơ</span></div>
      <div class="salary-stat-sub"><%= pendingCount > 0 ? 'Đang chờ quản lý phê duyệt' : 'Không có hồ sơ chờ' %></div>
    </div>

    <div class="salary-stat-card stat--green">
      <div class="salary-stat-icon"><i class="fas fa-circle-check"></i></div>
      <div class="salary-stat-label">Đã Thanh Toán</div>
      <div class="salary-stat-val" style="color:#2e7d4f"><%= paidCount %> <span style="font-size:1rem;color:#6b5f54">/ <%= totalStaff %></span></div>
      <div class="salary-stat-sub font-weight-bold" style="color:#2e7d4f"><%= formatMoney(paidAmount) %></div>
    </div>
  </div>

  <!-- Thanh Thao tác Hành động Nhanh -->
  <div class="salary-toolbar">
    <div class="d-flex flex-wrap align-items-center gap-2">
      <!-- Nút Tự động tính lương -->
      <form action="/staff/accountant/salary/auto-calculate" method="POST" class="d-inline mr-2" onsubmit="return confirm('⚡ Tự động tính toán lại bảng lương tháng <%= month %>/<%= year %> cho TOÀN BỘ nhân viên dựa trên ngày công chấm công thực tế?')">
        <input type="hidden" name="month" value="<%= month %>">
        <input type="hidden" name="year" value="<%= year %>">
        <button type="submit" class="btn text-white font-weight-bold shadow-sm" style="background: linear-gradient(135deg, #241a14, #3d2b21); border: 1px solid #c8a24b;">
          <i class="fas fa-bolt text-warning mr-1"></i> ⚡ Tự động tính lương tháng <%= month %>
        </button>
      </form>

      <!-- Nút Gửi duyệt tất cả -->
      <% if (draftCount > 0) { %>
        <form action="/staff/accountant/salary/submit-all" method="POST" class="d-inline mr-2" onsubmit="return confirm('Gửi <%= draftCount %> bảng lương dự thảo của tháng <%= month %>/<%= year %> sang Quản lý duyệt?')">
          <input type="hidden" name="month" value="<%= month %>">
          <input type="hidden" name="year" value="<%= year %>">
          <button type="submit" class="btn font-weight-bold shadow-sm" style="background: #fbf1dc; color: #a9750f; border: 1px solid rgba(169, 117, 15, 0.4);">
            <i class="fas fa-paper-plane mr-1"></i> Gửi duyệt tất cả (<%= draftCount %>)
          </button>
        </form>
      <% } %>

      <!-- Nút Chi lương tất cả -->
      <% if (approvedCount > 0) { %>
        <form action="/staff/accountant/salary/pay-all" method="POST" class="d-inline mr-2" onsubmit="return confirm('Xác nhận đã chi trả lương cho <%= approvedCount %> nhân viên đã duyệt trong tháng <%= month %>/<%= year %>?')">
          <input type="hidden" name="month" value="<%= month %>">
          <input type="hidden" name="year" value="<%= year %>">
          <button type="submit" class="btn text-white font-weight-bold shadow-sm" style="background: #2e7d4f; border-color: #2e7d4f;">
            <i class="fas fa-money-bill-wave mr-1"></i> Thanh toán tất cả (<%= approvedCount %>)
          </button>
        </form>
      <% } %>
    </div>

    <!-- Nút Xuất Excel & Thiết lập thủ công -->
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-outline-secondary font-weight-bold mr-2" data-toggle="modal" data-target="#exportExcelModal" style="background:#fff; border-color:#e7ded0; color:#241a14;">
        <i class="fas fa-file-excel text-success mr-1"></i> Xuất Excel (.csv)
      </button>
      <button class="btn font-weight-bold text-dark" data-toggle="modal" data-target="#setupSalaryModal" style="background: #fdf6e7; border: 1px solid #c8a24b;">
        <i class="fas fa-plus text-warning mr-1"></i> Thiết lập lương riêng
      </button>
    </div>
  </div>

  <!-- BẢNG LƯƠNG CHÍNH -->
  <div class="table-salary-wrap mb-4">
    <div class="p-3 d-flex flex-wrap justify-content-between align-items-center border-bottom bg-white">
      <div class="d-flex align-items-center flex-wrap gap-2">
        <span class="font-weight-bold mr-3" style="font-family: var(--qt-serif); font-size: 1.05rem; color: #241a14;">
          <i class="fas fa-list-ul text-warning mr-2"></i>Danh Sách Lương Nhân Sự (<%= sList.length %>)
        </span>
        <!-- Filter Pills -->
        <button class="filter-pill-btn active mr-1" onclick="filterTable('all', this)">Tất cả (<%= sList.length %>)</button>
        <button class="filter-pill-btn mr-1" onclick="filterTable('0', this)">Dự thảo (<%= draftCount %>)</button>
        <button class="filter-pill-btn mr-1" onclick="filterTable('1', this)">Chờ duyệt (<%= pendingCount %>)</button>
        <button class="filter-pill-btn mr-1" onclick="filterTable('2', this)">Sẵn sàng chi (<%= approvedCount %>)</button>
        <button class="filter-pill-btn" onclick="filterTable('3', this)">Đã chi (<%= paidCount %>)</button>
      </div>

      <div class="small text-muted font-weight-bold">
        <i class="fas fa-scale-balanced mr-1 text-warning"></i>Định mức chuẩn: 26 ngày công / tháng
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-salary table-hover align-middle mb-0" id="salaryTable">
        <thead>
          <tr>
            <th width="4%">#</th>
            <th>Nhân viên</th>
            <th>Vị trí / Chức danh</th>
            <th class="text-center">Ngày công</th>
            <th class="text-right">Lương cơ bản</th>
            <th class="text-right">Phụ cấp</th>
            <th class="text-right">Thưởng / Phạt</th>
            <th class="text-right font-weight-bold" style="color: #a8822f;">Thực lĩnh</th>
            <th class="text-center">Trạng thái</th>
            <th class="text-center" width="14%">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (!sList || sList.length === 0) { %>
            <tr>
              <td colspan="10" class="text-center py-5 text-muted">
                <i class="fas fa-calculator fa-3x mb-3 text-muted d-block opacity-50"></i>
                Chưa có dữ liệu bảng lương tháng <%= month %>/<%= year %>.<br>
                <small>Bấm <strong>"⚡ Tự động tính lương"</strong> ở trên để hệ thống tự quét chấm công và tính lương cho toàn bộ <%= staffList.length %> nhân viên.</small>
              </td>
            </tr>
          <% } %>

          <% sList.forEach((s, idx) => { 
              var statusVal = (s.trang_thai === 'tam_tinh' ? 0 : (s.trang_thai === 'gui_duyet' ? 1 : (s.trang_thai === 'da_duyet' ? 2 : (s.trang_thai === 'da_thanh_toan' ? 3 : Number(s.trang_thai || 0)))));
              var thuongPhat = (Number(s.thuong || 0)) - (Number(s.phat || 0));
          %>
            <tr class="salary-row" data-status="<%= statusVal %>">
              <td class="text-muted small font-weight-bold"><%= idx + 1 %></td>
              <td>
                <div class="font-weight-bold" style="color:#241a14"><%= s.ten %></div>
                <small class="text-muted"><i class="fas fa-id-badge mr-1"></i>NV<%= s.id_nv %></small>
              </td>
              <td>
                <span class="badge badge-light border text-dark font-weight-normal px-2 py-1" style="background:#faf6ef; border-color:#e7ded0 !important;">
                  <%= s.ten_cd || s.chucvu %>
                </span>
              </td>
              <td class="text-center">
                <span class="badge badge-pill font-weight-bold px-2 py-1" style="background:#fdf6e7; color:#8a6a1f; border:1px solid #c8a24b; font-size:0.85rem;">
                  <%= s.songaycong || s.so_ngay_cong || 0 %> / 26
                </span>
              </td>
              <td class="text-right font-weight-bold" style="font-variant-numeric: tabular-nums;"><%= formatMoney(s.luong_cung) %></td>
              <td class="text-right text-muted" style="font-variant-numeric: tabular-nums;"><%= formatMoney(s.phu_cap) %></td>
              <td class="text-right font-weight-bold <%= thuongPhat > 0 ? 'text-success' : (thuongPhat < 0 ? 'text-danger' : 'text-muted') %>" style="font-variant-numeric: tabular-nums;">
                <%= thuongPhat > 0 ? '+' : '' %><%= formatMoney(thuongPhat) %>
              </td>
              <td class="text-right font-weight-bold" style="color: #a8822f; font-size: 1.05rem; font-variant-numeric: tabular-nums;">
                <%= formatMoney(s.tong_luong) %>
              </td>
              <td class="text-center">
                <% if(statusVal === 0) { %>
                  <span class="status-tag draft"><i class="fas fa-file-pen"></i> Dự thảo</span>
                <% } else if(statusVal === 1) { %>
                  <span class="status-tag pending"><i class="fas fa-hourglass-half"></i> Chờ duyệt</span>
                <% } else if(statusVal === 2) { %>
                  <span class="status-tag ready"><i class="fas fa-circle-check"></i> Sẵn sàng chi</span>
                <% } else if(statusVal === 3) { %>
                  <span class="status-tag paid"><i class="fas fa-check-double"></i> Đã chi</span>
                <% } %>
              </td>
              <td class="text-center">
                <div class="d-inline-flex gap-1">
                  <!-- Sửa nhanh -->
                  <button type="button" class="btn btn-sm btn-light border mr-1" title="Chỉnh sửa chi tiết"
                          onclick="openQuickEdit(<%= JSON.stringify(s) %>)">
                    <i class="fas fa-edit text-secondary"></i>
                  </button>

                  <!-- In Phiếu Lương -->
                  <a href="/staff/accountant/salary/print/<%= s.id_luong %>" class="btn btn-sm btn-light border mr-1" title="In phiếu lương" target="_blank">
                    <i class="fas fa-print text-info"></i>
                  </a>

                  <!-- Gửi duyệt lẻ -->
                  <% if (statusVal === 0) { %>
                    <form action="/staff/accountant/salary/submit/<%= s.id_luong %>" method="POST" class="d-inline mr-1" onsubmit="return confirm('Gửi duyệt bảng lương của <%= s.ten %>?')">
                      <button type="submit" class="btn btn-sm btn-warning text-dark" title="Gửi duyệt">
                        <i class="fas fa-paper-plane"></i>
                      </button>
                    </form>
                  <% } %>

                  <!-- Chi lương lẻ -->
                  <% if (statusVal === 2) { %>
                    <form action="/staff/accountant/salary/pay/<%= s.id_luong %>" method="POST" class="d-inline" onsubmit="return confirm('Xác nhận đã thanh toán lương cho <%= s.ten %>?')">
                      <button type="submit" class="btn btn-sm btn-success" title="Xác nhận chi">
                        <i class="fas fa-check"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- BẢNG NHẬT KÝ CHẤM CÔNG THÁNG (ACCORDION) -->
  <div class="table-salary-wrap mb-5">
    <div class="p-3 d-flex justify-content-between align-items-center bg-white cursor-pointer" data-toggle="collapse" data-target="#collapseAttendance" style="cursor: pointer;">
      <h6 class="m-0 font-weight-bold" style="color: #241a14;">
        <i class="fas fa-user-clock text-warning mr-2"></i>Nhật ký Chấm công Chi tiết Tháng <%= month %>/<%= year %>
        <span class="badge badge-pill badge-light border text-muted ml-2 px-2 py-1"><%= attList ? attList.length : 0 %> lượt ghi nhận</span>
      </h6>
      <span class="small font-weight-bold" style="color: #a8822f;"><i class="fas fa-chevron-down mr-1"></i> Bấm để xem/thu gọn</span>
    </div>
    <div id="collapseAttendance" class="collapse">
      <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
        <table class="table table-bordered table-striped table-hover small mb-0">
          <thead class="bg-light sticky-top">
            <tr>
              <th>Ngày</th>
              <th>Nhân viên</th>
              <th>Chức vụ</th>
              <th>Giờ vào</th>
              <th>Giờ ra</th>
              <th class="text-center">Tổng giờ</th>
            </tr>
          </thead>
          <tbody>
            <% if (!attList || attList.length === 0) { %>
              <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu chấm công trong tháng này.</td></tr>
            <% } else { %>
              <% attList.forEach(a => { 
                  const d = a.ngay ? new Date(a.ngay) : null;
                  const dateStr = d ? `${('0'+d.getDate()).slice(-2)}/${('0'+(d.getMonth()+1)).slice(-2)}/${d.getFullYear()}` : '-';
                  const vaoStr = a.gio_vao ? new Date(a.gio_vao).toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'}) : '--:--';
                  const raStr = a.gio_ra ? new Date(a.gio_ra).toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'}) : '--:--';
              %>
                <tr>
                  <td class="font-weight-bold"><%= dateStr %></td>
                  <td class="font-weight-bold" style="color: #241a14;"><%= a.ten %></td>
                  <td><%= a.chucvu %></td>
                  <td class="text-success font-weight-bold"><i class="fas fa-arrow-right-to-bracket mr-1"></i><%= vaoStr %></td>
                  <td class="text-danger font-weight-bold"><i class="fas fa-arrow-right-from-bracket mr-1"></i><%= raStr %></td>
                  <td class="text-center font-weight-bold"><%= a.tong_gio != null ? a.tong_gio : '0' %> h</td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<!-- Modal Thiết lập / Sửa Nhanh Lương -->
<div class="modal fade" id="setupSalaryModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 14px; overflow: hidden;">
      <form action="/staff/accountant/salary/upsert" method="POST" id="salaryForm">
        <div class="modal-header text-white py-3" style="background: linear-gradient(135deg, #241a14, #3d2b21); border-bottom: 2px solid #c8a24b;">
          <h5 class="modal-title font-weight-bold" id="modalTitle" style="font-family: var(--qt-serif);">
            <i class="fas fa-edit mr-2 text-warning"></i>Thiết lập Lương Nhân Viên
          </h5>
          <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body p-4">
          <input type="hidden" name="thang" value="<%= month %>">
          <input type="hidden" name="nam" value="<%= year %>">
          
          <div class="form-group">
            <label class="font-weight-bold text-dark">Nhân viên <span class="text-danger">*</span></label>
            <select name="id_nv" id="modal_id_nv" class="form-control font-weight-bold" required>
              <% stList.forEach(st => { %>
                <option value="<%= st.id_nv %>"><%= st.ten %> (<%= st.chucvu %>)</option>
              <% }) %>
            </select>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label class="font-weight-bold text-dark">Lương cơ bản</label>
                <div class="input-group">
                  <input type="number" name="luong_cung" id="modal_luong_cung" class="form-control font-weight-bold" placeholder="0" min="0" required oninput="calcTotal()" />
                  <div class="input-group-append"><span class="input-group-text">đ</span></div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label class="font-weight-bold text-dark">Số ngày công thực tế</label>
                <input type="number" step="0.5" name="so_ngay_cong" id="modal_so_ngay_cong" class="form-control font-weight-bold" placeholder="26" value="26" min="0" max="31" />
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-4">
              <div class="form-group">
                <label class="font-weight-bold text-success">Thưởng (+)</label>
                <input type="number" name="thuong" id="modal_thuong" class="form-control" value="0" min="0" oninput="calcTotal()" />
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label class="font-weight-bold text-info">Phụ cấp (+)</label>
                <input type="number" name="phu_cap" id="modal_phu_cap" class="form-control" value="0" min="0" oninput="calcTotal()" />
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label class="font-weight-bold text-danger">Phạt (-)</label>
                <input type="number" name="phat" id="modal_phat" class="form-control" value="0" min="0" oninput="calcTotal()" />
              </div>
            </div>
          </div>

          <!-- Preview Tổng thực nhận -->
          <div class="p-3 rounded-lg mt-3 text-right" style="background: #faf6f0; border: 1px solid #e7ded0;">
            <span class="text-muted font-weight-bold mr-2">Tổng thực lĩnh chuyển khoản:</span>
            <span class="h5 font-weight-bold mb-0" id="preview_tong_luong" style="color: #a8822f;">0 đ</span>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary font-weight-bold" data-dismiss="modal">Hủy</button>
          <button type="submit" class="btn font-weight-bold px-4 text-white" style="background: linear-gradient(135deg, #241a14, #3d2b21); border: 1px solid #c8a24b;">
            <i class="fas fa-save mr-1 text-warning"></i> Lưu Bảng Lương
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Xuất Excel -->
<div class="modal fade" id="exportExcelModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 14px; overflow: hidden;">
      <form action="/staff/accountant/attendance/export" method="GET">
        <div class="modal-header text-white py-3" style="background: linear-gradient(135deg, #241a14, #3d2b21); border-bottom: 2px solid #c8a24b;">
          <h5 class="modal-title font-weight-bold"><i class="fas fa-file-excel mr-2 text-success"></i> Xuất Báo Cáo Chấm Công &amp; Lương</h5>
          <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body p-4">
          <p class="text-muted small">Tải xuống báo cáo chi tiết chấm công và bảng lương tổng hợp theo định dạng Excel CSV có dấu UTF-8.</p>
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label class="font-weight-bold">Tháng</label>
                <select name="month" class="form-control font-weight-bold">
                  <% for(let m = 1; m <= 12; m++) { %>
                    <option value="<%= m %>" <%= m == month ? 'selected' : '' %>>Tháng <%= m %></option>
                  <% } %>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label class="font-weight-bold">Năm</label>
                <select name="year" class="form-control font-weight-bold">
                  <% for(let y = 2024; y <= 2027; y++) { %>
                    <option value="<%= y %>" <%= y == year ? 'selected' : '' %>>Năm <%= y %></option>
                  <% } %>
                </select>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary font-weight-bold" data-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-success font-weight-bold px-4"><i class="fas fa-download mr-1"></i> Tải xuống</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function filterTable(status, btn) {
    $('.filter-pill-btn').removeClass('active');
    $(btn).addClass('active');

    if (status === 'all') {
      $('.salary-row').show();
    } else {
      $('.salary-row').hide();
      $('.salary-row[data-status="' + status + '"]').show();
    }
  }

  function openQuickEdit(s) {
    $('#modalTitle').html('<i class="fas fa-edit mr-2 text-warning"></i>Sửa Lương: ' + s.ten);
    $('#modal_id_nv').val(s.id_nv).prop('disabled', true);
    if ($('#hidden_id_nv').length === 0) {
      $('#salaryForm').append('<input type="hidden" name="id_nv" id="hidden_id_nv" value="' + s.id_nv + '">');
    } else {
      $('#hidden_id_nv').val(s.id_nv);
    }
    $('#modal_luong_cung').val(s.luong_cung || 0);
    $('#modal_so_ngay_cong').val(s.so_ngay_cong || s.songaycong || 0);
    $('#modal_thuong').val(s.thuong || 0);
    $('#modal_phu_cap').val(s.phu_cap || 0);
    $('#modal_phat').val(s.phat || 0);
    calcTotal();
    $('#setupSalaryModal').modal('show');
  }

  function calcTotal() {
    var c = parseFloat($('#modal_luong_cung').val()) || 0;
    var t = parseFloat($('#modal_thuong').val()) || 0;
    var pc = parseFloat($('#modal_phu_cap').val()) || 0;
    var p = parseFloat($('#modal_phat').val()) || 0;
    var total = c + t + pc - p;
    $('#preview_tong_luong').text(total.toLocaleString('vi-VN') + ' đ');
  }

  $('#setupSalaryModal').on('hidden.bs.modal', function () {
    $('#modal_id_nv').prop('disabled', false);
    $('#hidden_id_nv').remove();
    $('#modalTitle').html('<i class="fas fa-edit mr-2 text-warning"></i>Thiết lập Lương Nhân Viên');
  });
</script>

<%- include('../partials/footer') %>
