<%
  var activePage = 'leave-manage';
  var staffName = session.staffName || 'Kế toán';
%>
<%- include('../partials/header') %>

<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-calendar-minus mr-2"></i> Quản lý Nghỉ phép</h1>
    </div>
    <div class="col-md-4 text-right">
        <button class="btn btn-primary shadow-sm" data-toggle="modal" data-target="#requestLeaveModal"><i class="fas fa-plus"></i> Xin nghỉ phép</button>
    </div>
</div>

<% if (typeof msg !== 'undefined' && msg) { %>
<div class="alert alert-<%= msgType || 'info' %> alert-dismissible fade show shadow-sm" role="alert">
    <i class="fas fa-info-circle mr-2"></i><%= msg %>
    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
</div>
<% } %>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách Đơn xin nghỉ phép (Toàn bộ nhân sự)</h6>
        <span class="badge badge-warning"><%= leaves.filter(l => l.trang_thai == 0).length %> đơn chờ duyệt</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover" width="100%" cellspacing="0">
                <thead class="bg-light">
                    <tr>
                        <th width="150px">Nhân viên</th>
                        <th>Chức vụ</th>
                        <th>Lý do</th>
                        <th>Từ ngày</th>
                        <th>Đến ngày</th>
                        <th>Ngày gửi</th>
                        <th>Trạng thái</th>
                        <th width="160px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (leaves.length === 0) { %>
                        <tr><td colspan="8" class="text-center py-4 text-muted">Chưa có dữ liệu nghỉ phép.</td></tr>
                    <% } %>
                    <% leaves.forEach(l => { %>
                    <tr>
                        <td class="font-weight-bold"><%= l.ten_nhanvien %></td>
                        <td><small class="text-muted"><%= l.chucvu %></small></td>
                        <td><%= l.ly_do %></td>
                        <td><%= l.ngay_bat_dau ? new Date(l.ngay_bat_dau).toLocaleDateString('vi-VN') : '-' %></td>
                        <td><%= l.ngay_ket_thuc ? new Date(l.ngay_ket_thuc).toLocaleDateString('vi-VN') : '-' %></td>
                        <td><small><%= l.created_at ? new Date(l.created_at).toLocaleDateString('vi-VN') : '-' %></small></td>
                        <td>
                            <% if(l.trang_thai == 0) { %>
                                <span class="badge badge-warning"><i class="fas fa-clock mr-1"></i>Chờ duyệt</span>
                            <% } else if(l.trang_thai == 1) { %>
                                <span class="badge badge-success"><i class="fas fa-check mr-1"></i>Đã chấp thuận</span>
                            <% } else { %>
                                <span class="badge badge-danger"><i class="fas fa-times mr-1"></i>Từ chối</span>
                            <% } %>
                        </td>
                        <td>
                            <% if(l.trang_thai == 0) { %>
                            <form action="/staff/accountant/leave/approve/<%= l.id_np %>" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success shadow-sm" title="Duyệt đơn nghỉ" onclick="return confirm('Xác nhận duyệt đơn nghỉ phép của <%= l.ten_nhanvien %>?')">
                                    <i class="fas fa-check"></i> Duyệt
                                </button>
                            </form>
                            <form action="/staff/accountant/leave/reject/<%= l.id_np %>" method="POST" class="d-inline ml-1">
                                <button type="submit" class="btn btn-sm btn-danger shadow-sm" title="Từ chối" onclick="return confirm('Xác nhận từ chối đơn nghỉ phép của <%= l.ten_nhanvien %>?')">
                                    <i class="fas fa-times"></i> Từ chối
                                </button>
                            </form>
                            <% } else { %>
                            <span class="text-muted small">Đã xử lý</span>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Request Leave Modal -->
<div class="modal fade" id="requestLeaveModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/staff/accountant/leave/add" method="POST">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title">Lập phiếu xin nghỉ phép</h5>
          <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label>Lý do nghỉ</label>
            <textarea name="ly_do" class="form-control" rows="3" required placeholder="Ghi rõ lý do xin nghỉ phép..."></textarea>
          </div>
          <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                    <label>Từ ngày</label>
                    <input type="date" name="ngay_bat_dau" id="ngay_bat_dau_acc" class="form-control" required />
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                    <label>Đến ngày</label>
                    <input type="date" name="ngay_ket_thuc" id="ngay_ket_thuc_acc" class="form-control" required />
                </div>
              </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary">Gửi đơn xin nghỉ</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
const todayAcc = new Date().toISOString().split('T')[0];
const startDateAcc = document.getElementById('ngay_bat_dau_acc');
const endDateAcc = document.getElementById('ngay_ket_thuc_acc');
if (startDateAcc) startDateAcc.setAttribute('min', todayAcc);
if (endDateAcc) endDateAcc.setAttribute('min', todayAcc);
if (startDateAcc) startDateAcc.addEventListener('change', function() {
    endDateAcc.setAttribute('min', this.value);
    if (endDateAcc.value && endDateAcc.value < this.value) {
        endDateAcc.value = this.value;
    }
});
</script>

<%- include('../partials/footer') %>
