<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Phiếu Lương - <%= s.ten %> (T<%= s.thang %>/<%= s.nam %>)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    :root {
      --espresso: #241a14;
      --gold: #c8a24b;
      --gold-dark: #9e7d30;
      --cream: #fbf8f4;
      --ink: #1f1a16;
      --line: #e7ded0;
    }
    * { box-sizing: border-box; }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      padding: 30px;
      color: var(--ink);
      line-height: 1.6;
      background: #f4efe9;
      font-size: 14px;
    }
    .slip-container {
      max-width: 720px;
      margin: 0 auto;
      background: #fff;
      padding: 40px 48px;
      border-radius: 14px;
      box-shadow: 0 10px 30px rgba(36, 26, 20, 0.12);
      border: 1px solid var(--line);
      position: relative;
    }
    .slip-container::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 6px;
      background: linear-gradient(90deg, var(--espresso), var(--gold));
      border-radius: 14px 14px 0 0;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--line);
      padding-bottom: 20px;
      margin-bottom: 24px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand-logo {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, var(--gold), var(--gold-dark));
      border-radius: 10px;
      display: grid;
      place-items: center;
      color: #fff;
      font-size: 20px;
    }
    .brand-name {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 20px;
      font-weight: 700;
      color: var(--espresso);
      line-height: 1.2;
    }
    .brand-sub {
      font-size: 11.5px;
      color: #8a7a6c;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .title-box {
      text-align: right;
    }
    .title-box h1 {
      margin: 0;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 18px;
      color: var(--espresso);
    }
    .title-box .period {
      font-size: 13px;
      font-weight: 700;
      color: var(--gold-dark);
      margin-top: 2px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px 24px;
      background: #faf6f0;
      padding: 16px 20px;
      border-radius: 10px;
      border: 1px solid var(--line);
      margin-bottom: 24px;
      font-size: 13.5px;
    }
    .info-item {
      display: flex;
      justify-content: space-between;
    }
    .info-label { color: #6b5f54; font-weight: 500; }
    .info-val { font-weight: 700; color: var(--espresso); }

    .salary-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 24px;
    }
    .salary-table th {
      background: var(--espresso);
      color: #fff;
      font-weight: 600;
      padding: 10px 14px;
      text-align: left;
      font-size: 12.5px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .salary-table th:last-child { text-align: right; }
    .salary-table td {
      padding: 11px 14px;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
    }
    .salary-table td.num {
      text-align: right;
      font-variant-numeric: tabular-nums;
      font-weight: 600;
    }
    .salary-table tr.total-row {
      background: #fdf6e7;
      font-size: 15px;
    }
    .salary-table tr.total-row td {
      border-top: 2px solid var(--gold);
      border-bottom: 2px solid var(--gold);
      font-weight: 800;
      color: var(--espresso);
    }
    .salary-table tr.total-row td.num {
      color: #a8822f;
      font-size: 18px;
    }

    .footer {
      display: flex;
      justify-content: space-between;
      margin-top: 40px;
      padding-top: 10px;
    }
    .sign-box {
      text-align: center;
      width: 200px;
    }
    .sign-title {
      font-weight: 700;
      color: var(--espresso);
    }
    .sign-hint {
      font-size: 11.5px;
      color: #8a7a6c;
      font-style: italic;
      margin-top: 2px;
    }
    .sign-space {
      height: 70px;
    }
    .sign-line {
      border-top: 1px dashed #b5a898;
    }

    .no-print {
      max-width: 720px;
      margin: 0 auto 16px;
      display: flex;
      gap: 10px;
      justify-content: flex-end;
    }
    .btn {
      padding: 9px 18px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 13.5px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border: 1px solid transparent;
      text-decoration: none;
    }
    .btn-print { background: var(--espresso); color: #fff; border-color: var(--gold); }
    .btn-print:hover { background: #3d2b21; }
    .btn-back { background: #fff; color: var(--espresso); border-color: var(--line); }

    @media print {
      body { background: #fff; padding: 0; }
      .no-print { display: none !important; }
      .slip-container {
        box-shadow: none;
        border: none;
        padding: 20px 0;
        max-width: 100%;
      }
    }
  </style>
</head>
<body>

  <div class="no-print">
    <a href="javascript:history.back()" class="btn btn-back">
      <i class="fas fa-arrow-left"></i> Quay lại
    </a>
    <button onclick="window.print()" class="btn btn-print">
      <i class="fas fa-print"></i> In Phiếu Lương
    </button>
  </div>

  <div class="slip-container">
    <div class="header">
      <div class="brand">
        <div class="brand-logo">
          <i class="fas fa-utensils"></i>
        </div>
        <div>
          <div class="brand-name">Nhà Hàng Bảo Đoàn</div>
          <div class="brand-sub">Hệ thống Quản lý F&B Cao Cấp</div>
        </div>
      </div>
      <div class="title-box">
        <h1>PHIẾU LƯƠNG NHÂN VIÊN</h1>
        <div class="period">Kỳ lương: Tháng <%= s.thang %> / <%= s.nam %></div>
      </div>
    </div>

    <div class="info-grid">
      <div class="info-item">
        <span class="info-label">Mã nhân viên:</span>
        <span class="info-val">NV<%= s.id_nv %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Chức vụ / Vị trí:</span>
        <span class="info-val"><%= s.chucvu || s.ten_cd || 'Nhân viên' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Họ và tên:</span>
        <span class="info-val"><%= s.ten %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Ngày xuất phiếu:</span>
        <span class="info-val"><%= new Date().toLocaleDateString('vi-VN') %></span>
      </div>
    </div>

    <table class="salary-table">
      <thead>
        <tr>
          <th>Khoản mục thu nhập &amp; khấu trừ</th>
          <th>Chi tiết / Ghi chú</th>
          <th>Số tiền (VNĐ)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><b>Lương cơ bản theo công thực tế</b></td>
          <td style="color:#6b5f54">Ngày công chuẩn: <%= s.so_ngay_cong || s.songaycong || 26 %>/26 công</td>
          <td class="num"><%= Number(s.luong_cung || 0).toLocaleString('vi-VN') %> đ</td>
        </tr>
        <tr>
          <td><b>Phụ cấp chế độ</b></td>
          <td style="color:#6b5f54">Ăn trưa, xăng xe đi lại, hỗ trợ ca</td>
          <td class="num" style="color:#2e7d4f">+<%= Number(s.phu_cap || 0).toLocaleString('vi-VN') %> đ</td>
        </tr>
        <tr>
          <td><b>Khen thưởng / Thưởng hiệu suất</b></td>
          <td style="color:#6b5f54">Thưởng chuyên cần, KPI dịch vụ</td>
          <td class="num" style="color:#2e7d4f">+<%= Number(s.thuong || 0).toLocaleString('vi-VN') %> đ</td>
        </tr>
        <% if (Number(s.phat || 0) > 0) { %>
        <tr>
          <td><b>Các khoản khấu trừ / Phạt</b></td>
          <td style="color:#6b5f54">Vi phạm quy định, đi trễ hoặc hao hụt</td>
          <td class="num" style="color:#b3352c">-<%= Number(s.phat || 0).toLocaleString('vi-VN') %> đ</td>
        </tr>
        <% } %>
        <tr class="total-row">
          <td colspan="2"><b>TỔNG THỰC LĨNH CHUYỂN KHOẢN</b></td>
          <td class="num"><b><%= Number(s.tong_luong || 0).toLocaleString('vi-VN') %> VNĐ</b></td>
        </tr>
      </tbody>
    </table>

    <div class="footer">
      <div class="sign-box">
        <div class="sign-title">Người nhận lương</div>
        <div class="sign-hint">(Ký và ghi rõ họ tên)</div>
        <div class="sign-space"></div>
        <div class="sign-line"></div>
      </div>
      <div class="sign-box">
        <div class="sign-title">Kế toán trưởng / Quản lý</div>
        <div class="sign-hint">(Ký duyệt và đóng dấu)</div>
        <div class="sign-space"></div>
        <div class="sign-line"></div>
      </div>
    </div>
  </div>

</body>
</html>
