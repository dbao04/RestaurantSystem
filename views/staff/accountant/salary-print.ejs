<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Phiếu Lương - <%= s.ten %></title>
    <style>
        body { font-family: Arial, sans-serif; padding: 40px; color: #333; line-height: 1.6; }
        .header { text-align: center; margin-bottom: 40px; border-bottom: 2px solid #4e73df; padding-bottom: 20px; }
        .company-name { font-size: 24px; font-weight: bold; color: #4e73df; }
        .report-title { font-size: 20px; font-weight: bold; margin-top: 10px; }
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 40px; }
        .info-item { margin-bottom: 10px; }
        .salary-details { width: 100%; border-collapse: collapse; margin-bottom: 40px; }
        .salary-details th, .salary-details td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        .salary-details th { background-color: #f8f9fc; }
        .total-row { font-size: 20px; font-weight: bold; background-color: #eee !important; }
        .footer { margin-top: 60px; display: flex; justify-content: space-between; }
        .signature-box { text-align: center; width: 200px; }
        .signature-line { margin-top: 80px; border-top: 1px solid #333; }
        @media print {
            .no-print { display: none; }
            body { padding: 0; }
        }
    </style>
</head>
<body>
    <div class="no-print" style="margin-bottom: 20px;">
        <button onclick="window.print()" style="padding: 10px 20px; background: #4e73df; color: white; border: none; border-radius: 4px; cursor: pointer;">In Phiếu Lương</button>
        <button onclick="window.history.back()" style="padding: 10px 20px; background: #858796; color: white; border: none; border-radius: 4px; cursor: pointer; margin-left: 10px;">Quay lại</button>
    </div>

    <div class="header">
        <div class="company-name">NHÀ HÀNG BD</div>
        <div class="report-title">PHIẾU LƯƠNG NHÂN VIÊN</div>
        <div>Tháng <%= s.thang %> Năm <%= s.nam %></div>
    </div>

    <div class="info-grid">
        <div>
            <div class="info-item"><strong>Họ tên:</strong> <%= s.ten %></div>
            <div class="info-item"><strong>Mã NV:</strong> NV<%= s.id_nv %></div>
        </div>
        <div>
            <div class="info-item"><strong>Chức vụ:</strong> <%= s.chucvu %></div>
            <div class="info-item"><strong>Ngày in:</strong> <%= new Date().toLocaleDateString('vi-VN') %></div>
        </div>
    </div>

    <table class="salary-details">
        <thead>
            <tr>
                <th>Danh mục</th>
                <th style="text-align: right;">Số tiền (VND)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Lương cơ bản (Lương cứng)</td>
                <td style="text-align: right;"><%= s.luong_cung.toLocaleString('vi-VN') %></td>
            </tr>
            <tr>
                <td>Khen thưởng / Bonus</td>
                <td style="text-align: right;"><%= s.thuong.toLocaleString('vi-VN') %></td>
            </tr>
            <tr>
                <td>Phụ cấp (Xăng xe, ăn uống)</td>
                <td style="text-align: right;"><%= s.phu_cap.toLocaleString('vi-VN') %></td>
            </tr>
            <tr class="total-row">
                <td>TỔNG THỰC LĨNH</td>
                <td style="text-align: right;"><%= s.tong_luong.toLocaleString('vi-VN') %></td>
            </tr>
        </tbody>
    </table>

    <div class="footer">
        <div class="signature-box">
            <div><strong>Người nhận lương</strong></div>
            <div style="font-size: 12px; font-style: italic;">(Ký và ghi rõ họ tên)</div>
            <div class="signature-line"></div>
        </div>
        <div class="signature-box">
            <div><strong>Kế toán trưởng</strong></div>
            <div style="font-size: 12px; font-style: italic;">(Ký và đóng dấu)</div>
            <div class="signature-line"></div>
        </div>
    </div>

    <script>
        // Tự động mở hộp thoại in nếu không phải dev mode
        // window.onload = () => window.print();
    </script>
</body>
</html>
