<%
  var activePage = 'staff-manage';
  var staffName = session.staffName || 'Kế toán';
%>
<%- include('../partials/header') %>

<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-users-cog mr-2"></i> Danh sách Nhân sự Hệ thống</h1>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách Toàn bộ Nhân viên</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped" width="100%" cellspacing="0">
                <thead class="bg-light">
                    <tr>
                        <th>Tên nhân viên</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Chức vụ</th>
                        <th>Ngày gia nhập</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% staff.forEach(s => { %>
                    <tr>
                        <td class="font-weight-bold"><%= s.ten %></td>
                        <td><%= s.sodienthoai %></td>
                        <td><%= s.email %></td>
                        <td><span class="badge badge-secondary"><%= s.chucvu %></span></td>
                        <td><%= new Date(s.created_at).toLocaleDateString('vi-VN') %></td>
                        <td>
                            <% if(s.trangthai == 1) { %>
                                <span class="badge badge-success">Đang làm việc</span>
                            <% } else { %>
                                <span class="badge badge-danger">Đã nghỉ việc</span>
                            <% } %>
                        </td>
                        <td>
                            <form action="/staff/accountant/staff/delete/<%= s.id_nv %>" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa nhân sự này? Thao tác này không thể hoàn tác.')">
                                <button type="submit" class="btn btn-sm btn-circle btn-outline-danger shadow-sm"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
