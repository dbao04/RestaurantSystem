<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Báo cáo Thu chi - Tháng <%= month %>/<%= year %></title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 50px; color: #444; line-height: 1.6; }
        .header { text-align: center; margin-bottom: 50px; }
        .company-info { font-size: 14px; margin-bottom: 5px; }
        .report-title { font-size: 26px; font-weight: bold; color: #333; margin-top: 10px; }
        .report-period { font-size: 18px; margin-bottom: 30px; }
        .summary-grid { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 40px; }
        .box { flex: 1; padding: 15px; border: 1px solid #ddd; background: #fdfdfd; border-radius: 5px; text-align: center; }
        .box-title { font-size: 12px; color: #666; text-transform: uppercase; margin-bottom: 10px; }
        .box-value { font-size: 20px; font-weight: bold; }
        .details-table { width: 100%; border-collapse: collapse; margin-bottom: 40px; }
        .details-table th, .details-table td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        .details-table th { background: #f3f3f3; font-weight: bold; }
        .profit-pos { color: green; font-weight: bold; }
        .profit-neg { color: red; font-weight: bold; }
        .footer { margin-top: 80px; display: flex; justify-content: space-around; }
        .signature-box { text-align: center; width: 250px; }
        .signature-line { margin-top: 90px; border-top: 1px dashed #777; }
        @media print {
            .no-print { display: none; }
            body { padding: 0px 20px; }
            .box { background: white; border: 1px solid #333; }
        }
    </style>
</head>
<body>
    <div class="no-print" style="margin-bottom: 30px; text-align: center;">
        <button onclick="window.print()" style="padding: 12px 24px; font-size: 16px; background: #28a745; color: white; border: none; border-radius: 5px; cursor: pointer; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <i class="fas fa-print"></i> XÁC NHẬN IN BÁO CÁO
        </button>
        <button onclick="window.history.back()" style="padding: 12px 24px; font-size: 16px; background: #6c757d; color: white; border: none; border-radius: 5px; cursor: pointer; margin-left: 20px;">
            HỦY (QUAY LẠI)
        </button>
    </div>

    <div class="header">
        <div class="company-info">Nhà Hàng Bảo Đoàn - CHI NHÁNH GÒ VẤP</div>
        <div class="report-title">BÁO CÁO KẾT QUẢ KINH DOANH</div>
        <div class="report-period">Kỳ báo cáo: Tháng <%= month %> năm <%= year %></div>
    </div>

    <div class="summary-grid">
        <div class="box">
            <div class="box-title">Tổng Doanh thu</div>
            <div class="box-value text-success"><%= report.revenue.toLocaleString('vi-VN') %>đ</div>
        </div>
        <div class="box">
            <div class="box-title">Tổng Chi phí</div>
            <div class="box-value text-danger">
                <%= (report.inventoryCosts + report.salaryCosts + report.otherExpenses).toLocaleString('vi-VN') %>đ
            </div>
        </div>
        <div class="box">
            <div class="box-title">Lợi nhuận ròng</div>
            <div class="box-value <%= report.netProfit >= 0 ? 'profit-pos' : 'profit-neg' %>">
                <%= report.netProfit.toLocaleString('vi-VN') %>đ
            </div>
        </div>
    </div>

    <h3>I. CHI TIẾT DOANH THU & CHI PHÍ</h3>
    <table class="details-table">
        <thead>
            <tr>
                <th>STT</th>
                <th>Mục (Hạng mục thu chi)</th>
                <th style="text-align: right;">Số tiền (VND)</th>
                <th>Ghi chú phát sinh</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>01</td>
                <td>Doanh thu bán hàng (Hóa đơn tại quầy & Online)</td>
                <td style="text-align: right;"><%= report.revenue.toLocaleString('vi-VN') %></td>
                <td>Đã hoàn thành</td>
            </tr>
            <tr>
                <td>02</td>
                <td>Chi phí nhập hàng (Nguyên vật liệu)</td>
                <td style="text-align: right;">-<%= report.inventoryCosts.toLocaleString('vi-VN') %></td>
                <td>Đã đối soát kho</td>
            </tr>
            <tr>
                <td>03</td>
                <td>Chi phí quỹ lương (Nhân sự)</td>
                <td style="text-align: right;">-<%= report.salaryCosts.toLocaleString('vi-VN') %></td>
                <td>Dựa trên bảng lương đã chốt</td>
            </tr>
            <tr>
                <td>04</td>
                <td>Các khoản chi phí khác (Điện, nước, mặt bằng...)</td>
                <td style="text-align: right;">-<%= report.otherExpenses.toLocaleString('vi-VN') %></td>
                <td>Theo phiếu chi phát sinh</td>
            </tr>
            <tr style="background: #fdfdfd; font-weight: bold;">
                <td colspan="2" style="text-align: center; text-transform: uppercase;">Kết quả lợi nhuận sau cùng</td>
                <td style="text-align: right;"><%= report.netProfit.toLocaleString('vi-VN') %></td>
                <td><%= report.netProfit >= 0 ? 'Dương (+) Lãi' : 'Âm (-) Lỗ' %></td>
            </tr>
        </tbody>
    </table>

    <div class="footer">
        <div class="signature-box">
            <div><strong>Người lập biểu</strong></div>
            <div style="font-size: 13px; font-style: italic;">(Ký và ghi rõ họ tên)</div>
            <div class="signature-line"></div>
        </div>
        <div class="signature-box">
            <div><strong>Phê duyệt (Giám đốc)</strong></div>
            <div style="font-size: 13px; font-style: italic;">(Ký, đóng dấu công ty)</div>
            <div class="signature-line"></div>
        </div>
    </div>

    <p style="margin-top: 50px; font-size: 12px; color: #999; text-align: center;">
        In tại Hệ thống Quản trị Nhà Hàng Bảo Đoàn | Thời gian in: <%= new Date().toLocaleString('vi-VN') %> | Bản in chính thức.
    </p>
</body>
</html>
