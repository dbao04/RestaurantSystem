<%
  var activePage = 'attendance';
  var staffName = session.staffName || 'Kế toán';
%>
<%- include('../partials/header') %>

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-user-check mr-2"></i> Theo dõi Chấm công toàn bộ nhân viên</h1>
    </div>
    <div class="col-md-4 text-right">
        <form class="form-inline justify-content-end" method="GET" action="/staff/accountant/attendance">
            <input type="date" name="date" class="form-control mr-2" value="<%= date %>">
            <button type="submit" class="btn btn-primary">Xem ngày</button>
        </form>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-dark text-white">
        <h6 class="m-0 font-weight-bold">Tình trạng đi làm ngày <%= new Date(date).toLocaleDateString('vi-VN') %></h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="bg-light">
                    <tr>
                        <th>Nhân viên</th>
                        <th>Chức vụ</th>
                        <th>Giờ vào</th>
                        <th>Giờ ra</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    <% logs.forEach(l => { %>
                    <tr>
                        <td class="font-weight-bold"><%= l.ten %></td>
                        <td><%= l.chucvu %></td>
                        <td>
                            <% if(l.gio_vao) { %>
                                <span class="badge badge-primary"><%= formatTime(l.gio_vao) %></span>
                            <% } else { %>
                                <span class="text-muted">--:--</span>
                            <% } %>
                        </td>
                        <td>
                            <% if(l.gio_ra) { %>
                                <span class="badge badge-info"><%= formatTime(l.gio_ra) %></span>
                            <% } else { %>
                                <span class="text-muted">--:--</span>
                            <% } %>
                        </td>
                        <td>
                            <% if(l.gio_vao && l.gio_ra) { %>
                                <span class="badge badge-success">Đã hoàn thành</span>
                            <% } else if(l.gio_vao) { %>
                                <span class="badge badge-warning">Đang làm việc</span>
                            <% } else { %>
                                <span class="badge badge-danger">Vắng / Chưa check-in</span>
                            <% } %>
                        </td>
                        <td>
                             <% if(!l.gio_vao) { %>
                                <span class="text-danger small">Cần kiểm tra lý do vắng</span>
                             <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="alert alert-warning shadow-sm border-left-warning">
            <i class="fas fa-exclamation-circle mr-2"></i> Lưu ý dành cho Kế toán: Dữ liệu này được dùng để đối soát khi chốt lương tháng. Các trường hợp vắng không phép hoặc đi muộn cần được ghi chú lại.
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
