<%
  var activePage = 'bao-cao-phuc-vu';
  var staffName = session.staffName || 'Nhân viên';

  var soDaDuyet = danhSach.filter(function(b) { return b.trang_thai === 'DA_DUYET'; }).length;
  var soChoDuyet = danhSach.filter(function(b) { return b.trang_thai === 'CHO_DUYET'; }).length;
  var soSuCo = danhSach.filter(function(b) { return b.su_co_phat_sinh && b.su_co_phat_sinh.trim().length > 0; }).length;
%>
<%- include('partials/header') %>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h3 mb-1 text-gray-800"><i class="fas fa-list-check text-primary mr-2"></i> Lịch sử Báo cáo Cuối ngày Phục vụ</h1>
    <div class="small text-muted">
      <%= laQuanLy ? 'Quản lý có thể theo dõi toàn bộ báo cáo ca làm, sự cố và duyệt đánh giá của nhân viên phục vụ.' : 'Danh sách các báo cáo ca làm bạn đã gửi cho Quản lý.' %>
    </div>
  </div>
  <div>
    <a href="/staff/phuc-vu/bao-cao" class="btn btn-sm btn-primary shadow-sm">
      <i class="fas fa-plus mr-1"></i> Tạo báo cáo mới
    </a>
  </div>
</div>

<!-- Thống kê nhanh -->
<div class="row mb-4">
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card border-left-primary shadow h-100 py-2"><div class="card-body py-2">
      <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng số báo cáo</div>
      <div class="h5 mb-0 font-weight-bold text-gray-800"><%= danhSach.length %></div>
    </div></div>
  </div>
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card border-left-warning shadow h-100 py-2"><div class="card-body py-2">
      <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Chờ Quản lý duyệt</div>
      <div class="h5 mb-0 font-weight-bold text-gray-800"><%= soChoDuyet %></div>
    </div></div>
  </div>
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card border-left-success shadow h-100 py-2"><div class="card-body py-2">
      <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Đã được duyệt</div>
      <div class="h5 mb-0 font-weight-bold text-gray-800"><%= soDaDuyet %></div>
    </div></div>
  </div>
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card border-left-danger shadow h-100 py-2"><div class="card-body py-2">
      <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Ca có sự cố phát sinh</div>
      <div class="h5 mb-0 font-weight-bold text-gray-800"><%= soSuCo %></div>
    </div></div>
  </div>
</div>

<!-- Bộ lọc & Bảng danh sách -->
<div class="card shadow mb-4">
  <div class="card-header py-3">
    <form class="form-inline" method="get" action="/staff/phuc-vu/bao-cao/lich-su">
      <label class="small text-muted mr-2 font-weight-bold">Từ ngày:</label>
      <input type="date" name="tu_ngay" class="form-control form-control-sm mr-3" value="<%= loc.tu_ngay || '' %>">
      
      <label class="small text-muted mr-2 font-weight-bold">Đến ngày:</label>
      <input type="date" name="den_ngay" class="form-control form-control-sm mr-3" value="<%= loc.den_ngay || '' %>">

      <label class="small text-muted mr-2 font-weight-bold">Trạng thái:</label>
      <select name="trang_thai" class="form-control form-control-sm mr-3">
        <option value="">-- Tất cả trạng thái --</option>
        <option value="CHO_DUYET" <%= loc.trang_thai === 'CHO_DUYET' ? 'selected' : '' %>>Chờ duyệt</option>
        <option value="DA_DUYET" <%= loc.trang_thai === 'DA_DUYET' ? 'selected' : '' %>>Đã duyệt</option>
        <option value="YEU_CAU_SUA" <%= loc.trang_thai === 'YEU_CAU_SUA' ? 'selected' : '' %>>Yêu cầu bổ sung</option>
      </select>

      <button type="submit" class="btn btn-sm btn-primary mr-2"><i class="fas fa-filter mr-1"></i> Lọc dữ liệu</button>
      <a href="/staff/phuc-vu/bao-cao/lich-su" class="btn btn-sm btn-outline-secondary">Đặt lại</a>
    </form>
  </div>

  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="thead-light">
          <tr>
            <th class="text-center" style="width: 60px;">#ID</th>
            <th>Ngày &amp; Ca làm</th>
            <% if (laQuanLy) { %><th>Nhân viên</th><% } %>
            <th class="text-center">Bàn / Khách</th>
            <th class="text-center">Đánh giá ca</th>
            <th>Sự cố / Ý kiến khách</th>
            <th class="text-center">Trạng thái</th>
            <th class="text-center">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (danhSach && danhSach.length > 0) { %>
            <% danhSach.forEach(function(b) { %>
              <tr>
                <td class="text-center font-weight-bold text-muted">#<%= b.id %></td>
                <td>
                  <div class="font-weight-bold text-dark"><%= new Date(b.ngay).toLocaleDateString('vi-VN') %></div>
                  <small class="badge badge-light border"><%= b.ca %></small>
                </td>
                <% if (laQuanLy) { %>
                  <td>
                    <div class="font-weight-bold text-primary"><%= b.ten_nv %></div>
                    <small class="text-muted"><%= b.ten_cd || 'Phục vụ' %> (<%= b.ma_nv %>)</small>
                  </td>
                <% } %>
                <td class="text-center">
                  <span class="badge badge-info"><%= b.so_ban_phuc_vu %> bàn</span><br>
                  <small class="text-muted font-weight-bold"><%= b.so_khach_phuc_vu %> khách</small>
                </td>
                <td class="text-center">
                  <% if (b.danh_gia_ca === 'Rất tốt') { %>
                    <span class="badge badge-success"><i class="fas fa-smile"></i> Rất tốt</span>
                  <% } else if (b.danh_gia_ca === 'Có sự cố') { %>
                    <span class="badge badge-danger"><i class="fas fa-triangle-exclamation"></i> Có sự cố</span>
                  <% } else { %>
                    <span class="badge badge-secondary"><i class="fas fa-meh"></i> Bình thường</span>
                  <% } %>
                </td>
                <td style="max-width:260px;">
                  <% if (b.su_co_phat_sinh) { %>
                    <div class="small text-danger"><i class="fas fa-exclamation-circle"></i> <b>Sự cố:</b> <%= b.su_co_phat_sinh.slice(0, 60) %><%= b.su_co_phat_sinh.length > 60 ? '...' : '' %></div>
                  <% } %>
                  <% if (b.phan_hoi_khach) { %>
                    <div class="small text-info"><i class="fas fa-comment"></i> <b>Ý kiến:</b> <%= b.phan_hoi_khach.slice(0, 60) %><%= b.phan_hoi_khach.length > 60 ? '...' : '' %></div>
                  <% } %>
                  <% if (!b.su_co_phat_sinh && !b.phan_hoi_khach) { %>
                    <span class="small text-muted font-italic">Không có ghi nhận</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <% if (b.trang_thai === 'DA_DUYET') { %>
                    <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle"></i> Đã duyệt</span>
                  <% } else if (b.trang_thai === 'YEU_CAU_SUA') { %>
                    <span class="badge badge-danger px-2 py-1"><i class="fas fa-times-circle"></i> Cần sửa</span>
                  <% } else { %>
                    <span class="badge badge-warning text-dark px-2 py-1"><i class="fas fa-clock"></i> Chờ duyệt</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <a href="/staff/phuc-vu/bao-cao/<%= b.id %>" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-eye mr-1"></i> Chi tiết
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="<%= laQuanLy ? 8 : 7 %>" class="text-center py-5 text-muted">
                <i class="fas fa-clipboard-list fa-3x mb-3 text-gray-300"></i>
                <p class="mb-0">Không có báo cáo nào phù hợp với bộ lọc.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
