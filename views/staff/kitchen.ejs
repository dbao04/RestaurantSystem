<%
  var activePage = 'kitchen';
  var staffName = session.staffName || 'Nhân viên';
  var unreadCount = unread || 0;
%>
<%- include('partials/header') %>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">
    <%= session.staffRole === 'Phuc vu' ? 'Món ăn đã sẵn sàng phục vụ' : 'Điều phối Món ăn (Bếp)' %>
  </h1>
</div>

<div class="row">
  <!-- MÓN ĐANG CHỜ CHẾ BIẾN (Chỉ hiện cho Đầu bếp & NV có quyền) -->
  <% if (session.staffRole === 'Bep' || session.staffRole === 'Ke toan') { %>
  <div class="col-lg-6 mb-4">
    <div class="card shadow mb-4 border-left-warning h-100">
      <div class="card-header py-3 bg-warning text-white d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold"><i class="fas fa-fire mr-2"></i> Bếp đang nấu (Chờ xử lý)</h6>
        <span class="badge badge-light"><%= orders.filter(o => o.trangthai_bep === 0).length %> món</span>
      </div>
      <div class="card-body">
        <% 
           let pendingOrders = orders.filter(o => o.trangthai_bep === 0);
           if(pendingOrders.length > 0) { 
        %>
          <div class="list-group">
            <% pendingOrders.forEach(o => { 
              let displayName = '';
              if (o.table_name) {
                displayName = 'Bàn: ' + o.table_name;
              } else if (o.ten_khach && o.ten_khach.startsWith('Bàn ')) {
                displayName = 'Bàn: ' + o.ten_khach.substring(4);
              } else {
                displayName = 'Bàn: Chưa gán (' + o.ten_khach + ')';
              }
            %>
              <div class="list-group-item d-flex justify-content-between align-items-center" id="order-row-<%= o.id %>">
                <div>
                  <h6 class="mb-1 font-weight-bold text-dark"><%= o.name_mon %> <span class="badge badge-primary badge-pill">x<%= o.soluong %></span></h6>
                  <p class="mb-0 text-muted small"><%= displayName %> | Đơn: <%= o.sesis.substring(0,6).toUpperCase() %></p>
                </div>
                <!-- Nút báo xong cho Bếp -->
                <% if (session.staffRole === 'Bep') { %>
                  <button type="button" class="btn btn-sm btn-success" title="Xác nhận xong" onclick="markDone('<%= o.id %>')">Báo xong</button>
                <% } %>
              </div>
            <% }) %>
          </div>
          <script>
            function markDone(id) {
              if(confirm('Xác nhận Bếp đã làm xong món này?')) {
                fetch('/staff/kitchen/mark-done/' + id, {
                  method: 'POST',
                  headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
                }).then(res => res.json()).then(data => {
                  if(data.success) {
                    Swal.fire({
                      title: 'Đã báo xong!',
                      text: 'Thông báo đã được gửi đến Phục vụ.',
                      icon: 'success',
                      timer: 1500,
                      showConfirmButton: false
                    }).then(() => window.location.reload());
                  } else {
                    alert('Lỗi: ' + (data.error || 'Có lỗi xảy ra'));
                  }
                }).catch(err => alert('Lỗi mạng!'));
              }
            }
          </script>
        <% } else { %>
          <div class="text-center text-muted p-4">Hiện không có món nào đang chờ nấu.</div>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- MÓN ĐÃ SẴN SÀNG PHỤC VỤ -->
  <div class="<%= session.staffRole === 'Phuc vu' ? 'col-lg-12' : 'col-lg-6' %> mb-4">
    <div class="card shadow mb-4 border-left-success h-100">
      <div class="card-header py-3 bg-success text-white">
        <h6 class="m-0 font-weight-bold"><i class="fas fa-check-circle mr-2"></i> Món đã xong (Chờ mang ra)</h6>
      </div>
      <div class="card-body">
        <% 
           let doneOrders = orders.filter(o => o.trangthai_bep === 1);
           if(doneOrders.length > 0) { 
        %>
          <div class="list-group">
            <% doneOrders.forEach(o => { 
              let displayName = '';
              if (o.table_name) {
                displayName = '<strong>Bàn: ' + o.table_name + '</strong>';
              } else if (o.ten_khach && o.ten_khach.startsWith('Bàn ')) {
                displayName = '<strong>Bàn: ' + o.ten_khach.substring(4) + '</strong>';
              } else {
                displayName = '<strong>Bàn: Chưa gán (' + o.ten_khach + ')</strong>';
              }
            %>
              <div class="list-group-item list-group-item-success flex-column align-items-start">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1 font-weight-bold text-dark"><i class="fas fa-utensils mr-2"></i><%= o.name_mon %> <span class="badge badge-dark badge-pill">x<%= o.soluong %></span></h6>
                  <small>Giờ đến: <%= o.tg %></small>
                </div>
                <p class="mb-0 text-dark small"><%- displayName %> (Đơn: <%= o.sesis.substring(0,6).toUpperCase() %>)</p>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center text-muted p-4">Chưa có món nào ra lò.</div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
