<%
  var activePage = 'dashboard';
  var staffName = session.staffName || 'Nhân viên';
  var unreadCount = unread || 0;
%>
<%- include('partials/header') %>

<!-- Dashboard content -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Tổng quan</h1>
  <a href="/staff/attendance" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
    <i class="fas fa-clock fa-sm text-white-50"></i> Chấm công hôm nay
  </a>
</div>

<!-- Summary Cards -->
<div class="row">
  <div class="col-xl-3 col-md-6 mb-4">
    <div class="card border-left-primary shadow h-100 py-2">
      <div class="card-body">
        <div class="row no-gutters align-items-center">
          <div class="col mr-2">
            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Ca làm việc tháng này</div>
            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.totalSchedule || 0 %></div>
          </div>
          <div class="col-auto"><i class="fas fa-calendar fa-2x text-gray-300"></i></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6 mb-4">
    <div class="card border-left-success shadow h-100 py-2">
      <div class="card-body">
        <div class="row no-gutters align-items-center">
          <div class="col mr-2">
            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Ngày đã chấm công</div>
            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.totalAttendance || 0 %></div>
          </div>
          <div class="col-auto"><i class="fas fa-check-circle fa-2x text-gray-300"></i></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6 mb-4">
    <div class="card border-left-warning shadow h-100 py-2">
      <div class="card-body">
        <div class="row no-gutters align-items-center">
          <div class="col mr-2">
            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Thông báo chưa đọc</div>
            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= unread || 0 %></div>
          </div>
          <div class="col-auto"><i class="fas fa-bell fa-2x text-gray-300"></i></div>
        </div>
      </div>
    </div>
  </div>
  <% if (['Ke toan', 'Quay', 'Thu ngan', 'Phuc vu'].includes(session.staffRole)) { %>
  <div class="col-xl-3 col-md-6 mb-4">
    <div class="card border-left-info shadow h-100 py-2">
      <div class="card-body">
        <div class="row no-gutters align-items-center">
          <div class="col mr-2">
            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Tin nhắn khách chờ</div>
            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.pendingChats || 0 %></div>
          </div>
          <div class="col-auto"><i class="fas fa-comments fa-2x text-gray-300"></i></div>
        </div>
      </div>
    </div>
  </div>
  <% } %>
</div>

<!-- Quick Actions -->
<div class="row">
  <div class="col-md-6">
    <div class="card shadow mb-4">
      <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Thao tác nhanh</h6></div>
      <div class="card-body">
        <a href="/staff/bookings" class="btn btn-outline-primary btn-block mb-2 text-left"><i class="fas fa-book mr-2"></i>Quản lý đặt bàn</a>
        <a href="/staff/kitchen" class="btn btn-outline-danger btn-block mb-2 text-left"><i class="fas fa-fire mr-2"></i><%= session.staffRole === 'Phuc vu' ? 'Món đã xong' : 'Quản lý Đơn bàn (Bếp)' %></a>
        
        <% if (['Ke toan', 'Quay', 'Thu ngan'].includes(session.staffRole)) { %>
          <a href="/staff/customers" class="btn btn-outline-info btn-block mb-2 text-left"><i class="fas fa-users mr-2"></i>Quản lý Khách hàng</a>
          <a href="/staff/shift" class="btn btn-outline-success btn-block mb-2 text-left"><i class="fas fa-calculator mr-2"></i>Chốt ca làm việc</a>
          <a href="/staff/chat" class="btn btn-outline-primary btn-block mb-2 text-left"><i class="fas fa-comments mr-2"></i>Chat với khách hàng</a>
          <% if (session.staffRole === 'Ke toan') { %>
            <a href="/staff/accountant/salary" class="btn btn-outline-warning btn-block mb-2 text-left"><i class="fas fa-money-check-alt mr-2"></i>Quản lý Lương</a>
            <a href="/staff/accountant/reports" class="btn btn-outline-danger btn-block mb-2 text-left"><i class="fas fa-chart-line mr-2"></i>Báo cáo Thu chi</a>
          <% } %>
        <% } else if (session.staffRole === 'Phuc vu') { %>
          <a href="/staff/chat" class="btn btn-outline-info btn-block mb-2 text-left"><i class="fas fa-comments mr-2"></i>Chat với khách hàng</a>
          <a href="/staff/emails" class="btn btn-outline-dark btn-block mb-2 text-left"><i class="fas fa-envelope mr-2"></i>Gửi Email</a>
        <% } else if (session.staffRole === 'Bep') { %>
          <a href="/staff/kitchen/inventory" class="btn btn-outline-warning btn-block mb-2 text-left"><i class="fas fa-boxes mr-2"></i>Quản lý Kho Nguyên liệu</a>
          <a href="/staff/kitchen/recipes" class="btn btn-outline-info btn-block mb-2 text-left"><i class="fas fa-scroll mr-2"></i>Công thức nấu ăn</a>
        <% } %>

        <div class="mt-3 pt-3 border-top">
          <a href="/staff/schedule" class="btn btn-outline-secondary btn-block mb-2 text-left"><i class="fas fa-calendar mr-2"></i>Đăng ký lịch làm việc</a>
          <a href="/staff/attendance" class="btn btn-outline-success btn-block mb-2 text-left"><i class="fas fa-clock mr-2"></i>Chấm công hôm nay</a>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card shadow mb-4">
      <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Lịch làm việc tuần này</h6></div>
      <div class="card-body">
        <% if (weekSchedule && weekSchedule.length > 0) { %>
          <% weekSchedule.forEach(s => { %>
            <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded" style="background:#f8f9fc;">
              <span><i class="fas fa-calendar-day mr-2 text-primary"></i><%= new Date(s.ngay).toLocaleDateString('vi-VN') %></span>
              <span class="badge badge-<%= s.ca==='sang'?'info':s.ca==='chieu'?'warning':'dark' %>">
                <%= s.ca==='sang'?'Sáng 7h-12h':s.ca==='chieu'?'Chiều 12h-17h':'Tối 17h-21h' %>
              </span>
              <span class="badge badge-<%= s.trangthai==1?'success':s.trangthai==2?'danger':'secondary' %>">
                <%= s.trangthai==1?'Đã duyệt':s.trangthai==2?'Từ chối':'Chờ duyệt' %>
              </span>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-center text-muted">Chưa có lịch làm việc tuần này. <a href="/staff/schedule">Đăng ký ngay</a></p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
