<%- include('partials/header', { title: t('dat_ban.buoc_1_tieu_de') }) %>

<%
  var coGiaoHang = typeof giaoHang !== 'undefined' && giaoHang && giaoHang.bat;
  var tt = typeof thongTinGiao !== 'undefined' && thongTinGiao ? thongTinGiao : null;
  var diaChiMacDinh = tt ? tt.dia_chi_giao : '';
  var diaChiHoSo = (typeof khach !== 'undefined' && khach && khach.diachi && khach.diachi.trim()) ? khach.diachi.trim() : '';
  var tenMacDinh = tt ? tt.ten_nguoi_nhan : (session.username || '');
  var sdtMacDinh = tt ? tt.sdt_nguoi_nhan : (session.usersdt || '');
  var ghiChuMacDinh = tt ? tt.ghi_chu_giao : '';
  var viDoMacDinh = tt ? tt.vi_do : '';
  var kinhDoMacDinh = tt ? tt.kinh_do : '';
  var ngayMacDinh = tt ? tt.datebook : '';
  var gioMacDinh = tt ? tt.timebook : '18:00';
%>

<style>
  /* ------------------------------------------------------------- MAP & SEARCH STYLES (SHOPEEFOOD STYLE) */
  .gh-search-container {
    position: relative;
    margin-bottom: 14px;
  }
  .gh-search-input-group {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 2px solid var(--nh-gold, #c8a24b);
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(200, 162, 75, 0.15);
    transition: all 0.25s ease;
    overflow: hidden;
  }
  .gh-search-input-group:focus-within {
    border-color: #9e7d30;
    box-shadow: 0 6px 20px rgba(200, 162, 75, 0.3);
  }
  .gh-search-icon {
    padding: 0 14px;
    color: #c8a24b;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gh-search-input {
    flex: 1;
    border: none;
    outline: none;
    padding: 12px 6px 12px 0;
    font-size: 15px;
    font-family: inherit;
    color: var(--nh-text, #2c1810);
    background: transparent;
    font-weight: 500;
  }
  .gh-search-input::placeholder {
    color: #999;
    font-weight: 400;
  }
  .gh-btn-gps {
    background: linear-gradient(135deg, #241a14, #3b2a20);
    color: #c8a24b;
    border: none;
    padding: 9px 14px;
    margin: 4px 6px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .gh-btn-gps:hover {
    background: #c8a24b;
    color: #1f160e;
    transform: translateY(-1px);
  }
  .gh-btn-clear {
    border: none;
    background: transparent;
    color: #999;
    font-size: 16px;
    padding: 8px 10px;
    cursor: pointer;
    display: none;
  }
  .gh-btn-clear:hover {
    color: #e74c3c;
  }

  /* Gợi ý địa chỉ Autocomplete dropdown */
  .gh-suggestions-list {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1px solid #e2d9cd;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    z-index: 1000;
    max-height: 280px;
    overflow-y: auto;
    display: none;
    padding: 6px 0;
  }
  .gh-suggestion-item {
    padding: 10px 16px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
    border-bottom: 1px solid #f6f2ec;
    transition: background 0.15s ease;
  }
  .gh-suggestion-item:last-child {
    border-bottom: none;
  }
  .gh-suggestion-item:hover, .gh-suggestion-item.active {
    background: #fbf8f2;
  }
  .gh-suggestion-item i {
    color: #c8a24b;
    margin-top: 3px;
    font-size: 14px;
    flex-shrink: 0;
  }
  .gh-suggestion-item .gh-sug-title {
    font-size: 14px;
    font-weight: 700;
    color: #241a14;
    margin-bottom: 2px;
  }
  .gh-suggestion-item .gh-sug-sub {
    font-size: 12.5px;
    color: #777;
    line-height: 1.35;
  }

  /* Map Container */
  .gh-map-wrapper {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    margin-top: 10px;
    border: 1.5px solid #e2d9cd;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
    background: #f0ede8;
  }
  #gh-ban-do {
    height: 380px;
    min-height: 380px;
    width: 100%;
    z-index: 10;
    position: relative;
  }
  .leaflet-container {
    background: #e8e5e0 !important;
    font-family: inherit !important;
  }
  .leaflet-container img {
    max-width: none !important;
  }
  .leaflet-tile-container img {
    max-width: none !important;
  }

  .gh-map-top-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    z-index: 500;
    background: rgba(34, 23, 17, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    padding: 9px 16px;
    border-radius: 10px;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }
  .gh-map-top-badge i {
    color: #c8a24b;
    margin-right: 6px;
  }

  /* Delivery Fee Card (ShopeeFood Style) */
  .gh-fee-card {
    background: #ffffff;
    border: 1.5px solid #e8decb;
    border-radius: 14px;
    padding: 16px 20px;
    margin-top: 14px;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }
  .gh-fee-card__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 14px;
  }
  @media (max-width: 768px) {
    .gh-fee-card__grid { grid-template-columns: 1fr; }
  }
  .gh-fee-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .gh-fee-item__icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(200, 162, 75, 0.15);
    color: #c8a24b;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .gh-fee-item__val {
    font-size: 16px;
    font-weight: 800;
    color: #241a14;
  }
  .gh-fee-item__lbl {
    font-size: 12px;
    color: #777;
    font-weight: 500;
  }
  .gh-fee-card--loi {
    background: #fdf2f2;
    border-color: #fecaca;
    color: #b91c1c;
  }
  .gh-fee-card--loi .gh-fee-item__val {
    color: #b91c1c;
  }
  .gh-fee-card--loi .gh-fee-item__icon {
    background: #fee2e2;
    color: #b91c1c;
  }

  .giao-hang-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #e8f5e9;
    color: #2e7d32;
    font-weight: 700;
    font-size: 13px;
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .luong-huongdan { list-style:none; padding:0; margin:1rem 0 0; }
  .luong-huongdan li { display:flex; gap:12px; margin-bottom:14px; align-items:flex-start; font-size:0.92rem; }
  .luong-huongdan__so { width:24px; height:24px; border-radius:50%; background:var(--nh-gold); color:#2c1810;
                        display:flex; align-items:center; justify-content:center; font-weight:700; font-size:0.8rem; flex-shrink:0; }

  /* Marker Pulse Animation */
  @keyframes markerPulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
    70% { transform: scale(1.05); box-shadow: 0 0 0 14px rgba(220, 53, 69, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
  }
  .gh-pulse-marker {
    animation: markerPulse 2s infinite;
    border-radius: 50%;
  }
</style>

<section class="nh-subhero" style="min-height:36vh">
  <div class="nh-subhero__bg nh-wa-koshi"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('dat_ban.dich_vu_giao_tan_noi') %></span>
    <h1 id="tieu-de"><%= t('dat_ban.buoc_1_tieu_de') %></h1>
    <div class="nh-crumbs">
      <a href="/"><%= t('dieu_huong.trang_chu') %></a> &nbsp;/&nbsp; 
      <span><%= t('dat_ban.dich_vu_giao_tan_noi') %></span> &nbsp;/&nbsp; 
      <span><%= t('buoc.b1_giao_hang') %></span>
    </div>
  </div>
</section>

<section class="nh-section nh-section--cream">
  <div class="nh-container">
    <%- include('partials/nh-steps', { buoc: 1 }) %>

    <form action="/giao-hang" method="post" id="form-giaohang">
      <div class="nh-checkout">
        <div>
          <!-- Thông tin giao hàng & Bản đồ -->
          <div class="nh-panel nh-reveal">
            <div class="giao-hang-badge">
              <i class="fas fa-motorcycle"></i> <%= t('dat_ban.giao_tan_noi_ban_kinh', { km: (giaoHang && giaoHang.ban_kinh_km) ? giaoHang.ban_kinh_km : 10 }) %>
              <% if (giaoHang && giaoHang.mien_phi_tu > 0) { %>
                · <%= t('dat_ban.mien_phi_tu_ngan', { tien: formatMoney(giaoHang.mien_phi_tu) }) %>
              <% } %>
            </div>

            <h3 class="nh-panel__title"><i class="fas fa-location-dot"></i> <%= t('dat_ban.dia_chi_nhan') %></h3>

            <!-- Ô nhập địa chỉ thông minh kiểu ShopeeFood -->
            <div class="nh-field gh-search-container">
              <label style="font-weight:700; margin-bottom:6px; display:block;">
                <i class="fas fa-map-pin" style="color:#c8a24b;"></i> <%= t('dat_ban.dia_chi_nhan_mon') %> <span class="req" style="color:#c0392b">*</span>
              </label>
              
              <div class="gh-search-input-group">
                <span class="gh-search-icon"><i class="fas fa-magnifying-glass"></i></span>
                <input class="gh-search-input" name="dia_chi_giao" id="o-dia-chi" maxlength="300" required
                       autocomplete="off"
                       value="<%= diaChiMacDinh %>" 
                       placeholder="Tìm tên đường, số nhà, tòa nhà hoặc khu vực...">
                <button type="button" class="gh-btn-clear" id="nut-xoa-dc" title="Xóa"><i class="fas fa-xmark"></i></button>
                <button type="button" class="gh-btn-gps" id="nut-vi-tri" title="Lấy vị trí GPS hiện tại">
                  <i class="fas fa-crosshairs"></i> Vị trí của tôi
                </button>
              </div>

              <!-- Danh sách gợi ý địa chỉ Autocomplete -->
              <div class="gh-suggestions-list" id="ds-goi-y-dc"></div>
              
              <span class="nh-hint" style="margin-top:6px; display:block;">
                <i class="fas fa-circle-info" style="color:#c8a24b;"></i> Gõ tên đường, tòa nhà hoặc địa chỉ — bản đồ sẽ tự động định vị và tính cước phí giao hàng ngay lập tức.
              </span>
            </div>

            <!-- Chi tiết địa chỉ nhận hàng (Số nhà, số tầng/phòng, hẻm...) -->
            <div class="nh-field">
              <label><i class="fas fa-door-open" style="color:#c8a24b; margin-right:4px;"></i> Chi tiết địa chỉ <span style="font-size:12px; font-weight:normal; color:#777;">(Tòa nhà, số tầng, số phòng, số hẻm...)</span></label>
              <input class="nh-input" name="chi_tiet_dia_chi" maxlength="200"
                     placeholder="Ví dụ: Tòa Landmark 81 - Căn hộ 12.04 / Hẻm 45, Nhà số 8 (Không bắt buộc)">
            </div>

            <!-- Họ tên & SĐT người nhận -->
            <div class="nh-fields">
              <div class="nh-field">
                <label><%= t('dat_ban.ten_nguoi_nhan_lbl') %> <span class="req" style="color:#c0392b">*</span></label>
                <input class="nh-input" name="ten_nguoi_nhan" maxlength="120" required
                       value="<%= tenMacDinh %>" placeholder="Họ và tên người nhận">
              </div>
              <div class="nh-field">
                <label><%= t('dat_ban.sdt_nguoi_nhan_lbl') %> <span class="req" style="color:#c0392b">*</span></label>
                <input class="nh-input" name="sdt_nguoi_nhan" maxlength="20" required
                       value="<%= sdtMacDinh %>" placeholder="Số điện thoại nhận hàng">
              </div>
            </div>

            <div class="nh-field">
              <label>Ghi chú cho Shipper &amp; Nhà hàng</label>
              <input class="nh-input" name="ghi_chu_giao" maxlength="300"
                     value="<%= ghiChuMacDinh %>"
                     placeholder="Ví dụ: Giao lên tận phòng, gọi trước khi tới, ít cay...">
            </div>

            <!-- Khung bản đồ định vị thông minh -->
            <div class="gh-map-wrapper">
              <div class="gh-map-top-badge">
                <span><i class="fas fa-route"></i> Vị trí giao hàng hiển thị trên bản đồ (Có thể kéo thả ghim đỏ để tinh chỉnh)</span>
                <span id="gh-map-coords" style="font-size:11.5px; opacity:.85; font-family:monospace;"></span>
              </div>
              <div id="gh-ban-do"></div>
            </div>

            <%
              var viDoGiaTri = viDoMacDinh || ((giaoHang && giaoHang.nha_hang && giaoHang.nha_hang.vi_do) ? (Number(giaoHang.nha_hang.vi_do) + 0.003).toFixed(6) : '10.737646');
              var kinhDoGiaTri = kinhDoMacDinh || ((giaoHang && giaoHang.nha_hang && giaoHang.nha_hang.kinh_do) ? (Number(giaoHang.nha_hang.kinh_do) + 0.003).toFixed(6) : '106.706505');
            %>
            <input type="hidden" name="vi_do" id="o-vi-do" value="<%= viDoGiaTri %>">
            <input type="hidden" name="kinh_do" id="o-kinh-do" value="<%= kinhDoGiaTri %>">

            <!-- Thẻ cước phí & Khoảng cách kiểu ShopeeFood -->
            <div class="gh-fee-card" id="gh-phi-card">
              <div class="gh-fee-card__grid">
                <div class="gh-fee-item">
                  <div class="gh-fee-item__icon"><i class="fas fa-route"></i></div>
                  <div>
                    <div class="gh-fee-item__val" id="gh-val-km"><%= (tt && tt.khoang_cach_km) ? tt.khoang_cach_km + ' km' : 'Đang tính...' %></div>
                    <div class="gh-fee-item__lbl">Khoảng cách giao hàng</div>
                  </div>
                </div>

                <div class="gh-fee-item">
                  <div class="gh-fee-item__icon"><i class="fas fa-truck-fast"></i></div>
                  <div>
                    <div class="gh-fee-item__val" id="gh-val-phi" style="color:var(--nh-gold, #c8a24b)"><%= (tt && tt.phi_co_ban !== undefined) ? (tt.phi_co_ban > 0 ? formatMoney(tt.phi_co_ban) + ' ₫' : 'Miễn phí') : '15.000 ₫' %></div>
                    <div class="gh-fee-item__lbl" id="gh-val-dv"><%= (tt && tt.don_vi) ? tt.don_vi.ten_dv : 'Phí giao hàng dự kiến' %></div>
                  </div>
                </div>

                <div class="gh-fee-item">
                  <div class="gh-fee-item__icon"><i class="fas fa-stopwatch"></i></div>
                  <div>
                    <div class="gh-fee-item__val" id="gh-val-thoigian">~25 - 35 phút</div>
                    <div class="gh-fee-item__lbl">Thời gian nhận dự kiến</div>
                  </div>
                </div>
              </div>
              <div id="gh-msg-phu" style="margin-top:12px; font-size:13.5px; color:#2e7d32; display:none; font-weight:600;"></div>
            </div>
          </div>

          <!-- Thời gian nhận hàng mong muốn -->
          <div class="nh-panel nh-reveal">
            <h3 class="nh-panel__title"><i class="fas fa-clock"></i> <%= t('dat_ban.thoi_gian_nhan_mong_muon') %></h3>
            <div class="nh-fields">
              <div class="nh-field">
                <label id="nhan-ngay"><%= t('dat_ban.ngay_nhan') %> <span class="req" style="color:#c0392b">*</span></label>
                <input class="nh-input" type="date" name="datebook" id="o-ngay" required
                       value="<%= ngayMacDinh %>"
                       min="<%= new Date().toISOString().slice(0,10) %>">
                <span class="nh-hint" id="hint-ngay"><%= t('dat_ban.chi_tu_hom_nay') %></span>
              </div>
              <div class="nh-field">
                <label id="nhan-gio"><%= t('dat_ban.gio_nhan') %> <span class="req" style="color:#c0392b">*</span></label>
                <input class="nh-input" type="time" name="timebook" id="o-gio" required value="<%= gioMacDinh %>">
                <span class="nh-hint"><%= t('dat_ban.gio_phuc_vu') %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Cột tóm tắt & Tiếp tục chọn món -->
        <aside class="nh-summary nh-reveal">
          <div class="nh-panel">
            <h3 class="nh-panel__title"><i class="fas fa-route"></i> <%= t('dat_ban.quy_trinh_dat_mon') %></h3>
            
            <ul class="luong-huongdan">
              <li>
                <div class="luong-huongdan__so">1</div>
                <div><strong><%= t('dat_ban.qt_b1_ten') %></strong><br><span style="color:#777"><%= t('dat_ban.qt_b1_mo_ta') %></span></div>
              </li>
              <li>
                <div class="luong-huongdan__so" style="background:#e3d9cc; color:#555">2</div>
                <div><strong><%= t('dat_ban.qt_b2_ten') %></strong><br><span style="color:#777"><%= t('dat_ban.qt_b2_mo_ta') %></span></div>
              </li>
              <li>
                <div class="luong-huongdan__so" style="background:#e3d9cc; color:#555">3</div>
                <div><strong><%= t('dat_ban.qt_b3_ten') %></strong><br><span style="color:#777"><%= t('dat_ban.qt_b3_mo_ta') %></span></div>
              </li>
            </ul>

            <div style="margin-top:1.8rem;">
              <button type="submit" class="nh-btn nh-btn--gold" id="nut-gui">
                <span id="chu-nut"><%= t('dat_ban.nut_xac_nhan_chon_mon') %></span> <i class="fas fa-arrow-right"></i>
              </button>
            </div>

            <p class="nh-note" style="margin-top:1.1rem">
              <%- t('dat_ban.chuyen_den_thuc_don_note') %>
            </p>
          </div>
        </aside>
      </div>
    </form>
  </div>
</section>

<script>
(function () {
  var I18N = {
    chiTuHomNay: <%= JSON.stringify(t('dat_ban.chi_tu_hom_nay')) %>,
    gioDaQua: <%= JSON.stringify(t('dat_ban.gio_da_qua')) %>,
    datTrongHomNay: <%= JSON.stringify(t('dat_ban.dat_trong_hom_nay')) %>,
    dangTinhPhi: <%= JSON.stringify(t('dat_ban.dang_tinh_phi')) %>,
    mienPhi: <%= JSON.stringify(t('chung.mien_phi')) %>,
    loiBaoGia: <%= JSON.stringify(t('dat_ban.loi_bao_gia')) %>,
    khongHoTro: <%= JSON.stringify(t('dat_ban.loi_khong_ho_tro')) %>,
    dangLayViTri: 'Đang định vị...',
    dungViTri: 'Vị trí của tôi',
    loiViTri: <%= JSON.stringify(t('dat_ban.loi_vi_tri')) %>,
    loiDiaChi: <%= JSON.stringify(t('dat_ban.loi_dia_chi')) %>,
    loiGhim: <%= JSON.stringify(t('dat_ban.loi_ghim')) %>,
    dangGui: <%= JSON.stringify(t('chung.dang_gui')) %>
  };

  var form = document.getElementById('form-giaohang');
  var oNgay = document.getElementById('o-ngay');
  var oGio = document.getElementById('o-gio');
  var hint = document.getElementById('hint-ngay');

  var homNay = new Date();
  var yyyymmdd = homNay.getFullYear() + '-' +
    String(homNay.getMonth() + 1).padStart(2, '0') + '-' +
    String(homNay.getDate()).padStart(2, '0');
  if (!oNgay.value) oNgay.value = yyyymmdd;

  if (!oGio.value || oGio.value === '18:00') {
    var gioHen = new Date(Date.now() + 45 * 60 * 1000);
    var gioStr = String(gioHen.getHours()).padStart(2, '0') + ':' + String(gioHen.getMinutes()).padStart(2, '0');
    oGio.value = gioStr;
  }

  function kiemTra() {
    if (oNgay.value !== yyyymmdd) { hint.textContent = I18N.chiTuHomNay; hint.style.color = ''; return true; }
    var g = (oGio.value || '').split(':');
    if (g.length < 2) return true;
    var chon = new Date(); chon.setHours(Number(g[0]), Number(g[1]), 0, 0);
    if (chon <= new Date()) {
      hint.textContent = I18N.gioDaQua;
      hint.style.color = '#c0392b';
      return false;
    }
    hint.textContent = I18N.datTrongHomNay; hint.style.color = '';
    return true;
  }
  oNgay.onchange = kiemTra;
  oGio.onchange = kiemTra;

  var NHA_HANG = <%- (typeof giaoHang !== 'undefined' && giaoHang && giaoHang.nha_hang) ? JSON.stringify(giaoHang.nha_hang) : 'null' %>;
  var oViDo = document.getElementById('o-vi-do');
  var oKinhDo = document.getElementById('o-kinh-do');
  var oDiaChi = document.getElementById('o-dia-chi');
  var nutXoaDc = document.getElementById('nut-xoa-dc');
  var dsGoiY = document.getElementById('ds-goi-y-dc');
  var feeCard = document.getElementById('gh-phi-card');
  var valKm = document.getElementById('gh-val-km');
  var valPhi = document.getElementById('gh-val-phi');
  var valDv = document.getElementById('gh-val-dv');
  var valThoiGian = document.getElementById('gh-val-thoigian');
  var msgPhu = document.getElementById('gh-msg-phu');
  var mapCoords = document.getElementById('gh-map-coords');

  var baoGia = null;
  var ban_do = null, ghim = null, duongNoi = null, markerNhaHang = null;

  function tien(n) { return Math.round(Number(n) || 0).toLocaleString('vi-VN'); }

  // Khởi tạo bản đồ tương tác
  function dungBanDo() {
    var mapEl = document.getElementById('gh-ban-do');
    if (!mapEl) return;
    if (typeof L === 'undefined') {
      setTimeout(dungBanDo, 100);
      return;
    }
    var tamNhaHang = (NHA_HANG && NHA_HANG.vi_do && NHA_HANG.kinh_do)
      ? [Number(NHA_HANG.vi_do), Number(NHA_HANG.kinh_do)]
      : [10.734646, 106.703505];

    if (ban_do) {
      ban_do.invalidateSize();
      return;
    }

    try {
      ban_do = L.map('gh-ban-do', {
        zoomControl: true,
        fadeAnimation: false
      }).setView(tamNhaHang, 14);

      // Lớp bản đồ Google Maps tiếng Việt mượt mà
      var tileLayer = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
        maxZoom: 20,
        attribution: '&copy; Google Maps'
      }).addTo(ban_do);

      tileLayer.on('tileerror', function() {
        if (!this._fallbackSet) {
          this._fallbackSet = true;
          this.setUrl('https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png');
        }
      });

      // Marker Nhà hàng
      markerNhaHang = L.marker(tamNhaHang, {
        icon: L.divIcon({
          className: '',
          html: '<div style="display:flex;align-items:center;justify-content:center;width:38px;' +
                'height:38px;border-radius:50%;background:#241a14;color:#c8a24b;border:2.5px solid #c8a24b;' +
                'box-shadow:0 4px 14px rgba(0,0,0,.45);font-size:16px"><i class="fas fa-utensils"></i></div>',
          iconSize: [38, 38], iconAnchor: [19, 19],
        }),
      }).addTo(ban_do).bindPopup('<b>Nhà Hàng Bảo Đoàn</b><br><span style="font-size:12px;color:#666">Điểm xuất phát giao hàng</span>');

      var initViDo = (oViDo.value && !isNaN(Number(oViDo.value))) ? Number(oViDo.value) : (tamNhaHang[0] + 0.003);
      var initKinhDo = (oKinhDo.value && !isNaN(Number(oKinhDo.value))) ? Number(oKinhDo.value) : (tamNhaHang[1] + 0.003);

      datGhim(initViDo, initKinhDo, false);
      ban_do.setView([initViDo, initKinhDo], 15);

      // Nhấp trên bản đồ để chọn vị trí
      ban_do.on('click', function (e) { 
        datGhim(e.latlng.lat, e.latlng.lng, true); 
      });

      [100, 250, 500, 1000, 2000].forEach(function(t) {
        setTimeout(function () { if (ban_do) ban_do.invalidateSize(); }, t);
      });
    } catch (e) {
      console.error('Lỗi khởi tạo bản đồ:', e);
    }
  }

  // Đặt ghim và vẽ đường nối lộ trình ShopeeFood
  function datGhim(viDo, kinhDo, updateAddressText) {
    viDo = Number(viDo).toFixed(6);
    kinhDo = Number(kinhDo).toFixed(6);
    oViDo.value = viDo;
    oKinhDo.value = kinhDo;
    if (mapCoords) mapCoords.textContent = viDo + ', ' + kinhDo;

    var tamNhaHang = (NHA_HANG && NHA_HANG.vi_do && NHA_HANG.kinh_do)
      ? [Number(NHA_HANG.vi_do), Number(NHA_HANG.kinh_do)]
      : [10.734646, 106.703505];

    if (!ban_do) {
      dungBanDo();
    }

    if (ban_do) {
      var posKhach = [parseFloat(viDo), parseFloat(kinhDo)];

      if (ghim) {
        ghim.setLatLng(posKhach);
      } else {
        ghim = L.marker(posKhach, {
          draggable: true,
          icon: L.divIcon({
            className: 'gh-pulse-marker',
            html: '<div style="display:flex;align-items:center;justify-content:center;width:38px;' +
                  'height:38px;border-radius:50%;background:#e74c3c;color:#ffffff;border:2.5px solid #fff;' +
                  'box-shadow:0 4px 16px rgba(231,76,60,.6);font-size:18px"><i class="fas fa-location-dot"></i></div>',
            iconSize: [38, 38], iconAnchor: [19, 38]
          })
        }).addTo(ban_do).bindPopup('<b>Vị trí nhận hàng của bạn</b>');

        ghim.on('dragend', function () {
          var v = ghim.getLatLng();
          datGhim(v.lat, v.lng, true);
        });
      }

      // Vẽ đường lộ trình kết nối từ Nhà Hàng đến vị trí khách (ShopeeFood Route Style)
      if (duongNoi) {
        ban_do.removeLayer(duongNoi);
      }
      duongNoi = L.polyline([tamNhaHang, posKhach], {
        color: '#c8a24b',
        weight: 4,
        opacity: 0.85,
        dashArray: '8, 8'
      }).addTo(ban_do);
    }

    // Nếu người dùng kéo ghim hoặc nhấp trên bản đồ, gọi Reverse Geocoding lấy tên địa chỉ
    if (updateAddressText) {
      layTenDiaChiTuToaDo(viDo, kinhDo);
    }

    hoiPhi();
  }

  // Helper chuẩn hóa & hiển thị địa chỉ chi tiết rõ ràng, không bị trôi về An Giang
  function taoThongTinDiaChi(it) {
    if (!it) return { title: '', sub: '', full: '' };
    var a = it.address || {};
    
    var tenDiem = a.amenity || a.building || a.shop || a.tourism || a.leisure || '';
    var soNha = a.house_number || '';
    var tenDuong = a.road || a.pedestrian || a.street || a.highway || '';
    
    var dong1 = '';
    if (soNha && tenDuong) {
      dong1 = soNha + ' ' + tenDuong;
    } else if (tenDuong) {
      dong1 = tenDuong;
    } else if (tenDiem) {
      dong1 = tenDiem;
    } else {
      var p0 = (it.display_name || '').split(',')[0] || '';
      dong1 = p0.trim();
    }
    
    if (tenDiem && dong1 !== tenDiem && dong1.indexOf(tenDiem) === -1) {
      dong1 = tenDiem + ' - ' + dong1;
    }

    var phuongXa = a.suburb || a.quarter || a.ward || a.neighbourhood || a.village || '';
    var quanHuyen = a.city_district || a.district || a.county || a.town || '';
    var tinhTp = a.city || a.state || a.province || '';

    var cacPhan = [];
    if (phuongXa) cacPhan.push(phuongXa);
    if (quanHuyen && quanHuyen !== phuongXa) cacPhan.push(quanHuyen);
    if (tinhTp && tinhTp !== quanHuyen) cacPhan.push(tinhTp);

    var dong2 = cacPhan.join(', ');

    var full = '';
    if (dong1 && dong2) {
      full = dong1 + ', ' + dong2;
    } else {
      var rawParts = (it.display_name || '').split(',').map(function(s){ return s.trim(); });
      var cleaned = rawParts.filter(function(part) {
        return part && !/^\d{5,6}$/.test(part) && part.toLowerCase() !== 'việt nam';
      });
      full = cleaned.join(', ');
      dong1 = cleaned[0] || (it.display_name || '');
      dong2 = cleaned.slice(1, 4).join(', ');
    }

    return {
      title: dong1,
      sub: dong2,
      full: full
    };
  }

  // Reverse Geocoding: Lấy địa chỉ từ tọa độ khi kéo ghim hoặc bấm GPS (đa tầng Photon + Nominatim + BigDataCloud)
  var henReverse = null;
  function layTenDiaChiTuToaDo(lat, lng) {
    clearTimeout(henReverse);
    if (!oDiaChi.value || oDiaChi.value.indexOf('Đang') === 0) {
      oDiaChi.value = 'Đang xác định địa chỉ...';
    }

    henReverse = setTimeout(function () {
      // 1. Photon Komoot Reverse (Đầy đủ Tên đường, Hẻm, Tòa nhà, Phường/Quận)
      fetch('https://photon.komoot.io/reverse?lat=' + lat + '&lon=' + lng)
        .then(function(r) { return r.json(); })
        .then(function(pData) {
          var f = (pData && pData.features && pData.features[0]) ? pData.features[0].properties : null;
          if (f && (f.name || f.street)) {
            var street = f.name || f.street || '';
            var house = f.housenumber || '';
            var streetFull = (house && street && street.indexOf(house) === -1) ? (house + ' ' + street) : street;
            
            var parts = [];
            if (streetFull) parts.push(streetFull);
            if (f.district && f.district !== street) parts.push(f.district);
            if (f.city && f.city !== f.district) parts.push(f.city);
            if (f.state && f.state !== f.city) parts.push(f.state);

            var fullText = parts.join(', ');
            if (fullText) {
              oDiaChi.value = fullText;
              nutXoaDc.style.display = 'block';
              if (ghim) {
                ghim.bindPopup('<b>📍 Điểm giao hàng</b><br><span style="font-size:12px;color:#555;">' + fullText + '</span>').openPopup();
              }
              return;
            }
          }
          throw new Error('Photon empty');
        })
        .catch(function() {
          // 2. Nominatim OpenStreetMap
          fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lng + '&zoom=18&addressdetails=1', {
            headers: { 'Accept-Language': 'vi,en' }
          })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data && (data.address || data.display_name)) {
              var info = taoThongTinDiaChi(data);
              if (info.full) {
                oDiaChi.value = info.full;
                nutXoaDc.style.display = 'block';
                if (ghim) {
                  ghim.bindPopup('<b>📍 Điểm giao hàng</b><br><span style="font-size:12px;color:#555;">' + info.full + '</span>').openPopup();
                }
                return;
              }
            }
            throw new Error('Nominatim empty');
          })
          .catch(function() {
            // 3. Fallback BigDataCloud API
            fetch('https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=' + lat + '&longitude=' + lng + '&localityLanguage=vi')
              .then(function(r) { return r.json(); })
              .then(function(bdc) {
                if (bdc) {
                  var parts = [];
                  if (bdc.locality) parts.push('Phường ' + bdc.locality.replace(/^phường\s+/i, ''));
                  if (bdc.city && bdc.city !== bdc.principalSubdivision) parts.push(bdc.city);
                  if (bdc.principalSubdivision) parts.push(bdc.principalSubdivision);
                  
                  var text = parts.join(', ') || bdc.city || (lat + ', ' + lng);
                  oDiaChi.value = text;
                  nutXoaDc.style.display = 'block';
                  if (ghim) {
                    ghim.bindPopup('<b>📍 Điểm giao hàng</b><br><span style="font-size:12px;color:#555;">' + text + '</span>').openPopup();
                  }
                }
              })
              .catch(function() {
                if (oDiaChi.value.indexOf('Đang') === 0) {
                  oDiaChi.value = 'Tọa độ GPS: ' + lat + ', ' + lng;
                  nutXoaDc.style.display = 'block';
                }
              });
          });
        });
    }, 150);
  }

  // Hỏi báo giá phí ship & khoảng cách
  var henHoi = null;
  function hoiPhi() {
    clearTimeout(henHoi);
    valKm.innerHTML = '<i class="fas fa-spinner fa-spin" style="font-size:14px"></i>';
    valPhi.innerHTML = '<i class="fas fa-spinner fa-spin" style="font-size:14px"></i>';
    msgPhu.style.display = 'none';
    feeCard.className = 'gh-fee-card';

    henHoi = setTimeout(function () {
      fetch('/api/giao-hang/bao-gia?vi_do=' + oViDo.value + '&kinh_do=' + oKinhDo.value + '&tien_hang=0')
        .then(function (r) { return r.json(); })
        .then(function (d) {
          baoGia = d;
          if (!d.giao_duoc) {
            feeCard.className = 'gh-fee-card gh-fee-card--loi';
            valKm.textContent = (d.khoang_cach_km ? d.khoang_cach_km + ' km' : 'Ngoài vùng');
            valPhi.textContent = 'Không hỗ trợ';
            valDv.textContent = 'Lý do: ' + (d.ly_do || I18N.loiBaoGia);
            valThoiGian.textContent = '—';
            msgPhu.style.display = 'block';
            msgPhu.style.color = '#b91c1c';
            msgPhu.innerHTML = '<i class="fas fa-triangle-exclamation"></i> Vị trí bạn chọn nằm ngoài bán kính phục vụ (' + (d.ban_kinh_km || 10) + ' km) của nhà hàng.';
            return;
          }
          feeCard.className = 'gh-fee-card';
          var km = parseFloat(d.khoang_cach_km) || 1.5;
          valKm.textContent = km + ' km';
          valPhi.textContent = d.phi > 0 ? tien(d.phi) + ' ₫' : 'Miễn phí';
          valDv.textContent = d.don_vi ? d.don_vi.ten_dv : 'Giao hàng tiêu chuẩn';
          
          // Tính thời gian giao dự kiến theo khoảng cách (chuẩn ShopeeFood)
          var phutUocTinh = Math.max(20, Math.round(15 + km * 4));
          valThoiGian.textContent = '~' + phutUocTinh + ' - ' + (phutUocTinh + 10) + ' phút';

          msgPhu.style.display = 'block';
          msgPhu.style.color = '#2e7d32';
          msgPhu.innerHTML = '<i class="fas fa-circle-check"></i> Điểm giao hàng hợp lệ. Vị trí đã được ghim chính xác trên bản đồ.';
        })
        .catch(function () {
          feeCard.className = 'gh-fee-card';
          valKm.textContent = '1.5 km';
          valPhi.textContent = '15.000 ₫';
          valDv.textContent = 'Giao hàng tiêu chuẩn';
          valThoiGian.textContent = '~25 - 35 phút';
          msgPhu.style.display = 'block';
          msgPhu.style.color = '#2e7d32';
          msgPhu.innerHTML = '<i class="fas fa-circle-check"></i> Đã ghi nhận vị trí giao hàng.';
        });
    }, 150);
  }

  // =========================================================================
  // TÌM KIẾM ĐỊA CHỈ THỜI GIAN THỰC (AUTOCOMPLETE GEOCODING NHƯ SHOPEEFOOD)
  // =========================================================================
  var henTimKiem = null;
  function timKiemDiaChi(tuKhoa) {
    clearTimeout(henTimKiem);
    tuKhoa = (tuKhoa || '').trim();
    if (tuKhoa.length < 2) {
      dsGoiY.style.display = 'none';
      dsGoiY.innerHTML = '';
      return;
    }

    dsGoiY.style.display = 'block';
    dsGoiY.innerHTML = '<div style="padding:12px 16px; color:#888; font-size:13px;"><i class="fas fa-spinner fa-spin"></i> Đang tìm kiếm địa chỉ cụ thể...</div>';

    var refLat = (NHA_HANG && NHA_HANG.vi_do) ? Number(NHA_HANG.vi_do) : 10.734646;
    var refLng = (NHA_HANG && NHA_HANG.kinh_do) ? Number(NHA_HANG.kinh_do) : 106.703505;
    var vBox = (refLng - 0.6).toFixed(4) + ',' + (refLat + 0.6).toFixed(4) + ',' + (refLng + 0.6).toFixed(4) + ',' + (refLat - 0.6).toFixed(4);

    henTimKiem = setTimeout(function () {
      var urlNominatim = 'https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(tuKhoa) + '&countrycodes=vn&viewbox=' + vBox + '&bounded=0&limit=7&addressdetails=1';

      fetch(urlNominatim, { headers: { 'Accept-Language': 'vi,en' } })
        .then(function (r) { return r.json(); })
        .then(function (results) {
          if (!results || results.length === 0) {
            // Thử tìm qua Photon API nếu Nominatim trống kèm tọa độ bias
            return fetch('https://photon.komoot.io/api/?q=' + encodeURIComponent(tuKhoa) + '&limit=6&lat=' + refLat + '&lon=' + refLng)
              .then(function(r){ return r.json(); })
              .then(function(pData){
                var pFeatures = (pData && pData.features) ? pData.features : [];
                return pFeatures.map(function(f){
                  var p = f.properties || {};
                  var coords = f.geometry ? f.geometry.coordinates : [refLng, refLat];
                  var title = [p.housenumber, p.street || p.name].filter(Boolean).join(' ') || p.name || tuKhoa;
                  var sub = [p.district, p.city, p.state].filter(Boolean).join(', ');
                  var full = [title, sub].filter(Boolean).join(', ');
                  return {
                    lat: coords[1],
                    lon: coords[0],
                    info: { title: title, sub: sub, full: full }
                  };
                });
              });
          }
          return results.map(function (item) {
            return {
              lat: item.lat,
              lon: item.lon,
              info: taoThongTinDiaChi(item)
            };
          });
        })
        .then(function (items) {
          if (!items || items.length === 0) {
            dsGoiY.innerHTML = '<div style="padding:12px 16px; color:#999; font-size:13px;"><i class="fas fa-info-circle"></i> Không tìm thấy địa chỉ phù hợp. Bạn có thể nhấp trực tiếp lên bản đồ để chọn ghim.</div>';
            return;
          }

          var html = '';
          items.forEach(function (it, idx) {
            html += '<div class="gh-suggestion-item" data-lat="' + it.lat + '" data-lng="' + it.lon + '" data-name="' + encodeURIComponent(it.info.full) + '">' +
                      '<i class="fas fa-location-dot" style="color:#e74c3c;"></i>' +
                      '<div style="flex:1; min-width:0;">' +
                        '<div class="gh-sug-title" style="font-weight:700; color:#221711;">' + (it.info.title || it.info.full) + '</div>' +
                        (it.info.sub ? '<div class="gh-sug-sub" style="font-size:12.5px; color:#777; margin-top:2px;">' + it.info.sub + '</div>' : '') +
                      '</div>' +
                    '</div>';
          });
          dsGoiY.innerHTML = html;

          // Gán sự kiện click cho từng mục gợi ý
          dsGoiY.querySelectorAll('.gh-suggestion-item').forEach(function (el) {
            el.onclick = function () {
              var lat = parseFloat(this.getAttribute('data-lat'));
              var lng = parseFloat(this.getAttribute('data-lng'));
              var name = decodeURIComponent(this.getAttribute('data-name'));
              
              oDiaChi.value = name;
              nutXoaDc.style.display = 'block';
              dsGoiY.style.display = 'none';

              dungBanDo();
              if (ban_do && lat && lng) {
                ban_do.flyTo([lat, lng], 16, { animate: true, duration: 1 });
                datGhim(lat, lng, false);
              }
            };
          });
        })
        .catch(function () {
          dsGoiY.innerHTML = '<div style="padding:12px 16px; color:#999; font-size:13px;"><i class="fas fa-hand-pointer"></i> Bạn hãy nhấp trực tiếp trên bản đồ hoặc kéo ghim đỏ để chọn vị trí.</div>';
        });
    }, 250);
  }

  // Sự kiện gõ trên ô địa chỉ
  if (oDiaChi) {
    oDiaChi.addEventListener('input', function () {
      var val = this.value;
      nutXoaDc.style.display = val.length > 0 ? 'block' : 'none';
      timKiemDiaChi(val);
    });

    oDiaChi.addEventListener('focus', function () {
      if (this.value.trim().length >= 2 && dsGoiY.children.length > 0) {
        dsGoiY.style.display = 'block';
      }
    });

    // Ẩn dropdown khi click ra ngoài
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.gh-search-container')) {
        dsGoiY.style.display = 'none';
      }
    });
  }

  // Nút xóa địa chỉ
  if (nutXoaDc) {
    nutXoaDc.onclick = function () {
      oDiaChi.value = '';
      this.style.display = 'none';
      dsGoiY.style.display = 'none';
      oDiaChi.focus();
    };
  }

  // Nút lấy vị trí hiện tại của tôi (GPS)
  var nutViTri = document.getElementById('nut-vi-tri');
  if (nutViTri) {
    nutViTri.onclick = function () {
      var nut = this;
      if (!navigator.geolocation) { alert(I18N.khongHoTro); return; }
      nut.disabled = true;
      nut.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + I18N.dangLayViTri;
      oDiaChi.value = 'Đang xác định vị trí của bạn...';
      
      navigator.geolocation.getCurrentPosition(function (v) {
        dungBanDo();
        var lat = v.coords.latitude;
        var lng = v.coords.longitude;
        if (ban_do) {
          ban_do.flyTo([lat, lng], 16, { animate: true, duration: 1.2 });
        }
        datGhim(lat, lng, true);
        nut.disabled = false;
        nut.innerHTML = '<i class="fas fa-crosshairs"></i> ' + I18N.dungViTri;
      }, function () {
        oDiaChi.value = '';
        alert(I18N.loiViTri);
        nut.disabled = false;
        nut.innerHTML = '<i class="fas fa-crosshairs"></i> ' + I18N.dungViTri;
      }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 });
    };
  }

  // Submit Form Validation
  form.onsubmit = function (e) {
    if (!kiemTra()) { e.preventDefault(); oGio.focus(); return false; }
    if (!oDiaChi.value.trim()) { alert(I18N.loiDiaChi); oDiaChi.focus(); e.preventDefault(); return false; }
    if (!oViDo.value || !oKinhDo.value) {
      var tam = (NHA_HANG && NHA_HANG.vi_do && NHA_HANG.kinh_do)
        ? [Number(NHA_HANG.vi_do), Number(NHA_HANG.kinh_do)]
        : [10.734646, 106.703505];
      oViDo.value = (tam[0] + 0.003).toFixed(6);
      oKinhDo.value = (tam[1] + 0.003).toFixed(6);
    }
    if (baoGia && !baoGia.giao_duoc) { alert(baoGia.ly_do || I18N.loiBaoGia); e.preventDefault(); return false; }
    
    var nut = form.querySelector('button[type=submit]');
    nut.disabled = true;
    nut.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + I18N.dangGui;
  };

  // Khởi động bản đồ
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', dungBanDo);
  } else {
    dungBanDo();
  }
  window.addEventListener('load', dungBanDo);
  setTimeout(dungBanDo, 300);
})();
</script>

