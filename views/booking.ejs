<%- include('partials/header', { title: t('dat_ban.tieu_de') }) %>

<%
  /*
    MOT FORM, HAI HINH THUC

    Truoc day trang nay chi lam duoc mot viec: dat ban an tai cho. Cot
    `hopdong.loai_don` da co gia tri 'giao_hang' tu lau va tro ly ao van hua
    "nha hang co giao hang trong ban kinh 5km", nhung khong co cho nao tren
    website de khach chon.

    Tach thanh hai trang rieng se phai nhan doi ca gio hang, tom tat don, kiem
    tra ngay gio va man hinh xac nhan. Nen o day dung mot form, doi phan giua
    theo lua chon:

        Tai cho    → so khach + dip dat ban        (nhu cu, khong doi gi)
        Giao hang  → dia chi + ghim ban do + phi   (phan moi)

    HAI O BAT BUOC CUA NHANH CU
    ---------------------------
    `khach` va `noidung` la NOT NULL trong CSDL va dang `required` tren form.
    Khi khach chon giao hang, hai nhom nut do bi VO HIEU HOA (`disabled`) chu
    khong phai chi bi an: o bi vo hieu hoa khong tham gia kiem tra `required`
    va khong duoc gui len. An bang CSS thoi thi trinh duyet se tu choi gui form
    kem mot thong bao tro toi mot o vo hinh - loi kho hieu nhat co the gap.
    Hai o an di ben duoi cung ten se duoc bat len de thay the.
  */
  var coGiaoHang = typeof giaoHang !== 'undefined' && giaoHang && giaoHang.bat;
  var diaChiCu = (typeof khach !== 'undefined' && khach && khach.diachi) ? khach.diachi : '';
%>

<% if (coGiaoHang) { %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
<% } %>

<style>
  .hinh-thuc { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  @media (max-width:520px) { .hinh-thuc { grid-template-columns:1fr; } }
  .ht-o { position:relative; }
  .ht-o input { position:absolute; opacity:0; pointer-events:none; }
  .ht-o span { display:block; border:2px solid #e3d9cc; border-radius:12px; padding:16px 14px;
               cursor:pointer; transition:.18s; background:#fff; }
  .ht-o input:checked + span { border-color:var(--nh-gold); background:#fffdf7;
                               box-shadow:0 4px 16px rgba(200,169,81,.18); }
  .ht-o b { display:block; font-size:16px; margin-bottom:3px; }
  .ht-o small { color:#8a8a8a; line-height:1.5; display:block; }
  .ht-o i { color:var(--nh-gold); margin-right:6px; }

  #gh-ban-do { height:280px; border-radius:12px; margin-top:10px; z-index:1; }
  .gh-phi { background:#fffdf7; border:1px solid #eee3d0; border-radius:12px;
            padding:13px 15px; margin-top:12px; font-size:14px; line-height:1.65; }
  .gh-phi b { color:var(--nh-gold); font-size:17px; }
  .gh-phi--loi { background:#fdf0ee; border-color:#f0c8c0; color:#b03a2e; }
  .gh-nut { display:inline-flex; align-items:center; gap:7px; background:#2c1810; color:#fff;
            border:0; border-radius:10px; padding:11px 16px; font-size:14px; font-weight:600;
            cursor:pointer; margin-top:10px; }
  .gh-nut:disabled { opacity:.55; }
</style>

<section class="nh-subhero" style="min-height:38vh">
  <div class="nh-subhero__bg nh-wa-koshi"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('dat_ban.eyebrow') %></span>
    <h1 id="tieu-de"><%= t('dat_ban.tieu_de') %></h1>
    <div class="nh-crumbs"><a href="/"><%= t('dieu_huong.trang_chu') %></a> &nbsp;/&nbsp; <a href="/cart"><%= t('gio_hang.tieu_de') %></a> &nbsp;/&nbsp; <span id="crumb"><%= t('dat_ban.tieu_de') %></span></div>
  </div>
</section>

<section class="nh-section nh-section--cream">
  <div class="nh-container">
    <%- include('partials/nh-steps', { buoc: 3 }) %>

    <form action="/datban" method="post" id="form-datban">
      <%
        /* Tên và số điện thoại lấy thẳng từ phiên đăng nhập, không cho sửa: đây
           là thông tin nhà hàng dùng để gọi lại xác nhận, sửa được thì đơn có
           thể mang tên người khác. Ô hiển thị chỉ để khách đối chiếu; giá trị
           thật đi kèm trong hai input ẩn bên dưới. */
      %>
      <input type="hidden" name="hoten" value="<%= session.username %>">
      <input type="hidden" name="sdt" value="<%= session.usersdt %>">

      <div class="nh-checkout">
        <div>
          <% if (coGiaoHang) { %>
            <!-- Hình thức -->
            <div class="nh-panel nh-reveal">
              <h3 class="nh-panel__title"><i class="fas fa-hand-pointer"></i> <%= t('dat_ban.hinh_thuc') %></h3>
              <div class="hinh-thuc">
                <label class="ht-o">
                  <input type="radio" name="hinh_thuc" value="tai_cho" checked>
                  <span>
                    <b><i class="fas fa-utensils"></i><%= t('dat_ban.tai_cho') %></b>
                    <small><%= t('dat_ban.tai_cho_mo_ta') %></small>
                  </span>
                </label>
                <label class="ht-o">
                  <input type="radio" name="hinh_thuc" value="giao_hang">
                  <span>
                    <b><i class="fas fa-motorcycle"></i><%= t('dat_ban.giao_hang') %></b>
                    <small>
                      <%= t('dat_ban.giao_hang_mo_ta', { km: giaoHang.ban_kinh_km }) %>
                      <% if (giaoHang.mien_phi_tu > 0) { %>
                        <%= t('dat_ban.mien_phi_tu', { tien: formatMoney(giaoHang.mien_phi_tu) }) %>
                      <% } %>
                    </small>
                  </span>
                </label>
              </div>
            </div>

            <!-- Địa chỉ giao (chỉ hiện khi chọn giao hàng) -->
            <div class="nh-panel nh-reveal" id="khoi-giao" style="display:none">
              <h3 class="nh-panel__title"><i class="fas fa-location-dot"></i> <%= t('dat_ban.giao_toi_dau') %></h3>

              <div class="nh-field">
                <label><%= t('dat_ban.dia_chi_nhan') %> <span class="req">*</span></label>
                <input class="nh-input" name="dia_chi_giao" id="o-dia-chi" maxlength="300"
                       value="<%= diaChiCu %>" placeholder="<%= t('dat_ban.dia_chi_goi_y') %>">
                <span class="nh-hint"><%= t('dat_ban.dia_chi_chi_tiet') %></span>
              </div>

              <div class="nh-fields">
                <div class="nh-field">
                  <label><%= t('dat_ban.nguoi_nhan') %></label>
                  <input class="nh-input" name="ten_nguoi_nhan" maxlength="120"
                         value="<%= session.username %>">
                </div>
                <div class="nh-field">
                  <label><%= t('dat_ban.sdt_nguoi_nhan') %></label>
                  <input class="nh-input" name="sdt_nguoi_nhan" maxlength="20"
                         value="<%= session.usersdt %>">
                </div>
              </div>

              <div class="nh-field">
                <label><%= t('dat_ban.ghi_chu_shipper') %></label>
                <input class="nh-input" name="ghi_chu_giao" maxlength="300"
                       placeholder="<%= t('dat_ban.ghi_chu_shipper_goi_y') %>">
              </div>

              <label style="display:block; margin-top:6px; font-weight:600">
                <%= t('dat_ban.ghim_ban_do') %> <span class="req">*</span>
              </label>
              <span class="nh-hint">
                <%= t('dat_ban.ghim_huong_dan') %>
              </span>
              <button type="button" class="gh-nut" id="nut-vi-tri">
                <i class="fas fa-crosshairs"></i> <%= t('dat_ban.dung_vi_tri') %>
              </button>
              <div id="gh-ban-do"></div>

              <input type="hidden" name="vi_do" id="o-vi-do">
              <input type="hidden" name="kinh_do" id="o-kinh-do">

              <div class="gh-phi" id="gh-phi">
                <%= t('dat_ban.chua_ghim') %>
              </div>
            </div>

            <%
              /* Hai ô thay thế cho `khach` và `noidung` khi chọn giao hàng.
                 Bắt đầu ở trạng thái disabled để nhánh đặt bàn cũ không bị gửi
                 lên hai giá trị cùng tên. */
            %>
            <input type="hidden" name="khach" value="1" disabled id="gh-khach">
            <input type="hidden" name="noidung" value="Giao hàng tận nơi" disabled id="gh-noidung">
          <% } %>

          <!-- Người đặt -->
          <div class="nh-panel nh-reveal">
            <h3 class="nh-panel__title"><i class="fas fa-user"></i> <%= t('dat_ban.nguoi_dat') %></h3>
            <div class="nh-fields">
              <div class="nh-field">
                <label><%= t('chung.ho_ten') %> <span class="nh-locked"><%= t('chung.tu_dong') %></span></label>
                <input class="nh-input" type="text" value="<%= session.username %>" readonly>
              </div>
              <div class="nh-field">
                <label><%= t('chung.dien_thoai') %> <span class="nh-locked"><%= t('chung.tu_dong') %></span></label>
                <input class="nh-input" type="text" value="<%= session.usersdt %>" readonly>
              </div>
            </div>
            <p class="nh-note">
              <%= t('dat_ban.lay_tu_tai_khoan') %>
              <a href="/profile" style="color:var(--nh-gold); font-weight:600"><%= t('dat_ban.thong_tin_ca_nhan') %></a>.
            </p>
          </div>

          <!-- Thời gian -->
          <div class="nh-panel nh-reveal">
            <h3 class="nh-panel__title"><i class="fas fa-calendar-alt"></i> <%= t('dat_ban.thoi_gian') %></h3>
            <div class="nh-fields">
              <div class="nh-field">
                <label id="nhan-ngay"><%= t('dat_ban.ngay_den') %> <span class="req">*</span></label>
                <input class="nh-input" type="date" name="datebook" id="o-ngay" required
                       min="<%= new Date().toISOString().slice(0,10) %>">
                <span class="nh-hint" id="hint-ngay"><%= t('dat_ban.chi_tu_hom_nay') %></span>
              </div>
              <div class="nh-field">
                <label id="nhan-gio"><%= t('dat_ban.gio_den') %> <span class="req">*</span></label>
                <input class="nh-input" type="time" name="timebook" id="o-gio" required value="18:00">
                <span class="nh-hint"><%= t('dat_ban.gio_phuc_vu') %></span>
              </div>
            </div>
          </div>

          <!-- Số khách -->
          <div class="nh-panel nh-reveal" id="khoi-khach">
            <h3 class="nh-panel__title"><i class="fas fa-users"></i> <%= t('dat_ban.so_khach') %> <span class="req" style="color:#c0392b">*</span></h3>
            <div class="nh-chips">
              <% ['2','4','6','8','10-15','15-20'].forEach(function (n, i) { %>
                <label class="nh-chip">
                  <input type="radio" name="khach" value="<%= n %>" required <%= i === 0 ? '' : '' %>>
                  <span><i class="fas fa-user-friends"></i> <%= n %> <%= t('chung.nguoi') %></span>
                </label>
              <% }) %>
            </div>
          </div>

          <!-- Dịp -->
          <div class="nh-panel nh-reveal" id="khoi-dip">
            <h3 class="nh-panel__title"><i class="fas fa-champagne-glasses"></i> <%= t('dat_ban.dip') %> <span class="req" style="color:#c0392b">*</span></h3>
            <div class="nh-chips">
              <%
                var DIP = [
                  { v: 'Dùng bữa thường', nhan: t('dat_ban.dip_thuong'), i: 'fa-utensils' },
                  { v: 'Sinh nhật', nhan: t('dat_ban.dip_sinh_nhat'), i: 'fa-cake-candles' },
                  { v: 'Tiệc cưới', nhan: t('dat_ban.dip_cuoi'), i: 'fa-ring' },
                  { v: 'Cuộc họp', nhan: t('dat_ban.dip_hop'), i: 'fa-briefcase' },
                  { v: 'Khác', nhan: t('dat_ban.dip_khac'), i: 'fa-ellipsis' },
                ];
              %>
              <% DIP.forEach(function (d) { %>
                <label class="nh-chip">
                  <input type="radio" name="noidung" value="<%= d.v %>" required>
                  <span><i class="fas <%= d.i %>"></i> <%= d.nhan %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Tóm tắt đơn -->
        <aside class="nh-summary nh-reveal">
          <div class="nh-panel">
            <h3 class="nh-panel__title"><i class="fas fa-receipt"></i> <%= t('dat_ban.don_cua_ban') %></h3>

            <% if (typeof cartItems !== 'undefined' && cartItems && cartItems.length) { %>
              <% cartItems.forEach(function (item) { %>
                <div class="nh-summary__row">
                  <span><%= (item.name_mon || '').trim() %> <span style="color:var(--nh-gold)">×<%= item.soluong %></span></span>
                  <span><%= formatMoney(item.soluong * item.gia_mon) %> ₫</span>
                </div>
              <% }) %>
              <% if (coGiaoHang) { %>
                <div class="nh-summary__row" id="dong-phi" style="display:none">
                  <span><%= t('dat_ban.phi_giao') %></span>
                  <span id="dong-phi-so">—</span>
                </div>
              <% } %>
              <div class="nh-summary__total">
                <span><%= t('chung.tong_cong') %></span>
                <b><span id="tong-tien"><%= formatMoney(subtotal) %></span> ₫</b>
              </div>
              <a href="/cart" class="nh-hint" style="display:inline-block; margin-top:.6rem; color:var(--nh-gold); font-weight:600">
                <i class="fas fa-pen"></i> <%= t('dat_ban.sua_mon') %>
              </a>
            <% } %>

            <button type="submit" class="nh-btn nh-btn--gold" id="nut-gui">
              <span id="chu-nut"><%= t('dat_ban.xac_nhan_dat_ban') %></span> <i class="fas fa-arrow-right"></i>
            </button>

            <p class="nh-note" id="ghi-chu-cuoi">
              <%- t('dat_ban.ghi_chu_tai_cho') %>
            </p>
          </div>
        </aside>
      </div>
    </form>
  </div>
</section>

<% if (coGiaoHang) { %><script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script><% } %>
<script>
/*
  Chuoi ngon ngu cho phan JavaScript cua trang nay.

  Cac chuoi trong ma JavaScript khong the goi thang `t()` - `t()` chay o may
  chu luc dung HTML, con doan nay chay o trinh duyet sau do. Nen dong het vao
  mot doi tuong duy nhat, sinh boi may chu ngay tai day.

  Gom thanh MOT khoi thay vi rai `<%%= t(...) %%>` giua ma JavaScript vi hai le:
  ma con doc duoc nhu ma, va them mot chuoi moi chi la them mot dong o day.
*/
var NN = {
  chiTuHomNay:   <%- JSON.stringify(t('dat_ban.chi_tu_hom_nay')) %>,
  gioDaQua:      <%- JSON.stringify(t('dat_ban.gio_da_qua')) %>,
  datHomNay:     <%- JSON.stringify(t('dat_ban.dat_trong_hom_nay')) %>,
  dangGui:       <%- JSON.stringify(t('chung.dang_gui')) %>,
  tieuDe:        <%- JSON.stringify(t('dat_ban.tieu_de')) %>,
  tieuDeGiao:    <%- JSON.stringify(t('dat_ban.tieu_de_giao')) %>,
  giaoHang:      <%- JSON.stringify(t('dat_ban.giao_hang')) %>,
  ngayDen:       <%- JSON.stringify(t('dat_ban.ngay_den')) %>,
  gioDen:        <%- JSON.stringify(t('dat_ban.gio_den')) %>,
  ngayNhan:      <%- JSON.stringify(t('dat_ban.ngay_nhan')) %>,
  gioNhan:       <%- JSON.stringify(t('dat_ban.gio_nhan')) %>,
  xacNhanDatBan: <%- JSON.stringify(t('dat_ban.xac_nhan_dat_ban')) %>,
  datGiaoHang:   <%- JSON.stringify(t('dat_ban.dat_giao_hang')) %>,
  ghiChuTaiCho:  <%- JSON.stringify(t('dat_ban.ghi_chu_tai_cho')) %>,
  ghiChuGiao:    <%- JSON.stringify(t('dat_ban.ghi_chu_giao')) %>,
  dangTinhPhi:   <%- JSON.stringify(t('dat_ban.dang_tinh_phi')) %>,
  dangLayViTri:  <%- JSON.stringify(t('dat_ban.dang_lay_vi_tri')) %>,
  dungViTri:     <%- JSON.stringify(t('dat_ban.dung_vi_tri')) %>,
  cachNhaHang:   <%- JSON.stringify(t('dat_ban.cach_nha_hang')) %>,
  phiGiao:       <%- JSON.stringify(t('dat_ban.phi_giao')) %>,
  mienPhi:       <%- JSON.stringify(t('chung.mien_phi')) %>,
  duocMienPhi:   <%- JSON.stringify(t('dat_ban.duoc_mien_phi')) %>,
  camKetTrong:   <%- JSON.stringify(t('dat_ban.cam_ket_trong')) %>,
  loiDiaChi:     <%- JSON.stringify(t('dat_ban.loi_dia_chi')) %>,
  loiGhim:       <%- JSON.stringify(t('dat_ban.loi_ghim')) %>,
  loiViTri:      <%- JSON.stringify(t('dat_ban.loi_vi_tri')) %>,
  khongHoTro:    <%- JSON.stringify(t('dat_ban.loi_khong_ho_tro')) %>,
  loiBaoGia:     <%- JSON.stringify(t('dat_ban.loi_bao_gia')) %>,
  khongGiaoDuoc: <%- JSON.stringify(t('dat_ban.loi_bao_gia')) %>,
};
(function () {
  var form = document.getElementById('form-datban');
  var oNgay = document.getElementById('o-ngay');
  var oGio = document.getElementById('o-gio');
  var hint = document.getElementById('hint-ngay');

  // Mặc định là hôm nay để khách đặt trong ngày chỉ phải chọn giờ.
  var homNay = new Date();
  var yyyymmdd = homNay.getFullYear() + '-' +
    String(homNay.getMonth() + 1).padStart(2, '0') + '-' +
    String(homNay.getDate()).padStart(2, '0');
  if (!oNgay.value) oNgay.value = yyyymmdd;

  // Đặt trong ngày mà chọn giờ đã trôi qua thì báo ngay tại chỗ, chứ để server
  // trả về alert() rồi history.back() là mất hết những gì vừa điền.
  function kiemTra() {
    if (oNgay.value !== yyyymmdd) { hint.textContent = NN.chiTuHomNay; hint.style.color = ''; return true; }
    var g = (oGio.value || '').split(':');
    if (g.length < 2) return true;
    var chon = new Date(); chon.setHours(Number(g[0]), Number(g[1]), 0, 0);
    if (chon <= new Date()) {
      hint.textContent = NN.gioDaQua;
      hint.style.color = '#c0392b';
      return false;
    }
    hint.textContent = NN.datHomNay; hint.style.color = '';
    return true;
  }
  oNgay.onchange = kiemTra;
  oGio.onchange = kiemTra;

  form.onsubmit = function (e) {
    if (!kiemTra()) { e.preventDefault(); oGio.focus(); return false; }
    if (typeof kiemTraGiaoHang === 'function' && !kiemTraGiaoHang()) { e.preventDefault(); return false; }
    var nut = form.querySelector('button[type=submit]');
    nut.disabled = true;
    nut.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + NN.dangGui;
  };

<% if (coGiaoHang) { %>
  // ======================================================================
  // NHÁNH GIAO HÀNG
  // ======================================================================
  var NHA_HANG = <%- JSON.stringify(giaoHang.nha_hang) %>;
  var TIEN_HANG = <%= Number(subtotal) || 0 %>;

  var khoiGiao = document.getElementById('khoi-giao');
  var khoiKhach = document.getElementById('khoi-khach');
  var khoiDip = document.getElementById('khoi-dip');
  var oViDo = document.getElementById('o-vi-do');
  var oKinhDo = document.getElementById('o-kinh-do');
  var oDiaChi = document.getElementById('o-dia-chi');
  var hopPhi = document.getElementById('gh-phi');
  var dongPhi = document.getElementById('dong-phi');
  var dongPhiSo = document.getElementById('dong-phi-so');
  var tongTien = document.getElementById('tong-tien');
  var ghKhach = document.getElementById('gh-khach');
  var ghNoiDung = document.getElementById('gh-noidung');

  var laGiao = false;
  var baoGia = null;
  var ban_do = null, ghim = null;

  function tien(n) { return Math.round(Number(n) || 0).toLocaleString('vi-VN'); }

  /* Bật/tắt hai nhóm bắt buộc của nhánh đặt bàn.
     Phải dùng `disabled` chứ không chỉ ẩn — xem ghi chú đầu tệp. */
  function doiHinhThuc(giao) {
    laGiao = giao;
    khoiGiao.style.display = giao ? '' : 'none';
    khoiKhach.style.display = giao ? 'none' : '';
    khoiDip.style.display = giao ? 'none' : '';

    form.querySelectorAll('#khoi-khach input, #khoi-dip input').forEach(function (o) {
      o.disabled = giao;
    });
    ghKhach.disabled = !giao;
    ghNoiDung.disabled = !giao;

    document.getElementById('tieu-de').textContent = giao ? NN.tieuDeGiao : NN.tieuDe;
    document.getElementById('crumb').textContent = giao ? NN.giaoHang : NN.tieuDe;
    document.getElementById('nhan-ngay').innerHTML = (giao ? NN.ngayNhan : NN.ngayDen) + ' <span class="req">*</span>';
    document.getElementById('nhan-gio').innerHTML = (giao ? NN.gioNhan : NN.gioDen) + ' <span class="req">*</span>';
    document.getElementById('chu-nut').textContent = giao ? NN.datGiaoHang : NN.xacNhanDatBan;
    document.getElementById('ghi-chu-cuoi').innerHTML = giao ? NN.ghiChuGiao : NN.ghiChuTaiCho;

    dongPhi.style.display = (giao && baoGia && baoGia.giao_duoc) ? '' : 'none';
    veTong();
    if (giao) setTimeout(dungBanDo, 60);   // đợi khối hiện ra rồi Leaflet mới đo được kích thước
  }

  function veTong() {
    var them = (laGiao && baoGia && baoGia.giao_duoc) ? Number(baoGia.phi) : 0;
    tongTien.textContent = tien(TIEN_HANG + them);
  }

  /* Leaflet đo kích thước khung lúc khởi tạo. Dựng bản đồ trong một khối
     display:none thì nó nghĩ khung rộng 0px và chỉ vẽ một mảng xám. Nên hoãn
     tới lần đầu khối được hiện ra, và gọi invalidateSize() cho các lần sau. */
  function dungBanDo() {
    var tam = NHA_HANG ? [NHA_HANG.vi_do, NHA_HANG.kinh_do] : [10.7756, 106.7019];
    if (ban_do) { ban_do.invalidateSize(); return; }

    ban_do = L.map('gh-ban-do').setView(tam, 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(ban_do);

    if (NHA_HANG) {
      L.marker(tam, {
        icon: L.divIcon({
          className: '',
          html: '<div style="display:flex;align-items:center;justify-content:center;width:28px;' +
                'height:28px;border-radius:50%;background:#2c1810;color:#fff;border:2px solid #fff;' +
                'box-shadow:0 2px 8px rgba(0,0,0,.35)"><i class="fas fa-utensils"></i></div>',
          iconSize: [28, 28], iconAnchor: [14, 14],
        }),
      }).addTo(ban_do).bindPopup(<%- JSON.stringify(t('chung.ten_nha_hang')) %>);
    }

    ban_do.on('click', function (e) { datGhim(e.latlng.lat, e.latlng.lng); });
  }

  function datGhim(viDo, kinhDo) {
    oViDo.value = viDo;
    oKinhDo.value = kinhDo;

    if (ghim) ghim.setLatLng([viDo, kinhDo]);
    else {
      ghim = L.marker([viDo, kinhDo], { draggable: true }).addTo(ban_do);
      // Kéo được ghim: bấm một phát hiếm khi trúng đúng số nhà, và phóng to rồi
      // bấm lại là hai thao tác thay vì một.
      ghim.on('dragend', function () {
        var v = ghim.getLatLng();
        oViDo.value = v.lat; oKinhDo.value = v.lng;
        hoiPhi();
      });
    }
    hoiPhi();
  }

  var henHoi = null;
  function hoiPhi() {
    clearTimeout(henHoi);
    hopPhi.className = 'gh-phi';
    hopPhi.textContent = NN.dangTinhPhi;
    // Gom các lần kéo ghim liên tiếp thành một lần hỏi.
    henHoi = setTimeout(function () {
      fetch('/api/giao-hang/bao-gia?vi_do=' + oViDo.value + '&kinh_do=' + oKinhDo.value +
            '&tien_hang=' + TIEN_HANG)
        .then(function (r) { return r.json(); })
        .then(function (d) {
          baoGia = d;
          if (!d.giao_duoc) {
            hopPhi.className = 'gh-phi gh-phi--loi';
            hopPhi.textContent = d.ly_do || NN.khongGiaoDuoc;
            dongPhi.style.display = 'none';
            veTong();
            return;
          }
          hopPhi.className = 'gh-phi';
          hopPhi.innerHTML =
            NN.cachNhaHang + ' <b>' + d.khoang_cach_km + ' km</b> · ' + NN.phiGiao + ' <b>' +
            (d.phi > 0 ? tien(d.phi) + ' ₫' : NN.mienPhi) + '</b>' +
            (d.mien_phi ? ' <span style="color:#198754">' + NN.duocMienPhi + '</span>' : '') +
            (d.don_vi ? '<br><span style="color:#8a8a8a">' + d.don_vi.ten_dv + ' · ' +
              NN.camKetTrong.replace('{phut}', d.don_vi.thoi_gian_cam_ket_phut) + '</span>' : '');
          dongPhiSo.textContent = (d.phi > 0 ? tien(d.phi) : 0) + ' ₫';
          dongPhi.style.display = '';
          veTong();
        })
        .catch(function () {
          hopPhi.className = 'gh-phi gh-phi--loi';
          hopPhi.textContent = NN.loiBaoGia;
        });
    }, 350);
  }

  document.getElementById('nut-vi-tri').onclick = function () {
    var nut = this;
    if (!navigator.geolocation) { alert(NN.khongHoTro); return; }
    nut.disabled = true;
    nut.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + NN.dangLayViTri;
    navigator.geolocation.getCurrentPosition(function (v) {
      dungBanDo();
      ban_do.setView([v.coords.latitude, v.coords.longitude], 17);
      datGhim(v.coords.latitude, v.coords.longitude);
      nut.disabled = false;
      nut.innerHTML = '<i class="fas fa-crosshairs"></i> ' + NN.dungViTri;
    }, function () {
      // Không nói "lỗi": người dùng vừa chủ động từ chối, hoặc đang ở trong nhà
      // không bắt được vệ tinh. Cả hai đều có cách đi tiếp là bấm vào bản đồ.
      alert(NN.loiViTri);
      nut.disabled = false;
      nut.innerHTML = '<i class="fas fa-crosshairs"></i> ' + NN.dungViTri;
    }, { enableHighAccuracy: true, timeout: 12000 });
  };

  /* Chặn ở trình duyệt những gì máy chủ cũng sẽ chặn.
     Không phải để tin vào trình duyệt — máy chủ vẫn kiểm tra lại tất cả — mà để
     khách biết ngay tại chỗ, thay vì mất hết những gì vừa điền rồi mới biết. */
  window.kiemTraGiaoHang = function () {
    if (!laGiao) return true;
    if (!oDiaChi.value.trim()) { alert(NN.loiDiaChi); oDiaChi.focus(); return false; }
    if (!oViDo.value) { alert(NN.loiGhim); return false; }
    if (baoGia && !baoGia.giao_duoc) { alert(baoGia.ly_do || NN.khongGiaoDuoc); return false; }
    return true;
  };

  form.querySelectorAll('input[name=hinh_thuc]').forEach(function (o) {
    o.onchange = function () { doiHinhThuc(this.value === 'giao_hang'); };
  });
  doiHinhThuc(false);
<% } %>
})();
</script>

