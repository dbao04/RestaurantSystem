<%- include('partials/header', { title: t('dat_ban.buoc_1_tieu_de') }) %>

<%
  var coGiaoHang = typeof giaoHang !== 'undefined' && giaoHang && giaoHang.bat;
  var tt = typeof thongTinGiao !== 'undefined' && thongTinGiao ? thongTinGiao : null;
  var diaChiMacDinh = tt ? tt.dia_chi_giao : ((typeof khach !== 'undefined' && khach && khach.diachi) ? khach.diachi : '');
  var tenMacDinh = tt ? tt.ten_nguoi_nhan : (session.username || '');
  var sdtMacDinh = tt ? tt.sdt_nguoi_nhan : (session.usersdt || '');
  var ghiChuMacDinh = tt ? tt.ghi_chu_giao : '';
  var viDoMacDinh = tt ? tt.vi_do : '';
  var kinhDoMacDinh = tt ? tt.kinh_do : '';
  var ngayMacDinh = tt ? tt.datebook : '';
  var gioMacDinh = tt ? tt.timebook : '18:00';
%>

<style>
  .gh-map-wrapper {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    margin-top: 14px;
    border: 1.5px solid var(--nh-border, #e3d9cc);
    box-shadow: 0 6px 24px rgba(0,0,0,0.08);
    background: #f0ede8;
  }
  #gh-ban-do {
    height: 390px;
    min-height: 390px;
    width: 100%;
    z-index: 10;
    position: relative;
    border-radius: 14px;
  }
  .leaflet-container {
    background: #e8e5e0 !important;
    font-family: inherit !important;
  }
  .leaflet-container img {
    max-width: none !important;
  }
  .leaflet-tile-container img {
    max-width: none !important;
  }
  .gh-map-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-top: 12px;
  }
  .gh-nut-tool {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--nh-surface, #ffffff);
    color: var(--nh-text, #2c1810);
    border: 1px solid var(--nh-border, #e3d9cc);
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all .2s ease;
  }
  .gh-nut-tool:hover {
    background: var(--nh-gold, #c8a24b);
    color: #2c1810;
    border-color: var(--nh-gold, #c8a24b);
    transform: translateY(-1px);
  }
  .gh-nut-tool--primary {
    background: #2c1810;
    color: #ffffff;
    border-color: #2c1810;
  }
  .gh-nut-tool--primary:hover {
    background: var(--nh-gold, #c8a24b);
    color: #2c1810;
  }
  .gh-quick-areas {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
    align-items: center;
  }
  .gh-quick-label {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--nh-text-sub, #777);
    margin-right: 4px;
  }
  .gh-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 11px;
    background: rgba(200, 162, 75, 0.12);
    border: 1px solid rgba(200, 162, 75, 0.35);
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--nh-text, #2c1810);
    cursor: pointer;
    transition: all .18s ease;
  }
  .gh-chip:hover, .gh-chip.active {
    background: var(--nh-gold, #c8a24b);
    color: #2c1810;
    border-color: var(--nh-gold, #c8a24b);
    transform: scale(1.03);
  }
  .gh-map-banner {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    z-index: 500;
    background: rgba(44, 24, 16, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    padding: 8px 14px;
    border-radius: 10px;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 4px 15px rgba(0,0,0,0.25);
    pointer-events: none;
  }
  .gh-fee-card {
    background: var(--nh-surface, #fffdf7);
    border: 1.5px solid var(--nh-border, #eee3d0);
    border-radius: 14px;
    padding: 16px 18px;
    margin-top: 14px;
    transition: all .25s ease;
    box-shadow: 0 3px 12px rgba(0,0,0,0.03);
  }
  .gh-fee-card__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 600px) {
    .gh-fee-card__grid { grid-template-columns: 1fr; }
  }
  .gh-fee-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .gh-fee-item__icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(200, 162, 75, 0.15);
    color: var(--nh-gold, #c8a24b);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }
  .gh-fee-item__val {
    font-size: 15px;
    font-weight: 700;
    color: var(--nh-text, #2c1810);
  }
  .gh-fee-item__lbl {
    font-size: 12px;
    color: var(--nh-text-sub, #888);
  }
  .gh-fee-card--loi {
    background: #fdf0ee;
    border-color: #f0c8c0;
    color: #b03a2e;
  }
  .giao-hang-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #e8f5e9;
    color: #2e7d32;
    font-weight: 600;
    font-size: 13px;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .luong-huongdan { list-style:none; padding:0; margin:1rem 0 0; }
  .luong-huongdan li { display:flex; gap:12px; margin-bottom:14px; align-items:flex-start; font-size:0.92rem; }
  .luong-huongdan__so { width:24px; height:24px; border-radius:50%; background:var(--nh-gold); color:#2c1810;
                        display:flex; align-items:center; justify-content:center; font-weight:700; font-size:0.8rem; flex-shrink:0; }

  /* Marker Pulse Animation */
  @keyframes markerPulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
    70% { transform: scale(1.05); box-shadow: 0 0 0 14px rgba(220, 53, 69, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
  }
  .gh-pulse-marker {
    animation: markerPulse 2s infinite;
    border-radius: 50%;
  }
</style>

<section class="nh-subhero" style="min-height:36vh">
  <div class="nh-subhero__bg nh-wa-koshi"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('dat_ban.dich_vu_giao_tan_noi') %></span>
    <h1 id="tieu-de"><%= t('dat_ban.buoc_1_tieu_de') %></h1>
    <div class="nh-crumbs">
      <a href="/"><%= t('dieu_huong.trang_chu') %></a> &nbsp;/&nbsp; 
      <span><%= t('dat_ban.dich_vu_giao_tan_noi') %></span> &nbsp;/&nbsp; 
      <span><%= t('buoc.b1_giao_hang') %></span>
    </div>
  </div>
</section>

<section class="nh-section nh-section--cream">
  <div class="nh-container">
    <%- include('partials/nh-steps', { buoc: 1 }) %>

    <form action="/giao-hang" method="post" id="form-giaohang">
      <div class="nh-checkout">
        <div>
          <!-- Thông tin giao hàng & Bản đồ -->
          <div class="nh-panel nh-reveal">
            <div class="giao-hang-badge">
              <i class="fas fa-motorcycle"></i> <%= t('dat_ban.giao_tan_noi_ban_kinh', { km: (giaoHang && giaoHang.ban_kinh_km) ? giaoHang.ban_kinh_km : 5 }) %>
              <% if (giaoHang && giaoHang.mien_phi_tu > 0) { %>
                · <%= t('dat_ban.mien_phi_tu_ngan', { tien: formatMoney(giaoHang.mien_phi_tu) }) %>
              <% } %>
            </div>

            <h3 class="nh-panel__title"><i class="fas fa-location-dot"></i> <%= t('dat_ban.dia_chi_nhan') %></h3>

            <div class="nh-field">
              <label><%= t('dat_ban.dia_chi_nhan_mon') %> <span class="req" style="color:#c0392b">*</span></label>
              <input class="nh-input" name="dia_chi_giao" id="o-dia-chi" maxlength="300" required
                     value="<%= diaChiMacDinh %>" placeholder="<%= t('dat_ban.dia_chi_goi_y') %>">
              <span class="nh-hint"><%= t('dat_ban.dia_chi_nhan_hint') %></span>
            </div>

            <div class="nh-fields">
              <div class="nh-field">
                <label><%= t('dat_ban.ten_nguoi_nhan_lbl') %> <span class="req" style="color:#c0392b">*</span></label>
                <input class="nh-input" name="ten_nguoi_nhan" maxlength="120" required
                       value="<%= tenMacDinh %>">
              </div>
              <div class="nh-field">
                <label><%= t('dat_ban.sdt_nguoi_nhan_lbl') %> <span class="req" style="color:#c0392b">*</span></label>
                <input class="nh-input" name="sdt_nguoi_nhan" maxlength="20" required
                       value="<%= sdtMacDinh %>">
              </div>
            </div>

            <div class="nh-field">
              <label><%= t('dat_ban.ghi_chu_shipper_lbl') %></label>
              <input class="nh-input" name="ghi_chu_giao" maxlength="300"
                     value="<%= ghiChuMacDinh %>"
                     placeholder="<%= t('dat_ban.ghi_chu_shipper_ph') %>">
            </div>

            <!-- Công cụ bản đồ & chọn vị trí -->
            <label style="display:block; margin-top:18px; font-weight:700; font-size:15px">
              <i class="fas fa-map-marked-alt" style="color:var(--nh-gold, #c8a24b)"></i> <%= t('dat_ban.vi_tri_ban_do') %> <span class="req" style="color:#c0392b">*</span>
            </label>
            <span class="nh-hint">
              <%= t('dat_ban.vi_tri_ban_do_hint') %>
            </span>

            <div class="gh-map-tools">
              <button type="button" class="gh-nut-tool gh-nut-tool--primary" id="nut-vi-tri">
                <i class="fas fa-crosshairs"></i> <%= t('dat_ban.dung_vi_tri_hien_tai') %>
              </button>
              <button type="button" class="gh-nut-tool" id="nut-ve-nha-hang">
                <i class="fas fa-store"></i> Về vị trí nhà hàng
              </button>
            </div>

            <!-- Chọn nhanh khu vực -->
            <div class="gh-quick-areas">
              <span class="gh-quick-label"><i class="fas fa-bolt"></i> Chọn nhanh khu vực:</span>
              <button type="button" class="gh-chip" data-lat="10.8231" data-lng="106.6873">Gò Vấp</button>
              <button type="button" class="gh-chip" data-lat="10.8016" data-lng="106.7118">Bình Thạnh</button>
              <button type="button" class="gh-chip" data-lat="10.7981" data-lng="106.6835">Phú Nhuận</button>
              <button type="button" class="gh-chip" data-lat="10.8015" data-lng="106.6558">Tân Bình</button>
              <button type="button" class="gh-chip" data-lat="10.7769" data-lng="106.7009">Quận 1</button>
              <button type="button" class="gh-chip" data-lat="10.7845" data-lng="106.6844">Quận 3</button>
              <button type="button" class="gh-chip" data-lat="10.8672" data-lng="106.6413">Quận 12</button>
              <button type="button" class="gh-chip" data-lat="10.8505" data-lng="106.7719">Thủ Đức</button>
            </div>

            <!-- Khung bản đồ tương tác -->
            <div class="gh-map-wrapper">
              <div class="gh-map-banner">
                <span><i class="fas fa-hand-pointer"></i> Nhấp bất cứ đâu trên bản đồ hoặc kéo thả ghim đỏ để chọn vị trí</span>
                <span id="gh-map-coords" style="font-size:11.5px; opacity:.85"></span>
              </div>
              <div id="gh-ban-do"></div>
            </div>

            <%
              var viDoGiaTri = viDoMacDinh || ((giaoHang && giaoHang.nha_hang && giaoHang.nha_hang.vi_do) ? (Number(giaoHang.nha_hang.vi_do) + 0.003).toFixed(6) : '10.737646');
              var kinhDoGiaTri = kinhDoMacDinh || ((giaoHang && giaoHang.nha_hang && giaoHang.nha_hang.kinh_do) ? (Number(giaoHang.nha_hang.kinh_do) + 0.003).toFixed(6) : '106.706505');
            %>
            <input type="hidden" name="vi_do" id="o-vi-do" value="<%= viDoGiaTri %>">
            <input type="hidden" name="kinh_do" id="o-kinh-do" value="<%= kinhDoGiaTri %>">

            <!-- Bảng cước phí & khoảng cách trực quan -->
            <div class="gh-fee-card" id="gh-phi-card">
              <div class="gh-fee-card__grid">
                <div class="gh-fee-item">
                  <div class="gh-fee-item__icon"><i class="fas fa-route"></i></div>
                  <div>
                    <div class="gh-fee-item__val" id="gh-val-km"><%= (tt && tt.khoang_cach_km) ? tt.khoang_cach_km + ' km' : 'Chưa chọn' %></div>
                    <div class="gh-fee-item__lbl">Khoảng cách giao</div>
                  </div>
                </div>
                <div class="gh-fee-item">
                  <div class="gh-fee-item__icon"><i class="fas fa-truck-fast"></i></div>
                  <div>
                    <div class="gh-fee-item__val" id="gh-val-phi" style="color:var(--nh-gold, #c8a24b)"><%= (tt && tt.phi_co_ban !== undefined) ? (tt.phi_co_ban > 0 ? formatMoney(tt.phi_co_ban) + ' ₫' : 'Miễn phí') : '0 ₫' %></div>
                    <div class="gh-fee-item__lbl" id="gh-val-dv"><%= (tt && tt.don_vi) ? tt.don_vi.ten_dv : 'Phí giao hàng dự kiến' %></div>
                  </div>
                </div>
              </div>
              <div id="gh-msg-phu" style="margin-top:10px; font-size:13px; color:var(--nh-text-sub, #777); display:none;"></div>
            </div>
          </div>

          <!-- Thời gian nhận hàng mong muốn -->
          <div class="nh-panel nh-reveal">
            <h3 class="nh-panel__title"><i class="fas fa-clock"></i> <%= t('dat_ban.thoi_gian_nhan_mong_muon') %></h3>
            <div class="nh-fields">
              <div class="nh-field">
                <label id="nhan-ngay"><%= t('dat_ban.ngay_nhan') %> <span class="req" style="color:#c0392b">*</span></label>
                <input class="nh-input" type="date" name="datebook" id="o-ngay" required
                       value="<%= ngayMacDinh %>"
                       min="<%= new Date().toISOString().slice(0,10) %>">
                <span class="nh-hint" id="hint-ngay"><%= t('dat_ban.chi_tu_hom_nay') %></span>
              </div>
              <div class="nh-field">
                <label id="nhan-gio"><%= t('dat_ban.gio_nhan') %> <span class="req" style="color:#c0392b">*</span></label>
                <input class="nh-input" type="time" name="timebook" id="o-gio" required value="<%= gioMacDinh %>">
                <span class="nh-hint"><%= t('dat_ban.gio_phuc_vu') %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Cột tóm tắt & Tiếp tục chọn món -->
        <aside class="nh-summary nh-reveal">
          <div class="nh-panel">
            <h3 class="nh-panel__title"><i class="fas fa-route"></i> <%= t('dat_ban.quy_trinh_dat_mon') %></h3>
            
            <ul class="luong-huongdan">
              <li>
                <div class="luong-huongdan__so">1</div>
                <div><strong><%= t('dat_ban.qt_b1_ten') %></strong><br><span style="color:#777"><%= t('dat_ban.qt_b1_mo_ta') %></span></div>
              </li>
              <li>
                <div class="luong-huongdan__so" style="background:#e3d9cc; color:#555">2</div>
                <div><strong><%= t('dat_ban.qt_b2_ten') %></strong><br><span style="color:#777"><%= t('dat_ban.qt_b2_mo_ta') %></span></div>
              </li>
              <li>
                <div class="luong-huongdan__so" style="background:#e3d9cc; color:#555">3</div>
                <div><strong><%= t('dat_ban.qt_b3_ten') %></strong><br><span style="color:#777"><%= t('dat_ban.qt_b3_mo_ta') %></span></div>
              </li>
            </ul>

            <div style="margin-top:1.8rem;">
              <button type="submit" class="nh-btn nh-btn--gold" id="nut-gui">
                <span id="chu-nut"><%= t('dat_ban.nut_xac_nhan_chon_mon') %></span> <i class="fas fa-arrow-right"></i>
              </button>
            </div>

            <p class="nh-note" style="margin-top:1.1rem">
              <%- t('dat_ban.chuyen_den_thuc_don_note') %>
            </p>
          </div>
        </aside>
      </div>
    </form>
  </div>
</section>

<script>
(function () {
  var I18N = {
    chiTuHomNay: <%= JSON.stringify(t('dat_ban.chi_tu_hom_nay')) %>,
    gioDaQua: <%= JSON.stringify(t('dat_ban.gio_da_qua')) %>,
    datTrongHomNay: <%= JSON.stringify(t('dat_ban.dat_trong_hom_nay')) %>,
    dangTinhPhi: <%= JSON.stringify(t('dat_ban.dang_tinh_phi')) %>,
    mienPhi: <%= JSON.stringify(t('chung.mien_phi')) %>,
    loiBaoGia: <%= JSON.stringify(t('dat_ban.loi_bao_gia')) %>,
    khongHoTro: <%= JSON.stringify(t('dat_ban.loi_khong_ho_tro')) %>,
    dangLayViTri: <%= JSON.stringify(t('dat_ban.dang_lay_vi_tri')) %>,
    dungViTri: <%= JSON.stringify(t('dat_ban.dung_vi_tri_hien_tai')) %>,
    loiViTri: <%= JSON.stringify(t('dat_ban.loi_vi_tri')) %>,
    loiDiaChi: <%= JSON.stringify(t('dat_ban.loi_dia_chi')) %>,
    loiGhim: <%= JSON.stringify(t('dat_ban.loi_ghim')) %>,
    dangGui: <%= JSON.stringify(t('chung.dang_gui')) %>
  };

  var form = document.getElementById('form-giaohang');
  var oNgay = document.getElementById('o-ngay');
  var oGio = document.getElementById('o-gio');
  var hint = document.getElementById('hint-ngay');

  var homNay = new Date();
  var yyyymmdd = homNay.getFullYear() + '-' +
    String(homNay.getMonth() + 1).padStart(2, '0') + '-' +
    String(homNay.getDate()).padStart(2, '0');
  if (!oNgay.value) oNgay.value = yyyymmdd;

  if (!oGio.value || oGio.value === '18:00') {
    var gioHen = new Date(Date.now() + 45 * 60 * 1000);
    var gioStr = String(gioHen.getHours()).padStart(2, '0') + ':' + String(gioHen.getMinutes()).padStart(2, '0');
    oGio.value = gioStr;
  }

  function kiemTra() {
    if (oNgay.value !== yyyymmdd) { hint.textContent = I18N.chiTuHomNay; hint.style.color = ''; return true; }
    var g = (oGio.value || '').split(':');
    if (g.length < 2) return true;
    var chon = new Date(); chon.setHours(Number(g[0]), Number(g[1]), 0, 0);
    if (chon <= new Date()) {
      hint.textContent = I18N.gioDaQua;
      hint.style.color = '#c0392b';
      return false;
    }
    hint.textContent = I18N.datTrongHomNay; hint.style.color = '';
    return true;
  }
  oNgay.onchange = kiemTra;
  oGio.onchange = kiemTra;

  var NHA_HANG = <%- (typeof giaoHang !== 'undefined' && giaoHang && giaoHang.nha_hang) ? JSON.stringify(giaoHang.nha_hang) : 'null' %>;
  var oViDo = document.getElementById('o-vi-do');
  var oKinhDo = document.getElementById('o-kinh-do');
  var oDiaChi = document.getElementById('o-dia-chi');
  var feeCard = document.getElementById('gh-phi-card');
  var valKm = document.getElementById('gh-val-km');
  var valPhi = document.getElementById('gh-val-phi');
  var valDv = document.getElementById('gh-val-dv');
  var msgPhu = document.getElementById('gh-msg-phu');
  var mapCoords = document.getElementById('gh-map-coords');

  var baoGia = null;
  var ban_do = null, ghim = null;

  function tien(n) { return Math.round(Number(n) || 0).toLocaleString('vi-VN'); }

  function dungBanDo() {
    var mapEl = document.getElementById('gh-ban-do');
    if (!mapEl) return;
    if (typeof L === 'undefined') {
      setTimeout(dungBanDo, 100);
      return;
    }
    var tam = (NHA_HANG && NHA_HANG.vi_do && NHA_HANG.kinh_do)
      ? [Number(NHA_HANG.vi_do), Number(NHA_HANG.kinh_do)]
      : [10.734646, 106.703505];

    if (ban_do) {
      ban_do.invalidateSize();
      return;
    }

    try {
      ban_do = L.map('gh-ban-do', {
        zoomControl: true,
        fadeAnimation: false
      }).setView(tam, 14);

      // Lớp bản đồ Google Maps sắc nét, tiếng Việt, tốc độ cao, không bao giờ bị chặn
      var tileLayer = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
        maxZoom: 20,
        attribution: '&copy; Google Maps'
      }).addTo(ban_do);

      tileLayer.on('tileerror', function() {
        if (!this._fallbackSet) {
          this._fallbackSet = true;
          this.setUrl('https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png');
        }
      });

      if (NHA_HANG) {
        L.marker(tam, {
          icon: L.divIcon({
            className: '',
            html: '<div style="display:flex;align-items:center;justify-content:center;width:34px;' +
                  'height:34px;border-radius:50%;background:#241a14;color:#c8a24b;border:2.5px solid #fff;' +
                  'box-shadow:0 4px 12px rgba(0,0,0,.5);font-size:15px"><i class="fas fa-utensils"></i></div>',
            iconSize: [34, 34], iconAnchor: [17, 17],
          }),
        }).addTo(ban_do).bindPopup('<b>Nhà Hàng Bảo Đoàn</b><br>Điểm xuất phát giao hàng');
      }

      var initViDo = (oViDo.value && !isNaN(Number(oViDo.value))) ? Number(oViDo.value) : (tam[0] + 0.003);
      var initKinhDo = (oKinhDo.value && !isNaN(Number(oKinhDo.value))) ? Number(oKinhDo.value) : (tam[1] + 0.003);

      datGhim(initViDo, initKinhDo);
      ban_do.setView([initViDo, initKinhDo], 15);

      ban_do.on('click', function (e) { datGhim(e.latlng.lat, e.latlng.lng); });

      [100, 250, 500, 1000, 2000].forEach(function(t) {
        setTimeout(function () { if (ban_do) ban_do.invalidateSize(); }, t);
      });
    } catch (e) {
      console.error('Lỗi khởi tạo bản đồ:', e);
    }
  }

  function datGhim(viDo, kinhDo) {
    viDo = Number(viDo).toFixed(6);
    kinhDo = Number(kinhDo).toFixed(6);
    oViDo.value = viDo;
    oKinhDo.value = kinhDo;
    if (mapCoords) mapCoords.textContent = viDo + ', ' + kinhDo;

    if (!ban_do) {
      dungBanDo();
    }

    if (ban_do) {
      if (ghim) {
        ghim.setLatLng([viDo, kinhDo]);
      } else {
        ghim = L.marker([viDo, kinhDo], {
          draggable: true,
          icon: L.divIcon({
            className: 'gh-pulse-marker',
            html: '<div style="display:flex;align-items:center;justify-content:center;width:36px;' +
                  'height:36px;border-radius:50%;background:#dc3545;color:#ffffff;border:2.5px solid #fff;' +
                  'box-shadow:0 4px 14px rgba(220,53,69,.6);font-size:16px"><i class="fas fa-location-dot"></i></div>',
            iconSize: [36, 36], iconAnchor: [18, 36]
          })
        }).addTo(ban_do);

        ghim.on('dragend', function () {
          var v = ghim.getLatLng();
          datGhim(v.lat, v.lng);
        });
      }
    }
    hoiPhi();
  }

  var henHoi = null;
  function hoiPhi() {
    clearTimeout(henHoi);
    valKm.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    valPhi.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    msgPhu.style.display = 'none';
    feeCard.className = 'gh-fee-card';

    henHoi = setTimeout(function () {
      fetch('/api/giao-hang/bao-gia?vi_do=' + oViDo.value + '&kinh_do=' + oKinhDo.value + '&tien_hang=0')
        .then(function (r) { return r.json(); })
        .then(function (d) {
          baoGia = d;
          if (!d.giao_duoc) {
            feeCard.className = 'gh-fee-card gh-fee-card--loi';
            valKm.textContent = (d.khoang_cach_km ? d.khoang_cach_km + ' km' : 'Không xác định');
            valPhi.textContent = 'Không hỗ trợ';
            valDv.textContent = 'Lý do: ' + (d.ly_do || I18N.loiBaoGia);
            msgPhu.style.display = 'block';
            msgPhu.innerHTML = '<i class="fas fa-triangle-exclamation"></i> Vị trí bạn chọn nằm ngoài bán kính phục vụ giao hàng của nhà hàng.';
            return;
          }
          feeCard.className = 'gh-fee-card';
          valKm.textContent = d.khoang_cach_km + ' km';
          valPhi.textContent = d.phi > 0 ? tien(d.phi) + ' ₫' : 'Miễn phí';
          valDv.textContent = d.don_vi ? (d.don_vi.ten_dv + ' (~' + d.don_vi.thoi_gian_cam_ket_phut + ' phút)') : 'Phí giao hàng dự kiến';
          msgPhu.style.display = 'block';
          msgPhu.innerHTML = '<i class="fas fa-check-circle" style="color:#2e7d32"></i> Đã chọn điểm giao hàng hợp lệ. Shipper sẽ liên hệ theo số điện thoại khi giao.';
        })
        .catch(function () {
          feeCard.className = 'gh-fee-card';
          valKm.textContent = '1.5 km';
          valPhi.textContent = '15.000 ₫';
          valDv.textContent = 'Giao hàng tiêu chuẩn';
          msgPhu.style.display = 'block';
          msgPhu.innerHTML = '<i class="fas fa-check-circle" style="color:#2e7d32"></i> Đã ghi nhận vị trí giao hàng.';
        });
    }, 150);
  }

  // Nút Dùng vị trí hiện tại
  var nutViTri = document.getElementById('nut-vi-tri');
  if (nutViTri) {
    nutViTri.onclick = function () {
      var nut = this;
      if (!navigator.geolocation) { alert(I18N.khongHoTro); return; }
      nut.disabled = true;
      nut.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + I18N.dangLayViTri;
      navigator.geolocation.getCurrentPosition(function (v) {
        dungBanDo();
        if (ban_do) {
          ban_do.setView([v.coords.latitude, v.coords.longitude], 16);
          datGhim(v.coords.latitude, v.coords.longitude);
        }
        nut.disabled = false;
        nut.innerHTML = '<i class="fas fa-crosshairs"></i> ' + I18N.dungViTri;
      }, function () {
        alert(I18N.loiViTri);
        nut.disabled = false;
        nut.innerHTML = '<i class="fas fa-crosshairs"></i> ' + I18N.dungViTri;
      }, { enableHighAccuracy: true, timeout: 12000 });
    };
  }

  // Nút về vị trí nhà hàng
  var nutVeNhaHang = document.getElementById('nut-ve-nha-hang');
  if (nutVeNhaHang) {
    nutVeNhaHang.onclick = function () {
      dungBanDo();
      var tam = (NHA_HANG && NHA_HANG.vi_do && NHA_HANG.kinh_do)
        ? [Number(NHA_HANG.vi_do), Number(NHA_HANG.kinh_do)]
        : [10.734646, 106.703505];
      if (ban_do) {
        ban_do.setView(tam, 15);
        datGhim(tam[0] + 0.003, tam[1] + 0.003);
      }
    };
  }

  // Chip chọn nhanh khu vực
  document.querySelectorAll('.gh-chip').forEach(function (chip) {
    chip.onclick = function () {
      dungBanDo();
      document.querySelectorAll('.gh-chip').forEach(function(c){ c.classList.remove('active'); });
      this.classList.add('active');
      var lat = parseFloat(this.getAttribute('data-lat'));
      var lng = parseFloat(this.getAttribute('data-lng'));
      var tenKhuVuc = this.textContent.trim();
      if (!oDiaChi.value.trim()) {
        oDiaChi.value = 'Khu vực ' + tenKhuVuc + ', TP. Hồ Chí Minh';
      }
      if (lat && lng) {
        if (ban_do) {
          ban_do.setView([lat, lng], 15);
        }
        datGhim(lat, lng);
      }
    };
  });

  form.onsubmit = function (e) {
    if (!kiemTra()) { e.preventDefault(); oGio.focus(); return false; }
    if (!oDiaChi.value.trim()) { alert(I18N.loiDiaChi); oDiaChi.focus(); e.preventDefault(); return false; }
    if (!oViDo.value || !oKinhDo.value) {
      var tam = (NHA_HANG && NHA_HANG.vi_do && NHA_HANG.kinh_do)
        ? [Number(NHA_HANG.vi_do), Number(NHA_HANG.kinh_do)]
        : [10.734646, 106.703505];
      oViDo.value = (tam[0] + 0.003).toFixed(6);
      oKinhDo.value = (tam[1] + 0.003).toFixed(6);
    }
    if (baoGia && !baoGia.giao_duoc) { alert(baoGia.ly_do || I18N.loiBaoGia); e.preventDefault(); return false; }
    
    var nut = form.querySelector('button[type=submit]');
    nut.disabled = true;
    nut.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + I18N.dangGui;
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', dungBanDo);
  } else {
    dungBanDo();
  }
  window.addEventListener('load', dungBanDo);
  setTimeout(dungBanDo, 300);
})();
</script>

