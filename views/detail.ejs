<%- include('partials/header', { title: dish ? tenMon(dish).chinh : t('chi_tiet.tieu_de'), activeNav: 'menu' }) %>

<section class="nh-subhero nh-subhero--sm">
  <div class="nh-subhero__bg nh-wa-koshi"></div>
  <div class="nh-subhero__veil"></div>
  <div class="nh-container nh-subhero__inner">
    <span class="nh-eyebrow"><%= t('thuc_don.eyebrow_bep') %></span>
    <h1><%= t('chi_tiet.tieu_de') %></h1>
    <div class="nh-crumbs"><a href="/"><%= t('dieu_huong.trang_chu') %></a> &nbsp;/&nbsp; <a href="/menu"><%= t('dieu_huong.thuc_don') %></a> &nbsp;/&nbsp; <%= t('chi_tiet.breadcrumb') %></div>
  </div>
</section>

<section class="nh-section nh-section--cream">
  <div class="nh-container">
    <%- include('partials/nh-steps', { buoc: 1 }) %>

    <% if (dish) { %>
      <div class="nh-detail nh-reveal">
        <div class="nh-detail__media">
          <img src="/food/<%= dish.images %>" alt="<%= tenMon(dish).chinh %>"
               onerror="this.onerror=null;this.src='/mon-thay-the.svg'">
        </div>

        <div>
          <span class="nh-eyebrow nh-eyebrow--sm"><%= t('chi_tiet.nhan') %></span>
          <h2 class="nh-section-title" style="font-size:clamp(1.7rem,3.4vw,2.5rem)">
            <%= tenMon(dish).chinh %>
          </h2>
          <div class="nh-divider" style="margin-left:0"></div>

          <p class="nh-detail__price"><%= formatMoney(dish.gia_mon) %> ₫</p>

          <p class="nh-lead" style="margin-top:1rem">
            <% var tmc = tenMon(dish); %><%= tmc.phu || t('chi_tiet.mo_ta_mac_dinh') %>
          </p>

          <%
            /* Nguyên liệu nào đã đẩy món vào một nhóm dị ứng thì đánh dấu ngay
               trong danh sách, để khách dò tên món ăn được là thấy luôn chỗ
               cần chú ý, không phải đối chiếu hai khối với nhau. */
            var nlCanhBao = new Set();
            (diUng && diUng.nhom || []).forEach(function (n) {
              n.nguyen_lieu.forEach(function (x) { nlCanhBao.add(x); });
            });
          %>
          <div class="nh-nl">
            <% if (nguyenLieu && nguyenLieu.length) { %>
              <% if (diUng.co_canh_bao) { %>
                <div class="nh-diung">
                  <p class="nh-diung__dau">
                    <i class="fas fa-exclamation-triangle"></i> <%= t('chi_tiet.di_ung_tieu_de') %>
                  </p>
                  <ul class="nh-diung__nhom">
                    <% diUng.nhom.forEach(function (n) { %>
                      <li>
                        <b><%= t('di_ung.' + n.khoa) %></b>
                        <span><%= n.nguyen_lieu.map(tenNguyenLieu).join(' · ') %></span>
                      </li>
                    <% }); %>
                  </ul>
                </div>
              <% } else { %>
                <p class="nh-diung__trong">
                  <i class="fas fa-check-circle"></i> <%= t('chi_tiet.di_ung_khong_thay') %>
                </p>
              <% } %>

              <h3 class="nh-nl__ten"><%= t('chi_tiet.nguyen_lieu') %></h3>
              <ul class="nh-nl__ds">
                <% nguyenLieu.forEach(function (nl) { %>
                  <li class="<%= nlCanhBao.has(nl) ? 'la-di-ung' : '' %>"><%= tenNguyenLieu(nl) %></li>
                <% }); %>
              </ul>
            <% } else { %>
              <p class="nh-nl__chua-co"><%= t('chi_tiet.nguyen_lieu_chua_co') %></p>
            <% } %>

            <p class="nh-note nh-nl__luu-y">
              <i class="fas fa-circle-info" style="color:var(--nh-gold)"></i>
              <%= t('chi_tiet.di_ung_luu_y') %>
            </p>
          </div>

          <form action="/add-to-cart" method="post" class="nh-detail__buy">
            <input type="hidden" name="monid" value="<%= dish.id_mon %>">
            <div class="nh-qty">
              <button type="button" data-buoc="-1" aria-label="<%= t('chi_tiet.bot_mot_phan') %>"><i class="fas fa-minus"></i></button>
              <input type="number" name="soluong" id="sl" value="1" min="1" max="100" aria-label="<%= t('chung.so_luong') %>">
              <button type="button" data-buoc="1" aria-label="<%= t('chi_tiet.them_mot_phan') %>"><i class="fas fa-plus"></i></button>
            </div>
            <button type="submit" class="nh-btn nh-btn--gold">
              <i class="fas fa-shopping-bag"></i> <%= t('chi_tiet.them_gio') %>
            </button>
            <a href="/menu" class="nh-btn nh-btn--dark nh-btn--sm">
              <i class="fas fa-arrow-left"></i> <%= t('gio_hang.chon_them_mon') %>
            </a>
          </form>

          <p class="nh-note">
            <i class="fas fa-circle-info" style="color:var(--nh-gold)"></i>
            <%= t('chi_tiet.ghi_chu_dat') %>
          </p>
        </div>
      </div>
    <% } else { %>
      <div class="nh-empty">
        <i class="fas fa-utensils"></i>
        <h3><%= t('chi_tiet.khong_thay') %></h3>
        <p class="nh-lead" style="margin:.6rem 0 1.6rem"><%= t('chi_tiet.khong_thay_mo_ta') %></p>
        <a href="/menu" class="nh-btn nh-btn--gold"><i class="fas fa-book-open"></i> <%= t('chung.xem_thuc_don') %></a>
      </div>
    <% } %>
  </div>
</section>

<script>
  // Bộ tăng giảm số phần. Gõ tay vẫn được, nút chỉ là lối đi nhanh hơn.
  (function () {
    var o = document.getElementById('sl');
    if (!o) return;
    document.querySelectorAll('.nh-qty [data-buoc]').forEach(function (n) {
      n.onclick = function () {
        var v = (parseInt(o.value, 10) || 1) + Number(n.getAttribute('data-buoc'));
        o.value = Math.min(100, Math.max(1, v));
      };
    });
  })();
</script>

<%- include('partials/goi-y-mon') %>
<%- include('partials/footer') %>
