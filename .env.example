# =====================================================================
#  MAU CAU HINH — chep file nay thanh ".env" roi dien thong tin cua may ban
#      Windows : copy .env.example .env
#      Linux   : cp .env.example .env
# =====================================================================

# --- Ket noi co so du lieu (bat buoc) --------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=gs_restaurant

# --- May chu web -----------------------------------------------------
PORT=3000
NODE_ENV=development

# Chuoi bi mat cho phien dang nhap. Tren may that PHAI doi thanh chuoi
# ngau nhien rieng, toi thieu 32 ky tu.
SESSION_SECRET=doi_thanh_chuoi_ngau_nhien_toi_thieu_32_ky_tu

# --- HTTPS (tuy chon) ------------------------------------------------
# Dien thoai chi mo duoc camera (quet QR, cham cong khuon mat) qua https.
# He thong tu sinh chung chi tu ky trong config/chung-chi/.
# Dat BAT_HTTPS=0 neu muon tat han, chi chay http.
HTTPS_PORT=3443
BAT_HTTPS=1

# --- Dia chi cho ma QR dan o ban (tuy chon) --------------------------
# De TRONG khi chay trong mang Wi-Fi cua quan: he thong tu tim IP LAN cua
# may chu de nhung vao ma QR, nen dien thoai khach quet la mo duoc ngay.
# Chi dien khoa nay khi he thong da co ten mien that hoac chay qua Internet,
# vi luc do IP LAN khong con dung nua. Vi du:
# QR_BASE_URL=https://nhahang.vn
#
# CHU Y: khach dung 4G hoac o mang khac thi dia chi LAN khong bao gio mo duoc.
# Luc do chay `npm run qr:online` (hoac nhap dup _mo_qr_online.bat) - no mo mot
# tunnel https ra Internet va ma QR tu doi theo, KHONG can dien khoa nay.
# Neu khoa nay dang duoc dien thi no thang ca tunnel. Xem HUONG_DAN_QUET_QR_TU_XA.md
QR_BASE_URL=

# --- Email -----------------------------------------------------------
# Dung cho chuc nang quen mat khau va trang /staff/emails/send.
#
# EMAIL_PASS phai la MAT KHAU UNG DUNG 16 ky tu cua Google, KHONG phai mat khau
# dang nhap Gmail (Google da chan loai do). Lay tai myaccount.google.com/apppasswords
# sau khi bat Xac minh 2 buoc. Cac buoc chi tiet: HUONG_DAN_CAI_DAT.md muc "Gui email".
#
# De trong thi hai chuc nang tren se bao loi thay vi gui vao hu khong.
# Kiem tra sau khi dien:  npm run mail:test -- dia-chi-nhan@gmail.com
#
# Khi lap trinh, muon thu ma khong gui that: dat EMAIL_THU_NGHIEM=1 (hop thu ao,
# thu KHONG toi nguoi nhan that). Dung bat khoa nay khi chay that.
EMAIL_USER=
EMAIL_PASS=

# --- Dich vu AI / ML -------------------------------------------------
# KHONG khai bao o day. Dia chi ML service duoc luu trong co so du lieu,
# o bang "cau_hinh", khoa "ml_service_url" (mac dinh http://127.0.0.1:8000).
# Web van chay binh thuong khi dich vu nay tat: cac trang du bao se doc
# ket qua da luu san trong co so du lieu.

# --- Chi dung khi chay lai migration (tuy chon) ----------------------
# Cac bien duoi day chi duoc doc boi script trong config/migrations/,
# khong anh huong den viec chay he thong hang ngay.
APP_URL=http://localhost:3000
VIETQR_BANK=VCB
VIETQR_ACCOUNT=0011001234567
VIETQR_NAME=NHA HANG BAO DOAN
